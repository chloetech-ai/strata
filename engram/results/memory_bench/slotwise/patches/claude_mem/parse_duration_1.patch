+"""Appointment durations typed by reception staff."""
+
+import re
+
+# '45', '45m', '45 min', '1h', '1h30', '1h 30m', '1:30'
+_PATTERN = re.compile(
+    r"(?:(?P<hours>[0-9]+)\s*h\s*(?:(?P<h_minutes>[0-9]+)\s*(?:m|min)?)?)"
+    r"|(?:(?P<clock_hours>[0-9]+):(?P<clock_minutes>[0-9]{1,2}))"
+    r"|(?:(?P<minutes>[0-9]+)\s*(?:m|min)?)"
+)
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '1h30' or '1:30'. Raises ValueError otherwise."""
+    match = _PATTERN.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match["minutes"] is not None:
+        total = int(match["minutes"])
+    else:
+        hours, minutes = (
+            (int(match["hours"]), int(match["h_minutes"] or 0))
+            if match["hours"] is not None
+            else (int(match["clock_hours"]), int(match["clock_minutes"]))
+        )
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        total = hours * 60 + minutes
+
+    if total == 0:
+        raise ValueError("duration must be more than zero")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
