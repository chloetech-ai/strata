+"""The text of the reminder SMS sent to clients before an appointment."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+SMS_LIMIT = 160
+
+# German letters have standard ASCII spellings. This runs before NFKD, which would reduce ä to a.
+_GERMAN = str.maketrans({
+    "ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss",
+})
+
+
+def to_ascii(text):
+    """`text` in plain ASCII: German letters spelled out, accents dropped, anything else replaced by '?'."""
+    decomposed = unicodedata.normalize("NFKD", text.translate(_GERMAN))
+    stripped = "".join(c for c in decomposed if not unicodedata.combining(c))
+    return stripped.encode("ascii", "replace").decode("ascii")
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`: ASCII, at most SMS_LIMIT characters, always with the reception number.
+
+    The greeting with the client's name is left out if a long name would push the message past the limit.
+    """
+    when = appointment.start.strftime("%d.%m. um %H:%M")
+    body = f"Erinnerung: Termin am {when} bei Lindqvist Physio. Absage bitte an {RECEPTION_NUMBER}."
+    greeted = f"Hallo {to_ascii(appointment.client)}, {body}"
+    return greeted if len(greeted) <= SMS_LIMIT else body
