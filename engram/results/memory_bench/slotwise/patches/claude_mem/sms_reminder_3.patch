+++ b/tests/test_reminders.py
@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import RECEPTION_NUMBER, SMS_LIMIT, reminder_text, to_ascii
+
+
+def appointment(client, start=datetime.datetime(2026, 10, 19, 14, 30)):
+    return Appointment("Anna Lindqvist", client, start)
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_german_letters_are_spelled_out(self):
+        self.assertEqual(to_ascii("Müller-Lüdi Jörg Äpfel Groß"), "Mueller-Luedi Joerg Aepfel Gross")
+
+    def test_accents_are_dropped(self):
+        self.assertEqual(to_ascii("René Hélène Zoë"), "Rene Helene Zoe")
+
+    def test_characters_without_a_latin_equivalent_become_question_marks(self):
+        self.assertEqual(to_ascii("Li 李"), "Li ?")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_time_and_reception_number(self):
+        text = reminder_text(appointment("Kim Weber"))
+        self.assertIn("19.10. um 14:30", text)
+        self.assertIn(RECEPTION_NUMBER, text)
+        self.assertIn("Hallo Kim Weber", text)
+
+    def test_name_is_transliterated(self):
+        self.assertIn("Hallo Joerg Mueller", reminder_text(appointment("Jörg Müller")))
+
+    def test_long_name_drops_the_greeting_and_stays_within_limit(self):
+        text = reminder_text(appointment("Maria " + "Schneider-" * 20 + "Zweig"))
+        self.assertLessEqual(len(text), SMS_LIMIT)
+        self.assertTrue(text.startswith("Erinnerung: Termin am 19.10."))
+        self.assertIn(RECEPTION_NUMBER, text)
+
+    def test_result_is_ascii(self):
+        text = reminder_text(appointment("Zoë Bäumler"))
+        text.encode("ascii")
+
+
+if __name__ == "__main__":
+    unittest.main()
