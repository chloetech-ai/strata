+    def test_free_slots_on_empty_day_run_from_opening_to_last_fit(self):
+        # Tuesday 07:30-19:00; a 45-minute appointment must finish by 19:00, so the last start is 18:15.
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(b - a == datetime.timedelta(minutes=15) for a, b in zip(slots, slots[1:])))
+
+    def test_free_slots_on_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 30), [])  # Sunday
+
+    def test_free_slots_leave_break_either_side(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so 45-minute slots need to end by 08:50 or start at 09:55 or later
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        for minute in (0, 15, 30, 45):
+            self.assertNotIn(datetime.datetime(2026, 9, 8, 9, minute), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_agree_with_book(self):
+        # Every grid start is offered exactly when booking a 60-minute appointment there would succeed.
+        day = datetime.date(2026, 9, 8)
+        free = set(self._booked_at_nine().free_slots("lena", day, 60))
+        for hour in range(7, 19):
+            for minute in (0, 15, 30, 45):
+                start = datetime.datetime(2026, 9, 8, hour, minute)
+                s = self._booked_at_nine()
+                try:
+                    s.book(Appointment("lena", "Jo Li", start, "initial"))
+                    bookable = True
+                except (SlotTaken, OutsideOpeningHours):
+                    bookable = False
+                self.assertEqual(bookable, start in free, start)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(12, therapist="marco", client="Jo Li"))
+        s.cancel(a.id)
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 12, 0), slots)
+
+    @staticmethod
+    def _booked_at_nine():
+        s = Schedule()
+        s.book(at(9))  # lena, 09:00-09:45
+        return s
