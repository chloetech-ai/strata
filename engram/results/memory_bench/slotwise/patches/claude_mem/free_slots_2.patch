+    def test_free_slots_on_empty_day_run_from_opening_to_last_fit(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends exactly at 19:00
+        self.assertEqual(len(slots), 44)
+
+    def test_free_slots_respect_break_either_side(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so needs 08:55 and 09:55 clear
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 10 minutes before 09:00
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_agree_with_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(13, client="Jo Li", treatment="initial"))
+        free = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        start = datetime.datetime(2026, 9, 8, 7, 30)
+        while start < datetime.datetime(2026, 9, 8, 19, 0):
+            trial = Schedule()
+            trial.appointments = list(s.appointments)
+            try:
+                trial.book(Appointment("lena", "Kim Weber", start, treatment="short"))
+                accepted = True
+            except BookingError:
+                accepted = False
+            self.assertEqual(accepted, start in free, start)
+            start += datetime.timedelta(minutes=15)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
