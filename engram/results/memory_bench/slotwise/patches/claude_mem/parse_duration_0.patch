@@ -0,0 +1,33 @@
+import re
+
+_DURATION = re.compile(
+    r"(?:(?P<hours>\d+)\s*h(?:\s*(?P<h_minutes>\d+)\s*(?:m|min)?)?"
+    r"|(?P<minutes>\d+)\s*(?:m|min)?"
+    r"|(?P<colon_hours>\d+):(?P<colon_minutes>\d{1,2}))"
+)
+
+
+def parse_duration(text):
+    """Turn a duration such as '45', '1h30' or '1:30' into whole minutes."""
+    cleaned = text.strip().lower() if text else ""
+    match = _DURATION.fullmatch(cleaned)
+    if not match:
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match.group("minutes") is not None:
+        total = int(match.group("minutes"))
+    elif match.group("colon_hours") is not None:
+        total = _combine(match.group("colon_hours"), match.group("colon_minutes"))
+    else:
+        total = _combine(match.group("hours"), match.group("h_minutes") or "0")
+
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
+
+
+def _combine(hours, minutes):
+    minutes = int(minutes)
+    if minutes >= 60:
+        raise ValueError(f"minutes must be below 60 after an hour: {minutes}")
+    return int(hours) * 60 + minutes
