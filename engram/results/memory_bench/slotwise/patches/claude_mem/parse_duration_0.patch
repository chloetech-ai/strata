+++ b/tests/test_durations.py
@@ -0,0 +1,42 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for raw, minutes in cases.items():
+            self.assertEqual(parse_duration(raw), minutes, raw)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_empty_input_is_refused(self):
+        for raw in ["", "   "]:
+            with self.assertRaises(ValueError, msg=repr(raw)):
+                parse_duration(raw)
+
+    def test_zero_is_refused(self):
+        for raw in ["0", "0m", "0h", "0:00"]:
+            with self.assertRaises(ValueError, msg=raw):
+                parse_duration(raw)
+
+    def test_anything_else_is_refused(self):
+        for raw in ["abc", "-5", "1h75", "1:75", "1.5h", "1 hour"]:
+            with self.assertRaises(ValueError, msg=raw):
+                parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
