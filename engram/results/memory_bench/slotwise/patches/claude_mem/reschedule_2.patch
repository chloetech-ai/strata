+        self._check(appointment)
+        self.appointments.append(appointment)
+        return appointment
+
+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to `new_start`, keeping its therapist, client and treatment.
+
+        If the move is refused, the appointment is left where it was.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment has been cancelled, so it can't be moved.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check(moved, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
