+"""Printable documents for reception."""
+
+
+def day_plan(schedule, therapist, day):
+    """Text for the printed plan of `therapist`'s day: each booked appointment with its time, client and treatment.
+
+    Cancelled appointments are left out.
+    """
+    header = f"{therapist.capitalize()}, {day:%A} {day.day} {day:%B %Y}"
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        return f"{header}\n\nNo appointments."
+    lines = [header, ""]
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment} ({a.minutes} min)")
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
