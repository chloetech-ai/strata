@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(8, 30))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Lena, Monday 7 September 2026\n"
+            "\n"
+            "08:30-09:15  Kim Weber  standard (45 min)\n"
+            "10:00-10:30  Jo Li  short (30 min)",
+        )
+
+    def test_leaves_out_other_therapists_and_days(self):
+        s = Schedule()
+        s.book(at(9, therapist="marco"))
+        s.book(at(9, client="Jo Li"))
+        self.assertEqual(day_plan(s, "lena", MONDAY).count("Kim Weber"), 0)
+        self.assertIn("Jo Li", day_plan(s, "lena", MONDAY))
+
+    def test_leaves_out_cancelled(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        s.cancel(a.id)
+        text = day_plan(s, "lena", MONDAY)
+        self.assertNotIn("Kim Weber", text)
+        self.assertIn("Jo Li", text)
+
+    def test_empty_day(self):
+        self.assertEqual(day_plan(Schedule(), "lena", MONDAY), "Lena, Monday 7 September 2026\n\nNo appointments.")
+
+
+if __name__ == "__main__":
+    unittest.main()
