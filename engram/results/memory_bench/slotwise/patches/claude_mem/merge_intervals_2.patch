+"""Interval helpers for working with appointment time spans."""
+
+
+def merge_intervals(intervals):
+    """Merge (start, end) pairs that overlap or touch.
+
+    Works with ints or datetimes. Returns a new list of (start, end) tuples
+    sorted by start; the input list is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals, key=lambda pair: pair[0]):
+        if merged and start <= merged[-1][1]:
+            last_start, last_end = merged[-1]
+            merged[-1] = (last_start, max(last_end, end))
+        else:
+            merged.append((start, end))
+    return merged
