diff --git a/src/slotwise/reminders.py b/src/slotwise/reminders.py
new file mode 100644
index 0000000..1d1446d
--- /dev/null
+++ b/src/slotwise/reminders.py
@@ -0,0 +1,43 @@
+"""The reminder SMS sent to clients before their appointment."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+# A single SMS holds 160 GSM characters.
+MAX_LENGTH = 160
+
+# NFKD splits 'é' into 'e' plus an accent, but it turns 'ä' into 'a', so the German letters are spelled out first.
+GERMAN = str.maketrans({"ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue"})
+
+
+def to_ascii(text):
+    """Plain ASCII version of `text`. Characters with no Latin equivalent become '?'."""
+    text = unicodedata.normalize("NFKD", text.translate(GERMAN))
+    text = "".join(c for c in text if not unicodedata.combining(c))
+    return text.encode("ascii", "replace").decode("ascii")
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`: ASCII only, at most MAX_LENGTH characters.
+
+    The reception number is always kept. A long client name is shortened with '...' to make room.
+    """
+    when = appointment.start
+    therapist = to_ascii(appointment.therapist).capitalize()
+
+    def build(name):
+        return (
+            f"Hello {name}, your physio appointment with {therapist} is on "
+            f"{when:%a} {when.day} {when:%b} at {when:%H:%M}. "
+            f"Questions? Call reception on {RECEPTION_NUMBER}."
+        )
+
+    name = to_ascii(appointment.client)
+    overflow = len(build(name)) - MAX_LENGTH
+    if overflow > 0:
+        keep = len(name) - overflow - len("...")
+        name = name[:max(keep, 0)].rstrip() + "..."
+    text = build(name)
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder for appointment {appointment.id} is too long even without the client name")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..2369526
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,56 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_NUMBER, reminder_text, to_ascii
+
+
+def appointment(client="Kim Weber", therapist="anna"):
+    return Appointment(therapist, client, datetime.datetime(2026, 10, 19, 9, 0))
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_german_letters_are_spelled_out(self):
+        self.assertEqual(to_ascii("Jürgen Böhler, Groß Äpfel Öl Übung"), "Juergen Boehler, Gross Aepfel Oel Uebung")
+
+    def test_accents_are_dropped(self):
+        self.assertEqual(to_ascii("José Renée Ébène"), "Jose Renee Ebene")
+
+    def test_letters_without_latin_equivalent_become_question_marks(self):
+        self.assertEqual(to_ascii("Li 李"), "Li ?")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_reminder_names_client_therapist_time_and_reception(self):
+        text = reminder_text(appointment())
+        self.assertEqual(
+            text,
+            "Hello Kim Weber, your physio appointment with Anna is on Mon 19 Oct at 09:00. "
+            "Questions? Call reception on 044 512 77 30.",
+        )
+        self.assertIn(RECEPTION_NUMBER, text)
+
+    def test_text_is_ascii_only(self):
+        text = reminder_text(appointment(client="Jürgen Müller-Lüdke", therapist="sören"))
+        self.assertTrue(text.isascii())
+        self.assertIn("Juergen Mueller-Luedke", text)
+        self.assertIn("Soeren", text)
+
+    def test_long_name_is_shortened_and_reception_number_kept(self):
+        name = "Maximilian Alexander Konstantin von Hohenzollern-Sigmaringen " * 2
+        text = reminder_text(appointment(client=name))
+        self.assertLessEqual(len(text), MAX_LENGTH)
+        self.assertIn("...", text)
+        self.assertIn(RECEPTION_NUMBER, text)
+        self.assertTrue(text.startswith("Hello Maximilian Alexander"))
+
+    def test_short_name_is_not_marked_as_shortened(self):
+        self.assertNotIn("...", reminder_text(appointment()))
+
+    def test_refuses_when_text_cannot_fit_even_without_name(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(therapist="x" * 150))
+
+
+if __name__ == "__main__":
+    unittest.main()
