@@ -0,0 +1,22 @@
+"""Cancellation fees."""
+
+import datetime
+
+# Cancelling with at least this much notice is free.
+FREE_NOTICE = datetime.timedelta(hours=48)
+# Cancelling with less than this much notice costs the full price.
+FULL_FEE_NOTICE = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Free with 48 or more hours' notice, half the price with less than 48 hours,
+    and the full price with less than 24 hours.
+    """
+    notice = appointment.start - cancelled_at
+    if notice >= FREE_NOTICE:
+        return 0
+    if notice < FULL_FEE_NOTICE:
+        return appointment.price
+    return appointment.price // 2
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..5dfc622
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,38 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 7, 9, 0)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_free_with_48_hours_notice_or_more(self):
+        a = Appointment("lena", "Kim Weber", START)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(days=7)), 0)
+
+    def test_half_price_just_under_48_hours(self):
+        a = Appointment("lena", "Kim Weber", START)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47, minutes=59)), 4900)
+
+    def test_half_price_at_exactly_24_hours(self):
+        a = Appointment("lena", "Kim Weber", START)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=24)), 4900)
+
+    def test_full_price_just_under_24_hours(self):
+        a = Appointment("lena", "Kim Weber", START)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=23, minutes=59)), 9800)
+
+    def test_full_price_when_cancelled_after_start(self):
+        a = Appointment("lena", "Kim Weber", START)
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(minutes=5)), 9800)
+
+    def test_fee_follows_treatment_price(self):
+        a = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=30)), 7250)
+
+
+if __name__ == "__main__":
+    unittest.main()
