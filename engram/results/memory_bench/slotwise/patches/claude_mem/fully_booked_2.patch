+from .hours import is_open_between, opening_hours
 from .model import TREATMENTS
 
 # Time a therapist needs after each appointment to clean up and write notes.
@@ -58,3 +58,20 @@ class Schedule:
             raise ValueError(f"{monday} is not a Monday")
         days = [monday + datetime.timedelta(days=i) for i in range(7)]
         return {day: [a for a in self.appointments_for(therapist, day) if not a.cancelled] for day in days}
+
+    def is_fully_booked(self, therapist, day):
+        """True if no treatment fits in `therapist`'s free time on `day`, breaks included. A closed day is not fully booked."""
+        hours = opening_hours(day)
+        if hours is None:
+            return False
+        opens, closes = hours
+        shortest = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        free_from = opens
+        for a in self.appointments_for(therapist, day):
+            if a.cancelled:
+                continue
+            # A new appointment has to finish a break before `a` starts.
+            if a.start - BREAK - free_from >= shortest:
+                return False
+            free_from = max(free_from, a.end + BREAK)
+        return closes - free_from < shortest
