+    def test_room_for_a_short_appointment_is_not_fully_booked(self):
+        # Saturday 08:00-12:00. Last free stretch is 11:25-12:00, 35 minutes.
+        s = Schedule()
+        saturday = datetime.date(2026, 9, 12)
+        for hour, minute, treatment in [(8, 0, "standard"), (8, 55, "standard"), (9, 50, "standard"), (10, 45, "short")]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), treatment))
+        self.assertFalse(s.is_fully_booked("lena", saturday))
+
+    def test_no_room_for_a_short_appointment_is_fully_booked(self):
+        # Same day, but the last stretch is 11:40-12:00, 20 minutes.
+        s = Schedule()
+        saturday = datetime.date(2026, 9, 12)
+        for hour, minute in [(8, 0), (8, 55), (9, 50), (10, 45)]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute)))
+        self.assertTrue(s.is_fully_booked("lena", saturday))
+
+    def test_cancelling_frees_the_day(self):
+        s = Schedule()
+        saturday = datetime.date(2026, 9, 12)
+        booked = [s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, h, m))) for h, m in [(8, 0), (8, 55), (9, 50), (10, 45)]]
+        self.assertTrue(s.is_fully_booked("lena", saturday))
+        s.cancel(booked[1].id)
+        self.assertFalse(s.is_fully_booked("lena", saturday))
