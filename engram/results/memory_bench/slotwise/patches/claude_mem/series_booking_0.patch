diff --git a/src/slotwise/series.py b/src/slotwise/series.py
new file mode 100644
index 0000000..1b6ac61
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,35 @@
+"""Booking a run of weekly appointments in one go."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Longest series reception can book at once.
+MAX_SERIES = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, at the same weekday and time.
+
+    A week the therapist is already booked is skipped, and the series runs one week longer
+    instead. Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise ValueError(f"count must be at least 1, not {count}")
+    if count > MAX_SERIES:
+        raise BookingError(f"A series can have at most {MAX_SERIES} appointments.")
+    booked = []
+    week = 0
+    while len(booked) < count:
+        if week == 0:
+            appointment = first
+        else:
+            start = first.start + datetime.timedelta(weeks=week)
+            appointment = Appointment(first.therapist, first.client, start, first.treatment)
+        week += 1
+        try:
+            booked.append(schedule.book(appointment))
+        except SlotTaken:
+            continue
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..0673a20
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,76 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SERIES, book_series
+
+
+def at(day, hour, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8, 9), 3)  # Tuesday 8 Sept
+        self.assertEqual([a.start.day for a in booked], [8, 15, 22])
+        self.assertEqual({a.start.time() for a in booked}, {datetime.time(9)})
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_keeps_therapist_client_and_treatment(self):
+        s = Schedule()
+        first = Appointment("marco", "Jo Li", datetime.datetime(2026, 9, 8, 9), "initial")
+        booked = book_series(s, first, 2)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("marco", "Jo Li", "initial")})
+
+    def test_first_is_the_booked_object(self):
+        s = Schedule()
+        first = at(8, 9)
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+        self.assertIs(s.get(first.id), first)
+
+    def test_skips_taken_week_and_appends_one_at_end(self):
+        s = Schedule()
+        s.book(at(15, 9, client="Jo Li"))  # second week taken
+        booked = book_series(s, at(8, 9), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_skips_several_taken_weeks(self):
+        s = Schedule()
+        s.book(at(15, 9, client="Jo Li"))
+        s.book(at(22, 9, client="Jo Li"))
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 29])
+
+    def test_first_taken_is_skipped(self):
+        s = Schedule()
+        s.book(at(8, 9, client="Jo Li"))
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual([a.start.day for a in booked], [15, 22])
+
+    def test_series_is_not_booked_when_first_is_outside_hours(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(5, 20), 3)  # Saturday evening, closed
+        self.assertEqual(s.appointments, [])
+
+    def test_refuses_more_than_max(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, at(8, 9), MAX_SERIES + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_max_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(8, 9), MAX_SERIES)), MAX_SERIES)
+
+    def test_count_below_one_is_rejected(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), at(8, 9), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
