+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", client="Kim Weber", treatment="standard"):
+    start = datetime.datetime.combine(MONDAY, datetime.time(hour, minute))
+    return Appointment(therapist, client, start, treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_by_start_time(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Lena, Monday 7 September 2026\n"
+            "\n"
+            "09:00-09:45  Kim Weber  standard\n"
+            "10:00-10:30  Jo Li  short\n",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(11, therapist="marco", client="Jo Li"))
+        self.assertEqual(day_plan(s, "lena", MONDAY), "Lena, Monday 7 September 2026\n\nNo appointments.\n")
+
+    def test_leaves_out_other_days(self):
+        s = Schedule()
+        s.book(at(9))
+        tuesday = MONDAY + datetime.timedelta(days=1)
+        self.assertIn("No appointments.", day_plan(s, "lena", tuesday))
+
+
+if __name__ == "__main__":
+    unittest.main()
