+"""Printable documents for reception."""
+
+
+def day_plan(schedule, therapist, day):
+    """Text for reception to print: `therapist`'s booked appointments on `day`, by start time. Cancelled ones are left out."""
+    lines = [f"{therapist.capitalize()}, {day:%A} {day.day} {day:%B %Y}", ""]
+    booked = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not booked:
+        lines.append("No appointments.")
+    for a in booked:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment}")
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_printing.py b/tests/test_printing.py
