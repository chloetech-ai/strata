@@ -0,0 +1,43 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_bookings_by_start_time(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Lena - Monday 7 September 2026\n"
+            "\n"
+            "09:00-09:45  Kim Weber  standard (45 min)\n"
+            "10:00-10:30  Jo Li  short (30 min)\n",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(11, therapist="marco"))
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(Schedule(), "lena", MONDAY),
+            "Lena - Monday 7 September 2026\n\nNo appointments.\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
