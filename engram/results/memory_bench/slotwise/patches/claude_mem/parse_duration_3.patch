+"""Reads appointment lengths typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+# '45', '45m', '45 min', '45 minutes'
+_MINUTES_ONLY = re.compile(r"(\d+)\s*(?:m|mins?|minutes)?")
+# '1h', '2 h'
+_HOURS_ONLY = re.compile(r"(\d+)\s*h")
+# '1h30', '1h 30m', '2h15', '1 h 30 min'
+_HOURS_AND_MINUTES = re.compile(r"(\d+)\s*h\s*(\d+)\s*(?:m|mins?|minutes)?")
+# '1:30'
+_CLOCK = re.compile(r"(\d+):(\d{1,2})")
+
+
+def parse_duration(text):
+    """Returns the length in minutes of `text`, e.g. '1h30' -> 90.
+
+    Case and surrounding spaces are ignored. Raises ValueError for empty input, zero, or anything unrecognised.
+    """
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("empty duration")
+
+    if match := _MINUTES_ONLY.fullmatch(cleaned):
+        minutes = int(match[1])
+    elif match := _HOURS_ONLY.fullmatch(cleaned):
+        minutes = int(match[1]) * 60
+    elif match := _HOURS_AND_MINUTES.fullmatch(cleaned) or _CLOCK.fullmatch(cleaned):
+        if int(match[2]) > 59:
+            raise ValueError(f"'{text}' has more than 59 minutes")
+        minutes = int(match[1]) * 60 + int(match[2])
+    else:
+        raise ValueError(f"'{text}' is not a duration")
+
+    if minutes == 0:
+        raise ValueError(f"'{text}' is zero length")
+    return minutes
