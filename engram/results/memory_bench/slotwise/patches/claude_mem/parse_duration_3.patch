@@ -0,0 +1,42 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_reads_each_supported_form(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            self.assertEqual(parse_duration(text), minutes, text)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H30 "), 90)
+        self.assertEqual(parse_duration("45 MIN"), 45)
+
+    def test_refuses_empty_input(self):
+        for text in ["", "   "]:
+            with self.assertRaises(ValueError, msg=repr(text)):
+                parse_duration(text)
+
+    def test_refuses_zero(self):
+        for text in ["0", "0m", "0h", "0:00"]:
+            with self.assertRaises(ValueError, msg=text):
+                parse_duration(text)
+
+    def test_refuses_anything_else(self):
+        for text in ["abc", "-5", "1h90", "1.5h", "45 seconds"]:
+            with self.assertRaises(ValueError, msg=text):
+                parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
