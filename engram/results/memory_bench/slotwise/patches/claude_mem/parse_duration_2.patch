+"""Read appointment lengths typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*(?:min|m)?")
+_HOURS = re.compile(r"(\d+)\s*h(?:\s*(\d{1,2})\s*(?:min|m)?)?")
+_CLOCK = re.compile(r"(\d+)\s*:\s*(\d{1,2})")
+
+
+def parse_duration(text):
+    """Return the length in minutes, e.g. '1h30' -> 90. Raises ValueError if unreadable or zero."""
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("duration is empty")
+
+    if match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+    elif match := _HOURS.fullmatch(cleaned):
+        minutes = _with_minutes(int(match[1]), match[2])
+    elif match := _CLOCK.fullmatch(cleaned):
+        minutes = _with_minutes(int(match[1]), match[2])
+    else:
+        raise ValueError(f"unrecognised duration: {text!r}")
+
+    if minutes == 0:
+        raise ValueError("duration must be more than zero")
+    return minutes
+
+
+def _with_minutes(hours, minutes_text):
+    minutes = int(minutes_text or 0)
+    if minutes >= 60:
+        raise ValueError("minutes must be below 60 when hours are given")
+    return hours * 60 + minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
