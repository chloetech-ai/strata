             raise ValueError(f"{monday} is not a Monday")
         days = [monday + datetime.timedelta(days=i) for i in range(7)]
         return {day: [a for a in self.appointments_for(therapist, day) if not a.cancelled] for day in days}
+
+    def is_fully_booked(self, therapist, day):
+        """True if no treatment fits in `therapist`'s free time on `day`, breaks included.
+
+        A closed day is not booked up, so it returns False.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return False
+        opens, closes = hours
+        shortest = min(minutes for minutes, _ in TREATMENTS.values())
+        needed = datetime.timedelta(minutes=shortest)
+        # Each booking blocks its own time plus a break either side, as in `book`.
+        blocked = sorted(
+            (a.start - BREAK, a.end + BREAK)
+            for a in self.appointments_for(therapist, day)
+            if not a.cancelled
+        )
+        free_from = opens
+        for blocked_start, blocked_end in blocked:
+            if blocked_start - free_from >= needed:
+                return False
+            free_from = max(free_from, blocked_end)
+        return closes - free_from < needed
