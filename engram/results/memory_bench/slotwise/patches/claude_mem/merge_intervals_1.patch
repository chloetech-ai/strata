@@ -0,0 +1,17 @@
+"""Merging of (start, end) intervals."""
+
+
+def merge_intervals(intervals):
+    """Merge overlapping or touching (start, end) pairs.
+
+    Accepts ints or datetimes (all of one kind). Returns a new list of tuples
+    sorted by start; the input list is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            last_start, last_end = merged[-1]
+            merged[-1] = (last_start, max(last_end, end))
+        else:
+            merged.append((start, end))
+    return merged
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
