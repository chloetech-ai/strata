+++ b/src/slotwise/series.py
@@ -0,0 +1,34 @@
+"""Booking a weekly series of appointments."""
+
+import datetime
+
+from .errors import SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# Most sessions one series may book.
+MAX_SERIES = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, on the same weekday and time.
+
+    A week whose slot is taken is skipped and the series moves on to the next week,
+    so the series always gets `count` sessions. Any other refusal (unknown treatment,
+    practice closed) applies to every week alike, so it is raised on the first week
+    before anything is booked. Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise ValueError(f"count must be at least 1, not {count}")
+    if count > MAX_SERIES:
+        raise SeriesTooLong(f"A series can have at most {MAX_SERIES} sessions, not {count}.")
+    booked = []
+    week = 0
+    while len(booked) < count:
+        start = first.start + datetime.timedelta(weeks=week)
+        session = first if week == 0 else Appointment(first.therapist, first.client, start, first.treatment)
+        week += 1
+        try:
+            booked.append(schedule.book(session))
+        except SlotTaken:
+            continue
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..dce83e8
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,74 @@
+import datetime
+import unittest
+
+from slotwise.errors import OutsideOpeningHours, SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+# 2026-09-08 is a Tuesday; the series repeats on Tuesdays at 09:00.
+TUESDAY = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def first(start=TUESDAY, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, start, "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [TUESDAY, TUESDAY + datetime.timedelta(weeks=1), TUESDAY + datetime.timedelta(weeks=2)])
+        self.assertEqual(s.appointments, booked)
+
+    def test_first_is_the_first_booked_appointment(self):
+        s = Schedule()
+        f = first()
+        booked = book_series(s, f, 2)
+        self.assertIs(booked[0], f)
+        self.assertEqual(booked[1].client, "Kim Weber")
+        self.assertEqual(booked[1].therapist, "lena")
+        self.assertEqual(booked[1].treatment, "standard")
+
+    def test_skips_a_taken_week_and_appends_one_more(self):
+        s = Schedule()
+        s.book(first(start=TUESDAY + datetime.timedelta(weeks=1), client="Jo Li"))
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [TUESDAY, TUESDAY + datetime.timedelta(weeks=2), TUESDAY + datetime.timedelta(weeks=3)])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_first_week_taken_starts_the_series_a_week_later(self):
+        s = Schedule()
+        s.book(first(client="Jo Li"))
+        booked = book_series(s, first(), 2)
+        self.assertEqual([a.start for a in booked], [TUESDAY + datetime.timedelta(weeks=1), TUESDAY + datetime.timedelta(weeks=2)])
+
+    def test_other_therapist_does_not_block(self):
+        s = Schedule()
+        s.book(first(therapist="marco", client="Jo Li"))
+        self.assertEqual(len(book_series(s, first(), 2)), 2)
+
+    def test_more_than_nine_is_refused_and_nothing_is_booked(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, first(), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first(), 9)), 9)
+
+    def test_closed_day_is_refused_and_nothing_is_booked(self):
+        s = Schedule()
+        sunday = first(start=datetime.datetime(2026, 9, 13, 9, 0))
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, sunday, 3)
+        self.assertEqual(s.appointments, [])
+
+    def test_count_below_one_is_a_programming_error(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
