+++ b/tests/test_printing.py
@@ -0,0 +1,53 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber", day=MONDAY):
+    return Appointment(therapist, client, datetime.datetime.combine(day, datetime.time(hour, minute)), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_bookings_in_time_order(self):
+        s = Schedule()
+        s.book(at(14, client="Jo Li", treatment="short"))
+        s.book(at(9, client="Kim Weber"))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan: Lena, Monday 7 September 2026\n"
+            "\n"
+            "09:00-09:45  Kim Weber  standard (45 min)\n"
+            "14:00-14:30  Jo Li  short (30 min)",
+        )
+
+    def test_leaves_out_cancelled_bookings(self):
+        s = Schedule()
+        s.book(at(9, client="Kim Weber"))
+        cancelled = s.book(at(10, client="Jo Li"))
+        s.cancel(cancelled.id)
+        self.assertNotIn("Jo Li", day_plan(s, "lena", MONDAY))
+
+    def test_only_this_therapists_and_day(self):
+        s = Schedule()
+        s.book(at(9, client="Kim Weber"))
+        s.book(at(9, therapist="max", client="Jo Li"))
+        s.book(at(9, client="Ana Ruiz", day=MONDAY + datetime.timedelta(days=1)))
+        text = day_plan(s, "lena", MONDAY)
+        self.assertIn("Kim Weber", text)
+        self.assertNotIn("Jo Li", text)
+        self.assertNotIn("Ana Ruiz", text)
+
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(Schedule(), "lena", MONDAY),
+            "Day plan: Lena, Monday 7 September 2026\n\nNo appointments.",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
