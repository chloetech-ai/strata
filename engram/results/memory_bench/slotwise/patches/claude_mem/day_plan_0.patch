+"""Printed sheets for reception."""
+
+
+def day_plan(schedule, therapist, day):
+    """Text listing `therapist`'s bookings on `day`, in time order, for reception to print. Cancelled bookings are left out."""
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    lines = [f"Day plan: {therapist.capitalize()}, {day:%A} {day.day} {day:%B} {day.year}", ""]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment} ({a.minutes} min)")
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
