+    def test_empty_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_closed_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 13)))  # Sunday
+
+    def test_full_day_is_fully_booked(self):
+        # Saturday opens 08:00 and closes 12:00. Back-to-back 30-minute slots with 10-minute breaks
+        # leave no gap for another 30-minute slot once the last one starts at 11:20.
+        s = Schedule()
+        for hour, minute in [(8, 0), (8, 40), (9, 20), (10, 0), (10, 40), (11, 20)]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), "short"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+
+    def test_one_slot_short_is_not_fully_booked(self):
+        s = Schedule()
+        for hour, minute in [(8, 0), (8, 40), (9, 20), (10, 0), (10, 40)]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), "short"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+
+    def test_cancelling_reopens_a_full_day(self):
+        s = Schedule()
+        slots = [s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, h, m), "short"))
+                 for h, m in [(8, 0), (8, 40), (9, 20), (10, 0), (10, 40), (11, 20)]]
+        s.cancel(slots[2].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+
+    def test_other_therapists_bookings_do_not_fill_the_day(self):
+        s = Schedule()
+        for hour, minute in [(8, 0), (8, 40), (9, 20), (10, 0), (10, 40), (11, 20)]:
+            s.book(Appointment("marco", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), "short"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+        self.assertTrue(s.is_fully_booked("marco", datetime.date(2026, 9, 12)))
+
