+    def test_reschedule_moves_and_keeps_id(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 9, 14, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 9, 14, 0))
+        self.assertEqual(a.client, "Kim Weber")
+        self.assertIs(s.get(a.id), a)
+
+    def test_reschedule_frees_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 9, 14, 0))
+        s.book(at(9, client="Jo Li"))
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 5))
+
+    def test_reschedule_into_taken_slot_leaves_it_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_needs_break_from_others(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))  # ends 14:45
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 50))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 55))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 14, 55))
+
+    def test_reschedule_outside_opening_hours_leaves_it_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_cancelled_raises(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_unknown_appointment_raises(self):
+        with self.assertRaises(KeyError):
+            Schedule().reschedule(-1, datetime.datetime(2026, 9, 8, 9, 0))
+
