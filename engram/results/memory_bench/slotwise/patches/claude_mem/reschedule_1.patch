     def book(self, appointment):
         """Adds `appointment` if the practice is open and the therapist is free, with a break either side."""
+        self._check_slot(appointment)
+        self.appointments.append(appointment)
+        return appointment
+
+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to `new_start`, keeping its treatment, therapist and client.
+
+        The new time must pass the same checks as a new booking. The appointment's own old slot is not
+        counted as a conflict, so it can be moved by a few minutes. If the move is refused, nothing changes.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment is cancelled, so it cannot be moved. Please book a new one.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check_slot(moved, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
+    def get(self, appointment_id):
+        for appointment in self.appointments:
+            if appointment.id == appointment_id:
+                return appointment
+        raise KeyError(appointment_id)
+
+    def cancel(self, appointment_id):
+        """Marks the appointment cancelled, freeing its slot. The record is kept for fees."""
+        appointment = self.get(appointment_id)
+        appointment.cancelled = True
+        return appointment
+
+    def _check_slot(self, appointment, ignore=None):
+        """Raises BookingError unless `appointment` can go in its slot. `ignore` is an existing appointment to skip."""
         if appointment.treatment not in TREATMENTS:
             raise BookingError(f"We don't offer a treatment called '{appointment.treatment}'.")
         if not is_open_between(appointment.start, appointment.end):
