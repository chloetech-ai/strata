+    def test_reschedule_moves_the_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.treatment, "standard")
+        self.assertEqual(a.client, "Kim Weber")
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_frees_the_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        s.book(at(9, client="Jo Li"))
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_reschedule_can_shift_by_a_few_minutes(self):
+        s = Schedule()
+        a = s.book(at(9))  # ends 09:45, so it would clash with itself
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 15))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 15))
+
+    def test_reschedule_into_a_taken_slot_leaves_it_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 50))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_outside_opening_hours_leaves_it_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_unknown_appointment_raises(self):
+        with self.assertRaises(KeyError):
+            Schedule().reschedule(-1, datetime.datetime(2026, 9, 8, 11, 0))
+
