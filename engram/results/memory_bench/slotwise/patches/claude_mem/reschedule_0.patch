+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to `new_start`, keeping its id. Refused moves leave it where it was."""
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment has been cancelled, so it can't be moved. Book a new one instead.")
+        self._check_slot(replace(appointment, start=new_start), ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
+    def get(self, appointment_id):
