+    def test_reschedule_moves_and_keeps_id(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(s.get(a.id), a)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_can_shift_within_its_own_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start.hour, 9)
+        self.assertEqual(a.start.minute, 5)
+
+    def test_reschedule_into_taken_slot_leaves_original(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 55))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_needs_break_after_new_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 10))  # ends 10:55, inside break before 11:00
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 5))  # ends 10:50, ten minutes clear
+
+    def test_reschedule_ignores_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, therapist="marco", client="Jo Li"))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start.hour, 11)
+
+    def test_reschedule_outside_opening_hours_leaves_original(self):
