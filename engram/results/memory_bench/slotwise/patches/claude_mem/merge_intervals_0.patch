@@ -0,0 +1,15 @@
+"""Interval helpers for slotwise: merging (start, end) pairs of ints or datetimes."""
+
+
+def merge_intervals(intervals):
+    """Merge overlapping or touching (start, end) pairs.
+
+    Returns a new list of (start, end) tuples sorted by start. The input is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals, key=lambda pair: pair[0]):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
