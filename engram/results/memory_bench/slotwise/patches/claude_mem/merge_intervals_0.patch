+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_and_touching_pairs_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 6), (6, 8), (10, 12)]), [(1, 8), (10, 12)])
+
+    def test_unsorted_input_and_contained_pairs(self):
+        self.assertEqual(merge_intervals([(5, 9), (1, 2), (3, 10), (4, 6)]), [(1, 2), (3, 10)])
+
+    def test_disjoint_pairs_stay_separate_and_sorted(self):
+        self.assertEqual(merge_intervals([(8, 9), (1, 2)]), [(1, 2), (8, 9)])
+
+    def test_empty_input(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_datetimes(self):
+        result = merge_intervals([
+            (DT(2026, 9, 7, 10, 0), DT(2026, 9, 7, 11, 0)),
+            (DT(2026, 9, 7, 9, 0), DT(2026, 9, 7, 10, 0)),
+        ])
+        self.assertEqual(result, [(DT(2026, 9, 7, 9, 0), DT(2026, 9, 7, 11, 0))])
+
+    def test_input_is_not_modified(self):
+        pairs = [(5, 9), (1, 2), (3, 10)]
+        merge_intervals(pairs)
+        self.assertEqual(pairs, [(5, 9), (1, 2), (3, 10)])
+
+
+if __name__ == "__main__":
+    unittest.main()
