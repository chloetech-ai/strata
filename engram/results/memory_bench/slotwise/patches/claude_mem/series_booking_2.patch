diff --git a/src/slotwise/series.py b/src/slotwise/series.py
new file mode 100644
index 0000000..2b52183
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,49 @@
+"""Booking a weekly series of appointments."""
+
+import datetime
+
+from .errors import BookingError
+from .model import Appointment
+
+# A series is a course of treatment; more sessions than this need a new referral.
+MAX_SESSIONS = 9
+# How many weeks ahead to look for free weeks when some weeks in the series are taken.
+SEARCH_WEEKS = 52
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments starting with `first`, at the same weekday and time.
+
+    Weeks where the therapist is busy or the practice is closed are skipped, and the series
+    runs on into later weeks instead. `first` itself must be bookable. If the series cannot
+    be completed, nothing is booked. Returns the booked appointments in date order.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series can have between 1 and {MAX_SESSIONS} sessions, not {count}.")
+    booked = [schedule.book(first)]
+    week = 1
+    while len(booked) < count:
+        if week > SEARCH_WEEKS:
+            _unbook(schedule, booked)
+            raise BookingError(
+                f"Could not find {count} free weeks for this series within {SEARCH_WEEKS} weeks. "
+                "Please choose another time."
+            )
+        candidate = Appointment(
+            first.therapist,
+            first.client,
+            first.start + datetime.timedelta(weeks=week),
+            first.treatment,
+        )
+        try:
+            booked.append(schedule.book(candidate))
+        except BookingError:
+            pass
+        week += 1
+    return booked
+
+
+def _unbook(schedule, appointments):
+    """Removes `appointments` from `schedule`, matched by identity."""
+    gone = {id(a) for a in appointments}
+    schedule.appointments[:] = [a for a in schedule.appointments if id(a) not in gone]
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..aa57984
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,81 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import SEARCH_WEEKS, book_series
+
+# A Tuesday.
+FIRST = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def appt(start=FIRST, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, start, "standard")
+
+
+def weeks(n):
+    return datetime.timedelta(weeks=n)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_time(self):
+        s = Schedule()
+        booked = book_series(s, appt(), 3)
+        self.assertEqual([a.start for a in booked], [FIRST, FIRST + weeks(1), FIRST + weeks(2)])
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_first_is_the_given_appointment(self):
+        s = Schedule()
+        first = appt()
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+        self.assertIs(s.get(first.id), first)
+
+    def test_copies_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, appt(), 2)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("lena", "Kim Weber", "standard")})
+
+    def test_busy_week_is_skipped_and_series_runs_on(self):
+        s = Schedule()
+        s.book(appt(FIRST + weeks(1), client="Jo Li"))
+        booked = book_series(s, appt(), 3)
+        self.assertEqual([a.start for a in booked], [FIRST, FIRST + weeks(2), FIRST + weeks(3)])
+
+    def test_other_therapist_does_not_block(self):
+        s = Schedule()
+        s.book(appt(FIRST + weeks(1), therapist="mo", client="Jo Li"))
+        booked = book_series(s, appt(), 2)
+        self.assertEqual(booked[1].start, FIRST + weeks(1))
+
+    def test_first_must_be_bookable(self):
+        s = Schedule()
+        s.book(appt(client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, appt(), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_count_above_maximum_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, appt(), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_count_below_one_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, appt(), 0)
+
+    def test_nothing_is_booked_when_series_cannot_be_completed(self):
+        s = Schedule()
+        for week in range(1, SEARCH_WEEKS + 1):
+            s.book(appt(FIRST + weeks(week), client="Jo Li"))
+        before = list(s.appointments)
+        with self.assertRaises(BookingError):
+            book_series(s, appt(), 2)
+        self.assertEqual(s.appointments, before)
+
+
+if __name__ == "__main__":
+    unittest.main()
