+++ b/tests/test_fees.py
@@ -0,0 +1,38 @@
+import datetime
+import unittest
+from types import SimpleNamespace
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.standard = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def at(self, hours_before):
+        return self.start - datetime.timedelta(hours=hours_before)
+
+    def test_free_with_48_hours_or_more(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at(48)), 0)
+        self.assertEqual(cancellation_fee(self.standard, self.at(72)), 0)
+
+    def test_half_price_from_24_to_under_48_hours(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at(47.99)), 4900)
+        self.assertEqual(cancellation_fee(self.standard, self.at(24)), 4900)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at(23.99)), 9800)
+        self.assertEqual(cancellation_fee(self.standard, self.at(0)), 9800)
+
+    def test_cancelling_after_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at(-1)), 9800)
+
+    def test_half_price_rounds_up_to_the_next_cent(self):
+        odd = SimpleNamespace(start=self.start, price=9801)
+        self.assertEqual(cancellation_fee(odd, self.at(30)), 4901)
+
+
+if __name__ == "__main__":
+    unittest.main()
