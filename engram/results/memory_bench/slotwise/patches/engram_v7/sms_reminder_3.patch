@@ -0,0 +1,41 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_NUMBER, reminder_text
+
+
+def appointment(client="Anna Muster", therapist="Lena Keller"):
+    return Appointment(therapist, client, datetime.datetime(2026, 11, 3, 9, 15))
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_time_and_reception_number(self):
+        text = reminder_text(appointment())
+        self.assertIn("03.11.2026", text)
+        self.assertIn("09:15", text)
+        self.assertIn(RECEPTION_NUMBER, text)
+
+    def test_umlauts_and_accents_become_plain_ascii(self):
+        text = reminder_text(appointment(client="Zoë Brändli", therapist="Jürg Müller"))
+        self.assertEqual(text.encode("ascii").decode("ascii"), text)
+        self.assertIn("Braendli", text)
+        self.assertIn("Zoe", text)
+        self.assertIn("Juerg Mueller", text)
+
+    def test_long_names_still_fit(self):
+        text = reminder_text(appointment(client="Maria-Theresia " + "Brändli-" * 4 + "Sutter"))
+        self.assertLessEqual(len(text), MAX_LENGTH)
+        self.assertIn(RECEPTION_NUMBER, text)
+
+    def test_refuses_text_over_160_characters(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client="x" * 200))
+
+    def test_refuses_names_without_an_ascii_form(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client="王小明"))
+
+
+if __name__ == "__main__":
+    unittest.main()
