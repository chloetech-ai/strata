+"""Text of the SMS reminders sent before appointments."""
+
+import unicodedata
+
+from .model import Appointment
+
+RECEPTION_NUMBER = "044 512 77 30"
+MAX_LENGTH = 160
+
+# Umlauts and sharp s get their conventional spelling; other accents are dropped by NFKD below.
+_TRANSLITERATIONS = str.maketrans({"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"})
+
+
+def _ascii(text):
+    """Plain ASCII version of `text`; raises ValueError for characters that have no ASCII form."""
+    decomposed = unicodedata.normalize("NFKD", text.translate(_TRANSLITERATIONS))
+    decomposed = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    try:
+        return decomposed.encode("ascii", "strict").decode("ascii")
+    except UnicodeEncodeError:
+        bad = sorted({ch for ch in decomposed if ord(ch) > 127})
+        raise ValueError(f"cannot transliterate {text!r} to ASCII: {''.join(bad)!r}") from None
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """The reminder SMS for `appointment`: plain ASCII, at most 160 characters, always with the reception number."""
+    when = appointment.start
+    text = (
+        f"Guten Tag {appointment.client}. Erinnerung: Ihr Termin bei {appointment.therapist} "
+        f"am {when:%d.%m.%Y} um {when:%H:%M}. Verschieben: {RECEPTION_NUMBER}"
+    )
+    text = _ascii(text)
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}: {text!r}")
+    return text
