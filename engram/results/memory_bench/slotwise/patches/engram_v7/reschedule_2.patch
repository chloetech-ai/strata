+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to start at `new_start`, keeping its treatment and id.
+
+        The same checks as `book()` apply, ignoring the appointment's own old slot.
+        If the move is refused, the appointment is left where it was.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError(
+                f"Appointment {appointment_id} is cancelled, so it cannot be moved. Book a new appointment instead."
+            )
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check(moved)
+        appointment.start = new_start
+        return appointment
