+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_sorted_by_start(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_and_touching_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 7), (9, 10)]), [(1, 7), (9, 10)])
+
+    def test_contained_interval_keeps_outer_end(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_unsorted_input_is_not_modified(self):
+        intervals = [(8, 9), (1, 2), (2, 4)]
+        self.assertEqual(merge_intervals(intervals), [(1, 4), (8, 9)])
+        self.assertEqual(intervals, [(8, 9), (1, 2), (2, 4)])
+
+    def test_datetimes(self):
+        self.assertEqual(
+            merge_intervals([
+                (DT(2026, 9, 8, 9, 0), DT(2026, 9, 8, 9, 45)),
+                (DT(2026, 9, 8, 9, 45), DT(2026, 9, 8, 10, 30)),
+                (DT(2026, 9, 8, 11, 0), DT(2026, 9, 8, 11, 45)),
+            ]),
+            [(DT(2026, 9, 8, 9, 0), DT(2026, 9, 8, 10, 30)), (DT(2026, 9, 8, 11, 0), DT(2026, 9, 8, 11, 45))],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
