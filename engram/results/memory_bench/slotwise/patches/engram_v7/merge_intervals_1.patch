@@ -0,0 +1,13 @@
+def merge_intervals(intervals):
+    """Merge (start, end) pairs that overlap or touch; return them sorted by start.
+
+    Works with ints or datetimes. The input list is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
