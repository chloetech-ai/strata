@@ -0,0 +1,17 @@
+"""Cancellation fees."""
+
+import datetime
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before the start costs the full price, less than 48 hours
+    costs half, and 48 hours or more before the start is free.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < datetime.timedelta(hours=24):
+        return appointment.price
+    if notice < datetime.timedelta(hours=48):
+        return appointment.price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..73faf90
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,36 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.appointment = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def cancel_after(self, notice):
+        return cancellation_fee(self.appointment, self.start - notice)
+
+    def test_more_than_48_hours_notice_is_free(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=49)), 0)
+
+    def test_exactly_48_hours_notice_is_free(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=48)), 0)
+
+    def test_less_than_48_hours_notice_is_half_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=47, minutes=59)), 4900)
+
+    def test_exactly_24_hours_notice_is_half_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=24)), 4900)
+
+    def test_less_than_24_hours_notice_is_full_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=23, minutes=59)), 9800)
+
+    def test_cancelling_after_the_start_is_full_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=-1)), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
