@@ -138,6 +138,35 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             s.week("lena", datetime.date(2026, 9, 8))
 
+    def test_fully_booked_at_seven_treatments(self):
+        s = Schedule()
+        for i in range(6):
+            s.book(at(8 + i * 1, client=f"Client {i}"))  # 08:00 to 13:00 starts, one per hour
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        s.book(at(14, client="Client 6"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_book_still_allows_an_eighth_treatment(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(at(8 + i, client=f"Client {i}"))
+        s.book(at(15, client="Client 7"))
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+
+    def test_cancelled_appointments_do_not_count(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(at(8 + i, client=f"Client {i}"))
+        s.cancel(s.appointments[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_other_therapist_and_day_do_not_count(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(at(8 + i, client=f"Client {i}"))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
 
 if __name__ == "__main__":
