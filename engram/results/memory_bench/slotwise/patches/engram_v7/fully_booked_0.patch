+
+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` already has the contract maximum of treatments on `day`.
+
+        Only the online booking page checks this; `book()` still allows more when the therapist agrees.
+        """
+        active = [a for a in self.appointments_for(therapist, day) if not a.cancelled]
+        return len(active) >= MAX_TREATMENTS_PER_DAY
