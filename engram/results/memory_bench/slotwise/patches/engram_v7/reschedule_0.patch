+        self.assertEqual(a.treatment, "initial")
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 15))
+        self.assertEqual(a.start.hour, 9)
+        self.assertEqual(a.start.minute, 15)
+
+    def test_reschedule_into_taken_slot_leaves_appointment_unchanged(self):
+        s = Schedule()
+        s.book(at(9))
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "Lena already has an appointment from 09:00 to 09:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_respects_break(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "10-minute break"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 55))  # exactly 10 minutes after
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 55))
+
+    def test_reschedule_outside_opening_hours_is_refused(self):
+        s = Schedule()
