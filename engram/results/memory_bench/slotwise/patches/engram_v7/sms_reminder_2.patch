+"""SMS reminders for appointments."""
+
+import unicodedata
+
+# The SMS gateway takes plain ASCII only and a reminder over 160 characters is billed as two messages.
+MAX_LENGTH = 160
+RECEPTION_NUMBER = "044 512 77 30"
+
+# Written out before accents are stripped, so 'Brändli' becomes 'Braendli' rather than 'Brandli'.
+_UMLAUTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def to_ascii(text):
+    """Plain ASCII version of `text`: umlauts spelled out, other accents dropped."""
+    for char, replacement in _UMLAUTS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`, in plain ASCII and at most 160 characters.
+
+    Raises ValueError if the text would be longer than 160 characters."""
+    when = appointment.start.strftime("%d.%m.%Y um %H:%M")
+    text = to_ascii(
+        f"Erinnerung: Termin bei {appointment.therapist} am {when} "
+        f"fuer {appointment.client}. Verschieben bitte unter {RECEPTION_NUMBER}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"Reminder is {len(text)} characters, the limit is {MAX_LENGTH}: {text}")
+    return text
