@@ -0,0 +1,46 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_NUMBER, reminder_text, to_ascii
+
+
+def appointment(client="Anna Brändli", therapist="Dr. Müller", start=datetime.datetime(2026, 10, 20, 9, 30)):
+    return Appointment(therapist=therapist, client=client, start=start)
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_are_spelled_out(self):
+        self.assertEqual(to_ascii("Brändli Müller Böhler Ärger"), "Braendli Mueller Boehler Aerger")
+
+    def test_other_accents_are_dropped(self):
+        self.assertEqual(to_ascii("Zoë café"), "Zoe cafe")
+
+    def test_eszett_is_spelled_out(self):
+        self.assertEqual(to_ascii("Strasse Grüße"), "Strasse Gruesse")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text_is_plain_ascii_with_transliterated_name(self):
+        text = reminder_text(appointment())
+        self.assertTrue(text.isascii())
+        self.assertIn("Anna Braendli", text)
+        self.assertIn("Dr. Mueller", text)
+
+    def test_text_names_the_date_and_time(self):
+        self.assertIn("20.10.2026 um 09:30", reminder_text(appointment()))
+
+    def test_text_contains_reception_number(self):
+        self.assertIn(RECEPTION_NUMBER, reminder_text(appointment()))
+
+    def test_text_fits_in_one_sms(self):
+        self.assertLessEqual(len(reminder_text(appointment())), MAX_LENGTH)
+
+    def test_too_long_reminder_is_refused(self):
+        long_name = "A" * 200
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client=long_name))
+
+
+if __name__ == "__main__":
+    unittest.main()
