+    def reschedule(self, appointment_id, new_start):
+        """Moves the appointment to start at `new_start`, keeping its treatment length.
+
+        Raises a BookingError subclass and leaves the appointment unchanged if the new time is refused.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError(
+                f"Appointment {appointment.id} is cancelled and cannot be moved. Book a new appointment instead."
+            )
+        new_end = new_start + (appointment.end - appointment.start)
+        self._check_slot(appointment, new_start, new_end)
+        appointment.start = new_start
+        return appointment
