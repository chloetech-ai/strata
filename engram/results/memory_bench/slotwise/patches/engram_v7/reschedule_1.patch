@@ -107,6 +107,65 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(KeyError):
             s.cancel(-1)
 
+    def test_reschedule_moves_and_keeps_length(self):
+        s = Schedule()
+        a = s.book(at(9, treatment="initial"))  # 60 minutes
+        self.assertIs(s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0)), a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.end, datetime.datetime(2026, 9, 8, 12, 0))
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 20))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 20))
+
+    def test_reschedule_onto_taken_slot_is_refused_and_unchanged(self):
+        s = Schedule()
+        s.book(at(9))
+        b = s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "Lena already has an appointment from 09:00 to 09:45"):
+            s.reschedule(b.id, datetime.datetime(2026, 9, 8, 9, 30))
+        self.assertEqual(b.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_enforces_break(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        b = s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "10-minute break"):
+            s.reschedule(b.id, datetime.datetime(2026, 9, 8, 9, 50))
+        s.reschedule(b.id, datetime.datetime(2026, 9, 8, 9, 55))  # exactly 10 minutes after is allowed
+        self.assertEqual(b.start, datetime.datetime(2026, 9, 8, 9, 55))
+
+    def test_reschedule_outside_opening_hours_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_ignores_cancelled_appointments_in_the_way(self):
+        s = Schedule()
+        s.book(at(9))
+        a = s.book(at(11, client="Jo Li"))
+        cancelled = s.book(at(14, client="Kim Weber"))
+        s.cancel(cancelled.id)
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 14, 0))
+
+    def test_cancelled_appointment_cannot_be_rescheduled(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_unknown_id_raises(self):
+        s = Schedule()
+        with self.assertRaises(KeyError):
+            s.reschedule(-1, datetime.datetime(2026, 9, 8, 11, 0))
+
