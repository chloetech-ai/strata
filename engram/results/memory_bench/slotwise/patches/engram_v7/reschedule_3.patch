diff --git a/tests/test_schedule.py b/tests/test_schedule.py
index 7d266d6..dd42f22 100644
--- a/tests/test_schedule.py
+++ b/tests/test_schedule.py
@@ -107,6 +107,65 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(KeyError):
             s.cancel(-1)
 
+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        new_start = datetime.datetime(2026, 9, 8, 11, 0)
+        self.assertIs(s.reschedule(a.id, new_start), a)
+        self.assertEqual(a.start, new_start)
+        self.assertEqual(a.end, new_start + datetime.timedelta(minutes=45))  # same treatment length
+        s.book(at(9, client="Jo Li"))  # the old slot is free now
+
+    def test_reschedule_into_taken_slot_leaves_appointment_where_it_was(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "Lena already has an appointment from 11:00 to 11:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 40))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_enforces_break(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "10-minute break"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 55))  # exactly 10 minutes after is allowed
+
+    def test_reschedule_can_shift_within_own_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 15))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 15))
+
+    def test_reschedule_outside_opening_hours_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_ignores_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        b = s.book(at(11, client="Jo Li"))
+        s.cancel(b.id)
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_unknown_id_raises(self):
+        s = Schedule()
+        with self.assertRaises(KeyError):
+            s.reschedule(-1, datetime.datetime(2026, 9, 8, 11, 0))
+
