+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to `new_start`, keeping its treatment and id.
+
+        Checks the new time the same way `book()` does, ignoring the appointment's own old slot.
+        If the new time is refused, the appointment is left where it was.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError(f"Appointment {appointment_id} is cancelled, so it cannot be moved. Book a new one instead.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check(moved)
+        appointment.start = new_start
+        return appointment
