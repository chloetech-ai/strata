+    def test_fully_booked_at_seven_a_day(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for i in range(6):
+            s.book(short_at(i))  # 09:00, 09:40, 10:20, ...
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(at(14, 0, treatment="short", client="Jo Li"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_book_still_allows_an_eighth_treatment(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(short_at(i))
+        s.book(at(14, 0, treatment="short", client="Jo Li"))
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+
+    def test_cancelled_does_not_count_towards_full(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(short_at(i)) for i in range(7)]
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(short_at(i))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
