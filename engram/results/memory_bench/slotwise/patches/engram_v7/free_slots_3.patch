+    def test_free_slots_on_empty_day_cover_opening_to_closing(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # last one that ends by 19:00
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(b - a == datetime.timedelta(minutes=15) for a, b in zip(slots, slots[1:])))
+
+    def test_free_slots_closed_day_is_empty(self):
+        s = Schedule()
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_leave_out_overlap_and_break(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so starts 08:15 to 09:45 are blocked for a 45-minute treatment
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        blocked = [datetime.datetime(2026, 9, 8, 8, m) for m in (15, 30, 45)] + [
+            datetime.datetime(2026, 9, 8, 9, m) for m in (0, 15, 30, 45)
+        ]
+        for moment in blocked:
+            self.assertNotIn(moment, slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, break ends 08:55
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # first start after the 10-minute break
+
+    def test_free_slots_agree_with_book(self):
+        s = Schedule()
+        s.book(at(9))
+        day = datetime.date(2026, 9, 8)
+        listed = set(s.free_slots("lena", day, 45))
+        for h in range(7, 19):
+            for m in (0, 15, 30, 45):
+                moment = datetime.datetime(2026, 9, 8, h, m)
+                trial = Schedule()
+                trial.book(at(9))
+                try:
+                    trial.book(Appointment("lena", "Jo Li", moment, "standard"))
+                    accepted = True
+                except BookingError:
+                    accepted = False
+                self.assertEqual(moment in listed, accepted, moment)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
