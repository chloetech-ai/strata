@@ -0,0 +1,16 @@
+"""Helpers for working with (start, end) intervals."""
+
+
+def merge_intervals(intervals):
+    """Merge intervals that overlap or touch.
+
+    Takes (start, end) pairs of ints or datetimes and returns a new list of
+    (start, end) tuples sorted by start. The input list is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
