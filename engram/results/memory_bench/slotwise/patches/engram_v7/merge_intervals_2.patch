@@ -0,0 +1,40 @@
+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_sorted_by_start(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_and_touching_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6), (6, 8)]), [(1, 8)])
+
+    def test_contained_interval_is_absorbed(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_datetimes(self):
+        intervals = [
+            (DT(2026, 9, 8, 10, 0), DT(2026, 9, 8, 10, 45)),
+            (DT(2026, 9, 8, 9, 0), DT(2026, 9, 8, 10, 0)),
+            (DT(2026, 9, 8, 13, 0), DT(2026, 9, 8, 13, 30)),
+        ]
+        self.assertEqual(
+            merge_intervals(intervals),
+            [(DT(2026, 9, 8, 9, 0), DT(2026, 9, 8, 10, 45)), (DT(2026, 9, 8, 13, 0), DT(2026, 9, 8, 13, 30))],
+        )
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 6), (1, 2), (2, 3)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 2), (2, 3)])
+
+
+if __name__ == "__main__":
+    unittest.main()
