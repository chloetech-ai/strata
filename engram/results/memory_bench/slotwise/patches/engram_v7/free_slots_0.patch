@@ -138,6 +138,51 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             s.week("lena", datetime.date(2026, 9, 8))
 
+    def test_free_slots_empty_day_is_on_grid_from_opening(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))  # last start that ends by 19:00
+        self.assertEqual(len(slots), 43)  # 07:30 to 18:00 in 15-minute steps
+
+    def test_free_slots_closed_day_is_empty(self):
+        s = Schedule()
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 6), 45), [])  # Sunday
+
+    def test_free_slots_leave_out_overlaps_and_breaks(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so a 45-minute treatment needs to start by 08:00 or from 10:00
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # inside the 10-minute break
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_agree_with_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(12, 30, client="Jo Li"))
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        for minute in range(7 * 60 + 30, 19 * 60, 15):
+            start = datetime.datetime(2026, 9, 8, minute // 60, minute % 60)
+            trial = Schedule()
+            trial.appointments = list(s.appointments)
+            if start in slots:
+                trial.book(Appointment("lena", "Max Gut", start, "standard"))  # must not raise
+            else:
+                with self.assertRaises(BookingError):
+                    trial.book(Appointment("lena", "Max Gut", start, "standard"))
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(10, therapist="marco", client="Jo Li"))
+        s.cancel(a.id)
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
 
