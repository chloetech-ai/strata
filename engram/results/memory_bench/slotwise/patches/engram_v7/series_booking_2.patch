diff --git a/src/slotwise/series.py b/src/slotwise/series.py
new file mode 100644
index 0000000..7a5acfc
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,32 @@
+"""Booking a series of weekly sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# The insurance pays for at most 9 sessions per prescription.
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` sessions weekly, on the weekday and time of `first`.
+
+    A week whose slot is already taken is skipped, and the series runs one week
+    longer so the client still gets all `count` sessions. Returns the booked
+    appointments in order. Other refusals (such as closed hours) come from the
+    first week and repeat every week, so they are raised before anything is booked.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series can have 1 to {MAX_SESSIONS} sessions, not {count}.")
+    booked = []
+    week = 0
+    while len(booked) < count:
+        start = first.start + datetime.timedelta(weeks=week)
+        week += 1
+        session = Appointment(first.therapist, first.client, start, first.treatment)
+        try:
+            booked.append(schedule.book(session))
+        except SlotTaken:
+            continue
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..99bc2f3
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,59 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(day, hour, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute))
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_the_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8, 9), 3)  # Tuesdays 8, 15, 22 September
+        self.assertEqual([a.start.day for a in booked], [8, 15, 22])
+        self.assertEqual({a.start.time() for a in booked}, {datetime.time(9, 0)})
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_skips_a_taken_week_and_adds_a_session_at_the_end(self):
+        s = Schedule()
+        s.book(at(15, 9, client="Jo Li"))  # the second week is already taken
+        booked = book_series(s, at(8, 9), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_booked_sessions_are_new_appointments_for_the_client(self):
+        s = Schedule()
+        first = at(8, 9)
+        booked = book_series(s, first, 2)
+        self.assertIsNot(booked[0], first)
+        self.assertEqual({a.client for a in booked}, {"Kim Weber"})
+        self.assertEqual({a.therapist for a in booked}, {"lena"})
+        self.assertEqual(len({a.id for a in booked}), 2)
+
+    def test_more_than_the_maximum_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "1 to 9 sessions, not 12"):
+            book_series(s, at(8, 9), MAX_SESSIONS + 3)
+        self.assertEqual(s.appointments, [])
+
+    def test_maximum_number_of_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(8, 9), MAX_SESSIONS)), MAX_SESSIONS)
+
+    def test_zero_sessions_is_refused(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(8, 9), 0)
+
+    def test_closed_first_session_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(6, 9), 2)  # Sunday
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
