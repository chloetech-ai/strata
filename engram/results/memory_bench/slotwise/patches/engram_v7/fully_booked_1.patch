+    def test_fully_booked_at_seven_treatments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertEqual(len(s.appointments_for("lena", day)), 7)
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_not_fully_booked_below_seven(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_cancelled_does_not_count_towards_full(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        first = None
+        for hour in range(8, 15):
+            a = s.book(at(hour, client=f"Client {hour}"))
+            first = first or a
+        s.cancel(first.id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_book_still_allows_past_the_cap(self):
