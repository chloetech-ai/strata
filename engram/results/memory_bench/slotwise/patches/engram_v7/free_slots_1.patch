+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which an appointment of `minutes` could be booked for `therapist`.
+
+        Candidates are on a 15-minute grid from opening time. Uses the same rules as `book()`,
+        so the 10-minute break and cancelled appointments are handled the same way.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        length = datetime.timedelta(minutes=minutes)
+        start = hours[0]
+        slots = []
+        while start + length <= hours[1]:
+            try:
+                self._check_time(therapist, start, start + length)
+            except BookingError:
+                pass
+            else:
+                slots.append(start)
+            start += datetime.timedelta(minutes=15)
+        return slots
 
