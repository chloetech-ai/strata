@@ -138,6 +138,56 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             s.week("lena", datetime.date(2026, 9, 8))
 
+    def test_free_slots_empty_day_starts_at_opening_on_grid(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))  # last 60 min ends at 19:00
+        self.assertEqual(len(slots), 43)  # 07:30 to 18:00 in 15-minute steps
+
+    def test_free_slots_closed_day_is_empty(self):
+        s = Schedule()
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 6), 45), [])  # Sunday
+
+    def test_free_slots_keep_10_minute_break_on_both_sides(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        morning = [x for x in slots if x <= datetime.datetime(2026, 9, 8, 10, 0)]
+        # 08:00-08:45 ends exactly 10 minutes before 09:00, so it is allowed; 08:15 would end at 09:00 and is not.
+        # Nothing up to 09:45 is allowed, and 10:00 is the first start after the break on the 15-minute grid.
+        self.assertEqual(morning, [datetime.datetime(2026, 9, 8, h, m) for h, m in [(7, 30), (7, 45), (8, 0), (10, 0)]])
+
+    def test_free_slots_skip_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+
+    def test_free_slots_ignore_other_therapists(self):
+        s = Schedule()
+        s.book(at(9, therapist="marco"))
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+
+    def test_free_slots_last_start_ends_at_closing(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 12), 60)  # Saturday, 08:00-12:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 12, 8, 0))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 0))
+
+    def test_every_free_slot_is_accepted_by_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(13, 30, client="Jo Li"))
+        day = datetime.date(2026, 9, 8)
+        for treatment, minutes in [("short", 30), ("standard", 45), ("initial", 60)]:
+            for start in s.free_slots("lena", day, minutes):
+                trial = Schedule()
+                trial.appointments = list(s.appointments)
+                trial.book(Appointment("lena", "Probe", start, treatment))  # must not raise
+
 
