+"""Parsing of treatment durations typed by reception."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*(?:m|min)?")
+_HOURS = re.compile(r"(\d+)\s*h\s*(?:(\d+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"(\d+)\s*:\s*(\d+)")
+
+
+def parse_duration(text):
+    """Minutes for '45', '45m', '45 min', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    s = text.strip().lower()
+    minutes = None
+    if match := _MINUTES.fullmatch(s):
+        minutes = int(match.group(1))
+    elif match := _HOURS.fullmatch(s):
+        minutes = int(match.group(1)) * 60 + int(match.group(2) or 0)
+    elif match := _CLOCK.fullmatch(s):
+        if int(match.group(2)) >= 60:
+            raise ValueError(f"invalid duration: {text!r}")
+        minutes = int(match.group(1)) * 60 + int(match.group(2))
+    if not minutes:
+        raise ValueError(f"invalid duration: {text!r}")
+    return minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..cbcc2d1
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,34 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class DurationTest(unittest.TestCase):
+    def test_formats(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M "), 90)
+        self.assertEqual(parse_duration(" 45 MIN"), 45)
+
+    def test_rejects_empty_zero_and_garbage(self):
+        for text in ["", "   ", "0", "0h", "0:00", "abc", "-5", "1:60", "1h-30", "45 sec"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
