+++ b/tests/test_fees.py
@@ -0,0 +1,42 @@
+import datetime
+import types
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 7, 9, 0)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_more_than_48_hours_before_is_free(self):
+        a = Appointment("lena", "Kim Weber", START, "standard")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=49)), 0)
+
+    def test_exactly_48_hours_before_is_free(self):
+        a = Appointment("lena", "Kim Weber", START, "standard")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+
+    def test_between_24_and_48_hours_before_is_half_price(self):
+        a = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=30)), 7250)
+
+    def test_exactly_24_hours_before_is_half_price(self):
+        a = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=24)), 7250)
+
+    def test_less_than_24_hours_before_is_full_price(self):
+        a = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=2)), 14500)
+
+    def test_half_of_odd_cents_rounds_down(self):
+        a = types.SimpleNamespace(start=START, price=14501)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=30)), 7250)
+
+    def test_after_start_is_full_price(self):
+        a = Appointment("lena", "Kim Weber", START, "short")
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(hours=1)), 6800)
+
+
+if __name__ == "__main__":
+    unittest.main()
