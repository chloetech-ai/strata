index 0000000..24b6765
--- /dev/null
+++ b/src/slotwise/intervals.py
@@ -0,0 +1,14 @@
+def merge_intervals(intervals):
+    """Merge overlapping or touching (start, end) pairs.
+
+    Accepts ints or datetimes. Returns a new list of (start, end) tuples sorted
+    by start; the input list is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            last_start, last_end = merged[-1]
+            merged[-1] = (last_start, max(last_end, end))
+        else:
+            merged.append((start, end))
+    return merged
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..6ad4ce9
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,36 @@
+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_kept_and_sorted(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_touching_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_merged(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_datetimes(self):
+        d = datetime.datetime(2026, 9, 8, 9)
+        h = datetime.timedelta(hours=1)
+        result = merge_intervals([(d + h, d + 2 * h), (d, d + h)])
+        self.assertEqual(result, [(d, d + 2 * h)])
+
+    def test_input_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
