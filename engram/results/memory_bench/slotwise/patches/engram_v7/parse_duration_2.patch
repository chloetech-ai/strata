+"""Durations typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_DURATION = re.compile(
+    r"(?P<colon_h>[0-9]+):(?P<colon_m>[0-9]{2})"  # 1:30
+    r"|(?P<h>[0-9]+)\s*h(?:\s*(?P<h_m>[0-9]+)\s*(?:min|m)?)?"  # 1h, 1h30, 1h 30m
+    r"|(?P<m>[0-9]+)\s*(?:min|m)?"  # 45, 45m, 45 min
+)
+
+
+def parse_duration(text):
+    """Minutes for `text`. Raises ValueError for empty input, zero, or anything unrecognised."""
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if match["colon_h"] is not None:
+        hours, minutes = int(match["colon_h"]), int(match["colon_m"])
+    elif match["h"] is not None:
+        hours, minutes = int(match["h"]), int(match["h_m"] or 0)
+    else:
+        hours, minutes = 0, int(match["m"])
+    if minutes >= 60:
+        raise ValueError(f"minutes must be below 60: {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return total
