@@ -0,0 +1,50 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_PHONE, reminder_text, to_ascii
+
+
+def appointment(client="Zoë Brändli", therapist="lena", treatment="standard"):
+    start = datetime.datetime(2026, 10, 20, 14, 30)
+    return Appointment(therapist, client, start, treatment)
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_are_spelled_out(self):
+        self.assertEqual(to_ascii("Brändli Müller Öztürk Straße"), "Braendli Mueller Oeztuerk Strasse")
+
+    def test_other_accents_are_dropped(self):
+        self.assertEqual(to_ascii("Zoë café"), "Zoe cafe")
+
+    def test_untransliterable_characters_are_refused(self):
+        with self.assertRaises(ValueError):
+            to_ascii("Søren")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text_is_plain_ascii(self):
+        text = reminder_text(appointment())
+        self.assertTrue(text.isascii())
+        self.assertIn("Braendli", text)
+
+    def test_text_names_the_therapist_and_time(self):
+        text = reminder_text(appointment())
+        self.assertIn("lena", text)
+        self.assertIn("20.10.2026 um 14:30 Uhr", text)
+
+    def test_text_includes_reception_number(self):
+        self.assertIn(RECEPTION_PHONE, reminder_text(appointment()))
+
+    def test_long_name_still_fits_and_keeps_reception_number(self):
+        text = reminder_text(appointment(client="Maria Magdalena Elisabeth von Hohenstaufen-Wittgenstein-Weber"))
+        self.assertLessEqual(len(text), MAX_LENGTH)
+        self.assertIn(RECEPTION_PHONE, text)
+
+    def test_reminder_over_the_limit_is_refused(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client="A" * 200))
+
+
+if __name__ == "__main__":
+    unittest.main()
