+"""SMS reminder texts for appointments."""
+
+import unicodedata
+
+# Every reminder carries this number so clients can call to move their appointment.
+RECEPTION_PHONE = "044 512 77 30"
+
+# A longer reminder is billed as two SMS.
+MAX_LENGTH = 160
+
+# Spelled out first, so 'ä' becomes 'ae' rather than the 'a' that accent stripping would give.
+_UMLAUTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def to_ascii(text):
+    """Plain ASCII: umlauts spelled out, other accents dropped ('Brändli' -> 'Braendli', 'é' -> 'e')."""
+    for char, replacement in _UMLAUTS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(char for char in decomposed if not unicodedata.combining(char))
+    if not stripped.isascii():
+        raise ValueError(f"'{text}' cannot be written in plain ASCII.")
+    return stripped
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`: plain ASCII, at most 160 characters."""
+    when = appointment.start.strftime("%d.%m.%Y um %H:%M")
+    text = to_ascii(
+        f"Guten Tag {appointment.client}. Termin bei {appointment.therapist} am {when} Uhr. "
+        f"Verschieben: {RECEPTION_PHONE}"
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"Reminder is {len(text)} characters, the limit is {MAX_LENGTH}.")
+    return text
