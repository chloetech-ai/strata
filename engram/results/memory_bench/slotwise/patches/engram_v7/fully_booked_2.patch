+    def test_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # seven appointments, one per hour
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
+    def test_not_fully_booked_below_seven(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):  # six appointments
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointments_do_not_count(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        ids = [s.book(at(hour, client=f"Client {hour}")).id for hour in range(8, 15)]
+        s.cancel(ids[0])
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_book_still_allows_past_the_cap(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour, client=f"Client {hour}"))
+        s.book(at(15, client="Jo Li"))  # reception may book past 7 when the therapist agrees
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+
 
 if __name__ == "__main__":
     unittest.main()
