+++ b/tests/test_fees.py
@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.standard = Appointment("lena", "Kim Weber", self.start, "standard")  # 9800 cents
+
+    def cancel_hours_before(self, hours, appointment=None):
+        appointment = appointment or self.standard
+        return cancellation_fee(appointment, self.start - datetime.timedelta(hours=hours))
+
+    def test_more_than_48_hours_is_free(self):
+        self.assertEqual(self.cancel_hours_before(72), 0)
+        self.assertEqual(self.cancel_hours_before(48.5), 0)
+
+    def test_exactly_48_hours_is_free(self):
+        self.assertEqual(self.cancel_hours_before(48), 0)
+
+    def test_under_48_hours_is_half_price(self):
+        self.assertEqual(self.cancel_hours_before(47.9), 4900)
+        self.assertEqual(self.cancel_hours_before(24.5), 4900)
+
+    def test_exactly_24_hours_is_half_price(self):
+        self.assertEqual(self.cancel_hours_before(24), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        self.assertEqual(self.cancel_hours_before(23.9), 9800)
+        self.assertEqual(self.cancel_hours_before(1), 9800)
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(self.cancel_hours_before(-2), 9800)
+
+    def test_uses_the_treatment_price(self):
+        initial = Appointment("lena", "Kim Weber", self.start, "initial")
+        self.assertEqual(self.cancel_hours_before(1, initial), 14500)
+        self.assertEqual(self.cancel_hours_before(30, initial), 7250)
+
+
+if __name__ == "__main__":
+    unittest.main()
