+"""Printable text for the receipt printer at reception."""
+
+# The receipt printer prints 42 characters per line; longer lines wrap into a mess.
+WIDTH = 42
+
+
+def _fit(line):
+    return line[:WIDTH]
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s appointments on `day` as printable text, one line per appointment.
+
+    Cancelled appointments are left out. Every line is at most `WIDTH` characters.
+    """
+    lines = [_fit(f"{therapist.capitalize()}, {day:%A %d.%m.%Y}")]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for appointment in appointments:
+        span = f"{appointment.start:%H:%M}-{appointment.end:%H:%M}"
+        lines.append(_fit(f"{span} {appointment.treatment} {appointment.client}"))
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
