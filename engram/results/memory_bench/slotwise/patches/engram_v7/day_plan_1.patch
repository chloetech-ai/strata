@@ -0,0 +1,44 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_by_time(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li"))
+        s.book(at(9))
+        lines = day_plan(s, "lena", DAY).split("\n")
+        self.assertEqual(lines[0], "Lena, Tuesday 08.09.2026")
+        self.assertEqual(lines[1], "09:00-09:45 standard Kim Weber")
+        self.assertEqual(lines[2], "10:00-10:45 standard Jo Li")
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        s.book(at(9))
+        cancelled = s.book(at(10))
+        s.cancel(cancelled.id)
+        s.book(at(11, therapist="mia"))
+        self.assertEqual(len(day_plan(s, "lena", DAY).split("\n")), 2)
+
+    def test_empty_day(self):
+        self.assertEqual(day_plan(Schedule(), "lena", DAY).split("\n")[-1], "No appointments.")
+
+    def test_every_line_fits_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maximilian Alexandra Brändli-Hochstrasser"))
+        for line in day_plan(s, "lena", DAY).split("\n"):
+            self.assertLessEqual(len(line), WIDTH)
+
+
+if __name__ == "__main__":
+    unittest.main()
