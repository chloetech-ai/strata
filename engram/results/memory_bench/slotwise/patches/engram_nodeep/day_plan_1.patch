+"""Printable text for reception."""
+
+import textwrap
+
+# The receipt printer reception uses for day plans fits 42 characters a line.
+WIDTH = 42
+
+
+def _wrap(text, indent=""):
+    return textwrap.wrap(text, WIDTH, initial_indent=indent, subsequent_indent=indent) or [""]
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s live appointments on `day`, as text for the receipt printer.
+
+    Every line is wrapped to WIDTH characters so nothing spills over on paper.
+    """
+    lines = _wrap(f"{therapist.capitalize()} {day:%a %d.%m.%Y}") + [""]
+    appointments = schedule.appointments_for(therapist, day)
+    if not appointments:
+        lines += _wrap("No appointments.")
+    for appointment in appointments:
+        lines += _wrap(
+            f"{appointment.start:%H:%M}-{appointment.end:%H:%M} {appointment.treatment.capitalize()}"
+        )
+        lines += _wrap(appointment.client, indent="  ")
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
new file mode 100644
index 0000000..0fb96f3
--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,54 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, 0, treatment="short", client="Jo Li"))
+        s.book(at(9))
+        plan = day_plan(s, "lena", datetime.date(2026, 9, 8))
+        self.assertEqual(
+            plan.splitlines(),
+            [
+                "Lena Tue 08.09.2026",
+                "",
+                "09:00-09:45 Standard",
+                "  Kim Weber",
+                "10:00-10:30 Short",
+                "  Jo Li",
+            ],
+        )
+
+    def test_leaves_out_cancelled_appointments(self):
+        s = Schedule()
+        s.book(at(9))
+        cancelled = s.book(at(11, client="Jo Li"))
+        s.cancel(cancelled.id)
+        plan = day_plan(s, "lena", datetime.date(2026, 9, 8))
+        self.assertNotIn("Jo Li", plan)
+
+    def test_empty_day_says_so(self):
+        plan = day_plan(Schedule(), "lena", datetime.date(2026, 9, 8))
+        self.assertEqual(plan.splitlines()[-1], "No appointments.")
+
+    def test_no_line_is_wider_than_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Theresia von Hohenberg-Ammerschwihr de la Tour"))
+        plan = day_plan(s, "lena", datetime.date(2026, 9, 8))
+        for line in plan.splitlines():
+            self.assertLessEqual(len(line), WIDTH)
+        self.assertIn("Maria-Theresia", plan)
+        self.assertIn("Tour", plan)
+
+
+if __name__ == "__main__":
+    unittest.main()
