+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_intervals_are_sorted_and_kept(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_and_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 7), (9, 10)]), [(1, 7), (9, 10)])
+
+    def test_contained_interval_does_not_shrink_the_result(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_datetimes(self):
+        result = merge_intervals([
+            (DT(2026, 10, 15, 10, 0), DT(2026, 10, 15, 11, 0)),
+            (DT(2026, 10, 15, 8, 0), DT(2026, 10, 15, 10, 0)),
+        ])
+        self.assertEqual(result, [(DT(2026, 10, 15, 8, 0), DT(2026, 10, 15, 11, 0))])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 7), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 7), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
