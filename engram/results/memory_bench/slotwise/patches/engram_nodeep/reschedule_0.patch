+    def reschedule(self, appointment_id, new_start):
+        """Moves a live appointment to `new_start`, keeping its therapist and treatment.
+
+        The new time must pass the same checks as `book()`, and the
+        appointment's current slot does not count against it. If the move is
+        refused, the appointment stays where it was.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment was cancelled, so it cannot be moved. Please book a new appointment instead.")
