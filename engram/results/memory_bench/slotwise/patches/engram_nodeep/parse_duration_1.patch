+"""Parsing of appointment durations typed by reception."""
+
+import re
+
+_HOURS_MINUTES = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"(\d+):(\d{2})")
+_MINUTES = re.compile(r"(\d+)\s*(?:m|min)?")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for empty input, zero, or anything unrecognised.
+    """
+    cleaned = text.strip().lower()
+    hours_minutes = _HOURS_MINUTES.fullmatch(cleaned) or _CLOCK.fullmatch(cleaned)
+    if hours_minutes:
+        hours, minutes = int(hours_minutes.group(1)), hours_minutes.group(2)
+        minutes = int(minutes) if minutes is not None else 0
+        if minutes >= 60:
+            raise ValueError(f"minutes must be below 60: {text!r}")
+        total = hours * 60 + minutes
+    else:
+        match = _MINUTES.fullmatch(cleaned)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        total = int(match.group(1))
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
