+++ b/src/slotwise/printing.py
@@ -0,0 +1,19 @@
+"""Printable day plans for reception's receipt printer."""
+
+import textwrap
+
+# The receipt printer fits 42 characters on a line; anything longer wraps into a mess.
+WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """Returns `therapist`'s appointments on `day` as plain text, at most WIDTH per line."""
+    lines = textwrap.wrap(f"{therapist.capitalize()} {day:%a %d.%m.%Y}", WIDTH)
+    lines.append("-" * WIDTH)
+    appointments = schedule.appointments_for(therapist, day)
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines += textwrap.wrap(f"{a.start:%H:%M}-{a.end:%H:%M} {a.treatment.capitalize()}", WIDTH)
+        lines += textwrap.wrap(a.client, WIDTH, initial_indent="  ", subsequent_indent="  ")
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
new file mode 100644
index 0000000..c588137
--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,43 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_the_days_appointments_in_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li"))
+        s.book(at(8, treatment="initial"))
+        plan = day_plan(s, "lena", datetime.date(2026, 9, 8)).splitlines()
+        self.assertEqual(plan[0], "Lena Tue 08.09.2026")
+        self.assertEqual(plan[2], "08:00-09:00 Initial")
+        self.assertEqual(plan[3], "  Kim Weber")
+        self.assertEqual(plan[4], "10:00-10:45 Standard")
+        self.assertEqual(plan[5], "  Jo Li")
+
+    def test_no_appointments(self):
+        plan = day_plan(Schedule(), "lena", datetime.date(2026, 9, 8)).splitlines()
+        self.assertEqual(plan[2], "No appointments.")
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        s.cancel(s.appointments[1].id)
+        s.book(at(12, therapist="marc"))
+        self.assertNotIn("Jo Li", day_plan(s, "lena", datetime.date(2026, 9, 8)))
+        self.assertNotIn("12:00", day_plan(s, "lena", datetime.date(2026, 9, 8)))
+
+    def test_no_line_is_wider_than_the_receipt_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Theresia von Hohenlohe-Langenburg-Schillingsfürst"))
+        plan = day_plan(s, "lena", datetime.date(2026, 9, 8))
+        self.assertTrue(all(len(line) <= WIDTH for line in plan.splitlines()))
+        self.assertIn("Maria-Theresia", plan)
