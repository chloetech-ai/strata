+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, at(11).start)
+        self.assertIs(moved, a)
+        self.assertEqual(a.start.hour, 11)
+        self.assertEqual(a.therapist, "lena")
+        self.assertEqual(a.treatment, "standard")
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_within_own_slot_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, at(9, 5).start)  # overlaps its old self only
+        self.assertEqual(a.start.minute, 5)
+
+    def test_reschedule_into_taken_slot_is_refused_and_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, at(11).start)
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_keeps_gap_from_others(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))  # 11:00-11:45
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, at(10, 10).start)  # ends 10:55, 5 minutes before 11:00
+        s.reschedule(a.id, at(10, 5).start)  # ends 10:50, exactly 10 minutes before
+        self.assertEqual(a.start.hour, 10)
+
+    def test_reschedule_outside_opening_hours_is_refused_and_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, at(18, 30).start)
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, at(11).start)
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_unknown_id_raises(self):
