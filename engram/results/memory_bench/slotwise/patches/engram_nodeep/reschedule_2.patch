+        """Moves an appointment to `new_start`, keeping its therapist and treatment.
+
+        The new time must pass the same checks as `book()`. The appointment's
+        own old slot does not count as taken. Nothing changes if the move is refused.
+        """
+        appointment = self.get(appointment_id)
