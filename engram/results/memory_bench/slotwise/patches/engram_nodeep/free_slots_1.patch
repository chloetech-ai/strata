+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which `therapist` could book `minutes` of treatment.
+
+        Starts are every 15 minutes from opening time. A start counts only if
+        the appointment would end within opening hours and keep the gap from
+        the therapist's live appointments that `book()` requires.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = hours[0]
+        while start + length <= hours[1]:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += STEP
+        return slots
+
+    def _clash(self, therapist, start, end):
+        """The therapist's live appointment that leaves no GAP around [start, end), or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + GAP and start < other.end + GAP:
+                return other
+        return None
+
