+    def test_free_slots_empty_day_runs_from_opening_to_last_fitting_start(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends exactly at 19:00
+        self.assertEqual(len(slots), 44)
+
+    def test_free_slots_are_fifteen_minutes_apart(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        self.assertTrue(all(b - a == datetime.timedelta(minutes=15) for a, b in zip(slots, slots[1:])))
+
+    def test_free_slots_respect_gap_around_booking(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 15 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # would end 09:00, no gap
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), slots)  # overlaps
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # starts inside the gap after
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # first grid start after the gap
+
