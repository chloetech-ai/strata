@@ -0,0 +1,35 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import TREATMENTS, Appointment
+
+
+def appointment(treatment="standard"):
+    return Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 0), treatment)
+
+
+def hours_before(appt, hours):
+    return appt.start - datetime.timedelta(hours=hours)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_48_hours_or_more_is_free(self):
+        a = appointment()
+        self.assertEqual(cancellation_fee(a, hours_before(a, 48)), 0)
+        self.assertEqual(cancellation_fee(a, hours_before(a, 72)), 0)
+
+    def test_under_48_hours_is_half_price(self):
+        a = appointment()
+        self.assertEqual(cancellation_fee(a, hours_before(a, 47)), 4900)
+        self.assertEqual(cancellation_fee(a, hours_before(a, 24)), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        a = appointment()
+        self.assertEqual(cancellation_fee(a, hours_before(a, 23)), 9800)
+        self.assertEqual(cancellation_fee(a, hours_before(a, 0)), 9800)
+
+    def test_fee_follows_treatment_price(self):
+        a = appointment("initial")
+        self.assertEqual(cancellation_fee(a, hours_before(a, 30)), TREATMENTS["initial"][1] // 2)
+        self.assertEqual(cancellation_fee(a, hours_before(a, 2)), TREATMENTS["initial"][1])
