@@ -0,0 +1,57 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_by_time(self):
+        s = Schedule()
+        s.book(at(10, 30, client="Jo Li"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", DAY),
+            "Day plan Lena\n"
+            "08.09.2026\n"
+            "------------------------------------------\n"
+            "09:00 standard  Kim Weber\n"
+            "10:30 standard  Jo Li",
+        )
+
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(Schedule(), "lena", DAY),
+            "Day plan Lena\n08.09.2026\n" + "-" * WIDTH + "\nNo appointments",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        s.book(at(9, client="Jo Li"))
+        cancelled = s.book(at(10))
+        s.cancel(cancelled.id)
+        s.book(at(11, therapist="max"))
+        self.assertNotIn("Kim Weber", day_plan(s, "lena", DAY))
+        self.assertIn("Jo Li", day_plan(s, "lena", DAY))
+        self.assertNotIn("10:00", day_plan(s, "lena", DAY))
+        self.assertNotIn("11:00", day_plan(s, "lena", DAY))
+
+    def test_every_line_fits_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Theresia von Hohenstaufen-Brändli Gonzalez"))
+        s.book(at(10, therapist="max", client="Jo Li"))
+        plan = day_plan(s, "lena", DAY)
+        for line in plan.split("\n"):
+            self.assertLessEqual(len(line), WIDTH, line)
+        self.assertIn("Gonzalez", plan)
+
+
+if __name__ == "__main__":
+    unittest.main()
