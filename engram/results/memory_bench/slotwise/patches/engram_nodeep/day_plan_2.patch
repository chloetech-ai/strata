+"""Printable text for reception."""
+
+import textwrap
+
+# The receipt printer reception uses for day plans prints this many characters per line.
+WIDTH = 42
+
+
+def _wrap(text, indent=""):
+    return textwrap.wrap(text, width=WIDTH, subsequent_indent=indent) or [""]
+
+
+def day_plan(schedule, therapist, day):
+    """Returns `therapist`'s live appointments on `day` as text for the receipt printer.
+
+    Every line fits in WIDTH characters. A long client name wraps under its time.
+    """
+    lines = _wrap(f"Day plan {therapist.capitalize()}")
+    lines += _wrap(f"{day:%d.%m.%Y}")
+    lines.append("-" * WIDTH)
+    appointments = schedule.appointments_for(therapist, day)
+    if not appointments:
+        lines += _wrap("No appointments")
+    for a in appointments:
+        # "HH:MM " then the treatment padded to 9 characters and a space: 16 columns.
+        lines += _wrap(f"{a.start:%H:%M} {a.treatment:<9} {a.client}", indent=" " * 16)
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
