@@ -0,0 +1,37 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import RECEPTION_PHONE, SMS_LIMIT, reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_time_therapist_and_reception_number(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 10, 20, 9, 5))
+        text = reminder_text(a)
+        self.assertIn("Lena", text)
+        self.assertIn("20.10.2026 at 09:05", text)
+        self.assertIn(RECEPTION_PHONE, text)
+
+    def test_umlauts_are_spelled_out(self):
+        a = Appointment("lena", "Brändli", datetime.datetime(2026, 10, 20, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("Hello Braendli,", text)
+        self.assertTrue(text.isascii())
+
+    def test_other_accents_are_stripped(self):
+        a = Appointment("lena", "Zoë Gómez", datetime.datetime(2026, 10, 20, 9, 0))
+        self.assertIn("Hello Zoe Gomez,", reminder_text(a))
+
+    def test_fits_in_one_sms(self):
+        a = Appointment("lena", "Mörgeli-Schnürrenberger", datetime.datetime(2026, 10, 20, 9, 0))
+        self.assertLessEqual(len(reminder_text(a)), SMS_LIMIT)
+
+    def test_too_long_is_refused_rather_than_cut(self):
+        a = Appointment("lena", "x" * 200, datetime.datetime(2026, 10, 20, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
