+"""SMS reminders for appointments."""
+
+import unicodedata
+
+# Clients call this number to move their appointment.
+RECEPTION_PHONE = "044 512 77 30"
+
+# A longer SMS is billed as two messages.
+SMS_LIMIT = 160
+
+# The SMS gateway accepts only plain ASCII. Umlauts are spelled out ('Brändli' -> 'Braendli'),
+# because stripping the accent alone would leave 'Brandli'.
+UMLAUTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def _to_ascii(text):
+    for umlaut, spelled in UMLAUTS.items():
+        text = text.replace(umlaut, spelled)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """Return the reminder SMS for `appointment`, as plain ASCII of at most SMS_LIMIT characters.
+
+    Raises ValueError if the text would be too long. The phone number is never cut off.
+    """
+    text = _to_ascii(
+        f"Lindqvist Physio: Hello {appointment.client}, reminder of your appointment with "
+        f"{appointment.therapist.capitalize()} on {appointment.start:%d.%m.%Y} at {appointment.start:%H:%M}. "
+        f"To move it, call {RECEPTION_PHONE}."
+    )
+    if len(text) > SMS_LIMIT:
+        raise ValueError(f"reminder for {appointment.client!r} is {len(text)} characters, the limit is {SMS_LIMIT}")
+    return text
