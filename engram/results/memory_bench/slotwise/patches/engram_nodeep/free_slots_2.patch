+    def test_free_slots_empty_day_runs_from_opening_to_last_fit(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends exactly at 19:00
+        self.assertEqual(slots[1] - slots[0], datetime.timedelta(minutes=15))
+
+    def test_free_slots_respect_gap_around_booking(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        slots = [t.time() for t in s.free_slots("lena", datetime.date(2026, 9, 8), 45)]
+        self.assertIn(datetime.time(8, 0), slots)  # ends 08:45, 10 minutes before 09:00 is allowed
+        self.assertNotIn(datetime.time(8, 15), slots)  # would end at 09:00
+        self.assertNotIn(datetime.time(9, 45), slots)
+        self.assertNotIn(datetime.time(9, 0), slots)
+        self.assertIn(datetime.time(10, 0), slots)  # first start after 09:45 + 10 minutes
+
