+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which a `minutes`-long appointment could be booked.
+
+        Starts are on a 15-minute grid from opening time. A start counts only if
+        `book()` would accept it: the appointment ends within opening hours and
+        the therapist has GAP free before and after it.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT
+        return slots
+
+    def _clash(self, therapist, start, end):
+        """A live appointment of `therapist` too close to [start, end) to allow it, or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + GAP and start < other.end + GAP:
+                return other
+        return None
+
