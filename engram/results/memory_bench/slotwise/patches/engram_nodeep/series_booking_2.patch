@@ -0,0 +1,46 @@
+"""Booking a series of weekly sessions."""
+
+import datetime
+
+from .errors import SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# A prescription covers at most this many sessions.
+MAX_SESSIONS = 9
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`.
+
+    Each session keeps the weekday, time, therapist, client and treatment of
+    `first`. A week whose slot is already taken is skipped and the series
+    runs one week longer, so the client still gets `count` sessions. If
+    `first` itself is taken, nothing is booked. Returns the booked
+    appointments in date order.
+    """
+    if count < 1:
+        raise ValueError("A series needs at least one session.")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(
+            f"A series can have at most {MAX_SESSIONS} sessions. Please book {MAX_SESSIONS} or fewer."
+        )
+
+    booked_before = len(schedule.appointments)
+    booked = [schedule.book(first)]
+    week = 1
+    try:
+        while len(booked) < count:
+            start = first.start + week * WEEK
+            week += 1
+            session = Appointment(first.therapist, first.client, start, first.treatment)
+            try:
+                booked.append(schedule.book(session))
+            except SlotTaken:
+                continue
+    except Exception:
+        # Refuse the series in full rather than leave it half booked.
+        del schedule.appointments[booked_before:]
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..8df2a87
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,69 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SeriesTooLong, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+TUESDAY = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def first(therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, TUESDAY)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [TUESDAY + datetime.timedelta(weeks=i) for i in range(3)])
+        self.assertEqual(s.appointments, booked)
+        self.assertTrue(all(a.therapist == "lena" and a.client == "Kim Weber" for a in booked))
+
+    def test_skips_taken_week_and_adds_one_at_the_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", TUESDAY + datetime.timedelta(weeks=1)))
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [
+            TUESDAY,
+            TUESDAY + datetime.timedelta(weeks=2),
+            TUESDAY + datetime.timedelta(weeks=3),
+        ])
+
+    def test_other_therapist_does_not_block_the_series(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Jo Li", TUESDAY + datetime.timedelta(weeks=1)))
+        self.assertEqual(len(book_series(s, first(), 2)), 2)
+
+    def test_cancelled_week_is_free(self):
+        s = Schedule()
+        taken = s.book(Appointment("lena", "Jo Li", TUESDAY + datetime.timedelta(weeks=1)))
+        s.cancel(taken.id)
+        booked = book_series(s, first(), 2)
+        self.assertEqual(booked[1].start, TUESDAY + datetime.timedelta(weeks=1))
+
+    def test_nine_sessions_is_allowed(self):
+        self.assertEqual(len(book_series(Schedule(), first(), MAX_SESSIONS)), 9)
+
+    def test_more_than_nine_is_refused_and_nothing_is_booked(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong) as ctx:
+            book_series(s, first(), 10)
+        self.assertIsInstance(ctx.exception, BookingError)
+        self.assertEqual(s.appointments, [])
+
+    def test_taken_first_slot_books_nothing(self):
+        s = Schedule()
+        s.book(first(client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, first(), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_count_below_one_is_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
