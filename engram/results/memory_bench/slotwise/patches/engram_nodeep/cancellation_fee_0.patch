+"""Cancellation fees for Lindqvist Physio."""
+
+import datetime
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Free when cancelled 48 hours or more before the start, half the
+    treatment price when less than 48 hours before, and the full price
+    when less than 24 hours before (including after the start).
+    """
+    notice = appointment.start - cancelled_at
+    if notice >= datetime.timedelta(hours=48):
+        return 0
+    if notice >= datetime.timedelta(hours=24):
+        # Halve, rounding odd cents up. All current prices are even.
+        return (appointment.price + 1) // 2
+    return appointment.price
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
