+    def test_is_fully_booked_at_daily_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # seven 45-minute appointments, 10 minutes apart
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
+    def test_is_not_fully_booked_below_daily_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):  # six appointments
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointment_does_not_count_towards_full(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(at(hour)) for hour in range(8, 15)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_book_allows_going_past_daily_limit(self):
+        s = Schedule()
+        for hour in range(8, 16):  # eight appointments: reception may still book past the cap
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertEqual(len(s.appointments), 8)
+
