@@ -0,0 +1,38 @@
+"""Booking a prescribed series of weekly sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# The insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`.
+
+    Each appointment is at the same weekday and time as `first`. A week whose
+    slot is already taken is skipped and the series runs one week longer, so
+    the client still gets `count` sessions. Any other refusal (for example the
+    practice is closed on that weekday) is raised as it is.
+
+    Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise ValueError("count must be at least 1")
+    if count > MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {MAX_SESSIONS} sessions. Please book {MAX_SESSIONS} or fewer."
+        )
+    booked = []
+    week = 0
+    while len(booked) < count:
+        start = first.start + datetime.timedelta(weeks=week)
+        week += 1
+        candidate = Appointment(first.therapist, first.client, start, first.treatment)
+        try:
+            booked.append(schedule.book(candidate))
+        except SlotTaken:
+            pass
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..b9f2b72
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,69 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+MONDAY = datetime.datetime(2026, 9, 7, 8, 0)
+
+
+def first(start=MONDAY, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, start, "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_time(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [MONDAY + datetime.timedelta(weeks=i) for i in range(3)])
+        self.assertTrue(all(a.therapist == "lena" and a.client == "Kim Weber" for a in booked))
+        self.assertEqual(s.appointments, booked)
+
+    def test_skips_taken_week_and_adds_one_at_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", MONDAY + datetime.timedelta(weeks=1)))
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [
+            MONDAY,
+            MONDAY + datetime.timedelta(weeks=2),
+            MONDAY + datetime.timedelta(weeks=3),
+        ])
+
+    def test_other_therapist_does_not_block_week(self):
+        s = Schedule()
+        s.book(Appointment("mika", "Jo Li", MONDAY + datetime.timedelta(weeks=1)))
+        booked = book_series(s, first(), 2)
+        self.assertEqual(len(booked), 2)
+        self.assertEqual(booked[1].start, MONDAY + datetime.timedelta(weeks=1))
+
+    def test_cancelled_week_is_free(self):
+        s = Schedule()
+        a = s.book(Appointment("lena", "Jo Li", MONDAY + datetime.timedelta(weeks=1)))
+        s.cancel(a.id)
+        booked = book_series(s, first(), 2)
+        self.assertEqual(booked[1].start, MONDAY + datetime.timedelta(weeks=1))
+
+    def test_nine_sessions_allowed(self):
+        self.assertEqual(len(book_series(Schedule(), first(), MAX_SESSIONS)), MAX_SESSIONS)
+
+    def test_more_than_nine_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, first(), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_closed_weekday_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, first(start=datetime.datetime(2026, 9, 6, 8, 0)), 2)  # Sunday
+        self.assertEqual(s.appointments, [])
+
+    def test_count_below_one_raises(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
