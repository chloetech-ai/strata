+    def reschedule(self, appointment_id, new_start):
+        """Moves a live appointment to `new_start`, keeping its id and treatment.
+
+        The new time must pass the same checks as `book()`. The appointment
+        does not block itself. Nothing changes if the move is refused.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment was cancelled, so it cannot be moved. Please book a new one instead.")
+        moved = replace(appointment, start=new_start)
+        self._check(moved)
+        appointment.start = new_start
+        return appointment
+
