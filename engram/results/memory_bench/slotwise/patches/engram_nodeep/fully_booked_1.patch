+    def test_fully_booked_at_seven_treatments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # seven appointments, 60 min apart
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, hour, 0), "standard"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
+    def test_not_fully_booked_at_six_treatments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, hour, 0), "standard"))
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointments_do_not_count_towards_full(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, hour, 0), "standard"))
+            for hour in range(8, 15)
+        ]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
