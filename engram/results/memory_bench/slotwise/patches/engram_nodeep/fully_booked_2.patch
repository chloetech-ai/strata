+    def test_fully_booked_at_daily_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # seven treatments, 08:00 to 15:00
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_not_fully_booked_below_daily_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):  # six treatments
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointments_do_not_count_towards_fully_booked(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(at(hour)) for hour in range(8, 15)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_fully_booked_is_per_therapist(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):
