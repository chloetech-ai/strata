+"""Durations typed by receptionists, such as '45', '1h30' or '1:30'."""
+
+import re
+
+# '45', '45m', '45 min'
+_MINUTES = re.compile(r"(\d+)\s*(?:min|m)?")
+# '1h', '1h30', '1h 30m', '2h15'
+_HOURS = re.compile(r"(\d+)\s*h\s*(?:(\d+)\s*(?:min|m)?)?")
+# '1:30'
+_CLOCK = re.compile(r"(\d+):(\d+)")
+
+
+def parse_duration(text):
+    """Minutes for a duration typed as '45', '45m', '1h', '1h30' or '1:30'.
+
+    Case and surrounding spaces are ignored. Raises ValueError for empty
+    input, zero, or anything else.
+    """
+    cleaned = text.strip().lower()
+    if match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+    elif match := _HOURS.fullmatch(cleaned) or _CLOCK.fullmatch(cleaned):
+        minutes = _hours_and_minutes(match[1], match[2])
+    else:
+        raise ValueError(f"not a duration: {text!r}; use for example 45, 1h or 1h30")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _hours_and_minutes(hours, minutes):
+    minutes = int(minutes or 0)
+    if minutes >= 60:
+        raise ValueError(f"minutes must be below 60, got {minutes}")
+    return int(hours) * 60 + minutes
