+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` where an appointment of `minutes` could be booked.
+
+        Candidates run every STEP from opening time. A candidate is free when
+        `book()` would accept it: it fits within opening hours and leaves GAP
+        free before and after for `therapist`.
+        """
+        if minutes <= 0:
+            raise ValueError("minutes must be positive")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._blocking(therapist, start, start + length) is None:
+                slots.append(start)
+            start += STEP
+        return slots
+
+    def _blocking(self, therapist, start, end):
+        """The live appointment that stops `therapist` taking `start` to `end`, or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + GAP and start < other.end + GAP:
+                return other
+        return None
+
