+    def test_free_slots_empty_day_runs_from_opening_to_last_fitting_start(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))  # 18:00-19:00 is the last fit
+        self.assertEqual(len(slots), 43)  # 07:30 to 18:00 in 15-minute steps
+
+    def test_free_slots_closed_day_is_empty(self):
+        s = Schedule()
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 6), 30), [])  # Sunday
+
+    def test_free_slots_respects_gap_and_length(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so nothing may end after 08:50 or start before 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, no gap
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # starts inside the gap after 09:45
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
