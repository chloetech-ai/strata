+++ b/src/slotwise/series.py
@@ -0,0 +1,52 @@
+"""Booking a series of weekly appointments, such as prescribed physio sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+# How far ahead to look for free weeks before giving up on the series.
+MAX_WEEKS_SEARCHED = 52
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`.
+
+    Each later appointment is at the same weekday and time as `first`. A week
+    whose slot is already taken is skipped, and the series continues in the
+    next free week, so the client still gets `count` sessions.
+
+    The series is all or nothing: if it cannot be completed, nothing is booked
+    and the error is raised. Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise BookingError("A series needs at least one session.")
+    if count > MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {MAX_SESSIONS} sessions. Please book {MAX_SESSIONS} or fewer."
+        )
+
+    booked = [schedule.book(first)]
+    try:
+        week = 1
+        while len(booked) < count:
+            if week > MAX_WEEKS_SEARCHED:
+                raise BookingError(
+                    f"Could not find {count} free weeks in the next {MAX_WEEKS_SEARCHED} weeks for this series. "
+                    "Please choose another time or another therapist."
+                )
+            start = first.start + datetime.timedelta(weeks=week)
+            week += 1
+            appointment = Appointment(first.therapist, first.client, start, first.treatment)
+            try:
+                booked.append(schedule.book(appointment))
+            except SlotTaken:
+                continue
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..94ef259
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,86 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def at(day, hour=9, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, 0), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9, 0) for d in (8, 15, 22)],
+        )
+        self.assertEqual(len(s.appointments), 3)
+        self.assertIs(booked[0], s.appointments[0])
+
+    def test_keeps_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, at(8), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("lena", "Kim Weber", "standard"))
+
+    def test_skips_taken_week_and_adds_one_at_end(self):
+        s = Schedule()
+        s.book(at(15, client="Jo Li"))
+        booked = book_series(s, at(8), 3)
+        self.assertEqual(
+            [a.start.day for a in booked],
+            [8, 22, 29],
+        )
+
+    def test_other_therapist_does_not_block_week(self):
+        s = Schedule()
+        s.book(at(15, therapist="mia", client="Jo Li"))
+        booked = book_series(s, at(8), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_cancelled_appointment_does_not_block_week(self):
+        s = Schedule()
+        taken = s.book(at(15, client="Jo Li"))
+        s.cancel(taken.id)
+        booked = book_series(s, at(8), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_more_than_nine_sessions_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, at(8), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(8), 9)), 9)
+
+    def test_zero_sessions_is_refused(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(8), 0)
+
+    def test_taken_first_appointment_books_nothing(self):
+        s = Schedule()
+        s.book(at(8, client="Jo Li"))
+        with self.assertRaises(BookingError):
+            book_series(s, at(8), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_incomplete_series_books_nothing(self):
+        s = Schedule()
+        # Lena is busy every week after the first, far beyond the search window.
+        for week in range(1, 60):
+            day = datetime.datetime(2026, 9, 8, 9, 0) + datetime.timedelta(weeks=week)
+            s.appointments.append(Appointment("lena", "Jo Li", day, "standard"))
+        with self.assertRaises(BookingError):
+            book_series(s, at(8), 3)
+        self.assertEqual(len(s.appointments), 59)
+
+
+if __name__ == "__main__":
+    unittest.main()
