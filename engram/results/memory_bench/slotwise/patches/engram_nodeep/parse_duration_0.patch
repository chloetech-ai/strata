+"""Parse human-typed durations such as '45', '1h30' or '1:30' into minutes."""
+
+import re
+
+_PATTERNS = (
+    # '45', '45m', '45 min'
+    re.compile(r"(?P<minutes>\d+)\s*(?:m|min)?"),
+    # '1h', '1h30', '1h 30m', '2h15'
+    re.compile(r"(?P<hours>\d+)\s*h(?:\s*(?P<minutes>\d+)\s*(?:m|min)?)?"),
+    # '1:30'
+    re.compile(r"(?P<hours>\d+):(?P<minutes>\d+)"),
+)
+
+
+def parse_duration(text):
+    """Return the number of minutes described by `text`.
+
+    Raises ValueError for empty input, zero, or anything that is not one of
+    the accepted forms.
+    """
+    cleaned = text.strip().lower()
+    for pattern in _PATTERNS:
+        match = pattern.fullmatch(cleaned)
+        if match:
+            break
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+
+    groups = match.groupdict()
+    hours = int(groups.get("hours") or 0)
+    minutes = int(groups.get("minutes") or 0)
+    if minutes >= 60 and groups.get("hours") is not None:
+        raise ValueError(f"minutes must be under 60: {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
