@@ -0,0 +1,41 @@
+"""SMS reminders for appointments."""
+
+import unicodedata
+
+from .model import Appointment
+
+# The reception's number, so clients can call to move their appointment.
+RECEPTION_PHONE = "044 512 77 30"
+
+# The gateway bills anything longer than this as two messages.
+MAX_LENGTH = 160
+
+# The gateway accepts only plain ASCII. Umlauts become two-letter forms, which is
+# how German speakers write them; stripping the accent alone would give 'Brandli'.
+UMLAUTS = {
+    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+}
+
+
+def to_sms_ascii(text):
+    """Make text safe for the SMS gateway: umlauts become 'ae', 'oe', 'ue', 'ss'; other accents are stripped."""
+    for char, replacement in UMLAUTS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return "".join(ch for ch in decomposed if ord(ch) < 128)
+
+
+def reminder_text(appointment):
+    """Return the reminder SMS for an appointment as plain ASCII.
+
+    Raises ValueError if the text would be longer than 160 characters.
+    """
+    when = appointment.start.strftime("%d.%m.%Y at %H:%M")
+    text = to_sms_ascii(
+        f"Lindqvist Physio: reminder for {appointment.client}, appointment on {when} "
+        f"with {appointment.therapist}. To move it, call {RECEPTION_PHONE}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}: {text!r}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..867fc5b
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,39 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text, to_sms_ascii
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_client_time_and_reception_number(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 10, 20, 9, 30))
+        text = reminder_text(a)
+        self.assertIn("Kim Weber", text)
+        self.assertIn("20.10.2026 at 09:30", text)
+        self.assertIn("044 512 77 30", text)
+        self.assertLessEqual(len(text), 160)
+
+    def test_umlauts_become_two_letters(self):
+        a = Appointment("lena", "Anna Brändli", datetime.datetime(2026, 10, 20, 9, 30))
+        self.assertIn("Anna Braendli", reminder_text(a))
+
+    def test_too_long_is_refused(self):
+        a = Appointment("lena", "X" * 200, datetime.datetime(2026, 10, 20, 9, 30))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+class SmsAsciiTest(unittest.TestCase):
+    def test_umlauts_and_sharp_s(self):
+        self.assertEqual(to_sms_ascii("Brändli Müller Öztürk Straße"), "Braendli Mueller Oeztuerk Strasse")
+
+    def test_uppercase_umlauts(self):
+        self.assertEqual(to_sms_ascii("Ärger Ölmann Üben"), "Aerger Oelmann Ueben")
+
+    def test_other_accents_are_stripped(self):
+        self.assertEqual(to_sms_ascii("café à Genève"), "cafe a Geneve")
+
+
+if __name__ == "__main__":
+    unittest.main()
