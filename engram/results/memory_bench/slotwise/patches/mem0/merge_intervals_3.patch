+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_kept_and_sorted(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_and_touching_merge(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 7)]), [(1, 7)])
+
+    def test_contained_interval(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_unsorted_input(self):
+        self.assertEqual(merge_intervals([(8, 9), (1, 2), (2, 4), (3, 5)]), [(1, 5), (8, 9)])
+
+    def test_datetimes(self):
+        intervals = [
+            (DT(2026, 9, 7, 10, 0), DT(2026, 9, 7, 11, 0)),
+            (DT(2026, 9, 7, 9, 0), DT(2026, 9, 7, 10, 0)),
+            (DT(2026, 9, 7, 13, 0), DT(2026, 9, 7, 14, 0)),
+        ]
+        self.assertEqual(
+            merge_intervals(intervals),
+            [(DT(2026, 9, 7, 9, 0), DT(2026, 9, 7, 11, 0)), (DT(2026, 9, 7, 13, 0), DT(2026, 9, 7, 14, 0))],
+        )
+
+    def test_input_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
