+    def test_fully_booked_at_daily_maximum(self):
+        s = Schedule()
+        for i in range(6):
+            s.book(at(8 + i, client=f"Client {i}"))  # 08:00 to 13:00, each 45 min with changeover
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
