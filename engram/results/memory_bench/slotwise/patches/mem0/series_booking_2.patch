+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most 9 sessions per prescription.
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them by date.
+
+    Each later session is the same therapist, client and treatment, at the same weekday
+    and time, one week after the previous one. A week where the therapist is already
+    booked is skipped, and the series continues in the following week instead, so the
+    client still gets `count` sessions.
+
+    Raises BookingError if `first` cannot be booked. The practice's opening hours are the
+    same every week, so once `first` is booked, the later sessions only ever skip taken weeks.
+    """
+    if count < 1:
+        raise ValueError("count must be at least 1")
+    if count > MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {MAX_SESSIONS} sessions, because insurance pays for no more. "
+            "Please book fewer sessions."
+        )
+
+    booked = [schedule.book(first)]
+    week = 0
+    while len(booked) < count:
+        week += 1
+        start = first.start + datetime.timedelta(weeks=week)
+        session = Appointment(first.therapist, first.client, start, first.treatment)
+        try:
+            booked.append(schedule.book(session))
+        except SlotTaken:
+            continue
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..c46d917
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,96 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+# 2026-09-08 is a Tuesday.
+def first_at(day=8, hour=9, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions_from_first(self):
+        s = Schedule()
+        booked = book_series(s, first_at(), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, 8, 9), datetime.datetime(2026, 9, 15, 9), datetime.datetime(2026, 9, 22, 9)],
+        )
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_sessions_keep_therapist_client_and_treatment(self):
+        s = Schedule()
+        first = Appointment("marco", "Jo Li", datetime.datetime(2026, 9, 8, 9), "initial")
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("marco", "Jo Li", "initial")})
+
+    def test_each_session_has_its_own_id(self):
+        s = Schedule()
+        booked = book_series(s, first_at(), 3)
+        self.assertEqual(len({a.id for a in booked}), 3)
+
+    def test_returns_only_the_booked_sessions_in_order(self):
+        s = Schedule()
+        booked = book_series(s, first_at(), 2)
+        self.assertEqual(booked, s.appointments)
+
+    def test_taken_week_is_skipped_and_series_continues_after(self):
+        s = Schedule()
+        s.book(first_at(day=15, client="Jo Li"))  # the second week is taken
+        booked = book_series(s, first_at(), 3)
+        self.assertEqual(
+            [a.start.date() for a in booked],
+            [datetime.date(2026, 9, 8), datetime.date(2026, 9, 22), datetime.date(2026, 9, 29)],
+        )
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_taken_week_for_other_therapist_is_not_skipped(self):
+        s = Schedule()
+        s.book(first_at(day=15, therapist="marco", client="Jo Li"))
+        booked = book_series(s, first_at(), 2)
+        self.assertEqual(booked[1].start.date(), datetime.date(2026, 9, 15))
+
+    def test_cancelled_week_is_free(self):
+        s = Schedule()
+        taken = s.book(first_at(day=15, client="Jo Li"))
+        s.cancel(taken.id)
+        booked = book_series(s, first_at(), 2)
+        self.assertEqual(booked[1].start.date(), datetime.date(2026, 9, 15))
+
+    def test_at_most_nine_sessions(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, first_at(), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first_at(), MAX_SESSIONS)), MAX_SESSIONS)
+
+    def test_count_below_one_is_rejected(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first_at(), 0)
+
+    def test_first_session_taken_books_nothing(self):
+        s = Schedule()
+        s.book(first_at(client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, first_at(), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_first_session_outside_opening_hours_books_nothing(self):
+        s = Schedule()
+        # Saturday closes at 12:00, so a 45-minute session from 11:45 does not fit.
+        first = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 5, 11, 45))
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, first, 2)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
