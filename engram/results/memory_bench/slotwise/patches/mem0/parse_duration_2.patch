+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms_give_minutes(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            self.assertEqual(parse_duration(text), minutes, text)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30 MIN  "), 90)
+        self.assertEqual(parse_duration(" 45M "), 45)
+
+    def test_empty_text_is_rejected(self):
+        for text in ["", "   "]:
+            with self.assertRaises(ValueError, msg=repr(text)):
+                parse_duration(text)
+
+    def test_zero_is_rejected(self):
+        for text in ["0", "0m", "0h", "0h0", "0:00"]:
+            with self.assertRaises(ValueError, msg=text):
+                parse_duration(text)
+
+    def test_anything_else_is_rejected(self):
+        for text in ["abc", "-5", "1h60", "1:75", "1.5h", "45 seconds", "1h-30"]:
+            with self.assertRaises(ValueError, msg=text):
+                parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
