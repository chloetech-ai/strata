+"""Read how long a treatment lasts, as the receptionist types it."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+
+
+def parse_duration(text):
+    """Return the number of minutes in text, e.g. '45 min' -> 45, '1h30' -> 90, '1:30' -> 90.
+
+    Accepts minutes ('45', '45m', '45 min'), hours ('1h') and hours with minutes
+    ('1h30', '1h 30m', '2h15', '1:30'). Case and surrounding spaces are ignored.
+    Raises ValueError for empty text, zero, or anything else.
+    """
+    value = text.strip().lower()
+    if match := _MINUTES.fullmatch(value):
+        minutes = int(match[1])
+    elif match := _HOURS.fullmatch(value) or _CLOCK.fullmatch(value):
+        minutes = int(match[1]) * 60 + int(match[2] or 0)
+        if int(match[2] or 0) > 59:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
