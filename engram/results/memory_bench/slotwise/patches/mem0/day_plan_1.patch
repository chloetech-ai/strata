+"""Printable documents for the front desk."""
+
+from .schedule import Schedule
+
+
+def day_plan(schedule: Schedule, therapist, day):
+    """The day's non-cancelled appointments for `therapist`, as plain text for reception."""
+    lines = [f"Day plan: {therapist}, {day:%A %d %B %Y}", ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment}")
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_printing.py b/tests/test_printing.py
