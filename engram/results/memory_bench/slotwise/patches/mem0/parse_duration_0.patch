+"""Parsing of appointment durations written by hand, e.g. '45', '1h30', '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{1,2})")
+
+
+def parse_duration(text):
+    """Return the number of minutes in `text`.
+
+    Accepted forms (case-insensitive, surrounding spaces ignored):
+    '45', '45m', '45 min', '1h', '1h30', '1h 30m', '2h15', '1:30'.
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    value = text.strip().lower()
+    minutes = _parse_minutes(value)
+    if minutes is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
+
+
+def _parse_minutes(value):
+    for pattern, to_minutes in (
+        (_MINUTES, lambda m: int(m[1])),
+        (_HOURS, _hours_and_minutes),
+        (_CLOCK, _clock_to_minutes),
+    ):
+        match = pattern.fullmatch(value)
+        if match:
+            return to_minutes(match)
+    return None
+
+
+def _hours_and_minutes(match):
+    hours, minutes = int(match[1]), int(match[2] or 0)
+    if minutes >= 60:
+        return None
+    return hours * 60 + minutes
+
+
+def _clock_to_minutes(match):
+    hours, minutes = int(match[1]), int(match[2])
+    if minutes >= 60:
+        return None
+    return hours * 60 + minutes
