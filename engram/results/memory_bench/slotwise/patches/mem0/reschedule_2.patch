+    def reschedule(self, appointment_id, new_start):
+        """Moves the appointment to start at `new_start`, keeping its therapist, client and treatment.
+
+        The new time must pass the same checks as booking, ignoring the appointment's old time.
+        Raises BookingError (or a subclass) if it cannot be moved, and then the appointment is unchanged.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment has been cancelled, so it cannot be moved. Please book a new one.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check_free(moved, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
+    def _check_free(self, appointment, ignore=None):
+        """Raises BookingError (or a subclass) unless `appointment` fits. `ignore` is skipped in the overlap check."""
+        if appointment.treatment not in TREATMENTS:
+            raise BookingError(f"We don't offer the treatment '{appointment.treatment}'.")
+        if not is_open_between(appointment.start, appointment.end):
+            raise OutsideOpeningHours()
+        for other in self.appointments:
+            if other is ignore or other.cancelled or other.therapist != appointment.therapist:
+                continue
+            if appointment.start < other.end + CHANGEOVER and other.start < appointment.end + CHANGEOVER:
+                raise SlotTaken(appointment.therapist)
+
     def appointments_for(self, therapist, day):
         """`therapist`'s appointments on `day`, by start time."""
         mine = [a for a in self.appointments if a.therapist == therapist and a.start.date() == day]
