+    def test_reschedule_moves_and_keeps_id(self):
+        s = Schedule()
+        a = s.book(at(9, treatment="short"))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual((a.therapist, a.client, a.treatment), ("lena", "Kim Weber", "short"))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_into_own_old_slot_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 20))  # overlaps its own old slot
+        self.assertEqual(a.start.hour * 60 + a.start.minute, 9 * 60 + 20)
+
+    def test_reschedule_onto_other_appointment_is_taken(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_respects_changeover(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))  # 11:00-11:45
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 10))  # 10:10-10:55, only 5 min before 11:00
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_outside_opening_hours_is_refused(self):
