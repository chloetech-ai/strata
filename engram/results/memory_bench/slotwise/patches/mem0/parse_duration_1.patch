+"""Parsing of appointment durations written by hand."""
+
+import re
+
+# '1h', '1h30', '1h 30m', '45', '45m', '45 min'
+_HOURS_MINUTES = re.compile(r"(?:(?P<h>\d+)\s*h)?\s*(?:(?P<m>\d+)\s*(?:min|m)?)?")
+# '1:30'
+_CLOCK = re.compile(r"(?P<h>\d+):(?P<m>\d+)")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '1h30' or '1:30'. Raises ValueError if unusable."""
+    value = text.strip().lower()
+    if not value:
+        raise ValueError("empty duration")
+
+    clock = _CLOCK.fullmatch(value)
+    match = clock or _HOURS_MINUTES.fullmatch(value)
+    if match is None:
+        raise ValueError(f"unrecognised duration: {text!r}")
+
+    hours = int(match["h"] or 0)
+    minutes = int(match["m"] or 0)
+    if (clock or match["h"] is not None) and minutes >= 60:
+        raise ValueError(f"minutes out of range in {text!r}")
+
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError("duration must be positive")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..b7e90f1
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,34 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_empty_zero_and_garbage(self):
+        for text in ["", "   ", "0", "0m", "0:00", "abc", "-5", "1h60", "1:75", "h", "1 30"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
