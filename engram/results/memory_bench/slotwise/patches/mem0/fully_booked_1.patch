+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` already has DAILY_LIMIT non-cancelled appointments on `day`."""
+        return len([a for a in self.appointments_for(therapist, day) if not a.cancelled]) >= DAILY_LIMIT
