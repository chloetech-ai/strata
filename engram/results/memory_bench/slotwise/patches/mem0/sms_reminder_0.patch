+"""Text of the SMS reminders sent before an appointment."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+
+# The SMS gateway accepts only plain ASCII. These are written out the German way,
+# as 'Braendli' is for 'Brändli'; the rest are folded by unicodedata.
+_TRANSLITERATIONS = {
+    "ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss",
+}
+
+
+def _ascii(text):
+    for char, replacement in _TRANSLITERATIONS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """The reminder SMS for an appointment, in plain ASCII and at most 160 characters.
+
+    The client's name is left out: the message only needs to say when and with whom.
+    """
+    when = appointment.start
+    therapist = _ascii(appointment.therapist)
+    return (
+        f"Reminder: appointment with {therapist} on {when:%d.%m.%Y} at {when:%H:%M}. "
+        f"To move it, call {RECEPTION_NUMBER}."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..5df37c1
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,37 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_says_therapist_date_time_and_reception_number(self):
+        appointment = Appointment("Dr. Keller", "Kim Weber", datetime.datetime(2026, 10, 20, 9, 5))
+        self.assertEqual(
+            reminder_text(appointment),
+            "Reminder: appointment with Dr. Keller on 20.10.2026 at 09:05. To move it, call 044 512 77 30.",
+        )
+
+    def test_therapist_name_is_transliterated_to_ascii(self):
+        appointment = Appointment("Anja Brändli", "Kim Weber", datetime.datetime(2026, 10, 20, 9, 0))
+        text = reminder_text(appointment)
+        self.assertIn("with Anja Braendli on", text)
+        self.assertTrue(text.isascii())
+
+    def test_accents_outside_the_german_list_are_folded(self):
+        appointment = Appointment("Zoé Müller", "Kim Weber", datetime.datetime(2026, 10, 20, 9, 0))
+        self.assertIn("with Zoe Mueller on", reminder_text(appointment))
+
+    def test_client_name_is_not_in_the_text(self):
+        appointment = Appointment("Anja Brändli", "Kim Weber", datetime.datetime(2026, 10, 20, 9, 0))
+        self.assertNotIn("Kim", reminder_text(appointment))
+
+    def test_fits_in_one_sms(self):
+        appointment = Appointment("Dr. Maria-Theresia von Hohenlohe-Langenburg", "Kim Weber",
+                                  datetime.datetime(2026, 12, 31, 17, 45))
+        self.assertLessEqual(len(reminder_text(appointment)), 160)
+
+
+if __name__ == "__main__":
+    unittest.main()
