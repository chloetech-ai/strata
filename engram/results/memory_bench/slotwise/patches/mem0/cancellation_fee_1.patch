@@ -0,0 +1,22 @@
+"""Cancellation fees."""
+
+import datetime
+
+# Cancelling with less notice than these is charged. Earlier cancellations are free.
+HALF_FEE_NOTICE = datetime.timedelta(hours=48)
+FULL_FEE_NOTICE = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before the start: the full price.
+    Less than 48 hours before the start: half the price.
+    Otherwise: free.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < FULL_FEE_NOTICE:
+        return appointment.price
+    if notice < HALF_FEE_NOTICE:
+        return appointment.price // 2
+    return 0
