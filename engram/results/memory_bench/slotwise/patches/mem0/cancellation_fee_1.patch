@@ -0,0 +1,41 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+def booked(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+def hours_before(hours):
+    return START - datetime.timedelta(hours=hours)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_free_from_48_hours_before(self):
+        self.assertEqual(cancellation_fee(booked(), hours_before(48)), 0)
+        self.assertEqual(cancellation_fee(booked(), hours_before(72)), 0)
+
+    def test_half_price_under_48_hours(self):
+        self.assertEqual(cancellation_fee(booked(), hours_before(47)), 4900)
+
+    def test_half_price_from_24_hours_before(self):
+        self.assertEqual(cancellation_fee(booked(), hours_before(24)), 4900)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(cancellation_fee(booked(), hours_before(23)), 9800)
+
+    def test_full_price_after_start(self):
+        self.assertEqual(cancellation_fee(booked(), START + datetime.timedelta(minutes=5)), 9800)
+
+    def test_uses_the_treatment_price(self):
+        self.assertEqual(cancellation_fee(booked("initial"), hours_before(1)), 14500)
+        self.assertEqual(cancellation_fee(booked("short"), hours_before(30)), 3400)
+
+
+if __name__ == "__main__":
+    unittest.main()
