+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which a `minutes`-long appointment could be booked for `therapist`.
+
+        Starts are on a SLOT_STEP grid from opening time, and each one passes the same
+        checks as book(): the practice is open for the whole appointment and the
+        therapist has the CHANGEOVER gap around it. Empty if the practice is closed.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._is_free(therapist, start, start + length):
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _is_free(self, therapist, start, end):
+        """True if `therapist` has no non-cancelled appointment within CHANGEOVER of start..end."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if start < other.end + CHANGEOVER and other.start < end + CHANGEOVER:
+                return False
+        return True
+
