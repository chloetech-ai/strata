--- /dev/null
+++ b/src/slotwise/printing.py
@@ -0,0 +1,14 @@
+"""Printable documents for reception."""
+
+from .schedule import Schedule
+
+
+def day_plan(schedule: Schedule, therapist: str, day) -> str:
+    """Plain-text plan of `therapist`'s non-cancelled appointments on `day`, by start time."""
+    lines = [f"{therapist} - {day:%A %d.%m.%Y}", ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment} ({a.minutes} min)")
+    return "\n".join(lines) + "\n"
