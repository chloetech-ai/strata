+    def test_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        for hour in range(8, 15):  # 08:00 to 15:00, seven back-to-back-ish treatments
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_not_fully_booked_below_seven(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointment_does_not_count(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour, client=f"Client {hour}"))
+        last = s.book(at(14, client="Jo Li"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        s.cancel(last.id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
