+    def test_is_fully_booked_ignores_cancelled(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        cancelled = None
+        for i in range(7):
+            a = s.book(at(8 + i, client=f"Client {i}"))
+            if i == 0:
+                cancelled = a
+        s.cancel(cancelled.id)
+        self.assertFalse(s.is_fully_booked("lena", day))
