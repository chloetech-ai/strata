+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` has reached MAX_DAILY_TREATMENTS non-cancelled appointments on `day`."""
+        active = [a for a in self.appointments_for(therapist, day) if not a.cancelled]
+        return len(active) >= MAX_DAILY_TREATMENTS
