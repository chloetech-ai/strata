+    def test_is_fully_booked_at_seven(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for i in range(6):
+            s.book(at(8 + i, client=f"Client {i}"))  # 08:00 ... 13:00, one per hour
