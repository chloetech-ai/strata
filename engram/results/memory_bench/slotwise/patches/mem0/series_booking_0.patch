@@ -0,0 +1,66 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(day, hour, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8, 9), 3)  # Tuesdays 8, 15 and 22 September
+        self.assertEqual([a.start for a in booked], [
+            datetime.datetime(2026, 9, 8, 9),
+            datetime.datetime(2026, 9, 15, 9),
+            datetime.datetime(2026, 9, 22, 9),
+        ])
+        self.assertEqual(len(s.appointments), 3)
+        self.assertEqual({a.therapist for a in booked}, {"lena"})
+        self.assertEqual({a.client for a in booked}, {"Kim Weber"})
+
+    def test_skips_taken_week_and_adds_one_at_the_end(self):
+        s = Schedule()
+        s.book(at(15, 9, client="Jo Li"))
+        booked = book_series(s, at(8, 9), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_cancelled_slot_is_free(self):
+        s = Schedule()
+        blocker = s.book(at(15, 9, client="Jo Li"))
+        s.cancel(blocker.id)
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_other_therapist_does_not_block(self):
+        s = Schedule()
+        s.book(at(15, 9, therapist="marco", client="Jo Li"))
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_first_taken_refuses_and_books_nothing(self):
+        s = Schedule()
+        s.book(at(8, 9, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(8, 9), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_at_most_nine_sessions(self):
+        s = Schedule()
+        booked = book_series(s, at(8, 9), MAX_SESSIONS)
+        self.assertEqual(len(booked), 9)
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(8, 9), MAX_SESSIONS + 1)
+
+    def test_at_least_one_session(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(8, 9), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
