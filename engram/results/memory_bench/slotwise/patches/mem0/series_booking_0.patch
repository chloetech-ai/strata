+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most 9 sessions per prescription.
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them in date order.
+
+    Every appointment is on the same weekday and time as `first`. A week whose slot is
+    taken is skipped and the series moves on to a later week, so the client still gets
+    `count` sessions. Raises BookingError if `first` itself cannot be booked.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series can have between 1 and {MAX_SESSIONS} appointments.")
+    booked = [schedule.book(first)]
+    week = 0
+    while len(booked) < count:
+        week += 1
+        start = first.start + datetime.timedelta(weeks=week)
+        try:
+            booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+        except SlotTaken:
+            continue
+    return booked
