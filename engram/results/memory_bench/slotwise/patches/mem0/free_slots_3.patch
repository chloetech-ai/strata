+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which a `minutes`-long appointment for `therapist` could be booked.
+
+        Times are on a GRID starting at opening time, and each one passes the same checks as book().
+        Returns an empty list if the practice is closed that day.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = hours[0]
+        while start + length <= hours[1]:
+            if not self._clashes(therapist, start, start + length):
+                slots.append(start)
+            start += GRID
+        return slots
+
+    def _clashes(self, therapist, start, end):
+        """True if `therapist` has a non-cancelled appointment too close to `start`-`end`, changeover included."""
+        return any(
+            not other.cancelled
+            and other.therapist == therapist
+            and start < other.end + CHANGEOVER
+            and other.start < end + CHANGEOVER
+            for other in self.appointments
+        )
+
