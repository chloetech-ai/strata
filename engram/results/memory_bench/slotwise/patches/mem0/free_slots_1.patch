+    def test_free_slots_empty_day_is_whole_grid(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)  # Tuesday, 07:30-19:00
+        slots = s.free_slots("lena", day, 60)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))  # 18:00-19:00 is the last fit
+        self.assertEqual(len(slots), (18 * 60 - 7 * 60 - 30) // 15 + 1)
