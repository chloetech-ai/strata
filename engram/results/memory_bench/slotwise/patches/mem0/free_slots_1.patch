+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (15-minute steps from opening) where a `minutes`-long appointment fits.
+
+        Uses the same rules as book(): inside opening hours, and clear of the therapist's
+        other appointments by CHANGEOVER on each side.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if not self._clashes(therapist, start, start + length):
+                slots.append(start)
+            start += GRID
+        return slots
+
+    def _clashes(self, therapist, start, end):
+        """Whether `therapist` has a non-cancelled appointment too close to [start, end) to book."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if start < other.end + CHANGEOVER and other.start < end + CHANGEOVER:
+                return True
+        return False
+
