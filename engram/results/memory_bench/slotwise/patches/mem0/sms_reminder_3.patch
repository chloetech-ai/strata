@@ -0,0 +1,30 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_therapist_date_time_and_reception(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        self.assertEqual(
+            reminder_text(a),
+            "Erinnerung: Ihr Termin bei lena am 07.09. um 09:00 Uhr. "
+            "Verschieben oder absagen: 044 512 77 30",
+        )
+
+    def test_umlauts_are_spelled_out_and_accents_dropped(self):
+        a = Appointment("Brändli", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("bei Braendli am", text)
+        self.assertTrue(text.isascii())
+
+    def test_too_long_raises(self):
+        a = Appointment("x" * MAX_LENGTH, "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
