+"""Reminder SMS texts for appointments."""
+
+import unicodedata
+
+# The reception's number, so clients can call to move or cancel.
+RECEPTION_PHONE = "044 512 77 30"
+
+# Longer SMS are billed as two, so a reminder must fit in one.
+MAX_LENGTH = 160
+
+# The SMS gateway accepts only plain ASCII, so umlauts and ß are spelled out.
+_SPELLED = str.maketrans(
+    {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+)
+
+
+def _ascii(text):
+    decomposed = unicodedata.normalize("NFKD", text.translate(_SPELLED))
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """The reminder SMS for an appointment, in plain ASCII.
+
+    Raises ValueError if the text would not fit in one SMS.
+    """
+    when = appointment.start
+    text = _ascii(
+        f"Erinnerung: Ihr Termin bei {appointment.therapist} am "
+        f"{when:%d.%m.} um {when:%H:%M} Uhr. Verschieben oder absagen: {RECEPTION_PHONE}"
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}")
+    return text
