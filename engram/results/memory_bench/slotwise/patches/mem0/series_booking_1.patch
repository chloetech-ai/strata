+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SERIES = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them in order.
+
+    Each appointment is at the same weekday and time as `first`, one week later than the
+    previous one. A week the therapist is already booked is skipped, and the series
+    continues in the next free week, so the client still gets all `count` sessions.
+
+    Raises BookingError (or a subclass) if `first` cannot be booked, or if `count` is
+    more than MAX_SERIES. Nothing is booked in that case.
+    """
+    if count < 1:
+        raise ValueError("count must be at least 1")
+    if count > MAX_SERIES:
+        raise SeriesTooLong(MAX_SERIES)
+
+    # Checking the first session up front means a refused series books nothing.
+    schedule.book(first)
+    booked = [first]
+    week = 1
+    while len(booked) < count:
+        start = first.start + datetime.timedelta(weeks=week)
+        week += 1
+        try:
+            booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+        except SlotTaken:
+            continue
+    return booked
