@@ -0,0 +1,89 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours, SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SERIES, book_series
+
+# Tuesday 8 September 2026, 09:00
+FIRST = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def first(start=FIRST, therapist="lena", client="Kim Weber", treatment="standard"):
+    return Appointment(therapist, client, start, treatment)
+
+
+def week(n, hour=9, minute=0):
+    return datetime.datetime(2026, 9, 8 + 7 * n, hour, minute)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [week(0), week(1), week(2)])
+        self.assertEqual(s.appointments, booked)
+
+    def test_returns_appointments_with_client_therapist_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, first(treatment="initial"), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("lena", "Kim Weber", "initial"))
+        self.assertEqual(len({a.id for a in booked}), 2)
+
+    def test_first_is_booked_as_given(self):
+        s = Schedule()
+        f = first()
+        booked = book_series(s, f, 2)
+        self.assertIs(booked[0], f)
+
+    def test_taken_week_is_skipped_and_series_continues_at_the_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", week(1)))
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [week(0), week(2), week(3)])
+
+    def test_changeover_clash_skips_the_week(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", week(1, hour=9, minute=50)))  # 5 min after 09:45 slot
+        booked = book_series(s, first(), 2)
+        self.assertEqual([a.start for a in booked], [week(0), week(2)])
+
+    def test_other_therapist_does_not_block_a_week(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Jo Li", week(1)))
+        booked = book_series(s, first(), 2)
+        self.assertEqual([a.start for a in booked], [week(0), week(1)])
+
+    def test_cancelled_appointment_does_not_block_a_week(self):
+        s = Schedule()
+        taken = s.book(Appointment("lena", "Jo Li", week(1)))
+        s.cancel(taken.id)
+        booked = book_series(s, first(), 2)
+        self.assertEqual([a.start for a in booked], [week(0), week(1)])
+
+    def test_series_longer_than_max_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong) as cm:
+            book_series(s, first(), MAX_SERIES + 1)
+        self.assertEqual(s.appointments, [])
+        self.assertIsInstance(cm.exception, BookingError)
+
+    def test_max_length_series_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first(), MAX_SERIES)), MAX_SERIES)
+
+    def test_zero_sessions_is_an_error(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first(), 0)
+
+    def test_first_outside_opening_hours_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, first(week(0, hour=18, minute=30)), 2)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
