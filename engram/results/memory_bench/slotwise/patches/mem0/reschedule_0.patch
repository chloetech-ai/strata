+    def test_reschedule_into_own_old_slot_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))  # overlaps only its old self
