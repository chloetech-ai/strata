+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", client="Kim Weber", treatment="standard"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_start_order(self):
+        s = Schedule()
+        s.book(at(14, client="Jo Li", treatment="initial"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan: lena, Monday 07.09.2026\n"
+            "09:00-09:45  Kim Weber  standard\n"
+            "14:00-15:00  Jo Li  initial",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(10, therapist="marco", client="Jo Li"))
+        s.book(at(11, client="Jo Li", treatment="short"))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan: lena, Monday 07.09.2026\n11:00-11:30  Jo Li  short",
+        )
+
+    def test_no_appointments(self):
+        s = Schedule()
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan: lena, Monday 07.09.2026\nNo appointments.",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
