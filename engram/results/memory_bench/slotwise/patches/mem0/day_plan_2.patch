+"""Text printouts for the front desk."""
+
+from .schedule import Schedule
+
+
+def day_plan(schedule: Schedule, therapist, day):
+    """The printable plan of `therapist`'s non-cancelled appointments on `day`, one per line by start time."""
+    header = f"Day plan: {therapist}, {day.strftime('%A %d.%m.%Y')}"
+    lines = [header]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment}")
+    return "\n".join(lines)
