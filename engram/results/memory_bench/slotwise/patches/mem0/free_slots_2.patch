+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which an appointment of `minutes` could be booked for `therapist`.
+
+        Start times run every SLOT_STEP from opening time. A slot is offered only if it
+        fits inside opening hours and keeps the CHANGEOVER gap from the therapist's other
+        appointments. Returns [] on a day the practice is closed.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if not self._clashes(therapist, start, start + length):
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clashes(self, therapist, start, end):
+        """True if `therapist` has a non-cancelled appointment too close to [start, end)."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if start < other.end + CHANGEOVER and other.start < end + CHANGEOVER:
+                return True
+        return False
+
