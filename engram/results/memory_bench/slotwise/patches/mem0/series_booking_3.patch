index 0000000..7e1a0d0
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,92 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SeriesIncomplete
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, SEARCH_WEEKS, book_series
+
+TUESDAY = datetime.datetime(2026, 9, 8, 10, 0)  # 2026-09-08 is a Tuesday
+
+
+def appt(start=TUESDAY, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, start)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, appt(), 3)
+        self.assertEqual([a.start for a in booked], [TUESDAY + datetime.timedelta(weeks=i) for i in range(3)])
+        self.assertEqual(s.appointments, booked)
+
+    def test_skips_taken_week_and_adds_one_at_the_end(self):
+        s = Schedule()
+        s.book(appt(TUESDAY + datetime.timedelta(weeks=1), client="Jo Li"))  # 15 Sep taken
+        booked = book_series(s, appt(), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_returns_the_first_appointment_itself(self):
+        s = Schedule()
+        first = appt()
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+
+    def test_cancelled_week_is_free(self):
+        s = Schedule()
+        blocker = s.book(appt(TUESDAY + datetime.timedelta(weeks=1), client="Jo Li"))
+        s.cancel(blocker.id)
+        booked = book_series(s, appt(), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_other_therapist_does_not_block_series(self):
+        s = Schedule()
+        s.book(appt(TUESDAY + datetime.timedelta(weeks=1), therapist="marco", client="Jo Li"))
+        booked = book_series(s, appt(), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_maximum_number_of_sessions(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, appt(), MAX_SESSIONS)), MAX_SESSIONS)
+
+    def test_too_many_sessions_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, appt(), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, appt(), 0)
+        self.assertEqual(s.appointments, [])
+
+    def test_closed_weekday_cannot_be_booked(self):
+        s = Schedule()
+        sunday = datetime.datetime(2026, 9, 13, 10, 0)  # practice is closed on Sundays
+        with self.assertRaises(SeriesIncomplete):
+            book_series(s, appt(sunday), 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_partial_series_is_rolled_back(self):
+        s = Schedule()
+        # Every Tuesday for the search period is taken except the first two weeks.
+        for week in range(2, SEARCH_WEEKS):
+            s.book(appt(TUESDAY + datetime.timedelta(weeks=week), client="Jo Li"))
+        blockers = list(s.appointments)
+        with self.assertRaises(SeriesIncomplete):
+            book_series(s, appt(), 3)
+        self.assertEqual(s.appointments, blockers)
+
+    def test_unknown_treatment_is_not_reported_as_incomplete(self):
+        s = Schedule()
+        first = Appointment("lena", "Kim Weber", TUESDAY, "massage")
+        with self.assertRaises(BookingError) as ctx:
+            book_series(s, first, 2)
+        self.assertNotIsInstance(ctx.exception, SeriesIncomplete)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
