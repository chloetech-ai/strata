@@ -0,0 +1,48 @@
+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import BookingError, OutsideOpeningHours, SeriesIncomplete, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+# How many weeks from `first` to look for free weeks before giving up.
+SEARCH_WEEKS = 52
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`.
+
+    Every session is on the same weekday and time as `first`. A week that is
+    already taken, or when the practice is closed, is skipped and the series
+    moves on to a later week, so the client still gets `count` sessions.
+    Either all sessions are booked or none are.
+    Returns the booked appointments in date order.
+    Raises BookingError (or a subclass) if the series cannot be booked.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series can have between 1 and {MAX_SESSIONS} sessions. Please choose a smaller number.")
+
+    booked = []
+    for week in range(SEARCH_WEEKS):
+        if len(booked) == count:
+            break
+        if week == 0:
+            candidate = first
+        else:
+            start = first.start + week * WEEK
+            candidate = Appointment(first.therapist, first.client, start, first.treatment)
+        try:
+            booked.append(schedule.book(candidate))
+        except (SlotTaken, OutsideOpeningHours):
+            continue
+
+    if len(booked) < count:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise SeriesIncomplete(count)
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
