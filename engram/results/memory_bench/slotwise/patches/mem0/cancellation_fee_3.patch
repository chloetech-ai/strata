+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+def before(hours):
+    return START - datetime.timedelta(hours=hours)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.appointment = Appointment("lena", "Kim Weber", START, "standard")
+
+    def test_more_than_48_hours_is_free(self):
+        self.assertEqual(cancellation_fee(self.appointment, before(72)), 0)
+
+    def test_exactly_48_hours_is_free(self):
+        self.assertEqual(cancellation_fee(self.appointment, before(48)), 0)
+
+    def test_under_48_hours_is_half_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, before(47)), 4900)
+
+    def test_exactly_24_hours_is_half_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, before(24)), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, before(23)), 9800)
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, START + datetime.timedelta(minutes=5)), 9800)
+
+    def test_half_price_uses_treatment_price(self):
+        initial = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(initial, before(30)), 7250)
