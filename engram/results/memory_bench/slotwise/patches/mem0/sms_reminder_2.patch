+"""Reminder SMS sent to clients before their appointment."""
+
+import unicodedata
+
+# Clients call this number to move their appointment, so every reminder includes it.
+RECEPTION_PHONE = "044 512 77 30"
+
+# One SMS segment. Longer messages are billed as two.
+MAX_LENGTH = 160
+
+# The SMS gateway accepts only plain ASCII, so these are spelled out before the rest is stripped.
+_SPELLED_OUT = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def to_ascii(text):
+    """Plain ASCII version of `text`, e.g. 'Brändli' -> 'Braendli'."""
+    for char, replacement in _SPELLED_OUT.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """The text of the reminder SMS for `appointment`.
+
+    Raises ValueError if the text would not fit in one SMS.
+    """
+    when = appointment.start.strftime("%d.%m.%Y at %H:%M")
+    text = to_ascii(
+        f"Reminder: your appointment with {appointment.therapist} is on {when}. "
+        f"To move it, call {RECEPTION_PHONE}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"Reminder is {len(text)} characters, over the {MAX_LENGTH} limit.")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..2de654e
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,39 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_PHONE, reminder_text, to_ascii
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_time_and_reception_number(self):
+        appointment = Appointment("Brändli", "Zoë Müller", datetime.datetime(2026, 10, 20, 14, 30))
+        self.assertEqual(
+            reminder_text(appointment),
+            "Reminder: your appointment with Braendli is on 20.10.2026 at 14:30. "
+            "To move it, call 044 512 77 30.",
+        )
+
+    def test_is_plain_ascii_and_fits_one_sms(self):
+        appointment = Appointment("Brändli", "Zoë Müller", datetime.datetime(2026, 10, 20, 14, 30))
+        text = reminder_text(appointment)
+        self.assertTrue(text.isascii())
+        self.assertLessEqual(len(text), MAX_LENGTH)
+        self.assertIn(RECEPTION_PHONE, text)
+
+    def test_too_long_raises_rather_than_dropping_the_phone_number(self):
+        appointment = Appointment("x" * 150, "Kim", datetime.datetime(2026, 10, 20, 14, 30))
+        with self.assertRaises(ValueError):
+            reminder_text(appointment)
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_spells_out_umlauts_and_sharp_s(self):
+        self.assertEqual(to_ascii("Straße Äpfel Öl Über"), "Strasse Aepfel Oel Ueber")
+
+    def test_strips_other_accents(self):
+        self.assertEqual(to_ascii("Éloïse"), "Eloise")
+
+
+if __name__ == "__main__":
+    unittest.main()
