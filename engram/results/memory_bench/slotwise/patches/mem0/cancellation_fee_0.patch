@@ -0,0 +1,32 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+def appt(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_48_hours_or_more_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=48)), 0)
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(days=7)), 0)
+
+    def test_under_48_hours_is_half_price(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=47, minutes=59)), 4900)
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=24)), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=23, minutes=59)), 9800)
+        self.assertEqual(cancellation_fee(appt(), START), 9800)
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), START + datetime.timedelta(hours=1)), 9800)
+
+    def test_uses_treatment_price(self):
+        self.assertEqual(cancellation_fee(appt("initial"), START - datetime.timedelta(hours=1)), 14500)
+        self.assertEqual(cancellation_fee(appt("short"), START - datetime.timedelta(hours=30)), 3400)
