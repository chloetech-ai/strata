+"""Durations typed by the front desk, such as '45', '1h30' or '1:30'."""
+
+import re
+
+# Each form is matched against the whole text, after it is stripped and lowercased.
+_HOURS = re.compile(r"(\d+)\s*h\s*(?:(\d+)\s*(?:min|m)?)?")
+_MINUTES = re.compile(r"(\d+)\s*(?:min|m)?")
+_CLOCK = re.compile(r"(\d+):(\d+)")
+
+
+def parse_duration(text):
+    """Number of minutes in `text`. Raises ValueError if it is empty, zero or not a duration."""
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("duration is empty")
+
+    minutes = _minutes(cleaned)
+    if minutes is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _minutes(cleaned):
+    match = _HOURS.fullmatch(cleaned)
+    if match:
+        return _hours_and_minutes(match.group(1), match.group(2) or "0")
+
+    match = _MINUTES.fullmatch(cleaned)
+    if match:
+        return int(match.group(1))
+
+    match = _CLOCK.fullmatch(cleaned)
+    if match:
+        return _hours_and_minutes(match.group(1), match.group(2))
+
+    return None
+
+
+def _hours_and_minutes(hours, minutes):
+    # '1h90' and '1:90' are refused rather than read as 150 minutes.
+    if int(minutes) >= 60:
+        return None
+    return int(hours) * 60 + int(minutes)
