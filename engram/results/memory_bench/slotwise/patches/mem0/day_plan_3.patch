@@ -0,0 +1,33 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_non_cancelled_appointments_in_order(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 14, 0), "standard"))
+        early = s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 8, 0), "initial"))
+        s.cancel(early.id)
+        s.book(Appointment("lena", "Ana Roy", datetime.datetime(2026, 9, 8, 9, 0), "short"))
+        s.book(Appointment("marco", "Other", datetime.datetime(2026, 9, 8, 10, 0)))
+        self.assertEqual(
+            day_plan(s, "lena", datetime.date(2026, 9, 8)),
+            "Day plan: lena, 2026-09-08\n"
+            "09:00-09:30  Ana Roy  short\n"
+            "14:00-14:45  Kim Weber  standard\n",
+        )
+
+    def test_empty_day(self):
+        s = Schedule()
+        self.assertEqual(
+            day_plan(s, "lena", datetime.date(2026, 9, 8)),
+            "Day plan: lena, 2026-09-08\nNo appointments.\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
