+    def test_free_slots_on_empty_day_is_whole_grid(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # last start that ends by 19:00
+        self.assertEqual(len(slots), 44)
+
+    def test_free_slots_keep_cleanup_gap_around_bookings(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertEqual(
+            slots[:3],
+            [datetime.datetime(2026, 9, 8, 7, 30), datetime.datetime(2026, 9, 8, 7, 45), datetime.datetime(2026, 9, 8, 8, 0)],
+        )
+        self.assertEqual(slots[3], datetime.datetime(2026, 9, 8, 10, 0))  # 09:45 + gap = 09:55, next grid time
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+
