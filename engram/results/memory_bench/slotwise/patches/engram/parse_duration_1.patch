+++ b/src/slotwise/durations.py
@@ -0,0 +1,44 @@
+"""Parse human-typed durations such as '45', '1h30' or '1:30' into minutes."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*(?:m|min|mins)?")
+_HOURS = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*(?:m|min|mins)?)?")
+_CLOCK = re.compile(r"(\d+)\s*:\s*(\d{2})")
+
+
+def parse_duration(text):
+    """Return the duration in minutes. Raise ValueError if it is not a positive duration."""
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("duration is empty")
+
+    minutes = _parse_minutes(cleaned)
+    if minutes is None:
+        raise ValueError(f"cannot read {text!r} as a duration; try '45', '1h30' or '1:30'")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero, got {text!r}")
+    return minutes
+
+
+def _parse_minutes(cleaned):
+    match = _CLOCK.fullmatch(cleaned)
+    if match:
+        return _hours_and_minutes(match.group(1), match.group(2))
+
+    match = _HOURS.fullmatch(cleaned)
+    if match:
+        return _hours_and_minutes(match.group(1), match.group(2) or "0")
+
+    match = _MINUTES.fullmatch(cleaned)
+    if match:
+        return int(match.group(1))
+
+    return None
+
+
+def _hours_and_minutes(hours, minutes):
+    """Return the total, or None when the minutes part is 60 or more (e.g. '1:75')."""
+    if int(minutes) >= 60:
+        return None
+    return int(hours) * 60 + int(minutes)
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..57b21cf
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,46 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_empty_input(self):
+        for text in ["", "   "]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_zero(self):
+        for text in ["0", "0m", "0h", "0:00"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_anything_else(self):
+        for text in ["abc", "-5", "1.5h", "1:5", "1:75", "1h75", "h", "45 seconds"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
