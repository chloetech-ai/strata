+++ b/tests/test_reminders.py
@@ -0,0 +1,42 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text, to_ascii
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_become_two_letters(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Jörg Müller"), "Joerg Mueller")
+        self.assertEqual(to_ascii("ÄÖÜ ß"), "AeOeUe ss")
+
+    def test_other_accents_drop_the_accent(self):
+        self.assertEqual(to_ascii("Zoë"), "Zoe")
+        self.assertEqual(to_ascii("René"), "Rene")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_reminder_names_client_day_date_time_and_reception(self):
+        appointment = Appointment("lena", "Ana Brändli", datetime.datetime(2026, 10, 20, 9, 0))
+        text = reminder_text(appointment)
+        self.assertEqual(
+            text,
+            "Lindqvist Physio: Ana Braendli, your appointment is Tuesday 20 October at 09:00. "
+            "To move it, call 044 512 77 30.",
+        )
+
+    def test_reminder_is_plain_ascii_and_at_most_160_characters(self):
+        appointment = Appointment("lena", "Zoë Brändli-Müller", datetime.datetime(2026, 9, 8, 14, 30))
+        text = reminder_text(appointment)
+        self.assertTrue(text.isascii())
+        self.assertLessEqual(len(text), 160)
+
+    def test_too_long_reminder_is_refused(self):
+        appointment = Appointment("lena", "X" * 150, datetime.datetime(2026, 9, 8, 14, 30))
+        with self.assertRaises(ValueError):
+            reminder_text(appointment)
+
+
+if __name__ == "__main__":
+    unittest.main()
