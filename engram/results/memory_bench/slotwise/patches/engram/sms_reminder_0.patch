+"""SMS appointment reminders."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+MAX_LENGTH = 160  # longer SMS are billed as two messages
+
+_UMLAUTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+_WEEKDAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
+_MONTHS = [
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+]
+
+
+def to_ascii(text):
+    """Returns `text` in plain ASCII, as the SMS gateway needs.
+
+    Umlauts become two letters ('Brändli' -> 'Braendli'). Other accents are dropped ('Zoë' -> 'Zoe').
+    Anything else that cannot be converted becomes '?'.
+    """
+    for char, replacement in _UMLAUTS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(c for c in decomposed if not unicodedata.combining(c))
+    return stripped.encode("ascii", "replace").decode("ascii")
+
+
+def reminder_text(appointment):
+    """Returns the reminder SMS for `appointment`, in plain ASCII and at most 160 characters."""
+    start = appointment.start
+    text = (
+        f"Lindqvist Physio: {to_ascii(appointment.client)}, your appointment is "
+        f"{_WEEKDAYS[start.weekday()]} {start:%d} {_MONTHS[start.month - 1]} at {start:%H:%M}. "
+        f"To move it, call {RECEPTION_NUMBER}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder for {appointment.client!r} is {len(text)} characters, over {MAX_LENGTH}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
