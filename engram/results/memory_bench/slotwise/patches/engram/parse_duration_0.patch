@@ -0,0 +1,26 @@
+"""Durations typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-5]?[0-9])\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-5][0-9])")
+
+
+def parse_duration(text):
+    """Length in minutes of a duration such as '45 min', '1h 30m' or '1:30'.
+
+    Raises ValueError if the text is not a duration or is zero.
+    """
+    s = text.strip().lower()
+    if m := _MINUTES.fullmatch(s):
+        minutes = int(m[1])
+    elif m := _HOURS.fullmatch(s):
+        minutes = int(m[1]) * 60 + int(m[2] or 0)
+    elif m := _CLOCK.fullmatch(s):
+        minutes = int(m[1]) * 60 + int(m[2])
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..079faea
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,33 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class DurationsTest(unittest.TestCase):
+    def test_plain_minutes(self):
+        self.assertEqual(parse_duration("45"), 45)
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("45 min"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("2h15"), 135)
+
+    def test_clock_form(self):
+        self.assertEqual(parse_duration("1:30"), 90)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_empty_zero_and_other_input(self):
+        for text in ["", "   ", "0", "0h", "0:00", "abc", "-5", "1h90", "1:75", "1.5h"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
