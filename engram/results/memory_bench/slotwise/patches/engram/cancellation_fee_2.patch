@@ -0,0 +1,32 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 7, 9, 0)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def fee(self, treatment, hours_before):
+        appointment = Appointment("lena", "Kim Weber", START, treatment)
+        return cancellation_fee(appointment, START - datetime.timedelta(hours=hours_before))
+
+    def test_no_fee_at_48_hours_or_more(self):
+        self.assertEqual(self.fee("standard", 48), 0)
+        self.assertEqual(self.fee("standard", 72), 0)
+
+    def test_half_price_under_48_hours(self):
+        self.assertEqual(self.fee("standard", 47), 4900)
+        self.assertEqual(self.fee("initial", 24), 7250)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(self.fee("standard", 23), 9800)
+        self.assertEqual(self.fee("short", 0), 6800)
+
+    def test_full_price_after_start(self):
+        self.assertEqual(self.fee("initial", -1), 14500)
+
+
+if __name__ == "__main__":
+    unittest.main()
