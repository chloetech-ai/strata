diff --git a/src/slotwise/series.py b/src/slotwise/series.py
new file mode 100644
index 0000000..a1a7ac9
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,52 @@
+"""Booking a series of weekly sessions, as prescribed by a doctor."""
+
+import datetime
+
+from .errors import OutsideOpeningHours, SeriesNotFitting, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# The insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+# Free weeks are searched for only this many weeks after the first appointment.
+SEARCH_WEEKS = 12
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions, starting with `first`, at the same weekday and time.
+
+    A week whose slot is taken, or when the practice is closed, is skipped and the series
+    runs on into a later week instead. Either every session is booked or none is.
+    Returns the booked appointments, in date order.
+    """
+    if count < 1:
+        raise ValueError("a series needs at least one session")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(
+            f"A series can have at most {MAX_SESSIONS} sessions, because the insurance pays for "
+            f"{MAX_SESSIONS} per prescription. {count} were asked for, so nothing was booked."
+        )
+
+    booked = [schedule.book(first)]
+    for weeks in range(1, SEARCH_WEEKS):
+        if len(booked) == count:
+            break
+        session = Appointment(
+            first.therapist,
+            first.client,
+            first.start + datetime.timedelta(weeks=weeks),
+            first.treatment,
+        )
+        try:
+            booked.append(schedule.book(session))
+        except (SlotTaken, OutsideOpeningHours):
+            continue
+
+    if len(booked) < count:
+        found = len(booked)
+        # The sessions were appended to the schedule last, so they are the final entries.
+        del schedule.appointments[-found:]
+        raise SeriesNotFitting(
+            f"Only {found} of the {count} sessions for {first.therapist} fit within {SEARCH_WEEKS} "
+            f"weeks from {first.start:%A %d %B}, so nothing was booked. Choose a different day or time."
+        )
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..b273c15
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,86 @@
+import datetime
+import unittest
+
+from slotwise.errors import SeriesNotFitting, SeriesTooLong, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, SEARCH_WEEKS, book_series
+
+
+def at(day, hour, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute))
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_the_same_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8, 9), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9) for d in (8, 15, 22)],
+        )
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_first_is_the_first_booked_appointment(self):
+        s = Schedule()
+        first = at(8, 9)
+        self.assertIs(book_series(s, first, 2)[0], first)
+
+    def test_sessions_are_separate_appointments_for_the_same_client(self):
+        s = Schedule()
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual(len({a.id for a in booked}), 2)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("lena", "Kim Weber", "standard")})
+
+    def test_skips_a_taken_week_and_runs_one_week_longer(self):
+        s = Schedule()
+        s.book(at(15, 9, client="Jo Li"))
+        booked = book_series(s, at(8, 9), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9) for d in (8, 22, 29)],
+        )
+
+    def test_week_clashing_on_the_cleanup_gap_is_skipped(self):
+        s = Schedule()
+        s.book(at(15, 9, 50, client="Jo Li"))  # clashes with 09:00-09:45 under the 10-minute gap
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 22])
+
+    def test_cancelled_week_does_not_block(self):
+        s = Schedule()
+        blocker = s.book(at(15, 9, client="Jo Li"))
+        s.cancel(blocker.id)
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_taken_first_session_is_refused_and_nothing_is_booked(self):
+        s = Schedule()
+        s.book(at(8, 9, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(8, 9), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_more_than_the_maximum_is_refused_and_nothing_is_booked(self):
+        s = Schedule()
+        with self.assertRaisesRegex(SeriesTooLong, f"at most {MAX_SESSIONS} sessions"):
+            book_series(s, at(8, 9), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_partial_series_is_refused_and_nothing_is_booked(self):
+        s = Schedule()
+        for week in range(1, SEARCH_WEEKS):
+            start = datetime.datetime(2026, 9, 8, 9) + datetime.timedelta(weeks=week)
+            s.book(Appointment("lena", "Jo Li", start))  # every later week is taken
+        before = len(s.appointments)
+        with self.assertRaisesRegex(SeriesNotFitting, "Only 1 of the 2 sessions for lena.*Tuesday 08 September"):
+            book_series(s, at(8, 9), 2)
+        self.assertEqual(len(s.appointments), before)
+
+    def test_count_below_one_is_a_programming_error(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), at(8, 9), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
