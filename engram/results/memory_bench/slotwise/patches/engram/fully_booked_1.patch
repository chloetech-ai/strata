+    def test_is_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        for hour in range(8, 8 + 7):  # hourly, so each 45-minute treatment clears the 10-minute gap
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_is_not_fully_booked_below_seven(self):
+        s = Schedule()
+        for hour in range(8, 8 + 6):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_is_fully_booked_counts_bookings_over_the_cap(self):
+        s = Schedule()
+        for hour in range(8, 8 + 8):
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        s = Schedule()
+        booked = [s.book(at(hour)) for hour in range(8, 8 + 7)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_ignores_other_therapists_and_days(self):
