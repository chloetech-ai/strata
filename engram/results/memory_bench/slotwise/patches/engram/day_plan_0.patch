@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        text = day_plan(s, "lena", DAY)
+        self.assertEqual(
+            text,
+            "Day plan: lena\n"
+            "Tuesday 08 September 2026\n"
+            "\n"
+            "09:00-09:45 Kim Weber, standard\n"
+            "10:00-10:30 Jo Li, short",
+        )
+
+    def test_empty_day(self):
+        self.assertIn("No appointments.", day_plan(Schedule(), "lena", DAY))
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        s.book(at(12, therapist="sam"))
+        s.cancel(s.appointments[0].id)
+        text = day_plan(s, "lena", DAY)
+        self.assertNotIn("Kim Weber", text)
+        self.assertIn("11:00-11:45 Jo Li, standard", text)
+        self.assertNotIn("sam", text)
+
+    def test_no_line_is_wider_than_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maximiliane Konstantinopoulou-Esterhazy von Berchtesgaden"))
+        s.book(at(11, therapist="Dr. Annemarie Vanderbilt-Hohenstaufen"))
+        for line in day_plan(s, "lena", DAY).split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+        for line in day_plan(s, "Dr. Annemarie Vanderbilt-Hohenstaufen", DAY).split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
