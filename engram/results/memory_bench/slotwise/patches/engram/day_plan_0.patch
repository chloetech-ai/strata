+"""Printable text for the reception's receipt printer."""
+
+import textwrap
+
+# The receipt printer prints 42 characters a line; longer lines wrap into a mess.
+LINE_WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """Text of `therapist`'s active appointments on `day`, by start time, for reception to print."""
+    lines = [f"Day plan: {therapist}", f"{day:%A %d %B %Y}", ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M} {a.client}, {a.treatment}")
+    return "\n".join(line for text in lines for line in _wrap(text))
+
+
+def _wrap(text):
+    """`text` split into lines that fit the printer, continuation lines indented."""
+    return textwrap.wrap(text, LINE_WIDTH, subsequent_indent="      ") or [""]
