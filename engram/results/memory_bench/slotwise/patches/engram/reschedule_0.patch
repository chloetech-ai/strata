+    def test_reschedule_moves_the_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.end, datetime.datetime(2026, 9, 8, 11, 45))
+        self.assertEqual(a.treatment, "standard")
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_frees_the_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        s.book(at(9, client="Jo Li"))
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_reschedule_by_a_few_minutes_does_not_clash_with_itself(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 5))
+
+    def test_reschedule_into_another_appointment_is_taken(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "lena already has an appointment from 11:00 to 11:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_respects_the_cleanup_gap(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))  # 11:00-11:45
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 50))  # 10:50-11:35, gap is 0
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 0))  # 10:00-10:45, gap is 15 minutes
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 10, 0))
