+"""Printable documents for reception."""
+
+import textwrap
+
+# The reception receipt printer prints 42 characters per line; longer lines wrap into a mess.
+LINE_WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """Plain text day plan for `therapist` on `day`, fitted to the receipt printer's line width.
+
+    Cancelled appointments are left out.
+    """
+    lines = [
+        f"{therapist.title()} - {day:%A %d %B %Y}",
+        "-" * LINE_WIDTH,
+    ]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M} {a.treatment}")
+        lines.append(f"  {a.client}")
+    return "\n".join(_fit(line) for line in lines) + "\n"
+
+
+def _fit(line):
+    """`line` wrapped to the printer width, continuation lines indented by two spaces."""
+    return textwrap.fill(line, width=LINE_WIDTH, subsequent_indent="  ", break_long_words=True)
diff --git a/tests/test_printing.py b/tests/test_printing.py
