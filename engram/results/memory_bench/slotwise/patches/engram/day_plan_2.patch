+++ b/tests/test_printing.py
@@ -0,0 +1,52 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li"))
+        s.book(at(9))
+        plan = day_plan(s, "lena", MONDAY)
+        self.assertLess(plan.index("09:00-09:45"), plan.index("10:00-10:45"))
+        self.assertIn("Kim Weber", plan)
+        self.assertIn("Jo Li", plan)
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        s.book(at(9))
+        s.cancel(s.appointments[0].id)
+        s.book(at(11, therapist="sam", client="Ann Ek"))
+        plan = day_plan(s, "lena", MONDAY)
+        self.assertNotIn("Kim Weber", plan)
+        self.assertNotIn("Ann Ek", plan)
+        self.assertIn("No appointments.", plan)
+
+    def test_no_line_is_wider_than_the_printer(self):
+        s = Schedule()
+        s.book(at(9, treatment="initial", client="Maximilian Alexandrovich-Strousberg-Hohenlohe"))
+        s.book(at(11, client="Kim Weber"))
+        for line in day_plan(s, "lena", MONDAY).splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+
+    def test_long_name_wraps_and_keeps_all_of_it(self):
+        s = Schedule()
+        name = "Maximilian Alexandrovich-Strousberg-Hohenlohe"
+        s.book(at(9, client=name))
+        plan = day_plan(s, "lena", MONDAY)
+        self.assertNotIn(name, plan)  # too long for one line, so it is broken across lines
+        self.assertEqual("".join(plan.split()).count("".join(name.split())), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
