+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which `therapist` could book an appointment of `minutes`.
+
+        Slots run every 15 minutes from opening time and must fit within opening hours and
+        pass the same clash and cleanup-gap check as `book()`. The daily cap of 7 is not applied here.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clash(self, therapist, start, end):
+        """The active appointment of `therapist` that blocks `start`-`end` with the cleanup gap, or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + CLEANUP_GAP and start < other.end + CLEANUP_GAP:
+                return other
+        return None
+
