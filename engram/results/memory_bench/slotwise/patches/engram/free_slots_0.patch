+    def test_free_slots_on_empty_day_run_from_opening_every_15_minutes(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[1], datetime.datetime(2026, 9, 8, 7, 45))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends at 19:00
+
+    def test_free_slots_on_closed_day_is_empty(self):
+        s = Schedule()
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 6), 45), [])  # Sunday
+
+    def test_free_slots_on_saturday_stop_at_noon(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 12), 60)  # Saturday, 08:00-12:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 12, 8, 0))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 0))
+
+    def test_free_slots_respect_booking_and_cleanup_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so nothing may end after 08:50 or start before 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 15 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, no gap
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # first grid slot after 09:45
+
