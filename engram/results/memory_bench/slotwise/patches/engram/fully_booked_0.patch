+    def test_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        for hour in range(8, 15):  # 08:00 to 14:00, one every hour
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_not_fully_booked_below_seven(self):
+        s = Schedule()
+        for hour in range(8, 14):  # six appointments
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_counts_appointments_over_the_cap(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour))
+        s.book(at(15))  # reception booked over the cap
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertEqual(len(s.appointments), 8)
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        s = Schedule()
+        booked = [s.book(at(hour)) for hour in range(8, 15)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
