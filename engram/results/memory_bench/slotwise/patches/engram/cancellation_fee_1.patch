+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 8, 9, 0)
+        self.appointment = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def cancel_before(self, hours):
+        return cancellation_fee(self.appointment, self.start - datetime.timedelta(hours=hours))
+
+    def test_under_24_hours_pays_full_price(self):
+        self.assertEqual(self.cancel_before(2), 9800)
+        self.assertEqual(self.cancel_before(23.9), 9800)
+
+    def test_exactly_24_hours_pays_half(self):
+        self.assertEqual(self.cancel_before(24), 4900)
+
+    def test_between_24_and_48_hours_pays_half(self):
+        self.assertEqual(self.cancel_before(30), 4900)
+        self.assertEqual(self.cancel_before(47.9), 4900)
+
+    def test_48_hours_or_more_pays_nothing(self):
+        self.assertEqual(self.cancel_before(48), 0)
+        self.assertEqual(self.cancel_before(200), 0)
+
+    def test_fee_uses_the_treatment_price(self):
+        initial = Appointment("lena", "Kim Weber", self.start, "initial")
+        self.assertEqual(cancellation_fee(initial, self.start - datetime.timedelta(hours=1)), 14500)
+        self.assertEqual(cancellation_fee(initial, self.start - datetime.timedelta(hours=30)), 7250)
+
+
+if __name__ == "__main__":
+    unittest.main()
