+    def test_reschedule_moves_appointment_and_keeps_its_details(self):
+        s = Schedule()
+        a = s.book(at(9, treatment="short"))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual((a.therapist, a.client, a.treatment), ("lena", "Kim Weber", "short"))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_into_own_old_slot_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))  # overlaps only its old self
+        self.assertEqual(a.start.minute, 5)
+
+    def test_reschedule_clash_is_refused_and_appointment_stays(self):
+        s = Schedule()
+        s.book(at(9, client="Jo Li"))
+        a = s.book(at(11))
+        with self.assertRaisesRegex(SlotTaken, "lena already has an appointment from 09:00 to 09:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_respects_cleanup_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        a = s.book(at(12))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 55))
+        self.assertEqual(a.start.hour, 9)
+        self.assertEqual(a.start.minute, 55)
+
+    def test_reschedule_outside_opening_hours_is_refused_and_appointment_stays(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_ignores_cancelled_clashes(self):
+        s = Schedule()
+        other = s.book(at(9, client="Jo Li"))
+        s.cancel(other.id)
+        a = s.book(at(11))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 0))
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(CancelledAppointment):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
