@@ -0,0 +1,37 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 8, 9, 0)
+        self.standard = Appointment("lena", "Kim Weber", self.start)
+        self.initial = Appointment("lena", "Kim Weber", self.start, "initial")
+
+    def at_notice(self, hours):
+        return self.start - datetime.timedelta(hours=hours)
+
+    def test_free_when_cancelled_48_hours_or_more_before(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at_notice(72)), 0)
+        self.assertEqual(cancellation_fee(self.standard, self.at_notice(48)), 0)
+
+    def test_half_price_when_cancelled_under_48_hours_before(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at_notice(47)), 4900)
+        self.assertEqual(cancellation_fee(self.initial, self.at_notice(30)), 7250)
+
+    def test_half_price_at_exactly_24_hours_before(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at_notice(24)), 4900)
+
+    def test_full_price_when_cancelled_under_24_hours_before(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at_notice(23)), 9800)
+        self.assertEqual(cancellation_fee(self.initial, self.at_notice(0)), 14500)
+
+    def test_full_price_after_the_appointment_has_started(self):
+        self.assertEqual(cancellation_fee(self.standard, self.at_notice(-1)), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
