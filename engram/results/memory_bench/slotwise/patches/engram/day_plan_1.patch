@@ -0,0 +1,28 @@
+"""Printable text for the reception receipt printer."""
+
+import textwrap
+
+# The receipt printer prints at most 42 characters a line; longer lines wrap into a mess.
+LINE_WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """Text plan of `therapist`'s active appointments on `day`, for reception to print.
+
+    Every line fits within `LINE_WIDTH` characters. Cancelled appointments are left out.
+    """
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    lines = [f"Day plan: {therapist}", f"{day:%A %d %B %Y}", ""]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.treatment}")
+        lines.append(f"  {a.client}")
+    return "\n".join(line for text in lines for line in _fit(text))
+
+
+def _fit(text):
+    """`text` wrapped to `LINE_WIDTH`, continuation lines indented by two spaces."""
+    if not text:
+        return [""]
+    return textwrap.wrap(text, width=LINE_WIDTH, subsequent_indent="  ", break_long_words=True)
diff --git a/tests/test_printing.py b/tests/test_printing.py
