--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li"))
+        s.book(at(9))
+        plan = day_plan(s, "lena", DAY)
+        self.assertEqual(
+            plan,
+            "Day plan: lena\n"
+            "Tuesday 08 September 2026\n"
+            "\n"
+            "09:00-09:45  standard\n"
+            "  Kim Weber\n"
+            "10:00-10:45  standard\n"
+            "  Jo Li",
+        )
+
+    def test_leaves_out_cancelled_appointments(self):
+        s = Schedule()
+        s.book(at(9))
+        booked = s.book(at(10, client="Jo Li"))
+        s.cancel(booked.id)
+        self.assertNotIn("Jo Li", day_plan(s, "lena", DAY))
+
+    def test_other_therapists_are_left_out(self):
+        s = Schedule()
+        s.book(at(9, therapist="sam", client="Jo Li"))
+        self.assertIn("No appointments.", day_plan(s, "lena", DAY))
+
+    def test_empty_day(self):
+        self.assertEqual(day_plan(Schedule(), "lena", DAY).splitlines()[-1], "No appointments.")
+
+    def test_no_line_is_wider_than_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maximilian Alexander Konstantin Wolfgang-Friedrich von Hohenstein"))
+        for line in day_plan(s, "lena", DAY).splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
