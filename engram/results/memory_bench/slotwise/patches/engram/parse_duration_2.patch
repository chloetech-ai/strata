index 0000000..3615603
--- /dev/null
+++ b/src/slotwise/durations.py
@@ -0,0 +1,34 @@
+"""Appointment durations as typed by reception."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)(?:\s*(?:m|min))?")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '45 min', '1h', '1h 30m' or '1:30'.
+
+    Raises ValueError for anything else, for zero, and for minutes of 60 or more
+    written after hours.
+    """
+    cleaned = text.strip().lower()
+    if match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+    elif match := _HOURS.fullmatch(cleaned):
+        minutes = _hours_and_minutes(match[1], match[2])
+    elif match := _CLOCK.fullmatch(cleaned):
+        minutes = _hours_and_minutes(match[1], match[2])
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _hours_and_minutes(hours, minutes):
+    minutes = int(minutes) if minutes else 0
+    if minutes >= 60:
+        raise ValueError(f"minutes must be below 60 after the hours: {minutes}")
+    return int(hours) * 60 + minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
