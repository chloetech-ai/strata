+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which an appointment of `minutes` could be booked for `therapist`.
+
+        The times step through the day in 15-minute steps from opening time. Empty if the practice is closed.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clashing(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clashing(self, therapist, start, end):
+        """The first active appointment of `therapist` that leaves no cleanup gap to `start`-`end`, or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + CLEANUP_GAP and start < other.end + CLEANUP_GAP:
+                return other
+        return None
