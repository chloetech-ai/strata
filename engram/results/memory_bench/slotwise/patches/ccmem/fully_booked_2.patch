+    def test_day_is_fully_booked_when_no_treatment_fits(self):
+        # Friday 07:30-17:00. Short treatments every 40 min leave 10-minute gaps,
+        # too small for another 30-minute treatment with its buffers.
+        s = Schedule()
+        friday = datetime.date(2026, 9, 11)
+        first = datetime.datetime(2026, 9, 11, 7, 30)
+        for i in range(13):
+            s.book(Appointment("lena", "Kim Weber", first + datetime.timedelta(minutes=40 * i), "short"))
+        self.assertFalse(s.is_fully_booked("lena", friday))  # 16:10-16:40 still free
+        s.book(Appointment("lena", "Jo Li", first + datetime.timedelta(minutes=40 * 13), "short"))
+        self.assertTrue(s.is_fully_booked("lena", friday))
+
+    def test_cancelled_appointments_do_not_count_as_booked(self):
+        s = Schedule()
+        friday = datetime.date(2026, 9, 11)
+        first = datetime.datetime(2026, 9, 11, 7, 30)
+        booked = [
