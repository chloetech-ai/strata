 import datetime
 
 from .errors import BookingError, OutsideOpeningHours, SlotTaken
-from .hours import is_open_between
+from .hours import is_open_between, opening_hours
 from .model import TREATMENTS
 
 # Time a therapist needs between two appointments to clean up and write notes.
@@ -72,3 +72,25 @@ class Schedule:
             day: [a for a in self.appointments_for(therapist, day) if not a.cancelled]
             for day in days
         }
+
+    def is_fully_booked(self, therapist, day):
+        """True if no treatment we offer could still start on `day` for `therapist`.
+
+        Uses opening hours, active appointments and BUFFER. A closed day counts as
+        fully booked, so the online booking page can grey it out too.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return True
+        opens, closes = hours
+        shortest = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        active = [a for a in self.appointments_for(therapist, day) if not a.cancelled]
+        # The earliest free start is either opening time or just after BUFFER
+        # following an appointment, so only those starts need checking.
+        for start in [opens] + [a.end + BUFFER for a in active]:
+            end = start + shortest
+            if end > closes:
+                continue
+            if all(other.start >= end + BUFFER or start >= other.end + BUFFER for other in active):
+                return False
+        return True
