@@ -0,0 +1,47 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", client="Kim Weber", treatment="standard"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(Schedule(), "lena", MONDAY),
+            "Day plan: Lena, Monday 07 September 2026\n\nNo appointments.\n",
+        )
+
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="initial"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan: Lena, Monday 07 September 2026\n\n"
+            "09:00-09:45  Kim Weber             standard\n"
+            "10:00-11:00  Jo Li                 initial\n",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, therapist="marco", client="Jo Li"))
+        s.cancel(a.id)
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+    def test_other_days_are_left_out(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9, 0)))
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+
+if __name__ == "__main__":
+    unittest.main()
