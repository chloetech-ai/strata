+"""Printable documents for the front desk."""
+
+
+def day_plan(schedule, therapist, day):
+    """Text of `therapist`'s appointments on `day`, for printing at reception.
+
+    Cancelled appointments are left out. Each line gives the time, the client
+    and the treatment, in start-time order.
+    """
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    lines = [f"Day plan: {therapist.title()}, {day:%A %d %B %Y}", ""]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client:<20}  {a.treatment}")
+    return "\n".join(lines) + "\n"
