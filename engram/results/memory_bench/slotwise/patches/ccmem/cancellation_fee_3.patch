@@ -0,0 +1,33 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.appointment = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def cancel_hours_before(self, hours):
+        return cancellation_fee(self.appointment, self.start - datetime.timedelta(hours=hours))
+
+    def test_free_with_48_hours_or_more_notice(self):
+        self.assertEqual(self.cancel_hours_before(49), 0)
+        self.assertEqual(self.cancel_hours_before(48), 0)
+
+    def test_half_price_under_48_hours(self):
+        self.assertEqual(self.cancel_hours_before(47), 4900)
+        self.assertEqual(self.cancel_hours_before(24), 4900)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(self.cancel_hours_before(23), 9800)
+        self.assertEqual(self.cancel_hours_before(0), 9800)
+
+    def test_cancelling_after_start_costs_full_price(self):
+        self.assertEqual(self.cancel_hours_before(-1), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
