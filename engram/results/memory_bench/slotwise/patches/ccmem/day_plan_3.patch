+++ b/src/slotwise/printing.py
@@ -0,0 +1,15 @@
+"""Printable documents for the front desk."""
+
+
+def day_plan(schedule, therapist, day):
+    """Plain-text plan of `therapist`'s appointments on `day`, for reception to print.
+
+    Cancelled appointments are left out, as they no longer take up a slot.
+    """
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    lines = [f"Day plan: {therapist.title()}, {day:%A %d %B %Y}", ""]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  ({a.treatment})")
+    return "\n".join(lines) + "\n"
