+"""Weekly series of appointments, booked from a prescription."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for 9 sessions per prescription.
+MAX_SESSIONS = 9
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them in order.
+
+    Each session has the same therapist, client and treatment as `first`, and is
+    one week after the previous one. If a week's slot is already taken, that week
+    is skipped and the series continues in the next free week, so the series
+    always gets all `count` sessions.
+
+    Every session goes through `schedule.book()`, so opening hours, the treatment
+    check and the buffer apply. Because the weekday and time are the same every
+    week, a refusal for those reasons comes on the first session, before anything
+    is booked.
+
+    Raises BookingError if `count` is more than MAX_SESSIONS, and ValueError if it
+    is less than 1.
+    """
+    if count < 1:
+        raise ValueError(f"A series needs at least one session, not {count}")
+    if count > MAX_SESSIONS:
+        raise BookingError(
+            f"A series is limited to {MAX_SESSIONS} sessions, because insurance covers "
+            f"{MAX_SESSIONS} per prescription. Please request {MAX_SESSIONS} or fewer."
+        )
+
+    booked = []
+    start = first.start
+    while len(booked) < count:
+        session = Appointment(first.therapist, first.client, start, first.treatment)
+        try:
+            schedule.book(session)
+        except SlotTaken:
+            pass  # This week is blocked; the series moves on to a later week.
+        else:
+            booked.append(session)
+        start += WEEK
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
