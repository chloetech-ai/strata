+++ b/tests/test_series.py
@@ -0,0 +1,96 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def first(hour=9, day=8, therapist="lena", treatment="standard", client="Kim Weber"):
+    # 2026-09-08 is a Tuesday
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour), treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions_in_order(self):
+        s = Schedule()
+        sessions = book_series(s, first(), 3)
+        self.assertEqual(
+            [a.start.date() for a in sessions],
+            [datetime.date(2026, 9, 8), datetime.date(2026, 9, 15), datetime.date(2026, 9, 22)],
+        )
+        self.assertEqual(s.appointments, sessions)
+
+    def test_sessions_keep_therapist_client_treatment_and_time(self):
+        s = Schedule()
+        for a in book_series(s, first(hour=14, therapist="marco", treatment="short", client="Jo Li"), 2):
+            self.assertEqual((a.therapist, a.client, a.treatment), ("marco", "Jo Li", "short"))
+            self.assertEqual(a.start.hour, 14)
+            self.assertFalse(a.cancelled)
+
+    def test_sessions_get_their_own_ids(self):
+        s = Schedule()
+        start = first()
+        sessions = book_series(s, start, 3)
+        self.assertEqual(len({a.id for a in sessions}), 3)
+        self.assertNotIn(start.id, {a.id for a in sessions})
+
+    def test_first_is_not_changed(self):
+        s = Schedule()
+        start = first()
+        book_series(s, start, 2)
+        self.assertEqual(start.start, datetime.datetime(2026, 9, 8, 9))
+        self.assertFalse(start in s.appointments)
+
+    def test_taken_week_is_skipped_and_series_appended_at_end(self):
+        s = Schedule()
+        s.book(first(day=15, client="Jo Li"))  # blocks the second week
+        sessions = book_series(s, first(), 3)
+        self.assertEqual(
+            [a.start.date() for a in sessions],
+            [datetime.date(2026, 9, 8), datetime.date(2026, 9, 22), datetime.date(2026, 9, 29)],
+        )
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_first_week_taken_starts_later(self):
+        s = Schedule()
+        s.book(first(client="Jo Li"))
+        sessions = book_series(s, first(), 2)
+        self.assertEqual([a.start.date() for a in sessions], [datetime.date(2026, 9, 15), datetime.date(2026, 9, 22)])
+
+    def test_other_therapist_does_not_block_series(self):
+        s = Schedule()
+        s.book(first(therapist="marco", client="Jo Li"))
+        self.assertEqual(len(book_series(s, first(), 3)), 3)
+
+    def test_nine_sessions_allowed(self):
+        s = Schedule()
+        sessions = book_series(s, first(), MAX_SESSIONS)
+        self.assertEqual(len(sessions), 9)
+
+    def test_more_than_nine_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, first(), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first(), 0)
+
+    def test_closed_day_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, first(day=13), 3)  # 2026-09-13 is a Sunday
+        self.assertEqual(s.appointments, [])
+
+    def test_unknown_treatment_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, first(treatment="massage"), 2)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
