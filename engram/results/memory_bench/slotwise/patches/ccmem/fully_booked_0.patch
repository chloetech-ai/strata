+    def test_empty_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_closed_day_is_fully_booked(self):
+        self.assertTrue(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 13)))  # Sunday
+
+    def test_day_with_no_short_slot_left_is_fully_booked(self):
+        s = Schedule()
+        start = datetime.datetime(2026, 9, 8, 7, 30)
+        while True:
+            try:
+                s.book(Appointment("lena", "Kim Weber", start, "short"))
+            except BookingError:
+                break
+            start += datetime.timedelta(minutes=40)  # 30 minutes plus the 10-minute buffer
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_gap_that_fits_a_short_treatment_is_not_fully_booked(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        s.book(at(11, client="Jo Li"))  # 11:00-11:45, leaves plenty of room in between
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointment_frees_the_day(self):
+        s = Schedule()
+        start = datetime.datetime(2026, 9, 8, 7, 30)
+        booked = []
+        while True:
+            try:
+                booked.append(s.book(Appointment("lena", "Kim Weber", start, "short")))
+            except BookingError:
+                break
+            start += datetime.timedelta(minutes=40)
+        day = datetime.date(2026, 9, 8)
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
