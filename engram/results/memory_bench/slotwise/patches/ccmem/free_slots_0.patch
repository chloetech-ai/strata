+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which an appointment of `minutes` could be booked.
+
+        Times run in 15-minute steps from opening time. A start time is listed
+        only if book() would accept it for `therapist`. Returns [] if the
+        practice is closed that day.
+        """
+        if minutes <= 0:
+            raise ValueError("minutes must be positive")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = hours[0]
+        while is_open_between(start, start + length):
+            if self._blocking(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _blocking(self, therapist, start, end):
+        """An active appointment that stops `therapist` taking `start` to `end`, or None.
+
+        Each appointment needs BUFFER free before and after it.
+        """
+        for other in self.appointments:
+            if other.therapist != therapist or other.cancelled:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
