+    def test_empty_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_closed_day_is_fully_booked(self):
+        self.assertTrue(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 13)))  # Sunday
+
+    def test_full_day_is_fully_booked(self):
+        # Saturday 2026-09-12 is open 08:00-12:00. Three 60-minute appointments
+        # with 10-minute buffers leave 11:30-12:00, which only fits a short one.
+        day = datetime.date(2026, 9, 12)
+        s = Schedule()
+        for hour, minute in [(8, 0), (9, 10), (10, 20)]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), "initial"))
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 12, 11, 30), "short"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_gaps_shorter_than_shortest_treatment_are_fully_booked(self):
+        # Saturday 08:00-12:00. Free time left is 09:10-09:25 (15 min, after
+        # buffers) and 11:55-12:00 (5 min): neither fits a 30-minute treatment.
+        day = datetime.date(2026, 9, 12)
+        s = Schedule()
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, 8, 0), "initial"))  # 08:00-09:00
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 12, 9, 35), "initial"))  # 09:35-10:35
+        s.book(Appointment("lena", "Ana Roth", datetime.datetime(2026, 9, 12, 10, 45), "initial"))  # 10:45-11:45
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointment_frees_its_time(self):
+        day = datetime.date(2026, 9, 12)
+        s = Schedule()
+        for hour, minute in [(8, 0), (9, 10), (10, 20)]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), "initial"))
+        last = s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 12, 11, 30), "short"))
+        self.assertTrue(s.is_fully_booked("lena", day))
