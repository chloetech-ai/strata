 import datetime
 
 from .errors import BookingError, OutsideOpeningHours, SlotTaken
-from .hours import is_open_between
+from .hours import is_open_between, opening_hours
 from .model import TREATMENTS
 
 # Time a therapist needs between two appointments to clean up and write notes.
@@ -72,3 +72,23 @@ class Schedule:
             day: [a for a in self.appointments_for(therapist, day) if not a.cancelled]
             for day in days
         }
+
+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` has no room left on `day` for even the shortest treatment.
+
+        Days the practice is closed count as fully booked. Cancelled appointments
+        are ignored, and the BUFFER around each appointment is respected.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return True
+        opens, closes = hours
+        shortest = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        free_from = opens
+        for a in self.appointments_for(therapist, day):
+            if a.cancelled:
+                continue
+            if a.start - BUFFER - free_from >= shortest:
+                return False
+            free_from = max(free_from, a.end + BUFFER)
+        return closes - free_from < shortest
