+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+def appt(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_free_with_48_hours_notice(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=48)), 0)
+
+    def test_free_well_in_advance(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(days=7)), 0)
+
+    def test_half_price_just_under_48_hours(self):
+        when = START - datetime.timedelta(hours=48) + datetime.timedelta(minutes=1)
+        self.assertEqual(cancellation_fee(appt(), when), 9800 // 2)
+
+    def test_half_price_at_24_hours(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=24)), 9800 // 2)
+
+    def test_full_price_just_under_24_hours(self):
+        when = START - datetime.timedelta(hours=24) + datetime.timedelta(minutes=1)
+        self.assertEqual(cancellation_fee(appt(), when), 9800)
+
+    def test_full_price_after_start(self):
+        self.assertEqual(cancellation_fee(appt("initial"), START + datetime.timedelta(hours=1)), 14500)
+
+    def test_fee_uses_treatment_price(self):
+        self.assertEqual(cancellation_fee(appt("short"), START - datetime.timedelta(hours=1)), 6800)
