+"""Reminder SMS texts for upcoming appointments."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+# The SMS gateway bills anything longer than this as two messages.
+MAX_LENGTH = 160
+
+# Letters that NFKD normalisation does not split into a base letter and an accent.
+_REPLACEMENTS = {
+    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+    "æ": "ae", "Æ": "AE", "ø": "oe", "Ø": "Oe", "œ": "oe", "Œ": "OE",
+}
+
+
+def to_ascii(text):
+    """Transliterate to plain ASCII, e.g. 'Brändli' -> 'Braendli', 'Éric' -> 'Eric'."""
+    text = unicodedata.normalize("NFC", text)
+    for src, dst in _REPLACEMENTS.items():
+        text = text.replace(src, dst)
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """Return the reminder SMS for an appointment: plain ASCII, with the reception number.
+
+    Raises ValueError rather than returning a text that would go out as two messages.
+    """
+    when = appointment.start.strftime("%d.%m.%Y at %H:%M")
+    text = to_ascii(
+        f"Hello {appointment.client}, reminder of your appointment with {appointment.therapist} "
+        f"on {when}. To reschedule call {RECEPTION_NUMBER}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, over the {MAX_LENGTH} limit")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..ec88cc5
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,28 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_NUMBER, reminder_text, to_ascii
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text_is_ascii_and_has_reception_number(self):
+        a = Appointment("lena", "Brändli", datetime.datetime(2026, 10, 20, 9, 0))
+        text = reminder_text(a)
+        self.assertTrue(text.isascii())
+        self.assertIn("Braendli", text)
+        self.assertIn(RECEPTION_NUMBER, text)
+        self.assertIn("20.10.2026 at 09:00", text)
+        self.assertLessEqual(len(text), MAX_LENGTH)
+
+    def test_long_names_are_refused(self):
+        a = Appointment("x" * 100, "y" * 100, datetime.datetime(2026, 10, 20, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+    def test_to_ascii(self):
+        self.assertEqual(to_ascii("Müller Ähre Öl ß é"), "Mueller Aehre Oel ss e")
+
+
+if __name__ == "__main__":
+    unittest.main()
