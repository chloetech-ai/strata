+"""Parsing of appointment durations typed by staff."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*(?:m|min)?")
+_HOURS = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"(\d+):(\d{1,2})")
+
+
+def parse_duration(text):
+    """Turn '45', '45m', '1h', '1h30', '1h 30m' or '1:30' into minutes.
+
+    Raises ValueError for empty input, zero, or anything unrecognised.
+    """
+    value = text.strip().lower()
+    if not value:
+        raise ValueError("empty duration")
+
+    if match := _MINUTES.fullmatch(value):
+        minutes = int(match.group(1))
+    elif match := _HOURS.fullmatch(value):
+        minutes = int(match.group(1)) * 60 + _minutes_part(match.group(2))
+    elif match := _CLOCK.fullmatch(value):
+        minutes = int(match.group(1)) * 60 + _minutes_part(match.group(2))
+    else:
+        raise ValueError(f"unrecognised duration: {text!r}")
+
+    if minutes == 0:
+        raise ValueError("duration must be positive")
+    return minutes
+
+
+def _minutes_part(digits):
+    """Minutes after an hour, which must be below 60 when given."""
+    if digits is None:
+        return 0
+    minutes = int(digits)
+    if minutes >= 60:
+        raise ValueError(f"minutes out of range: {digits}")
+    return minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
