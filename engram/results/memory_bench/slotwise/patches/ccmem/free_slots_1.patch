+    def test_free_slots_empty_day_starts_at_opening(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends exactly at 19:00
+        self.assertEqual(slots[1] - slots[0], datetime.timedelta(minutes=15))
+
+    def test_free_slots_saturday_closes_at_noon(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 12), 30)  # Saturday, 08:00-12:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 12, 8, 0))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 30))
+
+    def test_free_slots_closed_day(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_leave_buffer_around_booking(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)  # ends 09:15, inside buffer
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 15 min before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, no buffer
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # starts 15 min after 09:45
+
