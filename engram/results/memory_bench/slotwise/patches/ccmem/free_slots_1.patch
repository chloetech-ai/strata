+    def _blocking(self, therapist, start, end):
+        """The first active appointment of `therapist` that leaves no BUFFER for [start, end), or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.cancelled:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` where an appointment of `minutes` could be booked for `therapist`.
+
+        Starts are every 15 minutes from opening time, and the appointment must
+        finish before closing. A start counts only if book() would accept it.
+        Returns an empty list on days the practice is closed.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._blocking(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
