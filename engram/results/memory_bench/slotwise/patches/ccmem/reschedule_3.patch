+    def reschedule(self, appointment_id, new_start):
+        """Moves an existing appointment to start at `new_start`.
+
+        The same checks as `book` apply, except that the appointment does not
+        block its own old slot. If the check fails, the appointment is left
+        where it was. Raises KeyError if there is no such appointment, and
+        BookingError (or a subclass) if it is cancelled or the new time is refused.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError(
+                f"{appointment.client}'s appointment is cancelled, so it cannot be moved. "
+                "Please book a new appointment instead."
+            )
+        candidate = dataclasses.replace(appointment, start=new_start)
+        self._check(candidate, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
