@@ -0,0 +1,56 @@
+"""Weekly series of appointments, as prescribed by a doctor."""
+
+import datetime
+
+from .errors import BookingError, OutsideOpeningHours, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+# How many weeks after `first` we look for free weeks to replace skipped ones.
+SEARCH_WEEKS = 26
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments starting with `first`, and returns them in date order.
+
+    Each later session is at the same weekday and time as `first`, with the same
+    therapist, client and treatment. A week that is already taken or outside
+    opening hours is skipped, and the series gets its session from a later week
+    instead, so every series ends up with `count` sessions.
+
+    The series is all-or-nothing: if it cannot get `count` sessions within
+    SEARCH_WEEKS weeks, nothing is booked and BookingError is raised.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series can have between 1 and {MAX_SESSIONS} sessions, not {count}.")
+
+    booked = []
+    try:
+        schedule.book(first)
+        booked.append(first)
+        week = 1
+        while len(booked) < count:
+            if week > SEARCH_WEEKS:
+                raise BookingError(
+                    f"Could not find {count} free weeks in a row for this series within "
+                    f"{SEARCH_WEEKS} weeks of {first.start:%A %d %B}. Nothing was booked."
+                )
+            session = Appointment(
+                first.therapist,
+                first.client,
+                first.start + datetime.timedelta(weeks=week),
+                first.treatment,
+            )
+            week += 1
+            try:
+                schedule.book(session)
+            except (SlotTaken, OutsideOpeningHours):
+                continue
+            booked.append(session)
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..c533ffe
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,103 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, SEARCH_WEEKS, book_series
+
+# Tuesday 2026-09-08 at 09:00
+FIRST = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def first(therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, FIRST, "standard")
+
+
+def week_starts(appointments):
+    return [a.start for a in appointments]
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual(
+            week_starts(booked),
+            [FIRST, FIRST + datetime.timedelta(weeks=1), FIRST + datetime.timedelta(weeks=2)],
+        )
+        self.assertEqual(s.appointments, booked)
+
+    def test_sessions_share_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, first("marco", "Jo Li"), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("marco", "Jo Li", "standard"))
+
+    def test_sessions_get_their_own_ids(self):
+        s = Schedule()
+        booked = book_series(s, first(), 4)
+        self.assertEqual(len({a.id for a in booked}), 4)
+
+    def test_first_is_booked_and_returned_first(self):
+        s = Schedule()
+        f = first()
+        booked = book_series(s, f, 2)
+        self.assertIs(booked[0], f)
+
+    def test_skipped_week_is_replaced_at_the_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Other", FIRST + datetime.timedelta(weeks=1)))  # week 2 taken
+        booked = book_series(s, first(), 3)
+        self.assertEqual(
+            week_starts(booked),
+            [
+                FIRST,
+                FIRST + datetime.timedelta(weeks=2),
+                FIRST + datetime.timedelta(weeks=3),
+            ],
+        )
+
+    def test_first_outside_opening_hours_books_nothing(self):
+        # Friday closes at 17:00, so a 60-minute session from 16:30 does not fit.
+        # Opening hours depend only on weekday and time, so no later week would fit either.
+        s = Schedule()
+        friday = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 11, 16, 30), "initial")
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, friday, 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_refuses_more_than_nine_sessions(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, first(), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first(), MAX_SESSIONS)), MAX_SESSIONS)
+
+    def test_refuses_zero_sessions(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), first(), 0)
+
+    def test_all_or_nothing_when_search_runs_out(self):
+        s = Schedule()
+        # Block every week from the second one onward, so the series can never fill up.
+        for week in range(1, SEARCH_WEEKS + 2):
+            s.book(Appointment("lena", "Other", FIRST + datetime.timedelta(weeks=week)))
+        before = list(s.appointments)
+        with self.assertRaises(BookingError):
+            book_series(s, first(), 2)
+        self.assertEqual(s.appointments, before)
+
+    def test_first_session_taken_books_nothing(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Other", FIRST))
+        with self.assertRaises(SlotTaken):
+            book_series(s, first(), 2)
+        self.assertEqual(len(s.appointments), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
