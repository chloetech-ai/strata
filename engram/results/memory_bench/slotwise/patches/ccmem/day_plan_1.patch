+"""Printable documents for the front desk."""
+
+
+def day_plan(schedule, therapist, day):
+    """Text of `therapist`'s active appointments on `day`, for printing at reception.
+
+    One line per appointment with its time, client and treatment. Cancelled
+    appointments are left out.
+    """
+    lines = [f"Day plan: {therapist.title()}, {day:%A %d %B %Y}", ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment} ({a.minutes} min)")
+    return "\n".join(lines) + "\n"
