+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="initial"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan: Lena, Monday 07 September 2026\n"
+            "\n"
+            "09:00-09:45  Kim Weber  standard (45 min)\n"
+            "10:00-11:00  Jo Li  initial (60 min)\n",
+        )
+
+    def test_no_appointments(self):
+        s = Schedule()
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan: Lena, Monday 07 September 2026\n\nNo appointments.\n",
+        )
+
+    def test_cancelled_appointments_are_left_out(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        s.cancel(a.id)
+        self.assertNotIn("Kim Weber", day_plan(s, "lena", MONDAY))
+        self.assertIn("Jo Li", day_plan(s, "lena", MONDAY))
+
+    def test_only_this_therapists_appointments(self):
+        s = Schedule()
+        s.book(at(9, therapist="max", client="Jo Li"))
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+    def test_only_this_day(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9, 0)))
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+
+if __name__ == "__main__":
+    unittest.main()
