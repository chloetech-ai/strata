+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to start at `new_start`, keeping its treatment.
+
+        The same opening hours and buffer rules as `book` apply, and the appointment
+        does not clash with itself. If the new time is refused, the appointment is
+        left where it was. Raises KeyError if there is no such appointment, and
+        BookingError if it has been cancelled.
