+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which an appointment of `minutes` could be booked.
+
+        Candidates are on a SLOT_STEP grid from opening time. A start is only
+        offered if the appointment fits within opening hours and book() would
+        accept it. Returns an empty list if the practice is closed that day.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clash(self, therapist, start, end):
+        """The active appointment that stops `therapist` taking `start` to `end`, or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.cancelled:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
