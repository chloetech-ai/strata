@@ -0,0 +1,53 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_start_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", DAY),
+            "Day plan: Lena, Tuesday 08 September 2026\n"
+            "\n"
+            "09:00-09:45  Kim Weber  standard\n"
+            "10:00-10:30  Jo Li  short\n",
+        )
+
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(Schedule(), "lena", DAY),
+            "Day plan: Lena, Tuesday 08 September 2026\n\nNo appointments.\n",
+        )
+
+    def test_cancelled_appointments_are_left_out(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        s.cancel(a.id)
+        self.assertNotIn("Kim Weber", day_plan(s, "lena", DAY))
+
+    def test_only_this_therapist_and_day(self):
+        s = Schedule()
+        s.book(at(9, therapist="marco", client="Jo Li"))
+        s.book(at(9, client="Kim Weber"))
+        s.book(Appointment("lena", "Zoë Brändli", datetime.datetime(2026, 9, 9, 9, 0)))
+        text = day_plan(s, "lena", DAY)
+        self.assertIn("Kim Weber", text)
+        self.assertNotIn("Jo Li", text)
+        self.assertNotIn("Zoë Brändli", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
