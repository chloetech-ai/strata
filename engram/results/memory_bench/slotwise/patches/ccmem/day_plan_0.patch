+"""Printable documents for reception."""
+
+from .schedule import Schedule
+
+
+def day_plan(schedule: Schedule, therapist, day):
+    """Plain-text plan of `therapist`'s active appointments on `day`, for printing.
+
+    One line per appointment with its time, client and treatment, in start order.
+    Cancelled appointments are left out.
+    """
+    lines = [f"Day plan: {therapist.title()}, {day:%A %d %B %Y}", ""]
+    active = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not active:
+        lines.append("No appointments.")
+    for a in active:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.client}  {a.treatment}")
+    return "\n".join(lines) + "\n"
