+++ b/tests/test_fees.py
@@ -0,0 +1,42 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 10, 20, 10, 0)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.standard = Appointment("lena", "Kim Weber", START)  # 9800 cents
+        self.initial = Appointment("lena", "Kim Weber", START, "initial")  # 14500 cents
+
+    def cancel_before(self, appointment, hours):
+        return cancellation_fee(appointment, START - datetime.timedelta(hours=hours))
+
+    def test_more_than_48_hours_notice_is_free(self):
+        self.assertEqual(self.cancel_before(self.standard, 72), 0)
+
+    def test_exactly_48_hours_notice_is_free(self):
+        self.assertEqual(self.cancel_before(self.standard, 48), 0)
+
+    def test_between_24_and_48_hours_is_half_price(self):
+        self.assertEqual(self.cancel_before(self.standard, 47), 4900)
+
+    def test_exactly_24_hours_is_half_price(self):
+        self.assertEqual(self.cancel_before(self.standard, 24), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        self.assertEqual(self.cancel_before(self.standard, 23), 9800)
+
+    def test_cancelling_after_start_is_full_price(self):
+        self.assertEqual(self.cancel_before(self.standard, -1), 9800)
+
+    def test_fee_uses_the_treatment_price(self):
+        self.assertEqual(self.cancel_before(self.initial, 1), 14500)
+        self.assertEqual(self.cancel_before(self.initial, 30), 7250)
+
+
+if __name__ == "__main__":
+    unittest.main()
