+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which `therapist` could book an appointment of `minutes`.
+
+        Starts run every 15 minutes from opening time. A start is listed only if
+        book() would accept it, so it must fit before closing and leave BUFFER
+        free around the therapist's other appointments. Returns [] on a closed day.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._blocker(therapist, start, start + length) is None:
+                slots.append(start)
+            start += GRID
+        return slots
+
+    def _blocker(self, therapist, start, end):
+        """The active appointment that stops `therapist` from taking `start` to `end`, or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.cancelled:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
