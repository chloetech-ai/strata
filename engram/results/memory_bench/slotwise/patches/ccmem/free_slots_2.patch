+    def test_free_slots_on_empty_day_start_at_opening_on_grid(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)  # Tuesday, 07:30-19:00
+        slots = s.free_slots("lena", day, 45)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[1] - slots[0], datetime.timedelta(minutes=15))
+        # last start must still finish by 19:00
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))
+
+    def test_free_slots_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_respect_buffer_around_booking(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, needs 10 min either side
+        starts = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), starts)  # ends 09:00, no buffer
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 15), starts)  # ends 08:45, exactly 10 min before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 15), starts)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), starts)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), starts)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), starts)  # first grid start after 09:45 + 10 min
+
+    def test_free_slots_skip_cancelled(self):
