+    def book_day(self, s, count, therapist="lena"):
+        # 45-minute treatments with the 10-minute buffer: one starts every 55 minutes from 08:00
+        for i in range(count):
+            start = datetime.datetime(2026, 9, 8, 8, 0) + datetime.timedelta(minutes=55 * i)
+            s.book(Appointment(therapist, f"Client {i}", start))
+
+    def test_not_fully_booked_below_limit(self):
+        s = Schedule()
+        self.book_day(s, MAX_TREATMENTS_PER_DAY - 1)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_at_limit(self):
+        s = Schedule()
+        self.book_day(s, MAX_TREATMENTS_PER_DAY)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
+        self.book_day(s, MAX_TREATMENTS_PER_DAY)
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_cancelled_does_not_count_towards_fully_booked(self):
+        s = Schedule()
+        self.book_day(s, MAX_TREATMENTS_PER_DAY)
+        s.cancel(s.appointments[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_book_does_not_enforce_daily_limit(self):
