+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` already has MAX_TREATMENTS_PER_DAY active appointments on `day`.
+
+        For the online booking page, which greys out such days. Cancelled
+        appointments do not count.
+        """
+        active = [a for a in self.appointments_for(therapist, day) if not a.cancelled]
+        return len(active) >= MAX_TREATMENTS_PER_DAY
