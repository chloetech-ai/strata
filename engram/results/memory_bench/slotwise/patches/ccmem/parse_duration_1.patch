+"""Parsing of appointment lengths typed by the receptionist."""
+
+import re
+
+# "1:30"
+_CLOCK = re.compile(r"(\d+):(\d{2})")
+# "1h", "1h30", "1h 30m", "1 h 30 min"
+_HOURS = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*(?:m|min)?)?")
+# "45", "45m", "45 min"
+_MINUTES = re.compile(r"(\d+)\s*(?:m|min)?")
+
+
+def parse_duration(text):
+    """Return the length in minutes for text such as '45', '1h30' or '1:30'.
+
+    Raises ValueError for empty input, zero, or anything unrecognised.
+    """
+    value = text.strip().lower()
+
+    for pattern in (_CLOCK, _HOURS):
+        match = pattern.fullmatch(value)
+        if match:
+            hours = int(match.group(1))
+            minutes = int(match.group(2) or 0)
+            if minutes >= 60:
+                raise ValueError(f"minutes must be below 60: {text!r}")
+            total = hours * 60 + minutes
+            break
+    else:
+        match = _MINUTES.fullmatch(value)
+        if not match:
+            raise ValueError(f"not a duration: {text!r}")
+        total = int(match.group(1))
+
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
