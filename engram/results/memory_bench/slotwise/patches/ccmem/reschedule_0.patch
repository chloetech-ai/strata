+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to start at `new_start`.
+
+        Same checks as `book`, except the appointment does not block its own
+        current slot. If the new time is refused, the appointment stays where it was.
+        Raises KeyError if there is no such appointment, and BookingError if it
+        is cancelled (book a new appointment instead).
+        """
