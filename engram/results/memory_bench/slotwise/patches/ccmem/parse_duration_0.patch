+"""Parsing of appointment lengths typed by the receptionist."""
+
+import re
+
+_DURATION = re.compile(
+    r"""
+    (?P<hours>\d+)\s*h(?:\s*(?P<h_minutes>\d+)\s*(?:m|min)?)?   # 1h, 1h30, 1h 30m
+    |(?P<minutes>\d+)\s*(?:m|min)?                              # 45, 45m, 45 min
+    |(?P<clock_hours>\d+):(?P<clock_minutes>\d{1,2})            # 1:30
+    """,
+    re.VERBOSE | re.ASCII,
+)
+
+
+def parse_duration(text):
+    """Length in minutes for text such as '45', '1h30' or '1:30'.
+
+    Raises ValueError if the text is not a duration or is zero.
+    """
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match["hours"] is not None:
+        minutes = int(match["h_minutes"] or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        total = int(match["hours"]) * 60 + minutes
+    elif match["minutes"] is not None:
+        total = int(match["minutes"])
+    else:
+        minutes = int(match["clock_minutes"])
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        total = int(match["clock_hours"]) * 60 + minutes
+
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..75dae83
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,46 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_empty_input(self):
+        for text in ["", "   "]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_zero(self):
+        for text in ["0", "0m", "0h", "0:00"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_other_text(self):
+        for text in ["abc", "-5", "1.5h", "1h90", "1:75", "h30", "45 seconds"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
