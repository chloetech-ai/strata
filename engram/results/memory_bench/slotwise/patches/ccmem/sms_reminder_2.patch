@@ -0,0 +1,32 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import RECEPTION_NUMBER, SMS_LIMIT, reminder_text
+
+
+def appointment(client="Anna Weber-Keller", therapist="Dr. Bernet"):
+    return Appointment(therapist, client, datetime.datetime(2026, 10, 20, 14, 30))
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_time_therapist_and_reception_number(self):
+        text = reminder_text(appointment())
+        self.assertIn("20.10.2026 at 14:30", text)
+        self.assertIn("Dr. Bernet", text)
+        self.assertIn(RECEPTION_NUMBER, text)
+
+    def test_is_ascii_and_within_limit(self):
+        text = reminder_text(appointment(client="Jörg Müller-Østergaard"))
+        self.assertTrue(text.isascii())
+        self.assertLessEqual(len(text), SMS_LIMIT)
+        self.assertIn("Jorg Muller-Ostergaard", text)
+
+    def test_long_name_is_shortened_but_number_kept(self):
+        text = reminder_text(appointment(client="A" * 200))
+        self.assertLessEqual(len(text), SMS_LIMIT)
+        self.assertIn(RECEPTION_NUMBER, text)
+
+
+if __name__ == "__main__":
+    unittest.main()
