+"""Text of the SMS reminders sent before appointments."""
+
+import unicodedata
+
+from .model import Appointment
+
+# The SMS gateway only takes ASCII and one message is 160 characters.
+SMS_LIMIT = 160
+
+# Clients can call this number if they need to change their appointment.
+RECEPTION_NUMBER = "044 512 77 30"
+
+# Letters that NFKD does not split into base letter plus accent.
+_TRANSLITERATIONS = str.maketrans({"ß": "ss", "ø": "o", "Ø": "O", "æ": "ae", "Æ": "AE", "œ": "oe", "Œ": "OE"})
+
+
+def _ascii(text):
+    """Reduce text to ASCII, keeping the base letter of accented characters (ä -> a)."""
+    decomposed = unicodedata.normalize("NFKD", text.translate(_TRANSLITERATIONS))
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def _compose(client, therapist, when):
+    return f"Hi {client}, reminder of your appointment with {therapist} on {when}. Questions? Call {RECEPTION_NUMBER}"
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the reminder SMS for an appointment, within the gateway's limits."""
+    when = appointment.start.strftime("%d.%m.%Y at %H:%M")
+    therapist = _ascii(appointment.therapist)
+    client = _ascii(appointment.client)
+    text = _compose(client, therapist, when)
+    if len(text) > SMS_LIMIT:
+        # The reception number must stay in every reminder, so shorten the client's name instead.
+        excess = len(text) - SMS_LIMIT
+        text = _compose(client[: max(len(client) - excess, 0)].rstrip(), therapist, when)
+    return text
