index 0000000..7f0209d
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,100 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def first(hour=9, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    # 2026-09-08 is a Tuesday
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, 8, 9), datetime.datetime(2026, 9, 15, 9), datetime.datetime(2026, 9, 22, 9)],
+        )
+        self.assertEqual(s.appointments, booked)
+
+    def test_sessions_match_the_first(self):
+        s = Schedule()
+        booked = book_series(s, first(treatment="initial"), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("lena", "Kim Weber", "initial"))
+            self.assertEqual(a.start.time(), datetime.time(9))
+
+    def test_first_is_the_first_booked_session(self):
+        s = Schedule()
+        f = first()
+        booked = book_series(s, f, 2)
+        self.assertIs(booked[0], f)
+        self.assertIs(s.get(f.id), f)
+
+    def test_sessions_get_their_own_ids(self):
+        booked = book_series(Schedule(), first(), 4)
+        self.assertEqual(len({a.id for a in booked}), 4)
+
+    def test_taken_week_is_skipped_and_series_continues(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        booked = book_series(s, first(), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, 8, 9), datetime.datetime(2026, 9, 22, 9), datetime.datetime(2026, 9, 29, 9)],
+        )
+
+    def test_taken_first_week_is_skipped(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9)))
+        booked = book_series(s, first(), 1)
+        self.assertEqual(booked[0].start, datetime.datetime(2026, 9, 15, 9))
+
+    def test_week_clashing_only_by_buffer_is_skipped(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9, 50)))  # starts inside the 10-minute gap after 09:00-09:45
+        booked = book_series(s, first(), 2)
+        self.assertEqual(booked[1].start, datetime.datetime(2026, 9, 22, 9))
+
+    def test_other_therapist_does_not_block(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        booked = book_series(s, first(), 2)
+        self.assertEqual(booked[1].start, datetime.datetime(2026, 9, 15, 9))
+
+    def test_cancelled_session_does_not_block(self):
+        s = Schedule()
+        taken = s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        s.cancel(taken.id)
+        booked = book_series(s, first(), 2)
+        self.assertEqual(booked[1].start, datetime.datetime(2026, 9, 15, 9))
+
+    def test_nine_sessions_allowed(self):
+        booked = book_series(Schedule(), first(), MAX_SESSIONS)
+        self.assertEqual(len(booked), 9)
+
+    def test_more_than_nine_sessions_refused(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "at most 9 sessions"):
+            book_series(s, first(), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_no_sessions_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first(), 0)
+
+    def test_closed_weekday_refused(self):
+        s = Schedule()
+        sunday = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 13, 9))
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, sunday, 2)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
