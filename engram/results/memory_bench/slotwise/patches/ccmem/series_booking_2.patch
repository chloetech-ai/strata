+"""Series bookings: the same appointment every week for a prescribed number of sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them.
+
+    Each session has the same therapist, client, treatment and weekday and time
+    as `first`. If a week's slot is already taken, that week is skipped and the
+    series carries on in the next free week, so the client still gets `count`
+    sessions. Any other refusal (for example, the practice is closed on that
+    weekday) is raised. Those rules don't change from week to week, so they
+    can only fail on the first week, before anything is booked.
+
+    Raises ValueError if `count` is below 1, and BookingError if it is above
+    MAX_SESSIONS.
+    """
+    if count < 1:
+        raise ValueError(f"A series needs at least one session, not {count}.")
+    if count > MAX_SESSIONS:
+        raise BookingError(f"A series can have at most {MAX_SESSIONS} sessions, not {count}.")
+
+    booked = []
+    week = 0
+    while len(booked) < count:
+        if week == 0:
+            appointment = first
+        else:
+            appointment = Appointment(first.therapist, first.client, first.start + week * WEEK, first.treatment)
+        try:
+            booked.append(schedule.book(appointment))
+        except SlotTaken:
+            pass
+        week += 1
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
