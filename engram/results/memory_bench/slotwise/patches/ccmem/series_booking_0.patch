+"""Booking a weekly series of appointments, such as the sessions on a prescription."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for 9 sessions per prescription.
+MAX_SESSIONS = 9
+# How many weeks after `first` to look for free slots before giving up on the series.
+SEARCH_WEEKS = 26
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them in date order.
+
+    Each later session is at the same weekday and time as `first`. A week where the
+    therapist is already busy is skipped, and the series continues in the next free
+    week, so the client still gets all `count` sessions.
+
+    The series is all-or-nothing: if it cannot be completed within SEARCH_WEEKS
+    weeks, nothing is booked. Raises BookingError (or a subclass) with a message for
+    the receptionist.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series has between 1 and {MAX_SESSIONS} sessions, not {count}.")
+    before = len(schedule.appointments)
+    booked = [schedule.book(first)]
+    week = 0
+    try:
+        while len(booked) < count:
+            week += 1
+            if week > SEARCH_WEEKS:
+                raise BookingError(
+                    f"Only {len(booked)} of {count} sessions fit within {SEARCH_WEEKS} weeks of "
+                    f"{first.start:%A %d %B}, so the series was not booked."
+                )
+            session = Appointment(
+                first.therapist, first.client, first.start + datetime.timedelta(weeks=week), first.treatment
+            )
+            try:
+                booked.append(schedule.book(session))
+            except SlotTaken:
+                pass  # this week is busy; the series moves on to the next one
+    except BookingError:
+        del schedule.appointments[before:]
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..3f63116
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,82 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise import series
+from slotwise.errors import BookingError, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+
+# Tuesday 2026-09-08, 09:00 — the first session of every series below.
+FIRST_START = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def first(client="Kim Weber"):
+    return Appointment("lena", client, FIRST_START)
+
+
+def busy_on(day_offset_weeks, client="Jo Li"):
+    return Appointment("lena", client, FIRST_START + datetime.timedelta(weeks=day_offset_weeks))
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_time(self):
+        s = Schedule()
+        booked = series.book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [FIRST_START + datetime.timedelta(weeks=i) for i in range(3)])
+        self.assertEqual(s.appointments, booked)
+
+    def test_first_is_the_booked_appointment(self):
+        s = Schedule()
+        f = first()
+        booked = series.book_series(s, f, 2)
+        self.assertIs(booked[0], f)
+        self.assertEqual(len({a.id for a in booked}), 2)
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(series.book_series(s, first(), 9)), 9)
+
+    def test_more_than_nine_is_refused(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "between 1 and 9"):
+            series.book_series(s, first(), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_is_refused(self):
+        with self.assertRaises(BookingError):
+            series.book_series(Schedule(), first(), 0)
+
+    def test_busy_week_is_skipped_and_session_added_at_end(self):
+        s = Schedule()
+        s.book(busy_on(1))  # week 2 is taken by someone else
+        booked = series.book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [FIRST_START, FIRST_START + datetime.timedelta(weeks=2), FIRST_START + datetime.timedelta(weeks=3)])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_first_session_taken_books_nothing(self):
+        s = Schedule()
+        s.book(busy_on(0))
+        with self.assertRaises(SlotTaken):
+            series.book_series(s, first(), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_not_completable_within_search_window_books_nothing(self):
+        s = Schedule()
+        s.book(busy_on(2))
+        with mock.patch.object(series, "SEARCH_WEEKS", 2):
+            with self.assertRaisesRegex(BookingError, "Only 2 of 3 sessions"):
+                series.book_series(s, first(), 3)
+        # the two sessions that were booked before the failure are rolled back
+        self.assertEqual([a.client for a in s.appointments], ["Jo Li"])
+
+    def test_cancelled_busy_week_is_free(self):
+        s = Schedule()
+        old = s.book(busy_on(1))
+        s.cancel(old.id)
+        booked = series.book_series(s, first(), 2)
+        self.assertEqual(booked[1].start, FIRST_START + datetime.timedelta(weeks=1))
+
+
+if __name__ == "__main__":
+    unittest.main()
