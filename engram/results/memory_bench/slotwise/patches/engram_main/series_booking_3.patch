@@ -0,0 +1,49 @@
+"""Booking a series of weekly sessions, as prescribed by a doctor."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+# How far ahead to look for free weeks before giving up.
+MAX_WEEKS_SEARCHED = 26
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments starting with `first`, returning them in order.
+
+    Each session is booked at the same weekday and time as `first`. A week whose slot is
+    already taken is skipped and a later week is used instead, so the client still gets
+    all `count` sessions. If the series cannot be completed, nothing is booked.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series can have 1 to {MAX_SESSIONS} sessions, so {count} can't be booked.")
+
+    booked = [schedule.book(first)]
+    try:
+        week = 1
+        while len(booked) < count:
+            if week > MAX_WEEKS_SEARCHED:
+                raise BookingError(
+                    f"Only {len(booked)} of {count} sessions could be booked, because "
+                    f"the next {MAX_WEEKS_SEARCHED} weeks are too full. Nothing was booked."
+                )
+            start = first.start + datetime.timedelta(weeks=week)
+            week += 1
+            session = Appointment(first.therapist, first.client, start, first.treatment)
+            try:
+                booked.append(schedule.book(session))
+            except SlotTaken:
+                continue
+    except BookingError:
+        _unbook(schedule, booked)
+        raise
+    return booked
+
+
+def _unbook(schedule, appointments):
+    for appointment in appointments:
+        schedule.appointments.remove(appointment)
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..55ad7f6
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,98 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(days_after, hour, minute=0, therapist="lena", client="Kim Weber"):
+    # Day 0 is Tuesday 2026-09-08.
+    start = datetime.datetime(2026, 9, 8, hour, minute) + datetime.timedelta(days=days_after)
+    return Appointment(therapist, client, start)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_the_same_time(self):
+        s = Schedule()
+        booked = book_series(s, at(0, 9), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9) for d in (8, 15, 22)],
+        )
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_keeps_therapist_client_and_treatment(self):
+        s = Schedule()
+        first = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9), "short")
+        booked = book_series(s, first, 2)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("lena", "Kim Weber", "short")})
+
+    def test_first_appointment_is_the_object_passed_in(self):
+        s = Schedule()
+        first = at(0, 9)
+        self.assertIs(book_series(s, first, 2)[0], first)
+
+    def test_taken_week_is_skipped_and_a_week_is_added_at_the_end(self):
+        s = Schedule()
+        s.book(at(7, 9, client="Jo Li"))  # 15 Sept 09:00 is taken
+        booked = book_series(s, at(0, 9), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9) for d in (8, 22, 29)],
+        )
+
+    def test_other_therapist_does_not_block_the_series(self):
+        s = Schedule()
+        s.book(at(7, 9, therapist="tom", client="Jo Li"))
+        booked = book_series(s, at(0, 9), 2)
+        self.assertEqual(booked[1].start, datetime.datetime(2026, 9, 15, 9))
+
+    def test_gap_from_a_neighbour_skips_the_week(self):
+        s = Schedule()
+        s.book(at(7, 9, 50, client="Jo Li"))  # 09:50 is inside the 10-minute gap after 09:00
+        booked = book_series(s, at(0, 9), 2)
+        self.assertEqual(booked[1].start, datetime.datetime(2026, 9, 22, 9))
+
+    def test_cancelled_appointment_does_not_block_the_series(self):
+        s = Schedule()
+        taken = s.book(at(7, 9, client="Jo Li"))
+        s.cancel(taken.id)
+        booked = book_series(s, at(0, 9), 2)
+        self.assertEqual(booked[1].start, datetime.datetime(2026, 9, 15, 9))
+
+    def test_more_than_nine_sessions_is_refused(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "1 to 9 sessions, so 12 can't be booked"):
+            book_series(s, at(0, 9), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_are_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(0, 9), MAX_SESSIONS)), 9)
+
+    def test_zero_sessions_is_refused(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(0, 9), 0)
+
+    def test_first_slot_taken_raises_and_books_nothing(self):
+        s = Schedule()
+        s.book(at(0, 9, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(0, 9), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_failure_part_way_leaves_nothing_booked(self):
+        s = Schedule()
+        # Weeks 1 to 26 are all taken, so the series can only get its first session.
+        for week in range(1, 27):
+            s.book(at(week * 7, 9, client="Jo Li"))
+        before = list(s.appointments)
+        with self.assertRaisesRegex(BookingError, "Only 1 of 2 sessions could be booked"):
+            book_series(s, at(0, 9), 2)
+        self.assertEqual(s.appointments, before)
+
+
+if __name__ == "__main__":
+    unittest.main()
