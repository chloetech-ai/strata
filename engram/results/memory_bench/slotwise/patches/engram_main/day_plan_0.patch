--- /dev/null
+++ b/src/slotwise/printing.py
@@ -0,0 +1,21 @@
+"""Text for reception's receipt printer."""
+
+import textwrap
+
+# The receipt printer wraps anything longer than this onto the next line.
+WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s live appointments on `day` as printable text, at most WIDTH characters a line."""
+    lines = _wrap(f"{therapist.title()}, {day:%A %d.%m.%Y}", indent="")
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines += _wrap("No appointments.", indent="")
+    for a in appointments:
+        lines += _wrap(f"{a.start:%H:%M}-{a.end:%H:%M} {a.client}, {a.treatment}", indent="      ")
+    return "\n".join(lines)
+
+
+def _wrap(text, indent):
+    return textwrap.wrap(text, WIDTH, subsequent_indent=indent)
diff --git a/tests/test_printing.py b/tests/test_printing.py
new file mode 100644
index 0000000..5d2476e
--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,58 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, client="Kim Weber", treatment="standard", therapist="lena"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Lena, Monday 07.09.2026\n"
+            "09:00-09:45 Kim Weber, standard\n"
+            "10:00-10:30 Jo Li, short",
+        )
+
+    def test_free_day_says_so(self):
+        self.assertEqual(day_plan(Schedule(), "lena", MONDAY), "Lena, Monday 07.09.2026\nNo appointments.")
+
+    def test_cancelled_appointments_are_left_out(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        self.assertEqual(day_plan(s, "lena", MONDAY), "Lena, Monday 07.09.2026\nNo appointments.")
+
+    def test_other_therapists_and_days_are_left_out(self):
+        s = Schedule()
+        s.book(at(9, therapist="tom"))
+        s.book(at(9, therapist="lena"))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9, 0)))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Lena, Monday 07.09.2026\n09:00-09:45 Kim Weber, standard",
+        )
+
+    def test_long_names_wrap_within_the_printer_width(self):
+        s = Schedule()
+        s.book(at(9, client="Maria Theresia Fortunata Gutierrez-Rodriguez de la Fuente"))
+        plan = day_plan(s, "lena", MONDAY)
+        for line in plan.split("\n"):
+            self.assertLessEqual(len(line), WIDTH, line)
+        self.assertIn("Gutierrez-Rodriguez", plan)
+        self.assertIn("de la Fuente", plan)
+
+    def test_long_therapist_name_wraps_within_the_printer_width(self):
+        plan = day_plan(Schedule(), "a" * 60, MONDAY)
+        for line in plan.split("\n"):
+            self.assertLessEqual(len(line), WIDTH, line)
