+    def test_reschedule_moves_the_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_may_overlap_its_own_old_time(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 15))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 15))
+
+    def test_reschedule_into_a_taken_slot_leaves_it_where_it_was(self):
+        s = Schedule()
+        s.book(at(9))
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "Lena is booked from 09:00 to 09:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_keeps_the_10_minute_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 55))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 55))
+
+    def test_reschedule_outside_hours_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_ignores_cancelled_bookings_in_the_way(self):
+        s = Schedule()
+        s.book(at(9))
+        gone = s.book(at(11, client="Jo Li"))
+        s.cancel(gone.id)
+        a = s.book(at(14, client="Ana Berg"))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_of_a_cancelled_appointment_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaisesRegex(BookingError, "is cancelled, so it can't be moved"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_unknown_id_is_a_key_error(self):
