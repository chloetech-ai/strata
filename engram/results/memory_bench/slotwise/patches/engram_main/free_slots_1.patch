         s.book(at(10, therapist="marco"))
         self.assertEqual([a.start.hour for a in s.appointments_for("lena", datetime.date(2026, 9, 8))], [8, 14])
 
+    def test_free_slots_on_empty_day_run_from_opening_in_15_minute_steps(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tue 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[1] - slots[0], datetime.timedelta(minutes=15))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))  # last 60-minute start that ends at 19:00
+        self.assertEqual(len(slots), 43)
+
+    def test_free_slots_keep_the_gap_on_both_sides(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so a new appointment must end by 08:50 or start from 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 60)
+        self.assertIn(datetime.datetime(2026, 9, 8, 7, 45), slots)  # ends 08:45
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 09:00, 10 minutes too late
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # starts 10:00, 15 minutes after the end
+
+    def test_free_slots_ignore_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+
+    def test_free_slots_ignore_other_therapists(self):
+        s = Schedule()
+        s.book(at(9, therapist="marco"))
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+
+    def test_free_slots_stop_before_closing_time(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 12), 45)  # Sat 08:00-12:00
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 15))
+
+    def test_free_slots_on_a_closed_day_is_empty(self):
