@@ -0,0 +1,21 @@
+"""Cancellation fees."""
+
+import datetime
+
+FREE_FROM = datetime.timedelta(hours=48)
+FULL_FEE_BELOW = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    48 hours or more before the start is free, less than 48 hours is half the
+    treatment price, and less than 24 hours is the full treatment price.
+    Half the price is rounded up to the next whole cent.
+    """
+    notice = appointment.start - cancelled_at
+    if notice >= FREE_FROM:
+        return 0
+    if notice < FULL_FEE_BELOW:
+        return appointment.price
+    return (appointment.price + 1) // 2
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..cf9b442
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,38 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 7, 9, 0)
+
+
+def at_notice(hours):
+    """Cancellation time that is `hours` before the appointment starts."""
+    return START - datetime.timedelta(hours=hours)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.appointment = Appointment("lena", "Kim Weber", START, "standard")
+
+    def test_free_at_48_hours_or_more(self):
+        self.assertEqual(cancellation_fee(self.appointment, at_notice(72)), 0)
+        self.assertEqual(cancellation_fee(self.appointment, at_notice(48)), 0)
+
+    def test_half_price_between_24_and_48_hours(self):
+        self.assertEqual(cancellation_fee(self.appointment, at_notice(47.9)), 4900)
+        self.assertEqual(cancellation_fee(self.appointment, at_notice(24)), 4900)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(cancellation_fee(self.appointment, at_notice(23.9)), 9800)
+        self.assertEqual(cancellation_fee(self.appointment, at_notice(-1)), 9800)
+
+    def test_half_price_rounds_up_to_whole_cent(self):
+        with mock.patch.dict("slotwise.model.TREATMENTS", {"standard": (45, 9801)}):
+            self.assertEqual(cancellation_fee(self.appointment, at_notice(30)), 4901)
+
+
+if __name__ == "__main__":
+    unittest.main()
