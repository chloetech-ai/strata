index 0000000..e1a9af6
--- /dev/null
+++ b/src/slotwise/intervals.py
@@ -0,0 +1,16 @@
+"""Merging of (start, end) intervals, given as ints or datetimes."""
+
+
+def merge_intervals(intervals):
+    """Merge overlapping or touching (start, end) pairs.
+
+    Returns a new list of (start, end) tuples sorted by start. The input is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..ab31a0c
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,38 @@
+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_input_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_intervals_are_kept_and_sorted(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_one_interval_inside_another_keeps_the_longer_end(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_chain_of_overlaps_collapses_to_one(self):
+        self.assertEqual(merge_intervals([(4, 5), (1, 2), (2, 4)]), [(1, 5)])
+
+    def test_datetimes(self):
+        result = merge_intervals([
+            (DT(2026, 9, 7, 9, 45), DT(2026, 9, 7, 10, 30)),
+            (DT(2026, 9, 7, 9, 0), DT(2026, 9, 7, 9, 45)),
+        ])
+        self.assertEqual(result, [(DT(2026, 9, 7, 9, 0), DT(2026, 9, 7, 10, 30))])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 6), (1, 4), (3, 7)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 4), (3, 7)])
