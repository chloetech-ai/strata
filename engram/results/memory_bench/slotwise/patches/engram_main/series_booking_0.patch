diff --git a/src/slotwise/series.py b/src/slotwise/series.py
new file mode 100644
index 0000000..3a1c374
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,41 @@
+"""Booking a series of weekly sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most 9 sessions per prescription.
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` sessions, one a week at the same weekday and time as `first`.
+
+    A week that is already taken is skipped and one more week is added at the end,
+    so the client still gets `count` sessions. Returns the booked appointments in order.
+    If booking fails part way, the sessions booked so far are removed again.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(f"A series can have between 1 and {MAX_SESSIONS} sessions, not {count}.")
+    before = len(schedule.appointments)
+    booked = []
+    week = 0
+    try:
+        while len(booked) < count:
+            start = first.start + datetime.timedelta(weeks=week)
+            # The first attempt books `first` itself, so its id is the series' first session.
+            if week == 0:
+                candidate = first
+            else:
+                candidate = Appointment(first.therapist, first.client, start, first.treatment)
+            try:
+                booked.append(schedule.book(candidate))
+            except SlotTaken:
+                pass
+            week += 1
+    except Exception:
+        # Schedule.book only ever appends, so truncating restores the schedule as it was.
+        del schedule.appointments[before:]
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..4c709e3
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,101 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(day, hour=9, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_the_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8), 3)  # Tuesdays 8, 15, 22 September 2026
+        self.assertEqual([a.start.day for a in booked], [8, 15, 22])
+        self.assertTrue(all(a.start.hour == 9 and a.start.minute == 0 for a in booked))
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_first_session_is_the_given_appointment(self):
+        s = Schedule()
+        first = at(8)
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+        self.assertIs(s.get(first.id), first)
+
+    def test_keeps_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, at(8, therapist="ben", client="Jo Li"), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("ben", "Jo Li", "standard"))
+
+    def test_taken_week_is_skipped_and_a_week_added_at_the_end(self):
+        s = Schedule()
+        s.book(at(15, client="Other"))  # the second week is already taken
+        booked = book_series(s, at(8), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_taken_first_week_is_skipped(self):
+        s = Schedule()
+        s.book(at(8, client="Other"))
+        booked = book_series(s, at(8), 2)
+        self.assertEqual([a.start.day for a in booked], [15, 22])
+
+    def test_cancelled_week_is_free_to_use(self):
+        s = Schedule()
+        taken = s.book(at(15, client="Other"))
+        s.cancel(taken.id)
+        booked = book_series(s, at(8), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_refuses_more_than_nine_sessions(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "between 1 and 9 sessions, not 10"):
+            book_series(s, at(8), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_are_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(8), MAX_SESSIONS)), 9)
+
+    def test_refuses_zero_sessions(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(8), 0)
+
+    def test_failure_removes_sessions_already_booked(self):
+        s = Schedule()
+        s.book(at(15, client="Other"))  # so the series skips 15 September
+        before = list(s.appointments)
+        real_book = s.book
+        calls = []
+
+        def book_then_fail(appointment):
+            calls.append(appointment)
+            if len(calls) == 3:
+                raise OutsideOpeningHours("closed")
+            return real_book(appointment)
+
+        s.book = book_then_fail
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(8), 3)
+        self.assertEqual(s.appointments, before)
+
+    def test_closed_weekday_fails_without_looping(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(6, hour=9), 2)  # Sunday, when the practice is closed
+        self.assertEqual(s.appointments, [])
+
+    def test_slot_taken_is_never_raised_to_the_caller(self):
+        s = Schedule()
+        s.book(at(8, client="Other"))
+        s.book(at(15, client="Other"))
+        booked = book_series(s, at(8), 1)
+        self.assertEqual([a.start.day for a in booked], [22])
+
+
+if __name__ == "__main__":
+    unittest.main()
