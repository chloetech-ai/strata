+    def test_free_slots_on_an_empty_day_run_on_the_grid_from_opening(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # last 45-minute slot that ends by 19:00
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(b - a == datetime.timedelta(minutes=15) for a, b in zip(slots, slots[1:])))
+
+    def test_free_slots_keep_the_gap_from_existing_appointments(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so the therapist is busy from 08:50 to 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, exactly 10 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # first grid start after the 10-minute gap
+
+    def test_every_free_slot_is_accepted_by_book(self):
