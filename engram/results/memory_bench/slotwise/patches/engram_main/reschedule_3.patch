+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to `new_start`. If the new time is refused, the appointment is left where it was."""
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("That appointment was cancelled, so it can't be moved. Book a new one instead.")
+        moved = replace(appointment, start=new_start)
+        # The appointment's old slot is not in the way of its new one.
+        self._check_free(moved, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
