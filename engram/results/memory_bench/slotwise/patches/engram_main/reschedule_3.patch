+    def test_reschedule_moves_the_same_appointment(self):
+        s = Schedule()
+        a = s.book(at(9, treatment="short"))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual((a.client, a.treatment, a.therapist), ("Kim Weber", "short", "lena"))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 20))
+        self.assertEqual(a.start.hour, 9)
+        self.assertEqual(a.start.minute, 20)
+
+    def test_reschedule_into_taken_slot_leaves_it_unchanged(self):
+        s = Schedule()
+        s.book(at(9))
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "Lena is booked from 09:00 to 09:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_keeps_the_10_minute_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        a = s.book(at(11, client="Jo Li"))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 55))  # allowed
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+
+    def test_reschedule_outside_hours_leaves_it_unchanged(self):
