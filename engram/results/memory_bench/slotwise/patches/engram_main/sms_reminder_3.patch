--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,48 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, reminder_text, to_ascii
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_are_transliterated(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Öztürk Strauß"), "Oeztuerk Strauss")
+        self.assertEqual(to_ascii("Ädi Üeli"), "Aedi Ueeli")
+
+    def test_other_accents_are_stripped(self):
+        self.assertEqual(to_ascii("José Müller-Çelik"), "Jose Mueller-Celik")
+
+    def test_letter_without_ascii_equivalent_raises(self):
+        with self.assertRaises(ValueError):
+            to_ascii("李 Wei")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text_contains_time_and_reception_number(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("Kim Weber", text)
+        self.assertIn("07.09.2026 um 09:00 Uhr", text)
+        self.assertIn("044 512 77 30", text)
+        self.assertTrue(text.isascii())
+        self.assertLessEqual(len(text), MAX_LENGTH)
+
+    def test_name_is_transliterated(self):
+        a = Appointment("lena", "Brändli", datetime.datetime(2026, 9, 7, 9, 0))
+        self.assertIn("Braendli", reminder_text(a))
+
+    def test_long_name_raises_instead_of_exceeding_limit(self):
+        a = Appointment("lena", "X" * 150, datetime.datetime(2026, 9, 7, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+    def test_non_ascii_name_raises(self):
+        a = Appointment("lena", "李 Wei", datetime.datetime(2026, 9, 7, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
