+"""Text of the SMS reminder sent before an appointment."""
+
+import unicodedata
+
+from .model import Appointment
+
+# The SMS gateway accepts only plain ASCII, and one message holds at most 160 characters.
+MAX_LENGTH = 160
+
+# The practice's reception number. Every reminder asks clients to call it to move their appointment.
+RECEPTION_PHONE = "044 512 77 30"
+
+# Letters that Unicode does not split into a base letter and an accent.
+_TRANSLITERATIONS = {
+    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+}
+
+
+def to_ascii(text):
+    """Return `text` as plain ASCII: umlauts are transliterated, other accents are dropped.
+
+    'Brändli' becomes 'Braendli'. Raises ValueError if a character has no ASCII equivalent.
+    """
+    spelled = "".join(_TRANSLITERATIONS.get(ch, ch) for ch in text)
+    decomposed = unicodedata.normalize("NFKD", spelled)
+    stripped = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    if not stripped.isascii():
+        bad = "".join(sorted(set(ch for ch in stripped if not ch.isascii())))
+        raise ValueError(f"name {text!r} has characters with no ASCII equivalent: {bad!r}")
+    return stripped
+
+
+def reminder_text(appointment):
+    """Return the reminder SMS for `appointment`.
+
+    Raises ValueError if the name cannot be written in ASCII or the text would exceed
+    160 characters, so that reception can fix the name or the appointment is flagged.
+    """
+    name = to_ascii(appointment.client)
+    when = f"{appointment.start:%d.%m.%Y} um {appointment.start:%H:%M} Uhr"
+    text = (
+        f"Guten Tag {name}. Erinnerung: Ihr Termin ist am {when}. "
+        f"Wenn Sie verhindert sind, rufen Sie bitte {RECEPTION_PHONE} an."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(
+            f"reminder for {appointment.client!r} is {len(text)} characters, "
+            f"more than {MAX_LENGTH}"
+        )
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
