+    def test_reschedule_moves_the_appointment_and_keeps_its_id(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertIs(s.get(a.id), a)
+
+    def test_reschedule_frees_the_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        s.book(at(9, client="Jo Li"))
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_reschedule_by_less_than_its_own_length_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 30))
+        self.assertEqual(a.start.hour * 60 + a.start.minute, 9 * 60 + 30)
+
+    def test_reschedule_into_the_same_time_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_into_a_taken_slot_is_refused_and_changes_nothing(self):
+        s = Schedule()
+        s.book(at(9, client="Jo Li"))
+        a = s.book(at(11))
+        with self.assertRaisesRegex(SlotTaken, "Lena is booked from 09:00 to 09:45, and needs 10 minutes"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_respects_the_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        a = s.book(at(11))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 55))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 55))
+
+    def test_reschedule_outside_opening_hours_is_refused_and_changes_nothing(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 6, 9, 0))  # a Sunday
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_a_cancelled_appointment_is_refused(self):
