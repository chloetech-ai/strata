         s.book(at(10, therapist="marco"))
         self.assertEqual([a.start.hour for a in s.appointments_for("lena", datetime.date(2026, 9, 8))], [8, 14])
 
+    def test_day_with_seven_appointments_is_fully_booked(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):  # six bookings: not yet full
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(at(14))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointment_does_not_count_towards_cap(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        first = s.book(at(8))
+        for hour in range(9, 15):
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(first.id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_cap_is_per_therapist_and_per_day(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_book_still_allows_going_over_the_cap(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour))
+        s.book(at(15))  # reception may book over the cap with the therapist's agreement
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+
 
 if __name__ == "__main__":
     unittest.main()
