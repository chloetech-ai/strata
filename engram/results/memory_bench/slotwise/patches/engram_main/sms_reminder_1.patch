@@ -0,0 +1,37 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import RECEPTION_PHONE, reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_time_and_reception_number(self):
+        a = Appointment("Lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("07.09.2026", text)
+        self.assertIn("09:00", text)
+        self.assertIn(RECEPTION_PHONE, text)
+
+    def test_umlauts_are_transliterated(self):
+        a = Appointment("Lena", "Hans Brändli", datetime.datetime(2026, 9, 7, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("Braendli", text)
+        self.assertTrue(text.isascii())
+
+    def test_other_accents_are_stripped(self):
+        a = Appointment("Lena", "José Müller", datetime.datetime(2026, 9, 7, 9, 0))
+        self.assertIn("Jose Mueller", reminder_text(a))
+
+    def test_unmappable_character_becomes_question_mark(self):
+        a = Appointment("Lena", "Kim 李", datetime.datetime(2026, 9, 7, 9, 0))
+        self.assertIn("Kim ?", reminder_text(a))
+
+    def test_too_long_is_refused(self):
+        a = Appointment("Lena", "X" * 200, datetime.datetime(2026, 9, 7, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
