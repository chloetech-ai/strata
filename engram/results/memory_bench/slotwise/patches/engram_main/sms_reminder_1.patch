+"""Text of the SMS reminders sent to clients before their appointment."""
+
+import unicodedata
+
+from .model import Appointment
+
+RECEPTION_PHONE = "044 512 77 30"
+MAX_LENGTH = 160
+
+# The SMS gateway accepts only ASCII, so umlauts are spelled out first;
+# any other accent is stripped by _to_ascii.
+_TRANSLITERATIONS = {
+    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+}
+
+
+def _to_ascii(text):
+    for char, replacement in _TRANSLITERATIONS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(c for c in decomposed if not unicodedata.combining(c))
+    # Characters with no ASCII equivalent become "?", as the gateway would do anyway.
+    return "".join(c if ord(c) < 128 else "?" for c in stripped)
+
+
+def reminder_text(appointment):
+    """Return the ASCII reminder text for an appointment.
+
+    Raises ValueError if the text would exceed 160 characters, so that a
+    long name cannot silently become a second billed SMS.
+    """
+    text = (
+        f"Reminder: {appointment.client}, your appointment with {appointment.therapist} "
+        f"is on {appointment.start:%d.%m.%Y} at {appointment.start:%H:%M}. "
+        f"To move it, please call {RECEPTION_PHONE}."
+    )
+    text = _to_ascii(text)
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, over the {MAX_LENGTH} limit")
+    return text
