+"""Text of the SMS reminder sent before an appointment."""
+
+import unicodedata
+
+# The reception number is part of every reminder so clients can call to move their appointment.
+RECEPTION_PHONE = "044 512 77 30"
+
+# The SMS gateway accepts only plain ASCII, and a longer message is billed as two.
+MAX_LENGTH = 160
+
+# German letters that NFKD decomposition cannot handle, written the way they are spelled.
+_UMLAUTS = str.maketrans({
+    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+})
+
+
+def to_ascii(text):
+    """Transliterate German letters and strip accents, e.g. 'Brändli' -> 'Braendli'.
+
+    Raises ValueError if any character still has no ASCII equivalent, so reception can fix the name.
+    """
+    text = unicodedata.normalize("NFKD", text.translate(_UMLAUTS))
+    text = "".join(c for c in text if not unicodedata.combining(c))
+    if not text.isascii():
+        raise ValueError(f"no ASCII equivalent for {text!r}")
+    return text
+
+
+def reminder_text(appointment):
+    """Return the reminder SMS for an appointment. Raises ValueError if it would exceed 160 characters."""
+    when = appointment.start
+    text = (
+        f"Hallo {to_ascii(appointment.client)}, Erinnerung an Ihren Termin am "
+        f"{when:%d.%m.%Y} um {when:%H:%M} bei {to_ascii(appointment.therapist)}. "
+        f"Zum Verschieben bitte {RECEPTION_PHONE} anrufen."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
