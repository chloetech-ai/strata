+++ b/tests/test_reminders.py
@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, reminder_text, to_ascii
+
+
+def appointment(client="Lena Meier", therapist="Anna Keller"):
+    return Appointment(therapist=therapist, client=client, start=datetime.datetime(2026, 10, 20, 9, 0))
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_transliterates_umlauts_and_sharp_s(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Größe Öl Über"), "Groesse Oel Ueber")
+
+    def test_strips_other_accents(self):
+        self.assertEqual(to_ascii("José Ñandú Çelik"), "Jose Nandu Celik")
+
+    def test_rejects_characters_without_ascii_equivalent(self):
+        with self.assertRaises(ValueError):
+            to_ascii("Łukasz")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_date_time_therapist_and_reception_number(self):
+        text = reminder_text(appointment())
+        self.assertEqual(
+            text,
+            "Hallo Lena Meier, Erinnerung an Ihren Termin am 20.10.2026 um 09:00 bei Anna Keller. "
+            "Zum Verschieben bitte 044 512 77 30 anrufen.",
+        )
+
+    def test_output_is_ascii_with_transliterated_names(self):
+        text = reminder_text(appointment(client="Brändli Jürg"))
+        self.assertTrue(text.isascii())
+        self.assertIn("Hallo Braendli Juerg,", text)
+
+    def test_rejects_text_over_the_sms_limit(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client="A" * MAX_LENGTH))
+
+
+if __name__ == "__main__":
+    unittest.main()
