+"""Appointment durations, typed the way reception types them."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*(?:min|m)?")
+_HOURS = re.compile(r"(\d+)\s*h\s*(?:(\d+)\s*(?:min|m)?)?")
+_CLOCK = re.compile(r"(\d+):(\d+)")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Surrounding spaces and case are ignored. Raises ValueError for empty input,
+    zero, and anything unrecognised.
+    """
+    value = text.strip().lower()
+    if not value:
+        raise ValueError("duration is empty")
+    minutes = _total_minutes(value)
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _total_minutes(value):
+    if match := _MINUTES.fullmatch(value):
+        return int(match[1])
+    if match := _HOURS.fullmatch(value):
+        return _hours_and_minutes(match[1], match[2] or "0")
+    if match := _CLOCK.fullmatch(value):
+        return _hours_and_minutes(match[1], match[2])
+    raise ValueError(f"not a duration: {value!r}")
+
+
+def _hours_and_minutes(hours, minutes):
+    if int(minutes) >= 60:
+        raise ValueError(f"minutes must be below 60: {minutes!r}")
+    return int(hours) * 60 + int(minutes)
