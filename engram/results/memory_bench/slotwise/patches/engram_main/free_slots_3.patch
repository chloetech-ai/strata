@@ -144,6 +144,42 @@ class ScheduleTest(unittest.TestCase):
         s.book(at(10, therapist="marco"))
         self.assertEqual([a.start.hour for a in s.appointments_for("lena", datetime.date(2026, 9, 8))], [8, 14])
 
+    def test_free_slots_on_an_empty_day_run_from_opening_in_15_minute_steps(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # last one ends at closing
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(isinstance(slot, datetime.datetime) for slot in slots))
+
+    def test_free_slots_keep_the_gap_around_existing_appointments(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so the therapist is busy 08:50-09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 10 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # starts 10 minutes after
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(10, therapist="marco"))
+        empty = Schedule()
+        day = datetime.date(2026, 9, 8)
+        self.assertEqual(s.free_slots("lena", day, 45), empty.free_slots("lena", day, 45))
+
+    def test_free_slots_on_a_closed_day_is_empty(self):
+        s = Schedule()
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_on_a_short_day(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 12), 30)  # Saturday, 08:00-12:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 12, 8, 0))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 30))
+
 
