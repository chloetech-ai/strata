+"""Durations typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:min|m)?")
+_HOURS = re.compile(r"([0-9]+)\s*h\s*(?:([0-9]+)\s*(?:min|m)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]+)")
+
+
+def _hours_and_minutes(hours, minutes):
+    if int(minutes) >= 60:
+        raise ValueError(f"minutes must be below 60, got {minutes}")
+    return int(hours) * 60 + int(minutes)
+
+
+def parse_duration(text):
+    """Length in minutes for '45', '45 min', '1h', '1h 30m' or '1:30'.
+
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    value = text.strip().lower()
+    if match := _MINUTES.fullmatch(value):
+        minutes = int(match[1])
+    elif match := _HOURS.fullmatch(value):
+        minutes = _hours_and_minutes(match[1], match[2] or 0)
+    elif match := _CLOCK.fullmatch(value):
+        minutes = _hours_and_minutes(match[1], match[2])
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
