+    def test_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        for i in range(MAX_PER_DAY - 1):
+            start = datetime.datetime(2026, 9, 8, 7, 30) + datetime.timedelta(minutes=55 * i)
+            s.book(Appointment("lena", "Jo Li", start))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 15, 0)))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointments_do_not_count_towards_full(self):
+        s = Schedule()
+        booked = [s.book(at(8 + i)) for i in range(MAX_PER_DAY)]
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
