+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` already has `MAX_PER_DAY` non-cancelled appointments on `day`."""
+        live = [a for a in self.appointments_for(therapist, day) if not a.cancelled]
+        return len(live) >= MAX_PER_DAY
