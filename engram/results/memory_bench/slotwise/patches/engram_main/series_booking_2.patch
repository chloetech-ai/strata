@@ -0,0 +1,42 @@
+"""Booking a series of weekly sessions, as prescribed by a doctor."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# The insurance pays for at most this many sessions in one series.
+MAX_SESSIONS = 9
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions starting from `first`, and returns them.
+
+    A week that is already taken is skipped and the series continues in the next
+    free week, so the client still gets all `count` sessions. If any session is
+    refused for another reason, nothing is booked.
+    """
+    if count < 1:
+        raise ValueError(f"A series needs at least one session, not {count}.")
+    if count > MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {MAX_SESSIONS} sessions, because the insurance "
+            f"pays for {MAX_SESSIONS} per prescription. Book {MAX_SESSIONS} or fewer."
+        )
+
+    booked = []
+    week = 0
+    while len(booked) < count:
+        session = Appointment(first.therapist, first.client, first.start + week * WEEK, first.treatment)
+        week += 1
+        try:
+            booked.append(schedule.book(session))
+        except SlotTaken:
+            continue
+        except BookingError:
+            for done in booked:
+                schedule.appointments.remove(done)
+            raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..6034f45
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,76 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(day, hour=9, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions_at_the_same_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 15, 22])
+        self.assertEqual({a.start.time() for a in booked}, {datetime.time(9, 0)})
+        self.assertEqual(s.appointments, booked)
+
+    def test_sessions_keep_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, at(8, therapist="max", client="Jo Li"), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("max", "Jo Li", "standard"))
+
+    def test_taken_week_is_skipped_and_added_at_the_end(self):
+        s = Schedule()
+        s.book(at(15, client="Jo Li"))
+        booked = book_series(s, at(8), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_skipped_weeks_do_not_count_towards_the_series(self):
+        s = Schedule()
+        s.book(at(8, client="Jo Li"))
+        s.book(at(15, client="Jo Li"))
+        booked = book_series(s, at(8), 2)
+        self.assertEqual([a.start.day for a in booked], [22, 29])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(8), MAX_SESSIONS)), MAX_SESSIONS)
+
+    def test_more_than_nine_sessions_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "at most 9 sessions"):
+            book_series(s, at(8), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_is_an_error(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), at(8), 0)
+
+    def test_refusal_part_way_books_nothing(self):
+        s = Schedule()
+        original_book = s.book
+        attempts = []
+
+        def refuse_third_session(appointment):
+            attempts.append(appointment)
+            if len(attempts) == 3:
+                raise OutsideOpeningHours("closed")
+            return original_book(appointment)
+
+        with mock.patch.object(s, "book", side_effect=refuse_third_session):
+            with self.assertRaises(OutsideOpeningHours):
+                book_series(s, at(8), 3)
+        self.assertEqual(s.appointments, [])
+
+    def test_other_therapists_do_not_block_the_series(self):
+        s = Schedule()
+        s.book(at(15, therapist="max"))
+        booked = book_series(s, at(8), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
