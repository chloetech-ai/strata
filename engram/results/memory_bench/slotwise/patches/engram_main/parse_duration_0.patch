+"""Parsing of appointment durations typed by reception."""
+
+import re
+
+_HOURS_MINUTES = re.compile(r"(\d+)\s*h\s*(?:(\d+)\s*(?:mins?|m)?)?")
+_CLOCK = re.compile(r"(\d+):(\d{2})")
+_MINUTES = re.compile(r"(\d+)\s*(?:mins?|m)?")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '45 min', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    cleaned = text.strip().lower()
+    minutes = _parse_minutes(cleaned)
+    if minutes is None or minutes <= 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
+
+
+def _parse_minutes(cleaned):
+    match = _HOURS_MINUTES.fullmatch(cleaned)
+    if match:
+        hours, minutes = match.group(1), match.group(2) or "0"
+        return _total(hours, minutes)
+    match = _CLOCK.fullmatch(cleaned)
+    if match:
+        return _total(match.group(1), match.group(2))
+    match = _MINUTES.fullmatch(cleaned)
+    if match:
+        return int(match.group(1))
+    return None
+
+
+def _total(hours, minutes):
+    if int(minutes) >= 60:
+        return None
+    return int(hours) * 60 + int(minutes)
