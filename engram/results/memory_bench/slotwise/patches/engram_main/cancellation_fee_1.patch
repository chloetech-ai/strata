+"""Cancellation fees.
+
+Cancelling less than 48 hours before the appointment costs half the treatment
+price; less than 24 hours costs the full price. 48 hours or more is free.
+"""
+
+import datetime
+
+FREE_CANCELLATION = datetime.timedelta(hours=48)
+FULL_FEE_WITHIN = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Half-price fees are rounded half up to the next whole cent, so an odd
+    number of cents becomes the higher amount.
+    """
+    notice = appointment.start - cancelled_at
+    if notice >= FREE_CANCELLATION:
+        return 0
+    if notice >= FULL_FEE_WITHIN:
+        return (appointment.price + 1) // 2
+    return appointment.price
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
