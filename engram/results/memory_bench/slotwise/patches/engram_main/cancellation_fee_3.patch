index 0000000..c29a91e
--- /dev/null
+++ b/src/slotwise/fees.py
@@ -0,0 +1,25 @@
+"""Cancellation fees.
+
+A cancellation 48 or more hours before the appointment is free. From 24 up to
+(not including) 48 hours before, the client pays half the treatment price. Less
+than 24 hours before, the client pays the full price.
+"""
+
+import datetime
+
+FREE_UNTIL = datetime.timedelta(hours=48)
+HALF_UNTIL = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Half-price fees are rounded to the nearest cent, with exact halves rounded
+    up, so the result is always a whole number of cents.
+    """
+    notice = appointment.start - cancelled_at
+    if notice >= FREE_UNTIL:
+        return 0
+    if notice >= HALF_UNTIL:
+        return (appointment.price + 1) // 2
+    return appointment.price
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..fc86b84
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,46 @@
+import datetime
+import unittest
+from unittest.mock import patch
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 10, 9, 0)
+
+
+def appt(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+def before(**delta):
+    return START - datetime.timedelta(**delta)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_48_or_more_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=49)), 0)
+        self.assertEqual(cancellation_fee(appt(), before(hours=48)), 0)
+
+    def test_between_24_and_48_hours_pays_half(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=47, minutes=59)), 4900)
+        self.assertEqual(cancellation_fee(appt(), before(hours=24)), 4900)
+
+    def test_under_24_hours_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=23, minutes=59)), 9800)
+        self.assertEqual(cancellation_fee(appt(), before(hours=1)), 9800)
+
+    def test_after_start_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), START + datetime.timedelta(minutes=5)), 9800)
+
+    def test_half_uses_each_treatment_price(self):
+        self.assertEqual(cancellation_fee(appt("initial"), before(hours=30)), 7250)
+        self.assertEqual(cancellation_fee(appt("short"), before(hours=30)), 3400)
+
+    def test_odd_cent_half_rounds_up(self):
+        # No current treatment has an odd price; this checks the rounding rule itself.
+        with patch.object(Appointment, "price", new=property(lambda self: 1001)):
+            self.assertEqual(cancellation_fee(appt(), before(hours=30)), 501)
+
+
+if __name__ == "__main__":
+    unittest.main()
