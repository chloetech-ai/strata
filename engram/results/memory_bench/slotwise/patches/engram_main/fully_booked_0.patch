+    def test_fully_booked_at_the_daily_cap(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 8 + DAILY_CAP - 1):  # 6 appointments, 1 short of the cap
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(at(8 + DAILY_CAP - 1))  # the 7th
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(at(hour)) for hour in range(8, 8 + DAILY_CAP)]
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
