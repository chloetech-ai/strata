+    def book_short_days(self, s, first, last):
+        """Books 30-minute treatments for lena on Tue 2026-09-08, 40 minutes apart from 08:00, slots first to last-1."""
+        for i in range(first, last):
+            start = datetime.datetime(2026, 9, 8, 8, 0) + datetime.timedelta(minutes=40 * i)
+            s.book(Appointment("lena", "Jo Li", start, "short"))
+
+    def test_is_fully_booked_at_the_daily_limit(self):
+        s = Schedule()
+        self.book_short_days(s, 0, 6)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.book_short_days(s, 6, 7)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_is_fully_booked_ignores_cancelled(self):
+        s = Schedule()
+        self.book_short_days(s, 0, 7)
+        s.cancel(s.appointments_for("lena", datetime.date(2026, 9, 8))[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_is_fully_booked_is_per_therapist_and_day(self):
