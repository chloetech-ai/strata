@@ -144,6 +144,48 @@ class ScheduleTest(unittest.TestCase):
         s.book(at(10, therapist="marco"))
         self.assertEqual([a.start.hour for a in s.appointments_for("lena", datetime.date(2026, 9, 8))], [8, 14])
 
+    def test_free_slots_on_empty_day_run_from_opening_in_15_minute_steps(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # last 45-minute slot that ends by 19:00
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(isinstance(t, datetime.datetime) for t in slots))
+
+    def test_free_slots_respect_a_shorter_day(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 12), 60)  # Saturday, 08:00-12:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 12, 8, 0))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 0))
+        self.assertEqual(len(slots), 13)
+
+    def test_free_slots_on_a_closed_day_are_empty(self):
+        s = Schedule()
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_skip_a_booking_and_its_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so starts from 08:15 to 09:45 would clash for a 45-minute visit
+        day = datetime.date(2026, 9, 8)
+        empty = Schedule().free_slots("lena", day, 45)
+        blocked = [datetime.datetime(2026, 9, 8, h, m) for h, m in [(8, 15), (8, 30), (8, 45), (9, 0), (9, 15), (9, 30), (9, 45)]]
+        self.assertEqual(s.free_slots("lena", day, 45), [t for t in empty if t not in blocked])
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), s.free_slots("lena", day, 45))  # ends 08:45, 10 minutes before 09:00
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), s.free_slots("lena", day, 45))  # starts 10 minutes after 09:45
+
+    def test_free_slots_ignore_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        day = datetime.date(2026, 9, 8)
+        self.assertEqual(s.free_slots("lena", day, 45), Schedule().free_slots("lena", day, 45))
+
+    def test_free_slots_ignore_other_therapists(self):
+        s = Schedule()
+        s.book(at(9, therapist="marco"))
+        day = datetime.date(2026, 9, 8)
+        self.assertEqual(s.free_slots("lena", day, 45), Schedule().free_slots("lena", day, 45))
+
 
