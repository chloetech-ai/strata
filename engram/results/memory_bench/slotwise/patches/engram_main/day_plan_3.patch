+++ b/src/slotwise/printing.py
@@ -0,0 +1,18 @@
+"""Printable text for reception's receipt printer."""
+
+import textwrap
+
+# The receipt printer wraps anything longer than this onto a new line, which ruins the printout.
+WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s non-cancelled appointments on `day` as printable text, one entry per appointment."""
+    lines = [f"{therapist.title()} {day:%a %d.%m.%Y}", ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        text = f"{a.start:%H:%M}-{a.end:%H:%M} {a.client}, {a.treatment}"
+        lines.extend(textwrap.wrap(text, width=WIDTH, subsequent_indent="      "))
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
new file mode 100644
index 0000000..6eafefd
--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,43 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+TUE = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", client="Kim Weber", treatment="standard"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_the_day_in_time_order(self):
+        s = Schedule()
+        s.book(at(14, client="Jo Li", treatment="short"))
+        s.book(at(8))
+        self.assertEqual(
+            day_plan(s, "lena", TUE),
+            "Lena Tue 08.09.2026\n\n08:00-08:45 Kim Weber, standard\n14:00-14:30 Jo Li, short",
+        )
+
+    def test_free_day_says_so(self):
+        self.assertEqual(day_plan(Schedule(), "lena", TUE), "Lena Tue 08.09.2026\n\nNo appointments.")
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        s.cancel(s.book(at(9)).id)
+        s.book(at(10, therapist="marco"))
+        self.assertEqual(day_plan(s, "lena", TUE), "Lena Tue 08.09.2026\n\nNo appointments.")
+
+    def test_every_line_fits_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Theresia von Hohenstaufen-Liechtenstein", treatment="initial"))
+        plan = day_plan(s, "lena", TUE)
+        self.assertTrue(all(len(line) <= WIDTH for line in plan.split("\n")))
+        self.assertIn("Maria-Theresia von Hohenstaufen-Liechtenstein", " ".join(plan.split()))
+
+
+if __name__ == "__main__":
+    unittest.main()
