+"""Booking a series of weekly sessions."""
+
+import datetime
+
+from .errors import SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# insurance pays for at most this many sessions per doctor's prescription
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments starting with `first` and returns them in date order.
+
+    Each appointment has the same weekday, time, therapist, client and treatment as `first`.
+    A week that is already taken is skipped, and a replacement week is added after the last
+    one, so the series always has `count` sessions.
+    """
+    if count < 1:
+        raise ValueError(f"count must be at least 1, not {count}")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(
+            f"A series can have at most {MAX_SESSIONS} sessions, but {count} were asked for. "
+            f"Please book {MAX_SESSIONS} or fewer, and book the rest once a new prescription is in."
+        )
+    booked = []
+    week = 0
+    while len(booked) < count:
+        if week == 0:
+            appointment = first
+        else:
+            start = first.start + datetime.timedelta(weeks=week)
+            appointment = Appointment(first.therapist, first.client, start, first.treatment)
+        week += 1
+        try:
+            schedule.book(appointment)
+        except SlotTaken:
+            continue
+        booked.append(appointment)
+    return booked
