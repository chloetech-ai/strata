@@ -0,0 +1,76 @@
+import datetime
+import unittest
+
+from slotwise.errors import SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+TUESDAY = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def week_of(n):
+    return TUESDAY + datetime.timedelta(weeks=n)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_with_same_time_therapist_and_client(self):
+        s = Schedule()
+        first = Appointment("lena", "Kim Weber", TUESDAY)
+        booked = book_series(s, first, 3)
+        self.assertEqual([a.start for a in booked], [week_of(0), week_of(1), week_of(2)])
+        self.assertTrue(all(a.therapist == "lena" and a.client == "Kim Weber" for a in booked))
+        self.assertEqual(s.appointments, booked)
+
+    def test_first_is_the_booked_object_and_keeps_its_treatment(self):
+        s = Schedule()
+        first = Appointment("lena", "Kim Weber", TUESDAY, "initial")
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+        self.assertEqual({a.treatment for a in booked}, {"initial"})
+        self.assertEqual(len({a.id for a in booked}), 2)
+
+    def test_taken_week_is_skipped_and_replacement_added_at_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", week_of(1)))
+        booked = book_series(s, Appointment("lena", "Kim Weber", TUESDAY), 3)
+        self.assertEqual([a.start for a in booked], [week_of(0), week_of(2), week_of(3)])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_first_week_taken_is_skipped_too(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", TUESDAY))
+        booked = book_series(s, Appointment("lena", "Kim Weber", TUESDAY), 2)
+        self.assertEqual([a.start for a in booked], [week_of(1), week_of(2)])
+
+    def test_cancelled_week_is_free(self):
+        s = Schedule()
+        taken = s.book(Appointment("lena", "Jo Li", week_of(1)))
+        s.cancel(taken.id)
+        booked = book_series(s, Appointment("lena", "Kim Weber", TUESDAY), 2)
+        self.assertEqual([a.start for a in booked], [week_of(0), week_of(1)])
+
+    def test_other_therapist_does_not_block_a_week(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Jo Li", week_of(1)))
+        booked = book_series(s, Appointment("lena", "Kim Weber", TUESDAY), 2)
+        self.assertEqual([a.start for a in booked], [week_of(0), week_of(1)])
+
+    def test_nine_sessions_allowed(self):
+        booked = book_series(Schedule(), Appointment("lena", "Kim Weber", TUESDAY), 9)
+        self.assertEqual(len(booked), 9)
+
+    def test_more_than_nine_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong) as context:
+            book_series(s, Appointment("lena", "Kim Weber", TUESDAY), 12)
+        self.assertIn("at most 9", str(context.exception))
+        self.assertEqual(s.appointments, [])
+
+    def test_count_below_one_is_a_caller_mistake(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), Appointment("lena", "Kim Weber", TUESDAY), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
