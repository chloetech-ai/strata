index 0000000..f3dca71
--- /dev/null
+++ b/src/slotwise/reminders.py
@@ -0,0 +1,39 @@
+"""Text of the SMS appointment reminders sent to clients."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+MAX_LENGTH = 160
+
+# The SMS gateway only accepts plain ASCII. Umlauts are written with an
+# extra e ('ä' -> 'ae'), as German readers expect; other accents are dropped.
+_UMLAUTS = str.maketrans({
+    "ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss",
+})
+
+
+def to_ascii(text):
+    """Return text in plain ASCII, e.g. 'Brändli' -> 'Braendli', 'café' -> 'cafe'."""
+    text = text.translate(_UMLAUTS)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """Return the reminder SMS for an appointment, in plain ASCII.
+
+    Raises ValueError if the text would be longer than 160 characters, which
+    the gateway would bill as two messages. The text is never cut short.
+    """
+    when = appointment.start.strftime("%d.%m.%Y at %H:%M")
+    text = to_ascii(
+        f"Hello {appointment.client}, this is a reminder of your appointment "
+        f"on {when} with {appointment.therapist}. To move it, please call "
+        f"{RECEPTION_NUMBER}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(
+            f"Reminder for {appointment.client} is {len(text)} characters; "
+            f"the limit is {MAX_LENGTH}. Please shorten the name or the text."
+        )
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..4b706b4
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,36 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text, to_ascii
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_get_an_extra_e(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Jörg Müller Strauß"), "Joerg Mueller Strauss")
+
+    def test_other_accents_are_dropped(self):
+        self.assertEqual(to_ascii("café"), "cafe")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text_is_ascii_with_reception_number(self):
+        a = Appointment("lena", "Jörg Brändli", datetime.datetime(2026, 10, 16, 9, 0))
+        text = reminder_text(a)
+        self.assertEqual(
+            text,
+            "Hello Joerg Braendli, this is a reminder of your appointment on "
+            "16.10.2026 at 09:00 with lena. To move it, please call 044 512 77 30.",
+        )
+        self.assertTrue(text.isascii())
+        self.assertLessEqual(len(text), 160)
+
+    def test_too_long_reminder_is_refused_not_cut(self):
+        a = Appointment("lena", "A" * 200, datetime.datetime(2026, 10, 16, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
