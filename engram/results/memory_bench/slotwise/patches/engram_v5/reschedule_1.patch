+    def _check_slot(self, appointment, ignore=None):
+        """Raises unless the practice is open for `appointment` and its therapist is free. `ignore` is skipped."""
+        if not is_open_between(appointment.start, appointment.end):
+            raise OutsideOpeningHours(_closed_message(appointment))
+        for other in self.appointments:
+            if other is ignore or other.cancelled or other.therapist != appointment.therapist:
+                continue
+            if appointment.start < other.end + GAP and other.start < appointment.end + GAP:
+                raise SlotTaken(
+                    f"{appointment.therapist} is booked from {other.start:%H:%M} to {other.end:%H:%M}, and needs "
+                    f"{GAP.seconds // 60} minutes between appointments. Please choose another time."
+                )
