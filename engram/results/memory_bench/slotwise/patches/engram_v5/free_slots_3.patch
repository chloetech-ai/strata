+    def test_free_slots_on_empty_day_start_at_opening_and_stop_at_closing(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends 19:00
+        # 07:30 to 18:15 in 15-minute steps: a 45-minute appointment must end by 19:00
+        self.assertEqual(len(slots), 44)
+
+    def test_free_slots_respect_gap_around_existing(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so lena needs 08:50 to 09:55 kept clear
+        starts = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), starts)  # overlaps
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), starts)  # ends at 09:00, inside the gap
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), starts)  # starts inside the gap
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), starts)  # first grid slot after the gap clears
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), starts)  # ends 08:45, still 15 minutes before 09:00
+
+    def test_free_slots_agree_with_book(self):
+        s = Schedule()
+        s.book(at(10, 0))
+        s.book(at(13, 0, client="Jo Li"))
+        day = datetime.date(2026, 9, 8)
+        offered = s.free_slots("lena", day, 60)
+        for start in [datetime.datetime.combine(day, datetime.time(7, 30)) + i * datetime.timedelta(minutes=15)
+                      for i in range(46)]:
+            trial = Schedule()
+            trial.appointments = list(s.appointments)
+            try:
+                trial.book(Appointment("lena", "Sam Ko", start, "initial"))
+                accepted = True
+            except BookingError:
+                accepted = False
+            self.assertEqual(start in offered, accepted, start)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(9, therapist="marco", client="Jo Li"))
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+
+    def test_free_slots_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
