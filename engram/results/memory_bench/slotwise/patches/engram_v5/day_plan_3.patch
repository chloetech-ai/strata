+"""Printable text for the receipt printer at reception."""
+
+import textwrap
+
+# the receipt printer fits 42 characters on a line; longer lines wrap into a mess
+WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s active appointments on `day` as plain text, at most 42 characters a line."""
+    lines = [*_wrap(therapist), *_wrap(f"{day:%A %d %B %Y}"), ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.extend(_wrap(f"{a.start:%H:%M}-{a.end:%H:%M} {a.treatment} {a.client}"))
+    return "\n".join(lines) + "\n"
+
+
+def _wrap(text):
+    """`text` split over as many lines as needed to fit the printer, continuation lines indented."""
+    return textwrap.wrap(text, WIDTH, subsequent_indent="    ") or [""]
