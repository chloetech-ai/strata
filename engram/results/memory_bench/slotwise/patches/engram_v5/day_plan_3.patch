@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, client="Kim Weber", treatment="standard", therapist="lena"):
+    return Appointment(therapist, client, datetime.datetime.combine(DAY, datetime.time(hour, minute)), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", DAY),
+            "lena\nTuesday 08 September 2026\n\n09:00-09:45 standard Kim Weber\n10:00-10:30 short Jo Li\n",
+        )
+
+    def test_empty_day(self):
+        self.assertEqual(day_plan(Schedule(), "lena", DAY), "lena\nTuesday 08 September 2026\n\nNo appointments.\n")
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(11, therapist="mia"))
+        self.assertIn("No appointments.", day_plan(s, "lena", DAY))
+
+    def test_no_line_longer_than_printer_width(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Theresia von Brändli-Oberholzer-Gantenbein", therapist="Dr. Christiane Haldimann"))
+        plan = day_plan(s, "Dr. Christiane Haldimann", DAY)
+        for line in plan.splitlines():
+            self.assertLessEqual(len(line), WIDTH)
+        self.assertIn("Brändli-Oberholzer-Gantenbein", plan.replace("\n    ", ""))
+
+
+if __name__ == "__main__":
+    unittest.main()
