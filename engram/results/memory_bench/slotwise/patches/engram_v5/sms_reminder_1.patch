+"""Text of the SMS reminders sent before appointments."""
+
+import unicodedata
+
+from .model import Appointment
+
+RECEPTION_NUMBER = "044 512 77 30"
+# longer SMS are billed as two messages
+MAX_LENGTH = 160
+
+# the SMS gateway only takes plain ASCII; these letters are written with an added e
+_UMLAUTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def _ascii(text):
+    """Turns umlauts and accents into plain ASCII, e.g. 'Brändli' -> 'Braendli'."""
+    for char, replacement in _UMLAUTS.items():
+        text = text.replace(char, replacement)
+    # decompose the rest ('é' -> 'e' + accent) and drop the accents
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """Returns the plain ASCII reminder SMS for `appointment`.
+
+    Raises ValueError if the text is longer than MAX_LENGTH characters, so a reminder is never cut short.
+    """
+    start = appointment.start
+    text = (
+        f"Hello {_ascii(appointment.client)}, this is a reminder of your appointment at Lindqvist Physio "
+        f"with {_ascii(appointment.therapist)} on {start:%d.%m.%Y} at {start:%H:%M}. "
+        f"To move it, call {RECEPTION_NUMBER}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"Reminder is {len(text)} characters, more than {MAX_LENGTH}: {text}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..45811a3
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,37 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import RECEPTION_NUMBER, reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_includes_date_time_and_reception_number(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("07.09.2026", text)
+        self.assertIn("09:00", text)
+        self.assertIn(RECEPTION_NUMBER, text)
+        self.assertIn("Kim Weber", text)
+
+    def test_umlauts_and_accents_become_ascii(self):
+        a = Appointment("lena", "Brändli", datetime.datetime(2026, 9, 7, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("Braendli", text)
+        self.assertTrue(text.isascii())
+
+    def test_accents_are_dropped(self):
+        a = Appointment("René", "José Pérez", datetime.datetime(2026, 9, 7, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("Jose Perez", text)
+        self.assertIn("Rene", text)
+        self.assertTrue(text.isascii())
+
+    def test_too_long_is_refused(self):
+        a = Appointment("lena", "x" * 200, datetime.datetime(2026, 9, 7, 9, 0))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
