         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 9))
 
+    def test_free_slots_on_empty_day_start_at_opening_on_grid(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # 18:15-19:00 is the last fit
+        self.assertEqual(len(slots), (18 * 60 + 15 - (7 * 60 + 30)) // 15 + 1)
+
+    def test_free_slots_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_respect_gap_on_both_sides(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 15 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, inside the gap
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)  # overlaps the booking
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), slots)  # overlaps the booking
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # starts inside the gap
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # 15 minutes after the end, on the grid
+
+    def test_free_slots_match_book(self):
+        s = Schedule()
+        s.book(at(9))
+        day = datetime.date(2026, 9, 8)
+        for start in s.free_slots("lena", day, 45):
+            s.book(Appointment("lena", "Jo Li", start, "standard"))  # must not raise
+            s.cancel(s.appointments[-1].id)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(12, therapist="marco", client="Jo Li"))
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+        s.cancel(a.id)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+        self.assertIn(datetime.datetime(2026, 9, 8, 12, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+
