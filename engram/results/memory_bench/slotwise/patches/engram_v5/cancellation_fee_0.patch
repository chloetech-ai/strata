@@ -0,0 +1,20 @@
+"""Cancellation fees for Lindqvist Physio."""
+
+import datetime
+
+from .model import Appointment
+
+
+def cancellation_fee(appointment: Appointment, cancelled_at: datetime.datetime) -> int:
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before: full price.
+    Less than 48 hours before: half price.
+    Earlier than that: nothing.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < datetime.timedelta(hours=24):
+        return appointment.price
+    if notice < datetime.timedelta(hours=48):
+        return appointment.price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
