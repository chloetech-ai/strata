--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,44 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.standard = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def test_more_than_48_hours_before_is_free(self):
+        cancelled_at = self.start - datetime.timedelta(hours=49)
+        self.assertEqual(cancellation_fee(self.standard, cancelled_at), 0)
+
+    def test_exactly_48_hours_before_is_free(self):
+        cancelled_at = self.start - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(self.standard, cancelled_at), 0)
+
+    def test_between_24_and_48_hours_is_half_price(self):
+        cancelled_at = self.start - datetime.timedelta(hours=30)
+        self.assertEqual(cancellation_fee(self.standard, cancelled_at), 4900)
+
+    def test_exactly_24_hours_before_is_half_price(self):
+        cancelled_at = self.start - datetime.timedelta(hours=24)
+        self.assertEqual(cancellation_fee(self.standard, cancelled_at), 4900)
+
+    def test_less_than_24_hours_before_is_full_price(self):
+        cancelled_at = self.start - datetime.timedelta(hours=2)
+        self.assertEqual(cancellation_fee(self.standard, cancelled_at), 9800)
+
+    def test_after_start_is_full_price(self):
+        cancelled_at = self.start + datetime.timedelta(minutes=5)
+        self.assertEqual(cancellation_fee(self.standard, cancelled_at), 9800)
+
+    def test_uses_treatment_price(self):
+        initial = Appointment("lena", "Kim Weber", self.start, "initial")
+        cancelled_at = self.start - datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(initial, cancelled_at), 14500)
+
+
+if __name__ == "__main__":
+    unittest.main()
