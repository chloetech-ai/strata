+"""Printable text for reception's receipt printer."""
+
+import textwrap
+
+# the receipt printer prints this many characters a line; longer lines wrap into a mess
+WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s appointments on `day` as printable text, at most WIDTH characters a line."""
+    lines = [f"{day:%A %d %B %Y}", *_wrap(f"Therapist: {therapist}"), "-" * WIDTH]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}")
+        lines.extend(_wrap(a.client, indent="  "))
+        lines.extend(_wrap(f"{a.treatment}, {a.minutes} min", indent="  "))
+    return "\n".join(lines)
+
+
+def _wrap(text, indent=""):
+    return textwrap.wrap(text, WIDTH, initial_indent=indent, subsequent_indent=indent)
