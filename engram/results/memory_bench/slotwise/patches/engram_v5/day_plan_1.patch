@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Monday 07 September 2026\n"
+            "Therapist: lena\n"
+            "------------------------------------------\n"
+            "09:00-09:45\n"
+            "  Kim Weber\n"
+            "  standard, 45 min\n"
+            "10:00-10:45\n"
+            "  Jo Li\n"
+            "  standard, 45 min",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(10, therapist="marc", client="Jo Li"))
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+    def test_empty_day(self):
+        text = day_plan(Schedule(), "lena", MONDAY)
+        self.assertEqual(text.splitlines()[-1], "No appointments.")
+
+    def test_no_line_is_wider_than_the_printer(self):
+        therapist = "Dr. Johanna Elisabeth Ruth Strasser-Nordmann"
+        s = Schedule()
+        s.book(at(9, therapist=therapist, client="Maria-Theresa Alexandrina von Hohenzollern-Sigmaringen"))
+        text = day_plan(s, therapist, MONDAY)
+        self.assertNotIn("No appointments.", text)
+        for line in text.splitlines():
+            self.assertLessEqual(len(line), WIDTH, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
