+    def reschedule(self, appointment_id, new_start):
+        """Moves the appointment to `new_start`, keeping its length. Refused the same way a booking is."""
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment was cancelled, so it can't be moved. Please book a new appointment.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check_time(moved)
+        appointment.start = new_start
+        return appointment
