+        s.book(at(9, therapist="marco", client="Jo Li"))
+        s.book(Appointment("lena", "Sam Ko", datetime.datetime(2026, 9, 9, 9, 0)))
+        day = datetime.date(2026, 9, 8)
+        self.assertFalse(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 10)))
