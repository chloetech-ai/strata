+    def test_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        for i in range(6):
+            s.book(at(8 + i, client=f"Client {i}"))  # 08:00 to 13:55, one per hour
+        day = datetime.date(2026, 9, 8)
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(at(14, client="Client 6"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_book_still_allows_going_over_the_cap(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(at(8 + i, client=f"Client {i}"))
+        s.book(at(15, client="Client 7"))
+        self.assertEqual(len(s.appointments), 8)
+
+    def test_fully_booked_ignores_cancelled_and_other_therapists_and_days(self):
+        s = Schedule()
