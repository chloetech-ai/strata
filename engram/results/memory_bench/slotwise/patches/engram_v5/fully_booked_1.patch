 class Schedule:
     def __init__(self):
@@ -56,6 +59,15 @@ class Schedule:
         days = [monday + datetime.timedelta(days=i) for i in range(7)]
         return {day: [a for a in self.appointments_for(therapist, day) if not a.cancelled] for day in days}
 
+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` already has the daily maximum of active appointments on `day`.
+
+        Only the online booking page uses this. book() does not enforce the cap, because reception
+        sometimes books over it when the therapist agrees.
+        """
+        active = [a for a in self.appointments_for(therapist, day) if not a.cancelled]
+        return len(active) >= DAILY_CAP
+
 
