@@ -0,0 +1,58 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li"))
+        s.book(at(9, treatment="short"))
+        plan = day_plan(s, "lena", DAY)
+        self.assertEqual(
+            plan.splitlines(),
+            [
+                "Day plan Tuesday 08.09.2026",
+                "lena",
+                "-" * WIDTH,
+                "09:00-09:30 Short",
+                "  Kim Weber",
+                "10:00-10:45 Standard",
+                "  Jo Li",
+            ],
+        )
+
+    def test_empty_day(self):
+        self.assertIn("No appointments.", day_plan(Schedule(), "lena", DAY).splitlines())
+
+    def test_cancelled_appointments_are_left_out(self):
+        s = Schedule()
+        a = s.book(at(9, client="Jo Li"))
+        s.cancel(a.id)
+        self.assertNotIn("Jo Li", day_plan(s, "lena", DAY))
+
+    def test_other_therapists_are_left_out(self):
+        s = Schedule()
+        s.book(at(9, therapist="mark", client="Jo Li"))
+        self.assertNotIn("Jo Li", day_plan(s, "lena", DAY))
+
+    def test_no_line_is_longer_than_the_printer_width(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Theresia Fankhauser-Brändli von und zu Oberwil"))
+        plan = day_plan(s, "lena", DAY)
+        for line in plan.splitlines():
+            self.assertLessEqual(len(line), WIDTH, line)
+        self.assertIn("Fankhauser-Brändli", plan)
+
+
+if __name__ == "__main__":
+    unittest.main()
