@@ -0,0 +1,23 @@
+"""Printable text for reception."""
+
+import textwrap
+
+# the receipt printer prints this many characters a line; longer lines wrap into a mess
+WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s active appointments on `day` as text, at most WIDTH characters a line."""
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    lines = [f"Day plan {day:%A %d.%m.%Y}", therapist, "-" * WIDTH]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M} {a.treatment.capitalize()}")
+        lines.append(f"  {a.client}")
+    return "\n".join(line for text in lines for line in _fit(text))
+
+
+def _fit(text):
+    """`text` split into lines of at most WIDTH characters; continuation lines are indented."""
+    return textwrap.wrap(text, WIDTH, subsequent_indent="  ", break_on_hyphens=False) or [""]
