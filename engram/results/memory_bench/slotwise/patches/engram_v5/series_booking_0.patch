@@ -0,0 +1,47 @@
+"""Series bookings: the same weekday, time and therapist, one session a week."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# insurance pays for at most 9 sessions per doctor's prescription
+MAX_SESSIONS = 9
+
+# how many weeks past `count` we look for free weeks before giving up
+MAX_SKIPPED_WEEKS = 12
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments starting with `first` and returns them.
+
+    A week whose slot is already taken is skipped, and the session moves to the
+    next free week, so the client still gets all `count` sessions. The series is
+    all or nothing: if it cannot be completed, nothing is booked.
+    """
+    if count < 1:
+        raise ValueError(f"count must be at least 1, not {count}")
+    if count > MAX_SESSIONS:
+        raise BookingError(f"A series can have at most {MAX_SESSIONS} sessions. Please book {MAX_SESSIONS} or fewer.")
+
+    booked = []
+    week = 0
+    try:
+        while len(booked) < count:
+            if week >= count + MAX_SKIPPED_WEEKS:
+                raise SlotTaken(
+                    f"{first.therapist} has no free {first.start:%A} at {first.start:%H:%M} for {count} weeks. "
+                    "Please choose another time or fewer sessions."
+                )
+            start = first.start + datetime.timedelta(weeks=week)
+            appointment = Appointment(first.therapist, first.client, start, first.treatment)
+            try:
+                booked.append(schedule.book(appointment))
+            except SlotTaken:
+                pass  # this week is taken; the session moves to a later week
+            week += 1
+    except BookingError:
+        # book() appends, so the sessions booked so far are the last entries
+        del schedule.appointments[len(schedule.appointments) - len(booked):]
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..65a93f1
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,67 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SKIPPED_WEEKS, book_series
+
+
+def first_session(therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, 9, 0))  # a Tuesday
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, first_session(), 4)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9, 0) for d in (8, 15, 22, 29)],
+        )
+        self.assertEqual(len(s.appointments), 4)
+        self.assertTrue(all(a.therapist == "lena" and a.client == "Kim Weber" for a in booked))
+
+    def test_taken_week_is_skipped_and_added_at_the_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9, 0)))
+        booked = book_series(s, first_session(), 2)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, 8, 9, 0), datetime.datetime(2026, 9, 22, 9, 0)],
+        )
+
+    def test_more_than_nine_sessions_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, first_session(), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first_session(), 9)), 9)
+
+    def test_count_below_one_is_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first_session(), 0)
+
+    def test_incomplete_series_books_nothing(self):
+        s = Schedule()
+        # block every week the series could use after the first one
+        for week in range(1, 2 + MAX_SKIPPED_WEEKS):
+            s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9, 0) + datetime.timedelta(weeks=week)))
+        before = len(s.appointments)
+        with self.assertRaises(SlotTaken):
+            book_series(s, first_session(), 2)
+        self.assertEqual(len(s.appointments), before)
+
+    def test_other_therapist_does_not_block_the_series(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Jo Li", datetime.datetime(2026, 9, 15, 9, 0)))
+        booked = book_series(s, first_session(), 2)
+        self.assertEqual(len(booked), 2)
+        self.assertEqual(booked[1].start, datetime.datetime(2026, 9, 15, 9, 0))
+
+
+if __name__ == "__main__":
+    unittest.main()
