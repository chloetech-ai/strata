+"""Text of the SMS appointment reminders."""
+
+import unicodedata
+
+# the gateway accepts only plain ASCII, and longer messages are billed as two
+MAX_LENGTH = 160
+RECEPTION_NUMBER = "044 512 77 30"
+
+# German letters are written with an extra e, so 'Brändli' becomes 'Braendli'
+_UMLAUTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def reminder_text(appointment):
+    """The SMS reminder for `appointment`. Raises ValueError if it would not fit in MAX_LENGTH."""
+    text = (
+        f"Lindqvist Physio: Hello {appointment.client}, reminder of your appointment with "
+        f"{appointment.therapist} on {appointment.start:%A %d %B} at {appointment.start:%H:%M}. "
+        f"To move it, call {RECEPTION_NUMBER}."
+    )
+    text = _to_ascii(text)
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"Reminder is {len(text)} characters, the limit is {MAX_LENGTH}: {text}")
+    return text
+
+
+def _to_ascii(text):
+    for char, replacement in _UMLAUTS.items():
+        text = text.replace(char, replacement)
+    # other accents: 'é' -> 'e'
+    decomposed = unicodedata.normalize("NFKD", text)
+    return "".join(c for c in decomposed if not unicodedata.combining(c)).encode("ascii").decode("ascii")
