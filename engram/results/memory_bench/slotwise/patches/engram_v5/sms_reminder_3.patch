@@ -0,0 +1,38 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, reminder_text
+
+
+def appointment(therapist="lena", client="Kim Weber", treatment="standard"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, 9, 0), treatment)
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text(self):
+        self.assertEqual(
+            reminder_text(appointment()),
+            "Lindqvist Physio: Hello Kim Weber, reminder of your appointment with lena on Tuesday 08 September "
+            "at 09:00. To move it, call 044 512 77 30.",
+        )
+
+    def test_umlauts_become_plain_ascii(self):
+        text = reminder_text(appointment(therapist="Brändli", client="Jürg Öztürk"))
+        self.assertIn("Braendli", text)
+        self.assertIn("Juerg Oeztuerk", text)
+        text.encode("ascii")
+
+    def test_accents_lose_their_mark(self):
+        self.assertIn("Rene Bessaguet", reminder_text(appointment(client="René Bessaguet")))
+
+    def test_too_long_is_refused_not_cut(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client="X" * 150))
+
+    def test_fits_within_limit(self):
+        self.assertLessEqual(len(reminder_text(appointment())), MAX_LENGTH)
+
+
+if __name__ == "__main__":
+    unittest.main()
