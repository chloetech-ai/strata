@@ -0,0 +1,38 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        # "standard" treatment: 9800 cents
+        self.appointment = Appointment(
+            "lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 0), "standard"
+        )
+
+    def cancel_before(self, hours):
+        return self.appointment.start - datetime.timedelta(hours=hours)
+
+    def test_more_than_48_hours_before_is_free(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_before(72)), 0)
+
+    def test_exactly_48_hours_before_is_free(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_before(48)), 0)
+
+    def test_under_48_hours_is_half_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_before(47)), 4900)
+
+    def test_exactly_24_hours_before_is_half_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_before(24)), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_before(23)), 9800)
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_before(-1)), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
