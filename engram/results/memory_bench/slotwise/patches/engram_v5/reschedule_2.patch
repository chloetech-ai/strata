+    def test_reschedule_keeps_gap_from_others(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.book(at(11, client="Jo Li"))  # 11:00-11:45
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 55))  # ends 11:40, inside the gap
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 5))  # ends 10:50, exactly 10 minutes before 11:00
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 10, 5))
