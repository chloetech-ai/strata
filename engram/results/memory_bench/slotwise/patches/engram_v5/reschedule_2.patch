+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to `new_start`, keeping its id, therapist and treatment.
+
+        Nothing changes if the new time is refused.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError(
+                "This appointment has been cancelled, so it cannot be moved. Please book a new appointment instead."
+            )
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check_free(moved)
+        appointment.start = new_start
+        return appointment
