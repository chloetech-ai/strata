+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.appointment = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def cancel_hours_before(self, hours):
+        return self.start - datetime.timedelta(hours=hours)
+
+    def test_under_24_hours_pays_full_price(self):
+        fee = cancellation_fee(self.appointment, self.cancel_hours_before(23))
+        self.assertEqual(fee, 9800)
+
+    def test_between_24_and_48_hours_pays_half(self):
+        fee = cancellation_fee(self.appointment, self.cancel_hours_before(30))
+        self.assertEqual(fee, 4900)
+
+    def test_exactly_24_hours_pays_half(self):
+        fee = cancellation_fee(self.appointment, self.cancel_hours_before(24))
+        self.assertEqual(fee, 4900)
+
+    def test_exactly_48_hours_pays_nothing(self):
+        fee = cancellation_fee(self.appointment, self.cancel_hours_before(48))
+        self.assertEqual(fee, 0)
+
+    def test_more_than_48_hours_pays_nothing(self):
+        fee = cancellation_fee(self.appointment, self.cancel_hours_before(72))
+        self.assertEqual(fee, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
