@@ -0,0 +1,44 @@
+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_sorted_by_start(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_touching_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_keeps_outer_end(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_datetimes(self):
+        result = merge_intervals([
+            (DT(2026, 10, 15, 9, 30), DT(2026, 10, 15, 10, 0)),
+            (DT(2026, 10, 15, 9, 0), DT(2026, 10, 15, 9, 30)),
+            (DT(2026, 10, 15, 11, 0), DT(2026, 10, 15, 11, 30)),
+        ])
+        self.assertEqual(result, [
+            (DT(2026, 10, 15, 9, 0), DT(2026, 10, 15, 10, 0)),
+            (DT(2026, 10, 15, 11, 0), DT(2026, 10, 15, 11, 30)),
+        ])
+
+    def test_input_not_modified(self):
+        intervals = [(5, 6), (1, 4), (3, 2)]
+        snapshot = list(intervals)
+        merge_intervals(intervals)
+        self.assertEqual(intervals, snapshot)
+
+
+if __name__ == "__main__":
+    unittest.main()
