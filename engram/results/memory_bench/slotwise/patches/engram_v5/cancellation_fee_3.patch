@@ -0,0 +1,36 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.appointment = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def cancel_hours_before(self, hours):
+        return self.start - datetime.timedelta(hours=hours)
+
+    def test_more_than_48_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_hours_before(72)), 0)
+
+    def test_exactly_48_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_hours_before(48)), 0)
+
+    def test_between_24_and_48_hours_is_half_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_hours_before(36)), 4900)
+
+    def test_exactly_24_hours_ahead_is_half_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_hours_before(24)), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.cancel_hours_before(2)), 9800)
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.start + datetime.timedelta(hours=1)), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
