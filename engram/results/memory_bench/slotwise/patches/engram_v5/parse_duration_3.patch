@@ -0,0 +1,32 @@
+"""Reading durations typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]+)")
+
+
+def parse_duration(text):
+    """Length in minutes of a duration such as '45', '45 min', '1h', '1h30' or '1:30'.
+
+    Raises ValueError if the text is not a duration or the duration is zero.
+    """
+    cleaned = text.strip().lower()
+    if match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+    elif match := _HOURS.fullmatch(cleaned):
+        minutes = _hours_and_minutes(text, match[1], match[2] or "0")
+    elif match := _CLOCK.fullmatch(cleaned):
+        minutes = _hours_and_minutes(text, match[1], match[2])
+    else:
+        raise ValueError(f"Cannot read {text!r} as a duration; try 45, 1h or 1h30")
+    if minutes == 0:
+        raise ValueError(f"Duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _hours_and_minutes(text, hours, minutes):
+    if int(minutes) >= 60:
+        raise ValueError(f"Minutes must be less than 60 in {text!r}")
+    return int(hours) * 60 + int(minutes)
