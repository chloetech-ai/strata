+"""Appointment durations typed by the front desk, e.g. '45', '1h30' or '1:30'."""
+
+import re
+
+_CLOCK = re.compile(r"(\d+):(\d{2})")  # 1:30
+_HOURS_MINUTES = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*(?:min|m)?)?")  # 1h, 1h30, 1h 30m
+_MINUTES = re.compile(r"(\d+)\s*(?:min|m)?")  # 45, 45m, 45 min
+
+
+def parse_duration(text):
+    """Return the duration in minutes, e.g. parse_duration('1h30') == 90.
+
+    Accepts minutes ('45', '45m', '45 min'), hours ('1h', '2h15', '1h 30m')
+    and hours:minutes ('1:30'). Case and surrounding spaces are ignored.
+    Raises ValueError for anything else, and for zero.
+    """
+    value = text.strip().lower()
+    minutes = _parse(value)
+    if minutes is None or minutes == 0:
+        raise ValueError(
+            f"Not a valid duration: {text!r}. Please enter minutes, such as 45, or hours and minutes, such as 1h30 or 1:30."
+        )
+    return minutes
+
+
+def _parse(value):
+    if match := _CLOCK.fullmatch(value):
+        hours, minutes = int(match[1]), int(match[2])
+        return hours * 60 + minutes if minutes < 60 else None
+    if match := _HOURS_MINUTES.fullmatch(value):
+        hours, minutes = int(match[1]), int(match[2] or 0)
+        return hours * 60 + minutes if minutes < 60 else None
+    if match := _MINUTES.fullmatch(value):
+        return int(match[1])
+    return None
diff --git a/tests/test_durations.py b/tests/test_durations.py
