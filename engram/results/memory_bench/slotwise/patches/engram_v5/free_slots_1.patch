+    def test_free_slots_empty_day_starts_at_opening_on_grid(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends exactly at 19:00
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(s.minute % 15 == 0 for s in slots))
+
+    def test_free_slots_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 6), 45), [])  # Sunday
+
+    def test_free_slots_respect_gap_on_both_sides(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, blocked until 09:55 and from 08:50
+        starts = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), starts)  # ends 09:00, inside the gap
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), starts)  # ends 08:45, 10 minutes before the 09:00 start
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), starts)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), starts)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), starts)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), starts)  # first grid start after the 09:55 gap end
+
+    def test_free_slots_agree_with_book(self):
+        day = datetime.date(2026, 9, 8)
+        booked = [at(9), at(13, 15, client="Jo Li")]
+        s = Schedule()
+        for appointment in booked:
+            s.book(appointment)
+        offered = s.free_slots("lena", day, 60)
+        for hour in range(7, 19):
+            for minute in (0, 15, 30, 45):
+                start = datetime.datetime(2026, 9, 8, hour, minute)
+                if start.time() < datetime.time(7, 30) or start + datetime.timedelta(minutes=60) > datetime.datetime(2026, 9, 8, 19):
+                    continue
+                trial = Schedule()
+                for appointment in booked:
+                    trial.book(appointment)
+                try:
+                    trial.book(Appointment("lena", "Sam Ko", start, "initial"))
+                    accepted = True
+                except SlotTaken:
+                    accepted = False
+                self.assertEqual(accepted, start in offered, start)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
