+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (15-minute grid from opening time) where a `minutes`-long appointment could be booked."""
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        slots = []
+        start = opens
+        while start + datetime.timedelta(minutes=minutes) <= closes:
+            end = start + datetime.timedelta(minutes=minutes)
+            if self._blocking(therapist, start, end) is None:
+                slots.append(start)
+            start += FREE_SLOT_STEP
+        return slots
+
+    def _blocking(self, therapist, start, end):
+        """The non-cancelled appointment of `therapist` that leaves no GAP around [start, end), or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if start < other.end + GAP and other.start < end + GAP:
+                return other
+        return None
+
