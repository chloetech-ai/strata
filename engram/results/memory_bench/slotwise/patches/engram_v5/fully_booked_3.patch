+    def test_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # seven appointments, one per hour
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
+    def test_six_appointments_is_not_fully_booked(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointments_do_not_count_towards_full(self):
+        s = Schedule()
+        first = s.book(at(8))
+        for hour in range(9, 15):
+            s.book(at(hour))
+        s.cancel(first.id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_book_still_accepts_appointments_past_the_cap(self):
+        s = Schedule()
+        for hour in range(8, 16):  # eight appointments
+            s.book(at(hour))
