+    def test_reschedule_moves_start_and_keeps_length(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 13, 0))
+        self.assertEqual(a.end, datetime.datetime(2026, 9, 8, 13, 45))
+
+    def test_reschedule_to_own_overlapping_time_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start.minute, 5)
+
+    def test_reschedule_frees_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 0))
+        s.book(at(9, client="Jo Li"))
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_reschedule_into_taken_slot_leaves_appointment_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 50))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_keeps_ten_minute_gap(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))  # 11:00-11:45
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 10))  # ends 10:55, 5 minutes before 11:00
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 5))  # ends 10:50, exactly 10 minutes before 11:00
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 10, 5))
+
+    def test_reschedule_outside_opening_hours(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_ignores_other_therapist(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(13, therapist="marco", client="Jo Li"))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 0))
+        self.assertEqual(a.start.hour, 13)
+
+    def test_reschedule_ignores_cancelled_appointment_in_the_way(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        s.cancel(s.appointments[1].id)
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start.hour, 11)
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
