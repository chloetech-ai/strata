+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# insurance pays for at most this many sessions per doctor's prescription
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them.
+
+    Every session has the same weekday, time, therapist, client and treatment as `first`, so
+    `first` must not be booked yet. A week whose slot is taken is skipped, and a later week is
+    booked in its place so the client still gets `count` sessions.
+    """
+    if count < 1:
+        raise ValueError(f"A series needs at least one session, not {count}")
+    if count > MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {MAX_SESSIONS} sessions, but {count} were asked for. "
+            f"Please book {MAX_SESSIONS} or fewer."
+        )
+    booked = []
+    week = 0
+    while len(booked) < count:
+        if week == 0:
+            candidate = first
+        else:
+            start = first.start + datetime.timedelta(weeks=week)
+            candidate = Appointment(first.therapist, first.client, start, first.treatment)
+        week += 1
+        try:
+            booked.append(schedule.book(candidate))
+        except SlotTaken:
+            continue  # that week is taken, so the series moves on to the next one
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..4df0c70
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,88 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(hour, minute=0, day=8, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), "standard")
+
+
+def week_later(start, weeks):
+    return start + datetime.timedelta(weeks=weeks)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions_like_first(self):
+        s = Schedule()
+        first = at(9)
+        booked = book_series(s, first, 3)
+        self.assertEqual([a.start for a in booked], [week_later(first.start, i) for i in range(3)])
+        self.assertIs(booked[0], first)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("lena", "Kim Weber", "standard"))
+        self.assertEqual(s.appointments, booked)
+
+    def test_skips_taken_week_and_books_replacement_at_end(self):
+        s = Schedule()
+        first = at(9)
+        s.book(at(9, day=15, client="Jo Li"))  # second week is taken
+        booked = book_series(s, first, 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [first.start, week_later(first.start, 2), week_later(first.start, 3)],
+        )
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_first_week_taken_is_skipped(self):
+        s = Schedule()
+        s.book(at(9, client="Jo Li"))
+        booked = book_series(s, at(9), 2)
+        self.assertEqual([a.start.day for a in booked], [15, 22])
+
+    def test_other_therapist_does_not_block_a_week(self):
+        s = Schedule()
+        s.book(at(9, day=15, therapist="marco", client="Jo Li"))
+        booked = book_series(s, at(9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_gap_around_existing_appointment_blocks_a_week(self):
+        s = Schedule()
+        s.book(at(9, 50, day=15, client="Jo Li"))  # starts 5 minutes after a 9:00 session ends
+        booked = book_series(s, at(9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 22])
+
+    def test_cancelled_appointment_does_not_block_a_week(self):
+        s = Schedule()
+        cancelled = s.book(at(9, day=15, client="Jo Li"))
+        s.cancel(cancelled.id)
+        booked = book_series(s, at(9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_nine_sessions_allowed(self):
+        booked = book_series(Schedule(), at(9), MAX_SESSIONS)
+        self.assertEqual(len(booked), 9)
+
+    def test_more_than_nine_sessions_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(BookingError) as caught:
+            book_series(s, at(9), MAX_SESSIONS + 1)
+        self.assertIn("at most 9", str(caught.exception))
+        self.assertEqual(s.appointments, [])
+
+    def test_closed_first_session_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(18, 30), 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_is_a_caller_mistake(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), at(9), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
