+    def test_is_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        for hour in range(8, 15):  # seven 45-minute appointments, 08:00 to 15:00
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
