@@ -0,0 +1,31 @@
+"""Durations typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_DURATION = re.compile(
+    r"(?:(?P<h>[0-9]+)\s*h(?:\s*(?P<hm>[0-9]+)\s*(?:min|m)?)?"  # 1h, 1h30, 1h 30 min
+    r"|(?P<m>[0-9]+)\s*(?:min|m)?"  # 45, 45m, 45 min
+    r"|(?P<hh>[0-9]+):(?P<mm>[0-9]{2}))",  # 1:30
+    re.ASCII,
+)
+
+
+def parse_duration(text):
+    """Minutes for a duration like '45m', '1h30' or '1:30'. Raises ValueError if unclear or zero."""
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"Please enter a duration such as 45, 1h or 1:30 (got {text!r}).")
+
+    if match["h"] is not None:
+        hours, minutes = int(match["h"]), int(match["hm"] or 0)
+    elif match["m"] is not None:
+        hours, minutes = 0, int(match["m"])
+    else:
+        hours, minutes = int(match["hh"]), int(match["mm"])
+
+    if minutes >= 60:
+        raise ValueError(f"Minutes must be below 60, for example 1h30 or 1:30 (got {text!r}).")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"The duration must be more than zero (got {text!r}).")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
