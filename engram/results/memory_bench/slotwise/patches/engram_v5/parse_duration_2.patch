index 0000000..95fe6c5
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,28 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45"), 45)
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("45 min"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("2h15"), 135)
+
+    def test_colon(self):
+        self.assertEqual(parse_duration("1:30"), 90)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M "), 90)
+        self.assertEqual(parse_duration("45 MIN"), 45)
+
+    def test_rejects_empty_zero_and_garbage(self):
+        for text in ["", "   ", "0", "0h", "0:00", "abc", "-5", "1.5h", "1h75", "1:75", "1 hour"]:
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_duration(text)
