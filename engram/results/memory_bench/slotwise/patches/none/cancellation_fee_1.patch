@@ -0,0 +1,33 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_free_with_24_hours_notice(self):
+        a = Appointment("lena", "Kim Weber", START, "standard")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=24)), 0)
+
+    def test_half_price_just_inside_24_hours(self):
+        a = Appointment("lena", "Kim Weber", START, "standard")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=24) + datetime.timedelta(minutes=1)), 4900)
+
+    def test_half_price_rounds_down_to_whole_cents(self):
+        a = Appointment("lena", "Kim Weber", START, "short")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=2)), 3400)
+
+    def test_full_price_at_start(self):
+        a = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(a, START), 14500)
+
+    def test_full_price_after_start(self):
+        a = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(minutes=5)), 14500)
+
+
+if __name__ == "__main__":
+    unittest.main()
