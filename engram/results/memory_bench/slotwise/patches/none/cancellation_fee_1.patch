+"""Cancellation fees."""
+
+import datetime
+
+# Notice a client must give to cancel without a fee.
+FREE_NOTICE = datetime.timedelta(hours=24)
+
+# Share of the appointment price charged for a late cancellation (after FREE_NOTICE, before the start).
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Free with at least FREE_NOTICE before the start; LATE_CANCELLATION_PERCENT of the price
+    inside that window; the full price once the appointment has started.
+    """
+    notice = appointment.start - cancelled_at
+    if notice >= FREE_NOTICE:
+        return 0
+    if notice > datetime.timedelta(0):
+        return appointment.price * LATE_CANCELLATION_PERCENT // 100
+    return appointment.price
