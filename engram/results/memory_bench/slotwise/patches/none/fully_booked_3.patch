 from .model import BOOKED, CANCELLED, TREATMENTS
 
 # Time a therapist needs after each appointment to clean up and write notes.
@@ -66,3 +66,22 @@ class Schedule:
             day: [a for a in self.appointments_for(therapist, day) if a.status != CANCELLED]
             for day in days
         }
+
+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` has no room for even the shortest treatment on `day`. A closed day counts as fully booked."""
+        hours = opening_hours(day)
+        if hours is None:
+            return True
+        opens, closes = hours
+        shortest = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        booked = [a for a in self.appointments_for(therapist, day) if a.status != CANCELLED]
+        # A free gap can only start at opening time or straight after an existing appointment's turnaround.
+        candidates = [opens] + [a.end + TURNAROUND for a in booked]
+        for start in candidates:
+            end = start + shortest
+            if end > closes:
+                continue
+            if any(a.start < end + TURNAROUND and start < a.end + TURNAROUND for a in booked):
+                continue
+            return False
+        return True
