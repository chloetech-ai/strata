+"""Reminder SMS for upcoming appointments."""
+
+from .model import Appointment
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the text of the reminder SMS for `appointment`."""
+    return (
+        f"Hi {appointment.client}, this is a reminder of your physiotherapy appointment "
+        f"with {appointment.therapist.title()} on {appointment.start:%A %d %B} "
+        f"at {appointment.start:%H:%M}. Please call us if you need to cancel or reschedule."
+    )
