@@ -0,0 +1,20 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_client_therapist_and_time(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        self.assertEqual(
+            reminder_text(a),
+            "Hi Kim Weber, this is a reminder of your physiotherapy appointment "
+            "with Lena on Monday 07 September at 09:00. "
+            "Please call us if you need to cancel or reschedule.",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
