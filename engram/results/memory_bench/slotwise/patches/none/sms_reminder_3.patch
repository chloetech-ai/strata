+"""Reminder messages sent to clients before their appointment."""
+
+from .model import Appointment
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the text of the reminder SMS for `appointment`."""
+    return (
+        f"Hi {appointment.client}, this is a reminder of your appointment with "
+        f"{appointment.therapist.title()} on {appointment.start:%A %d %B} at {appointment.start:%H:%M}."
+    )
