@@ -0,0 +1,18 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_therapist_day_and_time(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0))
+        self.assertEqual(
+            reminder_text(a),
+            "Hi Kim Weber, this is a reminder of your appointment with Lena on Monday 07 September at 09:00.",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
