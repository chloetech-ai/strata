+    def test_free_slots_empty_day_runs_from_opening_to_last_fitting_start(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30–19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends exactly at closing
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(isinstance(s, datetime.datetime) for s in slots))
+
+    def test_free_slots_closed_day(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_respect_turnaround_on_both_sides(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00–09:45, blocks the therapist until 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 10 minutes before 09:00 is fine
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # would end at 09:00
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # starts inside the turnaround
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_match_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(12, therapist="marco", client="Jo Li"))
+        for start in s.free_slots("lena", datetime.date(2026, 9, 8), 60):
+            trial = Schedule()
+            trial.appointments = list(s.appointments)
+            trial.book(Appointment("lena", "Jo Li", start, "initial"))  # each offered slot is bookable on its own
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
