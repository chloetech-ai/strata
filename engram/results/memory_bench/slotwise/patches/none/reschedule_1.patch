+    def reschedule(self, appointment_id, new_start):
+        """Moves the appointment to start at `new_start`, keeping its treatment and id.
+
+        Refused with the same rules as `book`, and the appointment is left unchanged if it is refused.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.status == CANCELLED:
+            raise BookingError(
+                f"Appointment {appointment_id} is cancelled and cannot be moved. Please book a new appointment."
+            )
+        self._check(dataclasses.replace(appointment, start=new_start), ignore_id=appointment_id)
+        appointment.start = new_start
+        return appointment
