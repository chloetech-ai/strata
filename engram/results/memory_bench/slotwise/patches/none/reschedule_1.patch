+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(a.treatment, "standard")
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_into_taken_slot_leaves_appointment_unchanged(self):
+        s = Schedule()
+        s.book(at(9))
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # ends 09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 15))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 15))
+
+    def test_reschedule_respects_gap_to_others(self):
+        s = Schedule()
+        s.book(at(9))  # ends 09:45
+        a = s.book(at(12, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 50))
+
+    def test_reschedule_outside_opening_hours_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
