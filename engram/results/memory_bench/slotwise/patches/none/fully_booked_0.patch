+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` has no room for even the shortest treatment on `day`, turnaround included.
+
+        A day the practice is closed is not fully booked, so this returns False for it.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return False
+        opens, closes = hours
+        shortest = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        # Each booked appointment blocks the therapist from TURNAROUND before it to TURNAROUND after it.
+        blocked = [
+            (a.start - TURNAROUND, a.end + TURNAROUND)
+            for a in self.appointments_for(therapist, day)
+            if a.status != CANCELLED
+        ]
+        free_from = opens
+        for start, end in blocked:
+            if free_from + shortest <= start:
+                return False
+            free_from = max(free_from, end)
+        return free_from + shortest > closes
+
