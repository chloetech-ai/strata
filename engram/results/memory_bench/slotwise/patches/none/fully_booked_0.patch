+    def fill_day(self, s, therapist, day):
+        """Book short treatments at every 5-minute start where one fits, so the day ends up packed."""
+        start = datetime.datetime.combine(day, datetime.time(7, 30))
+        while start < datetime.datetime.combine(day, datetime.time(19, 0)):
+            try:
+                s.book(Appointment(therapist, "Kim Weber", start, "short"))
+            except BookingError:
+                pass
+            start += datetime.timedelta(minutes=5)
+
+    def test_packed_day_is_fully_booked(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)  # Tuesday
+        self.fill_day(s, "lena", day)
+        self.assertTrue(len(s.appointments) > 1)
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cancelling_one_frees_the_day(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        self.fill_day(s, "lena", day)
+        s.cancel(s.appointments[len(s.appointments) // 2].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_empty_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_other_therapist_does_not_fill_day(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        self.fill_day(s, "marco", day)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_closed_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 6)))  # Sunday
+
