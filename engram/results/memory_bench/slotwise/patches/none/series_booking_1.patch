new file mode 100644
index 0000000..478f37e
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from slotwise.errors import SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def first(hour=9, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_appointments(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9) for d in (8, 15, 22)],
+        )
+        self.assertEqual(s.appointments, booked)
+        self.assertTrue(all(a.client == "Kim Weber" and a.therapist == "lena" for a in booked))
+        self.assertEqual(len({a.id for a in booked}), 3)
+
+    def test_keeps_treatment(self):
+        s = Schedule()
+        booked = book_series(s, first(treatment="initial"), 2)
+        self.assertEqual([a.treatment for a in booked], ["initial", "initial"])
+
+    def test_refused_occurrence_books_nothing(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        before = list(s.appointments)
+        with self.assertRaises(SlotTaken):
+            book_series(s, first(), 3)
+        self.assertEqual(s.appointments, before)
+
+    def test_count_must_be_positive(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
