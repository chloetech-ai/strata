index 0000000..3483bc0
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,32 @@
+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .model import Appointment
+
+WEEK = datetime.timedelta(days=7)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments starting with `first`, all with the same therapist, client and treatment.
+
+    The series is all or nothing: if any occurrence is refused, the ones already booked are removed and the error is raised.
+    Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise ValueError(f"a series needs at least one appointment, not {count}")
+    booked = []
+    try:
+        for i in range(count):
+            occurrence = Appointment(
+                first.therapist,
+                first.client,
+                first.start + i * WEEK,
+                first.treatment,
+            )
+            booked.append(schedule.book(occurrence))
+    except Exception:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
