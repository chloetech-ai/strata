@@ -0,0 +1,15 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_client_therapist_and_time(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 30), "initial")
+        self.assertEqual(
+            reminder_text(a),
+            "Hello Kim Weber, this is a reminder of your physiotherapy appointment "
+            "with Lena on Tuesday 08 September at 09:30 (60 minutes).",
+        )
