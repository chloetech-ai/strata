+"""Parsing of appointment lengths typed by receptionists."""
+
+import re
+
+# Hours with optional minutes ("1h", "1h30", "1h 30m"), plain minutes ("45", "45m",
+# "45 min"), or clock style ("1:30").
+_DURATION = re.compile(
+    r"(?:(?P<hours>\d+)\s*h\s*(?:(?P<h_minutes>\d+)\s*(?:min|m)?)?)"
+    r"|(?P<minutes>\d+)\s*(?:min|m)?"
+    r"|(?P<clock_hours>\d+):(?P<clock_minutes>\d{1,2})"
+)
+
+
+def parse_duration(text):
+    """Return the length in minutes described by `text`.
+
+    Raises ValueError if the text is not a duration or is zero.
+    """
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match["hours"] is not None:
+        minutes = int(match["h_minutes"] or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes out of range: {text!r}")
+        total = int(match["hours"]) * 60 + minutes
+    elif match["minutes"] is not None:
+        total = int(match["minutes"])
+    else:
+        minutes = int(match["clock_minutes"])
+        if minutes >= 60:
+            raise ValueError(f"minutes out of range: {text!r}")
+        total = int(match["clock_hours"]) * 60 + minutes
+
+    if total == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return total
