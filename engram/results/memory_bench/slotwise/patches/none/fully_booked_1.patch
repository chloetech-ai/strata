+    def is_fully_booked(self, therapist, day):
+        """True if no treatment can be booked with `therapist` on `day` (a date), or the practice is closed that day."""
+        hours = opening_hours(day)
+        if hours is None:
+            return True
+        opens, closes = hours
+        shortest = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        # Each booked appointment blocks the therapist for TURNAROUND either side.
+        blocked = sorted(
+            (a.start - TURNAROUND, a.end + TURNAROUND)
+            for a in self.appointments_for(therapist, day)
+            if a.status != CANCELLED
+        )
+        free_from = opens
+        for block_start, block_end in blocked:
+            if block_start - free_from >= shortest:
+                return False
+            free_from = max(free_from, block_end)
+        return closes - free_from < shortest
+
