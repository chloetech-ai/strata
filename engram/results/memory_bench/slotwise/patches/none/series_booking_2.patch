@@ -0,0 +1,31 @@
+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import BookingError
+from .model import Appointment
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, all with the same therapist, client and treatment.
+
+    Either every appointment is booked or none is: if one of them is refused, the ones already added are removed and the error is raised.
+    Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise ValueError(f"A series needs at least one appointment, not {count}")
+    later = [
+        Appointment(first.therapist, first.client, first.start + i * WEEK, first.treatment)
+        for i in range(1, count)
+    ]
+    booked = []
+    try:
+        for appointment in [first, *later]:
+            booked.append(schedule.book(appointment))
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..a9e6cb6
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,66 @@
+import datetime
+import unittest
+
+from slotwise.errors import OutsideOpeningHours, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def at(day, hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_appointments(self):
+        s = Schedule()
+        booked = book_series(s, at(7, 9), 3)  # Mondays 7, 14, 21 September
+        self.assertEqual([a.start.day for a in booked], [7, 14, 21])
+        self.assertEqual(s.appointments, booked)
+
+    def test_first_is_the_given_appointment(self):
+        s = Schedule()
+        first = at(7, 9)
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+        self.assertIs(s.get(first.id), first)
+
+    def test_copies_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, at(7, 9, therapist="omar", treatment="initial", client="Jo Li"), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("omar", "Jo Li", "initial"))
+
+    def test_appointments_get_distinct_ids(self):
+        s = Schedule()
+        booked = book_series(s, at(7, 9), 3)
+        self.assertEqual(len({a.id for a in booked}), 3)
+
+    def test_count_must_be_positive(self):
+        s = Schedule()
+        with self.assertRaises(ValueError):
+            book_series(s, at(7, 9), 0)
+        self.assertEqual(s.appointments, [])
+
+    def test_clash_books_nothing(self):
+        s = Schedule()
+        s.book(at(14, 9, client="Jo Li"))  # blocks the second week
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(7, 9), 3)
+        self.assertEqual([a.client for a in s.appointments], ["Jo Li"])
+
+    def test_refused_first_appointment_books_nothing(self):
+        s = Schedule()
+        # Saturday 12 September closes at 12:00, so a 45-minute appointment at 11:30 is refused
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(12, 11, 30), 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_other_therapist_does_not_clash(self):
+        s = Schedule()
+        s.book(at(14, 9, therapist="omar"))
+        self.assertEqual(len(book_series(s, at(7, 9), 3)), 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
