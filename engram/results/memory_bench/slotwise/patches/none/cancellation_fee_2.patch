--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,37 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+def appt(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_more_than_24_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(days=2)), 0)
+
+    def test_exactly_24_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=24)), 0)
+
+    def test_inside_24_hours_is_half_price(self):
+        self.assertEqual(cancellation_fee(appt("standard"), START - datetime.timedelta(hours=2)), 4900)
+        self.assertEqual(cancellation_fee(appt("initial"), START - datetime.timedelta(hours=2)), 7250)
+
+    def test_just_inside_24_hours_is_half_price(self):
+        self.assertEqual(
+            cancellation_fee(appt(), START - datetime.timedelta(hours=24) + datetime.timedelta(seconds=1)),
+            4900,
+        )
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt("short"), START), 6800)
+        self.assertEqual(cancellation_fee(appt("short"), START + datetime.timedelta(minutes=5)), 6800)
+
+
+if __name__ == "__main__":
+    unittest.main()
