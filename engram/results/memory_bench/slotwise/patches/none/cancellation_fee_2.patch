+++ b/src/slotwise/fees.py
@@ -0,0 +1,22 @@
+"""Fees charged when an appointment is cancelled."""
+
+import datetime
+
+# Cancelling at least this long before the start is free.
+FREE_CANCELLATION = datetime.timedelta(hours=24)
+# Percentage of the treatment price charged for a late cancellation (inside FREE_CANCELLATION).
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Free if cancelled at least FREE_CANCELLATION before the start, LATE_CANCELLATION_PERCENT
+    of the price if cancelled later but before the start, and the full price once it has started.
+    """
+    price = appointment.price
+    if cancelled_at >= appointment.start:
+        return price
+    if appointment.start - cancelled_at >= FREE_CANCELLATION:
+        return 0
+    return price * LATE_CANCELLATION_PERCENT // 100
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
