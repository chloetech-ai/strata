+"""Parsing of appointment lengths typed by receptionists."""
+
+import re
+
+# '1:30' | '1h', '1h30', '1h 30m' | '45', '45m', '45 min'
+_DURATION = re.compile(
+    r"(?:(?P<ch>\d+):(?P<cm>[0-5]\d))"
+    r"|(?:(?P<hh>\d+)\s*h\s*(?:(?P<hm>[0-5]?\d)\s*(?:m|min)?)?)"
+    r"|(?:(?P<mm>\d+)\s*(?:m|min)?)"
+)
+
+
+def parse_duration(text):
+    """Return the length in minutes described by `text`, e.g. '1h30' -> 90.
+
+    Raises ValueError for empty input, zero, or anything unrecognised.
+    """
+    s = text.strip().lower()
+    if not s:
+        raise ValueError("duration is empty")
+    m = _DURATION.fullmatch(s)
+    if m is None:
+        raise ValueError(f"unrecognised duration: {text!r}")
+    if m["ch"] is not None:
+        hours, minutes = int(m["ch"]), int(m["cm"])
+    elif m["hh"] is not None:
+        hours, minutes = int(m["hh"]), int(m["hm"] or 0)
+    else:
+        hours, minutes = 0, int(m["mm"])
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError("duration must be greater than zero")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
