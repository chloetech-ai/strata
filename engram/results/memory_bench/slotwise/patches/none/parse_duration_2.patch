+"""Parse appointment durations written by hand, e.g. '45', '1h30' or '1:30'."""
+
+import re
+
+# Hours and minutes: '1h', '1h30', '1h 30m'. Hours and colon forms: '1:30'. Bare minutes: '45', '45m', '45 min'.
+_DURATION = re.compile(
+    r"""
+    (?:
+        (?P<h>\d+)\s*h(?:\s*(?P<hm>\d+)\s*(?:min|m)?)?
+      | (?P<hh>\d+):(?P<mm>\d+)
+      | (?P<m>\d+)\s*(?:min|m)?
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+def parse_duration(text):
+    """Return the duration in minutes, e.g. '1h30' -> 90.
+
+    Raises ValueError for unrecognised text, minutes of 60 or more after an hour, or a zero duration.
+    """
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a valid duration: {text!r}")
+
+    if match.group("h") is not None:
+        hours, minutes = int(match.group("h")), int(match.group("hm") or 0)
+    elif match.group("hh") is not None:
+        hours, minutes = int(match.group("hh")), int(match.group("mm"))
+    else:
+        hours, minutes = 0, int(match.group("m"))
+
+    if minutes >= 60 and (match.group("h") is not None or match.group("hh") is not None):
+        raise ValueError(f"minutes must be under 60 when hours are given: {text!r}")
+
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
