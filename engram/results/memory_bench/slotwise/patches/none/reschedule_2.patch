@@ -87,6 +87,48 @@ class ScheduleTest(unittest.TestCase):
         s.book(at(9, client="Jo Li"))
         self.assertEqual(len(s.appointments), 2)
 
+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 15, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 15, 0))
+        self.assertEqual(a.treatment, "standard")
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_can_keep_overlapping_own_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 5))
+
+    def test_reschedule_into_taken_slot_leaves_appointment_unchanged(self):
+        s = Schedule()
+        s.book(at(9))
+        a = s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_outside_opening_hours_leaves_appointment_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 15, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_unknown_id(self):
+        with self.assertRaises(KeyError):
+            Schedule().reschedule(999999, datetime.datetime(2026, 9, 8, 9, 0))
+
     def test_cancel_unknown_id(self):
         with self.assertRaises(KeyError):
             Schedule().cancel(999999)
