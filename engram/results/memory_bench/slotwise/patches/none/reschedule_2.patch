+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to `new_start`, keeping its id and treatment. Checks the same rules as `book`, ignoring the appointment's current slot."""
+        appointment = self.get(appointment_id)
+        if appointment.status == CANCELLED:
+            raise BookingError("This appointment is cancelled. Please book a new appointment instead.")
+        moved = replace(appointment, start=new_start)
+        self._check_slot(moved, ignore=appointment)
+        appointment.start = new_start
+        return appointment
