+    def reschedule(self, appointment_id, new_start):
+        """Moves the appointment to start at `new_start`, keeping its treatment. Refused (and left unchanged) if the new time doesn't fit."""
+        appointment = self.get(appointment_id)
+        if appointment.status == CANCELLED:
+            raise BookingError(f"Appointment {appointment_id} is cancelled and cannot be moved.")
