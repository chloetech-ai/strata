@@ -0,0 +1,20 @@
+"""Cancellation fees."""
+
+import datetime
+
+# Cancelling at least this long before the start is free.
+FREE_NOTICE = datetime.timedelta(hours=24)
+# Share of the price (in percent) charged for a late cancellation, and for a no-show.
+LATE_PERCENT = 50
+NO_SHOW_PERCENT = 100
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`."""
+    if cancelled_at >= appointment.start:
+        percent = NO_SHOW_PERCENT
+    elif appointment.start - cancelled_at >= FREE_NOTICE:
+        return 0
+    else:
+        percent = LATE_PERCENT
+    return appointment.price * percent // 100
