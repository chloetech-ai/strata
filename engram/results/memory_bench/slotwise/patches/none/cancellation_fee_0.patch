@@ -0,0 +1,32 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+def appointment(treatment="standard"):
+    return Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 10, 0), treatment)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_a_day_ahead_is_free(self):
+        a = appointment()
+        self.assertEqual(cancellation_fee(a, a.start - datetime.timedelta(hours=24)), 0)
+
+    def test_less_than_a_day_ahead_is_half_price(self):
+        a = appointment()
+        self.assertEqual(cancellation_fee(a, a.start - datetime.timedelta(hours=23, minutes=59)), 4900)
+
+    def test_half_price_depends_on_treatment(self):
+        a = appointment("initial")
+        self.assertEqual(cancellation_fee(a, a.start - datetime.timedelta(hours=2)), 7250)
+
+    def test_after_start_is_full_price(self):
+        a = appointment("short")
+        self.assertEqual(cancellation_fee(a, a.start), 6800)
+        self.assertEqual(cancellation_fee(a, a.start + datetime.timedelta(minutes=5)), 6800)
+
+
+if __name__ == "__main__":
+    unittest.main()
