+"""Fees for cancelling an appointment late."""
+
+import datetime
+
+# Cancelling at least this long before the start is free.
+FREE_UNTIL = datetime.timedelta(hours=24)
+# Cancelling at least this long before the start costs half the price; later costs the full price.
+HALF_FEE_UNTIL = datetime.timedelta(hours=2)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Free with at least 24 hours' notice, half the price with at least 2 hours' notice,
+    and the full price for anything later, including after the appointment has started.
+    """
+    notice = appointment.start - cancelled_at
+    if notice >= FREE_UNTIL:
+        return 0
+    if notice >= HALF_FEE_UNTIL:
+        return appointment.price // 2
+    return appointment.price
