@@ -0,0 +1,33 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 7, 9, 0)
+
+
+def at(hours_before):
+    return START - datetime.timedelta(hours=hours_before)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_free_with_a_day_notice(self):
+        a = Appointment("lena", "Kim Weber", START, "standard")
+        self.assertEqual(cancellation_fee(a, at(48)), 0)
+        self.assertEqual(cancellation_fee(a, at(24)), 0)
+
+    def test_half_price_with_two_hours_notice(self):
+        a = Appointment("lena", "Kim Weber", START, "initial")
+        self.assertEqual(cancellation_fee(a, at(23)), 7250)
+        self.assertEqual(cancellation_fee(a, at(2)), 7250)
+
+    def test_full_price_under_two_hours_or_after_start(self):
+        a = Appointment("lena", "Kim Weber", START, "standard")
+        self.assertEqual(cancellation_fee(a, at(1)), 9800)
+        self.assertEqual(cancellation_fee(a, START), 9800)
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(hours=1)), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
