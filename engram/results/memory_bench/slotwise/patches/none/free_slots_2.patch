@@ -110,6 +110,38 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 8))
 
+    def test_free_slots_empty_day_runs_from_opening_to_last_fitting_start(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))
+        self.assertEqual(len(slots), 43)
+        self.assertTrue(all(b - a == datetime.timedelta(minutes=15) for a, b in zip(slots, slots[1:])))
+
+    def test_free_slots_respects_booking_and_turnaround(self):
+        s = Schedule()
+        s.book(at(9))  # standard, 09:00-09:45, blocked until 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # first grid start after the 09:55 turnaround
+
+    def test_free_slots_ignores_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(10, therapist="marco", client="Jo Li"))
+        s.cancel(a.id)
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), slots)  # freed by cancelling
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # marco's booking doesn't block lena
+
+    def test_free_slots_stops_at_closing_on_short_day(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 11), 60)  # Friday, closes 17:00
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 11, 16, 0))
+
+    def test_free_slots_closed_day(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 30), [])  # Sunday
+
