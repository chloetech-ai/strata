+"""Text of the reminder SMS sent to clients before their appointment."""
+
+from .model import Appointment
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the reminder SMS for `appointment`, e.g. 'Hi Kim Weber, ... with Lena on Tuesday 08 September at 09:00.'"""
+    return (
+        f"Hi {appointment.client}, this is a reminder of your physiotherapy appointment "
+        f"with {appointment.therapist.title()} on {appointment.start:%A %d %B} "
+        f"at {appointment.start:%H:%M}. See you then."
+    )
