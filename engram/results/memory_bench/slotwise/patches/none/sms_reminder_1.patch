+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_client_therapist_day_and_time(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 0))
+        self.assertEqual(
+            reminder_text(a),
+            "Hi Kim Weber, this is a reminder of your physiotherapy appointment "
+            "with Lena on Tuesday 08 September at 09:00. See you then.",
+        )
+
+    def test_uses_start_time_not_end(self):
+        a = Appointment("tom", "Jo Li", datetime.datetime(2026, 9, 11, 14, 30), "initial")
+        self.assertIn("on Friday 11 September at 14:30.", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
