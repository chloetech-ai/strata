+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertEqual(slots, [
+            datetime.datetime(2026, 9, 8, 7, 30),
+            datetime.datetime(2026, 9, 8, 7, 45),
+            datetime.datetime(2026, 9, 8, 8, 0),
+            *[datetime.datetime(2026, 9, 8, 10, 0) + i * datetime.timedelta(minutes=15) for i in range(34)],
+        ])
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))
+
