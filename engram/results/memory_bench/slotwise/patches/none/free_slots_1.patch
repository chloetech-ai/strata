+    def test_free_slots_on_empty_day_fit_before_closing(self):
+        # Tuesday 07:30–19:00: a 45-minute appointment can start as late as 18:15.
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))
+        self.assertEqual(len(slots), 44)
+        self.assertTrue(all(b - a == datetime.timedelta(minutes=15) for a, b in zip(slots, slots[1:])))
+
+    def test_free_slots_closed_day(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 6), 45), [])  # Sunday
+
+    def test_free_slots_short_day(self):
+        # Saturday 08:00–12:00: a 60-minute appointment can start up to 11:00.
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 12), 60)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 12, 8, 0))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 0))
+        self.assertEqual(len(slots), 13)
+
+    def test_free_slots_respect_booking_and_turnaround(self):
