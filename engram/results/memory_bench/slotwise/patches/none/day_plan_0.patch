@@ -0,0 +1,50 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    start = datetime.datetime.combine(MONDAY, datetime.time(hour, minute))
+    return Appointment(therapist, client, start, treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_by_start_time(self):
+        s = Schedule()
+        s.book(at(11, client="Jo Li", treatment="short"))
+        s.book(at(9, treatment="initial"))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Lena — Monday 07 September 2026\n"
+            "\n"
+            "09:00–10:00  Kim Weber  initial (60 min)\n"
+            "11:00–11:30  Jo Li  short (30 min)\n",
+        )
+
+    def test_leaves_out_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(10, client="Jo Li"))
+        s.cancel(a.id)
+        self.assertIn("Jo Li", day_plan(s, "lena", MONDAY))
+        self.assertNotIn("Kim Weber", day_plan(s, "lena", MONDAY))
+
+    def test_only_this_therapist(self):
+        s = Schedule()
+        s.book(at(9, therapist="max"))
+        self.assertEqual(day_plan(s, "lena", MONDAY).splitlines()[-1], "No appointments.")
+
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(Schedule(), "lena", MONDAY),
+            "Lena — Monday 07 September 2026\n\nNo appointments.\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
