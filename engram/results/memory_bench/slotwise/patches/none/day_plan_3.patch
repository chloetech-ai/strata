@@ -0,0 +1,38 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Lena – Monday 07 September 2026\n"
+            "\n"
+            "09:00–09:45  Kim Weber  standard (45 min)\n"
+            "10:00–10:30  Jo Li  short (30 min)",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(11, therapist="marc"))
+        self.assertEqual(day_plan(s, "lena", MONDAY).splitlines()[-1], "No appointments.")
+
+    def test_other_days_are_left_out(self):
+        s = Schedule()
+        s.book(at(9))
+        self.assertEqual(day_plan(s, "lena", MONDAY + datetime.timedelta(days=1)).splitlines()[-1], "No appointments.")
