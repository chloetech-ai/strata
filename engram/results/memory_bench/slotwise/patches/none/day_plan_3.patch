+"""Printable documents for the reception desk."""
+
+from .model import CANCELLED
+
+
+def day_plan(schedule, therapist, day):
+    """Text listing `therapist`'s booked appointments on `day`, by start time, for printing.
+
+    Cancelled appointments are left out.
+    """
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    lines = [f"{therapist.title()} – {day:%A %d %B %Y}", ""]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}–{a.end:%H:%M}  {a.client}  {a.treatment} ({a.minutes} min)")
+    return "\n".join(lines)
