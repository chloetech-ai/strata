+    def is_fully_booked(self, therapist, day):
+        """True if no treatment at all could be booked for `therapist` on `day`. A closed day counts as fully booked."""
+        hours = opening_hours(day)
+        if hours is None:
+            return True
+        shortest = min(TREATMENTS, key=lambda t: TREATMENTS[t][0])
+        # The earliest free start in any gap is either opening time or just after a turnaround.
+        candidates = [hours[0]] + [
+            a.end + TURNAROUND
+            for a in self.appointments_for(therapist, day)
+            if a.status != CANCELLED
+        ]
+        for start in sorted(candidates):
+            try:
