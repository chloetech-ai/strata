     return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
 
+SATURDAY = datetime.date(2026, 9, 12)
+# Standard appointments every 55 minutes fill 08:00-12:00 with only 10-minute gaps.
+PACKED_SATURDAY = [(8, 0), (8, 55), (9, 50), (10, 45)]
+
+
+def saturday(hour, minute=0):
+    return Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute))
+
 
