+    def test_is_fully_booked_empty_day(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_is_fully_booked_closed_day(self):
+        self.assertTrue(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 6)))  # Sunday
+
+    def test_is_fully_booked_when_no_gap_fits_shortest_treatment(self):
+        s = Schedule()
+        for hour, minute in PACKED_SATURDAY:
+            s.book(saturday(hour, minute))
+        self.assertTrue(s.is_fully_booked("lena", SATURDAY))
+
+    def test_is_not_fully_booked_when_a_gap_fits_a_treatment(self):
+        s = Schedule()
+        s.book(saturday(8, 0))
+        s.book(saturday(8, 55))  # 09:40 onward is free
+        self.assertFalse(s.is_fully_booked("lena", SATURDAY))
+
+    def test_cancelled_appointment_frees_its_slot(self):
+        s = Schedule()
+        packed = [s.book(saturday(hour, minute)) for hour, minute in PACKED_SATURDAY]
+        self.assertTrue(s.is_fully_booked("lena", SATURDAY))
+        s.cancel(packed[-1].id)
+        self.assertFalse(s.is_fully_booked("lena", SATURDAY))
+
+    def test_is_fully_booked_is_per_therapist(self):
+        s = Schedule()
+        for hour, minute in PACKED_SATURDAY:
+            s.book(saturday(hour, minute))
