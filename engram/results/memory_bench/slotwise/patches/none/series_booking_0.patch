+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import BookingError
+from .model import Appointment
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments for the same therapist, client and treatment, starting with `first`.
+
+    Either the whole series is booked or none of it is: if any appointment is refused, the ones already
+    added are removed again and the error is raised. Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise ValueError("a series needs at least one appointment")
+    booked = []
+    try:
+        booked.append(schedule.book(first))
+        for i in range(1, count):
+            start = first.start + datetime.timedelta(weeks=i)
+            booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
