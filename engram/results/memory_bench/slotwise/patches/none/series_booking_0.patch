+import datetime
+import unittest
+
+from slotwise.errors import SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber", day=8):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_appointments_and_returns_them(self):
+        s = Schedule()
+        booked = book_series(s, at(9, treatment="initial"), 3)
+        self.assertEqual([a.start.date() for a in booked], [datetime.date(2026, 9, d) for d in (8, 15, 22)])
+        self.assertEqual([a.start.hour for a in booked], [9, 9, 9])
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("lena", "Kim Weber", "initial")})
+        self.assertEqual(s.appointments, booked)
+
+    def test_first_appointment_is_booked_itself(self):
+        s = Schedule()
+        first = at(9)
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+        self.assertIs(s.get(first.id), first)
+
+    def test_each_appointment_gets_its_own_id(self):
+        booked = book_series(Schedule(), at(9), 3)
+        self.assertEqual(len({a.id for a in booked}), 3)
+
+    def test_count_of_one_books_just_the_first(self):
+        s = Schedule()
+        booked = book_series(s, at(9), 1)
+        self.assertEqual(len(booked), 1)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_count_below_one_is_rejected(self):
+        s = Schedule()
+        with self.assertRaises(ValueError):
+            book_series(s, at(9), 0)
+        self.assertEqual(s.appointments, [])
+
+    def test_conflict_later_in_series_books_nothing(self):
+        s = Schedule()
+        s.book(at(9, day=22, client="Jo Li"))  # third week of the series
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(9), 4)
+        self.assertEqual([a.client for a in s.appointments], ["Jo Li"])
+
+    def test_leaves_existing_appointments_alone_on_rollback(self):
+        s = Schedule()
+        existing = s.book(at(9, day=15, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(9), 2)
+        self.assertEqual(s.appointments, [existing])
+
+
+if __name__ == "__main__":
+    unittest.main()
