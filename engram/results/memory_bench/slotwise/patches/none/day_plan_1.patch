+"""Printable documents for reception."""
+
+from .model import CANCELLED
+
+
+def day_plan(schedule, therapist, day):
+    """Text day plan for `therapist` on `day` (a date), listing booked appointments in start order.
+
+    Cancelled appointments are left out, as they no longer take up the therapist's time.
+    """
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    lines = [f"{therapist.title()} — {day:%A %d %B %Y}", ""]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}–{a.end:%H:%M}  {a.client}  ({a.treatment})")
+    return "\n".join(lines) + "\n"
