+"""Parsing of appointment durations typed by staff, e.g. '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTE_UNIT = r"(?:m|min|mins|minutes)"
+
+_PATTERN = re.compile(
+    rf"(?:(?P<hours>[0-9]+)\s*h\s*(?:(?P<h_minutes>[0-9]+)\s*{_MINUTE_UNIT}?)?"
+    r"|(?P<c_hours>[0-9]+):(?P<c_minutes>[0-9]{1,2})"
+    rf"|(?P<minutes>[0-9]+)\s*{_MINUTE_UNIT}?)"
+)
+
+
+def parse_duration(text):
+    """Return the duration in minutes, e.g. '1h30' -> 90. Raises ValueError if unparseable or zero."""
+    match = _PATTERN.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    if match["hours"] is not None:
+        minutes = int(match["h_minutes"] or 0)
+        if minutes >= 60:
+            raise ValueError(f"invalid duration: {text!r}")
+        total = int(match["hours"]) * 60 + minutes
+    elif match["c_hours"] is not None:
+        minutes = int(match["c_minutes"])
+        if minutes >= 60:
+            raise ValueError(f"invalid duration: {text!r}")
+        total = int(match["c_hours"]) * 60 + minutes
+    else:
+        total = int(match["minutes"])
+
+    if total == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..4c9f576
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,34 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_formats(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_empty_zero_and_invalid(self):
+        for text in ["", "   ", "0", "0h", "0:00", "abc", "-5", "1h60", "1:75", "1.5h", "45 seconds"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
