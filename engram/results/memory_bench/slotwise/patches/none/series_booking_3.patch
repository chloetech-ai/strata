@@ -0,0 +1,31 @@
+"""Booking a series of weekly appointments."""
+
+import datetime
+
+from .errors import BookingError
+from .model import Appointment
+from .schedule import Schedule
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` appointments a week apart, starting with `first`, and returns them.
+
+    Every appointment after `first` has the same therapist, client and treatment, one week later than the one before.
+    The series is all or nothing: if any appointment is refused, the ones already booked are removed and the
+    BookingError is raised.
+    """
+    if count < 1:
+        raise ValueError(f"a series needs at least one appointment, not {count}")
+    booked = []
+    try:
+        booked.append(schedule.book(first))
+        for i in range(1, count):
+            appointment = Appointment(first.therapist, first.client, first.start + i * WEEK, first.treatment)
+            booked.append(schedule.book(appointment))
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..f7a6de4
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,74 @@
+import datetime
+import unittest
+
+from slotwise.errors import OutsideOpeningHours, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber", day=8):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_appointments(self):
+        s = Schedule()
+        booked = book_series(s, at(9), 3)
+        self.assertEqual([a.start for a in booked], [
+            datetime.datetime(2026, 9, 8, 9),
+            datetime.datetime(2026, 9, 15, 9),
+            datetime.datetime(2026, 9, 22, 9),
+        ])
+        self.assertEqual(s.appointments, booked)
+
+    def test_repeats_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, at(9, therapist="marco", treatment="initial", client="Jo Li"), 2)
+        for a in booked:
+            self.assertEqual((a.therapist, a.client, a.treatment), ("marco", "Jo Li", "initial"))
+
+    def test_first_is_the_first_booked_appointment(self):
+        s = Schedule()
+        first = at(9)
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+
+    def test_count_one_books_just_first(self):
+        s = Schedule()
+        booked = book_series(s, at(9), 1)
+        self.assertEqual(len(booked), 1)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_count_below_one_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(ValueError):
+            book_series(s, at(9), 0)
+        self.assertEqual(s.appointments, [])
+
+    def test_clash_in_a_later_week_books_nothing(self):
+        s = Schedule()
+        s.book(at(9, 0, client="Jo Li", day=15))  # blocks the second week
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(9), 3)
+        self.assertEqual([a.client for a in s.appointments], ["Jo Li"])
+
+    def test_closed_day_in_series_books_nothing(self):
+        s = Schedule()
+        # 6 Sep 2026 is a Sunday, when the practice is closed.
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(9, day=6), 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_other_appointments_are_kept_when_series_fails(self):
+        s = Schedule()
+        other = s.book(at(9, 0, therapist="marco", client="Jo Li", day=8))
+        s.book(at(9, 0, client="Ann Roth", day=22))
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(9), 3)
+        self.assertEqual(s.appointments[0], other)
+        self.assertEqual([a.client for a in s.appointments], ["Jo Li", "Ann Roth"])
+
+
+if __name__ == "__main__":
+    unittest.main()
