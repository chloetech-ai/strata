+"""Parsing of appointment lengths typed by receptionists."""
+
+import re
+
+# "45", "45m", "45 min", "1h", "1h30", "1h 30m", "2h15", "1:30"
+_DURATION = re.compile(
+    r"""
+    (?:
+        (?P<hours>\d+)\s*h(?:\s*(?P<h_minutes>\d+)\s*(?:m|min|mins|minutes)?)?
+      | (?P<clock_hours>\d+):(?P<clock_minutes>\d{2})
+      | (?P<minutes>\d+)\s*(?:m|min|mins|minutes)?
+    )
+    """,
+    re.VERBOSE,
+)
+
+
+def parse_duration(text):
+    """Return the number of minutes in `text`. Raises ValueError if it is not a positive duration."""
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match.group("hours") is not None:
+        hours = int(match.group("hours"))
+        minutes = int(match.group("h_minutes") or 0)
+    elif match.group("clock_hours") is not None:
+        hours = int(match.group("clock_hours"))
+        minutes = int(match.group("clock_minutes"))
+    else:
+        hours, minutes = 0, int(match.group("minutes"))
+
+    if minutes >= 60:
+        raise ValueError(f"minutes must be under 60: {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
