diff --git a/src/slotwise/fees.py b/src/slotwise/fees.py
new file mode 100644
index 0000000..b28ab40
--- /dev/null
+++ b/src/slotwise/fees.py
@@ -0,0 +1,20 @@
+"""Cancellation fees, worked out from how long before the appointment it was cancelled."""
+
+import datetime
+
+HALF_FEE_WITHIN = datetime.timedelta(hours=48)
+FULL_FEE_WITHIN = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before the start the full price is charged, less than 48 hours
+    half of it (rounded down to whole cents), and 48 hours or more before the start nothing.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < FULL_FEE_WITHIN:
+        return appointment.price
+    if notice < HALF_FEE_WITHIN:
+        return appointment.price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..37816a9
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,46 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import TREATMENTS, Appointment
+
+START = datetime.datetime(2026, 9, 7, 9, 0)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.appointment = Appointment("lena", "Kim Weber", START, "initial")  # 14500 cents
+
+    def fee_before(self, notice):
+        return cancellation_fee(self.appointment, START - notice)
+
+    def test_free_with_48_hours_or_more_notice(self):
+        self.assertEqual(self.fee_before(datetime.timedelta(hours=72)), 0)
+        self.assertEqual(self.fee_before(datetime.timedelta(hours=48)), 0)
+
+    def test_half_price_under_48_hours(self):
+        self.assertEqual(self.fee_before(datetime.timedelta(hours=48, minutes=-1)), 7250)
+        self.assertEqual(self.fee_before(datetime.timedelta(hours=24)), 7250)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(self.fee_before(datetime.timedelta(hours=24, minutes=-1)), 14500)
+        self.assertEqual(self.fee_before(datetime.timedelta(hours=1)), 14500)
+
+    def test_full_price_after_the_start(self):
+        self.assertEqual(self.fee_before(datetime.timedelta(hours=-2)), 14500)
+
+    def test_half_price_rounds_odd_cents_down(self):
+        with mock.patch.dict(TREATMENTS, {"odd": (30, 6801)}):
+            appointment = Appointment("lena", "Kim Weber", START, "odd")
+            fee = cancellation_fee(appointment, START - datetime.timedelta(hours=30))
+        self.assertEqual(fee, 3400)
+
+    def test_fee_uses_the_price_of_the_treatment(self):
+        appointment = Appointment("lena", "Kim Weber", START, "short")
+        fee = cancellation_fee(appointment, START - datetime.timedelta(hours=1))
+        self.assertEqual(fee, TREATMENTS["short"][1])
+
+
+if __name__ == "__main__":
+    unittest.main()
