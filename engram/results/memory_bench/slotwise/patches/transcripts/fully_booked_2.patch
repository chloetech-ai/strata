+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` has no room left on `day` for even the shortest treatment, buffers included.
+
+        A closed day is not fully booked, it is closed. Cancelled appointments leave their time free.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return False
+        opens, closes = hours
+        needed = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        busy = [a for a in self.appointments_for(therapist, day) if a.status != CANCELLED]
+        free_from = opens
+        for a in busy:
+            # A new appointment must end BUFFER before `a` starts.
+            if free_from + needed <= a.start - BUFFER:
+                return False
+            free_from = max(free_from, a.end + BUFFER)
+        return free_from + needed > closes
+
