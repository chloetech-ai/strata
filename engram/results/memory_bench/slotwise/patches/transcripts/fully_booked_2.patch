+    def test_empty_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_closed_day_is_not_fully_booked(self):
+        self.assertFalse(Schedule().is_fully_booked("lena", datetime.date(2026, 9, 13)))
+
+    def test_day_with_no_room_for_shortest_treatment_is_fully_booked(self):
+        # Saturday opens 08:00 and closes 12:00. The 60-minute sessions with buffers reach 11:20; a 30-minute one from 11:30 ends at 12:00.
+        s = Schedule()
+        for hour, minute in [(8, 0), (9, 10), (10, 20)]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), "initial"))
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, 11, 30), "short"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+
+    def test_gap_that_fits_shortest_treatment_with_buffers_is_not_full(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, 8, 0), "initial"))
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, 10, 20), "initial"))
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, 11, 30), "short"))
+        # 09:00-10:20 is free: 09:10-09:40 plus 10 minutes' buffer still ends before 10:20.
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+
+    def test_cancelled_appointment_frees_its_time(self):
+        s = Schedule()
+        for hour, minute in [(8, 0), (9, 10), (10, 20)]:
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, hour, minute), "initial"))
+        full = s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, 11, 30), "short"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+        s.cancel(full.id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
+
+    def test_other_therapist_does_not_fill_my_day(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Kim Weber", datetime.datetime(2026, 9, 12, 8, 0), "initial"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 12)))
