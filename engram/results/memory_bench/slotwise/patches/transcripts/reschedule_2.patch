     def book(self, appointment):
         """Adds `appointment` if the practice is open and the therapist is free, with BUFFER either side."""
+        self._check(appointment)
+        self.appointments.append(appointment)
+        return appointment
+
+    def reschedule(self, appointment_id, new_start):
+        """Moves a booked appointment to `new_start`, keeping its length. Checks the new time like `book`.
+
+        If the new time is refused, the appointment stays where it was.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.status == CANCELLED:
+            raise BookingError(f"Appointment {appointment_id} is cancelled. Book a new appointment instead.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check(moved, replacing=appointment)
+        appointment.start = new_start
+        return appointment
+
+    def _check(self, appointment, replacing=None):
+        """Raises a BookingError if `appointment` cannot go in. `replacing` is ignored as an existing booking."""
         if appointment.treatment not in TREATMENTS:
             choices = ", ".join(sorted(TREATMENTS))
             raise BookingError(f"Unknown treatment {appointment.treatment!r}. Choose one of: {choices}.")
