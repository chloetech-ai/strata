@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0, client="Kim Weber", treatment="standard", therapist="lena"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 7, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_by_start_time(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li", treatment="initial"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", MONDAY),
+            "Day plan Monday 07.09.2026\n"
+            "Therapist: lena\n"
+            "------------------------------------------\n"
+            "09:00-09:45  Standard\n"
+            "  Kim Weber\n"
+            "10:00-11:00  Initial\n"
+            "  Jo Li\n"
+            "------------------------------------------\n",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(10, client="Jo Li", therapist="marc"))
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+    def test_no_line_is_wider_than_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maximiliane Friederike von Hohenstein-Schwarzenberg", treatment="initial"))
+        plan = day_plan(s, "lena", MONDAY)
+        self.assertTrue(all(len(line) <= WIDTH for line in plan.splitlines()))
+        self.assertIn("Maximiliane Friederike von Hohenstein-", plan)
+        self.assertIn("Schwarzenberg", plan)
+
+
+if __name__ == "__main__":
+    unittest.main()
