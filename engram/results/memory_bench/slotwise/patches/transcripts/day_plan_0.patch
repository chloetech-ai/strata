+"""Printable day plans for the reception's receipt printer."""
+
+import textwrap
+
+from .model import CANCELLED
+
+# The receipt printer prints 42 characters a line; longer lines wrap into a mess.
+WIDTH = 42
+RULE = "-" * WIDTH
+
+
+def _wrapped(text, indent=""):
+    """`text` wrapped to the printer width, continuation lines indented by `indent`."""
+    return textwrap.wrap(text, width=WIDTH, initial_indent=indent, subsequent_indent=indent) or [indent.rstrip()]
+
+
+def day_plan(schedule, therapist, day):
+    """The day plan for `therapist` on `day` as text, at most WIDTH characters a line.
+
+    Lists the booked appointments by start time, leaving out cancelled ones. Client names
+    and treatment labels wrap onto further lines rather than being cut off.
+    """
+    lines = [*_wrapped(f"Day plan {day:%A %d.%m.%Y}"), *_wrapped(f"Therapist: {therapist}"), RULE]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.treatment.capitalize()}")
+        lines.extend(_wrapped(a.client, indent="  "))
+    lines.append(RULE)
+    return "\n".join(lines) + "\n"
