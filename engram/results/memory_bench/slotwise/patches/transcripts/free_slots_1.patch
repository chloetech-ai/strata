+    def test_free_slots_empty_day_starts_at_opening_on_grid(self):
+        monday = datetime.date(2026, 9, 7)
+        slots = Schedule().free_slots("lena", monday, 60)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 7, 7, 30))
+        self.assertEqual(slots[1], datetime.datetime(2026, 9, 7, 7, 45))
+        # last 60-minute start on a 19:00 close is 18:00
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 7, 18, 0))
+        self.assertEqual(len(slots), (18 * 60 - 7 * 60 - 30) // 15 + 1)
