+    def _clash(self, therapist, start, end):
+        """The first non-cancelled appointment of `therapist` too close to [start, end), or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.status == CANCELLED:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which a `minutes`-long appointment for `therapist` could be booked.
+
+        Starts are every 15 minutes from opening time, and the appointment must end by closing time.
+        Each one respects the same BUFFER rule as `book`. Empty if the practice is closed that day.
+        """
+        if minutes < 1:
+            raise ValueError("An appointment needs at least one minute.")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
