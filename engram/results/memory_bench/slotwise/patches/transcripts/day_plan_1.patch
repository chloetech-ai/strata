--- /dev/null
+++ b/src/slotwise/printing.py
@@ -0,0 +1,31 @@
+"""Printable day plan for reception. The receipt printer fits 42 characters a line."""
+
+import textwrap
+
+from .model import CANCELLED
+from .reminders import to_ascii
+
+LINE_WIDTH = 42
+
+
+def _wrap(text, indent=""):
+    """`text` as lines no longer than LINE_WIDTH, continuation lines indented the same as the first."""
+    lines = textwrap.wrap(to_ascii(text), width=LINE_WIDTH, initial_indent=indent, subsequent_indent=indent)
+    return lines or [indent.rstrip()]
+
+
+def day_plan(schedule, therapist, day):
+    """Text of `therapist`'s appointments on `day` (a date), ready to print.
+
+    Cancelled appointments are left out. Long names wrap onto more lines rather than being cut off.
+    Every line is at most LINE_WIDTH characters and plain ASCII.
+    """
+    lines = _wrap(f"Day plan: {therapist}") + _wrap(f"{day:%d.%m.%Y}") + [""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    if not appointments:
+        lines += _wrap("No appointments.")
+    for a in appointments:
+        lines += _wrap(f"{a.start:%H:%M}-{a.end:%H:%M} {a.treatment}")
+        lines += _wrap(a.client, indent="  ")
+        lines.append("")
+    return "\n".join(lines).rstrip() + "\n"
diff --git a/tests/test_printing.py b/tests/test_printing.py
new file mode 100644
index 0000000..7748876
--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,57 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+class DayPlanTest(unittest.TestCase):
+    def setUp(self):
+        self.schedule = Schedule()
+
+    def test_lists_the_day_in_time_order(self):
+        self.schedule.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 10, 0), "short"))
+        self.schedule.book(Appointment("lena", "Ana Gross", datetime.datetime(2026, 9, 7, 9, 0)))
+        self.assertEqual(
+            day_plan(self.schedule, "lena", MONDAY),
+            "Day plan: lena\n"
+            "07.09.2026\n"
+            "\n"
+            "09:00-09:45 standard\n"
+            "  Ana Gross\n"
+            "\n"
+            "10:00-10:30 short\n"
+            "  Kim Weber\n",
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        cancelled = self.schedule.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0)))
+        self.schedule.cancel(cancelled.id)
+        self.schedule.book(Appointment("tom", "Ana Gross", datetime.datetime(2026, 9, 7, 11, 0)))
+        self.assertIn("No appointments.", day_plan(self.schedule, "lena", MONDAY))
+        self.assertNotIn("Kim", day_plan(self.schedule, "lena", MONDAY))
+
+    def test_empty_day(self):
+        self.assertEqual(day_plan(self.schedule, "lena", MONDAY), "Day plan: lena\n07.09.2026\n\nNo appointments.\n")
+
+    def test_long_names_wrap_and_no_line_exceeds_the_printer_width(self):
+        long_name = "Maria-Elisabeth Schwarzenbach-Oberholzer von Wattenwyl Hochstrasse"
+        self.schedule.book(Appointment("lena", long_name, datetime.datetime(2026, 9, 7, 9, 0)))
+        text = day_plan(self.schedule, "lena", MONDAY)
+        for line in text.splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+        self.assertIn("Maria-Elisabeth", text)
+        self.assertIn("Hochstrasse", text)
+
+    def test_output_is_plain_ascii(self):
+        self.schedule.book(Appointment("lena", "Müller Zoë", datetime.datetime(2026, 9, 7, 9, 0)))
+        text = day_plan(self.schedule, "lena", MONDAY)
+        self.assertTrue(text.isascii())
+        self.assertIn("Mueller Zoe", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
