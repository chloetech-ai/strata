+"""Printable day plan for reception. The receipt printer fits 42 characters a line."""
+
+import textwrap
+
+from .model import CANCELLED
+
+LINE_WIDTH = 42
+
+
+def _wrap(text, indent=""):
+    return textwrap.wrap(text, width=LINE_WIDTH, subsequent_indent=indent)
+
+
+def day_plan(schedule, therapist, day):
+    """Text of `therapist`'s booked appointments on `day`, by start time. Cancelled ones are left out.
+
+    No line is longer than 42 characters: long client names and treatments wrap onto indented lines.
+    """
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    lines = _wrap(f"Day plan {therapist}, {day:%a %d.%m.%Y}")
+    if not appointments:
+        lines += _wrap("No appointments.")
+    for a in appointments:
+        lines += _wrap(f"{a.start:%H:%M}-{a.end:%H:%M} {a.client}, {a.treatment}", indent="      ")
+    return "\n".join(lines)
