@@ -0,0 +1,54 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+class DayPlanTest(unittest.TestCase):
+    def setUp(self):
+        self.schedule = Schedule()
+
+    def test_lists_appointments_by_start_time(self):
+        self.schedule.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 10, 0), "short"))
+        self.schedule.book(Appointment("lena", "Ana Brun", datetime.datetime(2026, 9, 7, 8, 0)))
+        self.assertEqual(
+            day_plan(self.schedule, "lena", MONDAY),
+            "Day plan lena, Mon 07.09.2026\n"
+            "08:00-08:45 Ana Brun, standard\n"
+            "10:00-10:30 Kim Weber, short",
+        )
+
+    def test_cancelled_appointments_are_left_out(self):
+        booked = self.schedule.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 8, 0)))
+        self.schedule.book(Appointment("lena", "Ana Brun", datetime.datetime(2026, 9, 7, 10, 0)))
+        self.schedule.cancel(booked.id)
+        self.assertNotIn("Kim Weber", day_plan(self.schedule, "lena", MONDAY))
+
+    def test_other_therapists_and_days_are_left_out(self):
+        self.schedule.book(Appointment("max", "Kim Weber", datetime.datetime(2026, 9, 7, 8, 0)))
+        self.schedule.book(Appointment("lena", "Ana Brun", datetime.datetime(2026, 9, 8, 8, 0)))
+        self.assertEqual(day_plan(self.schedule, "lena", MONDAY), "Day plan lena, Mon 07.09.2026\nNo appointments.")
+
+    def test_no_line_exceeds_the_printer_width(self):
+        self.schedule.book(
+            Appointment(
+                "lena",
+                "Maria-Theresia Oberholzer-Tschudi-Müller von Steinberg-Schwarzenbach",
+                datetime.datetime(2026, 9, 7, 8, 0),
+                "initial",
+            )
+        )
+        text = day_plan(self.schedule, "lena", MONDAY)
+        for line in text.splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+        self.assertIn("Tschudi-Müller", text)
+        self.assertIn("Schwarzenbach", text)
+        self.assertIn("initial", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
