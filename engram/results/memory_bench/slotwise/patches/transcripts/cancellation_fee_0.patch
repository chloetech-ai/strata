@@ -0,0 +1,47 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+def appt(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+def before(hours):
+    return START - datetime.timedelta(hours=hours)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_more_than_48_hours_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), before(72)), 0)
+
+    def test_exactly_48_hours_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), before(48)), 0)
+
+    def test_just_under_48_hours_is_half(self):
+        a = appt()
+        self.assertEqual(cancellation_fee(a, before(48) + datetime.timedelta(minutes=1)), a.price // 2)
+
+    def test_exactly_24_hours_is_half(self):
+        a = appt()
+        self.assertEqual(cancellation_fee(a, before(24)), a.price // 2)
+
+    def test_just_under_24_hours_is_full(self):
+        a = appt()
+        self.assertEqual(cancellation_fee(a, before(24) + datetime.timedelta(minutes=1)), a.price)
+
+    def test_after_start_is_full(self):
+        a = appt()
+        self.assertEqual(cancellation_fee(a, before(-1)), a.price)
+
+    def test_half_fee_uses_the_treatment_price(self):
+        self.assertEqual(cancellation_fee(appt("initial"), before(30)), 7250)
+        self.assertEqual(cancellation_fee(appt("short"), before(30)), 3400)
+
+
+if __name__ == "__main__":
+    unittest.main()
