+        duration = datetime.timedelta(minutes=min(minutes for minutes, _ in TREATMENTS.values()))
+        # A free start is either opening time or the moment a booking's buffer ends, so only those need checking.
+        mine = [a for a in self.appointments_for(therapist, day) if a.status != CANCELLED]
+        candidates = [hours[0]] + [a.end + BUFFER for a in mine]
+        return not any(
