+    def free_slots(self, therapist, day, minutes):
+        """Start times on a 15-minute grid from opening time at which an appointment of `minutes` could be booked.
+
+        Uses the same rules as `book`: it must end before closing and keep BUFFER from other appointments.
+        Returns an empty list if the practice is closed on `day`.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clash(self, therapist, start, end):
+        """The live appointment of `therapist` that a booking from `start` to `end` would clash with, BUFFER included, or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.status == CANCELLED:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
