+++ b/tests/test_fees.py
@@ -0,0 +1,43 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 10, 0)
+
+
+def appt(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+def before(**delta):
+    return START - datetime.timedelta(**delta)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_more_than_48_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), before(days=3)), 0)
+
+    def test_exactly_48_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=48)), 0)
+
+    def test_just_under_48_hours_is_half_price(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=47, minutes=59)), 4900)
+
+    def test_exactly_24_hours_ahead_is_half_price(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=24)), 4900)
+
+    def test_just_under_24_hours_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=23, minutes=59)), 9800)
+
+    def test_after_the_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), START + datetime.timedelta(minutes=5)), 9800)
+
+    def test_fee_uses_the_treatment_price(self):
+        self.assertEqual(cancellation_fee(appt("initial"), before(hours=1)), 14500)
+        self.assertEqual(cancellation_fee(appt("short"), before(hours=30)), 3400)
+
+
+if __name__ == "__main__":
+    unittest.main()
