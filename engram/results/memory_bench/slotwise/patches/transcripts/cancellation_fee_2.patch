+"""Cancellation fees: how much a client pays for cancelling an appointment."""
+
+import datetime
+
+FULL_FEE_WITHIN = datetime.timedelta(hours=24)
+HALF_FEE_WITHIN = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before the start: the full price.
+    Less than 48 hours before the start: half the price, rounded down to whole cents.
+    Otherwise: free. Exactly 24 hours before is half, exactly 48 hours before is free.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < FULL_FEE_WITHIN:
+        return appointment.price
+    if notice < HALF_FEE_WITHIN:
+        return appointment.price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
