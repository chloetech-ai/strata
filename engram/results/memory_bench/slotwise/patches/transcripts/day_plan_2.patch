+"""Printable day plan for reception. The receipt printer fits 42 characters a line."""
+
+import textwrap
+
+from .model import CANCELLED
+
+LINE_WIDTH = 42
+
+
+def _lines(text, indent=""):
+    """`text` wrapped to LINE_WIDTH, every line starting with `indent`. Long words are broken so nothing overflows."""
+    return textwrap.wrap(
+        text,
+        LINE_WIDTH,
+        initial_indent=indent,
+        subsequent_indent=indent,
+        break_long_words=True,
+        break_on_hyphens=False,
+    )
+
+
+def day_plan(schedule, therapist, day):
+    """The day plan for `therapist` on `day` as printable text, one line per row, no line over 42 characters.
+
+    Each appointment is a time-and-treatment line followed by the client's name, wrapped if it is long.
+    Cancelled appointments are left out.
+    """
+    lines = _lines(f"Day plan: {therapist}") + _lines(f"{day:%A %d.%m.%Y}")
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(f"{a.start:%H:%M}-{a.end:%H:%M}  {a.treatment}")
+        lines += _lines(a.client, indent="  ")
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_printing.py b/tests/test_printing.py
