@@ -0,0 +1,58 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime.combine(DAY, datetime.time(hour, minute)), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        s = Schedule()
+        s.book(at(10, 30, client="Jo Li", treatment="short"))
+        s.book(at(9))
+        self.assertEqual(
+            day_plan(s, "lena", DAY),
+            "Day plan: lena\n"
+            "Tuesday 08.09.2026\n"
+            "09:00-09:45  standard\n"
+            "  Kim Weber\n"
+            "10:30-11:00  short\n"
+            "  Jo Li\n",
+        )
+
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(Schedule(), "lena", DAY),
+            "Day plan: lena\nTuesday 08.09.2026\nNo appointments.\n",
+        )
+
+    def test_cancelled_appointments_are_left_out(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        s.cancel(a.id)
+        text = day_plan(s, "lena", DAY)
+        self.assertNotIn("Kim Weber", text)
+        self.assertIn("Jo Li", text)
+
+    def test_other_therapists_are_left_out(self):
+        s = Schedule()
+        s.book(at(9, therapist="mario"))
+        self.assertIn("No appointments.", day_plan(s, "lena", DAY))
+
+    def test_no_line_is_wider_than_the_printer(self):
+        long_name = "lena-marie-anne-theresia-hildegard-von-und-zu-der-langen-name"
+        s = Schedule()
+        s.book(at(9, client="Maximiliane Kristina Wunderlich-Hohenstein von Brandenburg"))
+        s.book(at(11, therapist=long_name))
+        text = day_plan(s, "lena", DAY)
+        for line in text.splitlines() + day_plan(s, long_name, DAY).splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+        self.assertIn("Maximiliane", text)
