+"""Durations as people type them: '45', '1h30', '1:30' and the like."""
+
+import re
+
+_HOURS_MINUTES = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*m?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+_MINUTES = re.compile(r"([0-9]+)\s*(?:min|m)?")
+
+
+def _split(text):
+    """(hours, minutes) as written in `text`, or raise ValueError."""
+    if m := _HOURS_MINUTES.fullmatch(text):
+        return int(m[1]), int(m[2] or 0)
+    if m := _CLOCK.fullmatch(text):
+        return int(m[1]), int(m[2])
+    if m := _MINUTES.fullmatch(text):
+        return 0, int(m[1])
+    raise ValueError(f"not a duration: {text!r}")
+
+
+def parse_duration(text):
+    """Minutes in a duration such as '45', '45m', '45 min', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    hours, minutes = _split(text.strip().lower())
+    if minutes >= 60:
+        raise ValueError(f"minutes must be under 60: {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
