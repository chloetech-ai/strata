+"""Appointment lengths typed by a person, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:min|m)?")
+_HOURS_AND_MINUTES = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:min|m)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{1,2})")
+
+
+def parse_duration(text):
+    """Return a duration in whole minutes, e.g. '1h 30m' -> 90.
+
+    Accepts minutes ('45', '45m', '45 min'), hours with optional minutes ('1h', '1h30',
+    '1h 30m') and clock style ('1:30'). Case and surrounding spaces are ignored.
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("empty duration")
+
+    minutes = None
+    if match := _CLOCK.fullmatch(cleaned):
+        hours, mins = int(match[1]), int(match[2])
+        if mins < 60:
+            minutes = hours * 60 + mins
+    elif match := _HOURS_AND_MINUTES.fullmatch(cleaned):
+        hours, mins = int(match[1]), int(match[2] or 0)
+        if mins < 60:
+            minutes = hours * 60 + mins
+    elif match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+
+    if minutes is None or minutes == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
