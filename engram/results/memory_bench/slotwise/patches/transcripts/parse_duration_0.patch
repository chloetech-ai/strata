@@ -0,0 +1,46 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_spellings(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_empty_input_raises(self):
+        for empty in ["", "   "]:
+            with self.subTest(empty=empty):
+                with self.assertRaises(ValueError):
+                    parse_duration(empty)
+
+    def test_zero_raises(self):
+        for zero in ["0", "0m", "0h", "0h0", "0:00"]:
+            with self.subTest(zero=zero):
+                with self.assertRaises(ValueError):
+                    parse_duration(zero)
+
+    def test_other_input_raises(self):
+        for bad in ["abc", "-5", "+5", "1.5h", "1h90", "1:75", "45 seconds", "h30"]:
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    parse_duration(bad)
+
+
+if __name__ == "__main__":
+    unittest.main()
