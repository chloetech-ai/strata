+    def test_fully_booked_at_seven_treatments(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_six_treatments_is_not_fully_booked(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_treatments_do_not_count_towards_full(self):
+        s = Schedule()
+        cancelled = [s.book(at(hour)) for hour in range(8, 10)]
+        for a in cancelled:
+            s.cancel(a.id)
+        for hour in range(10, 15):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_full_day_of_other_therapist_or_other_day_is_not_full(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour, therapist="marco"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 9)))
+
+    def test_book_still_allows_an_eighth_treatment(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour))
+        s.book(at(15))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
 
 if __name__ == "__main__":
