+    def _blocking(self, therapist, start, end):
+        """The first booked appointment of `therapist` that leaves no BUFFER gap to [start, end), or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.status == CANCELLED:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` where a `minutes`-long appointment for `therapist` could be booked.
+
+        Candidates run every 15 minutes from opening time, and each must fit inside opening hours
+        and leave BUFFER either side of existing appointments. Empty if the practice is closed.
+        """
+        if minutes < 1:
+            raise ValueError("An appointment needs at least one minute.")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            end = start + length
+            if is_open_between(start, end) and self._blocking(therapist, start, end) is None:
+                slots.append(start)
+            start += FREE_SLOT_STEP
+        return slots
+
