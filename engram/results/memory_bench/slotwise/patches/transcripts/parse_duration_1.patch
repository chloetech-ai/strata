index 0000000..c3e328d
--- /dev/null
+++ b/src/slotwise/durations.py
@@ -0,0 +1,28 @@
+"""Parsing of appointment lengths typed by receptionists, e.g. '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{1,2})")
+
+
+def parse_duration(text):
+    """Return the length in whole minutes. Raises ValueError if it is not a positive duration."""
+    cleaned = text.strip().lower()
+    minutes = None
+    if match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match.group(1))
+    elif match := _HOURS.fullmatch(cleaned):
+        minutes = _hours_and_minutes(match.group(1), match.group(2) or "0")
+    elif match := _CLOCK.fullmatch(cleaned):
+        minutes = _hours_and_minutes(match.group(1), match.group(2))
+    if minutes is None or minutes == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
+
+
+def _hours_and_minutes(hours, minutes):
+    if int(minutes) >= 60:
+        raise ValueError(f"minutes must be under 60: {minutes!r}")
+    return int(hours) * 60 + int(minutes)
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..2f276b2
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,34 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_empty_zero_and_nonsense(self):
+        for text in ["", "   ", "0", "0m", "0:00", "abc", "-5", "1.5h", "1h90", "1:75", "1x"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
