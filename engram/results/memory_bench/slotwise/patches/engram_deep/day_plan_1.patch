+"""Printable text for reception."""
+
+# The receipt printer prints 42 characters a line; anything longer wraps into an unreadable mess.
+LINE_WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s non-cancelled appointments on `day` as text, one line per appointment, every line at most LINE_WIDTH characters."""
+    lines = [
+        _fit(f"Day plan: {therapist.title()}"),
+        _fit(f"{day:%A %d %B %Y}"),
+        "",
+    ]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != "cancelled"]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(_fit(f"{a.start:%H:%M}-{a.end:%H:%M} {a.treatment:<8} {a.client}"))
+    return "\n".join(lines)
+
+
+def _fit(line):
+    """Shortens `line` to LINE_WIDTH, marking the cut with two dots."""
+    if len(line) <= LINE_WIDTH:
+        return line
+    return line[: LINE_WIDTH - 2] + ".."
diff --git a/tests/test_printing.py b/tests/test_printing.py
