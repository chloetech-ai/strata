--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,48 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_by_start_time(self):
+        s = Schedule()
+        s.book(at(14, treatment="short", client="Jo Li"))
+        s.book(at(9, treatment="initial"))
+        self.assertEqual(
+            day_plan(s, "lena", DAY).split("\n"),
+            [
+                "Day plan: Lena",
+                "Tuesday 08 September 2026",
+                "",
+                "09:00-10:00 initial  Kim Weber",
+                "14:00-14:30 short    Jo Li",
+            ],
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        cancelled = s.book(at(9))
+        s.cancel(cancelled.id)
+        s.book(at(10, therapist="mia"))
+        self.assertIn("No appointments.", day_plan(s, "lena", DAY).split("\n"))
+
+    def test_every_line_fits_the_printer(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Christina Rodriguez-Almendarez Vonderheide"))
+        s.book(at(10, therapist="a-very-long-therapist-name-for-testing"))
+        for line in day_plan(s, "lena", DAY).split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertTrue(day_plan(s, "lena", DAY).split("\n")[3].endswith(".."))
+
+
+if __name__ == "__main__":
+    unittest.main()
