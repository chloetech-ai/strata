+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (as datetimes) at which a `minutes`-long appointment for `therapist` could be booked.
+
+        Starts are on a 15-minute grid from opening time. The appointment must fit inside opening hours and keep its changeover gaps.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clash(self, therapist, start, end):
+        """The therapist's booked appointment that a booking from `start` to `end` would clash with, changeover gaps included, or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.status == "cancelled":
+                continue
+            if other.start < end + CHANGEOVER and start < other.end + CHANGEOVER:
+                return other
+        return None
+
