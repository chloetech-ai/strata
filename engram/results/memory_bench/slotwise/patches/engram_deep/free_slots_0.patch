+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which a `minutes`-long appointment for `therapist` could be booked.
+
+        Starts are on a 15-minute grid from opening time. Empty if the practice is closed that day.
+        """
+        if minutes <= 0:
+            raise ValueError(f"minutes must be positive, not {minutes}")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = hours[0]
+        while start + length <= hours[1]:
+            if not self._clashes(therapist, start, start + length):
+                slots.append(start)
+            start += GRID
+        return slots
+
+    def _clashes(self, therapist, start, end):
+        """`therapist`'s non-cancelled appointments that leave less than CHANGEOVER between them and `start`-`end`."""
+        return [
+            other
+            for other in self.appointments
+            if other.therapist == therapist
+            and other.status != "cancelled"
+            and other.start < end + CHANGEOVER
+            and start < other.end + CHANGEOVER
+        ]
+
