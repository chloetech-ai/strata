diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..fbff584
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,76 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def first(day=7, hour=9, therapist="lena", client="Kim Weber", treatment="standard"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour), treatment)
+
+
+class SeriesTests(unittest.TestCase):
+    def test_books_weekly_at_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [datetime.datetime(2026, 9, d, 9) for d in (7, 14, 21)])
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_first_session_is_the_given_appointment(self):
+        s = Schedule()
+        f = first()
+        booked = book_series(s, f, 2)
+        self.assertIs(booked[0], f)
+        self.assertEqual({a.therapist for a in booked}, {"lena"})
+        self.assertEqual({a.client for a in booked}, {"Kim Weber"})
+        self.assertEqual({a.treatment for a in booked}, {"standard"})
+
+    def test_skips_a_taken_week_and_adds_one_at_the_end(self):
+        s = Schedule()
+        s.book(first(day=14, client="Jo Li"))
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start.day for a in booked], [7, 21, 28])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_counts_a_changeover_clash_as_taken(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 14, 9, 50), "standard"))
+        booked = book_series(s, first(), 2)
+        self.assertEqual([a.start.day for a in booked], [7, 21])
+
+    def test_more_than_nine_is_refused(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "at most 9 sessions"):
+            book_series(s, first(), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first(), 9)), 9)
+
+    def test_zero_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, first(), 0)
+        self.assertEqual(s.appointments, [])
+
+    def test_too_few_free_weeks_books_nothing(self):
+        s = Schedule()
+        s.book(first(day=21, client="Jo Li"))
+        with mock.patch("slotwise.series.SERIES_SEARCH_WEEKS", 3):
+            with self.assertRaises(BookingError):
+                book_series(s, first(), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_closed_session_fails_the_whole_series(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, first(hour=3), 3)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
