diff --git a/src/slotwise/series.py b/src/slotwise/series.py
new file mode 100644
index 0000000..6ba2460
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,48 @@
+"""Booking a series of weekly sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+SERIES_MAX_SESSIONS = 9
+# How many weeks after the first session a series may reach for free weeks before giving up.
+SERIES_SEARCH_WEEKS = 52
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions like `first`, at the same weekday and time, and returns them.
+
+    `first` is the first appointment of the series and is not yet booked. A week whose slot is taken is skipped and a later week is used instead, so the client still gets every session.
+    Either all sessions are booked or none are.
+    """
+    if not 1 <= count <= SERIES_MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {SERIES_MAX_SESSIONS} sessions, because insurance pays for "
+            f"{SERIES_MAX_SESSIONS} per prescription. Please book {SERIES_MAX_SESSIONS} or fewer."
+        )
+    booked = []
+    try:
+        for week in range(SERIES_SEARCH_WEEKS):
+            if len(booked) == count:
+                break
+            if week == 0:
+                candidate = first
+            else:
+                start = first.start + datetime.timedelta(weeks=week)
+                candidate = Appointment(first.therapist, first.client, start, first.treatment)
+            try:
+                booked.append(schedule.book(candidate))
+            except SlotTaken:
+                continue
+        if len(booked) < count:
+            raise BookingError(
+                f"There are not {count} free weeks in the next {SERIES_SEARCH_WEEKS} weeks at this time "
+                f"with {first.therapist.title()}. Please choose another start date or time."
+            )
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
