+    def book_day(self, s, count, therapist="lena", day=datetime.date(2026, 9, 8), first=0):
+        # Back-to-back 45-minute treatments from 08:00, each with the changeover gap, so they all fit.
+        for n in range(first, first + count):
+            start = datetime.datetime.combine(day, datetime.time(8)) + n * datetime.timedelta(minutes=55)
+            s.book(Appointment(therapist, f"Client {n}", start, "standard"))
+
+    def test_fully_booked_at_seven_treatments(self):
+        s = Schedule()
+        self.book_day(s, 6)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.book_day(s, 1, first=6)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_over_the_limit_is_still_fully_booked(self):
+        s = Schedule()
+        self.book_day(s, 8)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointments_do_not_count(self):
+        s = Schedule()
+        self.book_day(s, 7)
+        s.cancel(s.appointments[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_other_therapists_and_days_do_not_count(self):
+        s = Schedule()
+        self.book_day(s, 7, therapist="mia")
+        self.book_day(s, 7, day=datetime.date(2026, 9, 9))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertTrue(s.is_fully_booked("mia", datetime.date(2026, 9, 8)))
