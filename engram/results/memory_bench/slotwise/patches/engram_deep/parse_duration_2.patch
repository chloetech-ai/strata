@@ -0,0 +1,27 @@
+"""Read the durations receptionists type, such as '45', '1h30' or '1:30', as minutes."""
+
+import re
+
+_UNIT = r"(?:m|min|mins|minutes)"
+_MINUTES = re.compile(rf"([0-9]+)\s*{_UNIT}?")
+_HOURS = re.compile(rf"([0-9]+)\s*h\s*(?:([0-9]+)\s*{_UNIT}?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+
+
+def parse_duration(text):
+    """Return the length in minutes of a duration written as '45', '1h30' or '1:30'."""
+    cleaned = text.strip().lower()
+    if match := _CLOCK.fullmatch(cleaned):
+        hours, minutes = int(match[1]), int(match[2])
+    elif match := _HOURS.fullmatch(cleaned):
+        hours, minutes = int(match[1]), int(match[2] or 0)
+    elif match := _MINUTES.fullmatch(cleaned):
+        hours, minutes = 0, int(match[1])
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes > 59:
+        raise ValueError(f"minutes must be below 60: {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
