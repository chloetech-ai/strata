+"""Reading durations typed at the front desk, such as '1h 30m', as minutes."""
+
+import re
+
+# Checked in this order, so '1:30' is never read as minutes alone.
+_CLOCK = re.compile(r"([0-9]+):([0-9]+)")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:min|m)?)?")
+_MINUTES = re.compile(r"([0-9]+)\s*(?:min|m)?")
+
+
+def parse_duration(text):
+    """Minutes for `text`: '45', '45m', '45 min', '1h', '1h30', '1h 30m', '2h15' or '1:30'.
+
+    Case and surrounding spaces are ignored. Raises ValueError for empty input,
+    zero, or anything else.
+    """
+    cleaned = text.strip().lower()
+    if match := _CLOCK.fullmatch(cleaned):
+        minutes = _with_hours(match[1], match[2])
+    elif match := _HOURS.fullmatch(cleaned):
+        minutes = _with_hours(match[1], match[2] or "0")
+    elif match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _with_hours(hours, minutes):
+    """Total minutes for an hours part and a minutes part that must be under 60."""
+    if int(minutes) >= 60:
+        raise ValueError(f"minutes must be under 60, got {minutes}")
+    return int(hours) * 60 + int(minutes)
