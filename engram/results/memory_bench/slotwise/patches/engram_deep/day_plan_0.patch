@@ -0,0 +1,62 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+def at(hour, minute=0):
+    return datetime.datetime(2026, 9, 7, hour, minute)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_the_day_in_start_order(self):
+        schedule = Schedule()
+        schedule.book(Appointment("lena", "Anna Keller", at(14), "short"))
+        schedule.book(Appointment("lena", "Ben Meier", at(9), "initial"))
+        plan = day_plan(schedule, "lena", MONDAY)
+        self.assertEqual(
+            plan.splitlines(),
+            [
+                "Lena",
+                "Monday 07 September 2026",
+                "-" * LINE_WIDTH,
+                "09:00 Initial: Ben Meier",
+                "14:00 Short: Anna Keller",
+            ],
+        )
+
+    def test_leaves_out_other_therapists_and_days(self):
+        schedule = Schedule()
+        schedule.book(Appointment("lena", "Anna Keller", at(9)))
+        schedule.book(Appointment("marc", "Ben Meier", at(10)))
+        schedule.book(Appointment("lena", "Cora Wyss", at(9) + datetime.timedelta(days=1)))
+        self.assertIn("Anna Keller", day_plan(schedule, "lena", MONDAY))
+        self.assertNotIn("Ben Meier", day_plan(schedule, "lena", MONDAY))
+        self.assertNotIn("Cora Wyss", day_plan(schedule, "lena", MONDAY))
+
+    def test_leaves_out_cancelled_appointments(self):
+        schedule = Schedule()
+        appointment = schedule.book(Appointment("lena", "Anna Keller", at(9)))
+        schedule.cancel(appointment.id)
+        plan = day_plan(schedule, "lena", MONDAY)
+        self.assertNotIn("Anna Keller", plan)
+        self.assertTrue(plan.endswith("No appointments."))
+
+    def test_empty_day_says_so(self):
+        plan = day_plan(Schedule(), "lena", MONDAY)
+        self.assertTrue(plan.endswith("No appointments."))
+
+    def test_every_line_fits_the_receipt_printer(self):
+        schedule = Schedule()
+        schedule.book(Appointment("lena", "Maximilian Alexander Freiherr von Hohenzollern-Sigmaringen", at(9)))
+        schedule.book(Appointment("lena", "Zoë Brändli", at(11)))
+        for line in day_plan(schedule, "lena", MONDAY).splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
