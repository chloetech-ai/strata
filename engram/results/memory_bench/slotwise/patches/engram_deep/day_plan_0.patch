+"""Printed day plans for reception's receipt printer."""
+
+import textwrap
+
+# The receipt printer fits this many characters on a line; longer lines wrap into an unreadable mess.
+LINE_WIDTH = 42
+
+
+def _wrapped(text, indent=""):
+    """`text` split into lines no wider than the printer, continuation lines indented by `indent`."""
+    return textwrap.wrap(text, LINE_WIDTH, subsequent_indent=indent) or [""]
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s appointments on `day` as printable text, cancelled ones left out. Every line fits the printer."""
+    lines = [*_wrapped(therapist.title()), *_wrapped(f"{day:%A %d %B %Y}"), "-" * LINE_WIDTH]
+    booked = [a for a in schedule.appointments_for(therapist, day) if a.status != "cancelled"]
+    if not booked:
+        lines.append("No appointments.")
+    for appointment in booked:
+        entry = f"{appointment.start:%H:%M} {appointment.treatment.title()}: {appointment.client}"
+        lines.extend(_wrapped(entry, indent="      "))
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
