+"""Durations typed by the front desk, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_COLON = re.compile(r"([0-9]+):([0-9]{1,2})")  # 1:30
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:m|min)?)?")  # 1h, 1h30, 1h 30m
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")  # 45, 45m, 45 min
+
+
+def parse_duration(text):
+    """Return the length of text in minutes, e.g. '1h30' -> 90.
+
+    Raises ValueError for empty input, zero, or anything not written in one of the forms above.
+    """
+    value = text.strip().lower()
+    if match := _COLON.fullmatch(value) or _HOURS.fullmatch(value):
+        minutes = int(match[2] or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes must be below 60: {text!r}")
+        total = int(match[1]) * 60 + minutes
+    elif match := _MINUTES.fullmatch(value):
+        total = int(match[1])
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
