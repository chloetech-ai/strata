+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to start at `new_start`, keeping its treatment and therapist.
+
+        The same checks as booking apply, ignoring the appointment's current slot. If a check fails, nothing changes.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.status == "cancelled":
+            raise BookingError(
+                "This appointment has been cancelled, so it cannot be moved. Please book a new appointment instead."
+            )
+        new_end = new_start + datetime.timedelta(minutes=appointment.minutes)
+        self._check_slot(appointment.therapist, new_start, new_end, ignore=appointment)
+        appointment.start = new_start
+        return appointment
