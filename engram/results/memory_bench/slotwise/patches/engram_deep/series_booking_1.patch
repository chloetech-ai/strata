+"""Booking a series of weekly sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+from .schedule import SERIES_MAX_SESSIONS, SERIES_SEARCH_WEEKS
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions, starting with `first`, at the same weekday and time.
+
+    A week whose slot is taken is skipped and a later week is used instead, so the client still gets every session.
+    Either all sessions are booked or none are. Returns the booked appointments in date order.
+    """
+    if count < 1:
+        raise BookingError("A series needs at least one session. Please choose how many sessions to book.")
+    if count > SERIES_MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {SERIES_MAX_SESSIONS} sessions, because insurance pays for "
+            f"{SERIES_MAX_SESSIONS} per prescription. Please book {SERIES_MAX_SESSIONS} or fewer."
+        )
+    booked = []
+    try:
+        for week in range(SERIES_SEARCH_WEEKS):
+            if len(booked) == count:
+                break
+            candidate = first if week == 0 else Appointment(
+                first.therapist, first.client, first.start + datetime.timedelta(weeks=week), first.treatment
+            )
+            try:
+                booked.append(schedule.book(candidate))
+            except SlotTaken:
+                continue
+        if len(booked) < count:
+            raise BookingError(
+                f"There are not {count} free weeks in the next {SERIES_SEARCH_WEEKS} weeks at this time "
+                f"with {first.therapist.title()}. Please choose another start date or time."
+            )
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..cf95f83
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,81 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.errors import BookingError
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def first_session(hour=9, therapist="lena"):
+    return Appointment(therapist, "Kim Weber", datetime.datetime(2026, 9, 7, hour), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, first_session(), 3)
+        self.assertEqual([a.start for a in booked], [datetime.datetime(2026, 9, d, 9) for d in (7, 14, 21)])
+        self.assertEqual(s.appointments, booked)
+
+    def test_first_appointment_is_the_first_booked(self):
+        s = Schedule()
+        first = first_session()
+        booked = book_series(s, first, 2)
+        self.assertIs(booked[0], first)
+
+    def test_skips_a_taken_week_and_adds_one_at_the_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 14, 9), "standard"))
+        booked = book_series(s, first_session(), 3)
+        self.assertEqual([a.start.day for a in booked], [7, 21, 28])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_changeover_clash_counts_as_taken(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 14, 9, 50), "standard"))
+        booked = book_series(s, first_session(), 2)
+        self.assertEqual([a.start.day for a in booked], [7, 21])
+
+    def test_other_therapist_does_not_block_a_week(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Jo Li", datetime.datetime(2026, 9, 14, 9), "standard"))
+        booked = book_series(s, first_session(), 3)
+        self.assertEqual([a.start.day for a in booked], [7, 14, 21])
+
+    def test_zero_sessions_is_refused(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "at least one session"):
+            book_series(s, first_session(), 0)
+        self.assertEqual(s.appointments, [])
+
+    def test_more_than_nine_is_refused(self):
+        s = Schedule()
+        with self.assertRaisesRegex(BookingError, "at most 9 sessions"):
+            book_series(s, first_session(), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first_session(), 9)), 9)
+
+    def test_outside_opening_hours_books_nothing(self):
+        s = Schedule()
+        # A 45-minute session from 18:30 ends at 19:15, after the 19:00 closing time on weekdays.
+        late = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 18, 30), "standard")
+        with self.assertRaisesRegex(BookingError, "closed"):
+            book_series(s, late, 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_too_few_free_weeks_books_nothing(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 21, 9), "standard"))
+        with mock.patch("slotwise.series.SERIES_SEARCH_WEEKS", 3):
+            with self.assertRaises(BookingError):
+                book_series(s, first_session(), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
