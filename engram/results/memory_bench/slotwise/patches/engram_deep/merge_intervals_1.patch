+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_sorted_by_start(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_and_nested(self):
+        self.assertEqual(merge_intervals([(1, 5), (2, 3), (4, 8)]), [(1, 8)])
+
+    def test_touching_is_merged(self):
+        self.assertEqual(merge_intervals([(1, 2), (2, 3)]), [(1, 3)])
+
+    def test_datetimes(self):
+        result = merge_intervals([
+            (DT(2026, 9, 8, 10), DT(2026, 9, 8, 11)),
+            (DT(2026, 9, 8, 9), DT(2026, 9, 8, 10)),
+            (DT(2026, 9, 8, 12), DT(2026, 9, 8, 13)),
+        ])
+        self.assertEqual(result, [
+            (DT(2026, 9, 8, 9), DT(2026, 9, 8, 11)),
+            (DT(2026, 9, 8, 12), DT(2026, 9, 8, 13)),
+        ])
+
+    def test_input_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
