+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (as datetimes) at which a `minutes`-long appointment could still be booked for `therapist`.
+
+        Starts run from opening time in 15-minute steps, and each must leave the changeover gap either side of its
+        appointment. Returns an empty list on a day the practice is closed.
+        """
+        if minutes <= 0:
+            raise ValueError(f"minutes must be positive, not {minutes}")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clashing(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clashing(self, therapist, start, end):
+        """The booked appointment of `therapist` that `start` to `end` would clash with, changeover gaps included, or None."""
+        for other in self.appointments:
+            if other.therapist != therapist or other.status == "cancelled":
+                continue
+            if other.start < end + CHANGEOVER and start < other.end + CHANGEOVER:
+                return other
+        return None
+
