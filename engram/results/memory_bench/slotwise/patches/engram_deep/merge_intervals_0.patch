@@ -0,0 +1,41 @@
+import unittest
+from datetime import datetime
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_intervals_are_sorted_and_kept(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_one_interval_inside_another_keeps_the_outer_end(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_chain_of_intervals_merges_into_one(self):
+        self.assertEqual(merge_intervals([(4, 5), (1, 2), (2, 4)]), [(1, 5)])
+
+    def test_datetimes_are_merged(self):
+        d = datetime(2026, 10, 15, 9, 0)
+        result = merge_intervals([
+            (d.replace(hour=10), d.replace(hour=11)),
+            (d.replace(hour=9), d.replace(hour=10)),
+        ])
+        self.assertEqual(result, [(d.replace(hour=9), d.replace(hour=11))])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
