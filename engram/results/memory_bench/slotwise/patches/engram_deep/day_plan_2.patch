@@ -0,0 +1,56 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 10, 15)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_time_order(self):
+        schedule = Schedule()
+        schedule.book(Appointment("anna", "Maria Muster", datetime.datetime(2026, 10, 15, 14, 0), "short"))
+        schedule.book(Appointment("anna", "Peter Pan", datetime.datetime(2026, 10, 15, 9, 0), "initial"))
+
+        plan = day_plan(schedule, "anna", DAY)
+
+        self.assertEqual(
+            plan.split("\n"),
+            [
+                "Day plan: Anna",
+                "Thursday 15 October 2026",
+                "-" * LINE_WIDTH,
+                "09:00-10:00 initial",
+                "  Peter Pan",
+                "14:00-14:30 short",
+                "  Maria Muster",
+            ],
+        )
+
+    def test_leaves_out_cancelled_appointments(self):
+        schedule = Schedule()
+        appointment = schedule.book(Appointment("anna", "Maria Muster", datetime.datetime(2026, 10, 15, 9, 0)))
+        schedule.cancel(appointment.id)
+
+        self.assertIn("No appointments.", day_plan(schedule, "anna", DAY))
+
+    def test_other_therapists_and_days_are_not_listed(self):
+        schedule = Schedule()
+        schedule.book(Appointment("ben", "Maria Muster", datetime.datetime(2026, 10, 15, 9, 0)))
+        schedule.book(Appointment("anna", "Peter Pan", datetime.datetime(2026, 10, 16, 9, 0)))
+
+        self.assertIn("No appointments.", day_plan(schedule, "anna", DAY))
+
+    def test_every_line_fits_the_receipt_printer(self):
+        schedule = Schedule()
+        long_name = "Maria-Theresia Gertrud Ottilie von Hohenstaufen-Lindqvist-Brändli"
+        schedule.book(Appointment("anna-marie-christine", long_name, datetime.datetime(2026, 10, 15, 9, 0)))
+
+        for line in day_plan(schedule, "anna-marie-christine", DAY).split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
