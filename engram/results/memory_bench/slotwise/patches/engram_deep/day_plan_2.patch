+"""Printable text for reception."""
+
+import textwrap
+
+# The reception receipt printer fits 42 characters on a line; longer lines wrap into a mess.
+LINE_WIDTH = 42
+
+
+def _wrapped(text, indent=""):
+    return textwrap.wrap(
+        text,
+        width=LINE_WIDTH,
+        initial_indent=indent,
+        subsequent_indent=indent,
+        break_long_words=True,
+        break_on_hyphens=False,
+    )
+
+
+def day_plan(schedule, therapist, day):
+    """Text of `therapist`'s booked appointments on `day`, by start time, with cancelled ones left out.
+
+    Every line fits within LINE_WIDTH characters.
+    """
+    lines = _wrapped(f"Day plan: {therapist.title()}")
+    lines += _wrapped(f"{day:%A %d %B %Y}")
+    lines.append("-" * LINE_WIDTH)
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != "cancelled"]
+    if not appointments:
+        lines.append("No appointments.")
+    for appointment in appointments:
+        lines += _wrapped(f"{appointment.start:%H:%M}-{appointment.end:%H:%M} {appointment.treatment}")
+        lines += _wrapped(appointment.client, indent="  ")
+    return "\n".join(lines)
