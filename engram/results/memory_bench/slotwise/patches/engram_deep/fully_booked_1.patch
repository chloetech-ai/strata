+    def test_fully_booked_at_seven_appointments_that_day(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # seven appointments, 60 minutes apart
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_not_fully_booked_at_six_appointments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_fully_booked_counts_appointments_over_the_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):
+            s.book(at(hour))
+        s.book(at(15))  # reception booked past the limit
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointment_does_not_count_towards_fully_booked(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(at(hour)) for hour in range(8, 15)]
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
