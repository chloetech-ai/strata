+    def reschedule(self, appointment_id, new_start):
+        """Moves the appointment to start at `new_start`, keeping its treatment, therapist, client and status.
+
+        Refused with the same checks as `book`, ignoring the appointment's own old time. If refused, nothing changes.
+        """
+        appointment = self.get(appointment_id)
