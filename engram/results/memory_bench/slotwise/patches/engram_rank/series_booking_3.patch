+++ b/src/slotwise/series.py
@@ -0,0 +1,32 @@
+"""Booking a prescribed series of weekly sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# The insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+
+def book_series(schedule, first, count):
+    """Books `count` sessions, one a week at the weekday and time of `first`.
+
+    A week that is already taken is skipped, and the series goes on in the next free week,
+    so the client still gets all `count` sessions. Returns the booked appointments in order.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(
+            f"A prescription can have 1 to {MAX_SESSIONS} sessions, not {count}. "
+            "The insurance pays for at most 9 sessions per prescription."
+        )
+    booked = [schedule.book(first)]
+    week = 0
+    while len(booked) < count:
+        week += 1
+        start = first.start + datetime.timedelta(weeks=week)
+        try:
+            booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+        except SlotTaken:
+            pass
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..c66bab3
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,77 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(day, hour, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute))
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_at_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, at(8, 9), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9) for d in (8, 15, 22)],
+        )
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_skips_a_taken_week_and_adds_a_session_at_the_end(self):
+        s = Schedule()
+        s.book(at(15, 9, client="Jo Li"))
+        booked = book_series(s, at(8, 9), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [datetime.datetime(2026, 9, d, 9) for d in (8, 22, 29)],
+        )
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_cancelled_appointment_does_not_block_its_week(self):
+        s = Schedule()
+        taken = s.book(at(15, 9, client="Jo Li"))
+        s.cancel(taken.id)
+        booked = book_series(s, at(8, 9), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_keeps_treatment_and_client(self):
+        s = Schedule()
+        first = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9), "initial")
+        booked = book_series(s, first, 2)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("lena", "Kim Weber", "initial")})
+        self.assertIs(booked[0], first)
+
+    def test_more_than_nine_sessions_is_rejected_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, at(8, 9), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(8, 9), 9)), 9)
+
+    def test_zero_sessions_is_rejected(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(8, 9), 0)
+
+    def test_first_outside_opening_hours_is_rejected_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(8, 18, 30), 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_first_session_taken_raises_and_books_nothing(self):
+        s = Schedule()
+        s.book(at(8, 9, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            book_series(s, at(8, 9), 3)
+        self.assertEqual(len(s.appointments), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
