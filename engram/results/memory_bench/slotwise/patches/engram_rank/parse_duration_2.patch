index 0000000..e03e995
--- /dev/null
+++ b/src/slotwise/durations.py
@@ -0,0 +1,28 @@
+"""Treatment durations as typed by reception."""
+
+import re
+
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:min|m)?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+_MINUTES = re.compile(r"([0-9]+)\s*(?:min|m)?")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '45 min', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for anything else, for minutes of 60 or more after hours,
+    and for a zero duration.
+    """
+    s = text.strip().lower()
+    if m := _MINUTES.fullmatch(s):
+        total = int(m[1])
+    elif m := _HOURS.fullmatch(s) or _CLOCK.fullmatch(s):
+        hours, minutes = int(m[1]), int(m[2] or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes must be below 60: {text!r}")
+        total = hours * 60 + minutes
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if total == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
