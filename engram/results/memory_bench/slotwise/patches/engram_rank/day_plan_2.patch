index 0000000..212be96
--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,51 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, hour, minute), treatment)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_by_start_time(self):
+        s = Schedule()
+        s.book(at(10, client="Jo Li"))
+        s.book(at(9))
+        plan = day_plan(s, "lena", DAY).splitlines()
+        self.assertEqual(plan[2], "09:00-09:45 Kim Weber")
+        self.assertEqual(plan[4], "10:00-10:45 Jo Li")
+
+    def test_leaves_out_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(10, client="Jo Li"))
+        s.cancel(a.id)
+        plan = day_plan(s, "lena", DAY)
+        self.assertNotIn("Kim Weber", plan)
+        self.assertIn("Jo Li", plan)
+
+    def test_only_this_therapists_appointments(self):
+        s = Schedule()
+        s.book(at(9, therapist="max"))
+        self.assertNotIn("Kim Weber", day_plan(s, "lena", DAY))
+
+    def test_empty_day(self):
+        self.assertIn("No appointments.", day_plan(Schedule(), "lena", DAY))
+
+    def test_no_line_longer_than_receipt_width(self):
+        s = Schedule()
+        s.book(at(9, client="Maria-Theresia Fuhrmann-Schneider-Kaufmann-Bergmann"))
+        plan = day_plan(s, "Dr. Annemarie Hochwohlgeborene-Schmidt", DAY)
+        for line in plan.splitlines():
+            self.assertLessEqual(len(line), WIDTH)
+        self.assertIn("...", plan)
+
+
+if __name__ == "__main__":
+    unittest.main()
