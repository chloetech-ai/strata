@@ -0,0 +1,23 @@
+"""Printable documents for reception."""
+
+from .model import CANCELLED
+
+# The receipt printer holds 42 characters per line; longer lines wrap into a mess.
+WIDTH = 42
+
+
+def _fit(text):
+    """`text` cut to WIDTH characters, ending in '...' if it was too long."""
+    return text if len(text) <= WIDTH else text[: WIDTH - 3] + "..."
+
+
+def day_plan(schedule, therapist, day):
+    """The day plan for `therapist` on `day` as text, one line per printed line, cancelled appointments left out."""
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    lines = [_fit(f"{day:%a %d.%m.%Y} {therapist}"), "-" * WIDTH]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(_fit(f"{a.start:%H:%M}-{a.end:%H:%M} {a.client}"))
+        lines.append(_fit(f"  {a.treatment}"))
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
