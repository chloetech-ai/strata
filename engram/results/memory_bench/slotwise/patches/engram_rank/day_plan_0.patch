index 0000000..79a5d3c
--- /dev/null
+++ b/tests/test_printing.py
@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 7)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_the_day_in_time_order(self):
+        schedule = Schedule()
+        schedule.book(Appointment("Lea", "Anna Muster", datetime.datetime(2026, 9, 7, 10, 0), "short"))
+        schedule.book(Appointment("Lea", "Ben Keller", datetime.datetime(2026, 9, 7, 8, 0)))
+        plan = day_plan(schedule, "Lea", DAY)
+        self.assertEqual(
+            plan.splitlines(),
+            [
+                "Day plan: Lea",
+                "Monday 07 September 2026",
+                "08:00-08:45 Ben Keller, standard",
+                "10:00-10:30 Anna Muster, short",
+            ],
+        )
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        schedule = Schedule()
+        cancelled = schedule.book(Appointment("Lea", "Anna Muster", datetime.datetime(2026, 9, 7, 8, 0)))
+        schedule.book(Appointment("Tom", "Ben Keller", datetime.datetime(2026, 9, 7, 9, 0)))
+        schedule.cancel(cancelled.id)
+        self.assertEqual(day_plan(schedule, "Lea", DAY).splitlines()[-1], "No appointments.")
+
+    def test_every_line_fits_the_receipt_printer(self):
+        schedule = Schedule()
+        schedule.book(
+            Appointment(
+                "Dr. Margarethe Schoenenberger-Vollenweider",
+                "Maria Dolores Fernandez-Gutierrez-Altenburger",
+                datetime.datetime(2026, 9, 7, 8, 0),
+                "initial",
+            )
+        )
+        plan = day_plan(schedule, "Dr. Margarethe Schoenenberger-Vollenweider", DAY)
+        self.assertTrue(all(len(line) <= WIDTH for line in plan.splitlines()))
+
+
+if __name__ == "__main__":
+    unittest.main()
