+"""Printable text for reception."""
+
+import textwrap
+
+from .model import CANCELLED
+
+# The receipt printer holds 42 characters per line; anything longer wraps into a mess.
+WIDTH = 42
+
+
+def _lines(text, indent=""):
+    return textwrap.wrap(text, WIDTH, subsequent_indent=indent) or [""]
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s non-cancelled appointments on `day` as text, every line at most WIDTH characters."""
+    lines = _lines(f"Day plan: {therapist}") + _lines(f"{day:%A %d %B %Y}")
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    if not appointments:
+        lines += _lines("No appointments.")
+    for appointment in appointments:
+        time = f"{appointment.start:%H:%M}-{appointment.end:%H:%M}"
+        lines += _lines(f"{time} {appointment.client}, {appointment.treatment}", indent="  ")
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
