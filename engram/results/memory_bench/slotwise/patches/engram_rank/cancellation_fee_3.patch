index 0000000..45ad75b
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,36 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.appointment = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def cancel_after(self, notice):
+        return cancellation_fee(self.appointment, self.start - notice)
+
+    def test_more_than_48_hours_is_free(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=49)), 0)
+
+    def test_exactly_48_hours_is_free(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=48)), 0)
+
+    def test_between_24_and_48_hours_is_half_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=30)), 4900)
+
+    def test_exactly_24_hours_is_half_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=24)), 4900)
+
+    def test_under_24_hours_is_full_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=2)), 9800)
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(self.cancel_after(datetime.timedelta(hours=-1)), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
