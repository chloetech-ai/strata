+++ b/src/slotwise/intervals.py
@@ -0,0 +1,17 @@
+"""Helpers for working with time intervals."""
+
+
+def merge_intervals(intervals):
+    """Merge overlapping or touching (start, end) pairs.
+
+    Accepts ints or datetimes. Returns a new list of (start, end) tuples sorted
+    by start; the input list is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
