+"""SMS reminder text for appointments."""
+
+import unicodedata
+
+from .model import Appointment
+
+RECEPTION_PHONE = "044 512 77 30"
+MAX_LENGTH = 160
+
+_TRANSLITERATIONS = {
+    "ä": "ae",
+    "ö": "oe",
+    "ü": "ue",
+    "Ä": "Ae",
+    "Ö": "Oe",
+    "Ü": "Ue",
+    "ß": "ss",
+}
+
+
+def to_ascii(text):
+    """Transliterate text to plain ASCII for the SMS gateway.
+
+    Raises ValueError for characters that have no ASCII form, rather than
+    sending a silent replacement.
+    """
+    for char, replacement in _TRANSLITERATIONS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(c for c in decomposed if not unicodedata.combining(c))
+    try:
+        return stripped.encode("ascii").decode("ascii")
+    except UnicodeEncodeError as error:
+        raise ValueError(f"no ASCII form for {error.object[error.start]!r}") from error
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the reminder SMS for an appointment.
+
+    Raises ValueError if the text would exceed the 160-character SMS limit,
+    rather than truncating it and possibly losing the reception number.
+    """
+    text = to_ascii(
+        f"Erinnerung: Termin bei {appointment.therapist} am "
+        f"{appointment.start:%d.%m.%Y} um {appointment.start:%H:%M}. "
+        f"Verschieben? Bitte anrufen: {RECEPTION_PHONE}"
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, limit is {MAX_LENGTH}")
+    return text
