+++ b/src/slotwise/series.py
@@ -0,0 +1,41 @@
+"""Series bookings: a prescription booked as one session per week."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# The insurance pays for 9 sessions per prescription.
+MAX_SESSIONS = 9
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions, starting with `first`, and returns them.
+
+    Each session has the same therapist, client and treatment as `first`, at the same
+    weekday and time. A week that is already taken is skipped, and the series continues in
+    the next free week so the client still gets all `count` sessions.
+    """
+    if count < 1:
+        raise BookingError("A series needs at least one session. Please enter 1 or more.")
+    if count > MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have at most {MAX_SESSIONS} sessions, because the insurance pays "
+            f"for {MAX_SESSIONS} per prescription. Please enter {MAX_SESSIONS} or fewer."
+        )
+    booked = []
+    week = 0
+    while len(booked) < count:
+        if week == 0:
+            candidate = first
+        else:
+            candidate = Appointment(first.therapist, first.client, first.start + week * WEEK, first.treatment)
+        try:
+            booked.append(schedule.book(candidate))
+        except SlotTaken:
+            # Skip this week. Other booking errors, such as closed hours, repeat every week, so they propagate.
+            pass
+        week += 1
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..00e0aa8
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,85 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def tuesday(day, hour=9, minute=0, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions_at_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, tuesday(8), 3)
+        self.assertEqual(
+            [a.start for a in booked],
+            [
+                datetime.datetime(2026, 9, 8, 9, 0),
+                datetime.datetime(2026, 9, 15, 9, 0),
+                datetime.datetime(2026, 9, 22, 9, 0),
+            ],
+        )
+        self.assertEqual(s.appointments, booked)
+        self.assertTrue(all(a.client == "Kim Weber" and a.therapist == "lena" for a in booked))
+
+    def test_taken_week_is_skipped_and_session_added_at_end(self):
+        s = Schedule()
+        s.book(tuesday(15, client="Jo Li"))
+        booked = book_series(s, tuesday(8), 3)
+        self.assertEqual(
+            [a.start.day for a in booked],
+            [8, 22, 29],
+        )
+
+    def test_first_session_taken_is_skipped(self):
+        s = Schedule()
+        s.book(tuesday(8, client="Jo Li"))
+        booked = book_series(s, tuesday(8), 2)
+        self.assertEqual([a.start.day for a in booked], [15, 22])
+
+    def test_gap_conflict_skips_the_week(self):
+        # 09:50 starts within 10 minutes of the 09:00–09:45 session, so that week is skipped
+        s = Schedule()
+        s.book(tuesday(15, hour=9, minute=50, client="Jo Li"))
+        booked = book_series(s, tuesday(8), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 22])
+
+    def test_cancelled_appointment_does_not_block_its_week(self):
+        s = Schedule()
+        other = s.book(tuesday(15, client="Jo Li"))
+        s.cancel(other.id)
+        booked = book_series(s, tuesday(8), 2)
+        self.assertEqual([a.start.day for a in booked], [8, 15])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, tuesday(8), MAX_SESSIONS)), 9)
+
+    def test_more_than_nine_sessions_is_rejected_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(BookingError) as ctx:
+            book_series(s, tuesday(8), 12)
+        self.assertIn("at most 9", str(ctx.exception))
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_is_rejected(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, tuesday(8), 0)
+        self.assertEqual(s.appointments, [])
+
+    def test_closed_weekday_raises_instead_of_looping(self):
+        # Sunday 6 Sep 2026 is closed in every week
+        s = Schedule()
+        sunday = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 6, 9, 0))
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, sunday, 2)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
