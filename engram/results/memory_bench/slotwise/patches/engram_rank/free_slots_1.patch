+        start = datetime.datetime(2026, 9, 8, 7, 30)
+        while start + datetime.timedelta(minutes=45) <= datetime.datetime(2026, 9, 8, 19, 0):
+            trial = Schedule()
+            trial.appointments = list(s.appointments)
+            try:
+                trial.book(Appointment("lena", "Kim Weber", start, "standard"))
+                booked = True
+            except SlotTaken:
+                booked = False
+            self.assertEqual(start in free, booked, start)
+            start += datetime.timedelta(minutes=15)
