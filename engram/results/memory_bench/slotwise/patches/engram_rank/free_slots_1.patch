+    def test_free_slots_on_an_empty_day_run_from_opening_on_a_15_minute_grid(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 60)
+        self.assertTrue(all(isinstance(s, datetime.datetime) for s in slots))
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[1], datetime.datetime(2026, 9, 8, 7, 45))
+        # the last 60-minute appointment must end by closing at 19:00
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))
+        self.assertEqual(len(slots), 43)
+
+    def test_free_slots_on_a_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 30), [])
+
+    def test_free_slots_keep_the_gap_from_existing_appointments(self):
+        # booked 09:00–09:45, so a 30-minute appointment needs to start by 08:20 or at 09:55 or later
+        s = Schedule()
+        s.book(at(9))
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_agree_with_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(13, 30, treatment="short", client="Jo Li"))
+        day = datetime.date(2026, 9, 8)
