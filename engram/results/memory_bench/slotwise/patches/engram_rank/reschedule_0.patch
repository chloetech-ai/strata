+    def test_reschedule_moves_the_same_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(s.get(a.id).start, datetime.datetime(2026, 9, 8, 13, 0))
+        self.assertEqual(s.get(a.id).end, datetime.datetime(2026, 9, 8, 13, 45))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 20))
+        self.assertEqual(s.get(a.id).start, datetime.datetime(2026, 9, 8, 9, 20))
+
+    def test_reschedule_into_another_appointment_is_taken(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 30))
+        self.assertEqual(s.get(a.id).start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_leaves_no_gap_is_taken(self):
+        # moved 09:25–09:55 leaves only 5 minutes before Jo's 10:00
+        s = Schedule()
+        a = s.book(at(9, treatment="short"))
+        s.book(at(10, client="Jo Li", treatment="short"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 25))
+        self.assertEqual(s.get(a.id).start.hour, 9)
+        self.assertEqual(s.get(a.id).start.minute, 0)
+
+    def test_reschedule_ignores_cancelled_appointments(self):
