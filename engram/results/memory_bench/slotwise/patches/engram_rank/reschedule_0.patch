+    def _check_slot(self, appointment):
+        """Raises if `appointment` is not a treatment we offer, is outside opening hours, or leaves no GAP to another booking."""
+        if appointment.treatment not in TREATMENTS:
+            raise BookingError(f"We don't offer a '{appointment.treatment}' treatment.")
+        if not is_open_between(appointment.start, appointment.end):
+            raise OutsideOpeningHours(appointment.start, appointment.end)
+        for other in self.appointments:
+            # Skip the record being moved: it is the same appointment, not a conflict.
+            if other.id == appointment.id or other.therapist != appointment.therapist or other.status == CANCELLED:
+                continue
+            # Overlap test with each appointment widened by GAP on both sides.
+            if appointment.start - GAP < other.end and other.start < appointment.end + GAP:
+                raise SlotTaken(appointment.therapist, appointment.start, appointment.end)
