         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 8))
 
+    def test_free_slots_on_empty_day_run_from_opening_until_close(self):
+        # Tuesday opens 07:30 and closes 19:00; a 60-minute treatment must end by 19:00
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 60)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))
+        self.assertEqual(len(slots), 43)
+
+    def test_free_slots_on_closed_day_is_empty(self):
+        # Sunday is not in OPENING_HOURS
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])
+
+    def test_free_slots_keep_the_gap_from_booked_appointments(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00–09:45, so each side needs 10 minutes clear
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, gap to 09:00 is 15 min
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, no gap
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 50), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # starts 15 min after 09:45
+
+    def test_free_slots_agree_with_book(self):
+        day = datetime.date(2026, 9, 8)
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(12, treatment="short"))
+        free = s.free_slots("lena", day, 45)
+        for hour in range(7, 19):
+            for minute in (0, 15, 30, 45):
+                start = datetime.datetime(day.year, day.month, day.day, hour, minute)
+                if start.hour == 7 and start.minute < 30:
+                    continue
+                trial = Schedule()
+                trial.appointments = list(s.appointments)
+                candidate = Appointment("lena", "Jo Li", start, "standard")
+                if start in free:
+                    trial.book(candidate)
+                else:
+                    with self.assertRaises((SlotTaken, OutsideOpeningHours)):
+                        trial.book(candidate)
+
+    def test_free_slots_ignore_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+
+    def test_free_slots_ignore_other_therapists(self):
+        s = Schedule()
+        s.book(at(9, therapist="marco"))
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+
+    def test_free_slots_saturday_ends_at_noon(self):
+        # Saturday 08:00–12:00; a 45-minute treatment starts no later than 11:15
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 12), 45)
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 15))
+        self.assertEqual(len(slots), 14)
+
+    def test_free_slots_rejects_non_positive_length(self):
+        with self.assertRaises(ValueError):
+            Schedule().free_slots("lena", datetime.date(2026, 9, 8), 0)
