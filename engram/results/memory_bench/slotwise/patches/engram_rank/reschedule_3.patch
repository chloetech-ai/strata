+        self._check(appointment)
+        self.appointments.append(appointment)
+        return appointment
+
+    def reschedule(self, appointment_id, new_start):
+        """Moves the appointment to start at `new_start`, keeping its id, with the same checks as `book`."""
+        appointment = self.get(appointment_id)
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check(moved, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
+    def _check(self, appointment, ignore=None):
+        """Raises unless `appointment` is valid and free. `ignore` is an existing appointment to disregard."""
         if appointment.treatment not in TREATMENTS:
             raise BookingError(f"We don't offer a '{appointment.treatment}' treatment.")
         if not is_open_between(appointment.start, appointment.end):
             raise OutsideOpeningHours(appointment.start, appointment.end)
