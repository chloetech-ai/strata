+    def test_reschedule_moves_the_same_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_keeps_status(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.status, "cancelled")
+
+    def test_reschedule_ignores_its_own_old_time(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 5))
+
+    def test_reschedule_onto_another_appointment_is_taken(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_inside_the_gap_is_taken(self):
+        # new 10:10–10:55 leaves only 5 minutes before the existing 11:00
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 10))
+
+    def test_reschedule_ignores_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        b = s.book(at(11, client="Jo Li"))
+        s.cancel(b.id)
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_ignores_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, therapist="marco", client="Jo Li"))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_outside_opening_hours(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_unknown_id_is_a_key_error(self):
+        with self.assertRaises(KeyError):
+            Schedule().reschedule(999999, datetime.datetime(2026, 9, 8, 11, 0))
