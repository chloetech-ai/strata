+    def book_day(self, s, count, therapist="lena"):
+        """Books `count` short treatments back to back with the gap, from 08:00 on 8 Sep 2026."""
+        start = datetime.datetime(2026, 9, 8, 8, 0)
+        for i in range(count):
+            s.book(Appointment(therapist, "Kim Weber", start + i * datetime.timedelta(minutes=40), "short"))
+
+    def test_fully_booked_at_seven_appointments(self):
+        six, seven = Schedule(), Schedule()
+        self.book_day(six, 6)
+        self.book_day(seven, 7)
+        self.assertFalse(six.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertTrue(seven.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointments_do_not_count_towards_full(self):
+        s = Schedule()
+        self.book_day(s, 7)
+        s.cancel(s.appointments_for("lena", datetime.date(2026, 9, 8))[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_full_day_is_per_therapist_and_per_day(self):
+        s = Schedule()
+        self.book_day(s, 7)
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_book_does_not_enforce_the_cap(self):
+        s = Schedule()
+        self.book_day(s, 8)
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
