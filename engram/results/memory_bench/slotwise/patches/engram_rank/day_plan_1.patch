+"""Printable text for reception's receipt printer."""
+
+from .model import CANCELLED
+
+# The receipt printer fits 42 characters per line; anything longer wraps into a mess.
+WIDTH = 42
+
+
+def _clip(text, width):
+    return text if len(text) <= width else text[: width - 3] + "..."
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s booked appointments on `day` as text, one line per appointment, by start time."""
+    lines = [
+        _clip(therapist, WIDTH),
+        _clip(f"{day:%A %d.%m.%Y}", WIDTH),
+        "-" * WIDTH,
+    ]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if a.status != CANCELLED]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        prefix = f"{a.start:%H:%M}-{a.end:%H:%M} {a.treatment:<9} "
+        lines.append(prefix + _clip(a.client, WIDTH - len(prefix)))
+    return "\n".join(lines)
