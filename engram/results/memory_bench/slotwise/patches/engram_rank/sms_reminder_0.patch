diff --git a/src/slotwise/reminders.py b/src/slotwise/reminders.py
new file mode 100644
index 0000000..1d786dd
--- /dev/null
+++ b/src/slotwise/reminders.py
@@ -0,0 +1,53 @@
+"""SMS reminders for appointments."""
+
+import unicodedata
+
+from .model import Appointment
+
+RECEPTION_PHONE = "044 512 77 30"
+
+# The SMS gateway only takes plain ASCII, and a longer message is billed as two.
+MAX_LENGTH = 160
+
+# Umlauts are mapped by hand so 'Brändli' becomes 'Braendli' rather than 'Brandli'.
+_TRANSLITERATIONS = {
+    "ä": "ae",
+    "ö": "oe",
+    "ü": "ue",
+    "Ä": "Ae",
+    "Ö": "Oe",
+    "Ü": "Ue",
+    "ß": "ss",
+}
+
+
+def to_ascii(text):
+    """Transliterate text to plain ASCII for the SMS gateway.
+
+    Raises ValueError if anything is still not ASCII afterwards, rather than
+    sending a silent gap.
+    """
+    for char, replacement in _TRANSLITERATIONS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(c for c in decomposed if not unicodedata.combining(c))
+    if not stripped.isascii():
+        bad = sorted({c for c in stripped if not c.isascii()})
+        raise ValueError(f"cannot transliterate to ASCII: {bad}")
+    return stripped
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the reminder SMS text for an appointment.
+
+    Raises ValueError if the text would exceed 160 characters, rather than
+    truncating it, since truncation could cut off the reception number.
+    """
+    text = to_ascii(
+        f"Erinnerung: Termin bei {appointment.therapist} am "
+        f"{appointment.start:%d.%m.%Y} um {appointment.start:%H:%M}. "
+        f"Verschieben: {RECEPTION_PHONE}"
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, limit is {MAX_LENGTH}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..3617f9c
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,51 @@
+import datetime
+
+import pytest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_PHONE, reminder_text, to_ascii
+
+
+def make_appointment(therapist="Anna Brändli", start=None):
+    start = start or datetime.datetime(2026, 10, 20, 9, 30)
+    return Appointment(therapist=therapist, client="Client", start=start)
+
+
+def test_to_ascii_transliterates_umlauts():
+    assert to_ascii("Brändli") == "Braendli"
+    assert to_ascii("Ärzte Öl Übung Strasse") == "Aerzte Oel Uebung Strasse"
+    assert to_ascii("Gruß") == "Gruss"
+
+
+def test_to_ascii_strips_other_accents():
+    assert to_ascii("café élève") == "cafe eleve"
+
+
+def test_to_ascii_raises_on_untransliterable_characters():
+    with pytest.raises(ValueError):
+        to_ascii("Zhang 张")
+
+
+def test_reminder_text_is_ascii_and_contains_fields():
+    text = reminder_text(make_appointment())
+    assert text == (
+        "Erinnerung: Termin bei Anna Braendli am 20.10.2026 um 09:30. "
+        f"Verschieben: {RECEPTION_PHONE}"
+    )
+    assert text.isascii()
+
+
+def test_reminder_text_includes_reception_phone():
+    assert RECEPTION_PHONE in reminder_text(make_appointment())
+
+
+def test_reminder_text_rejects_text_over_160_characters():
+    with pytest.raises(ValueError):
+        reminder_text(make_appointment(therapist="X" * 150))
+
+
+def test_reminder_text_accepts_exactly_160_characters():
+    base = reminder_text(make_appointment(therapist="X"))
+    therapist = "X" * (1 + MAX_LENGTH - len(base))
+    text = reminder_text(make_appointment(therapist=therapist))
+    assert len(text) == MAX_LENGTH
