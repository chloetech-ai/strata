+"""Parsing of treatment durations typed by reception."""
+
+import re
+
+# "1h", "1h30", "1h 30m", "1h 30 min", "45", "45m", "45 min", "1:30"
+_DURATION = re.compile(
+    r"(?:(?P<hours>[0-9]+)\s*h\s*(?:(?P<minutes>[0-9]+)\s*(?:m|min)?)?"
+    r"|(?P<plain>[0-9]+)\s*(?:m|min)?"
+    r"|(?P<clock_hours>[0-9]+):(?P<clock_minutes>[0-9]+))"
+)
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '1h30' or '1:30'. Raises ValueError if unclear."""
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match["plain"] is not None:
+        hours, minutes = 0, int(match["plain"])
+    elif match["clock_hours"] is not None:
+        hours, minutes = int(match["clock_hours"]), int(match["clock_minutes"])
+    else:
+        hours = int(match["hours"])
+        minutes = int(match["minutes"] or 0)
+
+    if minutes >= 60:
+        raise ValueError(f"minutes must be below 60: {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
