+    def test_free_slots_on_empty_day_run_from_opening_to_last_fitting_start(self):
+        # Tuesday 8 Sep 2026 opens 07:30 and closes 19:00; a 60-minute slot must end by 19:00.
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 60)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))
+        self.assertEqual(len(slots), 43)
+        self.assertTrue(all(b - a == datetime.timedelta(minutes=15) for a, b in zip(slots, slots[1:])))
+
+    def test_free_slots_on_closed_day_is_empty(self):
+        # Sunday
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 30), [])
+
+    def test_free_slots_on_saturday_stop_at_noon(self):
+        # Saturday 12 Sep 2026 opens 08:00 and closes 12:00; a 45-minute slot must end by 12:00.
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 12), 45)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 12, 8, 0))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 15))
+
