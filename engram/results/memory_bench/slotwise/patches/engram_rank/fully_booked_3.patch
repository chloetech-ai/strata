+    def test_is_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(at(14))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_is_fully_booked_ignores_cancelled(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        first = s.book(at(8))
+        for hour in range(9, 15):
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(first.id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_is_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour, therapist="marco"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertTrue(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 9)))
+
+    def test_book_does_not_enforce_the_daily_cap(self):
+        s = Schedule()
+        for hour in range(8, 16):
+            s.book(at(hour))
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+
