+
+    def is_fully_booked(self, therapist, day):
+        """Whether `therapist` already has MAX_TREATMENTS_PER_DAY non-cancelled appointments on `day`.
+
+        For the online booking page to grey out days. book() does not enforce this cap.
+        """
+        active = [a for a in self.appointments_for(therapist, day) if a.status != CANCELLED]
+        return len(active) >= MAX_TREATMENTS_PER_DAY
