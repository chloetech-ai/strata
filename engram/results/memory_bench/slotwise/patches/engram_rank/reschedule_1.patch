+    def test_reschedule_moves_the_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.end, datetime.datetime(2026, 9, 8, 11, 45))
+        self.assertEqual(a.treatment, "standard")
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 5))
+
+    def test_reschedule_into_taken_slot_is_rejected_and_leaves_it_in_place(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_respects_the_gap(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        # new 10:10–10:55 leaves only 5 minutes before the existing 11:00
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 10))
+
+    def test_reschedule_ignores_cancelled_appointments(self):
+        s = Schedule()
+        a = s.book(at(9))
+        b = s.book(at(11, client="Jo Li"))
+        s.cancel(b.id)
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_outside_opening_hours_is_rejected(self):
+        s = Schedule()
