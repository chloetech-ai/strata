+"""SMS reminders for appointments."""
+
+import unicodedata
+
+# The SMS gateway takes plain ASCII only, and a longer message is billed as two.
+MAX_LENGTH = 160
+# Reception's number, so clients can call to move their appointment.
+RECEPTION_PHONE = "044 512 77 30"
+
+# German letters that Unicode normalisation alone would turn into the wrong word ("Brändli" -> "Brandli").
+_TRANSLITERATIONS = {
+    "ä": "ae", "ö": "oe", "ü": "ue",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+    "ß": "ss",
+}
+
+
+def to_ascii(text):
+    """Turns `text` into plain ASCII: German letters become digraphs, other accents are stripped."""
+    for char, replacement in _TRANSLITERATIONS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def reminder_text(appointment):
+    """Returns the reminder SMS for `appointment`. Raises ValueError if it would not fit in one SMS."""
+    text = to_ascii(
+        f"Reminder: your appointment with {appointment.therapist} is on "
+        f"{appointment.start:%d.%m.%Y} at {appointment.start:%H:%M}. "
+        f"To move it, please call reception on {RECEPTION_PHONE}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"Reminder is {len(text)} characters, the limit is {MAX_LENGTH}: {text!r}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..e521170
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,41 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_PHONE, reminder_text, to_ascii
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_german_letters_become_digraphs(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Öztürk ß"), "Oeztuerk ss")
+
+    def test_other_accents_are_stripped(self):
+        self.assertEqual(to_ascii("café élan"), "cafe elan")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_time_therapist_and_reception_number(self):
+        a = Appointment("Brändli", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 30))
+        text = reminder_text(a)
+        self.assertEqual(
+            text,
+            "Reminder: your appointment with Braendli is on 07.09.2026 at 09:30. "
+            "To move it, please call reception on 044 512 77 30.",
+        )
+        self.assertIn(RECEPTION_PHONE, text)
+
+    def test_is_ascii_and_within_limit(self):
+        a = Appointment("Brändli", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 30))
+        text = reminder_text(a)
+        self.assertTrue(text.isascii())
+        self.assertLessEqual(len(text), MAX_LENGTH)
+
+    def test_raises_when_too_long(self):
+        a = Appointment("x" * 200, "Kim Weber", datetime.datetime(2026, 9, 7, 9, 30))
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
