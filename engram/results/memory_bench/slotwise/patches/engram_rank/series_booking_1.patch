+++ b/src/slotwise/series.py
@@ -0,0 +1,40 @@
+"""Booking a prescribed series of weekly sessions."""
+
+import datetime
+
+from .errors import BookingError, SlotTaken
+from .model import Appointment
+
+# The insurance pays for at most 9 sessions per prescription.
+MAX_SESSIONS = 9
+
+WEEK = datetime.timedelta(weeks=1)
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions starting with `first` and returns the booked appointments.
+
+    A week whose slot is taken is skipped, and the series gets one more session at the end
+    so the client still receives all `count` sessions.
+    """
+    if not 1 <= count <= MAX_SESSIONS:
+        raise BookingError(
+            f"A series can have 1 to {MAX_SESSIONS} sessions, not {count}. "
+            f"The insurance pays for {MAX_SESSIONS} sessions per prescription."
+        )
+    booked = []
+    weeks = 0
+    while len(booked) < count:
+        appointment = first if weeks == 0 else _week_after(first, weeks)
+        weeks += 1
+        try:
+            booked.append(schedule.book(appointment))
+        except SlotTaken:
+            # That week is taken; the loop goes on to the next week instead.
+            continue
+    return booked
+
+
+def _week_after(first, weeks):
+    """A new appointment `weeks` weeks after `first`, for the same therapist, client and treatment."""
+    return Appointment(first.therapist, first.client, first.start + weeks * WEEK, first.treatment)
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..9b1bac7
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, OutsideOpeningHours
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def at(hour, minute=0, therapist="lena", treatment="standard", client="Kim Weber", day=8):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, minute), treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions_at_the_same_time(self):
+        s = Schedule()
+        booked = book_series(s, at(9), 3)
+        self.assertEqual([a.start for a in booked], [
+            datetime.datetime(2026, 9, 8, 9, 0),
+            datetime.datetime(2026, 9, 15, 9, 0),
+            datetime.datetime(2026, 9, 22, 9, 0),
+        ])
+        self.assertEqual(s.appointments, booked)
+
+    def test_sessions_keep_therapist_client_and_treatment(self):
+        s = Schedule()
+        booked = book_series(s, at(9, treatment="short", client="Jo Li", therapist="marco"), 2)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("marco", "Jo Li", "short")})
+
+    def test_taken_week_is_skipped_and_a_session_added_at_the_end(self):
+        s = Schedule()
+        s.book(at(9, day=15, client="Jo Li"))
+        booked = book_series(s, at(9), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_taken_first_week_is_skipped(self):
+        s = Schedule()
+        s.book(at(9, client="Jo Li"))
+        booked = book_series(s, at(9), 2)
+        self.assertEqual([a.start.day for a in booked], [15, 22])
+
+    def test_cancelled_week_is_not_skipped(self):
+        s = Schedule()
+        a = s.book(at(9, day=15, client="Jo Li"))
+        s.cancel(a.id)
+        booked = book_series(s, at(9), 2)
+        self.assertEqual([x.start.day for x in booked], [8, 15])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(9), 9)), 9)
+
+    def test_more_than_nine_sessions_is_rejected_and_nothing_is_booked(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, at(9), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_is_rejected(self):
+        with self.assertRaises(BookingError):
+            book_series(Schedule(), at(9), 0)
+
+    def test_outside_opening_hours_is_raised(self):
+        s = Schedule()
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, at(18, 30), 2)
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
