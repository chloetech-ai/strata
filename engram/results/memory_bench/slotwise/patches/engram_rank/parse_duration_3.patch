+"""Parsing of treatment durations typed by reception."""
+
+import re
+
+# 1h, 1h30, 1h 30m, 2h15 | 45, 45m, 45 min | 1:30
+_DURATION = re.compile(
+    r"(?:(?P<hours>[0-9]+)\s*h\s*(?:(?P<h_minutes>[0-9]+)\s*m?)?"
+    r"|(?P<minutes>[0-9]+)\s*(?:m|min)?"
+    r"|(?P<c_hours>[0-9]+):(?P<c_minutes>[0-9]{1,2}))",
+    re.ASCII,
+)
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '1h', '1h30' or '1:30'.
+
+    Raises ValueError for empty input, zero, minutes of 60 or more, or anything else.
+    """
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if match["minutes"] is not None:
+        minutes = int(match["minutes"])
+    else:
+        hours = int(match["hours"] or match["c_hours"])
+        rest = match["h_minutes"] or match["c_minutes"]
+        rest = int(rest) if rest is not None else 0
+        if rest > 59:
+            raise ValueError(f"minutes must be below 60: {text!r}")
+        minutes = hours * 60 + rest
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
