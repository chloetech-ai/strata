@@ -0,0 +1,36 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.standard = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def cancel_hours_before(self, hours):
+        return self.start - datetime.timedelta(hours=hours)
+
+    def test_no_fee_with_more_than_48_hours_notice(self):
+        self.assertEqual(cancellation_fee(self.standard, self.cancel_hours_before(49)), 0)
+
+    def test_no_fee_at_exactly_48_hours_notice(self):
+        self.assertEqual(cancellation_fee(self.standard, self.cancel_hours_before(48)), 0)
+
+    def test_half_price_under_48_hours(self):
+        self.assertEqual(cancellation_fee(self.standard, self.cancel_hours_before(47)), 4900)
+
+    def test_half_price_at_exactly_24_hours(self):
+        self.assertEqual(cancellation_fee(self.standard, self.cancel_hours_before(24)), 4900)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(cancellation_fee(self.standard, self.cancel_hours_before(23)), 9800)
+
+    def test_full_price_after_start(self):
+        self.assertEqual(cancellation_fee(self.standard, self.start + datetime.timedelta(hours=1)), 9800)
+
+
+if __name__ == "__main__":
+    unittest.main()
