@@ -0,0 +1,31 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def setUp(self):
+        self.start = datetime.datetime(2026, 9, 7, 9, 0)
+        self.appointment = Appointment("lena", "Kim Weber", self.start, "standard")
+
+    def test_no_fee_with_more_than_48_hours_notice(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.start - datetime.timedelta(hours=49)), 0)
+
+    def test_half_price_between_24_and_48_hours_notice(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.start - datetime.timedelta(hours=30)), 4900)
+
+    def test_full_price_under_24_hours_notice(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.start - datetime.timedelta(hours=2)), 9800)
+
+    def test_full_price_after_the_start(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.start + datetime.timedelta(hours=1)), 9800)
+
+    def test_boundaries_belong_to_the_lower_fee(self):
+        self.assertEqual(cancellation_fee(self.appointment, self.start - datetime.timedelta(hours=48)), 0)
+        self.assertEqual(cancellation_fee(self.appointment, self.start - datetime.timedelta(hours=24)), 4900)
+
+
+if __name__ == "__main__":
+    unittest.main()
