index 0000000..6284d37
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,45 @@
+"""Series bookings: the same weekday and time, one week apart."""
+
+import datetime
+
+from .errors import BookingError, OutsideOpeningHours, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+# If a week is taken, the series moves on to the next one. This is how many extra weeks we look.
+MAX_SKIPPED_WEEKS = 4
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments starting with `first`, and returns them in order.
+
+    `first` is the first appointment of the series and is not booked itself; copies of it are.
+    A week that is taken or closed is skipped, and the series continues in a later week.
+    If `count` sessions can't all be booked, nothing is booked and BookingError is raised.
+    """
+    if count < 1:
+        raise ValueError("a series needs at least one session")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(f"A series can have at most {MAX_SESSIONS} sessions. Please book the rest separately.")
+
+    booked = []
+    for week in range(count + MAX_SKIPPED_WEEKS):
+        if len(booked) == count:
+            break
+        start = first.start + datetime.timedelta(weeks=week)
+        candidate = Appointment(first.therapist, first.client, start, first.treatment)
+        try:
+            booked.append(schedule.book(candidate))
+        except (SlotTaken, OutsideOpeningHours):
+            continue
+
+    if len(booked) < count:
+        # Undo this series so reception doesn't have to clean up part of it.
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise BookingError(
+            f"Only {len(booked)} of the {count} sessions could be booked in the coming weeks, "
+            "so none have been booked. Please choose another start date."
+        )
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..97aabca
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,65 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+MONDAY = datetime.datetime(2026, 9, 7, 9, 0)
+
+
+def first_session(client="Kim Weber"):
+    return Appointment("lena", client, MONDAY)
+
+
+class SeriesTest(unittest.TestCase):
+    def test_books_consecutive_weeks(self):
+        s = Schedule()
+        booked = book_series(s, first_session(), 3)
+        self.assertEqual([a.start for a in booked], [MONDAY + datetime.timedelta(weeks=i) for i in range(3)])
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_skips_taken_week_and_adds_one_at_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", MONDAY + datetime.timedelta(weeks=1)))  # second week taken
+        booked = book_series(s, first_session(), 3)
+        self.assertEqual([a.start.date().day for a in booked], [7, 21, 28])
+        self.assertEqual([a.client for a in booked], ["Kim Weber"] * 3)
+
+    def test_returned_appointments_are_new_bookings(self):
+        s = Schedule()
+        first = first_session()
+        booked = book_series(s, first, 2)
+        self.assertNotIn(first.id, [a.id for a in booked])
+        self.assertEqual(len({a.id for a in booked}), 2)
+
+    def test_more_than_nine_sessions_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, first_session(), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first_session(), 9)), 9)
+
+    def test_nothing_booked_when_not_enough_free_weeks(self):
+        s = Schedule()
+        # The search covers weeks 0-6 (3 sessions + 4 spare weeks). Weeks 1-5 are taken,
+        # leaving only 2 free weeks for a 3-session series.
+        blocked = [1, 2, 3, 4, 5]
+        for week in blocked:
+            s.book(Appointment("lena", "Jo Li", MONDAY + datetime.timedelta(weeks=week)))
+        with self.assertRaises(BookingError):
+            book_series(s, first_session(), 3)
+        self.assertEqual(len(s.appointments), len(blocked))
+        self.assertTrue(all(a.client == "Jo Li" for a in s.appointments))
+
+    def test_zero_sessions_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first_session(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
