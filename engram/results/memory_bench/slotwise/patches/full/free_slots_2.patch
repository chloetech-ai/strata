+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which a `minutes`-long appointment for `therapist` would be accepted.
+
+        Starts are SLOT_STEP apart, from opening time. Returns [] on a day the practice is closed.
+        """
+        if minutes <= 0:
+            raise ValueError(f"appointment length must be positive, not {minutes}")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clashing(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _clashing(self, therapist, start, end):
+        """The first active appointment for `therapist` that overlaps [start, end) or is within BUFFER of it."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
