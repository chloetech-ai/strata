+    def test_free_slots_on_empty_day(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # 18:15 + 45 min = 19:00
+        self.assertEqual(len(slots), 44)  # 07:30 to 18:15 in 15-minute steps
+
+    def test_free_slots_respect_buffer(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so 45-minute starts must end by 08:50 or begin at 09:55 or later
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 10 minutes clear
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, inside the buffer
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # overlaps the existing appointment
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # first grid start after the buffer
+
+    def test_free_slots_match_book(self):
