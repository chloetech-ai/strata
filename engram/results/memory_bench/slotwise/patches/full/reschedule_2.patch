+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertIs(s.get(a.id), a)
+        s.book(at(9))  # old slot is free now
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_reschedule_into_conflict_leaves_it_where_it_was(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 55))  # 5 min before Jo's 11:00
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_keeps_buffer_rule(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 10))  # ends 10:55, 5 min before 11:00
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 5))  # ends 10:50, exactly 10 min before 11:00
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 10, 5))
+
+    def test_reschedule_checks_opening_hours(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_cancelled_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+
