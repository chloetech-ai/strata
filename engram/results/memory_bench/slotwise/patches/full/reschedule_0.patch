+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual((a.start.hour, a.treatment, a.client), (11, "standard", "Kim Weber"))
+        self.assertIs(s.get(a.id), a)
+
+    def test_reschedule_can_shift_by_a_few_minutes(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start.minute, 5)
+
+    def test_reschedule_checks_the_new_time(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(12, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 30))  # ends 12:15, too close to 12:00
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))  # unchanged after refusals
+
+    def test_reschedule_cancelled_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+
+    def test_reschedule_unknown_id(self):
+        with self.assertRaises(KeyError):
