+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to `new_start`, keeping its treatment and client.
+
+        The same rules as booking apply to the new time. The appointment does not
+        block itself, so it can move by a few minutes. Raises BookingError if refused.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError(f"Appointment {appointment_id} is cancelled, so it cannot be moved.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check_free(moved, ignore_id=appointment_id)
+        appointment.start = new_start
+        return appointment
