+"""Printable plans for the reception receipt printer."""
+
+import textwrap
+
+# The receipt printer fits 42 characters on a line; longer lines wrap into a mess.
+LINE_WIDTH = 42
+
+
+def _wrapped(text, indent=""):
+    return textwrap.wrap(text, LINE_WIDTH, subsequent_indent=indent) or [""]
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s active appointments on `day` as plain text, one entry per appointment."""
+    lines = _wrapped(f"{therapist.capitalize()} - {day:%a %d %b %Y}")
+    lines.append("")
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines += _wrapped(f"{a.start:%H:%M}-{a.end:%H:%M} {a.client}", indent="      ")
+        lines += _wrapped(f"      {a.treatment}")
+    return "\n".join(lines)
