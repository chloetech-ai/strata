@@ -0,0 +1,40 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_active_appointments_in_order(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 7, 14, 0), "short"))
+        a = s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 8, 0)))
+        s.book(Appointment("marco", "Zoë Brändli", datetime.datetime(2026, 9, 7, 9, 0)))
+        s.cancel(a.id)
+        plan = day_plan(s, "lena", MONDAY)
+        self.assertEqual(
+            plan.splitlines(),
+            [
+                "Lena - Mon 07 Sep 2026",
+                "",
+                "14:00-14:30 Jo Li",
+                "      short",
+            ],
+        )
+
+    def test_empty_day(self):
+        self.assertIn("No appointments.", day_plan(Schedule(), "lena", MONDAY))
+
+    def test_no_line_exceeds_printer_width(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Maria-Theresia von Hohenberg-Liechtenstein Gräfin", datetime.datetime(2026, 9, 7, 9, 0)))
+        for line in day_plan(s, "lena", MONDAY).splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
