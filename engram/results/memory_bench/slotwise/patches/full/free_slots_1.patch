+    def _clash(self, therapist, start, end):
+        """The active appointment that stops `therapist` working from `start` to `end`, or None.
+
+        Counts BUFFER on either side of each appointment.
+        """
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` where a `minutes`-long appointment could be booked for `therapist`.
+
+        Times are on a 15-minute grid from opening time, and follow the same
+        rules as book(). Returns [] on a day the practice is closed.
+        """
+        if minutes <= 0:
+            raise ValueError(f"appointment length must be positive, not {minutes}")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
