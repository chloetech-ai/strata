+    def test_free_slots_on_empty_day(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))  # last 60-minute slot ends at 19:00
+        self.assertEqual(len(slots), 43)
+
+    def test_free_slots_closed_day(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])  # Sunday
+
+    def test_free_slots_respect_buffer_around_booking(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, buffer until 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 08:45, 15 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)  # ends 09:00, too close
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(9, therapist="marco", client="Jo Li"))
+        s.cancel(a.id)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), s.free_slots("lena", datetime.date(2026, 9, 8), 45))
+
+    def test_free_slots_on_saturday(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 12), 60)  # Saturday, 08:00-12:00
+        self.assertEqual(len(slots), 13)
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 0))
+
+    def test_free_slots_rejects_non_positive_length(self):
