+"""Printable plans for the receipt printer."""
+
+# The receipt printer prints 42 characters per line; longer lines wrap into a mess.
+WIDTH = 42
+
+
+def _fit(lead, text):
+    """`lead` followed by `text`, cut short so the line fits WIDTH."""
+    return (lead + text[: WIDTH - len(lead)]).rstrip()
+
+
+def day_plan(schedule, therapist, day):
+    """The therapist's active appointments on `day`, one block per appointment, as text."""
+    lines = [_fit("", f"{therapist.capitalize()} - {day:%a %d %b %Y}"), ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(_fit(f"{a.start:%H:%M}-{a.end:%H:%M}  ", a.client))
+        lines.append(_fit("  ", a.treatment))
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_printing.py b/tests/test_printing.py
