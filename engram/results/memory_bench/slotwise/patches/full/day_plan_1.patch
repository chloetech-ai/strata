@@ -0,0 +1,53 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_order(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 14, 0), "initial"))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 7, 8, 0), "short"))
+        text = day_plan(s, "lena", MONDAY)
+        self.assertEqual(
+            text.splitlines(),
+            [
+                "Lena - Mon 07 Sep 2026",
+                "",
+                "08:00-08:30  Jo Li",
+                "  short",
+                "14:00-15:00  Kim Weber",
+                "  initial",
+            ],
+        )
+
+    def test_no_line_longer_than_printer_width(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Zoë-Marie Brändli-Hohenstein von Oberkirch", datetime.datetime(2026, 9, 7, 9, 0)))
+        for line in day_plan(s, "lena", MONDAY).splitlines():
+            self.assertLessEqual(len(line), WIDTH, line)
+
+    def test_long_name_is_cut_not_wrapped(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Zoë-Marie Brändli-Hohenstein von Oberkirch", datetime.datetime(2026, 9, 7, 9, 0)))
+        lines = day_plan(s, "lena", MONDAY).splitlines()
+        self.assertEqual(lines[2], "09:00-09:45  Zoë-Marie Brändli-Hohenstein")
+        self.assertEqual(len(lines), 4)
+
+    def test_cancelled_appointments_left_out(self):
+        s = Schedule()
+        a = s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0)))
+        s.cancel(a.id)
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY).splitlines())
+
+    def test_empty_day(self):
+        self.assertEqual(day_plan(Schedule(), "lena", MONDAY).splitlines()[-1], "No appointments.")
+
+
+if __name__ == "__main__":
+    unittest.main()
