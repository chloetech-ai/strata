@@ -0,0 +1,54 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+DAY = datetime.date(2026, 9, 8)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_order(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 14, 0), "short"))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 8, 0), "initial"))
+        text = day_plan(s, "lena", DAY)
+        self.assertEqual(
+            text.splitlines(),
+            [
+                "Lena - Tuesday 08 September 2026",
+                "",
+                "08:00-09:00 Jo Li (initial)",
+                "14:00-14:30 Kim Weber (short)",
+            ],
+        )
+
+    def test_every_line_fits_the_printer(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Maria-Elisabeth von Hohenstein-Gerlingen", datetime.datetime(2026, 9, 8, 9, 0)))
+        for line in day_plan(s, "lena", DAY).splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH, line)
+
+    def test_long_entry_wraps_with_indent(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Maria-Elisabeth von Hohenstein-Gerlingen", datetime.datetime(2026, 9, 8, 9, 0)))
+        lines = day_plan(s, "lena", DAY).splitlines()
+        self.assertEqual(lines[2], "09:00-09:45 Maria-Elisabeth von")
+        self.assertTrue(lines[3].startswith("      "))
+
+    def test_cancelled_and_other_days_left_out(self):
+        s = Schedule()
+        a = s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 0)))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 9, 9, 0)))
+        s.cancel(a.id)
+        self.assertEqual(day_plan(s, "lena", DAY).splitlines()[-1], "No appointments.")
+
+    def test_umlauts_kept_as_they_are(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Zoë Brändli", datetime.datetime(2026, 9, 8, 9, 0)))
+        self.assertIn("Zoë Brändli", day_plan(s, "lena", DAY))
+
+
+if __name__ == "__main__":
+    unittest.main()
