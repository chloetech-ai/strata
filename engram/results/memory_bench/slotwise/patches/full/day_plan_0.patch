+"""Text for the receipt printer at reception."""
+
+import textwrap
+
+# The receipt printer fits 42 characters on a line; longer lines wrap into a mess.
+LINE_WIDTH = 42
+
+
+def _fill(text, subsequent_indent=""):
+    return textwrap.fill(text, width=LINE_WIDTH, subsequent_indent=subsequent_indent)
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s active appointments on `day`, one entry per appointment.
+
+    Every line is at most LINE_WIDTH characters. Cancelled appointments are left out.
+    """
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    lines = [_fill(f"{therapist.capitalize()} - {day:%A %d %B %Y}"), ""]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        entry = f"{a.start:%H:%M}-{a.end:%H:%M} {a.client} ({a.treatment})"
+        lines.append(_fill(entry, subsequent_indent="      "))
+    return "\n".join(lines)
