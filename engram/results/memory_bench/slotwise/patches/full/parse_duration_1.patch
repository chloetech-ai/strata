+++ b/tests/test_durations.py
@@ -0,0 +1,26 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_formats(self):
+        cases = {
+            "45": 45, "45m": 45, "45 min": 45, "1h": 60, "1h30": 90,
+            "1h 30m": 90, "2h15": 135, "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            self.assertEqual(parse_duration(text), minutes, text)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_invalid_input(self):
+        for text in ["", "   ", "abc", "-5", "0", "0h", "0:00", "1h90", "1:75", "1.5h", "45 seconds"]:
+            with self.assertRaises(ValueError, msg=text):
+                parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
