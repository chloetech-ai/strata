+"""Reading appointment lengths typed by reception."""
+
+import re
+
+# '45', '45m', '45 min', '1h', '1h30', '1h 30m', '2h15', '1:30'
+_DURATION = re.compile(
+    r"(?:(?P<hours>\d+)\s*h\s*(?:(?P<minutes>\d+)\s*(?:m|min)?)?"
+    r"|(?P<clock_hours>\d+):(?P<clock_minutes>\d{1,2})"
+    r"|(?P<only_minutes>\d+)\s*(?:m|min)?)"
+)
+
+
+def parse_duration(text):
+    """Minutes for a duration typed as text. Raises ValueError if it isn't a positive duration."""
+    match = _DURATION.fullmatch(text.strip().casefold())
+    if match is None:
+        raise ValueError(f"{text!r} is not a duration such as '45', '1h30' or '1:30'")
+    if match["only_minutes"] is not None:
+        minutes = int(match["only_minutes"])
+    elif match["clock_hours"] is not None:
+        minutes = int(match["clock_hours"]) * 60 + _minutes_part(match["clock_minutes"], text)
+    else:
+        minutes = int(match["hours"]) * 60 + _minutes_part(match["minutes"], text)
+    if minutes == 0:
+        raise ValueError(f"{text!r} is not a positive duration")
+    return minutes
+
+
+def _minutes_part(digits, text):
+    """The minutes after an hour count, which must be under 60 when given."""
+    if digits is None:
+        return 0
+    value = int(digits)
+    if value >= 60:
+        raise ValueError(f"{text!r} has more than 59 minutes")
+    return value
diff --git a/tests/test_durations.py b/tests/test_durations.py
