+"""Printable day plans for the receptionist's 42-character receipt printer."""
+
+WIDTH = 42
+
+
+def _fit(line):
+    """Cuts `line` to the printer width so it can't wrap."""
+    if len(line) <= WIDTH:
+        return line
+    return line[: WIDTH - 3] + "..."
+
+
+def day_plan(schedule, therapist, day):
+    """The day's active appointments for `therapist` as text, one block per appointment."""
+    header = f"{therapist.capitalize()} - {day:%A %d %B %Y}"
+    lines = [_fit(header), "-" * WIDTH]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        lines.append(_fit(f"{a.start:%H:%M}-{a.end:%H:%M} {a.client}"))
+        lines.append(_fit(f"  {a.treatment}, {a.minutes} min"))
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
