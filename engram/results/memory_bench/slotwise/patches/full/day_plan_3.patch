@@ -0,0 +1,47 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_appointments_in_order(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 14, 0), "initial"))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 7, 8, 0), "short"))
+        text = day_plan(s, "lena", MONDAY)
+        self.assertEqual(
+            text.splitlines(),
+            [
+                "Lena - Monday 07 September 2026",
+                "-" * WIDTH,
+                "08:00-08:30 Jo Li",
+                "  short, 30 min",
+                "14:00-15:00 Kim Weber",
+                "  initial, 60 min",
+            ],
+        )
+
+    def test_empty_day(self):
+        self.assertIn("No appointments.", day_plan(Schedule(), "lena", MONDAY))
+
+    def test_leaves_out_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0)))
+        s.cancel(a.id)
+        s.book(Appointment("marco", "Jo Li", datetime.datetime(2026, 9, 7, 10, 0)))
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+    def test_no_line_exceeds_printer_width(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Maximiliana-Constantina von Hohenberg-Wolfsberg", datetime.datetime(2026, 9, 7, 9, 0)))
+        for line in day_plan(s, "lena", MONDAY).splitlines():
+            self.assertLessEqual(len(line), WIDTH, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
