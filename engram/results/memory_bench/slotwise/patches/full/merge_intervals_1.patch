@@ -0,0 +1,29 @@
+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_merges_overlapping_touching_and_contained(self):
+        pairs = [(8, 10), (1, 3), (3, 5), (4, 6), (7, 8), (20, 21)]
+        self.assertEqual(merge_intervals(pairs), [(1, 6), (7, 10), (20, 21)])
+
+    def test_datetimes(self):
+        pairs = [(DT(2026, 9, 8, 9), DT(2026, 9, 8, 9, 45)), (DT(2026, 9, 8, 9, 30), DT(2026, 9, 8, 10))]
+        self.assertEqual(merge_intervals(pairs), [(DT(2026, 9, 8, 9), DT(2026, 9, 8, 10))])
+
+    def test_does_not_modify_input(self):
+        pairs = [(5, 6), (1, 2), (2, 3)]
+        before = list(pairs)
+        self.assertEqual(merge_intervals(pairs), [(1, 3), (5, 6)])
+        self.assertEqual(pairs, before)
+
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
