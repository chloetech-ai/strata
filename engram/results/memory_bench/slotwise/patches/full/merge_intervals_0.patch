@@ -0,0 +1,34 @@
+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_and_touching_merge(self):
+        self.assertEqual(merge_intervals([(5, 8), (1, 3), (3, 4), (7, 10)]), [(1, 4), (5, 10)])
+
+    def test_contained_interval_is_absorbed(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_disjoint_intervals_stay_separate_and_sorted(self):
+        self.assertEqual(merge_intervals([(10, 12), (1, 2)]), [(1, 2), (10, 12)])
+
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_datetimes(self):
+        dt = datetime.datetime
+        self.assertEqual(
+            merge_intervals([(dt(2026, 9, 8, 9, 45), dt(2026, 9, 8, 10)), (dt(2026, 9, 8, 9), dt(2026, 9, 8, 9, 45))]),
+            [(dt(2026, 9, 8, 9), dt(2026, 9, 8, 10))],
+        )
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 8), (1, 3)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 8), (1, 3)])
+
+
+if __name__ == "__main__":
+    unittest.main()
