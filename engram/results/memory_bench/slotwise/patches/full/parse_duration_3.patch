+"""Reading appointment lengths typed by reception."""
+
+import re
+
+_UNIT = r"(?:m|min|mins|minutes)"
+_HOURS_AND_MINUTES = re.compile(rf"([0-9]+)\s*h(?:\s*([0-9]+)\s*{_UNIT}?)?")
+_MINUTES = re.compile(rf"([0-9]+)\s*{_UNIT}?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+
+
+def parse_duration(text):
+    """Minutes for text such as '45', '45 min', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for anything else, and for a zero or negative duration.
+    """
+    cleaned = text.strip().lower()
+    minutes = None
+    if match := _HOURS_AND_MINUTES.fullmatch(cleaned):
+        hours, rest = int(match[1]), match[2]
+        extra = int(rest) if rest else 0
+        if extra >= 60:
+            raise ValueError(f"{text!r} has more than 59 minutes after the hour")
+        minutes = hours * 60 + extra
+    elif match := _CLOCK.fullmatch(cleaned):
+        hours, extra = int(match[1]), int(match[2])
+        if extra >= 60:
+            raise ValueError(f"{text!r} has more than 59 minutes after the hour")
+        minutes = hours * 60 + extra
+    elif match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+    if minutes is None:
+        raise ValueError(f"{text!r} is not a duration such as '45', '1h30' or '1:30'")
+    if minutes == 0:
+        raise ValueError("a duration must be more than zero")
+    return minutes
