+    def test_is_fully_booked_at_seven_active_appointments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        self.assertFalse(s.is_fully_booked("lena", day))
+        for hour in range(8, 15):  # 08:00 to 14:00, seven appointments
+            s.book(at(hour, client=f"Client {hour}"))
+            self.assertEqual(s.is_fully_booked("lena", day), hour == 14)
+
+    def test_cancelled_does_not_count_towards_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(at(hour, client=f"Client {hour}")) for hour in range(8, 15)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_other_therapist_and_day_do_not_count(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            s.book(at(hour, therapist="marco", client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 9)))
+
     def test_week_requires_monday(self):
         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 8))  # Tuesday
