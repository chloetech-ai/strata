@@ -0,0 +1,36 @@
+"""Reading durations typed by reception."""
+
+import re
+
+_HOURS_MINUTES = re.compile(r"(\d+)\s*h\s*(?:(\d+)\s*(?:min|m)?)?")
+_MINUTES = re.compile(r"(\d+)\s*(?:min|m)?")
+_CLOCK = re.compile(r"(\d+):(\d{2})")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '45 min', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for anything else, for zero, and for minutes of 60 or more after an hour.
+    """
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("empty duration")
+
+    if match := _HOURS_MINUTES.fullmatch(cleaned):
+        hours, minutes = int(match.group(1)), int(match.group(2) or 0)
+        if minutes >= 60:
+            raise ValueError(f"{text!r} has more than 59 minutes")
+        total = hours * 60 + minutes
+    elif match := _CLOCK.fullmatch(cleaned):
+        hours, minutes = int(match.group(1)), int(match.group(2))
+        if minutes >= 60:
+            raise ValueError(f"{text!r} has more than 59 minutes")
+        total = hours * 60 + minutes
+    elif match := _MINUTES.fullmatch(cleaned):
+        total = int(match.group(1))
+    else:
+        raise ValueError(f"{text!r} is not a duration")
+
+    if total <= 0:
+        raise ValueError(f"{text!r} is not a positive duration")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
