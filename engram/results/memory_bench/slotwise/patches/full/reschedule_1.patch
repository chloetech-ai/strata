+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(s.get(a.id).start, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_may_overlap_its_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))  # overlaps its own old slot, which is fine
+        self.assertEqual(s.get(a.id).start.minute, 5)
+
+    def test_reschedule_into_taken_slot_keeps_old_time(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(s.get(a.id).start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_outside_opening_hours_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 13, 9, 0))  # Sunday
+        self.assertEqual(s.get(a.id).start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_cancelled_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+
+    def test_reschedule_unknown_id(self):
+        with self.assertRaises(KeyError):
+            Schedule().reschedule(999999, datetime.datetime(2026, 9, 8, 14, 0))
