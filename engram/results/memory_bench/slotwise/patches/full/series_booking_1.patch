index 0000000..be640a2
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,44 @@
+"""Series bookings: the same appointment repeated weekly."""
+
+import datetime
+
+from .errors import BookingError, OutsideOpeningHours, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+# How far ahead a series may look for free weeks.
+MAX_WEEKS_SEARCHED = 26
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions starting with `first`, and returns them.
+
+    Weeks that are taken or closed are skipped and the series goes on after them.
+    If the sessions can't all be found within MAX_WEEKS_SEARCHED, nothing is booked
+    and BookingError is raised.
+    """
+    if count < 1:
+        raise ValueError("a series needs at least one session")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(
+            f"Insurance pays for at most {MAX_SESSIONS} sessions per prescription, "
+            f"so a series can't have {count}. Please book {MAX_SESSIONS} or fewer."
+        )
+    booked = []
+    for week in range(MAX_WEEKS_SEARCHED):
+        if len(booked) == count:
+            break
+        start = first.start + datetime.timedelta(weeks=week)
+        try:
+            booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+        except (SlotTaken, OutsideOpeningHours):
+            continue
+    if len(booked) < count:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise BookingError(
+            f"Only {len(booked)} of the {count} sessions could be booked within "
+            f"{MAX_WEEKS_SEARCHED} weeks, so nothing was booked. Please choose another start time."
+        )
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..5b14db3
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,63 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise import series
+from slotwise.errors import BookingError, SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def tuesday_9(client="Kim Weber", therapist="lena"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, 9, 0), "standard")
+
+
+def dates(appointments):
+    return [a.start.date() for a in appointments]
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_weekly_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, tuesday_9(), 3)
+        self.assertEqual([a.start for a in booked], [
+            datetime.datetime(2026, 9, 8, 9, 0),
+            datetime.datetime(2026, 9, 15, 9, 0),
+            datetime.datetime(2026, 9, 22, 9, 0),
+        ])
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_taken_week_is_skipped_and_added_at_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9, 0), "standard"))
+        booked = book_series(s, tuesday_9(), 3)
+        self.assertEqual(dates(booked), [datetime.date(2026, 9, d) for d in (8, 22, 29)])
+        self.assertTrue(all(a.client == "Kim Weber" for a in booked))
+
+    def test_nothing_booked_when_not_enough_weeks(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9, 0), "standard"))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9, 0), "standard"))
+        with mock.patch.object(series, "MAX_WEEKS_SEARCHED", 3):  # only week 2 is free
+            with self.assertRaises(BookingError):
+                book_series(s, tuesday_9(), 2)
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_more_than_nine_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, tuesday_9(), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, tuesday_9(), 9)), 9)
+
+    def test_zero_sessions_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), tuesday_9(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
