+"""Text of the reminder SMS sent before an appointment."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+MAX_LENGTH = 160  # longer messages are billed as two
+
+# German spellings first, so 'Brändli' becomes 'Braendli' rather than 'Brandli'.
+_GERMAN = {"ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue"}
+_WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+
+
+def to_ascii(text):
+    """Plain ASCII version of `text`. Characters with no ASCII form are dropped."""
+    for char, replacement in _GERMAN.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return "".join(ch for ch in decomposed if ord(ch) < 128)
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`. Raises ValueError if it is cancelled or too long."""
+    if appointment.cancelled:
+        raise ValueError("no reminder for a cancelled appointment")
+    start = appointment.start
+    text = (
+        f"Reminder: your appointment with {to_ascii(appointment.therapist.capitalize())} is on "
+        f"{_WEEKDAYS[start.weekday()]} {start:%d.%m.%Y} at {start:%H:%M}. "
+        f"To move it, call Lindqvist Physio on {RECEPTION_NUMBER}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..bc98bd8
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,34 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_NUMBER, reminder_text, to_ascii
+
+
+class ReminderTest(unittest.TestCase):
+    def test_contains_time_date_and_reception_number(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 0))
+        text = reminder_text(a)
+        self.assertIn("Tue 08.09.2026 at 09:00", text)
+        self.assertIn(RECEPTION_NUMBER, text)
+        self.assertLessEqual(len(text), MAX_LENGTH)
+
+    def test_is_plain_ascii_with_umlauts_transliterated(self):
+        a = Appointment("jörg", "Zoë Brändli", datetime.datetime(2026, 9, 8, 9, 0))
+        text = reminder_text(a)
+        self.assertTrue(text.isascii())
+        self.assertIn("Joerg", text)
+        self.assertNotIn("Zoë", text)
+
+    def test_cancelled_appointment_has_no_reminder(self):
+        a = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 0), cancelled=True)
+        with self.assertRaises(ValueError):
+            reminder_text(a)
+
+    def test_to_ascii(self):
+        self.assertEqual(to_ascii("Brändli Ö ß é"), "Braendli Oe ss e")
+        self.assertEqual(to_ascii("Ça va"), "Ca va")
+
+
+if __name__ == "__main__":
+    unittest.main()
