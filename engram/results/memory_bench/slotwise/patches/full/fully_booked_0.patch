+    def is_fully_booked(self, therapist, day):
+        """True if `therapist` already has DAILY_LIMIT active appointments on `day`.
+
+        `book()` does not check this, so reception can still exceed the limit with the therapist's agreement.
+        """
+        active = [a for a in self.appointments_for(therapist, day) if not a.cancelled]
+        return len(active) >= DAILY_LIMIT
