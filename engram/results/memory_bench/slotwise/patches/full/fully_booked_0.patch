+    def test_is_fully_booked_at_daily_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        self.assertFalse(s.is_fully_booked("lena", day))
+        for i in range(DAILY_LIMIT):
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 7 + i, 30), "short"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_cancelled_do_not_count_towards_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 7 + i, 30), "short"))
