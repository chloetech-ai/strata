@@ -0,0 +1,41 @@
+"""Reading appointment lengths typed by reception."""
+
+import re
+
+_DURATION = re.compile(
+    r"""
+    (?P<h>\d+)\s*h\s*(?:(?P<hm>\d+)\s*(?:min|m)?)?   # 1h, 1h30, 1h 30m
+    |(?P<m>\d+)\s*(?:min|m)?                          # 45, 45m, 45 min
+    |(?P<hh>\d+):(?P<mm>\d+)                          # 1:30
+    """,
+    re.VERBOSE,
+)
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '45 min', '1h30' or '1:30'.
+
+    Raises ValueError if the text isn't a duration, or if it is zero.
+    """
+    cleaned = text.strip().lower()
+    match = _DURATION.fullmatch(cleaned)
+    if match is None:
+        raise ValueError(f"{text!r} is not a duration, try something like 45, 1h or 1:30")
+    if match["h"] is not None:
+        minutes = int(match["h"]) * 60 + _minutes_part(match["hm"], text)
+    elif match["m"] is not None:
+        minutes = int(match["m"])
+    else:
+        minutes = int(match["hh"]) * 60 + _minutes_part(match["mm"], text)
+    if minutes == 0:
+        raise ValueError(f"{text!r} is not a duration: it must be longer than zero")
+    return minutes
+
+
+def _minutes_part(digits, text):
+    """The minutes after an hour, which must be below 60; missing means zero."""
+    if digits is None:
+        return 0
+    if int(digits) > 59:
+        raise ValueError(f"{text!r} is not a duration: minutes must be under 60")
+    return int(digits)
