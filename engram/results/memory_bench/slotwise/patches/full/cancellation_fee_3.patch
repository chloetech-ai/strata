+++ b/src/slotwise/fees.py
@@ -0,0 +1,18 @@
+"""Cancellation fees."""
+
+import datetime
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before the start: the full price.
+    Less than 48 hours before: half the price, rounded down to whole cents.
+    Earlier than that: free.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < datetime.timedelta(hours=24):
+        return appointment.price
+    if notice < datetime.timedelta(hours=48):
+        return appointment.price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..bf94901
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,40 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def appt(treatment="standard"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_free_more_than_48_hours_before(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(days=5)), 0)
+
+    def test_exactly_48_hours_before_is_free(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=48)), 0)
+
+    def test_just_under_48_hours_is_half(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=48) + datetime.timedelta(minutes=1)), 4900)
+
+    def test_exactly_24_hours_before_is_half(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=24)), 4900)
+
+    def test_just_under_24_hours_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), START - datetime.timedelta(hours=24) + datetime.timedelta(minutes=1)), 9800)
+
+    def test_after_start_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt(), START + datetime.timedelta(minutes=5)), 9800)
+
+    def test_half_uses_each_treatment_price(self):
+        cancelled_at = START - datetime.timedelta(hours=30)
+        self.assertEqual(cancellation_fee(appt("initial"), cancelled_at), 7250)
+        self.assertEqual(cancellation_fee(appt("short"), cancelled_at), 3400)
+
+
+if __name__ == "__main__":
+    unittest.main()
