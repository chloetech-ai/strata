+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (every 15 minutes from opening) where a `minutes`-long appointment fits.
+
+        Uses the same rules as book(): opening hours and BUFFER around existing appointments.
+        """
+        if minutes <= 0:
+            raise ValueError("minutes must be positive")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._conflict(therapist, start, start + length) is None:
+                slots.append(start)
+            start += GRID
+        return slots
+
+    def _conflict(self, therapist, start, end):
+        """The active appointment that blocks `therapist` from `start` to `end`, or None.
+
+        An appointment blocks if it overlaps, or is closer than BUFFER on either side.
+        """
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
