+    def test_free_slots_on_empty_day(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # last start that still ends by 19:00
+        self.assertEqual(len(slots), 44)
+
+    def test_free_slots_respect_buffer(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so a 45-minute slot needs to start by 08:05 or from 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_saturday_and_closed_day(self):
+        s = Schedule()
+        saturday = s.free_slots("lena", datetime.date(2026, 9, 12), 60)  # 08:00-12:00
+        self.assertEqual(len(saturday), 13)  # 08:00 .. 11:00
+        self.assertEqual(s.free_slots("lena", datetime.date(2026, 9, 13), 60), [])  # Sunday
