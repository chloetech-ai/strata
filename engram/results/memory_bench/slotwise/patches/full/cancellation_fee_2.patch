--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,39 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 9, 10, 9, 0)
+
+
+def appt(treatment="initial"):
+    return Appointment("lena", "Kim Weber", START, treatment)
+
+
+def before(**delta):
+    return START - datetime.timedelta(**delta)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_free_with_48_hours_or_more(self):
+        self.assertEqual(cancellation_fee(appt(), before(days=5)), 0)
+        self.assertEqual(cancellation_fee(appt(), before(hours=48)), 0)
+
+    def test_half_price_under_48_hours(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=47, minutes=59)), 7250)
+        self.assertEqual(cancellation_fee(appt(), before(hours=24)), 7250)
+
+    def test_full_price_under_24_hours(self):
+        self.assertEqual(cancellation_fee(appt(), before(hours=23, minutes=59)), 14500)
+        self.assertEqual(cancellation_fee(appt(), before(hours=1)), 14500)
+
+    def test_full_price_after_start(self):
+        self.assertEqual(cancellation_fee(appt(), START + datetime.timedelta(minutes=10)), 14500)
+
+    def test_uses_treatment_price(self):
+        self.assertEqual(cancellation_fee(appt("short"), before(hours=30)), 3400)
+
+
+if __name__ == "__main__":
+    unittest.main()
