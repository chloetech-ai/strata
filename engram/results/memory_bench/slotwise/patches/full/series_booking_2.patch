+++ b/tests/test_series.py
@@ -0,0 +1,56 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+# Tuesday 8 September 2026, 09:00
+FIRST = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9, 0))
+
+
+def week_of(k, client="Jo Li"):
+    return Appointment("lena", client, FIRST.start + datetime.timedelta(weeks=k))
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, FIRST, 3)
+        self.assertEqual([a.start for a in booked], [FIRST.start + datetime.timedelta(weeks=k) for k in range(3)])
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in booked}, {("lena", "Kim Weber", "standard")})
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_skips_taken_week_and_adds_one_at_the_end(self):
+        s = Schedule()
+        s.book(week_of(1))
+        booked = book_series(s, FIRST, 3)
+        self.assertEqual([a.start for a in booked], [
+            FIRST.start,
+            FIRST.start + datetime.timedelta(weeks=2),
+            FIRST.start + datetime.timedelta(weeks=3),
+        ])
+
+    def test_more_than_nine_sessions_is_refused(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, FIRST, 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_not_enough_free_weeks_books_nothing(self):
+        s = Schedule()
+        for k in range(1, 5):  # 4 taken weeks leave 8 of the 12 searched
+            s.book(week_of(k))
+        before = list(s.appointments)
+        with self.assertRaises(BookingError):
+            book_series(s, FIRST, 9)
+        self.assertEqual(s.appointments, before)
+
+    def test_count_must_be_positive(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), FIRST, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
