@@ -0,0 +1,48 @@
+"""Weekly series of appointments, as prescribed by doctors."""
+
+import datetime
+
+from .errors import BookingError, OutsideOpeningHours, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# Insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+# How many weeks ahead to look for free weeks before giving up.
+WEEKS_TO_SEARCH = 12
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them in order.
+
+    Same therapist, client, treatment and weekday/time as `first`. A week that is taken
+    or closed is skipped and the series continues in the next free week. If `count`
+    sessions can't be booked within WEEKS_TO_SEARCH weeks, nothing is booked.
+    """
+    if count < 1:
+        raise ValueError("a series needs at least one session")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(
+            f"A series can have at most {MAX_SESSIONS} sessions, because insurance only pays for "
+            f"{MAX_SESSIONS} per prescription. Please book the other {count - MAX_SESSIONS} separately."
+        )
+
+    before = len(schedule.appointments)
+    booked = []
+    try:
+        for week in range(WEEKS_TO_SEARCH):
+            if len(booked) == count:
+                break
+            start = first.start + datetime.timedelta(weeks=week)
+            try:
+                booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+            except (SlotTaken, OutsideOpeningHours):
+                continue
+        if len(booked) < count:
+            raise BookingError(
+                f"Only {len(booked)} of the {count} weekly sessions could be booked in the next "
+                f"{WEEKS_TO_SEARCH} weeks, so no appointments were booked. Please choose another start time."
+            )
+    except BookingError:
+        del schedule.appointments[before:]
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
