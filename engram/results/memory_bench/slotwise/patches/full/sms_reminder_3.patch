@@ -0,0 +1,42 @@
+"""Text of the reminder SMS sent before an appointment."""
+
+import unicodedata
+
+PRACTICE_PHONE = "044 512 77 30"
+MAX_LENGTH = 160  # longer messages are billed as two
+
+# Umlauts and ligatures have no accent to strip, so they need explicit spellings.
+_SPELLINGS = {"ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss", "æ": "ae", "ø": "oe", "œ": "oe"}
+
+
+def to_ascii(text):
+    """Plain ASCII for the SMS gateway: 'Brändli' -> 'Braendli', 'Zoë' -> 'Zoe'.
+
+    Characters with no ASCII form are dropped.
+    """
+    out = []
+    for ch in text:
+        spelling = _SPELLINGS.get(ch.lower())
+        if spelling:
+            out.append(spelling.capitalize() if ch.isupper() else spelling)
+            continue
+        decomposed = unicodedata.normalize("NFKD", ch)
+        out.append("".join(c for c in decomposed if ord(c) < 128))
+    return "".join(out)
+
+
+def reminder_text(appointment):
+    """The reminder for `appointment`, in ASCII and no longer than MAX_LENGTH characters.
+
+    The client's name is shortened if that's what it takes to fit.
+    """
+    when = f"{appointment.start:%a %d.%m.} at {appointment.start:%H:%M}"
+    therapist = to_ascii(appointment.therapist).capitalize()
+    name = to_ascii(appointment.client)
+    rest = f" Reminder: physio with {therapist} on {when}. To move it, call {PRACTICE_PHONE}."
+
+    room = MAX_LENGTH - len(rest) - len("Hi , ")
+    if room < 1:
+        raise ValueError("reminder does not fit in one SMS")
+    text = f"Hi {name[:room].rstrip()},{rest}"
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..c9de1e0
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,44 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, PRACTICE_PHONE, reminder_text, to_ascii
+
+
+def appointment(client="Kim Weber"):
+    return Appointment("lena", client, datetime.datetime(2026, 9, 8, 9, 0), "standard")
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_and_accents(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Zoë Ärger Öl Über Straße"), "Zoe Aerger Oel Ueber Strasse")
+        self.assertEqual(to_ascii("José"), "Jose")
+
+    def test_drops_characters_without_ascii_form(self):
+        self.assertEqual(to_ascii("Li 李"), "Li ")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contents(self):
+        text = reminder_text(appointment("Zoë Brändli"))
+        self.assertEqual(
+            text,
+            "Hi Zoe Braendli, Reminder: physio with Lena on Tue 08.09. at 09:00. "
+            f"To move it, call {PRACTICE_PHONE}.",
+        )
+
+    def test_is_ascii_and_has_phone(self):
+        text = reminder_text(appointment("Zoë Brändli"))
+        self.assertTrue(text.isascii())
+        self.assertIn("044 512 77 30", text)
+
+    def test_fits_in_one_sms_with_long_name(self):
+        text = reminder_text(appointment("Maria-Theresia Großmann-Überlingen von Ärzten Ärztinnen"))
+        self.assertLessEqual(len(text), MAX_LENGTH)
+        self.assertIn(PRACTICE_PHONE, text)
+        self.assertTrue(text.startswith("Hi Maria-Theresia"))
+
+
+if __name__ == "__main__":
+    unittest.main()
