@@ -0,0 +1,35 @@
+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_and_touching_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_contained_interval_is_absorbed(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_sorted_by_start_whatever_the_input_order(self):
+        self.assertEqual(merge_intervals([(8, 9), (1, 2)]), [(1, 2), (8, 9)])
+
+    def test_datetimes(self):
+        dt = datetime.datetime
+        result = merge_intervals([
+            (dt(2026, 9, 8, 9, 45), dt(2026, 9, 8, 10, 0)),
+            (dt(2026, 9, 8, 9, 0), dt(2026, 9, 8, 9, 45)),
+        ])
+        self.assertEqual(result, [(dt(2026, 9, 8, 9, 0), dt(2026, 9, 8, 10, 0))])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
