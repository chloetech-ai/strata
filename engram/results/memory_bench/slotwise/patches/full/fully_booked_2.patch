+    def test_is_fully_booked_at_seven(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):  # six short appointments
+            s.book(at(hour, treatment="short"))
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(at(14, treatment="short"))  # seventh
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_cancelled_does_not_count_towards_full(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        first = s.book(at(8, treatment="short"))
+        for hour in range(9, 15):
+            s.book(at(hour, treatment="short"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(first.id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
     def test_week_requires_monday(self):
