@@ -72,6 +72,51 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(BookingError):
             s.cancel(a.id)
 
+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertIs(s.get(a.id), a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(a.end, datetime.datetime(2026, 9, 8, 14, 45))
+        s.book(at(9, client="Jo Li"))  # old slot is free
+
+    def test_reschedule_into_own_old_slot_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 5))
+
+    def test_reschedule_refused_leaves_appointment_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 50))  # 13:50-14:35 overlaps Jo at 14:00
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 45))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_checks_buffer_against_others(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.book(at(12, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 55))  # ends 12:40, too close to 12:00
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))  # ends 11:45, 15 min before 12:00: ok
+
+    def test_cancelled_cannot_be_rescheduled(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+
+    def test_reschedule_unknown_id(self):
+        with self.assertRaises(KeyError):
+            Schedule().reschedule(999999, datetime.datetime(2026, 9, 8, 14, 0))
+
