+    def test_free_slots_on_empty_day(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends at 19:00
+        self.assertEqual(len(slots), (19 * 60 - 7 * 60 - 30 - 45) // 15 + 1)  # 07:30 to 18:15 in 15-minute steps
