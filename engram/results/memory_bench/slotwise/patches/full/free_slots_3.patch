+    def test_free_slots_respect_appointments_and_buffer(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, buffer until 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)  # ends 09:15, inside buffer
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, no buffer before 09:00
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 10 minutes clear
