+    def _blocking(self, therapist, start, end):
+        """A active appointment of `therapist` that overlaps, or is within BUFFER of, start-end. Else None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` at which `therapist` could take an appointment of `minutes`.
+
+        Times are on a 15-minute grid from opening time, and the appointment must finish
+        by closing time. Empty if the practice is closed that day.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        step = datetime.timedelta(minutes=15)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._blocking(therapist, start, start + length) is None:
+                slots.append(start)
+            start += step
+        return slots
+
