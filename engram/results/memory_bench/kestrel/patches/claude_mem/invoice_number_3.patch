+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number for a clinic in a year, e.g. 'INV-NG-2027-00004'.
+
+    Numbers run in sequence per clinic and per year, so only the entries in
+    `existing` for that clinic and year count. The next number is one past the
+    highest sequence issued so far, or 00001 if there are none.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [
+        int(number[len(prefix):])
+        for number in existing
+        if number.startswith(prefix) and number[len(prefix):].isdecimal()
+    ]
+    return f"{prefix}{max(sequences, default=0) + 1:05d}"
+
