+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("NG", 2027, []), "INV-NG-2027-00001")
+
+    def test_one_past_the_highest_sequence(self):
+        existing = ["INV-NG-2027-00001", "INV-NG-2027-00003", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00004")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-HB-2027-00009", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-NG-2026-00040", "INV-NG-2028-00050"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_clinic_codes_match_whole_segment(self):
+        existing = ["INV-NGX-2027-00007"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_ignores_malformed_numbers_for_the_same_prefix(self):
+        existing = ["INV-NG-2027-", "INV-NG-2027-ABCDE", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
+    def test_sequence_grows_past_five_digits(self):
+        existing = ["INV-NG-2027-99999"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-100000")
+
+
 if __name__ == "__main__":
     unittest.main()
