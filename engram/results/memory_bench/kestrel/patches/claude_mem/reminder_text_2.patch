+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+WEEKDAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
+MONTHS = (
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+)
+
+
+def reminder_text(appointment):
+    """The reminder sent two days before an appointment.
+
+    The time is given in local (Auckland) time, e.g. "Saturday 17 October at 2:30 pm".
+    """
+    start = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{WEEKDAYS[start.weekday()]} {start.day} {MONTHS[start.month - 1]}"
+    hour = start.hour % 12 or 12
+    time = f"{hour}:{start.minute:02d} {'am' if start.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora from {clinic}. Reminder: you have an appointment on {day} at {time}. "
+        "See you then! To change it, please contact us."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..998ca56
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,37 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import CLINICS
+from kestrel.reminders import reminder_text
+
+# SMS segments hold 160 GSM-7 characters; keep reminders to one segment.
+SEGMENT_LIMIT = 160
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_clinic_day_and_time_in_auckland_time(self):
+        # 01:30 UTC on 17 October 2026 is 2:30 pm in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("A1", utc(2026, 10, 17, 1, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Saturday 17 October at 2:30 pm", text)
+
+    def test_morning_time_uses_am(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 16, 21, 5), clinic="NG"))  # 10:05 am NZDT
+        self.assertIn("Saturday 17 October at 10:05 am", text)
+
+    def test_midnight_and_noon_use_twelve(self):
+        midnight = reminder_text(appt("A1", utc(2026, 10, 16, 11, 0)))  # 00:00 am NZDT on 17 Oct
+        noon = reminder_text(appt("A2", utc(2026, 10, 16, 23, 0)))  # 12:00 pm NZDT on 17 Oct
+        self.assertIn("at 12:00 am", midnight)
+        self.assertIn("at 12:00 pm", noon)
+
+    def test_is_friendly_and_fits_one_sms_segment(self):
+        for code in CLINICS:
+            text = reminder_text(appt("A1", utc(2026, 9, 30, 0, 0), clinic=code))
+            self.assertTrue(text.startswith("Kia ora"))
+            self.assertIn("See you then!", text)
+            self.assertLessEqual(len(text), SEGMENT_LIMIT, text)
+
+
+if __name__ == "__main__":
+    unittest.main()
