index 0000000..5ba5bd4
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, ATTENDED, Therapist
+from kestrel.slots import free_slots
+
+THERAPIST = Therapist("T1", "Ana", "HB")
+# Auckland is UTC+13 in early March 2027.
+DAY = datetime.date(2027, 3, 2)
+
+
+def at(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_followup_covers_working_hours(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(slots[0], at(8))
+        self.assertEqual(slots[-1], at(16, 30))  # last 30-minute slot ends at 17:00
+        self.assertEqual(len(slots), 18)
+
+    def test_empty_day_assessment_is_an_hour_long(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, ASSESSMENT)
+        self.assertEqual(slots[-1], at(16))  # last hour-long slot ends at 17:00
+        self.assertEqual(len(slots), 17)
+
+    def test_booked_followup_blocks_only_its_own_time(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2))])  # 15:00 local, followup
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(at(15), slots)
+        self.assertIn(at(14, 30), slots)
+        self.assertIn(at(15, 30), slots)
+
+    def test_assessment_does_not_fit_before_a_booking(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 21))])  # 10:00 local, followup
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertIn(at(9), slots)  # 9:00-10:00 is free
+        self.assertNotIn(at(9, 30), slots)  # would run into the 10:00 booking
+        self.assertNotIn(at(10), slots)
+        self.assertIn(at(10, 30), slots)
+
+    def test_booked_assessment_blocks_an_hour(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 23), kind=ASSESSMENT)])  # 12:00 local
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        for blocked in [at(12), at(12, 30)]:
+            self.assertNotIn(blocked, slots)
+        self.assertIn(at(11, 30), slots)  # 11:30-12:00 ends as the booking starts
+        self.assertIn(at(13), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2), status=CANCELLED)])
+        self.assertIn(at(15), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_attended_appointment_blocks(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2), status=ATTENDED)])
+        self.assertNotIn(at(15), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_other_therapists_bookings_are_ignored(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2), therapist="T2")])
+        self.assertIn(at(15), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
