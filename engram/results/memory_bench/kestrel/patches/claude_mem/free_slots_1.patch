+"""Finding start times where a new appointment could be booked."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+# Assumed clinic hours and appointment lengths. The repo does not define these
+# yet; change them here once the real values are confirmed.
+WORKING_START = datetime.time(8, 0)  # local (Auckland) time
+WORKING_END = datetime.time(17, 0)
+GRID = datetime.timedelta(minutes=30)  # candidate starts are this far apart
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=60),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (sorted datetime.time) where a new `kind` appointment fits.
+
+    `day` is a local (Auckland) date. A slot is free when the whole appointment
+    fits inside working hours and overlaps no non-cancelled appointment for the
+    therapist that day.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    duration = DURATIONS[kind]
+    busy = [
+        (a.start, a.start + DURATIONS[a.kind])
+        for a in calendar.for_day(therapist.id, day)
+        if a.status != CANCELLED
+    ]
+    slots = []
+    start = datetime.datetime.combine(day, WORKING_START)
+    close = datetime.datetime.combine(day, WORKING_END)
+    while start + duration <= close:
+        # Compare in UTC: wall-clock arithmetic on LOCAL_TZ is unreliable across DST.
+        begin = start.replace(tzinfo=LOCAL_TZ).astimezone(datetime.timezone.utc)
+        finish = begin + duration
+        if not any(b_start < finish and begin < b_end for b_start, b_end in busy):
+            slots.append(start.time())
+        start += GRID
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
