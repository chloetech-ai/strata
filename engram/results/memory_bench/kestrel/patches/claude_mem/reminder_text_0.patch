+"""Patient reminders."""
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CLINICS, FOLLOWUP
+
+KIND_PHRASES = {
+    ASSESSMENT: "initial assessment",
+    FOLLOWUP: "follow-up session",
+}
+
+
+def reminder_text(appointment):
+    """Text of the SMS reminder sent two days before an appointment.
+
+    Names the clinic, the kind of session (and its treatment, if it has one),
+    and the local (Auckland) day and time. The reminder comes from the clinic,
+    so it does not use the patient's name.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    when = f"{local:%A} {local.day} {local:%B} at {_clock(local)}"
+    session = KIND_PHRASES[appointment.kind]
+    if appointment.treatment:
+        session = f"{session} for {appointment.treatment}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! Reminder: your {session} is on {when}. "
+        "See you then! Need to reschedule? Please contact the clinic."
+    )
+
+
+def _clock(moment):
+    """12-hour local time, such as 2:30pm."""
+    hour = moment.hour % 12 or 12
+    suffix = "am" if moment.hour < 12 else "pm"
+    return f"{hour}:{moment.minute:02d}{suffix}"
