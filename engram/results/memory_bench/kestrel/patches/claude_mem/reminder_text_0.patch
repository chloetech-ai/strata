@@ -0,0 +1,38 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_session_and_local_time(self):
+        # 02:30 UTC on 17 October is 15:30 in Auckland (NZDT, UTC+13).
+        a = appt("a1", utc(2026, 10, 17, 2, 30), kind="followup", clinic="NG", treatment="lower back pain")
+        self.assertEqual(
+            reminder_text(a),
+            "Hi from Kestrel Physio Northgate! Reminder: your follow-up session for lower back pain "
+            "is on Saturday 17 October at 3:30pm. See you then! Need to reschedule? Please contact the clinic.",
+        )
+
+    def test_assessment_without_treatment_omits_for_clause(self):
+        a = appt("a1", utc(2026, 10, 17, 2, 0), kind="assessment", clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Hi from Kestrel Physio Harbour!", text)
+        self.assertIn("your initial assessment is on Saturday 17 October at 3:00pm.", text)
+        self.assertNotIn(" for ", text)
+
+    def test_uses_local_date_not_utc(self):
+        # 14:00 UTC on 17 October is 03:00 on 18 October in Auckland.
+        a = appt("a1", utc(2026, 10, 17, 14, 0), clinic="WK")
+        self.assertIn("Sunday 18 October at 3:00am", reminder_text(a))
+
+    def test_noon_and_midnight_are_12_hour_times(self):
+        # 23:00 UTC is 12:00 (noon) in Auckland; 11:00 UTC is midnight.
+        noon = appt("a1", utc(2026, 10, 16, 23, 0), clinic="NG")
+        midnight = appt("a2", utc(2026, 10, 17, 11, 0), clinic="NG")
+        self.assertIn("at 12:00pm.", reminder_text(noon))
+        self.assertIn("at 12:00am.", reminder_text(midnight))
+
+
+if __name__ == "__main__":
+    unittest.main()
