+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("NG", 2027, []), "INV-NG-2027-00001")
+
+    def test_one_above_highest_issued(self):
+        existing = ["INV-NG-2027-00001", "INV-NG-2027-00002", "INV-NG-2027-00007"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00008")
+
+    def test_order_of_existing_does_not_matter(self):
+        existing = ["INV-NG-2027-00003", "INV-NG-2027-00001", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00004")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-AK-2027-00009", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-NG-2026-00050", "INV-NG-2028-00060"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_clinic_code_is_matched_exactly(self):
+        # "NGA" must not count as a prefix match for "NG".
+        existing = ["INV-NGA-2027-00005"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_grows_past_five_digits(self):
+        existing = ["INV-NG-2027-99999"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-100000")
+
+
 if __name__ == "__main__":
     unittest.main()
