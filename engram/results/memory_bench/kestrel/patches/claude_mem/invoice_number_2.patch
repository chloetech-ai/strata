+def next_invoice_number(clinic, year, existing):
+    """Return the number for the next invoice from a clinic in a year.
+
+    Numbers look like INV-NG-2027-00001 and count up from 00001 for each clinic
+    and year. `existing` may hold numbers from any clinic and year; only those
+    for this clinic and year are counted. The next number is one above the
+    highest one issued, so gaps are never filled.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-([0-9]+)")
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match:
+            highest = max(highest, int(match.group(1)))
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
+
