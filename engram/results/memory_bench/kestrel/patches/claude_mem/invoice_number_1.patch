+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("NG", 2027, []), "INV-NG-2027-00001")
+
+    def test_follows_highest_existing_sequence(self):
+        existing = ["INV-NG-2027-00001", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
+    def test_uses_highest_not_last_listed(self):
+        existing = ["INV-NG-2027-00007", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00008")
+
+    def test_gaps_are_not_reused(self):
+        self.assertEqual(next_invoice_number("NG", 2027, ["INV-NG-2027-00005"]), "INV-NG-2027-00006")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-HB-2027-00009"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-NG-2026-00009"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-NG-2027-0003", "INV-NG-2027-00002X", "NG-2027-00004", "INV-NGX-2027-00005"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_clinic_code_is_matched_literally(self):
+        existing = ["INV-N.-2027-00004"]
+        self.assertEqual(next_invoice_number("N.", 2027, existing), "INV-N.-2027-00005")
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-NG-2027-00002"])
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
