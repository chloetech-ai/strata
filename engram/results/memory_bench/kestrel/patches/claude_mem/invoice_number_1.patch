+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number for a clinic in a year.
+
+    Numbers look like INV-<clinic>-<year>-<sequence>, e.g. INV-NG-2027-00001.
+    Only numbers for this clinic and year count, and the next number follows the
+    highest sequence used so far, so gaps are never reused. Numbers in `existing`
+    that are not in this format are ignored.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-(\d{{5,}})")
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match:
+            highest = max(highest, int(match.group(1)))
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
+
