+import re
+
+# Accepts "45m", "1h", "1h30", "1h30m" and "1h 30m" (the space is optional).
+_DURATION = re.compile(r"(?:(\d+)h\s*(?:(\d+)m?)?|(\d+)m)")
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration such as '45m' or '1h 30m'."""
+    match = _DURATION.fullmatch(text)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours, minutes, bare_minutes = match.groups()
+    if bare_minutes is not None:
+        return int(bare_minutes)
+    minutes = int(minutes) if minutes is not None else 0
+    if minutes >= 60:
+        raise ValueError(f"invalid duration: {text!r}")
+    return int(hours) * 60 + minutes
