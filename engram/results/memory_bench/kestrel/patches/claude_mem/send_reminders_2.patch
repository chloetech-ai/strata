+"""Appointment reminder texts."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment, with the start shown in local (Auckland) time."""
+    local = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    hour = local.hour % 12 or 12
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local:%M %p}"
+    return f"Reminder: you have a physio appointment at {clinic} on {when}. See you then."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment. Returns the number of messages sent.
+
+    patients maps patient ID to Patient. Cancelled, attended and no-show
+    appointments are skipped. Every recipient is looked up before anything is
+    sent, so an unknown patient ID sends nothing.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients.get(appointment.patient_id)
+        if patient is None:
+            raise ValueError(f"appointment {appointment.id} has unknown patient {appointment.patient_id}")
+        messages.append((patient.phone, reminder_text(appointment)))
+
+    if messages:
+        client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
