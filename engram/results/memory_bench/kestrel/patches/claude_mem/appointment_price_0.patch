+++ b/src/kestrel/pricing.py
@@ -1,10 +1,14 @@
 """Session prices, in cents."""
 
+from .models import ASSESSMENT, FOLLOWUP
+
 _PRICES_CENTS = {
-    "initial": 9500,  # $95
-    "follow_up": 7000,  # $70
+    "initial": 10500,  # $105
+    "follow_up": 7800,  # $78
 }
 
+_SESSION_KINDS = {ASSESSMENT: "initial", FOLLOWUP: "follow_up"}
+
 
 def session_price(kind):
     """Return the price in cents for a session kind: 'initial' or 'follow_up'.
@@ -15,3 +19,15 @@ def session_price(kind):
         return _PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    This is the list price for the appointment's kind. The patient's csc flag
+    is not applied yet. Raises ValueError if the appointment is not the
+    patient's.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id!r} is not for patient {patient.id!r}")
+    return session_price(_SESSION_KINDS[appointment.kind])
