+"""Finding free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+# Working hours and appointment lengths are not recorded anywhere else in the
+# codebase. These values are placeholders; confirm them with Kestrel Physio.
+OPENING = datetime.time(7, 0)
+CLOSING = datetime.time(17, 0)  # an appointment must finish by this time
+STEP = datetime.timedelta(minutes=15)  # slots start on this grid
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=60),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on `day` (a date) when a new `kind` appointment could be booked.
+
+    A slot is free if the appointment fits inside working hours and does not
+    overlap any of the therapist's non-cancelled appointments that day. Returns
+    a sorted list of datetime.time values in Auckland local time.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    length = DURATIONS[kind]
+    busy = [
+        (a.start, a.start + DURATIONS[a.kind])
+        for a in calendar.for_day(therapist.id, day)
+        if a.status != CANCELLED
+    ]
+    start = datetime.datetime.combine(day, OPENING, tzinfo=LOCAL_TZ)
+    closes = datetime.datetime.combine(day, CLOSING, tzinfo=LOCAL_TZ)
+    slots = []
+    while start + length <= closes:
+        end = start + length
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
