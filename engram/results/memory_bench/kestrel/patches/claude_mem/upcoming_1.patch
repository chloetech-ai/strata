diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index 41cc180..14841bc 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -64,5 +64,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now` (timezone-aware), soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 1955b25..e568754 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -117,6 +117,41 @@ class CalendarTest(unittest.TestCase):
             cal.move("a1", datetime.datetime(2027, 3, 3, 4))
         self.assertEqual(cal.get("a1").start, utc(2027, 3, 2, 2))
 
+    def test_upcoming_soonest_first_for_one_patient(self):
+        cal = Calendar([
+            appt("late", utc(2027, 3, 5, 2), patient="KP-000001"),
+            appt("soon", utc(2027, 3, 2, 2), patient="KP-000001"),
+            appt("other", utc(2027, 3, 3, 2), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 0))], ["soon", "late"])
+
+    def test_upcoming_excludes_past_and_starting_now(self):
+        cal = Calendar([
+            appt("past", utc(2027, 3, 1, 0), patient="KP-000001"),
+            appt("now", utc(2027, 3, 1, 12), patient="KP-000001"),
+            appt("future", utc(2027, 3, 1, 13), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 12))], ["future"])
+
+    def test_upcoming_excludes_non_booked(self):
+        cal = Calendar([
+            appt("cancelled", utc(2027, 3, 2, 2), patient="KP-000001", status="cancelled"),
+            appt("attended", utc(2027, 3, 2, 3), patient="KP-000001", status="attended"),
+            appt("booked", utc(2027, 3, 2, 4), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 0))], ["booked"])
+
+    def test_upcoming_accepts_messy_patient_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2), patient="KP-004211")])
+        for typed in ["kp4211", " KP-004211 "]:
+            with self.subTest(typed=typed):
+                self.assertEqual([a.id for a in cal.upcoming(typed, utc(2027, 3, 1, 0))], ["a1"])
+
+    def test_upcoming_needs_timezone_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 0))
+
 
 if __name__ == "__main__":
     unittest.main()
