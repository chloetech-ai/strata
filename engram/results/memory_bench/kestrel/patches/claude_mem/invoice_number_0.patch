+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number for a clinic in a year, e.g. 'INV-NG-2027-00001'.
+
+    Numbers are sequential per clinic and year. `existing` holds every invoice
+    number issued so far, for any clinic and year; only those for this clinic
+    and year count. The next number is one above the highest, so a gap left by
+    a deleted invoice is never reused.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-(\d+)")
+    sequences = [
+        int(match.group(1))
+        for number in existing
+        if (match := pattern.fullmatch(number)) is not None
+    ]
+    return f"INV-{clinic}-{year}-{max(sequences, default=0) + 1:05d}"
+
+
 @dataclass
 class Invoice:
     number: str
