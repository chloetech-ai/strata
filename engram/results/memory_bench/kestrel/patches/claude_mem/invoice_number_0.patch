+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year(self):
+        self.assertEqual(next_invoice_number("NG", 2027, []), "INV-NG-2027-00001")
+
+    def test_one_above_highest_existing(self):
+        existing = ["INV-NG-2027-00001", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
+    def test_uses_highest_not_count(self):
+        # Invoice 2 was deleted; the next number must not reuse anything issued.
+        existing = ["INV-NG-2027-00001", "INV-NG-2027-00003"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00004")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-PT-2027-00009", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-NG-2026-00040"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_ignores_clinic_code_that_only_starts_the_same(self):
+        existing = ["INV-NGX-2027-00007"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-NG-2027-00002"])
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+
