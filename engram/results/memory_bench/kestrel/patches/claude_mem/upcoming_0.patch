+    def test_upcoming_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("late", utc(2027, 3, 5, 2), patient="KP-000001"),
+            appt("soon", utc(2027, 3, 2, 2), patient="KP-000001"),
+            appt("past", utc(2027, 3, 1, 2), patient="KP-000001"),
+            appt("now", utc(2027, 3, 1, 9), patient="KP-000001"),
+            appt("other", utc(2027, 3, 3, 2), patient="KP-000002"),
+        ])
+        upcoming = cal.upcoming("KP-000001", utc(2027, 3, 1, 9))
+        self.assertEqual([a.id for a in upcoming], ["soon", "late"])
+
+    def test_upcoming_excludes_non_booked(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 2, 2), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 3, 2), patient="KP-000001"),
+        ])
+        cal.cancel("a1", utc(2027, 3, 1, 8))
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 9))], ["a2"])
+
+    def test_upcoming_accepts_messy_patient_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2), patient="KP-004211")])
+        for typed in ["kp4211", " KP-004211 "]:
+            with self.subTest(typed=typed):
+                self.assertEqual([a.id for a in cal.upcoming(typed, utc(2027, 3, 1, 9))], ["a1"])
+
+    def test_upcoming_needs_timezone_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 9))
+
