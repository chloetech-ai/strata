index 0000000..d5a68d9
--- /dev/null
+++ b/src/kestrel/export.py
@@ -0,0 +1,46 @@
+"""Monthly export of invoices for the accountant."""
+
+import csv
+import decimal
+import os
+
+HEADER = ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to a CSV file in `out_dir`.
+
+    An invoice belongs to the month of its `issued` date (the local Auckland date).
+    Rows are sorted by issue date, then invoice number. Amounts are written in dollars
+    with two decimal places. The file is named invoices-YYYY-MM.csv, replacing any
+    earlier export for the same month. Returns the path of the file written.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1 to 12, not {month}")
+
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+
+    os.makedirs(out_dir, exist_ok=True)
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    # utf-8-sig adds a byte order mark so spreadsheet programs read macrons in names correctly.
+    with open(path, "w", encoding="utf-8-sig", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.issued.isoformat(),
+                i.clinic,
+                i.patient_id,
+                i.patient_name,
+                i.description,
+                _dollars(i.amount_cents),
+            ])
+    return path
+
+
+def _dollars(cents):
+    return f"{decimal.Decimal(cents) / 100:.2f}"
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..b70bd33
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,111 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_name="Aroha Ngata", description="Initial assessment"):
+    return Invoice(
+        number=number,
+        clinic="NG",
+        patient_id="KP-004211",
+        patient_name=patient_name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+def read_rows(path):
+    with open(path, encoding="utf-8-sig", newline="") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2027, 3, 4))], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2027-03.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_writes_header_and_one_row_per_invoice(self):
+        path = export_invoices(
+            [invoice("INV-1", datetime.date(2027, 3, 4), 7000, description="Follow-up session: back pain")],
+            2027, 3, self.out_dir,
+        )
+        self.assertEqual(read_rows(path), [
+            ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"],
+            ["INV-1", "2027-03-04", "NG", "KP-004211", "Aroha Ngata", "Follow-up session: back pain", "70.00"],
+        ])
+
+    def test_only_includes_invoices_issued_in_that_month(self):
+        invoices = [
+            invoice("INV-feb", datetime.date(2027, 2, 28)),
+            invoice("INV-mar", datetime.date(2027, 3, 1)),
+            invoice("INV-mar-end", datetime.date(2027, 3, 31)),
+            invoice("INV-apr", datetime.date(2027, 4, 1)),
+            invoice("INV-mar-last-year", datetime.date(2026, 3, 15)),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        numbers = [row[0] for row in read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-mar", "INV-mar-end"])
+
+    def test_sorted_by_issue_date_then_number(self):
+        invoices = [
+            invoice("INV-0003", datetime.date(2027, 3, 10)),
+            invoice("INV-0002", datetime.date(2027, 3, 2)),
+            invoice("INV-0001", datetime.date(2027, 3, 10)),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        numbers = [row[0] for row in read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-0002", "INV-0001", "INV-0003"])
+
+    def test_amounts_formatted_as_dollars(self):
+        invoices = [
+            invoice("a", datetime.date(2027, 3, 1), 9500),
+            invoice("b", datetime.date(2027, 3, 1), 7005),
+            invoice("c", datetime.date(2027, 3, 1), 0),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual([row[6] for row in read_rows(path)[1:]], ["95.00", "70.05", "0.00"])
+
+    def test_non_ascii_names_survive_round_trip(self):
+        path = export_invoices(
+            [invoice("a", datetime.date(2027, 3, 1), patient_name="Mere Tāmati-Hōne")],
+            2027, 3, self.out_dir,
+        )
+        self.assertEqual(read_rows(path)[1][4], "Mere Tāmati-Hōne")
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([invoice("a", datetime.date(2027, 4, 1))], 2027, 3, self.out_dir)
+        self.assertEqual(len(read_rows(path)), 1)
+
+    def test_replaces_earlier_export_for_same_month(self):
+        export_invoices([invoice("old", datetime.date(2027, 3, 1))], 2027, 3, self.out_dir)
+        path = export_invoices([invoice("new", datetime.date(2027, 3, 1))], 2027, 3, self.out_dir)
+        self.assertEqual([row[0] for row in read_rows(path)[1:]], ["new"])
+
+    def test_creates_out_dir_if_missing(self):
+        nested = os.path.join(self.out_dir, "accounts", "2027")
+        path = export_invoices([], 2027, 3, nested)
+        self.assertTrue(os.path.isfile(path))
+
+    def test_rejects_invalid_month(self):
+        for month in (0, 13):
+            with self.subTest(month=month):
+                with self.assertRaises(ValueError):
+                    export_invoices([], 2027, month, self.out_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
