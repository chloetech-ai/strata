 - Add `Calendar.for_day`, which matches on the Auckland local date.
 - Add `ids.normalize_patient_id`, which accepts forms such as `kp4211` and `' KP-004211 '`. `Calendar.for_patient` uses it.
 - Fix `Calendar.all()` to sort by start time, as its docstring says, instead of by appointment ID.
-- Add `session_price`: initial assessment is 9500 cents, follow-up 7000 cents.
+- Add `session_price`: initial assessment is 10500 cents ($105), follow-up 7800 cents ($78).
+- Add `appointment_price(appointment, patient)`, which returns what the patient pays for an appointment in cents. It uses the session price for the appointment's kind and raises `ValueError` if the patient does not match.
 - Add `make_invoice` for appointments, dated on the local Auckland date.
 - Add `Calendar.move` to reschedule booked appointments. Cancelled, attended and no-show appointments cannot be moved.
 - Add `therapist_load(calendar, week_start)`, which counts booked appointments per therapist for each day of a week.
diff --git a/src/kestrel/pricing.py b/src/kestrel/pricing.py
index 27930b1..7e6eb14 100644
--- a/src/kestrel/pricing.py
+++ b/src/kestrel/pricing.py
@@ -1,8 +1,15 @@
 """Session prices, in cents."""
 
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
 _PRICES_CENTS = {
-    "initial": 9500,  # $95
-    "follow_up": 7000,  # $70
+    "initial": 10500,  # $105
+    "follow_up": 7800,  # $78
+}
+
+_KIND_TO_SESSION = {
+    ASSESSMENT: "initial",
+    FOLLOWUP: "follow_up",
 }
 
 
@@ -15,3 +22,17 @@ def session_price(kind):
         return _PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price is the session price for the appointment's kind. Raises
+    ValueError if the appointment belongs to a different patient.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(
+            f"appointment {appointment.id} belongs to {appointment.patient_id}, "
+            f"not {patient.id}"
+        )
+    return session_price(_KIND_TO_SESSION[appointment.kind])
