+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CLINICS
+
+KIND_NAMES = {
+    ASSESSMENT: "initial assessment",
+}
+
+
+def reminder_text(appointment):
+    """Return the SMS sent two days before `appointment`, in Auckland local time."""
+    local = appointment.start.astimezone(LOCAL_TZ)
+    when = f"{local:%A} {local.day} {local:%B} at {_clock(local)}"
+    clinic = CLINICS[appointment.clinic].name
+    visit = KIND_NAMES.get(appointment.kind, "follow-up appointment")
+    return (
+        f"Hi! This is a friendly reminder from {clinic}. "
+        f"You have your {visit} on {when}. "
+        "We look forward to seeing you! "
+        "If you need to change or cancel, please get in touch with the clinic."
+    )
+
+
+def _clock(local):
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    if local.minute:
+        return f"{hour}:{local.minute:02d}{suffix}"
+    return f"{hour}{suffix}"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
