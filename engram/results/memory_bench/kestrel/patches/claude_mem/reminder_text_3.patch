+++ b/tests/test_reminders.py
@@ -0,0 +1,38 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_assessment_names_clinic_day_and_time(self):
+        # 03:00 UTC on 15 Oct is 16:00 NZDT on Thursday 15 Oct.
+        a = appt("a1", utc(2026, 10, 15, 3, 0), kind="assessment", clinic="NG")
+        self.assertEqual(
+            reminder_text(a),
+            "Hi! This is a friendly reminder from Kestrel Physio Northgate. "
+            "You have your initial assessment on Thursday 15 October at 4pm. "
+            "We look forward to seeing you! "
+            "If you need to change or cancel, please get in touch with the clinic.",
+        )
+
+    def test_followup_uses_auckland_date_not_utc(self):
+        # 11:30 UTC on 16 Oct is 00:30 NZDT on Saturday 17 October.
+        a = appt("a1", utc(2026, 10, 16, 11, 30), kind="followup", clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("from Kestrel Physio Harbour.", text)
+        self.assertIn("follow-up appointment on Saturday 17 October at 12:30am.", text)
+
+    def test_minutes_shown_only_when_not_on_the_hour(self):
+        # 02:45 UTC on 15 Oct is 15:45 NZDT.
+        a = appt("a1", utc(2026, 10, 15, 2, 45), clinic="WK")
+        self.assertIn("at 3:45pm.", reminder_text(a))
+
+    def test_noon_is_12pm(self):
+        # 23:00 UTC on 14 Oct is 12:00 NZDT on 15 Oct.
+        a = appt("a1", utc(2026, 10, 14, 23, 0))
+        self.assertIn("on Thursday 15 October at 12pm.", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
