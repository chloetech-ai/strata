+"""Parsing appointment durations."""
+
+import re
+
+_DURATION = re.compile(r"(?:([0-9]+)h\s*(?:([0-9]+)m?)?)|(?:([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Turn a duration like '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    An hour part may be followed by minutes with or without the 'm' suffix.
+    Raises ValueError for anything else, including bare numbers.
+    """
+    match = _DURATION.fullmatch(text)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, hour_minutes, minutes = match.groups()
+    if minutes is not None:
+        return int(minutes)
+    return int(hours) * 60 + int(hour_minutes or 0)
