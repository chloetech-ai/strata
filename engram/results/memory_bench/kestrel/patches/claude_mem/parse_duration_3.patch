@@ -0,0 +1,44 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hour(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hour_and_minutes_without_suffix(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+
+    def test_hour_and_minutes_with_space(self):
+        self.assertEqual(parse_duration("1h 30m"), 90)
+
+    def test_hour_and_minutes_with_suffix(self):
+        self.assertEqual(parse_duration("2h15m"), 135)
+
+    def test_rejects_bare_number(self):
+        with self.assertRaises(ValueError):
+            parse_duration("45")
+
+    def test_rejects_fraction(self):
+        with self.assertRaises(ValueError):
+            parse_duration("1.5h")
+
+    def test_rejects_negative(self):
+        with self.assertRaises(ValueError):
+            parse_duration("-30m")
+
+    def test_rejects_unknown_unit(self):
+        with self.assertRaises(ValueError):
+            parse_duration("30s")
+
+    def test_rejects_minutes_before_hours(self):
+        with self.assertRaises(ValueError):
+            parse_duration("30m1h")
+
+    def test_rejects_empty(self):
+        with self.assertRaises(ValueError):
+            parse_duration("")
