+- Add `session_price`: initial assessment is 10500 cents, follow-up 7800 cents (new prices from the board's announcement).
+- Add `appointment_price(appointment, patient)`, which returns what the patient pays for an appointment in cents.
 - Add `make_invoice` for appointments, dated on the local Auckland date.
 - Add `Calendar.move` to reschedule booked appointments. Cancelled, attended and no-show appointments cannot be moved.
 - Add `therapist_load(calendar, week_start)`, which counts booked appointments per therapist for each day of a week.
diff --git a/src/kestrel/pricing.py b/src/kestrel/pricing.py
index 27930b1..072f9bc 100644
--- a/src/kestrel/pricing.py
+++ b/src/kestrel/pricing.py
@@ -1,8 +1,15 @@
 """Session prices, in cents."""
 
+from .models import ASSESSMENT, FOLLOWUP
+
 _PRICES_CENTS = {
-    "initial": 9500,  # $95
-    "follow_up": 7000,  # $70
+    "initial": 10500,  # $105
+    "follow_up": 7800,  # $78
+}
+
+_KIND_TO_SESSION = {
+    ASSESSMENT: "initial",
+    FOLLOWUP: "follow_up",
 }
 
 
@@ -15,3 +22,14 @@ def session_price(kind):
         return _PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for an appointment, in cents.
+
+    The price depends only on the appointment's kind for now. The patient is
+    checked to be the one booked on the appointment, and is not otherwise used.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id} is not for patient {patient.id}")
+    return session_price(_KIND_TO_SESSION[appointment.kind])
