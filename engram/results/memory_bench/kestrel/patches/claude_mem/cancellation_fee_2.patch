+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCEL_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCEL_PERCENT = 50
+
+_PRICE_KINDS = {ASSESSMENT: "initial", FOLLOWUP: "follow_up"}
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents for a cancelled or no-show appointment.
+
+    A cancellation made less than 48 hours before the start is charged 50% of the
+    session price (rounded half up); one made 48 hours or more before is free.
+    A no-show is charged the full session price, and cancelled_at is ignored.
+
+    Raises ValueError for a cancelled appointment without a timezone-aware
+    cancelled_at, and for any status other than cancelled or no_show.
+    """
+    price = session_price(_PRICE_KINDS[appointment.kind])
+
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled_at is required for a cancelled appointment")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+
+    if appointment.start - cancelled_at < LATE_CANCEL_WINDOW:
+        return (price * LATE_CANCEL_PERCENT + 50) // 100
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
