@@ -0,0 +1,63 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
+
+START = utc(2027, 3, 1, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_late_cancel_followup_is_half_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status="cancelled", cancelled_at=START - datetime.timedelta(hours=2))
+        self.assertEqual(cancellation_fee(a, a.cancelled_at), 3500)
+
+    def test_late_cancel_assessment_is_half_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status="cancelled")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=1)), 4750)
+
+    def test_cancel_just_inside_window_is_charged(self):
+        at = START - datetime.timedelta(hours=48) + datetime.timedelta(minutes=1)
+        self.assertEqual(cancellation_fee(appt("a1", START, status="cancelled"), at), 3500)
+
+    def test_cancel_exactly_48_hours_ahead_is_free(self):
+        at = START - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(appt("a1", START, status="cancelled"), at), 0)
+
+    def test_early_cancel_is_free(self):
+        at = START - datetime.timedelta(days=5)
+        self.assertEqual(cancellation_fee(appt("a1", START, status="cancelled"), at), 0)
+
+    def test_cancel_after_start_is_charged(self):
+        at = START + datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(appt("a1", START, status="cancelled"), at), 3500)
+
+    def test_no_show_followup_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status="no_show")), 7000)
+
+    def test_no_show_assessment_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status="no_show")), 9500)
+
+    def test_no_show_ignores_cancelled_at(self):
+        a = appt("a1", START, status="no_show")
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(days=5)), 7000)
+
+    def test_cancelled_requires_cancelled_at(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status="cancelled"))
+
+    def test_cancelled_at_must_be_timezone_aware(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status="cancelled"), datetime.datetime(2027, 2, 27, 9))
+
+    def test_booked_and_attended_have_no_fee(self):
+        for status in ["booked", "attended"]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", START, status=status), START - datetime.timedelta(hours=1))
+
+
+if __name__ == "__main__":
+    unittest.main()
