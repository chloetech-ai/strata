+"""Exports for the accountant."""
+
+import csv
+import datetime
+import os
+import tempfile
+
+COLUMNS = ("number", "issued", "clinic", "patient_id", "patient_name", "description", "amount")
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to a CSV file in out_dir.
+
+    Only invoices whose issued date falls in `year`/`month` are written, sorted by
+    issue date then invoice number. Amounts are in dollars, e.g. 95.00. The file is
+    named invoices-YYYY-MM.csv, replacing any earlier export for the same month.
+    Returns the path of the file written.
+    """
+    datetime.date(year, month, 1)  # raises ValueError for a bad month
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    fd, tmp_path = tempfile.mkstemp(dir=out_dir, prefix=os.path.basename(path) + ".", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
+            writer = csv.writer(f)
+            writer.writerow(COLUMNS)
+            for i in chosen:
+                writer.writerow([
+                    i.number, i.issued.isoformat(), i.clinic, i.patient_id, i.patient_name,
+                    i.description, f"{i.amount_cents // 100}.{i.amount_cents % 100:02d}",
+                ])
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp_path, path)
+    except BaseException:
+        try:
+            os.unlink(tmp_path)
+        except FileNotFoundError:
+            pass
+        raise
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
