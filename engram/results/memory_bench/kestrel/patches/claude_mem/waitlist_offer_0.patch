diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index 63955f6..0b33d71 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -37,3 +37,13 @@ class Waitlist:
     def entries(self):
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it.
+
+        Same order as entries(). The entry stays on the waitlist until it is removed.
+        """
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 2183bd4..11d07cb 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -72,6 +72,38 @@ class WaitlistTest(unittest.TestCase):
         with self.assertRaises(KeyError):
             Waitlist().remove("KP-000009")
 
+    def test_next_for_none_when_waitlist_empty(self):
+        self.assertIsNone(Waitlist().next_for(FOLLOWUP))
+
+    def test_next_for_none_when_nobody_waits_for_kind(self):
+        wl = Waitlist()
+        wl.add(WaitlistEntry("KP-000001", FOLLOWUP, utc(2026, 10, 1), urgent=True))
+        self.assertIsNone(wl.next_for(ASSESSMENT))
+
+    def test_next_for_picks_urgent_entry_of_that_kind_first(self):
+        wl = Waitlist()
+        early = WaitlistEntry("KP-000001", FOLLOWUP, utc(2026, 10, 1))
+        late_urgent = WaitlistEntry("KP-000002", FOLLOWUP, utc(2026, 10, 9), urgent=True)
+        wl.add(early)
+        wl.add(late_urgent)
+        self.assertIs(wl.next_for(FOLLOWUP), late_urgent)
+
+    def test_next_for_ignores_other_kinds_ahead_in_queue(self):
+        wl = Waitlist()
+        assessment = WaitlistEntry("KP-000001", ASSESSMENT, utc(2026, 10, 1), urgent=True)
+        followup = WaitlistEntry("KP-000002", FOLLOWUP, utc(2026, 10, 2))
+        wl.add(assessment)
+        wl.add(followup)
+        self.assertIs(wl.next_for(FOLLOWUP), followup)
+        self.assertIs(wl.next_for(ASSESSMENT), assessment)
+
+    def test_next_for_does_not_remove_entry(self):
+        wl = Waitlist()
+        entry = WaitlistEntry("KP-000001", FOLLOWUP, utc(2026, 10, 1))
+        wl.add(entry)
+        wl.next_for(FOLLOWUP)
+        self.assertEqual(wl.entries(), [entry])
+
     def test_rejects_unknown_kind(self):
         with self.assertRaises(ValueError):
             WaitlistEntry("KP-000001", "massage", utc(2026, 10, 1))
