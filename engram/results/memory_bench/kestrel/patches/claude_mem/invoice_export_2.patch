+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+
+FIELDS = ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to a CSV file in out_dir and return its path.
+
+    Invoices are matched on their issued (Auckland local) date and sorted by date, then by
+    invoice number. Amounts are written in dollars, e.g. 95.00. A month with no invoices
+    still gets a file, holding only the header row.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1-12, not {month}")
+
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    # UTF-8 with a byte order mark so Excel reads macrons in patient names correctly.
+    with open(path, "w", encoding="utf-8-sig", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(FIELDS)
+        for i in month_invoices:
+            dollars, cents = divmod(i.amount_cents, 100)
+            writer.writerow([
+                i.number, i.issued.isoformat(), i.clinic, i.patient_id, i.patient_name,
+                i.description, f"{dollars}.{cents:02d}",
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
