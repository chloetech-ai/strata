@@ -0,0 +1,19 @@
+"""Booking checks for the appointment calendar."""
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist`.
+
+    Kestrel never overbooks, so this is False when the appointment is for a
+    different therapist, its id is already in the calendar, or the therapist
+    already has a booked appointment at the same start time. Cancelled
+    appointments do not hold a slot.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if any(a.id == appointment.id for a in calendar.all()):
+        return False
+    return not any(
+        a.therapist_id == therapist.id and a.start == appointment.start
+        for a in calendar.booked()
+    )
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
