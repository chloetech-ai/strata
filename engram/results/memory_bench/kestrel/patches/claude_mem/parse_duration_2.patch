@@ -0,0 +1,23 @@
+"""Parsing human-typed durations."""
+
+import re
+
+_DURATION = re.compile(
+    r"\s*(?:(?P<minutes>\d+)\s*m|(?P<hours>\d+)\s*h(?:\s*(?P<rest>\d+)\s*m?)?)\s*",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text):
+    """Turn a typed duration into whole minutes, e.g. '1h 30m' -> 90.
+
+    Accepts '45m', '1h', '1h30', '1h30m' and '1h 30m' (spaces optional).
+    A bare number such as '45' is rejected because its unit is unclear.
+    Raises ValueError for anything else.
+    """
+    match = _DURATION.fullmatch(text)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if match.group("minutes") is not None:
+        return int(match.group("minutes"))
+    return int(match.group("hours")) * 60 + int(match.group("rest") or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
