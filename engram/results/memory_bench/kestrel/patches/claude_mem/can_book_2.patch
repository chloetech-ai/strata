@@ -0,0 +1,46 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import Therapist
+
+THERAPIST = Therapist("T1", "Sam", "HB")
+OTHER = Therapist("T2", "Alex", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_same_therapist_same_start_is_blocked(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_different_start_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 21), therapist="T1")))
+
+    def test_other_therapist_same_start_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1", status="cancelled")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_appointment_does_not_block_itself(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("a1", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_same_start_across_timezones_is_blocked(self):
+        # 20:00 UTC is 09:00 the next day in Auckland (UTC+13); it is still the same instant.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        auckland = datetime.timezone(datetime.timedelta(hours=13))
+        same = datetime.datetime(2027, 3, 2, 9, 0, tzinfo=auckland)
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", same, therapist="T1")))
+
+
+if __name__ == "__main__":
+    unittest.main()
