+"""Checks to run before an appointment is saved."""
+
+from .models import BOOKED
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist`.
+
+    A therapist cannot have two booked appointments at the same start time.
+    Appointments have no duration, so only exact start clashes are detected.
+    Cancelled appointments do not block a time, and `appointment` itself is ignored.
+    """
+    for existing in calendar.for_therapist(therapist.id):
+        if existing.id == appointment.id or existing.status != BOOKED:
+            continue
+        if existing.start == appointment.start:
+            return False
+    return True
diff --git a/tests/test_booking.py b/tests/test_booking.py
