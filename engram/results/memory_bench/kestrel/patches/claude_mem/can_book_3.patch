+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import Therapist
+
+THERAPIST = Therapist("T1", "Sam", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 21))))
+
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", utc(2027, 3, 1, 21))))
+
+    def test_same_start_for_same_therapist_is_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_same_start_for_other_therapist_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status="cancelled")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_duplicate_id_is_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("a1", utc(2027, 3, 1, 22))))
+
+    def test_does_not_modify_calendar(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 21)))
+        self.assertEqual(len(cal), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
