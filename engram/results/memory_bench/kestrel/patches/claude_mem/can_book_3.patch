+"""Checks run before an appointment is saved to the calendar."""
+
+from .models import BOOKED
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist`.
+
+    A booking is refused if its id is already in the calendar, or if the
+    therapist already has a booked appointment starting at the same time.
+    Appointments have no length yet, so only an exact start clash is checked.
+    """
+    if appointment.id in calendar:
+        return False
+    for other in calendar.for_therapist(therapist.id):
+        if other.status == BOOKED and other.start == appointment.start:
+            return False
+    return True
