@@ -64,5 +64,8 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def __contains__(self, appointment_id):
+        return appointment_id in self._appointments
+
     def __len__(self):
         return len(self._appointments)
