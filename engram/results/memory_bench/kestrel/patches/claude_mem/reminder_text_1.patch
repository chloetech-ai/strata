@@ -0,0 +1,35 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_kind_and_local_time(self):
+        # 20:30 UTC on 1 March 2027 is 09:30 on 2 March in Auckland (NZDT, UTC+13).
+        a = appt("a1", utc(2027, 3, 1, 20, 30), kind="assessment", clinic="NG")
+        self.assertEqual(
+            reminder_text(a),
+            "Hi, this is a friendly reminder from Kestrel Physio Northgate. "
+            "You have your initial assessment on Tuesday 2 March at 9:30am. "
+            "If you need to change or cancel, please contact the clinic. See you soon!",
+        )
+
+    def test_followup_wording(self):
+        # 09:00 UTC is 22:00 in Auckland.
+        a = appt("a1", utc(2027, 3, 1, 9), kind="followup", clinic="HB")
+        self.assertIn("your follow-up appointment on Monday 1 March at 10:00pm", reminder_text(a))
+
+    def test_afternoon_time_uses_12_hour_clock(self):
+        # 04:15 UTC is 17:15 in Auckland.
+        a = appt("a1", utc(2027, 3, 1, 4, 15), clinic="WK")
+        self.assertIn("at 5:15pm", reminder_text(a))
+
+    def test_midnight_and_noon_use_12(self):
+        # 11:00 UTC is 00:00 (midnight) in Auckland; 23:00 UTC is 12:00 (noon).
+        self.assertIn("at 12:00am", reminder_text(appt("a1", utc(2027, 3, 1, 11), clinic="WK")))
+        self.assertIn("at 12:00pm", reminder_text(appt("a1", utc(2027, 3, 1, 23), clinic="WK")))
+
+
+if __name__ == "__main__":
+    unittest.main()
