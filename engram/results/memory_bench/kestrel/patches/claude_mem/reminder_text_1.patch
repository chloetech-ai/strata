+"""Text for the SMS reminder sent two days before an appointment."""
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CLINICS, Appointment
+
+KIND_NAMES = {ASSESSMENT: "initial assessment"}
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """The reminder SMS for an appointment, with its local (Auckland) date and time."""
+    start = appointment.start.astimezone(LOCAL_TZ)
+    hour = start.hour % 12 or 12
+    meridiem = "am" if start.hour < 12 else "pm"
+    when = f"{start.strftime('%A')} {start.day} {start.strftime('%B')} at {hour}:{start.minute:02d}{meridiem}"
+    kind = KIND_NAMES.get(appointment.kind, "follow-up appointment")
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi, this is a friendly reminder from {clinic}. "
+        f"You have your {kind} on {when}. "
+        "If you need to change or cancel, please contact the clinic. See you soon!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
