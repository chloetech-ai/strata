diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index 41cc180..14841bc 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -64,5 +64,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now` (timezone-aware), soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 1955b25..c316ed9 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -117,6 +117,46 @@ class CalendarTest(unittest.TestCase):
             cal.move("a1", datetime.datetime(2027, 3, 3, 4))
         self.assertEqual(cal.get("a1").start, utc(2027, 3, 2, 2))
 
+    def test_upcoming_soonest_first_after_now(self):
+        cal = Calendar([
+            appt("later", utc(2027, 3, 5, 2)),
+            appt("sooner", utc(2027, 3, 3, 2)),
+            appt("past", utc(2027, 3, 1, 2)),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 0))], ["sooner", "later"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 2)), appt("a2", utc(2027, 3, 2, 3))])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 2))], ["a2"])
+
+    def test_upcoming_excludes_non_booked(self):
+        cal = Calendar([
+            appt("cancelled", utc(2027, 3, 3, 2), status="cancelled"),
+            appt("attended", utc(2027, 3, 3, 3), status="attended"),
+            appt("booked", utc(2027, 3, 3, 4)),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 0))], ["booked"])
+
+    def test_upcoming_only_this_patient(self):
+        cal = Calendar([
+            appt("mine", utc(2027, 3, 3, 2), patient="KP-000001"),
+            appt("theirs", utc(2027, 3, 3, 3), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 0))], ["mine"])
+
+    def test_upcoming_accepts_messy_patient_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 3, 2), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 2, 0))], ["a1"])
+
+    def test_upcoming_empty_when_none(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 3, 2))])
+        self.assertEqual(cal.upcoming("KP-000099", utc(2027, 3, 2, 0)), [])
+
+    def test_upcoming_needs_timezone_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 3, 2))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 2, 0))
+
 
 if __name__ == "__main__":
     unittest.main()
