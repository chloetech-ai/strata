index 0000000..aaa9169
--- /dev/null
+++ b/src/kestrel/export.py
@@ -0,0 +1,45 @@
+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+
+FIELDS = ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to a CSV file and return its path.
+
+    Only invoices whose issue date (local Auckland date) falls in the given year and
+    month are included, sorted by date then invoice number. Amounts are written in
+    dollars, e.g. 9500 cents as "95.00". The file is named invoices-YYYY-MM.csv and
+    is created in out_dir, which is made if it does not exist. A month with no
+    invoices gives a file with only the header row.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1-12, not {month}")
+
+    in_month = [i for i in invoices if i.issued.year == year and i.issued.month == month]
+    in_month.sort(key=lambda i: (i.issued, i.number))
+
+    os.makedirs(out_dir, exist_ok=True)
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(FIELDS)
+        for invoice in in_month:
+            writer.writerow([
+                invoice.number,
+                invoice.issued.isoformat(),
+                invoice.clinic,
+                invoice.patient_id,
+                invoice.patient_name,
+                invoice.description,
+                _dollars(invoice.amount_cents),
+            ])
+    return path
+
+
+def _dollars(cents):
+    if cents < 0:
+        raise ValueError(f"amount_cents must not be negative, got {cents}")
+    return f"{cents // 100}.{cents % 100:02d}"
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..fa72fb3
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,108 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=7000, **kw):
+    fields = dict(clinic="NG", patient_id="KP-004211", patient_name="Aroha Ngata", description="Follow-up session")
+    fields.update(kw)
+    return Invoice(number=number, issued=issued, amount_cents=amount_cents, **fields)
+
+
+def read_rows(path):
+    with open(path, encoding="utf-8", newline="") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2027, 3, 4))], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2027-03.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_writes_header_and_one_row_per_invoice(self):
+        path = export_invoices(
+            [invoice("INV-1", datetime.date(2027, 3, 4), 9500, description="Initial assessment")],
+            2027, 3, self.out_dir,
+        )
+        self.assertEqual(read_rows(path), [
+            ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"],
+            ["INV-1", "2027-03-04", "NG", "KP-004211", "Aroha Ngata", "Initial assessment", "95.00"],
+        ])
+
+    def test_only_includes_invoices_from_the_given_month(self):
+        invoices = [
+            invoice("INV-feb", datetime.date(2027, 2, 28)),
+            invoice("INV-mar", datetime.date(2027, 3, 1)),
+            invoice("INV-mar-end", datetime.date(2027, 3, 31)),
+            invoice("INV-apr", datetime.date(2027, 4, 1)),
+            invoice("INV-mar-prev-year", datetime.date(2026, 3, 15)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-mar", "INV-mar-end"])
+
+    def test_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-0003", datetime.date(2027, 3, 9)),
+            invoice("INV-0002", datetime.date(2027, 3, 2)),
+            invoice("INV-0001", datetime.date(2027, 3, 9)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-0002", "INV-0001", "INV-0003"])
+
+    def test_amounts_in_dollars_with_two_decimals(self):
+        invoices = [
+            invoice("a", datetime.date(2027, 3, 1), 0),
+            invoice("b", datetime.date(2027, 3, 1), 5),
+            invoice("c", datetime.date(2027, 3, 1), 7000),
+            invoice("d", datetime.date(2027, 3, 1), 10250),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[6] for r in rows[1:]], ["0.00", "0.05", "70.00", "102.50"])
+
+    def test_month_with_no_invoices_gives_header_only(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2027, 3, 4))], 2027, 5, self.out_dir)
+        self.assertEqual(len(read_rows(path)), 1)
+
+    def test_creates_out_dir_if_missing(self):
+        out_dir = os.path.join(self.out_dir, "exports", "2027")
+        path = export_invoices([], 2027, 3, out_dir)
+        self.assertTrue(os.path.isfile(path))
+
+    def test_overwrites_existing_file(self):
+        export_invoices([invoice("old", datetime.date(2027, 3, 4))], 2027, 3, self.out_dir)
+        path = export_invoices([invoice("new", datetime.date(2027, 3, 4))], 2027, 3, self.out_dir)
+        self.assertEqual([r[0] for r in read_rows(path)[1:]], ["new"])
+
+    def test_quotes_fields_containing_commas(self):
+        path = export_invoices(
+            [invoice("INV-1", datetime.date(2027, 3, 4), description="Follow-up session: back, neck")],
+            2027, 3, self.out_dir,
+        )
+        self.assertEqual(read_rows(path)[1][5], "Follow-up session: back, neck")
+
+    def test_rejects_invalid_month(self):
+        for month in (0, 13):
+            with self.subTest(month=month):
+                with self.assertRaises(ValueError):
+                    export_invoices([], 2027, month, self.out_dir)
+
+    def test_rejects_negative_amount(self):
+        with self.assertRaises(ValueError):
+            export_invoices([invoice("bad", datetime.date(2027, 3, 4), -1)], 2027, 3, self.out_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
