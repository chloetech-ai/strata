@@ -0,0 +1,42 @@
+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
+_PRICE_KIND = {ASSESSMENT: "initial", FOLLOWUP: "follow_up"}
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents for an appointment that was cancelled or missed.
+
+    A cancellation made less than 48 hours before the start is charged 50% of
+    the session price. A cancellation further ahead is free. A no-show is
+    charged the full session price. `cancelled_at` is when the patient
+    cancelled (timezone-aware); it is required for a cancelled appointment and
+    should be None for a no-show.
+
+    Raises ValueError for any other status, or for a missing or inconsistent
+    `cancelled_at`.
+    """
+    price = session_price(_PRICE_KIND[appointment.kind])
+
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError("a no-show has no cancellation time")
+        return price
+
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            raise ValueError("a cancelled appointment needs its cancellation time")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancelled_at must be timezone-aware")
+        if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+            return price * LATE_CANCELLATION_PERCENT // 100
+        return 0
+
+    raise ValueError(f"no cancellation fee for status {appointment.status!r}")
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..53f1e05
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,64 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 10, 9)
+
+    def test_late_cancellation_assessment_is_half_initial_price(self):
+        a = appt("a1", self.start, kind="assessment", status="cancelled", cancelled_at=utc(2027, 3, 9, 9))
+        self.assertEqual(cancellation_fee(a, a.cancelled_at), 4750)
+
+    def test_late_cancellation_followup_is_half_follow_up_price(self):
+        a = appt("a1", self.start, kind="followup", status="cancelled", cancelled_at=utc(2027, 3, 9, 9, 1))
+        self.assertEqual(cancellation_fee(a, a.cancelled_at), 3500)
+
+    def test_cancel_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", self.start, status="cancelled", cancelled_at=utc(2027, 3, 8, 9))
+        self.assertEqual(cancellation_fee(a, a.cancelled_at), 0)
+
+    def test_cancel_well_ahead_is_free(self):
+        a = appt("a1", self.start, status="cancelled", cancelled_at=utc(2027, 3, 1, 9))
+        self.assertEqual(cancellation_fee(a, a.cancelled_at), 0)
+
+    def test_window_is_measured_across_timezones(self):
+        # 48 hours before 09:00 UTC is 09:00 UTC two days earlier, whatever offset the times carry.
+        auckland = datetime.timezone(datetime.timedelta(hours=13))
+        cancelled = datetime.datetime(2027, 3, 8, 22, 1, tzinfo=auckland)  # 08:01 UTC on 8 March
+        a = appt("a1", self.start, status="cancelled", cancelled_at=cancelled)
+        self.assertEqual(cancellation_fee(a, cancelled), 3500)
+
+    def test_no_show_is_charged_in_full(self):
+        assessment = appt("a1", self.start, kind="assessment", status="no_show")
+        followup = appt("a2", self.start, kind="followup", status="no_show")
+        self.assertEqual(cancellation_fee(assessment), 9500)
+        self.assertEqual(cancellation_fee(followup), 7000)
+
+    def test_no_show_with_cancellation_time_raises(self):
+        a = appt("a1", self.start, status="no_show")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, utc(2027, 3, 9, 9))
+
+    def test_cancelled_without_cancellation_time_raises(self):
+        a = appt("a1", self.start, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_cancellation_time_must_be_timezone_aware(self):
+        a = appt("a1", self.start, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 9, 9))
+
+    def test_other_statuses_raise(self):
+        for status in ["booked", "attended"]:
+            with self.subTest(status=status):
+                a = appt("a1", self.start, status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
