@@ -0,0 +1,32 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_and_time_and_clinic(self):
+        # 15 Oct 2026 in Auckland is NZDT (UTC+13): 01:30 UTC is 14:30 local on Thursday 15 October.
+        text = reminder_text(appt("a1", utc(2026, 10, 15, 1, 30), clinic="HB"))
+        self.assertIn("Thursday 15 October at 2:30pm", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+
+    def test_near_midnight_utc_uses_next_local_day(self):
+        # 14 Oct 2026 23:30 UTC is 15 Oct 12:30 in Auckland.
+        text = reminder_text(appt("a1", utc(2026, 10, 14, 23, 30), clinic="NG"))
+        self.assertIn("Thursday 15 October at 12:30pm", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_morning_time_is_am(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 15, 21, 5), clinic="WK"))  # 16 Oct 10:05 local
+        self.assertIn("Friday 16 October at 10:05am", text)
+
+    def test_never_mentions_treatment_or_patient_name(self):
+        a = appt("a1", utc(2026, 10, 15, 1, 30), clinic="HB", treatment="lower back pain", patient="KP-004211")
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
