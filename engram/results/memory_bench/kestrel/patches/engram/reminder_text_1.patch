+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS reminder for an appointment, sent two days before it.
+
+    Privacy: the reminder says only the date, time and clinic name. It never
+    mentions the treatment, and it never includes the patient's name.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)  # the clinic's local time, not UTC
+    day = f"{local:%A} {local.day} {local:%B}"
+    hour = local.hour % 12 or 12
+    time = f"{hour}:{local.minute:02d}{'am' if local.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! Reminder: you have an appointment on {day} at {time}. "
+        "Please call us if you need to change it. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
