+"""SMS reminders for booked appointments."""
+
+from .calendar import LOCAL_TZ
+from .ids import normalize_patient_id
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment. It gives only the local date, time and clinic name."""
+    start = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Reminder: you have an appointment at {clinic} on "
+        f"{start:%A %d %B %Y} at {start:%H:%M}."
+    )
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment; return how many messages were sent.
+
+    `patients` maps patient ID to Patient, and `client` is a BulkieClient.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[normalize_patient_id(appointment.patient_id)]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..0926792
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,72 @@
+import unittest
+
+from kestrel.models import BOOKED, CANCELLED, Appointment, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return len(self.calls)
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key", transport=self.transport)
+        self.patients = {
+            "KP-000001": Patient("KP-000001", "Ben Ross", "+64211000001"),
+            "KP-000002": Patient("KP-000002", "Ana Lee", "+64211000002"),
+        }
+
+    def sent(self):
+        return [m for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_sends_one_message_per_booked_appointment(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 21, 2), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 2)
+        self.assertEqual([m["to"] for m in self.sent()], ["+64211000001", "+64211000002"])
+
+    def test_skips_cancelled_appointments(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 21, 2), patient="KP-000002", status=CANCELLED),
+        ]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 1)
+        self.assertEqual([m["to"] for m in self.sent()], ["+64211000001"])
+
+    def test_no_booked_appointments_sends_nothing(self):
+        self.assertEqual(send_reminders([], self.patients, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_normalises_messy_patient_ids(self):
+        appointments = [appt("a1", utc(2026, 10, 20, 2), patient=" kp1 ")]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 1)
+        self.assertEqual(self.sent()[0]["to"], "+64211000001")
+
+    def test_text_gives_local_date_time_and_clinic_only(self):
+        a = appt("a1", utc(2026, 10, 20, 2, 30), clinic="HB", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 20 October 2026", text)
+        self.assertIn("15:30", text)  # 02:30 UTC is 15:30 NZDT (UTC+13)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("Ben Ross", text)
+
+    def test_text_uses_local_date_near_midnight_utc(self):
+        # 11:30 UTC on 20 Oct is 00:30 on 21 Oct in Auckland.
+        a = appt("a1", utc(2026, 10, 20, 11, 30), clinic="NG")
+        self.assertIn("Wednesday 21 October 2026 at 00:30", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
