diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index 7abecc0..064acd1 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -65,5 +65,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now` (timezone-aware), soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 0819105..8c978f1 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -120,6 +120,42 @@ class CalendarTest(unittest.TestCase):
         self.assertEqual([a.id for a in cal.for_day("T1", day)], ["a1", "a2"])
         self.assertEqual([a.id for a in cal.for_day("T2", day)], ["other"])
 
+    def test_upcoming_starts_after_now_soonest_first(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("late", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("soon", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("past", utc(2027, 2, 28, 9), patient="KP-004211"),
+            appt("other", utc(2027, 3, 2, 9), patient="KP-000007"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", now)], ["soon", "late"])
+
+    def test_upcoming_excludes_appointment_starting_exactly_now(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([appt("a1", now, patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-004211", now), [])
+
+    def test_upcoming_excludes_cancelled_and_attended(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("booked", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("cancelled", utc(2027, 3, 2, 10), patient="KP-004211", status="cancelled"),
+            appt("attended", utc(2027, 3, 2, 11), patient="KP-004211", status="attended"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", now)], ["booked"])
+
+    def test_upcoming_accepts_messy_ids(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        for typed in ("kp4211", " KP-004211 ", "Kp-4211"):
+            with self.subTest(typed=typed):
+                self.assertEqual([a.id for a in cal.upcoming(typed, now)], ["a1"])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 1, 12))
+
 
 if __name__ == "__main__":
     unittest.main()
