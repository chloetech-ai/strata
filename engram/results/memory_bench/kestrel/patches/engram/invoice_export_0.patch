+"""Monthly invoice export for the accountant (imported into Xero)."""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "Clinic", "PatientID", "Date", "Description", "Amount"]
+
+
+def _amount(cents):
+    """Integer cents as a plain two-decimal number, e.g. 7000 -> '70.00'."""
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to a CSV in `out_dir`; return its path.
+
+    Invoices carry the patient id only, never a name, so none is written.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in month_invoices:
+            writer.writerow([
+                i.number,
+                i.clinic,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                _amount(i.amount_cents),
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
