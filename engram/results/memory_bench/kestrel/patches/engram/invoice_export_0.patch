@@ -0,0 +1,106 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents, clinic="HB", patient_id="KP-004211", description="Follow-up session"):
+    return Invoice(
+        number=number,
+        clinic=clinic,
+        patient_id=patient_id,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.out_dir = self._dir.name
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def read_rows(self, path):
+        with open(path, encoding="utf-8", newline="") as f:
+            return list(csv.reader(f))
+
+    def test_file_name_and_path(self):
+        path = export_invoices([], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_row_first(self):
+        path = export_invoices([], 2027, 3, self.out_dir)
+        self.assertEqual(self.read_rows(path), [["InvoiceNumber", "Clinic", "PatientID", "Date", "Description", "Amount"]])
+
+    def test_only_invoices_from_that_month(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 2, 28), 7000),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 1), 7000),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 31), 7000),
+            invoice("INV-HB-2027-00004", datetime.date(2027, 4, 1), 7000),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        numbers = [row[0] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2027-00002", "INV-HB-2027-00003"])
+
+    def test_dates_are_dd_mm_yyyy(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5), 7000)]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][3], "05/03/2027")
+
+    def test_amounts_are_two_decimal_numbers_without_dollar_sign(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5), 7000),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 6), 9500),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 7), 5),
+            invoice("INV-HB-2027-00004", datetime.date(2027, 3, 8), 0),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        amounts = [row[5] for row in self.read_rows(path)[1:]]
+        self.assertEqual(amounts, ["70.00", "95.00", "0.05", "0.00"])
+
+    def test_negative_amount(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5), -1250)]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][5], "-12.50")
+
+    def test_row_fields_and_patient_id_only(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5), 9500,
+                            patient_id="KP-004211", description="Initial assessment")]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual(
+            self.read_rows(path)[1],
+            ["INV-HB-2027-00001", "HB", "KP-004211", "05/03/2027", "Initial assessment", "95.00"],
+        )
+
+    def test_rows_in_date_then_number_order(self):
+        invoices = [
+            invoice("INV-HB-2027-00009", datetime.date(2027, 3, 9), 7000),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 2), 7000),
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 2), 7000),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        numbers = [row[0] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2027-00001", "INV-HB-2027-00002", "INV-HB-2027-00009"])
+
+    def test_description_with_comma_is_quoted(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5), 7000, description="Session, follow-up")]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][4], "Session, follow-up")
+
+    def test_returns_path_inside_out_dir(self):
+        path = export_invoices([], 2027, 12, self.out_dir)
+        self.assertEqual(os.path.dirname(path), self.out_dir)
+        self.assertTrue(path.endswith("kestrel-invoices-2027-12.csv"))
+
+
+if __name__ == "__main__":
+    unittest.main()
