+def next_invoice_number(clinic, year, existing):
+    """Next INV-<clinic>-<year>-<sequence> number, counted per clinic and year.
+
+    `existing` holds every invoice number issued so far, for any clinic and year;
+    only those for this clinic and year affect the sequence.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        sequence = number[len(prefix):]
+        if number.startswith(prefix) and len(sequence) == 5 and sequence.isdigit():
+            highest = max(highest, int(sequence))
+    if highest >= 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{highest + 1:05d}"
