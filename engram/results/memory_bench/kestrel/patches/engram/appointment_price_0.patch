 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
+# Appointments whose local (Pacific/Auckland) date is on or after this day pay the new prices.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+
 # Cents, so that no rounding is needed when money is added up.
-PRICES_CENTS = {
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
 
-def session_price(kind):
-    """Return the price in cents of a session of the given kind."""
+def session_price(kind, start):
+    """Return the price in cents of a session of the given kind starting at start."""
+    if start.tzinfo is None:
+        raise ValueError("start must be timezone-aware")
+    local_date = start.astimezone(LOCAL_TZ).date()
+    prices = NEW_PRICES_CENTS if local_date >= NEW_PRICES_FROM else OLD_PRICES_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def csc_discount(price, csc, kind):
+    """Return the discount in cents: CSC holders get 20% off follow-ups, not assessments."""
+    if csc and kind == FOLLOWUP:
+        return price * CSC_FOLLOWUP_DISCOUNT_PERCENT // 100
+    return 0
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents."""
+    price = session_price(appointment.kind, appointment.start)
+    return price - csc_discount(price, patient.csc, appointment.kind)
