 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
 # Cents, so that no rounding is needed when money is added up.
-PRICES_CENTS = {
+# Appointments on or after PRICE_CHANGE_DATE (local date) pay the new prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+
+def session_price(kind, start):
+    """Return the price in cents of a session of the given kind starting at start.
+
+    start must be timezone-aware. The price is chosen by its local
+    (Pacific/Auckland) date, so an appointment near midnight UTC can fall on
+    the next local day.
+    """
+    if start.tzinfo is None:
+        raise ValueError("start must be timezone-aware")
+    if kind not in OLD_PRICES_CENTS:
+        raise ValueError(f"unknown kind {kind!r}")
+    local_date = start.astimezone(LOCAL_TZ).date()
+    if local_date >= PRICE_CHANGE_DATE:
+        return NEW_PRICES_CENTS[kind]
+    return OLD_PRICES_CENTS[kind]
+
+
+def csc_discounted(cents, csc, kind):
+    """Return the price after the Community Services Card discount.
+
+    CSC holders get 20% off follow-up appointments, not initial assessments.
+    """
+    if csc and kind == FOLLOWUP:
+        return cents * 80 // 100
+    return cents
 
 
-def session_price(kind):
-    """Return the price in cents of a session of the given kind."""
-    try:
-        return PRICES_CENTS[kind]
-    except KeyError:
-        raise ValueError(f"unknown kind {kind!r}") from None
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents."""
+    cents = session_price(appointment.kind, appointment.start)
+    return csc_discounted(cents, patient.csc, appointment.kind)
