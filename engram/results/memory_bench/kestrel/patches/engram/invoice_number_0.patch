+def next_invoice_number(clinic, year, existing):
+    """Next INV-<clinic>-<year>-<sequence> number, counted per clinic and year.
+
+    `existing` holds invoice numbers from any clinic and year; only those for
+    this clinic and year count, and anything not in the format is ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [
+        int(number[len(prefix):])
+        for number in existing
+        if number.startswith(prefix) and re.fullmatch(r"[0-9]{5}", number[len(prefix):])
+    ]
+    next_sequence = max(sequences, default=0) + 1
+    if next_sequence > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{next_sequence:05d}"
+
