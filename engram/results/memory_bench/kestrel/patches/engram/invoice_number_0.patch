+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_sequence_for_clinic_and_year(self):
+        existing = ["INV-HB-2027-00041", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-NG-2027-00900", "INV-WK-2027-00500"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_restarts_at_00001_in_a_new_year(self):
+        existing = ["INV-HB-2026-00880"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_not_in_the_format(self):
+        existing = ["INV-HB-2027-0042", "INV-HB-2027-000x1", "INV-HB-2027-00003", "xINV-HB-2027-00099"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_does_not_mistake_a_longer_clinic_code_for_this_one(self):
+        existing = ["INV-HBX-2027-00050"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_does_not_modify_existing(self):
+        existing = ["INV-HB-2027-00001"]
+        next_invoice_number("HB", 2027, existing)
+        self.assertEqual(existing, ["INV-HB-2027-00001"])
+
+    def test_raises_when_sequence_is_exhausted(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
