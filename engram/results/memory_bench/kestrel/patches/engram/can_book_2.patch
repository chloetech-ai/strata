+++ b/tests/test_booking.py
@@ -0,0 +1,60 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import Therapist
+
+# In March the local time (Pacific/Auckland) is UTC+13, so utc(2027, 3, 1, 20) is 09:00 on 2 March.
+THERAPIST = Therapist("T1", "Ana", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 21))))
+
+    def test_overlapping_follow_up(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="followup")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20, 15), kind="followup")))
+
+    def test_back_to_back_follow_ups(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="followup")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20, 30), kind="followup")))
+
+    def test_assessment_blocks_its_notes_gap(self):
+        # Assessment 09:00-09:45, then notes until 10:00.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="assessment")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20, 45), kind="followup")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 21), kind="followup")))
+
+    def test_new_assessment_needs_its_own_gap(self):
+        # Follow-up 09:30-10:00, so an assessment at 09:00 would run into it.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20, 30), kind="followup")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20), kind="assessment")))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status="cancelled")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_must_start_on_quarter_hour(self):
+        cal = Calendar()
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20, 10))))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20, 45))))
+
+    def test_daily_cap(self):
+        booked = [appt(f"a{i}", utc(2027, 3, 1, 20 + i // 2, 30 * (i % 2))) for i in range(8)]
+        self.assertFalse(can_book(Calendar(booked), THERAPIST, appt("new", utc(2027, 3, 2, 1))))
+        self.assertTrue(can_book(Calendar(booked[:7]), THERAPIST, appt("new", utc(2027, 3, 2, 1))))
+
+    def test_therapist_mismatch(self):
+        cal = Calendar()
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20), therapist="T2")))
+
+
+if __name__ == "__main__":
+    unittest.main()
