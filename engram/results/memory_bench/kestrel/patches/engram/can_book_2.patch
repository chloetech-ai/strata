+"""Checks made before an appointment is saved."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Minutes each kind of appointment takes.
+DURATION_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+# Minutes the therapist needs for notes before the next patient.
+NOTES_GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}
+# Therapists' union agreement: at most this many patient appointments per day.
+MAX_PER_DAY = 8
+
+
+def _occupied(appointment):
+    """The (start, end) span an appointment occupies, including its notes gap."""
+    minutes = DURATION_MINUTES[appointment.kind] + NOTES_GAP_MINUTES[appointment.kind]
+    return appointment.start, appointment.start + datetime.timedelta(minutes=minutes)
+
+
+def can_book(calendar, therapist, appointment):
+    """Return True if `appointment` can be added to `calendar` for `therapist`, else False.
+
+    It must belong to the therapist, start on a quarter hour (local time), not overlap
+    another appointment for the therapist (including that appointment's notes gap), and
+    leave the therapist under MAX_PER_DAY appointments on that local day. Cancelled
+    appointments are ignored.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+
+    local_start = appointment.start.astimezone(LOCAL_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    start, end = _occupied(appointment)
+    for other in calendar.for_therapist(therapist.id):
+        if other.status == CANCELLED:
+            continue
+        other_start, other_end = _occupied(other)
+        if start < other_end and other_start < end:
+            return False
+
+    that_day = [
+        a for a in calendar.for_day(therapist.id, local_start.date())
+        if a.status != CANCELLED
+    ]
+    return len(that_day) < MAX_PER_DAY
diff --git a/tests/test_booking.py b/tests/test_booking.py
