diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index bad08f4..469edf7 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -40,3 +40,10 @@ class Waitlist:
     def entries(self):
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it."""
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index c1a7ee8..caa414a 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -109,5 +109,47 @@ class WaitlistTest(unittest.TestCase):
         self.assertEqual(waitlist.entries(), [rejoined])
 
 
+class NextForTest(unittest.TestCase):
+    def test_none_when_nobody_waiting(self):
+        self.assertIsNone(Waitlist().next_for("followup"))
+
+    def test_none_when_nobody_waiting_for_that_kind(self):
+        waitlist = Waitlist()
+        waitlist.add(entry("KP-000001", 9, kind="assessment"))
+        self.assertIsNone(waitlist.next_for("followup"))
+
+    def test_offers_earliest_of_that_kind(self):
+        waitlist = Waitlist()
+        late = entry("KP-000001", 15)
+        early = entry("KP-000002", 8)
+        waitlist.add(late)
+        waitlist.add(early)
+        self.assertIs(waitlist.next_for("followup"), early)
+
+    def test_urgent_of_that_kind_goes_first(self):
+        waitlist = Waitlist()
+        early = entry("KP-000001", 8)
+        urgent_late = entry("KP-000002", 16, urgent=True)
+        waitlist.add(early)
+        waitlist.add(urgent_late)
+        self.assertIs(waitlist.next_for("followup"), urgent_late)
+
+    def test_skips_other_kinds(self):
+        waitlist = Waitlist()
+        assessment = entry("KP-000001", 8, urgent=True, kind="assessment")
+        followup = entry("KP-000002", 16, kind="followup")
+        waitlist.add(assessment)
+        waitlist.add(followup)
+        self.assertIs(waitlist.next_for("followup"), followup)
+        self.assertIs(waitlist.next_for("assessment"), assessment)
+
+    def test_does_not_remove_entry(self):
+        waitlist = Waitlist()
+        e = entry("KP-000001", 9)
+        waitlist.add(e)
+        waitlist.next_for("followup")
+        self.assertEqual(waitlist.entries(), [e])
+
+
 if __name__ == "__main__":
     unittest.main()
