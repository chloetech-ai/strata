+"""SMS reminders for booked appointments."""
+
+from .calendar import LOCAL_TZ
+from .ids import normalize_patient_id
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment. Only the date, time and clinic name: never the treatment."""
+    local = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic]
+    return f"Reminder: you have an appointment at {clinic.name} on {local.day} {local:%B %Y} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of every booked appointment; return how many were sent.
+
+    `patients` maps patient ID to Patient. Every message is built before any is
+    sent, so a missing patient sends nothing.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[normalize_patient_id(appointment.patient_id)]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..45aca73
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,71 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import Patient
+from kestrel.reminders import reminder_text, send_reminders
+from test_sms import FakeTransport
+from kestrel.sms import BulkieClient
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Ana Lee", "+64211000001"),
+    "KP-004211": Patient("KP-004211", "Ben Ross", "+64211004211"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key", transport=self.transport)
+
+    def sent(self):
+        return [m for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_one_message_per_booked_appointment(self):
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-000001"),
+            appt("a3", utc(2027, 3, 2, 1), patient="KP-004211"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 3)
+        self.assertEqual(
+            [m["to"] for m in self.sent()],
+            ["+64211000001", "+64211000001", "+64211004211"],
+        )
+
+    def test_skips_cancelled_and_other_statuses(self):
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001", status="cancelled"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-004211", status="attended"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_messy_patient_id_on_appointment(self):
+        appointments = [appt("a1", utc(2027, 3, 1, 20), patient="kp4211")]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 1)
+        self.assertEqual(self.sent()[0]["to"], "+64211004211")
+
+    def test_missing_patient_sends_nothing(self):
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-000099"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_text_has_date_time_clinic_only(self):
+        # 2027-03-01 20:00 UTC is 2027-03-02 09:00 in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 20), clinic="HB", treatment="lower back pain"))
+        self.assertEqual(text, "Reminder: you have an appointment at Kestrel Physio Harbour on 2 March 2027 at 09:00.")
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("Ana", text)
+
+    def test_empty(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
