+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_number_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_continues_from_highest_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_does_not_reuse_gaps(self):
+        self.assertEqual(next_invoice_number("HB", 2027, ["INV-HB-2027-00005"]), "INV-HB-2027-00006")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-NG-2027-00009", "INV-WK-2027-00100"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-HB-2026-00500"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_that_are_not_in_the_format(self):
+        existing = ["INV-HB-2027-0042", "INV-HB-2027-000420", "HB-2027-00099", "INV-HBX-2027-00099"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2027-00003"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_raises_when_sequence_would_overflow_five_digits(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
