+def next_invoice_number(clinic, year, existing: Iterable[str]):
+    """Next INV-<clinic>-<year>-<sequence> number, counted per clinic and year.
+
+    Numbers from other clinics or years are ignored. The sequence continues from
+    the highest one issued, so gaps are never reused.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-(\d{{5}})")
+    sequences = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    next_sequence = max(sequences, default=0) + 1
+    if next_sequence > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"INV-{clinic}-{year}-{next_sequence:05d}"
