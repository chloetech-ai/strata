+"""Checks before a new appointment is booked."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Agreed slot rules. Every appointment starts on a quarter hour.
+SLOT_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+# The therapist needs a gap for notes after an assessment, but not after a follow-up.
+GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}
+# Union agreement: a therapist sees at most this many patients on a local day.
+DAILY_LIMIT = 8
+
+
+def _busy(appointment):
+    """The (start, end) span a therapist is busy for an appointment, including any gap after it."""
+    minutes = SLOT_MINUTES[appointment.kind] + GAP_MINUTES[appointment.kind]
+    return appointment.start, appointment.start + datetime.timedelta(minutes=minutes)
+
+
+def can_book(calendar, therapist, appointment):
+    """Return True if `appointment` can be added to `calendar` for `therapist`.
+
+    The appointment must be this therapist's, start on a quarter hour, not overlap
+    another live appointment of theirs (including its gap), and leave them within
+    the daily limit. Cancelled appointments are ignored.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    local_start = appointment.start.astimezone(LOCAL_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    live = [
+        a for a in calendar.for_therapist(therapist.id)
+        if a.status != CANCELLED and a.id != appointment.id
+    ]
+    start, end = _busy(appointment)
+    for other in live:
+        other_start, other_end = _busy(other)
+        if start < other_end and other_start < end:
+            return False
+
+    same_day = [a for a in live if a.start.astimezone(LOCAL_TZ).date() == local_start.date()]
+    return len(same_day) < DAILY_LIMIT
