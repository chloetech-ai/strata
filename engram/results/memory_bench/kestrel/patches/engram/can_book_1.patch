@@ -0,0 +1,62 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+# In March 2027 Auckland is UTC+13, so utc(2027, 3, 1, 20) is 09:00 on 2 March locally.
+THERAPIST = Therapist(id="T1", name="Ana", clinic="HB")
+START = utc(2027, 3, 1, 20)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", START)))
+
+    def test_overlapping_follow_up(self):
+        cal = Calendar([appt("a1", START, kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", START + datetime.timedelta(minutes=15))))
+
+    def test_back_to_back_follow_ups(self):
+        cal = Calendar([appt("a1", START, kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", START + datetime.timedelta(minutes=30), kind=FOLLOWUP)))
+
+    def test_gap_after_assessment_is_blocked(self):
+        cal = Calendar([appt("a1", START, kind=ASSESSMENT)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", START + datetime.timedelta(minutes=45))))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", START + datetime.timedelta(minutes=60))))
+
+    def test_new_assessment_overlapping_existing_follow_up(self):
+        cal = Calendar([appt("a1", START, kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", START - datetime.timedelta(minutes=15), kind=ASSESSMENT)))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", START, kind=FOLLOWUP, therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", START)))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", START, kind=FOLLOWUP, status=CANCELLED)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", START)))
+
+    def test_must_start_on_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("new", START + datetime.timedelta(minutes=10))))
+
+    def test_must_be_for_this_therapist(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("new", START, therapist="T2")))
+
+    def test_daily_limit(self):
+        existing = [appt(f"a{i}", START + datetime.timedelta(hours=i), kind=FOLLOWUP) for i in range(7)]
+        self.assertTrue(can_book(Calendar(existing), THERAPIST, appt("new", START + datetime.timedelta(hours=8))))
+        existing.append(appt("a7", START + datetime.timedelta(hours=7), kind=FOLLOWUP))
+        self.assertFalse(can_book(Calendar(existing), THERAPIST, appt("new", START + datetime.timedelta(hours=8))))
+
+    def test_daily_limit_is_per_local_day(self):
+        # Eight follow-ups on 2 March locally; a booking on 3 March is still allowed.
+        existing = [appt(f"a{i}", START + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP) for i in range(8)]
+        self.assertTrue(can_book(Calendar(existing), THERAPIST, appt("new", START + datetime.timedelta(days=1))))
+
+
+if __name__ == "__main__":
+    unittest.main()
