+"""Exports for the accountant."""
+
+import csv
+import os
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to a CSV file in `out_dir` and return its path.
+
+    The file is named kestrel-invoices-YYYY-MM.csv for importing into Xero. Dates are
+    DD/MM/YYYY and amounts are dollars with two decimals, converted from cents.
+    Only patient ids are written, never names.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"])
+        for invoice in chosen:
+            writer.writerow([
+                invoice.number,
+                invoice.clinic,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                _dollars(invoice.amount_cents),
+            ])
+    return path
+
+
+def _dollars(cents):
+    if cents < 0:
+        raise ValueError(f"negative amount {cents} cents")
+    return f"{cents // 100}.{cents % 100:02d}"
diff --git a/tests/test_export.py b/tests/test_export.py
