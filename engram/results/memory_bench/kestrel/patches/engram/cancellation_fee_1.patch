@@ -0,0 +1,30 @@
+"""Cancellation and no-show fees."""
+
+import datetime
+
+from kestrel.models import CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+# A cancellation this close to the start, or later, is charged half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents for an appointment.
+
+    `cancelled_at` is when the patient cancelled (timezone-aware). It is needed
+    for a cancelled appointment; for a no-show it is None.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status != CANCELLED:
+        return 0
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError("a cancelled appointment needs a cancellation time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancellation time must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return session_price(appointment.kind) // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..95d82ab
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_before_is_free(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 8)), 0)
+
+    def test_exactly_48_hours_before_is_free(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9)), 0)
+
+    def test_less_than_48_hours_before_is_half_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        at = utc(2027, 3, 8, 9) + datetime.timedelta(seconds=1)
+        self.assertEqual(cancellation_fee(a, at), 3500)
+
+    def test_cancelled_after_start_is_half_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 10)), 3500)
+
+    def test_late_cancellation_of_assessment_is_half_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 9)), 4750)
+
+    def test_window_is_elapsed_time_whatever_offset_the_cancellation_is_written_in(self):
+        # 2027-03-08 09:00 UTC is exactly 48 hours before the start, written here at UTC-11.
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        at = datetime.datetime(2027, 3, 7, 22, 0, tzinfo=datetime.timezone(datetime.timedelta(hours=-11)))
+        self.assertEqual(cancellation_fee(a, at), 0)
+
+    def test_uses_stored_cancelled_at_when_not_given(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED, cancelled_at=utc(2027, 3, 9, 9))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelled_without_any_time_is_an_error(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_rejects_naive_cancellation_time(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 9, 9))
+
+
+class NoShowFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_followup_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_pays_full_assessment_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+
+class OtherStatusesTest(unittest.TestCase):
+    def test_booked_has_no_fee(self):
+        self.assertEqual(cancellation_fee(appt("a1", utc(2027, 3, 10, 9), status=BOOKED)), 0)
+
+    def test_attended_has_no_fee(self):
+        self.assertEqual(cancellation_fee(appt("a1", utc(2027, 3, 10, 9), status=ATTENDED)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
