+"""Cancellation and no-show fees."""
+
+import datetime
+
+from kestrel.models import CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+# Cancelling less than this long before the start costs half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents for an appointment that was cancelled or missed.
+
+    For a cancelled appointment, `cancelled_at` is when the patient cancelled
+    (timezone-aware). For a no-show it must be None.
+    """
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError("a no-show has no cancellation time")
+        return session_price(appointment.kind)
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            raise ValueError("a cancelled appointment needs its cancellation time")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancelled_at must be timezone-aware")
+        if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+            return session_price(appointment.kind) // 2
+        return 0
+    raise ValueError(f"no fee applies to a {appointment.status} appointment")
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..5037574
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,68 @@
+import datetime
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW, Appointment
+
+START = datetime.datetime(2026, 11, 2, 9, 0, tzinfo=datetime.timezone.utc)
+
+
+def appointment(kind=FOLLOWUP, status=BOOKED):
+    return Appointment(
+        id="A1",
+        patient_id="KP-004211",
+        therapist_id="T1",
+        clinic="HB",
+        start=START,
+        kind=kind,
+        status=status,
+    )
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_49_hours_ahead_is_free(self):
+        at = START - datetime.timedelta(hours=49)
+        self.assertEqual(cancellation_fee(appointment(status=CANCELLED), at), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        at = START - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(appointment(status=CANCELLED), at), 0)
+
+    def test_cancelled_47_hours_ahead_is_half_the_followup_price(self):
+        at = START - datetime.timedelta(hours=47)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP, CANCELLED), at), 3500)
+
+    def test_cancelled_47_hours_ahead_is_half_the_assessment_price(self):
+        at = START - datetime.timedelta(hours=47)
+        self.assertEqual(cancellation_fee(appointment(ASSESSMENT, CANCELLED), at), 4750)
+
+    def test_cancelled_after_start_is_half_the_price(self):
+        at = START + datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP, CANCELLED), at), 3500)
+
+    def test_cancelled_needs_a_cancellation_time(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(status=CANCELLED))
+
+    def test_cancellation_time_must_be_timezone_aware(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(status=CANCELLED), START.replace(tzinfo=None))
+
+    def test_no_show_pays_full_followup_price(self):
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP, NO_SHOW)), 7000)
+
+    def test_no_show_pays_full_assessment_price(self):
+        self.assertEqual(cancellation_fee(appointment(ASSESSMENT, NO_SHOW)), 9500)
+
+    def test_no_show_takes_no_cancellation_time(self):
+        at = START - datetime.timedelta(hours=1)
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(status=NO_SHOW), at)
+
+    def test_booked_appointment_has_no_fee(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(status=BOOKED))
+
+
+if __name__ == "__main__":
+    unittest.main()
