+"""Reading the durations that reception and therapists type in by hand."""
+
+import re
+
+# "1h", "1h30", "1h 30m" (hours, then optional minutes), or "45m".
+_DURATION = re.compile(r"(?:([0-9]+)h(?:\s*([0-9]+)m?)?|([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Minutes in a duration, e.g. '1h30' -> 90, '45m' -> 45, '1h 30m' -> 90."""
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes, minutes_only = match.groups()
+    if minutes_only is not None:
+        return int(minutes_only)
+    return int(hours) * 60 + int(minutes or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
