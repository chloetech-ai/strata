+import datetime
+import unittest
+
+from kestrel.intervals import merge_busy
+
+UTC = datetime.timezone.utc
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_pair_is_unchanged(self):
+        self.assertEqual(merge_busy([(1, 2)]), [(1, 2)])
+
+    def test_disjoint_pairs_are_sorted(self):
+        self.assertEqual(merge_busy([(5, 7), (1, 2)]), [(1, 2), (5, 7)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_any_order(self):
+        self.assertEqual(merge_busy([(5, 7), (3, 4), (1, 3)]), [(1, 4), (5, 7)])
+
+    def test_contained_pair_does_not_shorten_merged_pair(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_chain_merges_into_one(self):
+        self.assertEqual(merge_busy([(1, 2), (2, 3), (3, 4), (4, 5)]), [(1, 5)])
+
+    def test_accepts_datetimes(self):
+        def at(hh, mm):
+            return datetime.datetime(2027, 4, 1, hh, mm, tzinfo=UTC)
+
+        merged = merge_busy([(at(10, 0), at(11, 0)), (at(9, 0), at(10, 0)), (at(12, 0), at(12, 30))])
+        self.assertEqual(merged, [(at(9, 0), at(11, 0)), (at(12, 0), at(12, 30))])
+
+
+if __name__ == "__main__":
+    unittest.main()
