@@ -0,0 +1,70 @@
+"""Free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, CLINICS, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+
+SLOT_MINUTES = 15  # every appointment starts on a quarter hour
+MAX_PATIENTS_PER_DAY = 8  # therapists' union agreement
+
+DURATION_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+NOTES_GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}  # the therapist's gap for notes after the appointment
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))  # Monday to Friday, all clinics
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}  # only Northgate opens on Saturdays
+
+
+def _opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a local date, or None if it is closed."""
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic {clinic!r}")
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None
+
+
+def _held_minutes(kind):
+    """How long an appointment of this kind holds the therapist: its length plus the notes gap."""
+    return DURATION_MINUTES[kind] + NOTES_GAP_MINUTES[kind]
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) at which a new appointment of `kind` could be
+    booked with `therapist` on the local (Pacific/Auckland) date `day`.
+
+    A start time is free when it is within the clinic's opening hours on that day, the new
+    appointment and its notes gap do not overlap any other appointment of the therapist's
+    (cancelled ones do not count), and the therapist has fewer than MAX_PATIENTS_PER_DAY
+    appointments that day.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = _opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    booked_today = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked_today) >= MAX_PATIENTS_PER_DAY:
+        return []
+
+    busy = []
+    for appointment in calendar.for_therapist(therapist.id):
+        if appointment.status != CANCELLED:
+            start = appointment.start.astimezone(UTC)
+            busy.append((start, start + datetime.timedelta(minutes=_held_minutes(appointment.kind))))
+
+    opens, closes = hours
+    times = []
+    wall_start = datetime.datetime.combine(day, opens)
+    wall_close = datetime.datetime.combine(day, closes)
+    while wall_start + datetime.timedelta(minutes=DURATION_MINUTES[kind]) <= wall_close:
+        start = wall_start.replace(tzinfo=LOCAL_TZ).astimezone(UTC)
+        end = start + datetime.timedelta(minutes=_held_minutes(kind))
+        if all(end <= busy_start or busy_end <= start for busy_start, busy_end in busy):
+            times.append(wall_start.time())
+        wall_start += datetime.timedelta(minutes=SLOT_MINUTES)
+    return times
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..47d5a2f
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,108 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from helpers import appt
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+LOCAL = ZoneInfo("Pacific/Auckland")
+MONDAY = datetime.date(2026, 10, 12)  # local
+SATURDAY = datetime.date(2026, 10, 17)  # local
+SUNDAY = datetime.date(2026, 10, 18)  # local
+
+
+def local(day, hh, mm=0):
+    return datetime.datetime.combine(day, datetime.time(hh, mm), tzinfo=LOCAL)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+HB = Therapist("T1", "Ana", "HB")
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_follow_up_runs_from_opening_to_last_fitting_start(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # 30 minutes must end by 18:00
+        self.assertEqual(len(slots), 41)
+
+    def test_empty_weekday_assessment_must_end_by_closing(self):
+        slots = free_slots(Calendar(), HB, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))  # 45 minutes must end by 18:00
+        self.assertEqual(len(slots), 40)
+
+    def test_returns_datetime_times_in_order(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertTrue(all(isinstance(s, datetime.time) and s.tzinfo is None for s in slots))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_saturday_closed_for_harbour(self):
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+
+    def test_saturday_northgate_hours(self):
+        ng = Therapist("T2", "Ben", "NG")
+        slots = free_slots(Calendar(), ng, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(8, 0))
+        self.assertEqual(slots[-1], t(11, 30))  # 30 minutes must end by 12:00
+
+    def test_sunday_closed_everywhere(self):
+        ng = Therapist("T2", "Ben", "NG")
+        self.assertEqual(free_slots(Calendar(), ng, SUNDAY, FOLLOWUP), [])
+
+    def test_booked_follow_up_blocks_overlapping_starts_only(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(t(8, 30), slots)
+        for blocked in (t(8, 45), t(9, 0), t(9, 15)):
+            self.assertNotIn(blocked, slots)
+        self.assertIn(t(9, 30), slots)
+
+    def test_assessment_leaves_notes_gap_before_next_patient(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(9, 45), slots)  # would start inside the 15-minute notes gap
+        self.assertIn(t(10, 0), slots)  # gap ends exactly as this one starts
+
+    def test_new_assessment_must_leave_gap_before_existing_appointment(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, ASSESSMENT)
+        self.assertIn(t(9, 0), slots)  # 45 minutes plus 15 minutes of notes ends at 10:00
+        self.assertNotIn(t(9, 15), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), therapist="T1", status=CANCELLED)])
+        self.assertIn(t(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), therapist="T2")])
+        self.assertIn(t(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_daily_cap_of_eight_patients(self):
+        booked = [appt(f"a{i}", local(MONDAY, 7, 30) + datetime.timedelta(minutes=30 * i), therapist="T1") for i in range(8)]
+        self.assertEqual(free_slots(Calendar(booked), HB, MONDAY, FOLLOWUP), [])
+
+    def test_seven_patients_still_leaves_slots(self):
+        booked = [appt(f"a{i}", local(MONDAY, 7, 30) + datetime.timedelta(minutes=30 * i), therapist="T1") for i in range(7)]
+        self.assertIn(t(12, 0), free_slots(Calendar(booked), HB, MONDAY, FOLLOWUP))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        booked = [appt(f"a{i}", local(MONDAY, 7, 30) + datetime.timedelta(minutes=30 * i), therapist="T1") for i in range(7)]
+        booked.append(appt("c", local(MONDAY, 15), therapist="T1", status=CANCELLED))
+        self.assertIn(t(12, 0), free_slots(Calendar(booked), HB, MONDAY, FOLLOWUP))
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, MONDAY, "physio")
+
+    def test_unknown_clinic_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), Therapist("T9", "Cy", "XX"), MONDAY, FOLLOWUP)
+
+
+if __name__ == "__main__":
+    unittest.main()
