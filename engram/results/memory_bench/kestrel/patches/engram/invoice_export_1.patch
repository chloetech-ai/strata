+"""Monthly export of invoices for the accountant (imported into Xero)."""
+
+import csv
+import pathlib
+
+
+HEADER = ["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def _money(cents):
+    """Integer cents as a plain two-decimal number, e.g. 7000 -> '70.00'."""
+    sign = "-" if cents < 0 else ""
+    dollars, rest = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{rest:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to a CSV in `out_dir` and return its path.
+
+    The file is named kestrel-invoices-YYYY-MM.csv. Rows are ordered by date, then
+    invoice number. Patient IDs are written; patient names never are.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = pathlib.Path(out_dir) / f"kestrel-invoices-{year:04d}-{month:02d}.csv"
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.clinic,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                _money(i.amount_cents),
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
