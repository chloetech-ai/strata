@@ -0,0 +1,33 @@
+"""Fees for cancelled and missed appointments."""
+
+import datetime
+
+from kestrel.models import CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+# A cancellation this close to the start, or later, is a late cancellation.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents for an appointment that was cancelled or missed.
+
+    `cancelled_at` is when the patient cancelled (timezone-aware). It is required
+    for a cancelled appointment and None for a no-show.
+
+    A cancellation less than 48 hours before the start costs 50% of the session
+    price. A cancellation earlier than that is free. A no-show pays the full
+    session price.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no fee for a {appointment.status} appointment")
+    if cancelled_at is None:
+        raise ValueError("a cancelled appointment needs cancelled_at")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..97be310
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,56 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 8, 59)), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9)), 0)
+
+    def test_cancelled_under_48_hours_ahead_costs_half_the_followup_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9, 1)), 3500)
+
+    def test_late_cancellation_of_assessment_costs_half_the_assessment_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 9)), 4750)
+
+    def test_cancelled_after_start_costs_half(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 10)), 3500)
+
+    def test_no_show_pays_full_followup_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_pays_full_assessment_price(self):
+        a = appt("a1", utc(2027, 3, 10, 9), kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_cancelled_needs_a_cancellation_time(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, None)
+
+    def test_cancellation_time_must_be_timezone_aware(self):
+        a = appt("a1", utc(2027, 3, 10, 9), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, utc(2027, 3, 9, 9).replace(tzinfo=None))
+
+    def test_booked_and_attended_have_no_fee(self):
+        for status in (BOOKED, ATTENDED):
+            with self.subTest(status=status):
+                a = appt("a1", utc(2027, 3, 10, 9), status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
