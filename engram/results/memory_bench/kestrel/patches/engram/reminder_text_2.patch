+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder sent two days before `appointment`.
+
+    Privacy: states only the date, time and clinic name. The treatment and the
+    patient's name are never included.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{local:%A} {local.day} {local:%B}"
+    hour = local.hour % 12 or 12
+    time = f"{hour}:{local.minute:02d}{'am' if local.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora from {clinic}. Friendly reminder: you have an appointment "
+        f"on {day} at {time}. If you can't make it, please let us know. See you soon!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
