index 0000000..a200f1a
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,21 @@
+"""Reading the durations that reception types in by hand."""
+
+import re
+
+# Minutes only, e.g. '45m'.
+_MINUTES = re.compile(r"([0-9]+)m")
+# Hours, then optional minutes, e.g. '1h', '1h30', '1h 30m'.
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-5]?[0-9])m?)?")
+
+
+def parse_duration(text):
+    """Minutes in a duration, e.g. '1h 30m' -> 90."""
+    stripped = text.strip()
+    match = _MINUTES.fullmatch(stripped)
+    if match is not None:
+        return int(match.group(1))
+    match = _HOURS.fullmatch(stripped)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes = match.groups()
+    return int(hours) * 60 + int(minutes or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..5723e2a
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,32 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("90m"), 90)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+        self.assertEqual(parse_duration("2h"), 120)
+
+    def test_hours_and_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("1h30m"), 90)
+        self.assertEqual(parse_duration("1h 30"), 90)
+
+    def test_surrounding_whitespace(self):
+        self.assertEqual(parse_duration(" 45m "), 45)
+
+    def test_rejects_other_text(self):
+        for raw in ("", "   ", "m", "h", "45", "1.5h", "1h 30m 10s",
+                    "1h60", "1h-30", "45 m", "1 h", "1h30m5", "-45m", "abc"):
+            with self.subTest(raw=raw), self.assertRaises(ValueError):
+                parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
