+"""Reading the durations that reception types in by hand."""
+
+import re
+
+# "1h", "1h30", "1h 30m", "1h30m", or "45m". A bare number needs a unit.
+_DURATION = re.compile(r"(?:([0-9]+)h\s*(?:([0-9]+)m?)?|([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Minutes in a duration, e.g. '1h 30m' -> 90, '45m' -> 45."""
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, minutes_alone = match.groups()
+    if hours is not None:
+        return int(hours) * 60 + int(minutes_after_hours or 0)
+    return int(minutes_alone)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
