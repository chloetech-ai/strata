+++ b/tests/test_intervals.py
@@ -0,0 +1,44 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_bare_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+
+    def test_hours_and_minutes(self):
+        self.assertEqual(parse_duration("1h30m"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("1h 30"), 90)
+
+    def test_surrounding_whitespace(self):
+        self.assertEqual(parse_duration(" 45m\n"), 45)
+
+    def test_multi_digit_hours(self):
+        self.assertEqual(parse_duration("12h5"), 725)
+
+    def test_rejects_bare_number(self):
+        for text in ("45", "0"):
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_duration(text)
+
+    def test_rejects_empty(self):
+        for text in ("", "   ", "m", "h"):
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_duration(text)
+
+    def test_rejects_other_text(self):
+        for text in ("1.5h", "-45m", "1h-30", "1m30", "30 m", "1 h", "one hour", "1h30m5", "1hr", "45min"):
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
