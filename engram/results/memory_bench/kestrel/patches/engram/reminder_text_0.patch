+"""SMS reminders sent to patients before their appointments."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Text of the reminder sent two days before an appointment.
+
+    Privacy: says only the date, time and clinic name. The treatment is never included.
+    """
+    start = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}. A friendly reminder that you have an appointment on "
+        f"{start:%A} {start.day} {start:%B} at {_clock(start)}. See you then! "
+        "If you need to change it, please contact us."
+    )
+
+
+def _clock(local):
+    """A 12-hour time such as 2:30pm, without platform-specific strftime flags."""
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    return f"{hour}:{local.minute:02d}{suffix}"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
