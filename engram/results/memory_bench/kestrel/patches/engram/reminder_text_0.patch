@@ -0,0 +1,29 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic(self):
+        # 2026-10-20 01:30 UTC is 14:30 on Tuesday 20 October in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("a1", utc(2026, 10, 20, 1, 30), clinic="HB"))
+        self.assertIn("Tuesday 20 October at 2:30pm", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+
+    def test_uses_local_date_not_utc_date(self):
+        # 2026-10-20 11:00 UTC is 00:00 on Wednesday 21 October in Auckland.
+        text = reminder_text(appt("a1", utc(2026, 10, 20, 11, 0), clinic="NG"))
+        self.assertIn("Wednesday 21 October at 12:00am", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_morning_and_noon_times(self):
+        # 2026-10-20 22:05 UTC is 11:05am on 21 October; 2026-10-20 23:00 UTC is 12:00pm.
+        self.assertIn("at 11:05am", reminder_text(appt("a1", utc(2026, 10, 20, 22, 5))))
+        self.assertIn("at 12:00pm", reminder_text(appt("a1", utc(2026, 10, 20, 23, 0))))
+
+    def test_never_mentions_treatment_or_patient(self):
+        a = appt("a1", utc(2026, 10, 20, 1, 30), treatment="lower back pain", patient="KP-004211")
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("KP-004211", text)
