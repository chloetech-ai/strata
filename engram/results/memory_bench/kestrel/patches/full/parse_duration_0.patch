@@ -0,0 +1,27 @@
+"""Durations such as '45m' and '1h 30m'."""
+
+import re
+
+_DURATION = re.compile(r"(?:([0-9]+)\s*h\s*(?:([0-9]+)\s*m?)?|([0-9]+)\s*m)")
+
+
+def parse_duration(text):
+    """Minutes in a duration written as '45m', '1h', '1h30' or '1h 30m'.
+
+    A bare number without a unit is rejected, and minutes after an hour must be under 60.
+    """
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes, minutes_only = match.group(1), match.group(2), match.group(3)
+    if minutes_only is not None:
+        total = int(minutes_only)
+    else:
+        total = int(hours) * 60
+        if minutes is not None:
+            if int(minutes) >= 60:
+                raise ValueError(f"minutes must be under 60 after hours: {text!r}")
+            total += int(minutes)
+    if total <= 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
