--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,32 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45m": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h30m": 90,
+            "1h 30m": 90,
+            "1h 30": 90,
+            "2h": 120,
+            "90m": 90,
+            " 45m ": 45,
+            "1H30M": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_rejects_everything_else(self):
+        for text in ["", "   ", "90", "1.5h", "-1h", "0m", "0h", "1h90", "1h 60m", "abc", "1 hour", "1h 30m 5s", "h30", "1h30h"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
