diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index ecc82dc..6dfa2f9 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -59,6 +59,12 @@ class Calendar:
         patient_id = normalize_patient_id(patient_id)
         return [a for a in self.all() if a.patient_id == patient_id]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after now, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 9fc301f..eb54a92 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -91,6 +91,39 @@ class CalendarTest(unittest.TestCase):
             cal.move("a1", datetime.datetime(2027, 3, 2, 9))
         self.assertEqual(cal.get("a1").start, utc(2027, 3, 1, 20))
 
+    def test_upcoming_soonest_first(self):
+        cal = Calendar([
+            appt("a3", utc(2027, 3, 3, 9), patient="KP-000001"),
+            appt("a1", utc(2027, 3, 1, 9), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 2, 9), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 2, 28, 0))], ["a1", "a2", "a3"])
+
+    def test_upcoming_excludes_past_and_now(self):
+        cal = Calendar([
+            appt("past", utc(2027, 2, 27, 9), patient="KP-000001"),
+            appt("now", utc(2027, 2, 28, 9), patient="KP-000001"),
+            appt("later", utc(2027, 3, 1, 9), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 2, 28, 9))], ["later"])
+
+    def test_upcoming_excludes_cancelled_and_other_patients(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 1, 9), patient="KP-000001", status="cancelled"),
+            appt("a2", utc(2027, 3, 2, 9), patient="KP-000001"),
+            appt("a3", utc(2027, 3, 3, 9), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 2, 28, 0))], ["a2"])
+
+    def test_upcoming_accepts_messy_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9), patient="KP-000001")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp1 ", utc(2027, 2, 28, 0))], ["a1"])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 2, 28, 0))
+
     def test_booked(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
