diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index ecc82dc..94a680b 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -59,6 +59,13 @@ class Calendar:
         patient_id = normalize_patient_id(patient_id)
         return [a for a in self.all() if a.patient_id == patient_id]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after now, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        patient_id = normalize_patient_id(patient_id)
+        return [a for a in self.booked() if a.patient_id == patient_id and a.start > now]
+
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 9fc301f..8506d88 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -91,6 +91,31 @@ class CalendarTest(unittest.TestCase):
             cal.move("a1", datetime.datetime(2027, 3, 2, 9))
         self.assertEqual(cal.get("a1").start, utc(2027, 3, 1, 20))
 
+    def test_upcoming_is_booked_future_appointments_soonest_first(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("late", utc(2027, 3, 5, 9), patient="KP-000001"),
+            appt("soon", utc(2027, 3, 2, 9), patient="KP-000001"),
+            appt("past", utc(2027, 2, 27, 9), patient="KP-000001"),
+            appt("cancelled", utc(2027, 3, 3, 9), patient="KP-000001", status="cancelled"),
+            appt("other", utc(2027, 3, 2, 10), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "late"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([appt("a1", now, patient="KP-000001")])
+        self.assertEqual(cal.upcoming("KP-000001", now), [])
+
+    def test_upcoming_normalizes_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-000001")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp1 ", utc(2027, 3, 1, 12))], ["a1"])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 12))
+
     def test_booked(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
