@@ -0,0 +1,92 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import HEADER, export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, cents, patient_id="KP-004211", description="Follow-up session", clinic="HB"):
+    return Invoice(number=number, clinic=clinic, patient_id=patient_id, issued=issued,
+                   amount_cents=cents, description=description)
+
+
+def read_rows(path):
+    with open(path, encoding="utf-8", newline="") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.out = self._dir.name
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def test_writes_month_file_and_returns_path(self):
+        path = export_invoices([], 2027, 3, self.out)
+        self.assertEqual(path, os.path.join(self.out, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_and_rows(self):
+        invoices = [
+            invoice("INV-HB-2027-00042", datetime.date(2027, 3, 1), 7000),
+            invoice("INV-NG-2027-00001", datetime.date(2027, 3, 2), 9500, patient_id="KP-000007",
+                    description="Initial assessment", clinic="NG"),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out))
+        self.assertEqual(rows[0], HEADER)
+        self.assertEqual(rows[1:], [
+            ["INV-HB-2027-00042", "KP-004211", "01/03/2027", "70.00", "Follow-up session"],
+            ["INV-NG-2027-00001", "KP-000007", "02/03/2027", "95.00", "Initial assessment"],
+        ])
+
+    def test_only_the_requested_month(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 2, 28), 7000),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 31), 7000),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 4, 1), 7000),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 3, 15), 7000),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2027-00002"])
+
+    def test_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2027-00009", datetime.date(2027, 3, 5), 7000),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 5), 7000),
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1), 7000),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2027-00001", "INV-HB-2027-00002", "INV-HB-2027-00009"])
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1), 9550),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 1), 5),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 1), 100000),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out))
+        self.assertEqual([r[3] for r in rows[1:]], ["95.50", "0.05", "1000.00"])
+
+    def test_empty_month_writes_header_only(self):
+        rows = read_rows(export_invoices([], 2027, 3, self.out))
+        self.assertEqual(rows, [HEADER])
+
+    def test_rejects_negative_amount_without_writing(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1), -100)]
+        with self.assertRaises(ValueError):
+            export_invoices(invoices, 2027, 3, self.out)
+        self.assertEqual(os.listdir(self.out), [])
+
+    def test_no_patient_names_in_output(self):
+        rows = read_rows(export_invoices([invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1), 7000)], 2027, 3, self.out))
+        self.assertFalse(any(h.lower().replace(" ", "") in ("name", "patientname") for h in rows[0]))
+        self.assertIn("KP-004211", rows[1])
+
+
+if __name__ == "__main__":
+    unittest.main()
