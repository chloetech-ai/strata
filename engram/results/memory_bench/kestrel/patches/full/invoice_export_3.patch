+"""Monthly export of invoices for the accountant.
+
+The file is comma-separated with a header row. Dates are DD/MM/YYYY and amounts
+are plain numbers with two decimals, no dollar sign. Patients appear by ID only.
+"""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "ContactName", "InvoiceDate", "Total", "Description"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to out_dir and return the file's path."""
+    month_invoices = sorted(
+        (i for i in invoices if (i.issued.year, i.issued.month) == (year, month)),
+        key=lambda i: (i.issued, i.number),
+    )
+    rows = [
+        [i.number, i.patient_id, _date(i.issued), _amount(i.amount_cents), i.description]
+        for i in month_invoices
+    ]
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        writer.writerows(rows)
+    return path
+
+
+def _date(d):
+    return f"{d.day:02d}/{d.month:02d}/{d.year:04d}"
+
+
+def _amount(cents):
+    if cents < 0:
+        raise ValueError(f"negative amount {cents} cents")
+    return f"{cents // 100}.{cents % 100:02d}"
