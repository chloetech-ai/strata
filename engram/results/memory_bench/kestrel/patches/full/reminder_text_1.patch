+++ b/tests/test_reminders.py
@@ -0,0 +1,46 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import CLINICS
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_clinic_date_and_time(self):
+        # 13 Oct 2026 is a Tuesday. 20:00 UTC is 09:00 NZDT.
+        text = reminder_text(appt("a1", utc(2026, 10, 12, 20), clinic="HB"))
+        self.assertEqual(
+            text,
+            "Kia ora! Just a reminder of your appointment at Kestrel Physio Harbour on "
+            "Tuesday 13 October at 9:00am. We look forward to seeing you.",
+        )
+
+    def test_afternoon_time(self):
+        # 14:30 NZDT on Tuesday 13 Oct is 01:30 UTC the same day.
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 1, 30), clinic="NG"))
+        self.assertIn("Tuesday 13 October at 2:30pm", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_local_date_across_utc_midnight(self):
+        # 13 Oct 11:00 UTC is 14 Oct 00:00 NZDT, so the reminder gives Wednesday 14 October.
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 11), clinic="WK"))
+        self.assertIn("Wednesday 14 October", text)
+
+    def test_never_says_what_the_appointment_is_for(self):
+        for kind in ["assessment", "followup"]:
+            with self.subTest(kind=kind):
+                text = reminder_text(appt("a1", utc(2026, 10, 12, 20), kind=kind, treatment="lower back pain"))
+                self.assertNotIn("lower back pain", text)
+                self.assertNotIn("assessment", text.lower())
+                self.assertNotIn("follow", text.lower())
+                self.assertNotIn("KP-", text)
+
+    def test_fits_in_one_sms_segment(self):
+        for code in CLINICS:
+            with self.subTest(clinic=code):
+                text = reminder_text(appt("a1", utc(2026, 10, 12, 20), clinic=code))
+                self.assertLessEqual(len(text), 160)
+
+
+if __name__ == "__main__":
+    unittest.main()
