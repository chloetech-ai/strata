+"""Text of the SMS reminders sent before appointments.
+
+Reminders carry only the date, the time and the clinic's name. They never say
+what the appointment is for, and they don't name the patient.
+"""
+
+from .calendar import AUCKLAND
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder text for an appointment, in local Auckland time."""
+    local = appointment.start.astimezone(AUCKLAND)
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return f"Kia ora! Just a reminder of your appointment at {clinic} on {when}. We look forward to seeing you."
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
