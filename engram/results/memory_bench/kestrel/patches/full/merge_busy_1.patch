+import unittest
+
+from helpers import utc
+from kestrel.intervals import merge_busy
+
+
+def t(hh, mm=0):
+    return utc(2027, 3, 1, hh, mm)
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_disjoint_stay_separate_and_sorted(self):
+        self.assertEqual(merge_busy([(t(14), t(15)), (t(9), t(10))]), [(t(9), t(10)), (t(14), t(15))])
+
+    def test_overlapping_merge(self):
+        self.assertEqual(merge_busy([(t(9), t(10, 30)), (t(10), t(11))]), [(t(9), t(11))])
+
+    def test_touching_merge(self):
+        self.assertEqual(merge_busy([(t(9), t(10)), (t(10), t(11))]), [(t(9), t(11))])
+
+    def test_contained_interval_does_not_shorten(self):
+        self.assertEqual(merge_busy([(t(9), t(12)), (t(10), t(11))]), [(t(9), t(12))])
+
+    def test_any_order(self):
+        intervals = [(t(13), t(14)), (t(9), t(9, 45)), (t(9, 30), t(10)), (t(10), t(10, 15))]
+        self.assertEqual(merge_busy(intervals), [(t(9), t(10, 15)), (t(13), t(14))])
+
+    def test_single_interval(self):
+        self.assertEqual(merge_busy([(t(9), t(10))]), [(t(9), t(10))])
+
+    def test_rejects_end_before_start(self):
+        with self.assertRaises(ValueError):
+            merge_busy([(t(10), t(9))])
+
+
+if __name__ == "__main__":
+    unittest.main()
