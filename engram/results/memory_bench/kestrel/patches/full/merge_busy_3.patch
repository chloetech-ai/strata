+"""Time intervals."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs, given in any order, into sorted, non-overlapping pairs.
+
+    Pairs that touch (one ends where the next starts) are merged too.
+    Raises ValueError for a pair whose start is after its end.
+    """
+    pairs = [(start, end) for start, end in intervals]
+    for start, end in pairs:
+        if start > end:
+            raise ValueError(f"interval starts after it ends: {(start, end)!r}")
+    merged = []
+    for start, end in sorted(pairs):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
