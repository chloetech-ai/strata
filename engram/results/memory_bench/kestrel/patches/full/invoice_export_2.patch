+"""Monthly export of invoices for the accountant, in the format Xero imports.
+
+The file leaves the system, so it carries patient IDs only, never names.
+"""
+
+import csv
+import datetime
+from decimal import Decimal
+import os
+import tempfile
+
+HEADER = ["InvoiceNumber", "ClinicCode", "PatientID", "InvoiceDate", "Amount", "Description"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to kestrel-invoices-YYYY-MM.csv in out_dir, and return its path.
+
+    The month is the invoice's issue date (local Auckland). A month with no
+    invoices gives a file with only the header row.
+    """
+    datetime.date(year, month, 1)  # raises ValueError for a bad month
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    # Write to a temporary file first, so the accountant never gets a half-written export.
+    fd, tmp_path = tempfile.mkstemp(dir=out_dir, prefix="kestrel-invoices-", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
+            writer = csv.writer(f)
+            writer.writerow(HEADER)
+            for i in chosen:
+                writer.writerow([
+                    i.number,
+                    i.clinic,
+                    i.patient_id,
+                    f"{i.issued:%d/%m/%Y}",
+                    f"{Decimal(i.amount_cents) / 100:.2f}",
+                    i.description,
+                ])
+        os.replace(tmp_path, path)
+    except BaseException:
+        os.unlink(tmp_path)
+        raise
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
