@@ -0,0 +1,99 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from helpers import appt, utc
+from kestrel.export import HEADER, export_invoices
+from kestrel.invoices import make_invoice
+from kestrel.models import Patient
+
+PATIENT = Patient("KP-004211", "Ana Silva", "+64211234567")
+
+
+def invoice(number, start, clinic="HB", kind="followup", cents=7000):
+    return make_invoice(appt("a", start, clinic=clinic, kind=kind), PATIENT, number, cents)
+
+
+def read_rows(path):
+    with open(path, encoding="utf-8", newline="") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.out = self._dir.name
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def test_file_name_and_return_value(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", utc(2027, 3, 1, 20))], 2027, 3, self.out)
+        self.assertEqual(path, os.path.join(self.out, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_and_row_format(self):
+        path = export_invoices(
+            [invoice("INV-HB-2027-00042", utc(2027, 3, 1, 20), clinic="HB", kind="assessment", cents=9500)],
+            2027, 3, self.out,
+        )
+        self.assertEqual(read_rows(path), [
+            HEADER,
+            ["INV-HB-2027-00042", "HB", "KP-004211", "02/03/2027", "95.00", "Initial assessment"],
+        ])
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        path = export_invoices([invoice("INV-NG-2027-00001", utc(2027, 3, 1, 20), cents=7005)], 2027, 3, self.out)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertIn(",70.05,", text)
+        self.assertNotIn("$", text)
+
+    def test_only_the_requested_month(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", utc(2027, 2, 27, 10)),  # 27 Feb 23:00 NZDT, so February
+            invoice("INV-HB-2027-00002", utc(2027, 3, 15, 20)),
+            invoice("INV-HB-2027-00003", utc(2027, 4, 15, 20)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2027-00002"])
+
+    def test_month_uses_local_date(self):
+        # 31 Mar 2027 13:00 UTC is 1 Apr 02:00 NZDT, so the invoice belongs to April.
+        invoices = [invoice("INV-HB-2027-00001", utc(2027, 3, 31, 13))]
+        self.assertEqual(read_rows(export_invoices(invoices, 2027, 3, self.out)), [HEADER])
+        april = read_rows(export_invoices(invoices, 2027, 4, self.out))
+        self.assertEqual(april[1][0], "INV-HB-2027-00001")
+        self.assertEqual(april[1][3], "01/04/2027")
+
+    def test_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2027-00003", utc(2027, 3, 20, 20)),
+            invoice("INV-HB-2027-00002", utc(2027, 3, 5, 20)),
+            invoice("INV-NG-2027-00001", utc(2027, 3, 5, 20)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2027-00002", "INV-NG-2027-00001", "INV-HB-2027-00003"])
+
+    def test_empty_month_has_header_only(self):
+        rows = read_rows(export_invoices([], 2027, 3, self.out))
+        self.assertEqual(rows, [HEADER])
+
+    def test_no_patient_name_in_file(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", utc(2027, 3, 1, 20))], 2027, 3, self.out)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Ana", f.read())
+
+    def test_no_temporary_files_left(self):
+        export_invoices([invoice("INV-HB-2027-00001", utc(2027, 3, 1, 20))], 2027, 3, self.out)
+        self.assertEqual(os.listdir(self.out), ["kestrel-invoices-2027-03.csv"])
+
+    def test_rejects_bad_month(self):
+        with self.assertRaises(ValueError):
+            export_invoices([], 2027, 13, self.out)
+
+
+if __name__ == "__main__":
+    unittest.main()
