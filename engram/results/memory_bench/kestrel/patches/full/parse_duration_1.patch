+"""Durations such as '45m', '1h' and '1h30'."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*m")
+_HOURS = re.compile(r"(\d+)\s*h")
+_HOURS_AND_MINUTES = re.compile(r"(\d+)\s*h\s*(?:(\d+)\s*m?)?")
+
+
+def parse_duration(text):
+    """Turn a duration like '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Raises ValueError for anything else, including zero, and for minutes of 60 or more
+    after an hour.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"not a duration: {text!r}")
+    t = text.strip().lower()
+    minutes = None
+    if m := _MINUTES.fullmatch(t):
+        minutes = int(m.group(1))
+    elif m := _HOURS_AND_MINUTES.fullmatch(t):
+        extra = int(m.group(2)) if m.group(2) else 0
+        if extra >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        minutes = int(m.group(1)) * 60 + extra
+    elif m := _HOURS.fullmatch(t):
+        minutes = int(m.group(1)) * 60
+    if minutes is None or minutes <= 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..7f9f73e
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,37 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("15 m"), 15)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+        self.assertEqual(parse_duration("2h"), 120)
+
+    def test_hours_and_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("1h 30"), 90)
+        self.assertEqual(parse_duration("2h05m"), 125)
+
+    def test_surrounding_space_and_case(self):
+        self.assertEqual(parse_duration("  45M "), 45)
+        self.assertEqual(parse_duration("1H30"), 90)
+
+    def test_rejects_everything_else(self):
+        for text in ["", "45", "m", "h", "1.5h", "1h60", "1h90m", "0m", "0h", "1d", "1h-30", "1h30m5", "45 minutes", "-45m"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_non_strings(self):
+        with self.assertRaises(ValueError):
+            parse_duration(45)
+
+
+if __name__ == "__main__":
+    unittest.main()
