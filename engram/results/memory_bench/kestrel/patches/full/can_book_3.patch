+"""Checks the booking form runs before saving a new appointment."""
+
+import datetime
+
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+NOTES_GAP_MINUTES = 15  # after an assessment, before the therapist sees the next patient
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added for this therapist, else False.
+
+    It must start on a quarter hour, and its time, plus the notes gap after an
+    assessment, must not overlap a booked appointment for the same therapist.
+    """
+    if appointment.therapist_id != therapist:
+        raise ValueError(f"appointment is for {appointment.therapist_id!r}, not {therapist!r}")
+    if appointment.start.astimezone(AUCKLAND).minute % 15 != 0:
+        return False
+    new_start, new_end = _busy(appointment)
+    for other in calendar.for_therapist(therapist):
+        if other.status != BOOKED:
+            continue
+        other_start, other_end = _busy(other)
+        if new_start < other_end and other_start < new_end:
+            return False
+    return True
+
+
+def _busy(appointment):
+    """The span an appointment occupies: its duration, plus the notes gap after an assessment."""
+    minutes = MINUTES[appointment.kind]
+    if appointment.kind == ASSESSMENT:
+        minutes += NOTES_GAP_MINUTES
+    return appointment.start, appointment.start + datetime.timedelta(minutes=minutes)
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..6b89ea8
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,68 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import AUCKLAND, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
+
+def local(day, hh, mm=0):
+    """A time on 2027-03-DD at hh:mm in Auckland."""
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=AUCKLAND)
+
+
+def new(start, kind=FOLLOWUP, therapist="T1"):
+    return appt("new", start, kind=kind, therapist=therapist)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), "T1", new(local(1, 9))))
+
+    def test_followups_back_to_back(self):
+        cal = Calendar([appt("a1", local(1, 9), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, "T1", new(local(1, 9, 30))))
+
+    def test_followup_overlapping_followup(self):
+        cal = Calendar([appt("a1", local(1, 9), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, "T1", new(local(1, 9, 15))))
+
+    def test_gap_after_assessment(self):
+        # Assessment 09:00-09:45, then 15 minutes of notes until 10:00.
+        cal = Calendar([appt("a1", local(1, 9), kind=ASSESSMENT)])
+        self.assertFalse(can_book(cal, "T1", new(local(1, 9, 45))))
+        self.assertTrue(can_book(cal, "T1", new(local(1, 10))))
+
+    def test_no_gap_after_followup(self):
+        cal = Calendar([appt("a1", local(1, 9), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, "T1", new(local(1, 9, 30), kind=ASSESSMENT)))
+
+    def test_new_assessment_needs_its_own_notes_gap(self):
+        # A new assessment 08:30-09:15 plus notes takes the therapist until 09:30.
+        cal = Calendar([appt("a1", local(1, 9, 15), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, "T1", new(local(1, 8, 30), kind=ASSESSMENT)))
+
+    def test_new_followup_ending_as_assessment_starts(self):
+        cal = Calendar([appt("a1", local(1, 9, 45), kind=ASSESSMENT)])
+        self.assertTrue(can_book(cal, "T1", new(local(1, 9, 15))))
+
+    def test_must_start_on_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), "T1", new(local(1, 9, 10))))
+        self.assertTrue(can_book(Calendar(), "T1", new(local(1, 9, 45))))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(1, 9), kind=FOLLOWUP, therapist="T2")])
+        self.assertTrue(can_book(cal, "T1", new(local(1, 9))))
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(1, 9), kind=FOLLOWUP, status="cancelled")])
+        self.assertTrue(can_book(cal, "T1", new(local(1, 9))))
+
+    def test_appointment_must_be_for_this_therapist(self):
+        with self.assertRaises(ValueError):
+            can_book(Calendar(), "T1", new(local(1, 9), therapist="T2"))
+
+
+if __name__ == "__main__":
+    unittest.main()
