+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text(self):
+        # 13 Oct 2026 09:00 UTC is 13 Oct 22:00 NZDT.
+        a = appt("a1", utc(2026, 10, 13, 9), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Kia ora! Reminder: you have an appointment at Kestrel Physio Harbour on Tuesday 13 October at 10:00pm. See you then.",
+        )
+
+    def test_uses_clinic_name(self):
+        a = appt("a1", utc(2026, 10, 13, 2), clinic="NG")  # 13 Oct 15:00 NZDT
+        self.assertIn("Kestrel Physio Northgate", reminder_text(a))
+        self.assertIn("at 3:00pm", reminder_text(a))
+
+    def test_local_date_across_utc_midnight(self):
+        # 13 Oct 10:30 UTC is 13 Oct 23:30 NZDT, still Tuesday locally.
+        a = appt("a1", utc(2026, 10, 13, 10, 30))
+        self.assertIn("on Tuesday 13 October at 11:30pm", reminder_text(a))
+
+    def test_midnight_and_noon(self):
+        midnight = appt("a1", utc(2026, 10, 13, 11))  # 14 Oct 00:00 NZDT
+        noon = appt("a2", utc(2026, 10, 14, 23))      # 15 Oct 12:00 NZDT
+        self.assertIn("on Wednesday 14 October at 12:00am", reminder_text(midnight))
+        self.assertIn("on Thursday 15 October at 12:00pm", reminder_text(noon))
+
+    def test_does_not_say_what_the_appointment_is_for(self):
+        for kind in ["assessment", "followup"]:
+            a = appt("a1", utc(2026, 10, 13, 9), kind=kind, treatment="lower back pain")
+            text = reminder_text(a).lower()
+            with self.subTest(kind=kind):
+                self.assertNotIn("lower back", text)
+                self.assertNotIn("assessment", text)
+                self.assertNotIn("follow", text)
+                self.assertNotIn("treatment", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
