+"""Free appointment slots for a therapist on a day."""
+
+import datetime
+
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, BOOKED, FOLLOWUP, KINDS
+
+# How long each kind takes, and the notes gap the therapist needs after it, in minutes.
+DURATION = {ASSESSMENT: 45, FOLLOWUP: 30}
+NOTES_GAP = {ASSESSMENT: 15, FOLLOWUP: 0}
+
+# Appointments start on a quarter hour.
+STEP = datetime.timedelta(minutes=15)
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a date, or None if closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times, sorted, at which a new appointment of this kind could be booked.
+
+    A slot is free if the appointment fits inside the clinic's opening hours and the
+    therapist has no booked appointment clashing with it, including the notes gap
+    after any assessment.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    opens = datetime.datetime.combine(day, hours[0], tzinfo=AUCKLAND)
+    closes = datetime.datetime.combine(day, hours[1], tzinfo=AUCKLAND)
+
+    length = datetime.timedelta(minutes=DURATION[kind])
+    hold = length + datetime.timedelta(minutes=NOTES_GAP[kind])
+    busy = [
+        (a.start, a.start + datetime.timedelta(minutes=DURATION[a.kind] + NOTES_GAP[a.kind]))
+        for a in calendar.booked()
+        if a.therapist_id == therapist.id
+    ]
+
+    slots = []
+    start = opens
+    while start + length <= closes:
+        end = start + hold
+        if all(end <= busy_start or busy_end <= start for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..30b8af0
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,93 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MONDAY = datetime.date(2026, 10, 12)
+SATURDAY = datetime.date(2026, 10, 17)
+SUNDAY = datetime.date(2026, 10, 18)
+HB_THERAPIST = Therapist("T1", "Jo Park", "HB")
+NG_THERAPIST = Therapist("T2", "Sam Lee", "NG")
+
+
+def t(hh, mm):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_follow_up(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertEqual(len(slots), 41)  # 07:30 to 17:30 in quarter hours
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))
+
+    def test_empty_weekday_assessment_must_end_by_close(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertEqual(len(slots), 40)
+        self.assertEqual(slots[-1], t(17, 15))
+
+    def test_slots_are_sorted_local_times_on_quarter_hours(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(s.minute % 15 == 0 and s.second == 0 for s in slots))
+
+    def test_booked_follow_up_blocks_its_half_hour(self):
+        # Local 09:00 to 09:30 is booked. Anything overlapping it is out.
+        cal = Calendar([appt("a1", utc(2026, 10, 11, 20), therapist="T1", kind=FOLLOWUP)])  # 12 Oct 09:00 NZDT
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        for gone in [t(8, 45), t(9, 0), t(9, 15)]:
+            self.assertNotIn(gone, slots)
+        self.assertIn(t(8, 30), slots)
+        self.assertIn(t(9, 30), slots)
+
+    def test_assessment_blocks_its_notes_gap(self):
+        # Assessment 09:00 to 09:45, then notes until 10:00.
+        cal = Calendar([appt("a1", utc(2026, 10, 11, 20), therapist="T1", kind=ASSESSMENT)])
+        follow_ups = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(9, 45), follow_ups)  # inside the notes gap
+        self.assertIn(t(10, 0), follow_ups)
+        self.assertIn(t(8, 30), follow_ups)  # a follow-up ending at 09:00 is fine
+
+    def test_new_assessment_needs_its_own_gap_before_next_booking(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 11, 20), therapist="T1", kind=FOLLOWUP)])  # 09:00 to 09:30
+        assessments = free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT)
+        # 08:15 to 09:15 would run into the follow-up at 09:00.
+        self.assertNotIn(t(8, 15), assessments)
+        self.assertIn(t(7, 30), assessments)  # 07:30 to 08:30 is clear
+
+    def test_cancelled_and_other_therapists_do_not_block(self):
+        cal = Calendar([
+            appt("a1", utc(2026, 10, 11, 20), therapist="T1", status=CANCELLED),
+            appt("a2", utc(2026, 10, 11, 20), therapist="T2"),
+        ])
+        self.assertIn(t(9, 0), free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_utc_stored_appointment_blocks_local_time(self):
+        # 11 Oct 21:00 UTC is 12 Oct 10:00 NZDT.
+        cal = Calendar([appt("a1", utc(2026, 10, 11, 21), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_saturday_only_northgate_08_to_12(self):
+        ng = free_slots(Calendar(), NG_THERAPIST, SATURDAY, FOLLOWUP)
+        self.assertEqual(ng[0], t(8, 0))
+        self.assertEqual(ng[-1], t(11, 30))
+        self.assertEqual(len(ng), 15)
+        self.assertEqual(free_slots(Calendar(), HB_THERAPIST, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), NG_THERAPIST, SUNDAY, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HB_THERAPIST, SUNDAY, ASSESSMENT), [])
+
+    def test_rejects_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB_THERAPIST, MONDAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
