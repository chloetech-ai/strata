+"""Monthly export of invoices for the accountant.
+
+The file is a comma-separated CSV with a header row, dates as DD/MM/YYYY and
+amounts as plain numbers with two decimals, as the accountant's import expects.
+It carries patient IDs, never patient names.
+"""
+
+import csv
+import datetime
+import os
+
+COLUMNS = ["InvoiceNumber", "Date", "Clinic", "PatientID", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to out_dir and return the file's path."""
+    first = datetime.date(year, month, 1)  # raises ValueError for a bad month
+    last_day = (first.replace(day=28) + datetime.timedelta(days=4)).replace(day=1) - datetime.timedelta(days=1)
+    in_month = sorted(
+        (i for i in invoices if first <= i.issued <= last_day),
+        key=lambda i: (i.issued, i.number),
+    )
+
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for i in in_month:
+            writer.writerow([
+                i.number,
+                i.issued.strftime("%d/%m/%Y"),
+                i.clinic,
+                i.patient_id,
+                i.description,
+                _amount(i.amount_cents),
+            ])
+    return path
+
+
+def _amount(cents):
+    dollars, cents = divmod(cents, 100)
+    return f"{dollars}.{cents:02d}"
diff --git a/tests/test_export.py b/tests/test_export.py
