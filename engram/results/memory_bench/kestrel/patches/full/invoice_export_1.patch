+++ b/tests/test_export.py
@@ -0,0 +1,94 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents, description="Follow-up session", clinic="HB", patient_id="KP-004211"):
+    return Invoice(number, clinic, patient_id, datetime.date(*issued), amount_cents, description)
+
+
+def read_rows(path):
+    with open(path, encoding="utf-8", newline="") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.out_dir = self._dir.name
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def test_filename_and_return_value(self):
+        path = export_invoices([], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_and_row_format(self):
+        path = export_invoices([invoice("INV-HB-2027-00042", (2027, 3, 1), 7000)], 2027, 3, self.out_dir)
+        self.assertEqual(read_rows(path), [
+            ["InvoiceNumber", "Date", "Clinic", "PatientID", "Description", "Amount"],
+            ["INV-HB-2027-00042", "01/03/2027", "HB", "KP-004211", "Follow-up session", "70.00"],
+        ])
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", (2027, 3, 1), 9500),
+            invoice("INV-HB-2027-00002", (2027, 3, 2), 105),
+            invoice("INV-HB-2027-00003", (2027, 3, 3), 7800),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out_dir))[1:]
+        self.assertEqual([r[5] for r in rows], ["95.00", "1.05", "78.00"])
+
+    def test_only_the_requested_month(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", (2027, 2, 28), 7000),  # last day of February
+            invoice("INV-HB-2027-00002", (2027, 3, 1), 7000),
+            invoice("INV-HB-2027-00003", (2027, 3, 31), 7000),
+            invoice("INV-HB-2027-00004", (2027, 4, 1), 7000),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out_dir))[1:]
+        self.assertEqual([r[0] for r in rows], ["INV-HB-2027-00002", "INV-HB-2027-00003"])
+
+    def test_december_rolls_over_correctly(self):
+        invoices = [invoice("INV-HB-2026-00001", (2026, 12, 31), 7000), invoice("INV-HB-2027-00001", (2027, 1, 1), 7000)]
+        rows = read_rows(export_invoices(invoices, 2026, 12, self.out_dir))[1:]
+        self.assertEqual([r[0] for r in rows], ["INV-HB-2026-00001"])
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-NG-2027-00002", (2027, 3, 5), 7000, clinic="NG"),
+            invoice("INV-HB-2027-00009", (2027, 3, 2), 7000),
+            invoice("INV-HB-2027-00001", (2027, 3, 5), 7000),
+        ]
+        rows = read_rows(export_invoices(invoices, 2027, 3, self.out_dir))[1:]
+        self.assertEqual([r[0] for r in rows], ["INV-HB-2027-00009", "INV-HB-2027-00001", "INV-NG-2027-00002"])
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", (2027, 4, 1), 7000)], 2027, 3, self.out_dir)
+        self.assertEqual(read_rows(path), [["InvoiceNumber", "Date", "Clinic", "PatientID", "Description", "Amount"]])
+
+    def test_commas_in_descriptions_are_quoted(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", (2027, 3, 1), 7000, description="Follow-up, neck")], 2027, 3, self.out_dir)
+        self.assertEqual(read_rows(path)[1][4], "Follow-up, neck")
+
+    def test_bad_month_is_rejected(self):
+        with self.assertRaises(ValueError):
+            export_invoices([], 2027, 13, self.out_dir)
+
+    def test_no_patient_names_in_file(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", (2027, 3, 1), 7000)], 2027, 3, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertIn("KP-004211", text)
+        self.assertNotIn("Ana", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
