+import re
 
 from .calendar import AUCKLAND
 from .models import ASSESSMENT, CLINICS, FOLLOWUP
@@ -48,12 +49,12 @@ def invoice_number(clinic, year, sequence):
     return f"INV-{clinic}-{year}-{sequence:05d}"
 
 
-def next_invoice_number(existing, clinic, year):
-    """The next number for a clinic in a year, given the numbers already issued.
+def next_invoice_number(clinic, year, existing):
+    """The next number for a clinic in a year, given every invoice number issued so far.
 
     Sequences count separately per clinic and restart each year, so numbers from
     other clinics or years are ignored.
     """
-    prefix = f"INV-{clinic}-{year}-"
-    used = [int(n[len(prefix):]) for n in existing if n.startswith(prefix)]
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-([0-9]{{5}})")
+    used = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
     return invoice_number(clinic, year, max(used, default=0) + 1)
