diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index d755b9a..3fc5d16 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -44,5 +44,12 @@ class Waitlist:
     def entries(self):
         return sorted(self._entries, key=lambda e: (not e.urgent, e.requested_at))
 
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None. The entry stays on the waitlist."""
+        for e in self.entries():
+            if e.kind == kind:
+                return e
+        return None
+
     def __len__(self):
         return len(self._entries)
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index bbd1fc3..289c8e5 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -62,6 +62,37 @@ class WaitlistTest(unittest.TestCase):
         self.assertEqual(wl.remove("Kp-1").patient_id, "KP-000001")
         self.assertEqual(len(wl), 0)
 
+    def test_next_for_is_first_in_order_for_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2026, 10, 1, 9), kind=FOLLOWUP))
+        wl.add(entry("KP-000002", utc(2026, 10, 2, 9), kind=FOLLOWUP))
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000001")
+
+    def test_next_for_offers_urgent_first(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2026, 10, 1, 9), kind=FOLLOWUP))
+        wl.add(entry("KP-000002", utc(2026, 10, 9, 9), kind=FOLLOWUP, urgent=True))
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000002")
+
+    def test_next_for_matches_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2026, 10, 1, 9), kind=ASSESSMENT))
+        wl.add(entry("KP-000002", utc(2026, 10, 2, 9), kind=FOLLOWUP))
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000002")
+        self.assertEqual(wl.next_for(ASSESSMENT).patient_id, "KP-000001")
+
+    def test_next_for_returns_none_when_nobody_waits_for_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2026, 10, 1, 9), kind=ASSESSMENT))
+        self.assertIsNone(wl.next_for(FOLLOWUP))
+        self.assertIsNone(Waitlist().next_for(ASSESSMENT))
+
+    def test_next_for_does_not_remove_the_entry(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2026, 10, 1, 9)))
+        wl.next_for(FOLLOWUP)
+        self.assertEqual(len(wl), 1)
+
     def test_entry_rejects_unknown_kind(self):
         with self.assertRaises(ValueError):
             entry("KP-000001", utc(2026, 10, 1, 9), kind="massage")
