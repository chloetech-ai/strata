+"""Durations such as '45m', '1h' and '1h 30m'."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*m")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*m?)?")
+
+
+def parse_duration(text):
+    """Turn a duration like '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Minutes after the hours must be under 60, and the total must be positive.
+    Anything else raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"not a duration: {text!r}")
+    text = text.strip()
+    match = _MINUTES.fullmatch(text)
+    if match:
+        minutes = int(match.group(1))
+    else:
+        match = _HOURS.fullmatch(text)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        hours = int(match.group(1))
+        minutes = int(match.group(2)) if match.group(2) else 0
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        minutes += hours * 60
+    if minutes <= 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..83c67c7
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,30 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_valid_forms(self):
+        cases = {
+            "45m": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "1h30m": 90,
+            "2h 5m": 125,
+            "90m": 90,
+            " 30m ": 30,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_rejects_everything_else(self):
+        for text in ["", "   ", "45", "1h60", "1h 90m", "0m", "0h", "-1h", "1.5h", "1 hour", "abc", "1h 30m extra", "1H", None, 45]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
