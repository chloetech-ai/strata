 """Session prices, in cents (NZD)."""
 
-from .models import ASSESSMENT, FOLLOWUP
+import datetime
 
-PRICES_CENTS = {
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, NO_SHOW
+
+# Prices for appointments on or after PRICE_CHANGE (local Auckland date).
+# Earlier appointments keep the old prices.
+PRICE_CHANGE = datetime.date(2027, 4, 1)
+PRICES_BEFORE_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+PRICES_FROM_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
 
-def session_price(kind):
-    """The full price of a session of the given kind, in cents."""
-    if kind not in PRICES_CENTS:
+def session_price(kind, day):
+    """The full price of a session of the given kind on a local Auckland date, in cents."""
+    if kind not in PRICES_BEFORE_CENTS:
         raise ValueError(f"unknown kind {kind!r}")
-    return PRICES_CENTS[kind]
+    prices = PRICES_FROM_CENTS if day >= PRICE_CHANGE else PRICES_BEFORE_CENTS
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for an appointment, in cents.
+
+    Card holders get CSC_FOLLOWUP_DISCOUNT_PERCENT off follow-ups, but not
+    assessments. A no-show pays the full price, without the discount.
+    Cancellation fees are not built yet, so cancelled appointments are refused.
+    """
+    if appointment.status == CANCELLED:
+        raise ValueError(f"cancellation fee for appointment {appointment.id} is not built yet")
+    day = appointment.start.astimezone(AUCKLAND).date()
+    price = session_price(appointment.kind, day)
+    if appointment.status == NO_SHOW:
+        return price
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
