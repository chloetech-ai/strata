-"""Session prices, in cents (NZD)."""
+"""Session prices, in cents (NZD).
 
-from .models import ASSESSMENT, FOLLOWUP
+Prices are set by the local Auckland date of the appointment. Appointments from
+NEW_PRICES_FROM onwards pay the new prices; earlier ones keep the old prices.
+"""
 
-PRICES_CENTS = {
+import datetime
+
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20  # Community Services Card holders, follow-ups only
 
-def session_price(kind):
-    """The full price of a session of the given kind, in cents."""
-    if kind not in PRICES_CENTS:
+LATE_CANCEL_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCEL_FEE_PERCENT = 50  # of the session price
+NO_SHOW_FEE_PERCENT = 100  # of the session price
+
+
+def session_price(kind, day):
+    """The full price of a session of the given kind on a local Auckland date, in cents."""
+    if kind not in OLD_PRICES_CENTS:
         raise ValueError(f"unknown kind {kind!r}")
-    return PRICES_CENTS[kind]
+    prices = NEW_PRICES_CENTS if day >= NEW_PRICES_FROM else OLD_PRICES_CENTS
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for an appointment, in cents.
+
+    - Attended and booked: the session price, less the CSC discount on follow-ups.
+    - Cancelled less than 48 hours before the start: 50% of the session price,
+      undiscounted. Earlier cancellations cost nothing.
+    - No-show: the full session price, undiscounted.
+    """
+    day = appointment.start.astimezone(AUCKLAND).date()
+    full = session_price(appointment.kind, day)
+    if appointment.status in (ATTENDED, BOOKED):
+        if patient.csc and appointment.kind == FOLLOWUP:
+            return full * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+        return full
+    if appointment.status == NO_SHOW:
+        return full * NO_SHOW_FEE_PERCENT // 100
+    if appointment.status == CANCELLED:
+        if appointment.cancelled_at is None:
+            raise ValueError("cancelled appointment has no cancellation time")
+        if appointment.start - appointment.cancelled_at < LATE_CANCEL_WINDOW:
+            return full * LATE_CANCEL_FEE_PERCENT // 100
+        return 0
+    raise ValueError(f"unknown status {appointment.status!r}")
