 """Session prices, in cents (NZD)."""
 
-from .models import ASSESSMENT, FOLLOWUP
+import datetime
 
-PRICES_CENTS = {
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)  # local Auckland date
+
+CSC_FOLLOWUP_PERCENT_OFF = 20  # Community Services Card holders, follow-ups only
 
 
-def session_price(kind):
-    """The full price of a session of the given kind, in cents."""
-    if kind not in PRICES_CENTS:
+def session_price(kind, day):
+    """The full price of a session of the given kind on a local Auckland date, in cents."""
+    if kind not in OLD_PRICES_CENTS:
         raise ValueError(f"unknown kind {kind!r}")
-    return PRICES_CENTS[kind]
+    prices = NEW_PRICES_CENTS if day >= NEW_PRICES_FROM else OLD_PRICES_CENTS
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    Booked and attended appointments pay the session price, less 20% for CSC
+    holders on follow-ups. A no-show pays the full session price, undiscounted.
+    Late-cancellation fees are not built yet, so cancelled appointments raise.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id} is not for patient {patient.id}")
+    if appointment.status == CANCELLED:
+        raise ValueError(f"cancellation fees are not built yet (appointment {appointment.id})")
+    day = appointment.start.astimezone(AUCKLAND).date()
+    price = session_price(appointment.kind, day)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status not in (BOOKED, ATTENDED):
+        raise ValueError(f"unknown status {appointment.status!r}")
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
+    return price
