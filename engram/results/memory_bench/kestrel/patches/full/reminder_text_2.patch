+"""Text for SMS appointment reminders.
+
+Reminders say only when and where. They never say what the appointment is for.
+"""
+
+from .calendar import AUCKLAND
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment: the local date, the time and the clinic name."""
+    start = appointment.start.astimezone(AUCKLAND)
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora from {clinic}. Reminder: you have an appointment on "
+        f"{start:%A} {start.day} {start:%B} at {_clock(start)}. "
+        "Call us if you need to change it. See you then!"
+    )
+
+
+def _clock(t):
+    """12-hour time such as 9:00am or 1:30pm, without the leading zero that %-I would need."""
+    hour = t.hour % 12 or 12
+    suffix = "am" if t.hour < 12 else "pm"
+    return f"{hour}:{t.minute:02d}{suffix}"
