+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_date_time_and_clinic(self):
+        # 13 Oct 2026 20:00 UTC is Tuesday 14 Oct 09:00 NZDT.
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 20), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Wednesday 14 October at 9:00am", text)
+
+    def test_afternoon_time(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 14, 1, 30), clinic="NG"))  # 14:30 NZDT
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("at 2:30pm", text)
+
+    def test_local_date_across_utc_midnight(self):
+        # 13 Oct 11:00 UTC is 14 Oct 00:00 NZDT.
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 11), clinic="WK"))
+        self.assertIn("Kestrel Physio Westwick", text)
+        self.assertIn("Wednesday 14 October at 12:00am", text)
+
+    def test_never_mentions_treatment_or_kind(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 20), clinic="HB", kind="assessment", treatment="lower back pain"))
+        self.assertNotIn("lower back", text)
+        self.assertNotIn("assessment", text.lower())
+
+    def test_fits_one_sms(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 20), clinic="HB"))
+        self.assertLessEqual(len(text), 160)
+
+
+if __name__ == "__main__":
+    unittest.main()
