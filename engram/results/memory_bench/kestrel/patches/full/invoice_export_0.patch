+"""Monthly export of invoices for the accountant, as CSV for Xero.
+
+The file carries patient ids only, never names: it leaves the system.
+"""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "Clinic", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to out_dir and return the file's path.
+
+    Amounts are plain numbers with two decimals, with no dollar sign. Dates are DD/MM/YYYY.
+    """
+    month_invoices = sorted(
+        (inv for inv in invoices if inv.issued.year == year and inv.issued.month == month),
+        key=lambda inv: (inv.issued, inv.number),
+    )
+    os.makedirs(out_dir, exist_ok=True)
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for inv in month_invoices:
+            writer.writerow([
+                inv.number,
+                inv.clinic,
+                inv.patient_id,
+                inv.issued.strftime("%d/%m/%Y"),
+                inv.description,
+                _amount(inv.amount_cents),
+            ])
+    return path
+
+
+def _amount(cents):
+    if cents < 0:
+        raise ValueError(f"negative amount {cents} cents is not supported in the export")
+    dollars, cents = divmod(cents, 100)
+    return f"{dollars}.{cents:02d}"
diff --git a/tests/test_export.py b/tests/test_export.py
