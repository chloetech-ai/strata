 """Session prices, in cents (NZD)."""
 
-from .models import ASSESSMENT, FOLLOWUP
+import datetime
 
-PRICES_CENTS = {
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, ATTENDED, BOOKED, FOLLOWUP
+
+# Prices for appointments on or after NEW_PRICES_FROM (local Auckland date).
+# Earlier appointments keep the old prices.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+CSC_DISCOUNT_PERCENT = 20  # Community Services Card holders, follow-ups only
 
 
-def session_price(kind):
-    """The full price of a session of the given kind, in cents."""
-    if kind not in PRICES_CENTS:
+def session_price(kind, day):
+    """The full price of a session of this kind on a local Auckland date, in cents."""
+    prices = NEW_PRICES_CENTS if day >= NEW_PRICES_FROM else OLD_PRICES_CENTS
+    if kind not in prices:
         raise ValueError(f"unknown kind {kind!r}")
-    return PRICES_CENTS[kind]
+    return prices[kind]
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for a booked or attended appointment, in cents.
+
+    Late-cancellation and no-show fees are not built yet, so those statuses are refused.
+    """
+    if appointment.status not in (BOOKED, ATTENDED):
+        raise ValueError(f"no price for an appointment with status {appointment.status!r}")
+    day = appointment.start.astimezone(AUCKLAND).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_DISCOUNT_PERCENT) // 100
+    return price
