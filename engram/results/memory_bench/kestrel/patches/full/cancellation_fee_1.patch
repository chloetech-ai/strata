@@ -0,0 +1,81 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
+
+START = utc(2027, 3, 10, 9)  # a fixed instant; the fee only depends on the gap to the cancellation time
+
+
+class LateCancellationTest(unittest.TestCase):
+    def cancelled(self, hours_before, kind=FOLLOWUP):
+        at = START - datetime.timedelta(hours=hours_before)
+        return appt("a1", START, kind=kind, status="cancelled", cancelled_at=at), at
+
+    def test_under_48_hours_costs_half_the_session_price(self):
+        a, at = self.cancelled(47, kind=FOLLOWUP)
+        self.assertEqual(cancellation_fee(a, at), 3500)
+
+    def test_assessment_half_price(self):
+        a, at = self.cancelled(24, kind=ASSESSMENT)
+        self.assertEqual(cancellation_fee(a, at), 4750)
+
+    def test_just_under_the_window_is_charged(self):
+        at = START - datetime.timedelta(hours=48) + datetime.timedelta(seconds=1)
+        a = appt("a1", START, status="cancelled", cancelled_at=at)
+        self.assertEqual(cancellation_fee(a, at), 3500)
+
+    def test_exactly_48_hours_is_free(self):
+        a, at = self.cancelled(48)
+        self.assertEqual(cancellation_fee(a, at), 0)
+
+    def test_well_before_is_free(self):
+        a, at = self.cancelled(24 * 7)
+        self.assertEqual(cancellation_fee(a, at), 0)
+
+    def test_after_the_start_is_charged(self):
+        at = START + datetime.timedelta(hours=1)
+        a = appt("a1", START, status="cancelled", cancelled_at=at)
+        self.assertEqual(cancellation_fee(a, at), 3500)
+
+    def test_uses_appointment_cancelled_at_when_not_passed(self):
+        at = START - datetime.timedelta(hours=2)
+        a = appt("a1", START, status="cancelled", cancelled_at=at)
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelled_without_a_time_is_rejected(self):
+        a = appt("a1", START, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancellation_time_is_rejected(self):
+        a = appt("a1", START, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 8, 9))
+
+
+class NoShowTest(unittest.TestCase):
+    def test_no_show_pays_full_followup_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status="no_show")), 7000)
+
+    def test_no_show_pays_full_assessment_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status="no_show")), 9500)
+
+    def test_no_show_takes_no_cancellation_time(self):
+        a = appt("a1", START, status="no_show")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, utc(2027, 3, 8, 9))
+
+
+class OtherStatusTest(unittest.TestCase):
+    def test_booked_has_no_fee(self):
+        self.assertEqual(cancellation_fee(appt("a1", START)), 0)
+
+    def test_attended_has_no_fee(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status="attended")), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
