+"""Cancellation and no-show fees, in cents (NZD)."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for an appointment.
+
+    A cancellation less than 48 hours before the start costs 50% of the session
+    price; one made 48 hours or more before costs nothing. A no-show costs the
+    full price. Any other appointment costs nothing.
+
+    cancelled_at is when the patient cancelled. If omitted, the appointment's
+    own cancelled_at is used. A no-show has no cancellation time.
+    """
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError("a no-show has no cancellation time")
+        return session_price(appointment.kind)
+    if appointment.status == CANCELLED:
+        at = cancelled_at if cancelled_at is not None else appointment.cancelled_at
+        if at is None:
+            raise ValueError("a cancelled appointment needs a cancellation time")
+        if at.tzinfo is None:
+            raise ValueError("cancellation time must be timezone-aware")
+        if appointment.start - at >= LATE_CANCELLATION_WINDOW:
+            return 0
+        return session_price(appointment.kind) * LATE_CANCELLATION_PERCENT // 100
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
