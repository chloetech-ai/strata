@@ -0,0 +1,64 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 1, 20)
+
+    def cancelled(self, kind="followup", cancelled_at=None):
+        return appt("a1", self.start, kind=kind, status="cancelled", cancelled_at=cancelled_at)
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", self.start, kind="followup", status="no_show")), 7000)
+        self.assertEqual(cancellation_fee(appt("a1", self.start, kind="assessment", status="no_show")), 9500)
+
+    def test_late_cancellation_pays_half(self):
+        at = self.start - datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(self.cancelled("followup", at), at), 3500)
+        self.assertEqual(cancellation_fee(self.cancelled("assessment", at), at), 4750)
+
+    def test_cancelled_after_start_pays_half(self):
+        at = self.start + datetime.timedelta(minutes=5)
+        self.assertEqual(cancellation_fee(self.cancelled("followup", at), at), 3500)
+
+    def test_just_inside_window_pays_half(self):
+        at = self.start - datetime.timedelta(hours=48) + datetime.timedelta(minutes=1)
+        self.assertEqual(cancellation_fee(self.cancelled("followup", at), at), 3500)
+
+    def test_exactly_48_hours_is_free(self):
+        at = self.start - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(self.cancelled("followup", at), at), 0)
+
+    def test_early_cancellation_is_free(self):
+        at = self.start - datetime.timedelta(days=3)
+        self.assertEqual(cancellation_fee(self.cancelled("assessment", at), at), 0)
+
+    def test_window_counts_across_timezones(self):
+        # 49 hours before start, expressed in another zone, is still outside the window.
+        at = (self.start - datetime.timedelta(hours=49)).astimezone(datetime.timezone(datetime.timedelta(hours=5)))
+        self.assertEqual(cancellation_fee(self.cancelled("followup", at), at), 0)
+
+    def test_uses_appointment_cancelled_at_when_not_given(self):
+        at = self.start - datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(self.cancelled("followup", at)), 3500)
+
+    def test_cancelled_needs_a_time(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled("followup"))
+
+    def test_rejects_naive_time(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled("followup"), datetime.datetime(2027, 2, 28, 9))
+
+    def test_other_statuses_have_no_fee(self):
+        for status in ["booked", "attended"]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", self.start, status=status))
+
+
+if __name__ == "__main__":
+    unittest.main()
