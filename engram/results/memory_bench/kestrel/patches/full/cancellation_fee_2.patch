+"""Fees for cancelled and missed appointments."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation this close to the start, or later, costs half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for a cancelled or no-show appointment.
+
+    A no-show pays the full session price. A cancellation pays half the session
+    price if it is less than 48 hours before the start, otherwise nothing.
+    cancelled_at is when the patient cancelled; if omitted, the appointment's own
+    cancelled_at is used. It is not needed for a no-show.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for appointment {appointment.id} with status {appointment.status!r}")
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError(f"cancelled appointment {appointment.id} has no cancellation time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancellation time must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
