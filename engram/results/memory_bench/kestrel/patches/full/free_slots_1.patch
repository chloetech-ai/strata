+"""Free appointment slots for a therapist on a day."""
+
+import datetime
+
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, ATTENDED, BOOKED, FOLLOWUP, KINDS
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}  # only Northgate opens on Saturdays
+
+DURATION = {ASSESSMENT: datetime.timedelta(minutes=45), FOLLOWUP: datetime.timedelta(minutes=30)}
+GAP_AFTER = {ASSESSMENT: datetime.timedelta(minutes=15), FOLLOWUP: datetime.timedelta(0)}  # notes time
+STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+OCCUPYING = (BOOKED, ATTENDED)  # cancelled and no-show appointments free their time
+
+
+def opening_hours(clinic, day):
+    """(open, close) for a clinic on a date, or None when the clinic is closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None
+
+
+def _occupied(kind, start):
+    """The time an appointment of this kind holds, including any notes gap after it."""
+    return start, start + DURATION[kind] + GAP_AFTER[kind]
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on a date when a new appointment of this kind could be booked for the therapist.
+
+    The appointment must fit inside the clinic's opening hours. It may not overlap
+    any booked or attended appointment for the therapist, including the notes gap
+    after an assessment.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    opens, closes = (datetime.datetime.combine(day, t, tzinfo=AUCKLAND) for t in hours)
+
+    busy = [
+        _occupied(a.kind, a.start.astimezone(AUCKLAND))
+        for a in calendar.for_therapist(therapist.id)
+        if a.status in OCCUPYING
+    ]
+    slots = []
+    start = opens
+    while start + DURATION[kind] <= closes:
+        begin, end = _occupied(kind, start)
+        if all(end <= b_start or b_end <= begin for b_start, b_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..ef8faef
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,124 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MONDAY = datetime.date(2026, 10, 12)
+SATURDAY = datetime.date(2026, 10, 17)
+SUNDAY = datetime.date(2026, 10, 18)
+HB_THERAPIST = Therapist("T1", "Jo Park", "HB")
+NG_THERAPIST = Therapist("T1", "Jo Park", "NG")
+
+
+def t(hh, mm):
+    return datetime.time(hh, mm)
+
+
+def local(day, hh, mm):
+    """A UTC timestamp for a local Auckland time on a day in NZDT (UTC+13)."""
+    local_start = datetime.datetime.combine(day, datetime.time(hh, mm))
+    return (local_start - datetime.timedelta(hours=13)).replace(tzinfo=datetime.timezone.utc)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_followup(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # 17:30 + 30 min is closing time
+        self.assertEqual(len(slots), 41)
+
+    def test_empty_weekday_assessment_must_finish_by_close(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))  # 17:15 + 45 min is closing time
+        self.assertEqual(len(slots), 40)
+
+    def test_slots_are_quarter_hours_sorted_times(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(s.minute % 15 == 0 and s.second == 0 for s in slots))
+
+    def test_booked_followup_blocks_overlapping_starts(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9, 0), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertIn(t(8, 30), slots)  # ends at 09:00, when the booking starts
+        self.assertNotIn(t(8, 45), slots)
+        self.assertNotIn(t(9, 0), slots)
+        self.assertIn(t(9, 30), slots)
+
+    def test_assessment_leaves_notes_gap(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10, 0), therapist="T1", kind=ASSESSMENT)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertIn(t(9, 0), slots)  # ends at 10:00
+        self.assertNotIn(t(9, 15), slots)
+        self.assertNotIn(t(10, 0), slots)
+        self.assertNotIn(t(10, 45), slots)  # 45-minute assessment ends, then the 15-minute notes gap
+        self.assertIn(t(11, 0), slots)  # free once the notes gap ends
+        self.assertIn(t(11, 15), slots)
+
+    def test_followup_after_assessment_waits_for_notes_gap(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10, 0), therapist="T1", kind=ASSESSMENT)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 45), slots)  # within the notes gap
+        self.assertIn(t(11, 0), slots)  # first start after the gap
+
+    def test_followup_has_no_gap(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10, 0), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_new_assessment_must_leave_room_before_booked_followup(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10, 0), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertNotIn(t(9, 15), slots)  # would run into the follow-up at 10:00
+        self.assertIn(t(9, 0), slots)  # ends at 10:00 exactly
+
+    def test_cancelled_and_no_show_free_their_time(self):
+        cal = Calendar([
+            appt("a1", local(MONDAY, 10, 0), therapist="T1", status="cancelled"),
+            appt("a2", local(MONDAY, 11, 0), therapist="T1", status="no_show"),
+        ])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertIn(t(10, 0), slots)
+        self.assertIn(t(11, 0), slots)
+
+    def test_attended_blocks_its_time(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10, 0), therapist="T1", status="attended")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 0), slots)
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10, 0), therapist="T2")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertIn(t(10, 0), slots)
+
+    def test_uses_local_time_for_bookings(self):
+        # 12 Oct 21:30 UTC is 13 Oct 10:30 NZDT, so it blocks 10:30 on Tuesday 13 Oct.
+        cal = Calendar([appt("a1", utc(2026, 10, 12, 21, 30), therapist="T1")])
+        tuesday = datetime.date(2026, 10, 13)
+        slots = free_slots(cal, HB_THERAPIST, tuesday, FOLLOWUP)
+        self.assertNotIn(t(10, 30), slots)
+        self.assertIn(t(10, 0), slots)  # ends at 10:30, when the booking starts
+
+    def test_saturday_only_northgate_open(self):
+        ng = free_slots(Calendar(), NG_THERAPIST, SATURDAY, FOLLOWUP)
+        self.assertEqual(ng[0], t(8, 0))
+        self.assertEqual(ng[-1], t(11, 30))  # 11:30 + 30 min is closing time
+        self.assertEqual(len(ng), 15)
+        self.assertEqual(free_slots(Calendar(), HB_THERAPIST, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), NG_THERAPIST, SUNDAY, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HB_THERAPIST, SUNDAY, ASSESSMENT), [])
+
+    def test_unknown_kind_is_rejected(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB_THERAPIST, MONDAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
