+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_date_and_time(self):
+        # 13 Oct 2026 09:00 NZDT is a Tuesday morning.
+        text = reminder_text(appt("a1", utc(2026, 10, 12, 20), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 13 October at 9:00am", text)
+
+    def test_afternoon_time(self):
+        # 13 Oct 2026 16:30 NZDT.
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 3, 30), clinic="WK"))
+        self.assertIn("Kestrel Physio Westwick", text)
+        self.assertIn("at 4:30pm", text)
+
+    def test_midnight_and_noon(self):
+        # 12:15am and 12:45pm local, Tuesday 13 October.
+        self.assertIn("at 12:15am", reminder_text(appt("a1", utc(2026, 10, 12, 11, 15))))
+        self.assertIn("at 12:45pm", reminder_text(appt("a1", utc(2026, 10, 12, 23, 45))))
+
+    def test_uses_local_date_not_utc(self):
+        # 13 Oct 11:00 UTC is 14 Oct 00:00 NZDT, so the reminder names Wednesday 14 October.
+        text = reminder_text(appt("a1", utc(2026, 10, 13, 11)))
+        self.assertIn("Wednesday 14 October at 12:00am", text)
+
+    def test_never_mentions_treatment(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 12, 20), treatment="lower back pain"))
+        self.assertNotIn("lower back pain", text.lower())
+        self.assertNotIn("back", text.lower())
+
+    def test_never_mentions_patient(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 12, 20), patient="KP-004211"))
+        self.assertNotIn("KP-004211", text)
+
+    def test_fits_one_sms_segment(self):
+        # The longest clinic name and the longest weekday and month, at the late-morning hour.
+        for clinic in ["NG", "HB", "WK"]:
+            with self.subTest(clinic=clinic):
+                text = reminder_text(appt("a1", utc(2026, 9, 29, 22, 45), clinic=clinic, treatment="rotator cuff tear"))
+                self.assertLessEqual(len(text), 160)
+
+
+if __name__ == "__main__":
+    unittest.main()
