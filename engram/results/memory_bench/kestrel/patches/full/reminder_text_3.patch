+"""Text of the SMS reminder sent two days before an appointment.
+
+The text names the clinic, date and time only. It never says what the
+appointment is for, and it never includes a patient's name.
+"""
+
+from .calendar import AUCKLAND
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    local = appointment.start.astimezone(AUCKLAND)
+    hour = local.hour % 12 or 12
+    meridian = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local.minute:02d}{meridian}"
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: your appointment at {clinic} is on {when}. To change it, please contact the clinic. See you then!"
