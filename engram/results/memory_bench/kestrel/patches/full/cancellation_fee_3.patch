@@ -0,0 +1,32 @@
+"""Fees for cancelled and missed appointments."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for a cancelled or no-show appointment.
+
+    A cancellation less than 48 hours before the start costs half the session price.
+    A cancellation with more notice costs nothing. A no-show costs the full session price.
+    cancelled_at defaults to the appointment's own cancelled_at.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError("a no-show has no cancellation time")
+        return price
+    if appointment.status == CANCELLED:
+        when = cancelled_at if cancelled_at is not None else appointment.cancelled_at
+        if when is None:
+            raise ValueError(f"appointment {appointment.id} has no cancellation time")
+        if when.tzinfo is None:
+            raise ValueError("cancellation time must be timezone-aware")
+        if appointment.start - when < LATE_CANCELLATION_WINDOW:
+            return price // 2
+        return 0
+    raise ValueError(f"no cancellation fee applies to status {appointment.status!r}")
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..46b0886
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,70 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+
+START = utc(2027, 3, 10, 9)
+
+
+def before_start(hours):
+    return START - datetime.timedelta(hours=hours)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_with_more_than_48_hours_notice_is_free(self):
+        a = appt("a1", START, status="cancelled", cancelled_at=before_start(49))
+        self.assertEqual(cancellation_fee(a), 0)
+
+    def test_exactly_48_hours_notice_is_free(self):
+        a = appt("a1", START, status="cancelled", cancelled_at=before_start(48))
+        self.assertEqual(cancellation_fee(a), 0)
+
+    def test_late_cancellation_costs_half_the_assessment_price(self):
+        a = appt("a1", START, kind="assessment", status="cancelled", cancelled_at=before_start(47))
+        self.assertEqual(cancellation_fee(a), 4750)
+
+    def test_late_cancellation_costs_half_the_followup_price(self):
+        a = appt("a1", START, kind="followup", status="cancelled", cancelled_at=before_start(2))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelling_after_the_start_is_late(self):
+        a = appt("a1", START, status="cancelled", cancelled_at=START + datetime.timedelta(hours=1))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_uses_the_appointments_own_cancelled_at(self):
+        a = appt("a1", START, status="cancelled", cancelled_at=before_start(1))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_explicit_cancelled_at_overrides_the_appointment(self):
+        a = appt("a1", START, status="cancelled", cancelled_at=before_start(1))
+        self.assertEqual(cancellation_fee(a, cancelled_at=before_start(72)), 0)
+
+    def test_no_show_pays_the_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind="assessment", status="no_show")), 9500)
+        self.assertEqual(cancellation_fee(appt("a2", START, kind="followup", status="no_show")), 7000)
+
+    def test_no_show_with_a_cancellation_time_is_rejected(self):
+        a = appt("a1", START, status="no_show")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, cancelled_at=before_start(1))
+
+    def test_cancelled_without_a_time_is_rejected(self):
+        a = appt("a1", START, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_cancellation_time_must_be_aware(self):
+        a = appt("a1", START, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, cancelled_at=datetime.datetime(2027, 3, 9, 9))
+
+    def test_no_fee_for_booked_or_attended(self):
+        for status in ["booked", "attended"]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", START, status=status))
+
+
+if __name__ == "__main__":
+    unittest.main()
