+"""Text for the reminder SMS sent two days before an appointment."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    # Privacy rule: the reminder gives only the date, the time and the clinic's
+    # name. It never mentions the treatment or the reason for the appointment.
+    local = appointment.start.astimezone(LOCAL_TZ)
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local.minute:02d}{suffix}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora! This is a friendly reminder of your appointment at {clinic} "
+        f"on {when}. If you need to change your booking, please contact the clinic. "
+        "See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
