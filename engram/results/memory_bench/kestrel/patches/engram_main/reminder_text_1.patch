@@ -0,0 +1,36 @@
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_clinic_date_and_local_time(self):
+        # 19 Oct 2026 20:30 UTC is 20 Oct 2026 09:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 19, 20, 30), clinic="NG")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Tuesday 20 October at 9:30am", text)
+
+    def test_uses_standard_time_in_winter(self):
+        # 1 Jul 2026 02:30 UTC is 1 Jul 2026 14:30 in Auckland (NZST, UTC+12).
+        a = appt("A1", utc(2026, 7, 1, 2, 30), clinic="WK")
+        self.assertIn("Wednesday 1 July at 2:30pm", reminder_text(a))
+
+    def test_twelve_hour_clock_at_midnight_and_noon(self):
+        # 19 Oct 2026 11:05 UTC is 12:05am on 20 Oct in Auckland; 23:05 UTC is 12:05pm.
+        midnight = appt("A1", utc(2026, 10, 19, 11, 5), clinic="HB")
+        noon = appt("A2", utc(2026, 10, 19, 23, 5), clinic="HB")
+        self.assertIn("Tuesday 20 October at 12:05am", reminder_text(midnight))
+        self.assertIn("Tuesday 20 October at 12:05pm", reminder_text(noon))
+
+    def test_does_not_mention_treatment_or_patient(self):
+        a = appt("A1", utc(2026, 10, 19, 20, 30), patient="KP-004211", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
