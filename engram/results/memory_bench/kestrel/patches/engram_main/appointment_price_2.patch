+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.plain = Patient("KP-004211", "Ana Silva", "+64211234567")
+        self.csc = Patient("KP-004211", "Ana Silva", "+64211234567", csc=True)
+
+    def test_full_price(self):
+        start = datetime.datetime(2027, 6, 1, 9, 0, tzinfo=NZDT)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), self.plain), 10500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.plain), 7800)
+
+    def test_csc_discount_on_followup_only(self):
+        start = datetime.datetime(2027, 6, 1, 9, 0, tzinfo=NZDT)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.csc), 6240)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), self.csc), 10500)
+
+    def test_csc_discount_before_change(self):
+        start = datetime.datetime(2027, 3, 1, 9, 0, tzinfo=NZDT)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.csc), 5600)
+
+    def test_cutover_uses_auckland_date_not_utc_date(self):
+        # 23:30 on 31 March Auckland time (NZDT, +13) is 10:30 UTC on 31 March: old prices.
+        before = datetime.datetime(2027, 3, 31, 23, 30, tzinfo=NZDT)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, before), self.plain), 9500)
+        # 00:30 on 1 April Auckland time is 11:30 UTC on 31 March: new prices.
+        after = datetime.datetime(2027, 4, 1, 0, 30, tzinfo=NZDT)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, after), self.plain), 10500)
+
