 """Session prices."""
 
+import datetime
+
+from .calendar import LOCAL_TZ
+from .ids import normalize_patient_id
 from .models import ASSESSMENT, FOLLOWUP
 
 # Full session prices in cents, before any discount or fee.
-PRICES_CENTS = {
+# Appointments dated before PRICE_CHANGE_DATE (local Auckland date) keep the old prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+# Community Services Card holders get this discount on follow-ups, not assessments.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
 
-def session_price(kind):
-    """The full price in cents of a session of the given kind."""
+def session_price(kind, date):
+    """The full price in cents of a session of the given kind on a local (Auckland) date."""
+    prices = NEW_PRICES_CENTS if date >= PRICE_CHANGE_DATE else OLD_PRICES_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    The session price on the appointment's local (Auckland) date, less the CSC
+    discount on a follow-up for a Community Services Card holder.
+    """
+    if normalize_patient_id(patient.id) != normalize_patient_id(appointment.patient_id):
+        raise ValueError(f"appointment {appointment.id!r} is not for patient {patient.id!r}")
+    local_date = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, local_date)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
