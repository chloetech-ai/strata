+++ b/tests/test_reminders.py
@@ -0,0 +1,31 @@
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_clinic_date_and_local_time(self):
+        # 01:30 UTC on 20 Oct is 14:30 on 20 Oct in Auckland (NZDT, +13).
+        a = appt("A1", utc(2026, 10, 20, 1, 30), clinic="NG")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Tuesday 20 October at 2:30pm", text)
+
+    def test_uses_local_date_not_utc_date(self):
+        # 13:00 UTC on 14 Oct is 02:00 on 15 Oct in Auckland.
+        a = appt("A1", utc(2026, 10, 14, 13, 0), clinic="HB")
+        self.assertIn("Thursday 15 October at 2:00am", reminder_text(a))
+
+    def test_never_mentions_kind_or_treatment(self):
+        a = appt("A1", utc(2026, 10, 20, 1, 30), kind="assessment", treatment="lower back pain", clinic="WK")
+        text = reminder_text(a).lower()
+        self.assertNotIn("assessment", text)
+        self.assertNotIn("follow", text)
+        self.assertNotIn("back pain", text)
+        self.assertNotIn("treatment", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
