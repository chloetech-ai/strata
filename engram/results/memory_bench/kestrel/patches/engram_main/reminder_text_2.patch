+"""Text of the SMS reminders sent before appointments."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS reminder for an appointment, sent two days before it.
+
+    The text gives only the clinic name, date and time. It never says what the
+    appointment is for, as the privacy rule requires.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    date = local.strftime("%A %d %B").lstrip("0")
+    hour = local.hour % 12 or 12
+    ampm = "am" if local.hour < 12 else "pm"
+    time = f"{hour}:{local.minute:02d}{ampm}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! Just a friendly reminder that you have an appointment "
+        f"with us on {date} at {time}. We look forward to seeing you. "
+        f"If you need to change it, please give the clinic a call. See you soon!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
