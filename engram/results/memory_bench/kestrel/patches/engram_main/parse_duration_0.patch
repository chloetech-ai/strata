+"""Durations as typed in the booking form."""
+
+import re
+
+# "45m", "1h", "1h30", "1h30m" and "1h 30m" are accepted; a bare number such as "30" is not,
+# because it is unclear whether it means minutes or hours.
+_DURATION = re.compile(r"^\s*(?:([0-9]+)h(?: ?([0-9]+)m?)?|([0-9]+)m)\s*$")
+
+
+def parse_duration(text):
+    """Turn a duration like "45m", "1h", "1h30" or "1h 30m" into whole minutes.
+
+    Raises ValueError for anything else.
+    """
+    match = _DURATION.match(text)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, minutes_only = match.groups()
+    if minutes_only is not None:
+        return int(minutes_only)
+    return int(hours) * 60 + int(minutes_after_hours or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..c4a98cb
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,26 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes_only(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours_only(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes(self):
+        for text in ["1h30", "1h30m", "1h 30m", "1h 30", " 1h30 "]:
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), 90)
+
+    def test_rejects_anything_else(self):
+        for text in ["", "   ", "30", "h", "m", "1.5h", "-45m", "45 minutes", "1h30s", "1 h 30 m", "1H", "٤٥m"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
