 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
+from .ids import normalize_patient_id
 from .models import ASSESSMENT, FOLLOWUP
 
+# Kestrel's clinics are all in Auckland; appointment times are stored in UTC.
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
+# Appointments on or after this Auckland local date pay the new prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+
 # Full session prices in cents, before any discount or fee.
-PRICES_CENTS = {
+OLD_PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
 
+# Community Services Card holders get this percentage off follow-ups, not assessments.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
-def session_price(kind):
-    """The full price in cents of a session of the given kind."""
+
+def session_price(kind, start):
+    """The full price in cents of a session of the given kind starting at a timezone-aware datetime."""
+    if start.tzinfo is None:
+        raise ValueError("start must be timezone-aware")
+    prices = NEW_PRICES_CENTS if start.astimezone(LOCAL_TZ).date() >= PRICE_CHANGE_DATE else OLD_PRICES_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays in cents for the appointment, after any CSC discount."""
+    if normalize_patient_id(appointment.patient_id) != normalize_patient_id(patient.id):
+        raise ValueError(f"appointment {appointment.id} is not for patient {patient.id}")
+    price = session_price(appointment.kind, appointment.start)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
