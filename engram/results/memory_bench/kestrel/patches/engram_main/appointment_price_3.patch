+UTC = datetime.timezone.utc
+
+# 31 March 2027 is still NZDT (UTC+13), so local midnight on 1 April 2027 is 11:00 UTC on 31 March.
+BEFORE_CUTOVER = datetime.datetime(2027, 3, 31, 10, 59, tzinfo=UTC)  # 23:59 on 31 March, Auckland
+AFTER_CUTOVER = datetime.datetime(2027, 3, 31, 11, 0, tzinfo=UTC)  # 00:00 on 1 April, Auckland
+
+
+def appointment(kind, start, patient_id="KP-000001"):
+    return Appointment("A1", patient_id, "T1", "NG", start, kind)
 
 
