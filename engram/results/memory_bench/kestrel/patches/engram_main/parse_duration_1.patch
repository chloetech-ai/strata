+"""Appointment lengths as typed by reception."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?")
+
+
+def parse_duration(text):
+    """Turn a typed duration into a whole number of minutes.
+
+    Accepts "45m", "1h", "1h30" and "1h 30m". Anything else, including
+    zero, raises ValueError.
+    """
+    typed = text.strip()
+    match = _MINUTES.fullmatch(typed)
+    if match is not None:
+        minutes = int(match.group(1))
+    else:
+        match = _HOURS.fullmatch(typed)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        hours, extra = match.groups()
+        if extra is not None and int(extra) >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        minutes = int(hours) * 60 + int(extra or 0)
+    if minutes == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
