+"""Appointment reminders sent by SMS."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment: clinic, date and time only, no treatment."""
+    start = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic]
+    return (
+        f"{clinic.name}: reminder of your appointment on {start:%A} {start.day} {start:%B}"
+        f" at {start:%H:%M}. Please contact the clinic if you need to change it."
+    )
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment. Returns the number of messages sent."""
+    messages = [
+        (patients[a.patient_id].phone, reminder_text(a))
+        for a in appointments
+        if a.status == BOOKED
+    ]
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..b7d66b3
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,83 @@
+import datetime
+import unittest
+
+from kestrel.models import CANCELLED, ATTENDED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+from helpers import UTC, appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"accepted": len(body["messages"])}
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Aroha Ngata", "+64211000001"),
+    "KP-000002": Patient("KP-000002", "Sam Te Ao", "+64211000002"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key", self.transport)
+
+    def sent(self):
+        return [(m["to"], m["text"]) for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_one_sms_per_booked_appointment_to_its_patient(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 1, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 1, 0), patient="KP-000002"),
+        ]
+        count = send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(count, 2)
+        self.assertEqual([to for to, _ in self.sent()], ["+64211000001", "+64211000002"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 1, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 1, 0), patient="KP-000002", status=ATTENDED),
+            appt("A3", utc(2026, 10, 22, 1, 0), patient="KP-000002", status=CANCELLED,
+                 cancelled_at=utc(2026, 10, 10, 1, 0)),
+        ]
+        count = send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(count, 1)
+        self.assertEqual([to for to, _ in self.sent()], ["+64211000001"])
+
+    def test_no_booked_appointments_sends_nothing(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_more_than_fifty_reminders_are_all_sent(self):
+        appointments = [appt("A%d" % i, utc(2026, 10, 20, 1, 0) + datetime.timedelta(minutes=i),
+                             patient="KP-000001") for i in range(51)]
+        count = send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(count, 51)
+        self.assertEqual(len(self.sent()), 51)
+
+    def test_text_gives_date_time_and_clinic_but_not_treatment(self):
+        a = appt("A1", utc(2026, 10, 20, 1, 30), patient="KP-000001", clinic="HB",
+                 treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 20 October", text)
+        self.assertIn("at 14:30", text)  # 01:30 UTC is 14:30 NZDT (UTC+13)
+        self.assertNotIn("back", text)
+        self.assertNotIn("pain", text)
+
+    def test_local_date_and_time_are_used_across_nz_midnight(self):
+        # 11:30 UTC on 14 Oct is 00:30 on 15 Oct in Auckland (NZDT).
+        a = appt("A1", utc(2026, 10, 14, 11, 30), patient="KP-000001", clinic="NG")
+        text = reminder_text(a)
+        self.assertIn("Thursday 15 October", text)
+        self.assertIn("at 00:30", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
