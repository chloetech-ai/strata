+            appt("a1", utc(2027, 3, 1, 20), patient="KP-004211", status="cancelled"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-004211", status="attended"),
+            appt("a3", utc(2027, 3, 1, 22), patient="KP-004211"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", utc(2027, 3, 1, 19))], ["a3"])
