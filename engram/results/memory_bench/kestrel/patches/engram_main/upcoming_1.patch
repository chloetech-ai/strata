+    def test_upcoming_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 1, 22), patient="KP-004211"),
+            appt("a2", utc(2027, 3, 1, 20), patient="KP-004211"),
+            appt("a3", utc(2027, 3, 1, 23), patient="KP-000007"),
+            appt("a4", utc(2027, 2, 28, 20), patient="KP-004211"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", utc(2027, 3, 1, 19))], ["a2", "a1"])
