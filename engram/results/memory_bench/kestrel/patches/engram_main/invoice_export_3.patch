+"""Exports for the accountant. Invoice exports contain patient IDs only, never patient names."""
+
+import csv
+import os
+
+HEADER = ["Invoice number", "Invoice date", "Clinic", "Patient ID", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to kestrel-invoices-YYYY-MM.csv in out_dir.
+
+    Returns the path of the file written. Amounts are stored in cents and written
+    as plain two-decimal numbers, e.g. 7000 becomes 70.00. Dates are DD/MM/YYYY.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in month_invoices:
+            writer.writerow([
+                i.number,
+                i.issued.strftime("%d/%m/%Y"),
+                i.clinic,
+                i.patient_id,
+                i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
