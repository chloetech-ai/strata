@@ -0,0 +1,106 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=7000, patient_id="KP-004211", patient_name="Aroha Test", description="Follow-up session", clinic="HB"):
+    return Invoice(
+        number=number,
+        clinic=clinic,
+        patient_id=patient_id,
+        patient_name=patient_name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self.tmp.name
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_row_first(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(self.read(path), [[
+            "Invoice number", "Invoice date", "Clinic", "Patient ID", "Description", "Amount",
+        ]])
+
+    def test_row_has_date_as_dd_mm_yyyy_and_amount_with_two_decimals(self):
+        i = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), amount_cents=7000)
+        path = export_invoices([i], 2026, 10, self.out_dir)
+        self.assertEqual(self.read(path)[1], [
+            "INV-HB-2026-00001", "03/10/2026", "HB", "KP-004211", "Follow-up session", "70.00",
+        ])
+
+    def test_amount_keeps_cents(self):
+        i = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), amount_cents=9550)
+        path = export_invoices([i], 2026, 10, self.out_dir)
+        self.assertEqual(self.read(path)[1][5], "95.50")
+
+    def test_amount_has_no_dollar_sign_or_thousands_separator(self):
+        i = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), amount_cents=123456)
+        path = export_invoices([i], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertIn(",1234.56", text)
+        self.assertNotIn("$", text)
+
+    def test_only_invoices_from_the_given_month(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00001", datetime.date(2025, 10, 15)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        numbers = [row[0] for row in self.read(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_file_name_is_zero_padded_month(self):
+        path = export_invoices([], 2027, 4, self.out_dir)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2027-04.csv")
+
+    def test_omits_patient_names(self):
+        i = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), patient_name="Aroha Test")
+        path = export_invoices([i], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertIn("KP-004211", text)
+        self.assertNotIn("Aroha", text)
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 5)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 5)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        numbers = [row[0] for row in self.read(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_empty_month_gives_header_only(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 9, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(len(self.read(path)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
