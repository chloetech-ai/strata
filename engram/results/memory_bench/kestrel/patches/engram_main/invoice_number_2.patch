+def next_invoice_number(clinic, year, existing):
+    """The next INV-<clinic>-<year>-<sequence> number for a clinic in a year.
+
+    The sequence is five digits and counts from 00001 for each clinic each
+    year. `existing` holds invoice numbers issued so far, for any clinic and
+    year; only those matching this clinic and year count, and the next number
+    follows the highest sequence among them.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [
+        int(number[len(prefix):])
+        for number in existing
+        if number.startswith(prefix) and len(number) == len(prefix) + 5 and number[len(prefix):].isdigit()
+    ]
+    next_sequence = max(sequences, default=0) + 1
+    if next_sequence > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{next_sequence:05d}"
