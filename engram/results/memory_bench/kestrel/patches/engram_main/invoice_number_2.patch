+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_number_in_year_is_00001(self):
+        self.assertEqual(next_invoice_number("NG", 2026, []), "INV-NG-2026-00001")
+
+    def test_follows_highest_sequence_for_clinic_and_year(self):
+        existing = ["INV-NG-2026-00001", "INV-NG-2026-00002"]
+        self.assertEqual(next_invoice_number("NG", 2026, existing), "INV-NG-2026-00003")
+
+    def test_uses_highest_sequence_not_count(self):
+        existing = ["INV-NG-2026-00001", "INV-NG-2026-00005"]
+        self.assertEqual(next_invoice_number("NG", 2026, existing), "INV-NG-2026-00006")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-HB-2026-00009"]
+        self.assertEqual(next_invoice_number("NG", 2026, existing), "INV-NG-2026-00001")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-NG-2025-00042"]
+        self.assertEqual(next_invoice_number("NG", 2026, existing), "INV-NG-2026-00001")
+
+    def test_clinic_code_must_match_whole_code(self):
+        existing = ["INV-NGX-2026-00004"]
+        self.assertEqual(next_invoice_number("NG", 2026, existing), "INV-NG-2026-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-NG-2026-42", "INV-NG-2026-000010", "INV-NG-2026-0000A", "garbage"]
+        self.assertEqual(next_invoice_number("NG", 2026, existing), "INV-NG-2026-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-NG-2026-00007"])
+        self.assertEqual(next_invoice_number("NG", 2026, existing), "INV-NG-2026-00008")
+
+    def test_raises_when_sequence_would_overflow(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("NG", 2026, ["INV-NG-2026-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
