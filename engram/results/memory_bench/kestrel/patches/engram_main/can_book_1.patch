@@ -0,0 +1,39 @@
+"""Checks made before a booking is saved."""
+
+import datetime
+
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+# How long each kind of appointment takes.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+# Notes time the therapist needs after an assessment, before the next patient.
+POST_ASSESSMENT_GAP = datetime.timedelta(minutes=15)
+
+
+def _busy_until(appointment):
+    """When the therapist is free again after this appointment."""
+    end = appointment.start + DURATIONS[appointment.kind]
+    if appointment.kind == ASSESSMENT:
+        end += POST_ASSESSMENT_GAP
+    return end
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the therapist's calendar.
+
+    It cannot be added if its time overlaps a booked appointment for the same
+    therapist, or if it starts before the post-assessment gap of an existing
+    assessment has passed (or vice versa). Cancelled appointments are ignored.
+    """
+    new_start = appointment.start
+    new_busy_until = _busy_until(appointment)
+    for other in calendar.for_therapist(therapist.id):
+        if other.status != BOOKED:
+            continue
+        if new_start < _busy_until(other) and other.start < new_busy_until:
+            return False
+    return True
diff --git a/tests/test_booking.py b/tests/test_booking.py
