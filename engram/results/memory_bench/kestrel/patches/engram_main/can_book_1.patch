+++ b/tests/test_booking.py
@@ -0,0 +1,72 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+
+THERAPIST = Therapist("T1", "Ana Lee", "HB")
+
+
+def at(hh, mm=0):
+    return utc(2027, 3, 1, hh, mm)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", at(9))))
+
+    def test_same_time_clashes(self):
+        cal = Calendar([appt("a1", at(9), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", at(9), kind=FOLLOWUP)))
+
+    def test_start_inside_existing_appointment_clashes(self):
+        cal = Calendar([appt("a1", at(9), kind=FOLLOWUP)])  # 09:00-09:30
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", at(9, 15), kind=FOLLOWUP)))
+
+    def test_new_appointment_running_into_existing_clashes(self):
+        cal = Calendar([appt("a1", at(9, 30), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", at(9), kind=ASSESSMENT)))  # 09:00-09:45
+
+    def test_back_to_back_followups_fit(self):
+        cal = Calendar([appt("a1", at(9), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", at(9, 30), kind=FOLLOWUP)))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", at(8, 30), kind=FOLLOWUP)))
+
+    def test_no_gap_needed_after_followup(self):
+        cal = Calendar([appt("a1", at(9), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", at(9, 30), kind=ASSESSMENT)))
+
+    def test_gap_needed_after_assessment(self):
+        cal = Calendar([appt("a1", at(9), kind=ASSESSMENT)])  # 09:00-09:45, notes until 10:00
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", at(9, 45), kind=FOLLOWUP)))
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", at(9, 59), kind=FOLLOWUP)))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", at(10), kind=FOLLOWUP)))
+
+    def test_new_assessment_needs_gap_before_next_patient(self):
+        cal = Calendar([appt("a1", at(9, 20), kind=FOLLOWUP)])
+        # Assessment 08:30-09:15, then 15 minutes of notes until 09:30: the 09:20 patient clashes.
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", at(8, 30), kind=ASSESSMENT)))
+        cal = Calendar([appt("a1", at(9, 30), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", at(8, 30), kind=ASSESSMENT)))
+
+    def test_other_therapists_ignored(self):
+        cal = Calendar([appt("a1", at(9), kind=FOLLOWUP, therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", at(9), kind=FOLLOWUP)))
+
+    def test_cancelled_appointments_ignored(self):
+        cal = Calendar([appt("a1", at(9), kind=FOLLOWUP, status="cancelled")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", at(9), kind=FOLLOWUP)))
+
+    def test_compares_instants_across_timezones(self):
+        # 09:00 Auckland (NZDT, UTC+13) is 20:00 UTC the day before.
+        auckland = datetime.datetime(2027, 3, 2, 9, 0, tzinfo=ZoneInfo("Pacific/Auckland"))
+        cal = Calendar([appt("a1", at(20), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", auckland, kind=FOLLOWUP)))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", auckland + datetime.timedelta(hours=1), kind=FOLLOWUP)))
+
+
+if __name__ == "__main__":
+    unittest.main()
