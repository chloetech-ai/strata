+"""Exports for the accountant. Exports contain patient IDs only, never patient names."""
+
+import csv
+from decimal import Decimal
+import os
+
+HEADER = ["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV file in out_dir.
+
+    Returns the path of the file, kestrel-invoices-YYYY-MM.csv. A month with no
+    invoices still gets a file, holding only the header row.
+    """
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in invoices:
+            if invoice.issued.year == year and invoice.issued.month == month:
+                writer.writerow([
+                    invoice.number,
+                    invoice.clinic,
+                    invoice.patient_id,
+                    invoice.issued.strftime("%d/%m/%Y"),
+                    invoice.description,
+                    _amount(invoice.amount_cents),
+                ])
+    return path
+
+
+def _amount(cents):
+    """Dollars as a plain number with two decimals, e.g. 7000 -> "70.00"."""
+    return str(Decimal(cents).scaleb(-2).quantize(Decimal("0.01")))
diff --git a/tests/test_export.py b/tests/test_export.py
