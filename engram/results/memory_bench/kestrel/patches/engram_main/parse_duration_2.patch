+"""Durations as typed by reception."""
+
+import re
+
+# "45m", "1h", "1h30", "1h 30m": an hour count with optional minutes, or minutes alone.
+_DURATION = re.compile(r"(?:([0-9]+)m|([0-9]+)h(?:\s*([0-9]+)m?)?)")
+
+
+def parse_duration(text):
+    """Turn a duration such as "45m", "1h", "1h30" or "1h 30m" into minutes.
+
+    Raises ValueError for anything else, including a zero duration or
+    minutes of 60 or more after an hour count ("1h90").
+    """
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    minutes_only, hours, minutes = match.groups()
+    if minutes_only is not None:
+        total = int(minutes_only)
+    else:
+        minutes = int(minutes) if minutes is not None else 0
+        if minutes >= 60:
+            raise ValueError(f"not a duration: {text!r}")
+        total = int(hours) * 60 + minutes
+    if total == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return total
