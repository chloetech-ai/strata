diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index 4cb5075..4074930 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -44,5 +44,12 @@ class Waitlist:
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at, e.patient_id))
 
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for that kind."""
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
+
     def __len__(self):
         return len(self._entries)
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 37c7fe0..ea1c711 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -75,6 +75,35 @@ class WaitlistTest(unittest.TestCase):
         self.assertEqual(Waitlist().entries(), [])
         self.assertEqual(len(Waitlist()), 0)
 
+    def test_next_for_is_first_in_order_of_that_kind(self):
+        wl = Waitlist([entry("KP-000001", 11, kind="assessment"), entry("KP-000002", 9, kind="assessment")])
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000002")
+
+    def test_next_for_ignores_other_kinds(self):
+        wl = Waitlist([entry("KP-000001", 8, kind="followup"), entry("KP-000002", 10, kind="assessment")])
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000002")
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000001")
+
+    def test_next_for_puts_urgent_first(self):
+        wl = Waitlist([
+            entry("KP-000001", 8, kind="followup"),
+            entry("KP-000002", 9, kind="followup"),
+            entry("KP-000003", 10, kind="followup", urgent=True),
+        ])
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000003")
+
+    def test_next_for_none_when_nobody_waits_for_that_kind(self):
+        wl = Waitlist([entry("KP-000001", 9, kind="followup")])
+        self.assertIsNone(wl.next_for("assessment"))
+
+    def test_next_for_empty_waitlist(self):
+        self.assertIsNone(Waitlist().next_for("followup"))
+
+    def test_next_for_does_not_remove_entry(self):
+        wl = Waitlist([entry("KP-000001", 9)])
+        wl.next_for("followup")
+        self.assertEqual(len(wl), 1)
+
 
 if __name__ == "__main__":
     unittest.main()
