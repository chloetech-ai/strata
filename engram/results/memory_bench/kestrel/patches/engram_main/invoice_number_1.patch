+def next_invoice_number(clinic, year, existing):
+    """The next number in INV-<clinic>-<year>-<sequence> format.
+
+    Sequences count per clinic and restart each year, so only existing numbers
+    for this clinic and year count. The next one follows the highest, so a gap
+    left by an earlier number is never reused.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    issued = [
+        int(number[len(prefix):])
+        for number in existing
+        if number.startswith(prefix) and SEQUENCE_DIGITS.fullmatch(number[len(prefix):])
+    ]
+    sequence = max(issued, default=0) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{sequence:05d}"
