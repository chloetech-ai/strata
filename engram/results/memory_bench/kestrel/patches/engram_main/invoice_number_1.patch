+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_existing_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00002", "INV-HB-2027-00041"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00042")
+
+    def test_does_not_reuse_a_gap(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00005"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00006")
+
+    def test_counts_per_clinic(self):
+        existing = ["INV-NG-2027-00009", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_formats(self):
+        existing = ["INV-HB-2027-0007", "INV-HB-2027-000080", "INV-HB-2027-0000a", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_accepts_year_as_int_and_any_iterable(self):
+        existing = iter(["INV-NG-2027-00001"])
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00002")
+
+    def test_raises_when_sequence_would_overflow(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
