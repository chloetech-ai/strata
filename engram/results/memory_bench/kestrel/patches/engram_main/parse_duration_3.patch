+"""Durations as typed on the booking form."""
+
+import re
+
+_HOURS_AND_MINUTES = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?")
+_MINUTES = re.compile(r"([0-9]+)m")
+
+
+def parse_duration(text):
+    """Turn a duration such as "45m", "1h", "1h30" or "1h 30m" into minutes.
+
+    A bare number after the hours is taken as minutes, so "1h30" is 90.
+    Raises ValueError for anything else, for minutes of 60 or more after
+    hours, and for a zero duration.
+    """
+    text = text.strip()
+    match = _HOURS_AND_MINUTES.fullmatch(text)
+    if match is not None:
+        hours, minutes = match.groups()
+        minutes = int(minutes or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60 after hours: {text!r}")
+        total = int(hours) * 60 + minutes
+    else:
+        match = _MINUTES.fullmatch(text)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        total = int(match.group(1))
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..416d8d4
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,46 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("90m"), 90)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+        self.assertEqual(parse_duration("2h"), 120)
+
+    def test_hours_then_bare_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h05"), 65)
+
+    def test_hours_and_minutes(self):
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("1h30m"), 90)
+
+    def test_surrounding_spaces(self):
+        self.assertEqual(parse_duration(" 45m "), 45)
+
+    def test_rejects_other_forms(self):
+        for raw in ["", "   ", "45", "m", "h", "1.5h", "-45m", "45 min", "1 h", "1h 30 m", "1h30m5", "1d", "h30"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+    def test_rejects_minutes_of_sixty_or_more_after_hours(self):
+        for raw in ["1h60", "1h 90m"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+    def test_rejects_zero(self):
+        for raw in ["0m", "0h", "0h0"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
