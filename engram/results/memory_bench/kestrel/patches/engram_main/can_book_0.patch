+"""Booking rules checked before an appointment is saved."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+# A therapist needs this long for notes after an assessment, before the next patient.
+ASSESSMENT_GAP = datetime.timedelta(minutes=15)
+
+# Union agreement: no therapist sees more than this many patients in a day.
+DAILY_LIMIT = 8
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist."""
+    if appointment.therapist_id != therapist.id:
+        return False
+    if appointment.id in (a.id for a in calendar.all()):
+        return False
+
+    start = appointment.start.astimezone(LOCAL_TZ)
+    if start.minute % 15 or start.second or start.microsecond:
+        return False
+
+    booked = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+
+    if sum(1 for a in booked if a.start.astimezone(LOCAL_TZ).date() == start.date()) >= DAILY_LIMIT:
+        return False
+
+    # Each appointment blocks its own time plus the gap after it, if it is an assessment.
+    # Two bookings clash when each starts before the other's blocked time has ended.
+    new_end = appointment.start + DURATIONS[appointment.kind] + _gap_after(appointment)
+    for other in booked:
+        other_end = other.start + DURATIONS[other.kind] + _gap_after(other)
+        if appointment.start < other_end and other.start < new_end:
+            return False
+    return True
+
+
+def _gap_after(appointment):
+    return ASSESSMENT_GAP if appointment.kind == ASSESSMENT else datetime.timedelta(0)
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..f10e229
