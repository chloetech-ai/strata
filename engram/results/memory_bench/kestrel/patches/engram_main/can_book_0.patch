+++ b/tests/test_booking.py
@@ -0,0 +1,90 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+THERAPIST = Therapist("T1", "Sam", "HB")
+
+
+def local(y, m, d, hh=0, mm=0):
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=AUCKLAND)
+
+
+def new(start, kind=FOLLOWUP, id="new", therapist="T1"):
+    return appt(id, start, kind=kind, therapist=therapist)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar_allows_booking(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, new(local(2027, 3, 1, 9))))
+
+    def test_other_therapists_bookings_do_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=FOLLOWUP, therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9))))
+
+    def test_overlapping_followup_is_refused(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9, 15))))
+
+    def test_back_to_back_after_followup_is_allowed(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9, 30))))
+
+    def test_start_during_assessment_is_refused(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=ASSESSMENT)])
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9, 30))))
+
+    def test_gap_after_assessment_is_required(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=ASSESSMENT)])
+        # The assessment runs 09:00-09:45, then 15 minutes for notes.
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9, 45))))
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 1, 10, 0))))
+
+    def test_new_assessment_needs_gap_before_next_booking(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 10), kind=FOLLOWUP)])
+        # A 09:30 assessment would end at 10:15, so it clashes with the 10:00 follow-up.
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9, 30), kind=ASSESSMENT)))
+        # 09:15 assessment ends 10:00, but its gap runs to 10:15: still a clash.
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9, 15), kind=ASSESSMENT)))
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9), kind=ASSESSMENT)))
+
+    def test_start_must_be_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, new(local(2027, 3, 1, 9, 10))))
+        self.assertTrue(can_book(Calendar(), THERAPIST, new(local(2027, 3, 1, 9, 45))))
+
+    def test_cancelled_bookings_do_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=FOLLOWUP, status=CANCELLED, cancelled_at=local(2027, 2, 20))])
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 1, 9))))
+
+    def test_daily_limit_of_eight(self):
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 8 + i // 2, 30 * (i % 2)), kind=FOLLOWUP) for i in range(8)])
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 14))))
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 2, 9))))
+
+    def test_cancelled_bookings_do_not_count_towards_daily_limit(self):
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 8 + i // 2, 30 * (i % 2)), kind=FOLLOWUP) for i in range(8)])
+        cal.cancel("a0", local(2027, 2, 20))
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 1, 14))))
+
+    def test_daily_limit_uses_auckland_date(self):
+        # Bookings from 00:00 to 03:30 NZDT on 1 Mar are still 1 Mar locally, but 28 Feb in UTC.
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 0, 0) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP) for i in range(8)])
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 12))))
+        # 00:15 on 2 Mar local is 1 Mar in UTC, so it must not count against 1 Mar's limit.
+        self.assertTrue(can_book(cal, THERAPIST, new(local(2027, 3, 2, 0, 15))))
+
+    def test_wrong_therapist_is_refused(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, new(local(2027, 3, 1, 9), therapist="T2")))
+
+    def test_duplicate_id_is_refused(self):
+        cal = Calendar([appt("new", local(2027, 3, 1, 9), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, new(local(2027, 3, 1, 14))))
+
+
+if __name__ == "__main__":
+    unittest.main()
