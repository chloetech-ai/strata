+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+
+FIELDS = ("Number", "Clinic", "Patient ID", "Date", "Description", "Amount")
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as a CSV file and return its path.
+
+    The file carries the patient ID but not the patient name. Dates are DD/MM/YYYY
+    and amounts are plain numbers with two decimals, as the accountant's import expects.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(FIELDS)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.clinic,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
