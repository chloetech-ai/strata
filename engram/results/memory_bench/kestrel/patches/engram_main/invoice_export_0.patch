@@ -0,0 +1,96 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number="INV-HB-2026-00001", issued=datetime.date(2026, 10, 1), patient_id="KP-004211",
+            patient_name="Aroha Test", amount_cents=7000, description="Follow-up session", clinic="HB"):
+    return Invoice(number=number, clinic=clinic, patient_id=patient_id, patient_name=patient_name,
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+def read_rows(path):
+    with open(path, newline="", encoding="utf-8") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.out_dir = self._dir.name
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def test_returns_path_named_for_month_in_out_dir(self):
+        path = export_invoices([invoice()], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_writes_header_then_one_row_per_invoice(self):
+        path = export_invoices([invoice()], 2026, 10, self.out_dir)
+        rows = read_rows(path)
+        self.assertEqual(rows[0], ["Number", "Clinic", "Patient ID", "Date", "Description", "Amount"])
+        self.assertEqual(rows[1], ["INV-HB-2026-00001", "HB", "KP-004211", "01/10/2026",
+                                   "Follow-up session", "70.00"])
+        self.assertEqual(len(rows), 2)
+
+    def test_only_includes_invoices_issued_in_the_month(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00005", datetime.date(2025, 10, 15)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_omits_patient_name(self):
+        path = export_invoices([invoice(patient_name="Aroha Test")], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertNotIn("Aroha", text)
+        self.assertNotIn("Test", text)
+        self.assertNotIn("Patient Name", text)
+
+    def test_amount_is_two_decimals_without_dollar_sign(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", amount_cents=9500),
+            invoice("INV-HB-2026-00002", amount_cents=7805),
+            invoice("INV-HB-2026-00003", amount_cents=5),
+        ]
+        rows = read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[5] for r in rows[1:]], ["95.00", "78.05", "0.05"])
+
+    def test_dates_are_day_month_year(self):
+        rows = read_rows(export_invoices([invoice(issued=datetime.date(2026, 10, 5))], 2026, 10, self.out_dir))
+        self.assertEqual(rows[1][3], "05/10/2026")
+
+    def test_fields_with_commas_are_quoted(self):
+        inv = invoice(description="Follow-up, with notes")
+        rows = read_rows(export_invoices([inv], 2026, 10, self.out_dir))
+        self.assertEqual(rows[1][4], "Follow-up, with notes")
+
+    def test_no_invoices_gives_header_only(self):
+        rows = read_rows(export_invoices([], 2026, 10, self.out_dir))
+        self.assertEqual(len(rows), 1)
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 2)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]],
+                         ["INV-HB-2026-00003", "INV-HB-2026-00001", "INV-HB-2026-00002"])
+
+
+if __name__ == "__main__":
+    unittest.main()
