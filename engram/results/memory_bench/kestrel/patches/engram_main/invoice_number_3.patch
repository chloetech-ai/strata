+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_does_not_reuse_a_gap(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_order_of_existing_numbers_does_not_matter(self):
+        existing = ["INV-HB-2027-00003", "INV-HB-2027-00001", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-NG-2027-00009", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00010")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00042"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-HB-2027-0004", "INV-HB-2027-000045", "INV-HB-2027-ABCDE", "INV-HB-2027-00002x"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2027-00005"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00006")
+
+    def test_raises_when_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
