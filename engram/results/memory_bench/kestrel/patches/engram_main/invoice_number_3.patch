+def next_invoice_number(clinic, year, existing):
+    """The next number in INV-<clinic>-<year>-<sequence>, e.g. INV-HB-2027-00001.
+
+    Sequences count per clinic and restart each year, so only numbers for this
+    clinic and year count. `existing` may hold numbers for any clinic and year.
+    The next number follows the highest sequence issued, so a gap is never reused.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [
+        int(number[len(prefix):])
+        for number in existing
+        if number.startswith(prefix) and re.fullmatch(r"\d{5}", number[len(prefix):])
+    ]
+    sequence = max(sequences, default=0) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{sequence:05d}"
+
