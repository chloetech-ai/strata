+    def test_upcoming_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-004211"),  # past
+            appt("a2", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("a3", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("a4", utc(2027, 3, 2, 10), patient="KP-000007"),  # other patient
+            appt("a5", utc(2027, 3, 2, 11), patient="KP-004211", status="cancelled"),
+        ])
+        now = utc(2027, 3, 1, 21)
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", now)], ["a3", "a2"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-004211", utc(2027, 3, 1, 20)), [])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 1, 19))
+
+    def test_upcoming_empty_for_unknown_patient(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-000007", utc(2027, 2, 1, 0)), [])
