+"""Monthly export of invoices for the accountant (Mere at Tui Accounting).
+
+The export carries patient IDs only, never patient names.
+"""
+
+import csv
+import os
+
+HEADER = ["number", "clinic", "patient_id", "date", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV file in out_dir.
+
+    Returns the path of the file, kestrel-invoices-YYYY-MM.csv. Invoices are
+    selected by their issued (local Auckland) date, sorted by date then number.
+    A month with no invoices gives a file with just the header row.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.clinic,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
