@@ -0,0 +1,93 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number="INV-HB-2026-00001", issued=datetime.date(2026, 10, 1), patient_id="KP-004211",
+            patient_name="Aroha Test", amount_cents=7000, description="Follow-up session", clinic="HB"):
+    return Invoice(number=number, clinic=clinic, patient_id=patient_id, patient_name=patient_name,
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+def read_rows(path):
+    with open(path, newline="", encoding="utf-8") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def export(self, invoices, year=2026, month=10):
+        return export_invoices(invoices, year, month, self.dir.name)
+
+    def test_returns_path_named_for_month_in_out_dir(self):
+        path = self.export([])
+        self.assertEqual(path, os.path.join(self.dir.name, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_writes_header_then_one_row_per_invoice(self):
+        path = self.export([invoice(amount_cents=7000)])
+        self.assertEqual(read_rows(path), [
+            ["number", "clinic", "patient_id", "date", "description", "amount"],
+            ["INV-HB-2026-00001", "HB", "KP-004211", "01/10/2026", "Follow-up session", "70.00"],
+        ])
+
+    def test_amounts_are_two_decimal_numbers_without_dollar_sign(self):
+        path = self.export([invoice(number="INV-HB-2026-00001", amount_cents=9550),
+                            invoice(number="INV-HB-2026-00002", amount_cents=7005)])
+        amounts = [row[5] for row in read_rows(path)[1:]]
+        self.assertEqual(amounts, ["95.50", "70.05"])
+
+    def test_dates_are_day_first(self):
+        path = self.export([invoice(issued=datetime.date(2026, 10, 5))])
+        self.assertEqual(read_rows(path)[1][3], "05/10/2026")
+
+    def test_only_invoices_from_the_given_month(self):
+        invoices = [
+            invoice(number="INV-HB-2026-00001", issued=datetime.date(2026, 9, 30)),
+            invoice(number="INV-HB-2026-00002", issued=datetime.date(2026, 10, 1)),
+            invoice(number="INV-HB-2026-00003", issued=datetime.date(2026, 10, 31)),
+            invoice(number="INV-HB-2026-00004", issued=datetime.date(2026, 11, 1)),
+            invoice(number="INV-HB-2025-00005", issued=datetime.date(2025, 10, 15)),
+        ]
+        path = self.export(invoices)
+        self.assertEqual([row[0] for row in read_rows(path)[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_never_writes_patient_names(self):
+        path = self.export([invoice(patient_name="Aroha Test")])
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice(number="INV-HB-2026-00003", issued=datetime.date(2026, 10, 2)),
+            invoice(number="INV-HB-2026-00002", issued=datetime.date(2026, 10, 2)),
+            invoice(number="INV-HB-2026-00001", issued=datetime.date(2026, 10, 1)),
+        ]
+        path = self.export(invoices)
+        self.assertEqual([row[0] for row in read_rows(path)[1:]],
+                         ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_month_with_no_invoices_gives_header_only(self):
+        path = self.export([invoice(issued=datetime.date(2026, 9, 1))])
+        self.assertEqual(read_rows(path), [["number", "clinic", "patient_id", "date", "description", "amount"]])
+
+    def test_description_with_comma_is_quoted(self):
+        path = self.export([invoice(description="Initial assessment, first visit")])
+        self.assertEqual(read_rows(path)[1][4], "Initial assessment, first visit")
+
+    def test_replaces_existing_file_for_the_month(self):
+        self.export([invoice(number="INV-HB-2026-00001"), invoice(number="INV-HB-2026-00002")])
+        path = self.export([invoice(number="INV-HB-2026-00001")])
+        self.assertEqual(len(read_rows(path)), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
