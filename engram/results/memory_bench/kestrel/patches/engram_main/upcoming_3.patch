diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index 089412f..33e19b4 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -63,5 +63,12 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after a timezone-aware datetime, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        patient_id = normalize_patient_id(patient_id)
+        return [a for a in self.booked() if a.patient_id == patient_id and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 2aa4570..5441823 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -114,6 +114,32 @@ class CalendarTest(unittest.TestCase):
         self.assertEqual([a.id for a in cal.for_day("T2", datetime.date(2027, 3, 2))], ["a2"])
         self.assertEqual(cal.for_day("T3", datetime.date(2027, 3, 2)), [])
 
+    def test_upcoming_only_later_booked_appointments_soonest_first(self):
+        now = utc(2027, 3, 1, 20)
+        cal = Calendar([
+            appt("past", utc(2027, 3, 1, 19)),
+            appt("at-now", utc(2027, 3, 1, 20)),
+            appt("late", utc(2027, 3, 3, 9)),
+            appt("soon", utc(2027, 3, 2, 9)),
+            appt("cancelled", utc(2027, 3, 2, 10), status="cancelled"),
+            appt("other-patient", utc(2027, 3, 2, 11), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "late"])
+
+    def test_upcoming_accepts_messy_patient_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp4211 ", utc(2027, 3, 1, 9))], ["a1"])
+
+    def test_upcoming_empty_when_nothing_later(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9))])
+        self.assertEqual(cal.upcoming("KP-000001", utc(2027, 3, 1, 9)), [])
+        self.assertEqual(cal.upcoming("KP-000009", utc(2027, 2, 1, 9)), [])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 9))
+
 
 if __name__ == "__main__":
     unittest.main()
