+++ b/src/kestrel/slots.py
@@ -0,0 +1,72 @@
+"""Finding times a new appointment could be booked for a therapist."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, CLINICS, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+
+# Appointment length, and the notes gap the therapist needs before the next patient, in minutes.
+DURATION = {ASSESSMENT: 45, FOLLOWUP: 30}
+GAP_AFTER = {ASSESSMENT: 15, FOLLOWUP: 0}
+START_STEP = 15  # every appointment starts on a quarter hour
+DAILY_LIMIT = 8  # union agreement: patient appointments per therapist per day
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}  # only Northgate opens on Saturdays
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a local date, or None if it is closed."""
+    if clinic not in CLINICS:
+        return None
+    weekday = day.weekday()
+    if weekday < 5:
+        return WEEKDAY_HOURS
+    if weekday == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None
+
+
+def _occupied(kind):
+    """How long an appointment of this kind blocks the therapist, including its gap."""
+    return datetime.timedelta(minutes=DURATION[kind] + GAP_AFTER[kind])
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times, sorted, at which a new appointment of this kind could be booked.
+
+    `day` is a local (Pacific/Auckland) date. A start is free when the appointment fits
+    within the therapist's clinic opening hours, it does not overlap another appointment
+    for the therapist (cancelled ones are ignored), and it leaves the notes gap after any
+    assessment, the new one included. Returns [] when the clinic is closed or the
+    therapist already has DAILY_LIMIT patient appointments that day.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= DAILY_LIMIT:
+        return []
+
+    busy = []
+    for a in booked:
+        begin = a.start.astimezone(UTC)
+        busy.append((begin, begin + _occupied(a.kind)))
+
+    length = _occupied(kind)
+    duration = datetime.timedelta(minutes=DURATION[kind])
+    opens, closes = hours
+    start = datetime.datetime.combine(day, opens)
+    closing = datetime.datetime.combine(day, closes)
+    slots = []
+    while start + duration <= closing:
+        begin = start.replace(tzinfo=LOCAL_TZ).astimezone(UTC)
+        end = begin + length
+        if all(end <= b0 or begin >= b1 for b0, b1 in busy):
+            slots.append(start.time())
+        start += datetime.timedelta(minutes=START_STEP)
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..e15e59f
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,115 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+T = lambda h, m=0: datetime.time(h, m)  # noqa: E731
+
+MONDAY = datetime.date(2027, 3, 1)
+TUESDAY = datetime.date(2027, 3, 2)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+
+HARBOUR = Therapist("T1", "Test Therapist", "HB")
+NORTHGATE = Therapist("T1", "Test Therapist", "NG")
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_followups_fill_opening_hours(self):
+        slots = free_slots(Calendar(), HARBOUR, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[0], T(7, 30))
+        self.assertEqual(slots[-1], T(17, 30))  # 30 minutes must finish by 18:00
+        self.assertEqual(len(slots), 41)
+
+    def test_assessments_must_finish_by_closing(self):
+        slots = free_slots(Calendar(), HARBOUR, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], T(17, 15))  # 45 minutes must finish by 18:00
+        self.assertEqual(len(slots), 40)
+
+    def test_starts_are_sorted_quarter_hours(self):
+        slots = free_slots(Calendar(), HARBOUR, MONDAY, ASSESSMENT)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(s.minute % 15 == 0 and s.second == 0 for s in slots))
+
+    def test_saturday_only_northgate_open(self):
+        slots = free_slots(Calendar(), NORTHGATE, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], T(8))
+        self.assertEqual(slots[-1], T(11, 30))  # 30 minutes must finish by 12:00
+        self.assertEqual(free_slots(Calendar(), HARBOUR, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        for clinic in ("NG", "HB", "WK"):
+            therapist = Therapist("T1", "Test Therapist", clinic)
+            self.assertEqual(free_slots(Calendar(), therapist, SUNDAY, FOLLOWUP), [])
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HARBOUR, MONDAY, "physio")
+
+    def test_booked_followup_blocks_only_its_own_time(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T1")])  # 10:00 NZDT
+        slots = free_slots(cal, HARBOUR, MONDAY, FOLLOWUP)
+        self.assertIn(T(9, 30), slots)
+        self.assertNotIn(T(9, 45), slots)  # would run into 10:00
+        self.assertNotIn(T(10, 0), slots)
+        self.assertNotIn(T(10, 15), slots)
+        self.assertIn(T(10, 30), slots)
+
+    def test_booked_assessment_adds_fifteen_minute_gap(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T1", kind=ASSESSMENT)])  # 10:00 NZDT
+        slots = free_slots(cal, HARBOUR, MONDAY, FOLLOWUP)
+        self.assertNotIn(T(10, 30), slots)  # inside the 45 minutes
+        self.assertNotIn(T(10, 45), slots)  # inside the notes gap
+        self.assertIn(T(11, 0), slots)
+
+    def test_new_assessment_needs_gap_before_next_patient(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T1")])  # followup at 10:00 NZDT
+        slots = free_slots(cal, HARBOUR, MONDAY, ASSESSMENT)
+        self.assertIn(T(9, 0), slots)  # 9:00 to 9:45, then the 15-minute gap ends exactly at 10:00
+        self.assertNotIn(T(9, 15), slots)  # 9:15 to 10:15 runs into 10:00
+        self.assertNotIn(T(10, 0), slots)
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T1", status="cancelled")])
+        self.assertIn(T(10, 0), free_slots(cal, HARBOUR, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T2")])
+        self.assertIn(T(10, 0), free_slots(cal, HARBOUR, MONDAY, FOLLOWUP))
+
+    def test_daily_limit_of_eight_patient_appointments(self):
+        cal = Calendar([
+            appt(f"a{i}", utc(2027, 2, 28, 20 + i // 2, 30 * (i % 2)), therapist="T1")
+            for i in range(8)
+        ])  # eight followups, 09:00 to 12:30 NZDT
+        self.assertEqual(free_slots(cal, HARBOUR, MONDAY, FOLLOWUP), [])
+
+    def test_below_daily_limit_still_has_slots(self):
+        cal = Calendar([
+            appt(f"a{i}", utc(2027, 2, 28, 20 + i // 2, 30 * (i % 2)), therapist="T1")
+            for i in range(7)
+        ])
+        self.assertNotEqual(free_slots(cal, HARBOUR, MONDAY, FOLLOWUP), [])
+
+    def test_cancelled_appointments_do_not_count_towards_limit(self):
+        cal = Calendar([
+            appt(f"a{i}", utc(2027, 2, 28, 20 + i // 2, 30 * (i % 2)), therapist="T1",
+                 status="cancelled" if i == 0 else "booked")
+            for i in range(8)
+        ])
+        self.assertNotEqual(free_slots(cal, HARBOUR, MONDAY, FOLLOWUP), [])
+
+    def test_local_date_decides_which_day_is_searched(self):
+        # 18:30 UTC on 1 March is 07:30 on 2 March NZDT, so it sits on the 2nd.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 18, 30), therapist="T1")])
+        slots = free_slots(cal, HARBOUR, TUESDAY, FOLLOWUP)
+        self.assertNotIn(T(7, 30), slots)
+        self.assertIn(T(8, 0), slots)
+        self.assertIn(T(7, 30), free_slots(cal, HARBOUR, MONDAY, FOLLOWUP))
+
+
+if __name__ == "__main__":
+    unittest.main()
