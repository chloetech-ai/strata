 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
 from .models import ASSESSMENT, FOLLOWUP
 
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
+# Appointments on or after this local date pay the new prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+
 # Full session prices in cents, before any discount or fee.
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+# Full session prices in cents from PRICE_CHANGE_DATE.
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+# Community Services Card holders get this percentage off follow-ups, not assessments.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
-def session_price(kind):
-    """The full price in cents of a session of the given kind."""
+def session_price(kind, day):
+    """The full price in cents of a session of the given kind on a local (Auckland) date."""
+    prices = NEW_PRICES_CENTS if day >= PRICE_CHANGE_DATE else PRICES_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents, after any discount."""
+    local_day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, local_day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price -= price * CSC_FOLLOWUP_DISCOUNT_PERCENT // 100
+    return price
