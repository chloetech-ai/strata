+class AppointmentPriceTest(unittest.TestCase):
+    def test_full_price_without_csc(self):
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, _utc(2026, 10, 15, 3)), patient()), 9500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, _utc(2026, 10, 15, 3)), patient()), 7000)
+
+    def test_csc_discount_on_followup_only(self):
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, _utc(2026, 10, 15, 3)), patient(csc=True)), 5600)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, _utc(2026, 10, 15, 3)), patient(csc=True)), 9500)
+
+    def test_csc_discount_after_cutover(self):
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, _utc(2027, 4, 1, 3)), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, _utc(2027, 4, 1, 3)), patient(csc=True)), 10500)
+
+    def test_old_price_just_before_cutover(self):
+        # 10:30 UTC on 31 March is 23:30 on 31 March in Auckland (NZDT, +13).
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, _utc(2027, 3, 31, 10, 30)), patient()), 7000)
+
+    def test_new_price_just_after_cutover(self):
+        # 11:30 UTC on 31 March is 00:30 on 1 April in Auckland (NZDT, +13).
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, _utc(2027, 3, 31, 11, 30)), patient()), 7800)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, _utc(2027, 3, 31, 11, 30)), patient()), 10500)
+
+    def test_cutover_uses_local_date_not_utc_date(self):
+        # 11:00 UTC on 31 March is exactly midnight on 1 April in Auckland: already the new prices.
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, _utc(2027, 3, 31, 11, 0)), patient()), 7800)
+        # 10:59 UTC on 31 March is 23:59 on 31 March in Auckland: still the old prices.
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, _utc(2027, 3, 31, 10, 59)), patient()), 7000)
+
+
+def _utc(year, month, day, hour, minute=0):
+    return datetime.datetime(year, month, day, hour, minute, tzinfo=datetime.timezone.utc)
 
 
