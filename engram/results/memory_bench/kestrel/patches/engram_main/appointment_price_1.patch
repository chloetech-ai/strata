 """Session prices."""
 
+import datetime
+
+from .calendar import LOCAL_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
-# Full session prices in cents, before any discount or fee.
+# Prices in cents, before any discount or fee. Appointments on or after
+# PRICE_CHANGE_DATE (local Auckland date) pay the new prices.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+# Community Services Card holders get this discount on follow-ups only.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
 
-def session_price(kind):
-    """The full price in cents of a session of the given kind."""
+def session_price(kind, day):
+    """The full price in cents of a session of the given kind on a local (Auckland) date."""
+    prices = NEW_PRICES_CENTS if day >= PRICE_CHANGE_DATE else PRICES_CENTS
     try:
-        return PRICES_CENTS[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents."""
+    if patient.id != appointment.patient_id:
+        raise ValueError(f"patient {patient.id} does not match appointment patient {appointment.patient_id}")
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
