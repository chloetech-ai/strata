+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.plain = Patient("KP-000001", "Aroha", "+64211234567")
+        self.csc = Patient("KP-000001", "Aroha", "+64211234567", csc=True)
+
+    def test_full_price(self):
+        self.assertEqual(appointment_price(appt("a", utc(2026, 10, 15, 2), kind=ASSESSMENT), self.plain), 9500)
+        self.assertEqual(appointment_price(appt("a", utc(2026, 10, 15, 2), kind=FOLLOWUP), self.plain), 7000)
+
+    def test_csc_discount_on_followup_only(self):
+        self.assertEqual(appointment_price(appt("a", utc(2026, 10, 15, 2), kind=FOLLOWUP), self.csc), 5600)
+        self.assertEqual(appointment_price(appt("a", utc(2026, 10, 15, 2), kind=ASSESSMENT), self.csc), 9500)
+
+    def test_csc_discount_after_change(self):
+        self.assertEqual(appointment_price(appt("a", utc(2027, 4, 5, 2), kind=FOLLOWUP), self.csc), 6240)
+        self.assertEqual(appointment_price(appt("a", utc(2027, 4, 5, 2), kind=ASSESSMENT), self.csc), 10500)
+
+    def test_change_judged_on_auckland_date(self):
+        # 31 March 10:59 UTC is 31 March 23:59 in Auckland (NZDT, +13): still the old price.
+        before = appt("a", utc(2027, 3, 31, 10, 59), kind=FOLLOWUP)
+        # 31 March 11:00 UTC is 1 April 00:00 in Auckland: the new price.
+        on = appt("b", utc(2027, 3, 31, 11, 0), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(before, self.plain), 7000)
+        self.assertEqual(appointment_price(on, self.plain), 7800)
+
+    def test_rejects_patient_who_is_not_the_appointment_patient(self):
+        other = Patient("KP-000002", "Hemi", "+64211234568", csc=True)
+        with self.assertRaises(ValueError):
