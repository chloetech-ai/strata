+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_sequence_for_the_clinic_and_year(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00900", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00901")
+
+    def test_restarts_at_00001_in_a_new_year(self):
+        existing = ["INV-HB-2026-00042", "INV-HB-2026-00043"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_that_are_not_in_the_format(self):
+        existing = ["INV-HB-2027-0009", "INV-HB-2027-000099", "INV-HB-2027-00005X", "HB-2027-00050", "INV-HBX-2027-00050"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2027-00002"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_last_sequence_number_is_still_issued(self):
+        existing = ["INV-HB-2027-%05d" % (MAX_SEQUENCE - 1)]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-99999")
+
+    def test_rejects_when_sequence_is_exhausted(self):
+        existing = ["INV-HB-2027-%05d" % MAX_SEQUENCE]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
