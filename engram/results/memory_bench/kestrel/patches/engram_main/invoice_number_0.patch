+def next_invoice_number(clinic, year, existing):
+    """The next number in INV-<clinic>-<year>-<sequence> after the numbers in `existing`.
+
+    `existing` may hold numbers for any clinic and year; only this clinic's
+    numbers for this year count, so the sequence restarts at 00001 each year.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-(\d{{5}})")
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match:
+            highest = max(highest, int(match.group(1)))
+    if highest >= MAX_SEQUENCE:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
+
