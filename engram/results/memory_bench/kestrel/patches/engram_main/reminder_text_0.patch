+"""Text messages sent to patients before their appointments."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+_DAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
+_MONTHS = (
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+)
+
+
+def reminder_text(appointment):
+    """The SMS reminder for an appointment, sent two days before it.
+
+    The time is shown in the clinic's local (Auckland) time, not UTC.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    date = f"{_DAYS[local.weekday()]} {local.day} {_MONTHS[local.month - 1]}"
+    suffix = "am" if local.hour < 12 else "pm"
+    hour = local.hour % 12 or 12
+    clock = f"{hour}{suffix}" if local.minute == 0 else f"{hour}:{local.minute:02d}{suffix}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora from {clinic}. Reminder: your appointment is on "
+        f"{date} at {clock}. See you then! To change it, please call us."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..4192324
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,46 @@
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_day_and_time(self):
+        # 2:30pm NZDT on Saturday 17 October 2026 is 01:30 UTC.
+        text = reminder_text(appt("A1", utc(2026, 10, 17, 1, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Saturday 17 October at 2:30pm", text)
+
+    def test_whole_hour_has_no_minutes(self):
+        # 9am NZDT on Saturday 17 October 2026 is 20:00 UTC on Friday 16 October.
+        text = reminder_text(appt("A1", utc(2026, 10, 16, 20, 0)))
+        self.assertIn("Saturday 17 October at 9am", text)
+
+    def test_midday_and_midnight_use_twelve(self):
+        noon = reminder_text(appt("A1", utc(2026, 10, 16, 23, 0)))  # 12pm NZDT
+        midnight = reminder_text(appt("A2", utc(2026, 10, 16, 11, 0)))  # 12am NZDT
+        self.assertIn("at 12pm", noon)
+        self.assertIn("at 12am", midnight)
+
+    def test_date_is_the_auckland_date_not_the_utc_date(self):
+        # 00:30 NZDT on Sunday 18 October is still Saturday 17 October in UTC.
+        text = reminder_text(appt("A1", utc(2026, 10, 17, 11, 30)))
+        self.assertIn("Sunday 18 October at 12:30am", text)
+
+    def test_zero_pads_minutes(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 17, 2, 5)))  # 3:05pm NZDT
+        self.assertIn("at 3:05pm", text)
+
+    def test_mentions_calling_to_change_appointment(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 17, 1, 30)))
+        self.assertIn("please call us", text)
+
+    def test_fits_in_one_sms(self):
+        for clinic in ("NG", "HB", "WK"):
+            text = reminder_text(appt("A1", utc(2026, 10, 17, 1, 30), clinic=clinic))
+            self.assertLessEqual(len(text), 160, text)
+
+
+if __name__ == "__main__":
+    unittest.main()
