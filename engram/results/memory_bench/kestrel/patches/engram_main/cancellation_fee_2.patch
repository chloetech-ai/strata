+"""Cancellation and no-show fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation made less than this long before the start costs part of the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for a cancelled or no-show appointment.
+
+    A no-show pays the full session price. A cancellation pays half the session
+    price if it was made less than 48 hours before the start, and nothing otherwise.
+    cancelled_at is when the patient cancelled; it defaults to the time recorded
+    on the appointment.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError(f"no cancellation time for appointment {appointment.id}")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at >= LATE_CANCELLATION_WINDOW:
+        return 0
+    return session_price(appointment.kind) * LATE_CANCELLATION_PERCENT // 100
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..e6da717
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,60 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 10, 9)
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", self.start, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+        self.assertEqual(cancellation_fee(appt("a1", self.start, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+
+    def test_no_show_ignores_cancelled_at(self):
+        a = appt("a1", self.start, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a, cancelled_at=None), 7000)
+
+    def test_cancelled_under_48_hours_before_costs_half(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, cancelled_at=self.start - datetime.timedelta(hours=47, minutes=59)), 4750)
+        self.assertEqual(cancellation_fee(a, cancelled_at=self.start - datetime.timedelta(hours=1)), 4750)
+        self.assertEqual(cancellation_fee(a, cancelled_at=self.start + datetime.timedelta(hours=1)), 4750)
+
+    def test_cancelled_half_price_for_followup(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, cancelled_at=self.start - datetime.timedelta(hours=2)), 3500)
+
+    def test_cancelled_48_hours_or_more_before_is_free(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, cancelled_at=self.start - datetime.timedelta(hours=48)), 0)
+        self.assertEqual(cancellation_fee(a, cancelled_at=self.start - datetime.timedelta(days=10)), 0)
+
+    def test_uses_recorded_cancelled_at_when_not_given(self):
+        a = appt("a1", self.start, status=CANCELLED, cancelled_at=self.start - datetime.timedelta(hours=3))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_argument_overrides_recorded_cancelled_at(self):
+        a = appt("a1", self.start, status=CANCELLED, cancelled_at=self.start - datetime.timedelta(hours=3))
+        self.assertEqual(cancellation_fee(a, cancelled_at=self.start - datetime.timedelta(days=2)), 0)
+
+    def test_cancelled_without_any_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", self.start, status=CANCELLED))
+
+    def test_cancelled_at_must_be_timezone_aware(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, cancelled_at=datetime.datetime(2027, 3, 9, 9))
+
+    def test_other_statuses_have_no_cancellation_fee(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", self.start, status=status), cancelled_at=self.start)
+
+
+if __name__ == "__main__":
+    unittest.main()
