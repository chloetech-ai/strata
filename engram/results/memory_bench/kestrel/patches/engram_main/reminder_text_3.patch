+++ b/tests/test_reminders.py
@@ -0,0 +1,48 @@
+import unittest
+
+from kestrel.models import ASSESSMENT, CLINICS, FOLLOWUP
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 20:30 UTC on 14 Oct is 09:30 on 15 Oct in Auckland (NZDT, +13).
+        a = appt("A1", utc(2026, 10, 14, 20, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October", text)
+        self.assertIn("9:30am", text)
+
+    def test_uses_local_date_across_utc_midnight(self):
+        # 13:00 UTC on 14 Oct is 02:00 on 15 Oct in Auckland, so it is the 15th.
+        a = appt("A1", utc(2026, 10, 14, 13, 0), clinic="NG")
+        self.assertIn("15 October at 2:00am", reminder_text(a))
+
+    def test_afternoon_times_use_pm(self):
+        a = appt("A1", utc(2026, 10, 15, 2, 5), clinic="WK")  # 15:05 local
+        self.assertIn("at 3:05pm", reminder_text(a))
+
+    def test_midday_and_midnight_are_twelve_hour_clock(self):
+        noon = appt("A1", utc(2026, 10, 14, 23, 0), clinic="WK")  # 12:00 on 15 Oct local
+        midnight = appt("A2", utc(2026, 10, 14, 11, 0), clinic="WK")  # 00:00 on 15 Oct local
+        self.assertIn("15 October at 12:00pm", reminder_text(noon))
+        self.assertIn("15 October at 12:00am", reminder_text(midnight))
+
+    def test_does_not_mention_treatment_or_kind(self):
+        a = appt("A1", utc(2026, 10, 15, 0, 0), kind=ASSESSMENT,
+                 clinic="HB", treatment="lower back pain")
+        text = reminder_text(a).lower()
+        self.assertNotIn("lower back", text)
+        self.assertNotIn("assessment", text)
+        self.assertNotIn("follow", text)
+
+    def test_names_the_clinic_for_each_code(self):
+        for code, clinic in CLINICS.items():
+            a = appt("A1", utc(2026, 10, 15, 0, 0), kind=FOLLOWUP, clinic=code)
+            self.assertIn(clinic.name, reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
