+"""Text of the reminder messages Kestrel sends to patients."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the SMS reminder sent two days before an appointment.
+
+    The text states only the date, the time and the clinic's name. It never
+    mentions the treatment or purpose of the appointment (privacy rule).
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{local:%A} {local.day} {local:%B}"
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    time = f"{hour}:{local.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi there! A friendly reminder of your appointment at {clinic} "
+        f"on {day} at {time}. We look forward to seeing you. "
+        "If you need to change or cancel, please give us a call. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..ca39fc0
