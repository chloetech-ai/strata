+++ b/src/kestrel/booking.py
@@ -0,0 +1,43 @@
+"""Booking rules checked before an appointment is saved."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Notes time the therapist needs after an assessment before the next patient.
+POST_ASSESSMENT_GAP = datetime.timedelta(minutes=15)
+# Union agreement: patient appointments per therapist per day.
+DAILY_LIMIT = 8
+
+
+def _busy_end(appointment):
+    """When an appointment stops blocking the therapist, including any notes gap."""
+    end = appointment.start + DURATIONS[appointment.kind]
+    if appointment.kind == ASSESSMENT:
+        end += POST_ASSESSMENT_GAP
+    return end
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist."""
+    if appointment.therapist_id != therapist.id:
+        return False
+    local_start = appointment.start.astimezone(LOCAL_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    new_end = _busy_end(appointment)
+    booked_that_day = 0
+    for other in calendar.for_therapist(therapist.id):
+        if other.id == appointment.id or other.status == CANCELLED:
+            continue
+        if other.start.astimezone(LOCAL_TZ).date() == local_start.date():
+            booked_that_day += 1
+        if other.start < new_end and appointment.start < _busy_end(other):
+            return False
+    return booked_that_day < DAILY_LIMIT
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..7aeaadd
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,71 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, Therapist
+
+THERAPIST = Therapist("T1", "Ana Test", "HB")
+
+
+def local_day(hh, mm=0):
+    """A time on 2 March 2027 in Auckland (NZDT, UTC+13)."""
+    return datetime.datetime(2027, 3, 2, hh, mm, tzinfo=ZoneInfo("Pacific/Auckland"))
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        cal = Calendar([appt("a1", local_day(9), kind="followup")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local_day(11), kind="followup")))
+
+    def test_start_must_be_quarter_hour_in_auckland_time(self):
+        cal = Calendar()
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20, 15))))  # 09:15 local
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 20, 10))))  # 09:10 local
+
+    def test_overlapping_appointment_blocks(self):
+        cal = Calendar([appt("a1", local_day(9), kind="followup")])  # 09:00-09:30
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local_day(9, 15), kind="followup")))
+
+    def test_back_to_back_followups_allowed(self):
+        cal = Calendar([appt("a1", local_day(9), kind="followup")])  # ends 09:30
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local_day(9, 30), kind="followup")))
+
+    def test_gap_after_assessment_blocks_next_patient(self):
+        cal = Calendar([appt("a1", local_day(9), kind=ASSESSMENT)])  # 09:00-09:45, notes until 10:00
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local_day(9, 45), kind="followup")))
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local_day(9, 50), kind="followup")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local_day(10), kind="followup")))
+
+    def test_new_assessment_leaves_gap_before_next_patient(self):
+        cal = Calendar([appt("a1", local_day(9, 50), kind="followup")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local_day(9), kind=ASSESSMENT)))  # notes gap runs to 10:00
+        cal = Calendar([appt("a1", local_day(10), kind="followup")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local_day(9), kind=ASSESSMENT)))  # 10:00 is after the gap
+
+    def test_other_therapists_do_not_clash(self):
+        cal = Calendar([appt("a1", local_day(9), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local_day(9))))
+
+    def test_appointment_for_another_therapist_is_refused(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("new", local_day(9), therapist="T2")))
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local_day(9), kind="followup", status="cancelled")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local_day(9), kind="followup")))
+
+    def test_daily_limit_of_eight(self):
+        booked = [appt(f"a{i}", local_day(9 + i // 2, 30 * (i % 2)), kind="followup") for i in range(8)]  # 09:00-13:00
+        self.assertFalse(can_book(Calendar(booked), THERAPIST, appt("new", local_day(14), kind="followup")))
+        self.assertTrue(can_book(Calendar(booked[:7]), THERAPIST, appt("new", local_day(14), kind="followup")))
+
+    def test_cancelled_appointments_do_not_count_towards_limit(self):
+        booked = [appt(f"a{i}", local_day(9 + i // 2, 30 * (i % 2)), kind="followup") for i in range(7)]
+        booked.append(appt("cancelled", local_day(14), kind="followup", status="cancelled"))
+        self.assertTrue(can_book(Calendar(booked), THERAPIST, appt("new", local_day(15), kind="followup")))
+
+
+if __name__ == "__main__":
+    unittest.main()
