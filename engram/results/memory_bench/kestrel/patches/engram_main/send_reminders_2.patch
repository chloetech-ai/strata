@@ -0,0 +1,22 @@
+"""Appointment reminders sent by SMS."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment: the clinic, date and time, never what it is for."""
+    local = appointment.start.astimezone(LOCAL_TZ)
+    when = f"{local.strftime('%A')} {local.day} {local.strftime('%B')} at {local.strftime('%H:%M')}"
+    return f"Reminder: you have an appointment at {CLINICS[appointment.clinic].name} on {when}."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment and return how many were sent.
+
+    Every message is built before anything is sent, so a missing patient
+    stops the run before any reminder goes out.
+    """
+    messages = [(patients[a.patient_id].phone, reminder_text(a)) for a in appointments if a.status == BOOKED]
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..33f4490
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,87 @@
+import datetime
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import UTC, appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"accepted": len(body["messages"])}
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Ana Ruru", "+64211000001"),
+    "KP-000002": Patient("KP-000002", "Ben Tui", "+64211000002"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key", self.transport)
+
+    def sent_messages(self):
+        return [(m["to"], m["text"]) for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_one_sms_per_booked_appointment(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 9), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 9), patient="KP-000002"),
+        ]
+        count = send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(count, 2)
+        self.assertEqual([to for to, _ in self.sent_messages()], ["+64211000001", "+64211000002"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 9), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 20, 10), patient="KP-000002", status=CANCELLED,
+                 cancelled_at=utc(2026, 10, 14, 0)),
+            appt("A3", utc(2026, 10, 20, 11), patient="KP-000002", status=ATTENDED),
+            appt("A4", utc(2026, 10, 20, 12), patient="KP-000002", status=NO_SHOW),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 1)
+        self.assertEqual(len(self.sent_messages()), 1)
+
+    def test_no_booked_appointments_sends_nothing(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_text_gives_date_time_and_clinic_only(self):
+        a = appt("A1", utc(2026, 10, 14, 22, 30), patient="KP-000001", clinic="HB",
+                 kind="assessment", treatment="lower back pain")
+        text = reminder_text(a)
+        # 22:30 UTC on 14 Oct is 11:30 on 15 Oct in Auckland (NZDT, +13).
+        self.assertIn("Thursday 15 October at 11:30", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("follow", text.lower())
+
+    def test_sent_text_uses_local_time_across_nzst(self):
+        # 1 July is NZST (+12): 21:00 UTC on 30 June is 09:00 on 1 July in Auckland.
+        a = appt("A1", datetime.datetime(2026, 6, 30, 21, 0, tzinfo=UTC), patient="KP-000001", clinic="NG")
+        send_reminders([a], PATIENTS, self.client)
+        self.assertEqual(self.sent_messages(),
+                         [("+64211000001", "Reminder: you have an appointment at Kestrel Physio Northgate on Wednesday 1 July at 09:00.")])
+
+    def test_missing_patient_sends_nothing(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 9), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 20, 10), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(self.transport.calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
