+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, CLINICS, FOLLOWUP, KINDS
+
+# Appointment length and the gap for notes that follows it, in minutes.
+DURATION_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+NOTES_GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}
+START_STEP_MINUTES = 15  # every appointment starts on a quarter hour
+MAX_PER_DAY = 8  # therapists' union agreement
+
+# Clinic opening hours (local time) by weekday, Monday is 0. A weekday or clinic
+# missing from this table is closed.
+OPENING_HOURS = {
+    **{weekday: {clinic: (datetime.time(7, 30), datetime.time(18, 0)) for clinic in CLINICS} for weekday in range(5)},
+    5: {"NG": (datetime.time(8, 0), datetime.time(12, 0))},
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times at which a new appointment of this kind could be booked.
+
+    `day` is a local (Pacific/Auckland) date. Returns sorted datetime.time values.
+    A start counts when the appointment ends within the clinic's opening hours,
+    and the appointment, plus any notes gap after it, does not overlap another
+    booking for the therapist. Cancelled appointments do not block a slot. If the
+    therapist already has MAX_PER_DAY appointments on the day, there are no slots.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = OPENING_HOURS.get(day.weekday(), {}).get(therapist.clinic)
+    if hours is None:
+        return []
+
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= MAX_PER_DAY:
+        return []
+    busy = [
+        (a.start, a.start + datetime.timedelta(minutes=DURATION_MINUTES[a.kind] + NOTES_GAP_MINUTES[a.kind]))
+        for a in booked
+    ]
+
+    duration = datetime.timedelta(minutes=DURATION_MINUTES[kind])
+    reserved = datetime.timedelta(minutes=DURATION_MINUTES[kind] + NOTES_GAP_MINUTES[kind])
+    step = datetime.timedelta(minutes=START_STEP_MINUTES)
+    opens = datetime.datetime.combine(day, hours[0], tzinfo=LOCAL_TZ)
+    closes = datetime.datetime.combine(day, hours[1], tzinfo=LOCAL_TZ)
+
+    slots = []
+    start = opens
+    while start + duration <= closes:
+        end = start + reserved
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += step
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..610851a
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,108 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import LOCAL_TZ, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MONDAY = datetime.date(2027, 3, 1)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+HB = Therapist("T1", "Alex", "HB")
+NG = Therapist("T2", "Sam", "NG")
+
+
+def local(y, m, d, hh=0, mm=0):
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=LOCAL_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_runs_from_opening_to_last_fitting_start(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # 17:30 + 30 min ends at 18:00
+        self.assertEqual(len(slots), 41)
+
+    def test_assessment_last_start_fits_before_closing(self):
+        slots = free_slots(Calendar(), HB, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))  # 17:15 + 45 min ends at 18:00
+
+    def test_results_are_sorted_time_values_on_quarter_hours(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) and s.minute % 15 == 0 for s in slots))
+
+    def test_saturday_only_northgate_is_open(self):
+        slots = free_slots(Calendar(), NG, SATURDAY, ASSESSMENT)
+        self.assertEqual(slots[0], t(8))
+        self.assertEqual(slots[-1], t(11, 15))  # 11:15 + 45 min ends at 12:00
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_all_closed(self):
+        self.assertEqual(free_slots(Calendar(), NG, SUNDAY, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HB, SUNDAY, FOLLOWUP), [])
+
+    def test_followup_blocks_only_its_own_time(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(t(8, 30), slots)  # ends exactly as the follow-up starts
+        self.assertNotIn(t(8, 45), slots)
+        self.assertNotIn(t(9), slots)
+        self.assertNotIn(t(9, 15), slots)
+        self.assertIn(t(9, 30), slots)  # no notes gap after a follow-up
+
+    def test_assessment_keeps_fifteen_minute_notes_gap_after_it(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(t(8, 30), slots)
+        self.assertNotIn(t(9, 45), slots)  # would run into the notes gap
+        self.assertIn(t(10), slots)  # 9:00 assessment, 45 min, then 15 min notes
+
+    def test_new_assessment_needs_its_own_notes_gap_before_the_next_booking(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 10), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, ASSESSMENT)
+        self.assertIn(t(9), slots)  # 9:00-9:45 assessment, gap until 10:00
+        self.assertNotIn(t(9, 15), slots)  # would run into the 10:00 follow-up
+        self.assertNotIn(t(9, 30), slots)
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=ASSESSMENT, therapist="T1", status="cancelled")])
+        self.assertIn(t(9), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind=ASSESSMENT, therapist="T9")])
+        self.assertIn(t(9), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_uses_local_date_across_utc_midnight(self):
+        # 2 Mar 09:30 NZDT is 1 Mar in UTC; it must block 2 Mar local, not 1 Mar.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20, 30), kind=FOLLOWUP, therapist="T1")])
+        self.assertIn(t(9, 30), free_slots(cal, HB, MONDAY, FOLLOWUP))
+        self.assertNotIn(t(9, 30), free_slots(cal, HB, datetime.date(2027, 3, 2), FOLLOWUP))
+
+    def test_eight_appointments_leave_no_slots(self):
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 7 + i), kind=FOLLOWUP, therapist="T1") for i in range(8)])
+        self.assertEqual(free_slots(cal, HB, MONDAY, FOLLOWUP), [])
+
+    def test_seven_appointments_still_leave_slots(self):
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 7 + i), kind=FOLLOWUP, therapist="T1") for i in range(7)])
+        self.assertTrue(free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        cal = Calendar(
+            [appt(f"a{i}", local(2027, 3, 1, 7 + i), kind=FOLLOWUP, therapist="T1") for i in range(7)]
+            + [appt("a9", local(2027, 3, 1, 15), kind=FOLLOWUP, therapist="T1", status="cancelled")]
+        )
+        self.assertTrue(free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, MONDAY, "physio")
+
+
+if __name__ == "__main__":
+    unittest.main()
