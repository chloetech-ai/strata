+"""Checks made before an appointment is saved."""
+
+import datetime
+
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# How long each kind of appointment takes.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for that therapist.
+
+    It must belong to the therapist, have an id the calendar does not already
+    hold, and not overlap any of the therapist's appointments that are not
+    cancelled.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if any(a.id == appointment.id for a in calendar.all()):
+        return False
+    start, end = appointment.start, _end(appointment)
+    for other in calendar.for_therapist(therapist.id):
+        if other.status == CANCELLED:
+            continue
+        # Half-open intervals: back-to-back appointments do not overlap.
+        if start < _end(other) and other.start < end:
+            return False
+    return True
