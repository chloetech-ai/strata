+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import Therapist
+
+THERAPIST = Therapist("T1", "Sam", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("n", utc(2027, 3, 1, 20))))
+
+    def test_overlapping_start_is_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="followup")])  # 20:00-20:30
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 20, 15))))
+
+    def test_overlap_from_earlier_assessment_is_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="assessment")])  # 20:00-20:45
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 20, 40), kind="followup")))
+
+    def test_new_assessment_overlapping_later_booking_is_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20, 30), kind="followup")])  # 20:30-21:00
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 20, 0), kind="assessment")))
+
+    def test_back_to_back_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="followup")])  # ends 20:30
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 20, 30))))
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 19, 30))))
+
+    def test_other_therapists_bookings_do_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 20))))
+
+    def test_cancelled_booking_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status="cancelled")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 20))))
+
+    def test_appointment_for_another_therapist_is_refused(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("n", utc(2027, 3, 1, 20), therapist="T2")))
+
+    def test_duplicate_id_is_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("a1", utc(2027, 3, 1, 22))))
+
+    def test_does_not_modify_calendar(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        can_book(cal, THERAPIST, appt("n", utc(2027, 3, 1, 20, 10)))
+        self.assertEqual(len(cal), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
