+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_existing_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_clinics_are_counted_separately(self):
+        existing = ["INV-HB-2027-00009", "INV-NG-2027-00002"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00003")
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00001")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_that_are_not_in_the_scheme(self):
+        existing = ["INV-HB-2027-0005", "INV-HB-2027-000050", "XINV-HB-2027-00009", "INV-HB-2027-00003 "]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_unknown_clinic_raises(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("XX", 2027, [])
+
+    def test_raises_when_sequence_would_overflow(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
