+def next_invoice_number(clinic, year, existing):
+    """Return the next INV-<clinic>-<year>-<sequence> number for a clinic and year.
+
+    ``existing`` is every invoice number issued so far, for any clinic and year.
+    Only numbers for this clinic and year count, so the sequence restarts at
+    00001 each year and is kept separately for each clinic.
+    """
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic {clinic!r}")
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year:04d}-(\d{{5}})")
+    sequences = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    sequence = max(sequences, default=0) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} {year}")
+    return f"INV-{clinic}-{year:04d}-{sequence:05d}"
+
+
