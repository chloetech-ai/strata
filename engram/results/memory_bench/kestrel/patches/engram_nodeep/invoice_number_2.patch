+from kestrel.invoices import make_invoice, next_invoice_number
 from kestrel.models import ASSESSMENT, FOLLOWUP, Patient
 
 PATIENT = Patient(id="KP-004211", name="Test Patient", phone="+64211234567")
 
 
+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_sequence_issued(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00900", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00815"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_years_when_counting(self):
+        existing = ["INV-HB-2026-00815", "INV-HB-2028-00100"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_does_not_match_a_clinic_code_that_only_starts_the_same(self):
+        existing = ["INV-HBX-2027-00009"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_an_iterator(self):
+        existing = iter(["INV-WK-2027-00004"])
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00005")
+
+    def test_raises_when_the_year_is_out_of_numbers(self):
+        existing = ["INV-NG-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("NG", 2027, existing)
+
+
