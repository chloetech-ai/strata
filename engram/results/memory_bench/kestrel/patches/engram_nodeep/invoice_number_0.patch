+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_highest_sequence_for_clinic_and_year(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00042", "INV-HB-2026-00007"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00043")
+
+    def test_counts_separately_per_clinic(self):
+        existing = ["INV-NG-2026-00009", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+        self.assertEqual(next_invoice_number("WK", 2026, existing), "INV-WK-2026-00001")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_years_when_counting(self):
+        existing = ["INV-HB-2027-00005", "INV-HB-2025-00080"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_ignores_strings_outside_the_scheme(self):
+        existing = ["legacy-99", "INV-HB-2026-7", "INV-HB-2026-00004"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00005")
+
+    def test_unknown_clinic_raises(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("ZZ", 2026, [])
+
+    def test_exhausted_sequence_raises(self):
+        existing = ["INV-HB-2026-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
