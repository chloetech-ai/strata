+# INV-<clinic code>-<year>-<five-digit sequence>
+_NUMBER_PATTERN = re.compile(r"^INV-([A-Z]+)-(\d{4})-(\d{5})$")
+
 
 @dataclass
 class Invoice:
@@ -36,3 +40,23 @@ def make_invoice(appointment, patient, number, amount_cents):
         amount_cents=amount_cents,
         description=DESCRIPTIONS[appointment.kind],
     )
+
+
+def next_invoice_number(clinic, year, existing):
+    """Return the next INV-<clinic>-<year>-<sequence> number.
+
+    `existing` holds every invoice number issued so far, for any clinic and
+    year. The sequence restarts at 00001 for each clinic and year, so only
+    numbers for this clinic and year count. Strings that are not in the
+    scheme are ignored.
+    """
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic {clinic!r}")
+    highest = 0
+    for number in existing:
+        m = _NUMBER_PATTERN.match(number)
+        if m and m.group(1) == clinic and int(m.group(2)) == year:
+            highest = max(highest, int(m.group(3)))
+    if highest >= 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} {year}")
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
