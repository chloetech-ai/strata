+++ b/tests/test_fees.py
@@ -0,0 +1,51 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+START = utc(2026, 10, 20, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancel_within_48_hours_costs_half_the_price(self):
+        a = appt("A1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47)), 3500)
+
+    def test_cancel_within_48_hours_of_assessment_costs_half_the_price(self):
+        a = appt("A1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=1)), 4750)
+
+    def test_cancel_exactly_48_hours_before_is_free(self):
+        a = appt("A1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+
+    def test_cancel_more_than_48_hours_before_is_free(self):
+        a = appt("A1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 1)), 0)
+
+    def test_cancel_after_start_costs_half_the_price(self):
+        a = appt("A1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(hours=2)), 3500)
+
+    def test_cancelled_without_cancelled_at_raises(self):
+        a = appt("A1", START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, None)
+
+    def test_naive_cancelled_at_raises(self):
+        a = appt("A1", START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2026, 10, 19, 9))
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("A1", START, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+        self.assertEqual(cancellation_fee(appt("A2", START, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+
+    def test_booked_or_attended_has_no_fee(self):
+        self.assertEqual(cancellation_fee(appt("A1", START, status=BOOKED)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
