index 0000000..08fda74
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,32 @@
+"""Parsing durations typed in by reception."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h")
+_HOURS_AND_MINUTES = re.compile(r"([0-9]+)h\s*([0-9]{1,2})m?")
+
+
+def parse_duration(text):
+    """Return the length in minutes for input like "45m", "1h", "1h30" or "1h 30m".
+
+    Raises ValueError if the input is not a duration.
+    """
+    stripped = text.strip()
+
+    match = _HOURS_AND_MINUTES.fullmatch(stripped)
+    if match is not None:
+        hours, minutes = int(match.group(1)), int(match.group(2))
+        if minutes >= 60:
+            raise ValueError(f"minutes out of range: {text!r}")
+        return hours * 60 + minutes
+
+    match = _HOURS.fullmatch(stripped)
+    if match is not None:
+        return int(match.group(1)) * 60
+
+    match = _MINUTES.fullmatch(stripped)
+    if match is not None:
+        return int(match.group(1))
+
+    raise ValueError(f"not a duration: {text!r}")
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..35278d9
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,28 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45m": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "1h30m": 90,
+            "  45m  ": 45,
+        }
+        for raw, minutes in cases.items():
+            with self.subTest(raw=raw):
+                self.assertEqual(parse_duration(raw), minutes)
+
+    def test_rejects_anything_else(self):
+        for raw in ["", "45", "30 m", "m", "h", "1.5h", "-45m", "1h60", "1h 90m", "1 hour", "45min", "1h30m15"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
