+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_interval(self):
+        self.assertEqual(merge_busy([(2, 5)]), [(2, 5)])
+
+    def test_disjoint_intervals_are_sorted(self):
+        self.assertEqual(merge_busy([(7, 9), (1, 2)]), [(1, 2), (7, 9)])
+
+    def test_overlapping_intervals_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_interval_does_not_shrink(self):
+        self.assertEqual(merge_busy([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_any_order(self):
+        self.assertEqual(
+            merge_busy([(8, 10), (5, 6), (1, 2), (2, 4), (9, 12)]),
+            [(1, 4), (5, 6), (8, 12)],
+        )
+
+    def test_does_not_modify_input(self):
+        intervals = [(3, 5), (1, 2)]
+        merge_busy(intervals)
+        self.assertEqual(intervals, [(3, 5), (1, 2)])
+
+
+if __name__ == "__main__":
+    unittest.main()
