+"""Combining (start, end) intervals."""
+
+
+def merge_busy(intervals):
+    """Return the intervals as a sorted list of non-overlapping (start, end) pairs.
+
+    Input may be in any order. Intervals that overlap or touch are merged, so
+    (1, 3) and (3, 5) become (1, 5). Works with any mutually comparable values,
+    such as numbers or timezone-aware datetimes.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
