+from helpers import appt, utc
+from kestrel.models import ASSESSMENT, FOLLOWUP, Patient
+from kestrel.pricing import appointment_price, session_price
+
+PATIENT = Patient(id="KP-004211", name="Test Patient", phone="+64211234567")
+CSC_PATIENT = Patient(id="KP-004212", name="Test CSC", phone="+64211234568", csc=True)
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def test_before_1_april_2027_uses_old_prices(self):
+        a = appt("A1", utc(2027, 3, 1, 9), kind=ASSESSMENT)
+        f = appt("A2", utc(2027, 3, 1, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, PATIENT), 9500)
+        self.assertEqual(appointment_price(f, PATIENT), 7000)
+
+    def test_last_local_moment_before_rise_uses_old_prices(self):
+        # 31 Mar 10:59 UTC is 31 Mar 23:59 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2027, 3, 31, 10, 59), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, PATIENT), 9500)
+
+    def test_local_date_decides_not_utc_date(self):
+        # 31 Mar 11:00 UTC is 1 Apr 00:00 in Auckland, so the new prices apply
+        # even though the UTC date is still 31 March.
+        a = appt("A1", utc(2027, 3, 31, 11), kind=ASSESSMENT)
+        f = appt("A2", utc(2027, 3, 31, 11), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, PATIENT), 10500)
+        self.assertEqual(appointment_price(f, PATIENT), 7800)
+
+    def test_on_or_after_1_april_2027_uses_new_prices(self):
+        a = appt("A1", utc(2027, 6, 1, 9), kind=ASSESSMENT)
+        f = appt("A2", utc(2027, 6, 1, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, PATIENT), 10500)
+        self.assertEqual(appointment_price(f, PATIENT), 7800)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        f = appt("A1", utc(2026, 10, 15, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(f, CSC_PATIENT), 5600)
+
+    def test_csc_followup_discount_after_rise(self):
+        f = appt("A1", utc(2027, 6, 1, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(f, CSC_PATIENT), 6240)
+
+    def test_csc_assessment_is_not_discounted(self):
+        a = appt("A1", utc(2026, 10, 15, 9), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, CSC_PATIENT), 9500)
+        b = appt("A2", utc(2027, 6, 1, 9), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(b, CSC_PATIENT), 10500)
 
 
 class SessionPriceTest(unittest.TestCase):
