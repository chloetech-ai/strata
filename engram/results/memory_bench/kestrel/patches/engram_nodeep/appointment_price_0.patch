 """Session prices."""
 
+import datetime
+import zoneinfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+LOCAL_TZ = zoneinfo.ZoneInfo("Pacific/Auckland")
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)  # local (Auckland) date the new prices start
+
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
 
 def session_price(kind):
     """Return the price of a session of this kind, in cents."""
@@ -14,3 +25,17 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for this appointment, in cents.
+
+    Appointments on or after 1 April 2027 (local Auckland date) use the new prices.
+    CSC holders get 20% off follow-ups, not initial assessments.
+    """
+    local_day = appointment.start.astimezone(LOCAL_TZ).date()
+    prices = NEW_PRICES_CENTS if local_day >= NEW_PRICES_FROM else PRICES_CENTS
+    price = prices[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * 80 // 100
+    return price
