+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, NO_SHOW, Therapist
+
+T1 = Therapist(id="T1", name="Ana", clinic="HB")
+T2 = Therapist(id="T2", name="Ben", clinic="HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_overlapping_booked_appointment_blocks(self):
+        # Existing follow-up 20:00-20:30; new follow-up at 20:15 overlaps.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 15))))
+
+    def test_back_to_back_is_allowed(self):
+        # Existing follow-up ends at 20:30; a new one starting then does not overlap.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 30))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 19, 30))))
+
+    def test_existing_duration_is_used(self):
+        # Existing assessment 20:00-20:45 blocks a 20:40 start.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind=ASSESSMENT)])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 40))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 45))))
+
+    def test_new_assessment_duration_is_used(self):
+        # Existing follow-up 20:30-21:00; a 20:00 assessment runs to 20:45 and overlaps.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20, 30))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20), kind=ASSESSMENT)))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 19, 45), kind=ASSESSMENT)))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_cancelled_and_no_show_do_not_block(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 1, 20), status=CANCELLED),
+            appt("a2", utc(2027, 3, 1, 20), status=NO_SHOW),
+        ])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_compares_instants_across_timezones(self):
+        # 08:00 UTC is 21:00 in Auckland (UTC+13); the same instant expressed in another zone must still clash.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 8))])
+        other = datetime.timezone(datetime.timedelta(hours=-5))
+        self.assertFalse(can_book(cal, T1, appt("new", datetime.datetime(2027, 3, 1, 3, 10, tzinfo=other))))
+
+
+if __name__ == "__main__":
+    unittest.main()
