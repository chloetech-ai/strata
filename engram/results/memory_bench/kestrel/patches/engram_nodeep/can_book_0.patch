+"""Booking checks for the appointment calendar."""
+
+import datetime
+
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+# How long each kind of appointment occupies the therapist's calendar.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def can_book(calendar, therapist, appointment):
+    """Return True if the appointment fits in the therapist's calendar without overlapping a booked one."""
+    start = appointment.start
+    end = start + DURATIONS[appointment.kind]
+    for other in calendar.for_therapist(therapist.id):
+        if other.status != BOOKED:
+            continue
+        if other.start < end and start < _end(other):
+            return False
+    return True
