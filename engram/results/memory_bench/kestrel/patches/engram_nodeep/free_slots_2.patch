@@ -0,0 +1,65 @@
+"""Free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP, KINDS
+
+# How long each kind of appointment takes, in minutes.
+DURATION_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+# Minutes the therapist keeps free after each kind, to write notes before the next patient.
+NOTE_GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}
+# Appointments start on a quarter hour.
+START_STEP = datetime.timedelta(minutes=15)
+
+# Opening hours (local time). Weekdays are the same at every clinic.
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+# On Saturdays only Northgate opens. Sundays are closed.
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}
+
+
+def opening_hours(therapist, day):
+    """The (open, close) local times of the therapist's clinic on a local date, or None if closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(therapist.clinic)
+    return None
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) at which a new appointment of this kind could be
+    booked for the therapist on a local (Pacific/Auckland) date.
+
+    A slot must fit inside opening hours and must not overlap any booked appointment of the
+    therapist, including the note gap after an assessment. Kestrel never overbooks.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist, day)
+    if hours is None:
+        return []
+
+    def local(t):
+        return datetime.datetime.combine(day, t, tzinfo=LOCAL_TZ)
+
+    # Each booked appointment blocks its time plus its note gap.
+    busy = []
+    for appointment in calendar.for_day(therapist.id, day):
+        if appointment.status != BOOKED:
+            continue
+        blocked = DURATION_MINUTES[appointment.kind] + NOTE_GAP_MINUTES[appointment.kind]
+        busy.append((appointment.start, appointment.start + datetime.timedelta(minutes=blocked)))
+
+    duration = datetime.timedelta(minutes=DURATION_MINUTES[kind])
+    blocked = duration + datetime.timedelta(minutes=NOTE_GAP_MINUTES[kind])
+    open_at, close_at = local(hours[0]), local(hours[1])
+
+    slots = []
+    start = open_at
+    while start + duration <= close_at:
+        end = start + blocked
+        if all(end <= busy_start or busy_end <= start for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += START_STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..15d69f2
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,98 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import LOCAL_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+TUESDAY = datetime.date(2027, 3, 2)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+HB = Therapist("T1", "Ana", "HB")
+NG = Therapist("T2", "Ben", "NG")
+
+
+def local(hh, mm, day=TUESDAY):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=LOCAL_TZ)
+
+
+def t(hh, mm):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_followup_runs_07_30_to_17_30(self):
+        slots = free_slots(Calendar(), HB, TUESDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))
+        self.assertEqual(len(slots), 41)
+
+    def test_empty_weekday_assessment_must_finish_by_18_00(self):
+        slots = free_slots(Calendar(), HB, TUESDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))
+        self.assertEqual(len(slots), 40)
+
+    def test_slots_are_sorted_and_on_quarter_hours(self):
+        slots = free_slots(Calendar(), HB, TUESDAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(s.minute % 15 == 0 and s.second == 0 for s in slots))
+
+    def test_saturday_only_northgate_open_08_00_to_12_00(self):
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+        slots = free_slots(Calendar(), NG, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(8, 0))
+        self.assertEqual(slots[-1], t(11, 30))
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), NG, SUNDAY, ASSESSMENT), [])
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, TUESDAY, "physio")
+
+    def test_booked_followup_blocks_its_half_hour(self):
+        cal = Calendar([appt("a1", local(10, 0).astimezone(datetime.timezone.utc), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, TUESDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 0), slots)
+        self.assertNotIn(t(9, 45), slots)
+        self.assertIn(t(9, 30), slots)  # ends exactly when the booking starts
+        self.assertIn(t(10, 30), slots)  # no gap after a follow-up
+
+    def test_booked_assessment_blocks_its_note_gap(self):
+        cal = Calendar([appt("a1", local(10, 0).astimezone(datetime.timezone.utc), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB, TUESDAY, FOLLOWUP)
+        # The assessment runs 10:00-10:45 and the note gap is 10:45-11:00.
+        self.assertIn(t(9, 30), slots)
+        self.assertNotIn(t(9, 45), slots)
+        self.assertNotIn(t(10, 30), slots)
+        self.assertNotIn(t(10, 45), slots)
+        self.assertIn(t(11, 0), slots)
+
+    def test_new_assessment_leaves_note_gap_before_next_booking(self):
+        cal = Calendar([appt("a1", local(11, 0).astimezone(datetime.timezone.utc), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, TUESDAY, ASSESSMENT)
+        # 10:00 assessment runs to 10:45 plus the gap, ending 11:00, so it fits.
+        self.assertIn(t(10, 0), slots)
+        # 10:15 assessment would need until 11:15, overlapping the 11:00 follow-up.
+        self.assertNotIn(t(10, 15), slots)
+        self.assertNotIn(t(10, 30), slots)
+
+    def test_cancelled_booking_frees_its_slot(self):
+        cal = Calendar([appt("a1", local(10, 0).astimezone(datetime.timezone.utc), kind=ASSESSMENT, therapist="T1")])
+        cal.cancel("a1", utc(2027, 3, 1, 0))
+        self.assertIn(t(10, 0), free_slots(cal, HB, TUESDAY, FOLLOWUP))
+
+    def test_other_therapists_bookings_do_not_block(self):
+        cal = Calendar([appt("a1", local(10, 0).astimezone(datetime.timezone.utc), kind=ASSESSMENT, therapist="T9")])
+        self.assertIn(t(10, 0), free_slots(cal, HB, TUESDAY, FOLLOWUP))
+
+    def test_booking_is_compared_on_its_local_day(self):
+        # 20:00 UTC on 1 March is 09:00 on 2 March in Auckland, so it blocks 09:00 on Tuesday.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind=FOLLOWUP, therapist="T1")])
+        self.assertNotIn(t(9, 0), free_slots(cal, HB, TUESDAY, FOLLOWUP))
+        self.assertIn(t(9, 0), free_slots(cal, HB, datetime.date(2027, 3, 1), FOLLOWUP))
+
+
+if __name__ == "__main__":
+    unittest.main()
