+++ b/src/kestrel/reminders.py
@@ -0,0 +1,22 @@
+"""Text messages reminding patients of their upcoming appointments."""
+
+from kestrel.calendar import LOCAL_TZ
+from kestrel.models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the SMS sent two days before an appointment.
+
+    SMS reminders carry only the date, the time and the clinic's name. They
+    never say what the appointment is for, so the treatment is left out.
+    """
+    start = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{start:%A} {start.day} {start:%B}"
+    hour = start.hour % 12 or 12
+    suffix = "am" if start.hour < 12 else "pm"
+    time = f"{hour}:{start.minute:02d}{suffix}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi! Just a friendly reminder of your appointment at {clinic} "
+        f"on {day} at {time}. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..055f0b3
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,34 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic(self):
+        # 14 Oct 01:30 UTC is 14 Oct 14:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 14, 1, 30), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Hi! Just a friendly reminder of your appointment at Kestrel Physio Harbour "
+            "on Wednesday 14 October at 2:30pm. See you then!",
+        )
+
+    def test_uses_auckland_date_not_utc_date(self):
+        # 14 Oct 12:30 UTC is 15 Oct 01:30 in Auckland.
+        a = appt("A1", utc(2026, 10, 14, 12, 30), clinic="NG")
+        self.assertIn("on Thursday 15 October at 1:30am", reminder_text(a))
+
+    def test_midday_is_pm(self):
+        # 13 Oct 23:00 UTC is 14 Oct 12:00 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 13, 23, 0), clinic="WK")
+        self.assertIn("at 12:00pm", reminder_text(a))
+
+    def test_never_mentions_treatment(self):
+        a = appt("A1", utc(2026, 10, 14, 1, 30), clinic="HB")
+        a.treatment = "lower back pain"
+        self.assertNotIn("lower back pain", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
