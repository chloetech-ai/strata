+class AppointmentPriceTest(unittest.TestCase):
+    def patient(self, csc=False):
+        return Patient("KP-000001", "Ana Silva", "+64211234567", csc=csc)
+
+    def appointment(self, kind, start):
+        return Appointment("A1", "KP-000001", "T1", "NG", start, kind)
+
+    def at_auckland(self, *args):
+        return datetime.datetime(*args, tzinfo=AUCKLAND)
+
+    def test_before_april_2027_keeps_old_prices(self):
+        start = self.at_auckland(2027, 3, 31, 23, 30)
+        self.assertEqual(appointment_price(self.appointment(ASSESSMENT, start), self.patient()), 9500)
+        self.assertEqual(appointment_price(self.appointment(FOLLOWUP, start), self.patient()), 7000)
+
+    def test_from_1_april_2027_uses_new_prices(self):
+        start = self.at_auckland(2027, 4, 1, 0, 30)
+        self.assertEqual(appointment_price(self.appointment(ASSESSMENT, start), self.patient()), 10500)
+        self.assertEqual(appointment_price(self.appointment(FOLLOWUP, start), self.patient()), 7800)
+
+    def test_cutoff_uses_auckland_date_not_utc(self):
+        # 00:30 on 1 April in Auckland (UTC+13) is 11:30 UTC on 31 March.
+        utc_start = datetime.datetime(2027, 3, 31, 11, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment(FOLLOWUP, utc_start), self.patient()), 7800)
+        # 23:30 on 31 March in Auckland is 10:30 UTC on 31 March: still the old price.
+        utc_start = datetime.datetime(2027, 3, 31, 10, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment(FOLLOWUP, utc_start), self.patient()), 7000)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        start = self.at_auckland(2026, 10, 15, 9, 0)
+        self.assertEqual(appointment_price(self.appointment(FOLLOWUP, start), self.patient(csc=True)), 5600)
+
+    def test_csc_followup_discount_after_april_2027(self):
+        start = self.at_auckland(2027, 5, 3, 9, 0)
+        self.assertEqual(appointment_price(self.appointment(FOLLOWUP, start), self.patient(csc=True)), 6240)
+
+    def test_csc_does_not_discount_assessment(self):
+        start = self.at_auckland(2026, 10, 15, 9, 0)
+        self.assertEqual(appointment_price(self.appointment(ASSESSMENT, start), self.patient(csc=True)), 9500)
+
+    def test_patient_must_match_appointment(self):
+        start = self.at_auckland(2026, 10, 15, 9, 0)
+        other = Patient("KP-000002", "Ben Ross", "+64211234568")
+        with self.assertRaises(ValueError):
+            appointment_price(self.appointment(FOLLOWUP, start), other)
+
+
 if __name__ == "__main__":
     unittest.main()
