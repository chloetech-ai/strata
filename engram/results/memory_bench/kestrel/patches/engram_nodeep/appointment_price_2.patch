 """Session prices."""
 
+import datetime
+
+from kestrel.calendar import LOCAL_TZ
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
 PRICES_CENTS = {
@@ -7,6 +10,15 @@ PRICES_CENTS = {
     FOLLOWUP: 7000,  # $70
 }
 
+# Appointments whose local (Auckland) date is on or after this day pay NEW_PRICES_CENTS.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
 def session_price(kind):
     """Return the price of a session of this kind, in cents."""
@@ -14,3 +26,17 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for this appointment, in cents."""
+    if patient.id != appointment.patient_id:
+        raise ValueError(f"appointment is for {appointment.patient_id!r}, not {patient.id!r}")
+    local_date = appointment.start.astimezone(LOCAL_TZ).date()
+    if local_date >= NEW_PRICES_FROM:
+        price = NEW_PRICES_CENTS[appointment.kind]
+    else:
+        price = session_price(appointment.kind)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
