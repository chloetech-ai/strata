+"""Reading durations typed in as text, such as "45m" or "1h 30m"."""
+
+import re
+
+_DURATION = re.compile(r"(?:(\d+)h\s*(?:(\d+)m?)?|(\d+)m)")
+
+
+def parse_duration(text):
+    """Return the length in minutes for input like "45m", "1h", "1h30" or "1h 30m".
+
+    Raises ValueError if the input is not a duration, or is zero minutes long.
+    """
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, minutes_only = match.groups()
+    if minutes_only is not None:
+        minutes = int(minutes_only)
+    else:
+        minutes = int(hours) * 60 + int(minutes_after_hours or 0)
+        if minutes_after_hours is not None and int(minutes_after_hours) >= 60:
+            raise ValueError(f"minutes must be under 60 after hours: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
