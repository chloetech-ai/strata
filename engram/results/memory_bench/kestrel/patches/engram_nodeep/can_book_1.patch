@@ -0,0 +1,42 @@
+"""Checks used by the booking form before an appointment is saved."""
+
+import datetime
+
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+# How long each kind of appointment takes, for working out overlaps.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist.
+
+    It must belong to the therapist, have an ID not already in the calendar,
+    and not overlap any booked appointment for the same therapist. Cancelled,
+    attended and no-show appointments do not block their time.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if _has_id(calendar, appointment.id):
+        return False
+
+    start = appointment.start
+    end = start + DURATIONS[appointment.kind]
+    for other in calendar.for_therapist(therapist.id):
+        if other.status != BOOKED:
+            continue
+        other_end = other.start + DURATIONS[other.kind]
+        if other.start < end and start < other_end:
+            return False
+    return True
+
+
+def _has_id(calendar, appointment_id):
+    try:
+        calendar.get(appointment_id)
+    except KeyError:
+        return False
+    return True
diff --git a/tests/test_booking.py b/tests/test_booking.py
