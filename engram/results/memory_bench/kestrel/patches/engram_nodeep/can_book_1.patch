+++ b/tests/test_booking.py
@@ -0,0 +1,59 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, ATTENDED, NO_SHOW, Therapist
+
+T1 = Therapist("T1", "Ana", "HB")
+T2 = Therapist("T2", "Ben", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar_allows_booking(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_same_start_is_rejected(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_overlap_with_existing_followup_is_rejected(self):
+        # A 30-minute follow-up from 20:00 runs to 20:30.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 15))))
+
+    def test_overlap_with_existing_assessment_is_rejected(self):
+        # A 45-minute assessment from 20:00 runs to 20:45.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind=ASSESSMENT)])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 30))))
+
+    def test_new_assessment_overlapping_later_followup_is_rejected(self):
+        # The new 45-minute assessment from 20:00 runs to 20:45, into the 20:30 follow-up.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20, 30))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20), kind=ASSESSMENT)))
+
+    def test_back_to_back_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20, 30))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 19, 30))))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_inactive_statuses_do_not_block(self):
+        for status in (CANCELLED, ATTENDED, NO_SHOW):
+            with self.subTest(status=status):
+                cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status=status)])
+                self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_appointment_for_other_therapist_is_rejected(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20), therapist="T2")))
+
+    def test_duplicate_id_is_rejected(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("a1", utc(2027, 3, 2, 20))))
+
+
+if __name__ == "__main__":
+    unittest.main()
