+class AppointmentPriceTest(unittest.TestCase):
+    def test_before_rise_uses_old_prices(self):
+        # 31 Mar 2027 10:00 UTC is 31 Mar 23:00 in Auckland (NZDT, UTC+13).
+        start = datetime.datetime(2027, 3, 31, 10, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 9500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7000)
+
+    def test_rise_starts_at_local_midnight_on_1_april(self):
+        # 31 Mar 11:00 UTC is 1 Apr 00:00 in Auckland; 10:59 UTC is still 31 Mar.
+        before = datetime.datetime(2027, 3, 31, 10, 59, tzinfo=datetime.timezone.utc)
+        after = datetime.datetime(2027, 3, 31, 11, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, before), patient()), 9500)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, after), patient()), 10500)
+
+    def test_date_is_taken_in_auckland_not_utc(self):
+        # 31 Mar 23:00 UTC is already 1 Apr 12:00 in Auckland, so the new price applies.
+        start = datetime.datetime(2027, 3, 31, 23, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7800)
+
+    def test_after_rise_uses_new_prices(self):
+        start = datetime.datetime(2027, 6, 1, 3, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 10500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7800)
+
+    def test_csc_gets_20_percent_off_followup_only(self):
+        start = datetime.datetime(2026, 10, 15, 2, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient(csc=True)), 5600)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient(csc=True)), 9500)
+
+    def test_csc_discount_applies_to_new_followup_price(self):
+        start = datetime.datetime(2027, 6, 1, 3, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient(csc=True)), 10500)
+
+    def test_appointment_for_another_patient_raises(self):
+        start = datetime.datetime(2026, 10, 15, 2, 0, tzinfo=datetime.timezone.utc)
+        with self.assertRaises(ValueError):
+            appointment_price(appointment(FOLLOWUP, start, patient_id="KP-000002"), patient())
+
+
 if __name__ == "__main__":
     unittest.main()
