 """Session prices."""
 
+import datetime
+import zoneinfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+LOCAL_TZ = zoneinfo.ZoneInfo("Pacific/Auckland")
+
+# Prices for appointments before PRICE_RISE_DATE.
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+# Prices for appointments on or after PRICE_RISE_DATE (local date).
+PRICE_RISE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
 
 def session_price(kind):
     """Return the price of a session of this kind, in cents."""
@@ -14,3 +27,19 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for this appointment, in cents.
+
+    The price depends on the appointment's local (Pacific/Auckland) date.
+    Community Services Card holders get 20% off follow-ups, not assessments.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id!r} is not for patient {patient.id!r}")
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    prices = NEW_PRICES_CENTS if day >= PRICE_RISE_DATE else PRICES_CENTS
+    price = prices[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * 80 // 100
+    return price
