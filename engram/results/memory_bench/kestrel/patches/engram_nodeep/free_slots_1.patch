@@ -0,0 +1,45 @@
+"""Free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+UTC = datetime.timezone.utc
+
+# How long each kind of appointment takes, and how long the therapist keeps free
+# after it to write notes before their next patient.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+NOTE_GAPS = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on a local (Pacific/Auckland) date when a new appointment of this kind
+    could be booked for the therapist, sorted. Starts fall on quarter hours."""
+    if kind not in DURATIONS:
+        raise ValueError(f"unknown kind {kind!r}")
+
+    # Each existing appointment blocks its duration plus its note gap. Cancelled ones free their time.
+    busy = []
+    for appointment in calendar.for_therapist(therapist.id):
+        if appointment.status == CANCELLED:
+            continue
+        start = appointment.start.astimezone(UTC)
+        busy.append((start, start + DURATIONS[appointment.kind] + NOTE_GAPS[appointment.kind]))
+
+    # Compare in UTC so that adding durations is exact across daylight saving changes.
+    new_length = DURATIONS[kind] + NOTE_GAPS[kind]
+    slots = []
+    for hour in range(24):
+        for minute in (0, 15, 30, 45):
+            start = datetime.datetime.combine(day, datetime.time(hour, minute), tzinfo=LOCAL_TZ).astimezone(UTC)
+            end = start + new_length
+            if all(end <= busy_start or busy_end <= start for busy_start, busy_end in busy):
+                slots.append(datetime.time(hour, minute))
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..d6ff320
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,73 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+THERAPIST = Therapist("T1", "Ana", "HB")
+DAY = datetime.date(2027, 3, 2)  # local date; 00:00 local is 1 March 11:00 UTC
+T = datetime.time
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_calendar_offers_every_quarter_hour(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(len(slots), 96)
+        self.assertEqual(slots[0], T(0, 0))
+        self.assertEqual(slots[-1], T(23, 45))
+
+    def test_assessment_leaves_note_gap_after_it(self):
+        # Local 09:00-09:45, then 15 minutes for notes until 10:00.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind=ASSESSMENT)])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertIn(T(8, 0), slots)  # a new 45-minute assessment 08:00-08:45 + 15 gap ends at 09:00
+        self.assertNotIn(T(8, 15), slots)  # would run into the 09:00 assessment
+        for blocked in (T(9, 0), T(9, 15), T(9, 30), T(9, 45)):
+            self.assertNotIn(blocked, slots)
+        self.assertIn(T(10, 0), slots)  # the note gap after 09:00-09:45 ends at 10:00
+
+    def test_gap_is_kept_before_the_next_patient(self):
+        # Existing assessment local 10:00-10:45, with notes until 11:00.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 21), kind=ASSESSMENT)])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertNotIn(T(9, 30), slots)  # 09:30-10:15 overlaps the 10:00 assessment
+        self.assertIn(T(9, 0), slots)  # 09:00-09:45 + 15 gap ends at 10:00, exactly when the next starts
+        self.assertNotIn(T(10, 0), slots)
+        self.assertIn(T(11, 0), slots)
+
+    def test_followup_has_no_gap_after_it(self):
+        # Local 09:00-09:30 follow-up; nothing is kept free after it.
+        cal = Calendar([appt("f1", utc(2027, 3, 1, 20), kind=FOLLOWUP)])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertIn(T(9, 30), slots)
+        self.assertIn(T(8, 30), slots)  # ends at 09:00 exactly
+        self.assertNotIn(T(8, 45), slots)
+        self.assertNotIn(T(9, 0), slots)
+
+    def test_assessment_after_followup_needs_no_gap(self):
+        cal = Calendar([appt("f1", utc(2027, 3, 1, 20), kind=FOLLOWUP)])  # local 09:00-09:30
+        self.assertIn(T(9, 30), free_slots(cal, THERAPIST, DAY, ASSESSMENT))
+
+    def test_cancelled_appointment_frees_its_time(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind=ASSESSMENT, status=CANCELLED)])
+        self.assertEqual(len(free_slots(cal, THERAPIST, DAY, ASSESSMENT)), 96)
+
+    def test_other_therapists_are_ignored(self):
+        cal = Calendar([appt("f1", utc(2027, 3, 1, 20), kind=FOLLOWUP, therapist="T2")])
+        self.assertEqual(len(free_slots(cal, THERAPIST, DAY, FOLLOWUP)), 96)
+
+    def test_uses_local_date(self):
+        # 20:00 UTC on 1 March is 09:00 on 2 March in Auckland, so it does not affect 1 March.
+        cal = Calendar([appt("f1", utc(2027, 3, 1, 20), kind=FOLLOWUP)])
+        self.assertNotIn(T(9, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+        self.assertIn(T(9, 0), free_slots(cal, THERAPIST, datetime.date(2027, 3, 1), FOLLOWUP))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "consult")
+
+
+if __name__ == "__main__":
+    unittest.main()
