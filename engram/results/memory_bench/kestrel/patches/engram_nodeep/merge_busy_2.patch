+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single(self):
+        self.assertEqual(merge_busy([(1, 2)]), [(1, 2)])
+
+    def test_disjoint_sorted_out_of_order(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_interval_keeps_outer_end(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_chain_merges_into_one(self):
+        self.assertEqual(merge_busy([(4, 5), (1, 2), (2, 4), (7, 8)]), [(1, 5), (7, 8)])
+
+    def test_accepts_lists_and_returns_tuples(self):
+        self.assertEqual(merge_busy([[1, 2], [2, 3]]), [(1, 3)])
+
+    def test_does_not_modify_input(self):
+        intervals = [(3, 4), (1, 2)]
+        merge_busy(intervals)
+        self.assertEqual(intervals, [(3, 4), (1, 2)])
+
+
+if __name__ == "__main__":
+    unittest.main()
