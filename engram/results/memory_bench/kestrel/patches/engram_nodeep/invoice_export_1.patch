@@ -0,0 +1,90 @@
+import csv
+import datetime
+import tempfile
+import unittest
+from pathlib import Path
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def inv(number, issued, amount_cents=7000, patient_id="KP-004211", description="Follow-up session"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.out_dir = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_file_is_named_by_year_and_month(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, self.out_dir / "kestrel-invoices-2026-10.csv")
+        self.assertTrue(path.exists())
+
+    def test_writes_header_row_then_invoices(self):
+        invoices = [inv("INV-HB-2026-00001", datetime.date(2026, 10, 15), 7000)]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual(rows[0], ["Invoice number", "Clinic", "Patient ID", "Date", "Description", "Amount"])
+        self.assertEqual(
+            rows[1],
+            ["INV-HB-2026-00001", "HB", "KP-004211", "15/10/2026", "Follow-up session", "70.00"],
+        )
+
+    def test_only_invoices_from_that_month_are_included(self):
+        invoices = [
+            inv("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            inv("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            inv("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            inv("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            inv("INV-HB-2025-00005", datetime.date(2025, 10, 15)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        invoices = [
+            inv("INV-HB-2026-00001", datetime.date(2026, 10, 2), 9500, description="Initial assessment"),
+            inv("INV-HB-2026-00002", datetime.date(2026, 10, 3), 5600),
+            inv("INV-HB-2026-00003", datetime.date(2026, 10, 4), 12005),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[5] for r in rows[1:]], ["95.00", "56.00", "120.05"])
+
+    def test_dates_are_day_first(self):
+        invoices = [inv("INV-HB-2026-00001", datetime.date(2026, 10, 5))]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual(rows[1][3], "05/10/2026")
+
+    def test_contains_patient_id_and_never_names(self):
+        invoices = [inv("INV-HB-2026-00001", datetime.date(2026, 10, 5))]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertIn("KP-004211", path.read_text(encoding="utf-8"))
+        self.assertNotIn("Test Patient", path.read_text(encoding="utf-8"))
+
+    def test_empty_month_writes_header_only(self):
+        rows = self.read_rows(export_invoices([], 2026, 10, self.out_dir))
+        self.assertEqual(len(rows), 1)
+
+    def test_creates_missing_out_dir(self):
+        out_dir = self.out_dir / "nested" / "exports"
+        path = export_invoices([], 2026, 10, out_dir)
+        self.assertTrue(path.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
