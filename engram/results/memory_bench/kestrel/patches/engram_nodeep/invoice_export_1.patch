+"""Monthly export of invoices for the accountant."""
+
+import csv
+from pathlib import Path
+
+HEADER = ["Invoice number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV file in out_dir and return its path.
+
+    The file is kestrel-invoices-YYYY-MM.csv, with a header row, dates as DD/MM/YYYY and
+    amounts as plain numbers with two decimals. Only patient IDs are written, never names.
+    """
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    path = out_dir / f"kestrel-invoices-{year:04d}-{month:02d}.csv"
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for inv in invoices:
+            if inv.issued.year != year or inv.issued.month != month:
+                continue
+            writer.writerow([
+                inv.number,
+                inv.clinic,
+                inv.patient_id,
+                inv.issued.strftime("%d/%m/%Y"),
+                inv.description,
+                f"{inv.amount_cents / 100:.2f}",
+            ])
+    return path
