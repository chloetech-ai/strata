+import datetime
+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_pair(self):
+        self.assertEqual(merge_busy([(1, 2)]), [(1, 2)])
+
+    def test_disjoint_pairs_are_sorted(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2), (3, 4)]), [(1, 2), (3, 4), (5, 6)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_contained_pair_is_absorbed(self):
+        self.assertEqual(merge_busy([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_any_order(self):
+        self.assertEqual(
+            merge_busy([(8, 9), (1, 2), (7, 10), (2, 3), (4, 5)]),
+            [(1, 3), (4, 5), (7, 10)],
+        )
+
+    def test_chain_of_overlaps_merges_into_one(self):
+        self.assertEqual(merge_busy([(4, 5), (1, 3), (2, 4)]), [(1, 5)])
+
+    def test_input_is_not_modified(self):
+        intervals = [(3, 4), (1, 2)]
+        merge_busy(intervals)
+        self.assertEqual(intervals, [(3, 4), (1, 2)])
+
+    def test_works_with_datetimes(self):
+        def at(hour):
+            return datetime.datetime(2027, 3, 1, hour, tzinfo=datetime.timezone.utc)
+
+        self.assertEqual(
+            merge_busy([(at(13), at(14)), (at(9), at(10)), (at(10), at(11))]),
+            [(at(9), at(11)), (at(13), at(14))],
+        )
+
+    def test_rejects_interval_ending_before_it_starts(self):
+        with self.assertRaises(ValueError):
+            merge_busy([(5, 1)])
+
+
+if __name__ == "__main__":
+    unittest.main()
