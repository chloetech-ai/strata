+"""SMS reminders."""
+
+from kestrel.calendar import LOCAL_TZ
+from kestrel.models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the SMS sent two days before an appointment.
+
+    Privacy: the text carries only the local date, the time and the clinic
+    name. It never says what the appointment is for (no treatment, no kind).
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{local.strftime('%A')} {local.day} {local.strftime('%B')}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Friendly reminder: you have an appointment at {clinic} "
+        f"on {day} at {_clock(local)}. We look forward to seeing you!"
+    )
+
+
+def _clock(local):
+    """Twelve-hour time such as '2pm' or '2:30pm'."""
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    if local.minute == 0:
+        return f"{hour}{suffix}"
+    return f"{hour}:{local.minute:02d}{suffix}"
