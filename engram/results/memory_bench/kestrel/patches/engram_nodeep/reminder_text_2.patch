@@ -0,0 +1,49 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ASSESSMENT, FOLLOWUP
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_includes_clinic_name(self):
+        a = appt("A1", utc(2026, 10, 14, 4, 0), clinic="NG")
+        self.assertIn("Kestrel Physio Northgate", reminder_text(a))
+
+    def test_includes_local_date_and_time(self):
+        # 15 Oct 04:00 UTC is 15 Oct 17:00 in Auckland (NZDT, UTC+13): Thursday.
+        a = appt("A1", utc(2026, 10, 15, 4, 0), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Thursday 15 October", text)
+        self.assertIn("at 5pm", text)
+
+    def test_time_uses_local_clock_with_minutes(self):
+        # 14 Oct 01:30 UTC is 14 Oct 14:30 in Auckland.
+        a = appt("A1", utc(2026, 10, 14, 1, 30), clinic="HB")
+        self.assertIn("Wednesday 14 October at 2:30pm", reminder_text(a))
+
+    def test_morning_time_is_am(self):
+        # 14 Oct 21:00 UTC is 15 Oct 10:00 in Auckland.
+        a = appt("A1", utc(2026, 10, 14, 21, 0), clinic="WK")
+        self.assertIn("at 10am", reminder_text(a))
+
+    def test_midnight_hour_is_twelve(self):
+        # 14 Oct 11:05 UTC is 15 Oct 00:05 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 14, 11, 5), clinic="WK")
+        self.assertIn("at 12:05am", reminder_text(a))
+
+    def test_never_mentions_treatment_or_kind(self):
+        for kind in (ASSESSMENT, FOLLOWUP):
+            a = appt(
+                "A1", utc(2026, 10, 14, 4, 0), kind=kind,
+                treatment="lower back pain", clinic="HB",
+            )
+            text = reminder_text(a).lower()
+            self.assertNotIn("lower back", text)
+            self.assertNotIn("assessment", text)
+            self.assertNotIn("follow", text)
+            self.assertNotIn("pain", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
