+"""Exports for the accountants."""
+
+import csv
+import os
+
+# Exports leave the system, so they carry patient IDs only, never names.
+HEADER = ["Invoice number", "Clinic", "Patient ID", "Date", "Amount", "Description"]
+
+
+def _money(cents):
+    sign = "-" if cents < 0 else ""
+    return "%s%d.%02d" % (sign, abs(cents) // 100, abs(cents) % 100)
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year/month to a CSV file in out_dir and return its path."""
+    path = os.path.join(out_dir, "kestrel-invoices-%04d-%02d.csv" % (year, month))
+    os.makedirs(out_dir, exist_ok=True)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for inv in invoices:
+            if inv.issued.year != year or inv.issued.month != month:
+                continue
+            writer.writerow([
+                inv.number,
+                inv.clinic,
+                inv.patient_id,
+                inv.issued.strftime("%d/%m/%Y"),
+                _money(inv.amount_cents),
+                inv.description,
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
