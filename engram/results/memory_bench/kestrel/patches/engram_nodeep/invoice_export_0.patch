@@ -0,0 +1,76 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def inv(number, issued, amount_cents=7000, patient_id="KP-004211", description="Follow-up session"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.out = os.path.join(self.tmp.name, "out")
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_only_the_months_invoices_with_header(self):
+        invoices = [
+            inv("INV-HB-2026-00001", datetime.date(2026, 10, 1)),
+            inv("INV-HB-2026-00002", datetime.date(2026, 9, 30)),
+            inv("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            inv("INV-HB-2025-00001", datetime.date(2025, 10, 15)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out)
+        rows = self.read_rows(path)
+        self.assertEqual(rows[0][0], "Invoice number")
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00001", "INV-HB-2026-00003"])
+
+    def test_file_name_and_location(self):
+        path = export_invoices([], 2026, 3, self.out)
+        self.assertEqual(path, os.path.join(self.out, "kestrel-invoices-2026-03.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_row_format(self):
+        invoices = [inv("INV-HB-2026-00042", datetime.date(2026, 10, 5), amount_cents=5600,
+                        description="Follow-up session")]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out))
+        self.assertEqual(rows[1], ["INV-HB-2026-00042", "HB", "KP-004211", "05/10/2026",
+                                   "56.00", "Follow-up session"])
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        invoices = [
+            inv("INV-HB-2026-00001", datetime.date(2026, 10, 1), amount_cents=9500),
+            inv("INV-HB-2026-00002", datetime.date(2026, 10, 2), amount_cents=105),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out))
+        self.assertEqual([r[4] for r in rows[1:]], ["95.00", "1.05"])
+
+    def test_empty_month_writes_header_only(self):
+        rows = self.read_rows(export_invoices([], 2026, 10, self.out))
+        self.assertEqual(len(rows), 1)
+
+    def test_no_patient_names_in_output(self):
+        path = export_invoices([inv("INV-HB-2026-00001", datetime.date(2026, 10, 1))],
+                               2026, 10, self.out)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Test Patient", f.read())
+
+
+if __name__ == "__main__":
+    unittest.main()
