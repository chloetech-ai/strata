@@ -0,0 +1,36 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 14 Oct 21:30 UTC is 15 Oct 10:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 14, 21, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October", text)
+        self.assertIn("10:30am", text)
+
+    def test_afternoon_time_uses_pm(self):
+        a = appt("A1", utc(2026, 10, 15, 2, 15), clinic="NG")  # 15:15 Auckland
+        self.assertIn("3:15pm", reminder_text(a))
+
+    def test_contains_no_treatment_kind_or_patient_details(self):
+        a = appt(
+            "A1",
+            utc(2026, 10, 14, 21, 30),
+            patient="KP-004211",
+            kind=ASSESSMENT,
+            treatment="lower back pain",
+        )
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
