+"""SMS appointment reminders."""
+
+from kestrel.calendar import LOCAL_TZ
+from kestrel.models import CLINICS
+
+# Reminders are texted to patients, so they carry the date, the time and the
+# clinic name only: never the treatment, the appointment kind or the patient's
+# name or ID.
+
+
+def reminder_text(appointment):
+    local = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{local:%A} {local.day} {local:%B}"
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    time = f"{hour}:{local.minute:02d}{suffix}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora! This is a friendly reminder of your appointment at {clinic} "
+        f"on {day} at {time}. We look forward to seeing you."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
