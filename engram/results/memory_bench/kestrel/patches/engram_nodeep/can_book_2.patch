+"""Checks for the booking form."""
+
+import datetime
+
+from .models import ASSESSMENT, FOLLOWUP
+
+# How long each kind of appointment takes, in minutes.
+DURATION_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+
+
+def _span(appointment):
+    """The (start, end) datetimes an appointment occupies."""
+    end = appointment.start + datetime.timedelta(minutes=DURATION_MINUTES[appointment.kind])
+    return appointment.start, end
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment does not overlap a booked appointment for the therapist."""
+    new_start, new_end = _span(appointment)
+    for other in calendar.booked():
+        if other.therapist_id != therapist.id or other.id == appointment.id:
+            continue
+        other_start, other_end = _span(other)
+        if new_start < other_end and other_start < new_end:
+            return False
+    return True
