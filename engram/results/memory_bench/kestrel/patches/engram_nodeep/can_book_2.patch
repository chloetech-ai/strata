@@ -0,0 +1,45 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import CANCELLED, Therapist
+
+T1 = Therapist(id="T1", name="Ana", clinic="HB")
+T2 = Therapist(id="T2", name="Ben", clinic="HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_calendar(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20), kind="assessment")))
+
+    def test_overlapping_booked_appointment(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="followup")])  # 20:00-20:30
+        new = appt("new", utc(2027, 3, 1, 20, 15), kind="followup")
+        self.assertFalse(can_book(cal, T1, new))
+
+    def test_new_assessment_runs_into_existing(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20, 30), kind="followup")])  # 20:30-21:00
+        new = appt("new", utc(2027, 3, 1, 20), kind="assessment")  # 20:00-20:45
+        self.assertFalse(can_book(cal, T1, new))
+
+    def test_back_to_back_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind="followup")])  # ends 20:30
+        new = appt("new", utc(2027, 3, 1, 20, 30), kind="followup")
+        self.assertTrue(can_book(cal, T1, new))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status=CANCELLED)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_same_appointment_does_not_block_itself(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, T1, appt("a1", utc(2027, 3, 1, 20))))
+
+
+if __name__ == "__main__":
+    unittest.main()
