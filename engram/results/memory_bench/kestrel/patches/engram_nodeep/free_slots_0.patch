+"""Free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+
+DURATION = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Time the therapist keeps free after an assessment to write notes.
+GAP_AFTER = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}  # only Northgate opens
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a date, or None when closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None  # Sunday
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (sorted datetime.time) at which a new appointment of this kind
+    could be booked for the therapist on a local (Pacific/Auckland) date."""
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    open_at = datetime.datetime.combine(day, hours[0], tzinfo=LOCAL_TZ).astimezone(UTC)
+    close_at = datetime.datetime.combine(day, hours[1], tzinfo=LOCAL_TZ).astimezone(UTC)
+
+    # Each booked appointment blocks its own length plus any gap after it.
+    busy = []
+    for appointment in calendar.for_therapist(therapist.id):
+        if appointment.status != BOOKED:
+            continue
+        busy_start = appointment.start.astimezone(UTC)
+        busy.append((busy_start, busy_start + DURATION[appointment.kind] + GAP_AFTER[appointment.kind]))
+
+    new_length = DURATION[kind] + GAP_AFTER[kind]
+    slots = []
+    start = open_at
+    while start + DURATION[kind] <= close_at:
+        end = start + new_length
+        if all(end <= busy_start or busy_end <= start for busy_start, busy_end in busy):
+            slots.append(start.astimezone(LOCAL_TZ).time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
