+++ b/tests/test_slots.py
@@ -0,0 +1,96 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MONDAY = datetime.date(2027, 3, 1)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+T = datetime.time
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def setUp(self):
+        self.therapist = Therapist("T1", "Ana", "HB")
+
+    def test_weekday_empty_calendar_follow_up(self):
+        slots = free_slots(Calendar(), self.therapist, MONDAY, FOLLOWUP)
+        # Open 07:30-18:00 local; a 30-minute follow-up can start up to 17:30.
+        self.assertEqual(slots[0], T(7, 30))
+        self.assertEqual(slots[-1], T(17, 30))
+        self.assertEqual(len(slots), 41)  # 07:30, 07:45, ... 17:30
+        self.assertTrue(all(s.minute % 15 == 0 for s in slots))
+
+    def test_assessment_latest_start(self):
+        slots = free_slots(Calendar(), self.therapist, MONDAY, ASSESSMENT)
+        # A 45-minute assessment must end by 18:00, so the latest start is 17:15.
+        self.assertEqual(slots[-1], T(17, 15))
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), self.therapist, SUNDAY, FOLLOWUP), [])
+
+    def test_saturday_only_northgate_open(self):
+        self.assertEqual(free_slots(Calendar(), self.therapist, SATURDAY, FOLLOWUP), [])
+        northgate = Therapist("T2", "Ben", "NG")
+        slots = free_slots(Calendar(), northgate, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], T(8, 0))
+        self.assertEqual(slots[-1], T(11, 30))  # 30 minutes must end by 12:00
+
+    def test_booked_follow_up_blocks_overlapping_starts(self):
+        # Local 10:00 on Monday 1 March is 21:00 UTC on 28 February (UTC+13).
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, self.therapist, MONDAY, FOLLOWUP)
+        self.assertIn(T(9, 30), slots)  # ends exactly when the booking starts
+        self.assertNotIn(T(9, 45), slots)
+        self.assertNotIn(T(10, 0), slots)
+        self.assertIn(T(10, 30), slots)  # no gap after a follow-up
+
+    def test_gap_after_assessment(self):
+        # Assessment 10:00-10:45 local, then 15 minutes for notes: busy until 11:00.
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, self.therapist, MONDAY, FOLLOWUP)
+        self.assertNotIn(T(10, 45), slots)
+        self.assertNotIn(T(10, 30), slots)
+        self.assertIn(T(11, 0), slots)
+        self.assertIn(T(9, 30), slots)
+
+    def test_new_assessment_needs_its_own_gap_free(self):
+        # A new assessment at 09:00 runs to 09:45 plus 15 minutes of notes, ending at 10:00,
+        # which just fits before the 10:00 booking. Starting at 09:15 or 09:30 would overlap it.
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, self.therapist, MONDAY, ASSESSMENT)
+        self.assertNotIn(T(9, 15), slots)
+        self.assertNotIn(T(9, 30), slots)
+        self.assertIn(T(9, 0), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), kind=FOLLOWUP, therapist="T1", status=CANCELLED)])
+        self.assertIn(T(10, 0), free_slots(cal, self.therapist, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), kind=FOLLOWUP, therapist="T2")])
+        self.assertIn(T(10, 0), free_slots(cal, self.therapist, MONDAY, FOLLOWUP))
+
+    def test_dst_day_uses_local_times(self):
+        # Northgate, Saturday 3 April 2027 (still NZDT, UTC+13): booking at local 10:00 is 21:00 UTC on 2 April.
+        northgate = Therapist("T2", "Ben", "NG")
+        cal = Calendar([appt("a1", utc(2027, 4, 2, 21, 0), kind=FOLLOWUP, therapist="T2")])
+        slots = free_slots(cal, northgate, datetime.date(2027, 4, 3), FOLLOWUP)
+        self.assertEqual(slots[0], T(8, 0))
+        self.assertNotIn(T(10, 0), slots)
+        self.assertIn(T(10, 30), slots)
+
+    def test_returns_sorted_times(self):
+        slots = free_slots(Calendar(), self.therapist, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), self.therapist, MONDAY, "surgery")
+
+
+if __name__ == "__main__":
+    unittest.main()
