diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index e68d339..be8fb9c 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -60,5 +60,12 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now` (an aware datetime), soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        patient_id = normalize_patient_id(patient_id)
+        return [a for a in self.booked() if a.patient_id == patient_id and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index bb8b24a..123f246 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -45,6 +45,44 @@ class CalendarTest(unittest.TestCase):
         ])
         self.assertEqual([a.id for a in cal.for_day("T1", datetime.date(2027, 3, 2))], ["a1", "a2"])
 
+    def test_upcoming_soonest_first_for_one_patient(self):
+        cal = Calendar([
+            appt("a2", utc(2027, 3, 5, 3), patient="KP-000002"),  # other patient
+            appt("a3", utc(2027, 3, 4, 3), patient="KP-000001"),
+            appt("a1", utc(2027, 3, 2, 3), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 0))], ["a1", "a3"])
+
+    def test_upcoming_excludes_past_and_starting_now(self):
+        cal = Calendar([
+            appt("past", utc(2027, 3, 1, 0), patient="KP-000001"),
+            appt("now", utc(2027, 3, 1, 12), patient="KP-000001"),
+            appt("later", utc(2027, 3, 1, 13), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 12))], ["later"])
+
+    def test_upcoming_excludes_cancelled_and_other_statuses(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 2, 1), patient="KP-000001", status="cancelled"),
+            appt("a2", utc(2027, 3, 2, 2), patient="KP-000001", status="no_show"),
+            appt("a3", utc(2027, 3, 2, 3), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 1, 0))], ["a3"])
+
+    def test_upcoming_normalises_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp-4211 ", utc(2027, 3, 1, 0))], ["a1"])
+
+    def test_upcoming_bad_patient_id_raises(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-42x1", utc(2027, 3, 1, 0))
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 0))
+
     def test_cancel_sets_status_and_time(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
         cancelled = cal.cancel("a1", utc(2027, 2, 28, 9))
