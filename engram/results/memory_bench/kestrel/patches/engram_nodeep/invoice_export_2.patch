@@ -0,0 +1,87 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def inv(number, issued, amount_cents=7000, patient_id="KP-004211", description="Follow-up session"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self.tmp.name
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_returns_path_named_by_year_and_month(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_writes_header_then_rows(self):
+        invoices = [inv("INV-HB-2026-00001", datetime.date(2026, 10, 15), 9500, description="Initial assessment")]
+        rows = self.read(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual(rows[0], ["Invoice Number", "Date", "Clinic", "Patient ID", "Description", "Amount"])
+        self.assertEqual(rows[1], ["INV-HB-2026-00001", "15/10/2026", "HB", "KP-004211", "Initial assessment", "95.00"])
+
+    def test_amount_has_two_decimals_and_no_dollar_sign(self):
+        invoices = [inv("INV-HB-2026-00001", datetime.date(2026, 10, 1), 5600), inv("INV-HB-2026-00002", datetime.date(2026, 10, 2), 7005)]
+        rows = self.read(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[5] for r in rows[1:]], ["56.00", "70.05"])
+
+    def test_excludes_other_months_and_years(self):
+        invoices = [
+            inv("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            inv("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            inv("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            inv("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            inv("INV-HB-2025-00005", datetime.date(2025, 10, 15)),
+        ]
+        rows = self.read(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_empty_month_writes_header_only(self):
+        rows = self.read(export_invoices([], 2026, 10, self.out_dir))
+        self.assertEqual(len(rows), 1)
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            inv("INV-HB-2026-00003", datetime.date(2026, 10, 20)),
+            inv("INV-HB-2026-00002", datetime.date(2026, 10, 5)),
+            inv("INV-HB-2026-00001", datetime.date(2026, 10, 5)),
+        ]
+        rows = self.read(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_dates_are_day_first(self):
+        rows = self.read(export_invoices([inv("INV-HB-2026-00001", datetime.date(2026, 3, 4))], 2026, 3, self.out_dir))
+        self.assertEqual(rows[1][1], "04/03/2026")
+
+    def test_no_patient_names_in_file(self):
+        path = export_invoices([inv("INV-HB-2026-00001", datetime.date(2026, 10, 1))], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertIn("KP-004211", text)
+        self.assertNotIn("Test Patient", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
