+"""Exports that leave the system (to the accountants)."""
+
+import csv
+import decimal
+import os
+
+HEADER = ["Invoice Number", "Date", "Clinic", "Patient ID", "Description", "Amount"]
+
+
+def _amount(cents):
+    """Return cents as a plain number with two decimals, e.g. 7000 -> "70.00"."""
+    return f"{decimal.Decimal(cents) / 100:.2f}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the month's invoices to a CSV file in out_dir and return its path.
+
+    Only invoices issued in the given year and month are included. The file
+    carries patient IDs only, never patient names.
+    """
+    month_invoices = sorted(
+        (inv for inv in invoices if inv.issued.year == year and inv.issued.month == month),
+        key=lambda inv: (inv.issued, inv.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for inv in month_invoices:
+            writer.writerow([
+                inv.number,
+                inv.issued.strftime("%d/%m/%Y"),
+                inv.clinic,
+                inv.patient_id,
+                inv.description,
+                _amount(inv.amount_cents),
+            ])
+    return path
