@@ -0,0 +1,33 @@
+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_pair(self):
+        self.assertEqual(merge_busy([(1, 2)]), [(1, 2)])
+
+    def test_disjoint_pairs_are_sorted(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 2), (2, 3)]), [(1, 3)])
+
+    def test_contained_pair_is_absorbed(self):
+        self.assertEqual(merge_busy([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_any_order(self):
+        self.assertEqual(merge_busy([(7, 9), (1, 3), (2, 5), (8, 8)]), [(1, 5), (7, 9)])
+
+    def test_chain_merges_into_one(self):
+        self.assertEqual(merge_busy([(4, 5), (1, 2), (2, 4)]), [(1, 5)])
+
+
+if __name__ == "__main__":
+    unittest.main()
