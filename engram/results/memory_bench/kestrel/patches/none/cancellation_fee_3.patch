index 0000000..caaa372
--- /dev/null
+++ b/src/kestrel/fees.py
@@ -0,0 +1,29 @@
+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation made with less notice than this is charged the full session price.
+NOTICE = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for a cancelled or no-show appointment.
+
+    A no-show is charged the full session price; cancelled_at is None for it.
+    A cancellation made less than NOTICE before the start (or after it) is charged
+    the full session price; one made earlier is free.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no fee for appointment {appointment.id} with status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError(f"cancelled appointment {appointment.id} needs cancelled_at")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < NOTICE:
+        return session_price(appointment.kind)
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..fa5fb4a
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ATTENDED, BOOKED
+
+from helpers import appt, utc
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_with_a_day_or_more_notice_is_free(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled", cancelled_at=utc(2027, 2, 28, 20))
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 28, 20)), 0)
+
+    def test_cancelled_with_less_than_a_day_notice_costs_the_followup_price(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled", cancelled_at=utc(2027, 2, 28, 21))
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 28, 21)), 7000)
+
+    def test_cancelled_less_than_a_day_out_costs_the_assessment_price(self):
+        a = appt("a1", utc(2027, 3, 1, 20), kind="assessment", status="cancelled", cancelled_at=utc(2027, 3, 1, 8))
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 8)), 9500)
+
+    def test_cancelled_after_the_start_costs_the_full_price(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled", cancelled_at=utc(2027, 3, 1, 21))
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 21)), 7000)
+
+    def test_no_show_costs_the_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", utc(2027, 3, 1, 20), kind="assessment", status="no_show")), 9500)
+        self.assertEqual(cancellation_fee(appt("a2", utc(2027, 3, 1, 20), status="no_show")), 7000)
+
+    def test_cancelled_requires_cancelled_at(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled", cancelled_at=utc(2027, 2, 28, 9))
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_cancelled_at_must_be_timezone_aware(self):
+        a =appt("a1", utc(2027, 3, 1, 20), status="cancelled", cancelled_at=utc(2027, 2, 28, 9))
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 2, 28, 9))
+
+    def test_rejects_appointments_that_are_not_cancelled_or_no_show(self):
+        for status in (BOOKED, ATTENDED):
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", utc(2027, 3, 1, 20), status=status))
+
+
+if __name__ == "__main__":
+    unittest.main()
