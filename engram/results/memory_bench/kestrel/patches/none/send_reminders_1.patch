+import unittest
+
+from kestrel.models import CANCELLED, Patient
+from kestrel.reminders import send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class RecordingTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Ada", "+64211111111"),
+    "KP-000002": Patient("KP-000002", "Ben", "+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_text_per_booked_appointment(self):
+        transport = RecordingTransport()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 1, 30), patient="KP-000001", clinic="HB"),
+            appt("A2", utc(2026, 10, 21, 1, 30), patient="KP-000002", clinic="HB"),
+        ]
+        sent = send_reminders(appointments, PATIENTS, BulkieClient("key", transport))
+        self.assertEqual(sent, 2)
+        messages = [m for _, body in transport.calls for m in body["messages"]]
+        self.assertEqual([m["to"] for m in messages], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        transport = RecordingTransport()
+        cancelled = appt("A1", utc(2026, 10, 20, 1, 30), patient="KP-000001")
+        cancelled.status = CANCELLED
+        sent = send_reminders([cancelled], PATIENTS, BulkieClient("key", transport))
+        self.assertEqual(sent, 0)
+        self.assertEqual(transport.calls, [])
+
+    def test_text_gives_the_local_time_and_clinic(self):
+        transport = RecordingTransport()
+        # 01:30 UTC on 20 Oct 2026 is 14:30 in Auckland (NZDT, UTC+13).
+        send_reminders([appt("A1", utc(2026, 10, 20, 1, 30), patient="KP-000001", clinic="HB")],
+                       PATIENTS, BulkieClient("key", transport))
+        text = transport.calls[0][1]["messages"][0]["text"]
+        self.assertIn("14:30", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+
+    def test_missing_patient_raises_before_anything_is_sent(self):
+        transport = RecordingTransport()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 1, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 1, 30), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, BulkieClient("key", transport))
+        self.assertEqual(transport.calls, [])
+
+    def test_large_run_is_split_by_the_client(self):
+        transport = RecordingTransport()
+        patients = {f"KP-{i:06d}": Patient(f"KP-{i:06d}", "P", f"+6421{i:07d}") for i in range(1, 61)}
+        appointments = [appt(f"A{i}", utc(2026, 10, 20, 1, 30), patient=pid) for i, pid in enumerate(patients, 1)]
+        sent = send_reminders(appointments, patients, BulkieClient("key", transport))
+        self.assertEqual(sent, 60)
+        self.assertEqual([len(body["messages"]) for _, body in transport.calls], [50, 10])
+
+
+if __name__ == "__main__":
+    unittest.main()
