+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return f"{clinic}: reminder of your appointment on {local:%a %d %b} at {local:%H:%M}. Reply to this message if you need to change it."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment. Returns the number of messages sent.
+
+    patients maps patient ID to Patient. Every booked appointment's patient must
+    be in it; if one is missing, nothing is sent.
+    """
+    booked = [a for a in appointments if a.status == BOOKED]
+    messages = []
+    for appointment in booked:
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
