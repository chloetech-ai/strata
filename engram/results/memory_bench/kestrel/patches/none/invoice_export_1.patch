+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, clinic="HB", patient_name="Aroha Ngata", description="Physiotherapy assessment"):
+    return Invoice(
+        number=number, clinic=clinic, patient_id="KP-004211", patient_name=patient_name,
+        issued=issued, amount_cents=amount_cents, description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([], 2026, 10, self.dir.name)
+        self.assertEqual(path, os.path.join(self.dir.name, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_only_when_no_invoices_in_month(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 9, 30))], 2026, 10, self.dir.name)
+        self.assertEqual(self.read_rows(path), [[
+            "invoice_number", "clinic", "patient_id", "patient_name", "issued", "description", "amount",
+        ]])
+
+    def test_row_contents_and_amount_in_dollars(self):
+        path = export_invoices(
+            [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15), 9500, "HB", "Aroha Ngata", "Physiotherapy assessment: lower back pain")],
+            2026, 10, self.dir.name,
+        )
+        self.assertEqual(self.read_rows(path)[1], [
+            "INV-HB-2026-00001", "HB", "KP-004211", "Aroha Ngata", "2026-10-15",
+            "Physiotherapy assessment: lower back pain", "95.00",
+        ])
+
+    def test_amount_keeps_two_decimal_places(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 10, 1), 7005)], 2026, 10, self.dir.name)
+        self.assertEqual(self.read_rows(path)[1][-1], "70.05")
+
+    def test_only_includes_invoices_issued_in_that_month(self):
+        invoices = [
+            invoice("N-SEP", datetime.date(2026, 9, 30)),
+            invoice("N-OCT", datetime.date(2026, 10, 1)),
+            invoice("N-OCT-END", datetime.date(2026, 10, 31)),
+            invoice("N-NOV", datetime.date(2026, 11, 1)),
+            invoice("N-OLD", datetime.date(2025, 10, 15)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.dir.name)
+        numbers = [row[0] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["N-OCT", "N-OCT-END"])
+
+    def test_rows_sorted_by_issue_date_then_number(self):
+        invoices = [
+            invoice("N3", datetime.date(2026, 10, 20)),
+            invoice("N2", datetime.date(2026, 10, 5)),
+            invoice("N1", datetime.date(2026, 10, 20)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.dir.name)
+        numbers = [row[0] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["N2", "N1", "N3"])
+
+    def test_names_with_commas_and_non_ascii_are_quoted_correctly(self):
+        path = export_invoices(
+            [invoice("N1", datetime.date(2026, 10, 2), patient_name="Ngata, Aroha Māhina")],
+            2026, 10, self.dir.name,
+        )
+        self.assertEqual(self.read_rows(path)[1][3], "Ngata, Aroha Māhina")
+
+    def test_rejects_invalid_month(self):
+        with self.assertRaises(ValueError):
+            export_invoices([], 2026, 13, self.dir.name)
+
+
+if __name__ == "__main__":
+    unittest.main()
