+"""Monthly export of invoices for the accountant."""
+
+import csv
+import datetime
+import os
+
+COLUMNS = ["invoice_number", "clinic", "patient_id", "patient_name", "issued", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to a CSV file in out_dir and return its path.
+
+    An invoice belongs to the month of its issued (Auckland local) date. Rows are
+    sorted by issue date, then invoice number. Amounts are written in dollars with
+    two decimal places. The file is named kestrel-invoices-YYYY-MM.csv.
+    """
+    datetime.date(year, month, 1)  # raises ValueError for a month outside 1-12
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for invoice in chosen:
+            dollars, cents = divmod(invoice.amount_cents, 100)
+            writer.writerow([
+                invoice.number,
+                invoice.clinic,
+                invoice.patient_id,
+                invoice.patient_name,
+                invoice.issued.isoformat(),
+                invoice.description,
+                f"{dollars}.{cents:02d}",
+            ])
+    return path
