index 0000000..894467e
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,15 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"(?:(?P<hours>\d+)h(?:\s*(?P<h_minutes>\d+)m?)?)|(?P<minutes>\d+)m"
+)
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration such as '45m', '1h', '1h30' or '1h 30m'."""
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    if match.group("minutes") is not None:
+        return int(match.group("minutes"))
+    return int(match.group("hours")) * 60 + int(match.group("h_minutes") or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
