+    def test_upcoming_soonest_first_after_now(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("late", utc(2027, 3, 3, 9)),
+            appt("soon", utc(2027, 3, 1, 14)),
+            appt("past", utc(2027, 3, 1, 10)),
+            appt("at_now", utc(2027, 3, 1, 12)),
+            appt("other", utc(2027, 3, 2, 9), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "late"])
+
+    def test_upcoming_excludes_cancelled(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 2, 9)),
+            appt("a2", utc(2027, 3, 3, 9), status="cancelled"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["a1"])
+
+    def test_upcoming_accepts_messy_patient_id(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp4211 ", now)], ["a1"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 12))
+
 
