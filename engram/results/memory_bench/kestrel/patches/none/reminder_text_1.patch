+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def _clock(moment):
+    """A local time in the style "2:30pm" or "9am"."""
+    hour = moment.hour % 12 or 12
+    suffix = "am" if moment.hour < 12 else "pm"
+    if moment.minute:
+        return f"{hour}:{moment.minute:02d}{suffix}"
+    return f"{hour}{suffix}"
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment, with the time in clinic (Auckland) local time."""
+    local = appointment.start.astimezone(CLINIC_TZ)
+    when = f"{local:%A} {local.day} {local:%B} at {_clock(local)}"
+    clinic = CLINICS[appointment.clinic].name
+    visit = f"physio for {appointment.treatment}" if appointment.treatment else "physio appointment"
+    return f"Hi! Reminder of your {visit} at {clinic} on {when}. To change it, please contact the clinic. See you then!"
