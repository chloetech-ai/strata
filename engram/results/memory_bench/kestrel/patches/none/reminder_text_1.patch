@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_day_date_and_time_in_local_time(self):
+        # 01:30 UTC on 20 Oct 2026 is 2:30pm in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 1, 30), clinic="HB"))
+        self.assertEqual(
+            text,
+            "Hi! Reminder of your physio appointment at Kestrel Physio Harbour on Tuesday 20 October at 2:30pm. "
+            "To change it, please contact the clinic. See you then!",
+        )
+
+    def test_uses_treatment_when_given(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 1, 30), clinic="NG", treatment="lower back pain"))
+        self.assertIn("Reminder of your physio for lower back pain at Kestrel Physio Northgate on Tuesday 20 October", text)
+
+    def test_date_is_local_not_utc(self):
+        # 12:00 UTC on 19 Oct is already 1:00am on 20 Oct in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 19, 12, 0)))
+        self.assertIn("on Tuesday 20 October at 1am.", text)
+
+    def test_whole_hour_has_no_minutes_and_morning_uses_am(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 21, 0)))  # 10:00am NZDT
+        self.assertIn("at 10am.", text)
+
+    def test_midday_and_midnight_twelve_hour_clock(self):
+        noon = reminder_text(appt("A1", utc(2026, 10, 20, 23, 0)))  # 12:00pm NZDT
+        self.assertIn("at 12pm.", noon)
+        midnight = reminder_text(appt("A2", utc(2026, 10, 20, 11, 0)))  # 12:00am NZDT
+        self.assertIn("at 12am.", midnight)
+
+    def test_offset_start_time_is_converted(self):
+        start = datetime.datetime(2026, 10, 20, 9, 15, tzinfo=datetime.timezone(datetime.timedelta(hours=-5)))
+        text = reminder_text(appt("A1", start))  # 14:15 UTC, 3:15am on 21 Oct NZDT
+        self.assertIn("on Wednesday 21 October at 3:15am.", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
