+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def send_reminders(appointments, patients, client):
+    """Text each patient a reminder for every booked appointment.
+
+    patients maps patient ID to Patient. Only booked appointments get a reminder;
+    cancelled, attended and no-show ones are skipped. Every message is built before
+    anything is sent, so a missing patient raises KeyError without sending any.
+    Returns the number of messages sent.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        local = appointment.start.astimezone(CLINIC_TZ)
+        text = (
+            f"{CLINICS[appointment.clinic].name}: reminder of your physiotherapy "
+            f"appointment on {local:%a %d %b} at {local:%H:%M}. "
+            "Please call the clinic if you need to change it."
+        )
+        messages.append((patient.phone, text))
+    if messages:
+        client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
