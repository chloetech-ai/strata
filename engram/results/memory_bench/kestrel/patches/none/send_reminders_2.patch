--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,90 @@
+import datetime
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class RecordingClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        self.batches.append(list(messages))
+        return [{"ok": True}]
+
+
+PATIENTS = {
+    "KP-000001": Patient(id="KP-000001", name="Ana", phone="+64211111111"),
+    "KP-000002": Patient(id="KP-000002", name="Ben", phone="+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_one_message_per_booked_appointment_to_the_patient(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 21, 2), patient="KP-000002"),
+            appt("a3", utc(2026, 10, 22, 2), patient="KP-000001"),
+        ]
+        client = RecordingClient()
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 3)
+        (batch,) = client.batches
+        self.assertEqual([phone for phone, _ in batch], ["+64211111111", "+64222222222", "+64211111111"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001", status=CANCELLED),
+            appt("a2", utc(2026, 10, 20, 3), patient="KP-000001", status=ATTENDED),
+            appt("a3", utc(2026, 10, 20, 4), patient="KP-000002", status=NO_SHOW),
+            appt("a4", utc(2026, 10, 20, 5), patient="KP-000002"),
+        ]
+        client = RecordingClient()
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 1)
+        (batch,) = client.batches
+        self.assertEqual([phone for phone, _ in batch], ["+64222222222"])
+
+    def test_text_gives_the_local_date_and_time(self):
+        # 2026-10-20 02:30 UTC is 15:30 on 20 Oct in Auckland (NZDT, UTC+13).
+        client = RecordingClient()
+        send_reminders([appt("a1", utc(2026, 10, 20, 2, 30), patient="KP-000001", clinic="HB")], PATIENTS, client)
+        (_, text), = client.batches[0]
+        self.assertIn("Tue 20 Oct at 15:30", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+
+    def test_nothing_to_send_makes_no_call(self):
+        client = RecordingClient()
+        self.assertEqual(send_reminders([], PATIENTS, client), 0)
+        self.assertEqual(client.batches, [])
+
+    def test_unknown_patient_raises_before_anything_is_sent(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 21, 2), patient="KP-009999"),
+        ]
+        client = RecordingClient()
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, client)
+        self.assertEqual(client.batches, [])
+
+    def test_works_with_the_bulkie_client(self):
+        class Transport:
+            def __init__(self):
+                self.calls = []
+
+            def post(self, path, body):
+                self.calls.append(body)
+                return {"ok": True}
+
+        transport = Transport()
+        start = utc(2026, 10, 20)
+        appointments = [appt(f"a{i}", start + datetime.timedelta(hours=i), patient="KP-000001") for i in range(51)]
+        self.assertEqual(send_reminders(appointments, PATIENTS, BulkieClient("key", transport)), 51)
+        self.assertEqual([len(body["messages"]) for body in transport.calls], [50, 1])
+
+
+if __name__ == "__main__":
+    unittest.main()
