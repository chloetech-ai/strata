+"""Checks run before an appointment is saved."""
+
+from .models import BOOKED
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist.
+
+    The therapist must be the one the appointment is for, and they must not
+    already have a booked appointment starting at the same time. Appointments
+    with the same id as this one are ignored, so re-checking an existing
+    appointment does not conflict with itself.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    for existing in calendar.for_therapist(therapist.id):
+        if existing.id == appointment.id or existing.status != BOOKED:
+            continue
+        if existing.start == appointment.start:
+            return False
+    return True
