+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), "T1", appt("new", utc(2027, 3, 1, 20))))
+
+    def test_same_therapist_same_start_is_a_conflict(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 20))))
+
+    def test_same_instant_in_another_timezone_is_a_conflict(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        nz = datetime.timezone(datetime.timedelta(hours=13))
+        new = appt("new", datetime.datetime(2027, 3, 2, 9, 0, tzinfo=nz))  # 20:00 UTC on the 1st
+        self.assertFalse(can_book(cal, "T1", new))
+
+    def test_different_therapist_same_start_is_fine(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 20))))
+
+    def test_different_start_is_fine(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 21))))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status="cancelled")])
+        self.assertTrue(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 20))))
+
+    def test_attended_and_no_show_still_block(self):
+        for status in ("attended", "no_show"):
+            with self.subTest(status=status):
+                cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status=status)])
+                self.assertFalse(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 20))))
+
+    def test_appointment_for_another_therapist_is_rejected(self):
+        cal = Calendar()
+        self.assertFalse(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 20), therapist="T2")))
+
+
+if __name__ == "__main__":
+    unittest.main()
