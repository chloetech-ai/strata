+"""Checks run before an appointment is saved."""
+
+from .models import CANCELLED
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist`.
+
+    A therapist can only have one appointment starting at a given instant.
+    Cancelled appointments don't hold their slot. The appointment must also
+    belong to the therapist.
+    """
+    if appointment.therapist_id != therapist:
+        return False
+    return not any(
+        a.start == appointment.start and a.status != CANCELLED
+        for a in calendar.for_therapist(therapist)
+    )
