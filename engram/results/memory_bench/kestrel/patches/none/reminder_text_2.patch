+import datetime
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import UTC, appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_and_local_date_and_time(self):
+        # 2026-10-15 01:30 UTC is 14:30 in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("A1", utc(2026, 10, 15, 1, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October at 2:30pm", text)
+
+    def test_uses_local_date_not_utc_date(self):
+        # 2026-10-15 11:30 UTC is 00:30 on 16 October in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 15, 11, 30), clinic="NG"))
+        self.assertIn("Friday 16 October at 12:30am", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_whole_hour_has_no_minutes(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 15, 3), clinic="WK"))
+        self.assertIn("at 4pm", text)
+
+    def test_noon_and_midnight_are_twelve(self):
+        noon = reminder_text(appt("A1", utc(2026, 10, 15, 23), clinic="WK"))  # 12:00 Auckland, 16 Oct
+        self.assertIn("at 12pm", noon)
+        midnight = reminder_text(appt("A2", utc(2026, 10, 15, 11), clinic="WK"))  # 00:00 Auckland
+        self.assertIn("at 12am", midnight)
+
+    def test_accepts_non_utc_aware_start(self):
+        start = datetime.datetime(2026, 10, 15, 9, 15, tzinfo=datetime.timezone(datetime.timedelta(hours=10)))
+        text = reminder_text(appt("A1", start, clinic="HB"))
+        self.assertIn("Thursday 15 October at 12:15pm", text)
+
+    def test_day_is_not_zero_padded(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 4, 1), clinic="HB"))  # 14:00 on 4 October
+        self.assertIn("Sunday 4 October at 2pm", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
