+"""Text for the SMS reminder sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for an appointment, shown in the clinic's local (Auckland) time."""
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    minute = f":{local.minute:02d}" if local.minute else ""
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}{minute}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi, this is a friendly reminder from {clinic}. "
+        f"You have an appointment on {when}. "
+        "If you need to change or cancel, please contact the clinic. See you then!"
+    )
