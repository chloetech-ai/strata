+"""Monthly export of invoices for the accountant."""
+
+import csv
+import datetime
+import os
+
+COLUMNS = ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to a CSV file and return its path.
+
+    An invoice belongs to the month of its local (Auckland) issue date. Rows are
+    sorted by issue date, then invoice number. Amounts are written in dollars,
+    e.g. 95.00. The file is named invoices-YYYY-MM.csv inside out_dir, and an
+    existing file for that month is replaced. Raises ValueError for a month
+    that does not exist.
+    """
+    first = datetime.date(year, month, 1)
+    month_invoices = [i for i in invoices if i.issued.year == first.year and i.issued.month == first.month]
+    month_invoices.sort(key=lambda i: (i.issued, i.number))
+
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for invoice in month_invoices:
+            writer.writerow([
+                invoice.number,
+                invoice.issued.isoformat(),
+                invoice.clinic,
+                invoice.patient_id,
+                invoice.patient_name,
+                invoice.description,
+                _dollars(invoice.amount_cents),
+            ])
+    return path
+
+
+def _dollars(cents):
+    return f"{cents // 100}.{cents % 100:02d}"
