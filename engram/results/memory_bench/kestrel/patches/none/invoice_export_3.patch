@@ -0,0 +1,96 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=7000, description="Physiotherapy follow-up", patient_name="Aroha Ngata"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id="KP-004211",
+        patient_name=patient_name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self.tmp.name
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2026-10.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_writes_header_and_one_row_per_invoice(self):
+        path = export_invoices(
+            [invoice("N1", datetime.date(2026, 10, 3), amount_cents=9500, description="Physiotherapy assessment")],
+            2026, 10, self.out_dir,
+        )
+        self.assertEqual(self.read_rows(path), [
+            ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"],
+            ["N1", "2026-10-03", "HB", "KP-004211", "Aroha Ngata", "Physiotherapy assessment", "95.00"],
+        ])
+
+    def test_only_includes_invoices_issued_in_the_month(self):
+        invoices = [
+            invoice("N-SEP", datetime.date(2026, 9, 30)),
+            invoice("N-OCT", datetime.date(2026, 10, 1)),
+            invoice("N-OCT-END", datetime.date(2026, 10, 31)),
+            invoice("N-NOV", datetime.date(2026, 11, 1)),
+            invoice("N-OLD", datetime.date(2025, 10, 15)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([row[0] for row in rows[1:]], ["N-OCT", "N-OCT-END"])
+
+    def test_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("N3", datetime.date(2026, 10, 9)),
+            invoice("N2", datetime.date(2026, 10, 2)),
+            invoice("N1", datetime.date(2026, 10, 9)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([row[0] for row in rows[1:]], ["N2", "N1", "N3"])
+
+    def test_quotes_fields_containing_commas(self):
+        path = export_invoices(
+            [invoice("N1", datetime.date(2026, 10, 3), patient_name="Ngata, Aroha")], 2026, 10, self.out_dir
+        )
+        self.assertEqual(self.read_rows(path)[1][4], "Ngata, Aroha")
+
+    def test_amount_has_two_decimal_places(self):
+        invoices = [invoice("N1", datetime.date(2026, 10, 3), amount_cents=7005)]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual(rows[1][6], "70.05")
+
+    def test_month_with_no_invoices_has_only_header(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 9, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(len(self.read_rows(path)), 1)
+
+    def test_replaces_existing_file_for_the_month(self):
+        export_invoices([invoice("OLD", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        path = export_invoices([invoice("NEW", datetime.date(2026, 10, 4))], 2026, 10, self.out_dir)
+        self.assertEqual([row[0] for row in self.read_rows(path)[1:]], ["NEW"])
+
+    def test_rejects_invalid_month(self):
+        with self.assertRaises(ValueError):
+            export_invoices([], 2026, 13, self.out_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
