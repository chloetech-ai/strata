+from kestrel.invoices import make_invoice, next_invoice_number
 from kestrel.models import Appointment, Patient
 
 from helpers import UTC, appt, utc
 
 
+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_starts_at_one_when_none_issued(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_continues_from_highest_number(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00007", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_ignores_other_clinics_and_years(self):
+        existing = ["INV-WN-2026-00009", "INV-HB-2025-00012", "INV-HB-2027-00020"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_ignores_numbers_that_do_not_match_the_format(self):
+        existing = ["INV-HB-2026-", "INV-HB-2026-00002A", "INV-HB-2026-00004", "XINV-HB-2026-00050"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00005")
+
+    def test_accepts_any_iterable(self):
+        existing = (number for number in ["INV-HB-2026-00002"])
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+
+
