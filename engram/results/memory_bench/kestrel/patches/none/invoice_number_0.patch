+def next_invoice_number(clinic, year, existing):
+    """Return the number for the next invoice for a clinic in a year.
+
+    Numbers look like 'INV-HB-2026-00001'. The sequence continues from the
+    highest number already issued for that clinic and year, and starts at 1
+    when there is none. Numbers for other clinics or years are ignored, as are
+    any that do not match the format.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        sequence = number[len(prefix):] if number.startswith(prefix) else ""
+        if _SEQUENCE.fullmatch(sequence):
+            highest = max(highest, int(sequence))
+    return f"{prefix}{highest + 1:05d}"
+
