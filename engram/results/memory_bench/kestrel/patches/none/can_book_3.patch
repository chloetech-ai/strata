+"""Checks run before an appointment is saved."""
+
+from .models import BOOKED
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added: the therapist has no booked appointment at the same start time.
+
+    Appointments have no duration yet, so only an exact start-time clash is detected.
+    """
+    for existing in calendar.for_therapist(therapist.id):
+        if existing.status == BOOKED and existing.start == appointment.start:
+            return False
+    return True
