+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import CANCELLED, Therapist
+
+T1 = Therapist("T1", "Ana", "HB")
+T2 = Therapist("T2", "Ben", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 21), therapist="T1")))
+
+    def test_same_start_clashes(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_other_therapist_does_not_clash(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_cancelled_does_not_clash(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1", status=CANCELLED)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_same_instant_in_different_zone_clashes(self):
+        nz = datetime.timezone(datetime.timedelta(hours=13))
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 7), therapist="T1")])
+        new = appt("new", datetime.datetime(2027, 3, 1, 20, tzinfo=nz), therapist="T1")
+        self.assertFalse(can_book(cal, T1, new))
+
+
+if __name__ == "__main__":
+    unittest.main()
