@@ -0,0 +1,62 @@
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, Patient
+from kestrel.reminders import send_reminders
+
+from helpers import appt, utc
+
+
+class FakeClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        self.batches.append(list(messages))
+        return [{"ok": True}]
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Aroha", "+64211111111"),
+    "KP-000002": Patient("KP-000002", "Ben", "+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_one_message_per_booked_appointment(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 20, 3), patient="KP-000002"),
+        ]
+        client = FakeClient()
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 2)
+        self.assertEqual(len(client.batches), 1)
+        self.assertEqual([to for to, _ in client.batches[0]], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 20, 3), patient="KP-000002", status=CANCELLED),
+            appt("a3", utc(2026, 10, 20, 4), patient="KP-000002", status=ATTENDED),
+        ]
+        client = FakeClient()
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 1)
+        self.assertEqual([to for to, _ in client.batches[0]], ["+64211111111"])
+
+    def test_no_booked_appointments_sends_nothing(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([], PATIENTS, client), 0)
+        self.assertEqual(client.batches, [])
+
+    def test_text_names_patient_clinic_and_local_time(self):
+        # 02:00 UTC on 20 Oct is 15:00 in Auckland (NZDT, UTC+13).
+        appointments = [appt("a1", utc(2026, 10, 20, 2), patient="KP-000001", clinic="HB")]
+        client = FakeClient()
+        send_reminders(appointments, PATIENTS, client)
+        _, text = client.batches[0][0]
+        self.assertIn("Aroha", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tue 20 Oct at 15:00", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
