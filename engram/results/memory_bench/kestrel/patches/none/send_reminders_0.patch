+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of every booked appointment.
+
+    patients maps patient ID to Patient. Appointments that are not booked are
+    skipped. Returns the number of messages sent.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, _reminder_text(patient, appointment)))
+    if not messages:
+        return 0
+    client.send_batch(messages)
+    return len(messages)
+
+
+def _reminder_text(patient, appointment):
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi {patient.name}, this is a reminder of your physiotherapy appointment "
+        f"at {clinic} on {local:%a %d %b} at {local:%H:%M}. See you then."
+    )
