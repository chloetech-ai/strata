+"""Appointment reminder texts."""
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CLINICS, FOLLOWUP
+
+_KIND_NAMES = {
+    ASSESSMENT: "physiotherapy assessment",
+    FOLLOWUP: "physiotherapy follow-up",
+}
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Names the clinic and gives the kind of appointment and its local (Auckland)
+    day and time. The patient's name and the treatment are left out of the text.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    when = f"{local:%A} {local.day} {local:%B} at {_clock(local)}"
+    return (
+        f"Kind reminder from {clinic}: you have a {_KIND_NAMES[appointment.kind]} "
+        f"on {when}. We look forward to seeing you! "
+        "If you need to change or cancel, please call the clinic to reschedule."
+    )
+
+
+def _clock(local):
+    """Twelve-hour time such as '9:30am'."""
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    return f"{hour}:{local.minute:02d}{suffix}"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
