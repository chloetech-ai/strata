+"""Checks run before an appointment is saved."""
+
+from .models import BOOKED
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist.
+
+    therapist is the therapist's id. A booking clashes with another booked
+    appointment for the same therapist that starts at the same time. The
+    appointment being checked is ignored, so re-checking an existing booking
+    does not clash with itself.
+    """
+    for other in calendar.for_therapist(therapist):
+        if other.id == appointment.id or other.status != BOOKED:
+            continue
+        if other.start == appointment.start:
+            return False
+    return True
