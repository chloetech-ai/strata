@@ -0,0 +1,40 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 21))))
+
+    def test_same_start_same_therapist_clashes(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        self.assertFalse(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 20), therapist="T1")))
+
+    def test_other_therapist_does_not_clash(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T1")])
+        self.assertTrue(can_book(cal, "T2", appt("new", utc(2027, 3, 1, 20), therapist="T2")))
+
+    def test_cancelled_appointment_does_not_clash(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status="cancelled")])
+        self.assertTrue(can_book(cal, "T1", appt("new", utc(2027, 3, 1, 20))))
+
+    def test_checking_existing_appointment_does_not_clash_with_itself(self):
+        existing = appt("a1", utc(2027, 3, 1, 20))
+        cal = Calendar([existing])
+        self.assertTrue(can_book(cal, "T1", existing))
+
+    def test_same_instant_in_different_timezones_clashes(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        # 20:00 UTC is 09:00 on the 2nd in Auckland (NZDT).
+        nz = datetime.timezone(datetime.timedelta(hours=13))
+        new = appt("new", datetime.datetime(2027, 3, 2, 9, 0, tzinfo=nz))
+        self.assertFalse(can_book(cal, "T1", new))
+
+
+if __name__ == "__main__":
+    unittest.main()
