@@ -0,0 +1,86 @@
+import datetime
+import unittest
+from datetime import date
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import DAY_END, DAY_START, free_slots
+
+THERAPIST = Therapist(id="T1", name="Hana Tui", clinic="HB")
+DAY = date(2026, 10, 15)
+
+
+def local(hh, mm=0, day=DAY):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_offers_every_grid_start_that_fits(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(slots[0], DAY_START)
+        self.assertEqual(slots[-1], t(16, 30))  # a 30-minute follow-up must finish by 17:00
+        self.assertEqual(len(slots), 39)  # 07:00 to 16:30 in 15-minute steps
+        self.assertEqual(slots, sorted(slots))
+
+    def test_assessment_is_longer_so_fewer_starts(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(16, 0))  # a 60-minute assessment must finish by 17:00
+        self.assertNotIn(t(16, 15), slots)
+
+    def test_returns_naive_local_times(self):
+        for slot in free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP):
+            self.assertIsInstance(slot, datetime.time)
+            self.assertIsNone(slot.tzinfo)
+
+    def test_booked_appointment_blocks_overlapping_starts(self):
+        # A 30-minute follow-up at 10:00 local blocks 09:45, 10:00 and 10:15 for another follow-up.
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind="followup")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(t(10, 0), slots)
+        self.assertIn(t(9, 30), slots)  # ends exactly when the booking starts
+        self.assertIn(t(10, 30), slots)  # starts exactly when the booking ends
+        self.assertNotIn(t(10, 15), slots)
+
+    def test_assessment_blocked_by_followup_it_would_overlap(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind="followup")])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertNotIn(t(9, 45), slots)  # 09:45-10:45 overlaps the 10:00-10:30 follow-up
+        self.assertIn(t(9, 0), slots)  # 09:00-10:00 ends as the follow-up starts
+        self.assertIn(t(10, 30), slots)
+
+    def test_existing_assessment_blocks_its_full_length(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind="assessment")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(t(10, 30), slots)
+        self.assertNotIn(t(10, 45), slots)
+        self.assertIn(t(11, 0), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", status=CANCELLED)])
+        self.assertEqual(free_slots(cal, THERAPIST, DAY, FOLLOWUP), free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(10), therapist="T2")])
+        self.assertIn(t(10, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_other_days_do_not_block(self):
+        cal = Calendar([appt("a1", local(10, day=date(2026, 10, 16)), therapist="T1")])
+        self.assertIn(t(10, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_uses_local_date_not_utc_date(self):
+        # 10:00 local on 15 Oct is 21:00 UTC on 14 Oct: it must still block 15 Oct.
+        cal = Calendar([appt("a1", datetime.datetime(2026, 10, 14, 21, 0, tzinfo=datetime.timezone.utc), therapist="T1")])
+        self.assertNotIn(t(10, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_rejects_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
