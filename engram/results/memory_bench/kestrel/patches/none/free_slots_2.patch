+"""Finding free appointment times for a therapist."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+# Assumed clinic rules; the codebase does not define them yet. Change here if they differ.
+DAY_START = datetime.time(7, 0)  # local (Auckland) time
+DAY_END = datetime.time(17, 0)  # an appointment must finish by this time
+STEP = datetime.timedelta(minutes=15)  # possible start times fall on this grid
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=60),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on a local (Auckland) date at which an appointment of this kind could be booked.
+
+    A slot is free when a new appointment of the given kind fits within the clinic day and does not
+    overlap any booked appointment for the therapist on that date. Returns datetime.time values, sorted.
+    """
+    if kind not in DURATIONS:
+        raise ValueError(f"unknown kind {kind!r}")
+    duration = DURATIONS[kind]
+    window_start = datetime.datetime.combine(day, DAY_START, tzinfo=CLINIC_TZ)
+    window_end = datetime.datetime.combine(day, DAY_END, tzinfo=CLINIC_TZ)
+    busy = [
+        (a.start, a.start + DURATIONS[a.kind])
+        for a in calendar.for_day(therapist.id, day)
+        if a.status == BOOKED
+    ]
+
+    slots = []
+    start = window_start
+    while start + duration <= window_end:
+        end = start + duration
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
