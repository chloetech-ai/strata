+"""Exports for the accountant."""
+
+import csv
+import os
+
+FIELDS = ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to a CSV file and return its path.
+
+    An invoice belongs to the month of its issued date (the local Auckland date).
+    The file is named invoices-YYYY-MM.csv, sorted by issue date then invoice number,
+    and amounts are written in dollars (e.g. 95.00). A month with no invoices still
+    gets a file, with just the header row.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1-12, not {month}")
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    # utf-8-sig adds a byte order mark so Excel reads macrons in patient names correctly.
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(f, fieldnames=FIELDS)
+        writer.writeheader()
+        for i in chosen:
+            writer.writerow({
+                "number": i.number,
+                "issued": i.issued.isoformat(),
+                "clinic": i.clinic,
+                "patient_id": i.patient_id,
+                "patient_name": i.patient_name,
+                "description": i.description,
+                "amount": f"{i.amount_cents // 100}.{i.amount_cents % 100:02d}",
+            })
+    return path
