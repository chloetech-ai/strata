@@ -0,0 +1,101 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=7000, name="Aroha Ngātā", description="Physiotherapy follow-up"):
+    return Invoice(number=number, clinic="HB", patient_id="KP-004211", patient_name=name,
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+def read_rows(path):
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.out_dir = self.tmp.name
+
+    def test_writes_only_the_requested_month(self):
+        invoices = [
+            invoice("N-1", datetime.date(2026, 9, 30)),
+            invoice("N-2", datetime.date(2026, 10, 1)),
+            invoice("N-3", datetime.date(2026, 10, 31)),
+            invoice("N-4", datetime.date(2026, 11, 1)),
+            invoice("N-5", datetime.date(2025, 10, 15)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        numbers = [row[0] for row in read_rows(path)[1:]]
+        self.assertEqual(numbers, ["N-2", "N-3"])
+
+    def test_returns_path_in_out_dir_named_by_month(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_month_with_no_invoices_has_only_header(self):
+        path = export_invoices([invoice("N-1", datetime.date(2026, 9, 1))], 2026, 10, self.out_dir)
+        self.assertEqual(read_rows(path), [[
+            "number", "issued", "clinic", "patient_id", "patient_name", "description", "amount",
+        ]])
+
+    def test_row_contents_and_amount_in_dollars(self):
+        path = export_invoices(
+            [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15), amount_cents=9500,
+                     description="Physiotherapy assessment")],
+            2026, 10, self.out_dir,
+        )
+        self.assertEqual(read_rows(path)[1], [
+            "INV-HB-2026-00001", "2026-10-15", "HB", "KP-004211", "Aroha Ngātā",
+            "Physiotherapy assessment", "95.00",
+        ])
+
+    def test_amount_keeps_two_decimal_places(self):
+        path = export_invoices([invoice("N-1", datetime.date(2026, 10, 2), amount_cents=7005)],
+                               2026, 10, self.out_dir)
+        self.assertEqual(read_rows(path)[1][6], "70.05")
+
+    def test_sorted_by_issue_date_then_number(self):
+        invoices = [
+            invoice("N-3", datetime.date(2026, 10, 20)),
+            invoice("N-2", datetime.date(2026, 10, 5)),
+            invoice("N-1", datetime.date(2026, 10, 20)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertEqual([row[0] for row in read_rows(path)[1:]], ["N-2", "N-1", "N-3"])
+
+    def test_quotes_fields_containing_commas(self):
+        path = export_invoices(
+            [invoice("N-1", datetime.date(2026, 10, 2), description="Physiotherapy follow-up: back, neck")],
+            2026, 10, self.out_dir,
+        )
+        self.assertEqual(read_rows(path)[1][5], "Physiotherapy follow-up: back, neck")
+
+    def test_file_is_utf8_with_bom_for_excel(self):
+        path = export_invoices([invoice("N-1", datetime.date(2026, 10, 2))], 2026, 10, self.out_dir)
+        with open(path, "rb") as f:
+            self.assertTrue(f.read().startswith(b"\xef\xbb\xbf"))
+
+    def test_rejects_invalid_month(self):
+        for month in (0, 13):
+            with self.subTest(month=month):
+                with self.assertRaises(ValueError):
+                    export_invoices([], 2026, month, self.out_dir)
+
+    def test_does_not_change_the_invoices(self):
+        original = invoice("N-1", datetime.date(2026, 10, 2))
+        export_invoices([original], 2026, 10, self.out_dir)
+        self.assertEqual(original.number, "N-1")
+        self.assertEqual(original.issued, datetime.date(2026, 10, 2))
+
+
+if __name__ == "__main__":
+    unittest.main()
