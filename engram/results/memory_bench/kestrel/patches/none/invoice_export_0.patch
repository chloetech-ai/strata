+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=7000, patient_name="Aroha Ngata", description="Physiotherapy follow-up"):
+    return Invoice(
+        number=number, clinic="HB", patient_id="KP-004211", patient_name=patient_name,
+        issued=issued, amount_cents=amount_cents, description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.DictReader(f))
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 9, 30))], 2026, 10, self.out_dir)
+        with open(path, newline="", encoding="utf-8") as f:
+            self.assertEqual(f.read().splitlines(), ["number,issued,clinic,patient_id,patient_name,description,amount"])
+
+    def test_includes_only_invoices_issued_in_the_month(self):
+        invoices = [
+            invoice("N1", datetime.date(2026, 9, 30)),
+            invoice("N2", datetime.date(2026, 10, 1)),
+            invoice("N3", datetime.date(2026, 10, 31)),
+            invoice("N4", datetime.date(2026, 11, 1)),
+            invoice("N5", datetime.date(2025, 10, 15)),
+        ]
+        rows = self.read(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r["number"] for r in rows], ["N2", "N3"])
+
+    def test_sorted_by_issue_date_then_number(self):
+        invoices = [
+            invoice("N3", datetime.date(2026, 10, 2)),
+            invoice("N2", datetime.date(2026, 10, 2)),
+            invoice("N1", datetime.date(2026, 10, 1)),
+        ]
+        rows = self.read(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r["number"] for r in rows], ["N1", "N2", "N3"])
+
+    def test_amount_in_dollars_with_cents(self):
+        invoices = [invoice("N1", datetime.date(2026, 10, 1), amount_cents=9500), invoice("N2", datetime.date(2026, 10, 2), amount_cents=7005)]
+        rows = self.read(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r["amount"] for r in rows], ["95.00", "70.05"])
+
+    def test_row_fields(self):
+        rows = self.read(export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15), patient_name="Aroha Ngata", description="Physiotherapy assessment: lower back pain", amount_cents=9500)], 2026, 10, self.out_dir))
+        self.assertEqual(rows, [{
+            "number": "INV-HB-2026-00001", "issued": "2026-10-15", "clinic": "HB", "patient_id": "KP-004211",
+            "patient_name": "Aroha Ngata", "description": "Physiotherapy assessment: lower back pain", "amount": "95.00",
+        }])
+
+    def test_quotes_names_containing_commas(self):
+        rows = self.read(export_invoices([invoice("N1", datetime.date(2026, 10, 1), patient_name="Ngata, Aroha")], 2026, 10, self.out_dir))
+        self.assertEqual(rows[0]["patient_name"], "Ngata, Aroha")
+
+
+if __name__ == "__main__":
+    unittest.main()
