+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+
+FIELDS = ["number", "issued", "clinic", "patient_id", "patient_name", "description", "amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a month to a CSV file and return its path.
+
+    Only invoices whose issue date (Auckland local date) falls in year and month
+    are included, sorted by issue date then invoice number. The amount is written
+    in dollars, e.g. 95.00. The file is named invoices-YYYY-MM.csv inside out_dir.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=FIELDS)
+        writer.writeheader()
+        for invoice in month_invoices:
+            writer.writerow({
+                "number": invoice.number,
+                "issued": invoice.issued.isoformat(),
+                "clinic": invoice.clinic,
+                "patient_id": invoice.patient_id,
+                "patient_name": invoice.patient_name,
+                "description": invoice.description,
+                "amount": f"{invoice.amount_cents // 100}.{invoice.amount_cents % 100:02d}",
+            })
+    return path
