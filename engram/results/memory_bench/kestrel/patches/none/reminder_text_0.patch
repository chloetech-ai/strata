+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_day_and_time(self):
+        # 2026-10-15 02:30 UTC is 15:30 on Thursday 15 October in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("A1", utc(2026, 10, 15, 2, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October at 3:30pm", text)
+
+    def test_on_the_hour_omits_minutes(self):
+        # 2026-10-15 01:00 UTC is 14:00 in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 15, 1), clinic="NG"))
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("at 2pm", text)
+
+    def test_morning_and_midnight_hours(self):
+        # 2026-10-14 12:05 UTC is 01:05 on 15 October in Auckland; 23:00 UTC is 12:00 (noon).
+        self.assertIn("at 1:05am", reminder_text(appt("A1", utc(2026, 10, 14, 12, 5))))
+        self.assertIn("at 12pm", reminder_text(appt("A1", utc(2026, 10, 14, 23))))
+
+    def test_uses_local_date_not_utc_date(self):
+        # 2026-10-15 11:30 UTC is 00:30 on 16 October in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 15, 11, 30)))
+        self.assertIn("Friday 16 October at 12:30am", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
