+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Gives the clinic, and the local (Auckland) day and time of the appointment.
+    The appointment holds no patient or therapist name, so the text does not use one.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    ampm = "am" if local.hour < 12 else "pm"
+    when = f"{hour}{ampm}" if local.minute == 0 else f"{hour}:{local.minute:02d}{ampm}"
+    day = f"{local.strftime('%A')} {local.day} {local.strftime('%B')}"
+    clinic = CLINICS[appointment.clinic].name
+    return f"Hi! Friendly reminder of your physio appointment at {clinic} on {day} at {when}. See you then!"
