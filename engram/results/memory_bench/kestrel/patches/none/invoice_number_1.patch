+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_highest_existing_sequence(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00003", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00004")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-HB-2026-00007", "INV-AK-2026-00002"]
+        self.assertEqual(next_invoice_number("AK", 2026, existing), "INV-AK-2026-00003")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-HB-2025-00009"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_clinic_codes_that_share_a_prefix_do_not_collide(self):
+        existing = ["INV-HBX-2026-00005", "INV-H-2026-00006"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-HB-2026-", "INV-HB-2026-abcde", "N1", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+
+    def test_accepts_any_iterable(self):
+        existing = (number for number in ["INV-HB-2026-00004"])
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00005")
+
+
 if __name__ == "__main__":
     unittest.main()
