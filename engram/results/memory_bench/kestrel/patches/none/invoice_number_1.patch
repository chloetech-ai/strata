+def next_invoice_number(clinic, year, existing):
+    """Return the number for the next invoice from a clinic in a year.
+
+    Numbers look like 'INV-HB-2026-00001': the clinic code, the year and a
+    five-digit sequence that restarts for each clinic and year. ``existing``
+    may hold numbers from any clinic or year; those that do not match this
+    clinic and year, or are not in this format, are ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    last = 0
+    for number in existing:
+        sequence = number[len(prefix):]
+        if number.startswith(prefix) and sequence.isdigit():
+            last = max(last, int(sequence))
+    return f"{prefix}{last + 1:05d}"
+
