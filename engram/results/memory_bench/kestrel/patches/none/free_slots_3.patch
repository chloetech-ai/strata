@@ -0,0 +1,91 @@
+import datetime
+import unittest
+from datetime import date
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import Therapist
+from kestrel.slots import free_slots
+
+THERAPIST = Therapist("T1", "Ana", "HB")
+DAY = date(2026, 10, 15)  # NZDT, UTC+13
+
+
+def local(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+def utc_for_local(hh, mm=0):
+    """UTC instant for a local time on DAY, so tests can state appointments in local time."""
+    return datetime.datetime(2026, 10, 15, hh, mm, tzinfo=datetime.timezone(datetime.timedelta(hours=13))).astimezone(datetime.timezone.utc)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_calendar_offers_every_grid_start_that_fits(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, "followup")
+        self.assertEqual(slots[0], local(9))
+        self.assertEqual(slots[-1], local(16, 30))
+        self.assertEqual(len(slots), 31)  # 09:00 to 16:30 every 15 minutes
+
+    def test_assessment_is_longer_so_last_start_is_earlier(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, "assessment")
+        self.assertEqual(slots[-1], local(16))
+
+    def test_returns_sorted_datetime_times(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, "followup")
+        self.assertTrue(all(isinstance(s, datetime.time) and s.tzinfo is None for s in slots))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_booked_appointment_blocks_overlapping_starts(self):
+        cal = Calendar([appt("a1", utc_for_local(10), kind="followup")])  # 10:00-10:30
+        slots = free_slots(cal, THERAPIST, DAY, "followup")
+        self.assertNotIn(local(9, 45), slots)  # would run 09:45-10:15
+        self.assertNotIn(local(10), slots)
+        self.assertNotIn(local(10, 15), slots)
+        self.assertIn(local(9, 30), slots)  # ends exactly at 10:00
+        self.assertIn(local(10, 30), slots)  # starts exactly at 10:30
+
+    def test_existing_appointment_blocks_using_its_own_length(self):
+        cal = Calendar([appt("a1", utc_for_local(10), kind="assessment")])  # 10:00-11:00
+        slots = free_slots(cal, THERAPIST, DAY, "followup")
+        self.assertNotIn(local(10, 30), slots)
+        self.assertNotIn(local(10, 45), slots)
+        self.assertIn(local(11), slots)
+
+    def test_new_assessment_must_fit_before_a_later_booking(self):
+        cal = Calendar([appt("a1", utc_for_local(11), kind="followup")])  # 11:00-11:30
+        slots = free_slots(cal, THERAPIST, DAY, "assessment")
+        self.assertNotIn(local(10, 30), slots)  # would run into 11:00
+        self.assertIn(local(10), slots)  # 10:00-11:00 fits exactly
+        self.assertIn(local(11, 30), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc_for_local(10), status="cancelled")])
+        self.assertIn(local(10), free_slots(cal, THERAPIST, DAY, "followup"))
+
+    def test_attended_and_no_show_still_block(self):
+        cal = Calendar([
+            appt("a1", utc_for_local(10), status="attended"),
+            appt("a2", utc_for_local(12), status="no_show"),
+        ])
+        slots = free_slots(cal, THERAPIST, DAY, "followup")
+        self.assertNotIn(local(10), slots)
+        self.assertNotIn(local(12), slots)
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", utc_for_local(10), therapist="T2")])
+        self.assertIn(local(10), free_slots(cal, THERAPIST, DAY, "followup"))
+
+    def test_uses_local_date_not_utc_date(self):
+        # 10:00 on 16 Oct NZDT is 21:00 UTC on 15 Oct: booked on the 16th, not the 15th.
+        cal = Calendar([appt("a1", utc(2026, 10, 15, 21))])
+        self.assertIn(local(10), free_slots(cal, THERAPIST, DAY, "followup"))
+        self.assertNotIn(local(10), free_slots(cal, THERAPIST, date(2026, 10, 16), "followup"))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
