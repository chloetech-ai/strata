+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Placeholder clinic rules, not confirmed by the clinic. Replace before relying on them.
+OPENING = datetime.time(9, 0)
+CLOSING = datetime.time(17, 0)
+SLOT_STEP = datetime.timedelta(minutes=15)
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=60),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times at which a new appointment of `kind` could be booked for `therapist` on `day`.
+
+    `day` is an Auckland local date. A slot is free if the appointment fits within
+    opening hours and overlaps no appointment the therapist has that is not cancelled.
+    Returns datetime.time values (local, no tzinfo), sorted.
+    """
+    if kind not in DURATIONS:
+        raise ValueError(f"unknown kind {kind!r}")
+    length = DURATIONS[kind]
+
+    busy = [
+        (a.start.astimezone(datetime.timezone.utc), (a.start + DURATIONS[a.kind]).astimezone(datetime.timezone.utc))
+        for a in calendar.for_day(therapist.id, day)
+        if a.status != CANCELLED
+    ]
+
+    closes = datetime.datetime.combine(day, CLOSING, tzinfo=CLINIC_TZ)
+    start = datetime.datetime.combine(day, OPENING, tzinfo=CLINIC_TZ)
+    times = []
+    while start + length <= closes:
+        begin = start.astimezone(datetime.timezone.utc)
+        end = begin + length
+        if all(end <= b_start or begin >= b_end for b_start, b_end in busy):
+            times.append(start.time())
+        start += SLOT_STEP
+    return times
