+from kestrel.invoices import make_invoice, next_invoice_number
 from kestrel.models import Appointment, Patient
 
 from helpers import UTC, appt, utc
 
 
+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_number_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_the_highest_number_issued(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00004")
+
+    def test_does_not_reuse_gaps(self):
+        self.assertEqual(next_invoice_number("HB", 2026, ["INV-HB-2026-00007", "INV-HB-2026-00002"]), "INV-HB-2026-00008")
+
+    def test_order_of_existing_numbers_does_not_matter(self):
+        self.assertEqual(next_invoice_number("HB", 2026, ["INV-HB-2026-00002", "INV-HB-2026-00010", "INV-HB-2026-00005"]), "INV-HB-2026-00011")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-PN-2026-00050", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00004")
+        self.assertEqual(next_invoice_number("PN", 2026, existing), "INV-PN-2026-00051")
+
+    def test_ignores_other_years(self):
+        existing = ["INV-HB-2025-00020", "INV-HB-2027-00030"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_ignores_clinic_codes_that_only_share_a_prefix(self):
+        existing = ["INV-HBX-2026-00009", "INV-H-2026-00009"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_ignores_malformed_sequence_numbers(self):
+        existing = ["INV-HB-2026-", "INV-HB-2026-abc", "INV-HB-2026-00002x", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00004")
+
+    def test_numbers_past_five_digits_keep_counting(self):
+        self.assertEqual(next_invoice_number("HB", 2026, ["INV-HB-2026-99999"]), "INV-HB-2026-100000")
+
+
