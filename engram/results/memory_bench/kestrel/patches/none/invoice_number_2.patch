+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number for a clinic in a year.
+
+    Numbers look like 'INV-HB-2026-00001'. Only the numbers issued for this
+    clinic and year count, and the next one follows the highest sequence
+    number issued so far (gaps are not reused). The first is number 1.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        sequence = number[len(prefix):] if number.startswith(prefix) else ""
+        if sequence.isdecimal():
+            highest = max(highest, int(sequence))
+    return f"{prefix}{highest + 1:05d}"
+
