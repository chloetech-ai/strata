+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_sorts_and_merges_overlapping_and_touching(self):
+        self.assertEqual(
+            merge_busy([(5, 7), (1, 3), (2, 4), (4, 5), (9, 10)]),
+            [(1, 7), (9, 10)],
+        )
+
+    def test_contained_interval_does_not_shrink_result(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_disjoint_intervals_stay_separate_and_sorted(self):
+        self.assertEqual(merge_busy([(8, 9), (1, 2)]), [(1, 2), (8, 9)])
+
+    def test_empty_input(self):
+        self.assertEqual(merge_busy([]), [])
