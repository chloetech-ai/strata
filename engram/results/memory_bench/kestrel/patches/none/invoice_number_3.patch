+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_the_highest_existing_number(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00007"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_ignores_other_clinics_and_years(self):
+        existing = ["INV-AK-2026-00009", "INV-HB-2025-00005", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_does_not_mistake_a_longer_clinic_code_for_this_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, ["INV-HBX-2026-00004"]), "INV-HB-2026-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-HB-2026-", "INV-HB-2026-abc", "INV-HB-2026-0000٣", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+
+    def test_accepts_any_iterable(self):
+        existing = (number for number in ["INV-HB-2026-00004"])
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00005")
+
+
 if __name__ == "__main__":
     unittest.main()
