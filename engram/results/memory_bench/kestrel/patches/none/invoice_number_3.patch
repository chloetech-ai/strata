+def next_invoice_number(clinic, year, existing):
+    """Return the number for the next invoice a clinic issues in a year.
+
+    Numbers look like INV-HB-2026-00001. Each clinic and year has its own
+    sequence, so only existing numbers for this clinic and year count.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        if not number.startswith(prefix):
+            continue
+        digits = number[len(prefix):]
+        if digits.isascii() and digits.isdigit():
+            highest = max(highest, int(digits))
+    return f"{prefix}{highest + 1:05d}"
