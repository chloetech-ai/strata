+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# Policy: a cancellation made at least this long before the start is free.
+# Later cancellations, and no-shows, are charged the full session price.
+# TODO: confirm these values with the clinic; they are not documented anywhere else.
+FREE_CANCELLATION_NOTICE = datetime.timedelta(hours=24)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for a cancelled or no-show appointment.
+
+    For a cancelled appointment, `cancelled_at` is when the patient cancelled.
+    For a no-show it is None.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no fee applies to appointment {appointment.id} with status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError(f"cancelled appointment {appointment.id} needs cancelled_at")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at >= FREE_CANCELLATION_NOTICE:
+        return 0
+    return session_price(appointment.kind)
