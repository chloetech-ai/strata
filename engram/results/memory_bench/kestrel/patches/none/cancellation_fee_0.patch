@@ -0,0 +1,52 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_no_show_charges_full_assessment_price(self):
+        a = appt("a1", utc(2027, 3, 1, 20), kind="assessment", status="no_show")
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_charges_full_followup_price(self):
+        a = appt("a1", utc(2027, 3, 1, 20), kind="followup", status="no_show")
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_cancelled_with_enough_notice_is_free(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled")
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2027, 2, 27, 20)), 0)
+
+    def test_cancelled_exactly_at_notice_limit_is_free(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled")
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2027, 2, 28, 20)), 0)
+
+    def test_cancelled_inside_notice_limit_charges_full_price(self):
+        a = appt("a1", utc(2027, 3, 1, 20), kind="assessment", status="cancelled")
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2027, 2, 28, 21)), 9500)
+
+    def test_cancelled_after_start_charges_full_price(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled")
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2027, 3, 1, 21)), 7000)
+
+    def test_cancelled_needs_cancelled_at(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_cancelled_at_must_be_timezone_aware(self):
+        a = appt("a1", utc(2027, 3, 1, 20), status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, cancelled_at=datetime.datetime(2027, 2, 28, 20))
+
+    def test_booked_and_attended_have_no_fee(self):
+        for status in ("booked", "attended"):
+            with self.subTest(status=status):
+                a = appt("a1", utc(2027, 3, 1, 20), status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
