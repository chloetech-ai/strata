+"""Free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+# Working day and appointment lengths. These are assumptions, not values taken from the clinics:
+# nothing else in the codebase defines them yet.
+DAY_START = datetime.time(9, 0)
+DAY_END = datetime.time(17, 0)
+SLOT_STEP = datetime.timedelta(minutes=30)
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=60),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on a local (Auckland) date at which a new appointment of this kind could be booked.
+
+    A start time is free when the whole appointment fits inside the working day and does not
+    overlap any of the therapist's appointments that day, other than cancelled ones. Returns a
+    sorted list of datetime.time values.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown appointment kind {kind!r}")
+    duration = DURATIONS[kind]
+    opens = datetime.datetime.combine(day, DAY_START, tzinfo=CLINIC_TZ)
+    closes = datetime.datetime.combine(day, DAY_END, tzinfo=CLINIC_TZ)
+    busy = [
+        (a.start, a.start + DURATIONS[a.kind])
+        for a in calendar.for_day(therapist.id, day)
+        if a.status != CANCELLED
+    ]
+    slots = []
+    start = opens
+    while start + duration <= closes:
+        end = start + duration
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += SLOT_STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..871fe51
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,88 @@
+import datetime
+import unittest
+from datetime import date
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+THERAPIST = Therapist(id="T1", name="Sam", clinic="HB")
+DAY = date(2026, 10, 15)  # NZDT, UTC+13
+
+
+def local_time(hh, mm):
+    return datetime.time(hh, mm)
+
+
+def at_local(hh, mm):
+    """A UTC datetime for the given Auckland wall-clock time on DAY."""
+    return utc(2026, 10, 14, 21, 0) + datetime.timedelta(hours=hh - 10, minutes=mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_followup_runs_to_last_fitting_slot(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(slots[0], local_time(9, 0))
+        self.assertEqual(slots[-1], local_time(16, 30))
+        self.assertEqual(len(slots), 16)
+
+    def test_empty_day_assessment_must_finish_by_close(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, ASSESSMENT)
+        self.assertEqual(slots[-1], local_time(16, 0))
+        self.assertEqual(len(slots), 15)
+
+    def test_returns_times_sorted_and_naive(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) and s.tzinfo is None for s in slots))
+
+    def test_followup_blocks_only_its_own_slot(self):
+        cal = Calendar([appt("a1", at_local(10, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(local_time(10, 0), slots)
+        self.assertIn(local_time(9, 30), slots)
+        self.assertIn(local_time(10, 30), slots)
+
+    def test_assessment_blocks_its_full_hour(self):
+        cal = Calendar([appt("a1", at_local(10, 0), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(local_time(10, 0), slots)
+        self.assertNotIn(local_time(10, 30), slots)
+        self.assertIn(local_time(11, 0), slots)
+
+    def test_new_assessment_cannot_overlap_booked_followup(self):
+        cal = Calendar([appt("a1", at_local(10, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        # 09:30 would run to 10:30, into the booked follow-up at 10:00.
+        self.assertNotIn(local_time(9, 30), slots)
+        self.assertNotIn(local_time(10, 0), slots)
+        self.assertIn(local_time(9, 0), slots)
+        self.assertIn(local_time(10, 30), slots)
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", at_local(10, 0), kind=ASSESSMENT, therapist="T1", status=CANCELLED)])
+        self.assertIn(local_time(10, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", at_local(10, 0), kind=FOLLOWUP, therapist="T2")])
+        self.assertIn(local_time(10, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_appointments_on_other_days_do_not_block(self):
+        cal = Calendar([appt("a1", at_local(10, 0) + datetime.timedelta(days=1), kind=FOLLOWUP, therapist="T1")])
+        self.assertIn(local_time(10, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_fully_booked_day_has_no_slots(self):
+        cal = Calendar([
+            appt(f"a{i}", at_local(9, 0) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP, therapist="T1")
+            for i in range(16)
+        ])
+        self.assertEqual(free_slots(cal, THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
