@@ -0,0 +1,33 @@
+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+from typing import Optional
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at: Optional[datetime.datetime] = None) -> int:
+    """Fee in cents for a cancelled or no-show appointment.
+
+    A cancellation made less than 48 hours before the start costs 50% of the
+    session price; earlier cancellations are free. A no-show pays the full price.
+    `cancelled_at` is when the patient cancelled (defaults to the appointment's
+    recorded time); it is not used for no-shows.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"appointment {appointment.id} is {appointment.status!r}, not cancelled or no-show")
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError(f"appointment {appointment.id} has no cancellation time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
