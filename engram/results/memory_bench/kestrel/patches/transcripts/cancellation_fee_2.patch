@@ -0,0 +1,68 @@
+import datetime
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+from helpers import appt, utc
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2026, 10, 20, 10, 0)
+
+    def test_cancel_inside_48_hours_costs_half(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 10, 1)), 3500)
+
+    def test_assessment_cancel_inside_48_hours_costs_half(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 19, 9, 0)), 4750)
+
+    def test_exactly_48_hours_before_is_free(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 10, 0)), 0)
+
+    def test_cancel_early_is_free(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 10, 9, 0)), 0)
+
+    def test_cancel_after_start_costs_half(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 20, 11, 0)), 3500)
+
+    def test_cancelled_at_defaults_to_recorded_time(self):
+        a = appt("a1", self.start, status=CANCELLED, cancelled_at=utc(2026, 10, 19, 9, 0))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_explicit_cancelled_at_wins_over_recorded_time(self):
+        a = appt("a1", self.start, status=CANCELLED, cancelled_at=utc(2026, 10, 10, 9, 0))
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 19, 9, 0)), 3500)
+
+    def test_cancelled_without_any_time_is_refused(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancelled_at_is_refused(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2026, 10, 19, 9, 0))
+
+    def test_no_show_pays_full_price(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_assessment_pays_full_price(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_booked_or_attended_is_refused(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                a = appt("a1", self.start, status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
