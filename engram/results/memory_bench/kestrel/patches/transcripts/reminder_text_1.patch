+"""Text for the SMS reminders sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS text for an appointment.
+
+    Deliberately includes only the clinic name, date and time. The treatment
+    and patient name never go in a reminder.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    when = f"{local.strftime('%A')} {local.day} {local.strftime('%B')} at {hour}:{local.minute:02d}{suffix}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora from {clinic}. This is a friendly reminder of your appointment "
+        f"on {when}. We look forward to seeing you! "
+        "If you need to change your booking, please contact the clinic."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
