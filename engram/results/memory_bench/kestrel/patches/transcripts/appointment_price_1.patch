+def local(y, m, d, hh=0, mm=0):
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=CLINIC_TZ)
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.patient = Patient(id="KP-000001", name="Ana Silva", phone="+64211234567")
+        self.csc_patient = Patient(id="KP-000001", name="Ana Silva", phone="+64211234567", csc=True)
+
+    def price(self, kind, start, patient=None):
+        patient = patient or self.patient
+        return appointment_price(appt("A1", start, kind=kind, patient=patient.id), patient)
+
+    def test_old_prices_before_cutoff(self):
+        self.assertEqual(self.price(ASSESSMENT, local(2027, 3, 31, 10)), 9500)
+        self.assertEqual(self.price(FOLLOWUP, local(2027, 3, 31, 10)), 7000)
+
+    def test_new_prices_from_cutoff(self):
+        self.assertEqual(self.price(ASSESSMENT, local(2027, 4, 1, 10)), 10500)
+        self.assertEqual(self.price(FOLLOWUP, local(2027, 4, 1, 10)), 7800)
+
+    def test_late_evening_31_march_keeps_old_price(self):
+        # 23:30 on 31 Mar is still NZDT (UTC+13), so it is 10:30 UTC on 31 Mar
+        self.assertEqual(self.price(ASSESSMENT, local(2027, 3, 31, 23, 30)), 9500)
+
+    def test_cutoff_uses_local_date_not_utc_date(self):
+        # 00:30 on 1 Apr is 11:30 UTC on 31 Mar, but the local date is 1 Apr
+        self.assertEqual(self.price(FOLLOWUP, local(2027, 4, 1, 0, 30)), 7800)
+
+    def test_csc_follow_up_is_20_percent_off(self):
+        self.assertEqual(self.price(FOLLOWUP, local(2026, 10, 15, 10), self.csc_patient), 5600)
+        self.assertEqual(self.price(FOLLOWUP, local(2027, 4, 1, 10), self.csc_patient), 6240)
+
+    def test_csc_assessment_is_not_discounted(self):
+        self.assertEqual(self.price(ASSESSMENT, local(2026, 10, 15, 10), self.csc_patient), 9500)
+        self.assertEqual(self.price(ASSESSMENT, local(2027, 4, 1, 10), self.csc_patient), 10500)
+
+    def test_appointment_for_another_patient_is_rejected(self):
+        other = appt("A1", local(2027, 4, 1, 10), patient="KP-000002")
+        with self.assertRaises(ValueError):
+            appointment_price(other, self.patient)
+
+
 if __name__ == "__main__":
     unittest.main()
