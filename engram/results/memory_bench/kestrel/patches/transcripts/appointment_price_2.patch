@@ -14,3 +24,24 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    Appointments on or after PRICE_CHANGE_DATE (clinic-local date) use the new prices.
+    CSC holders get 20% off follow-ups. A no-show pays the full price, with no discount.
+    Late-cancellation fees are not built yet, so cancelled appointments raise.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id} does not belong to patient {patient.id}")
+    if appointment.status == CANCELLED:
+        raise NotImplementedError("late-cancellation fee is not implemented")
+
+    local_date = appointment.start.astimezone(CLINIC_TZ).date()
+    prices = NEW_PRICES_CENTS if local_date >= PRICE_CHANGE_DATE else PRICES_CENTS
+    price = prices[appointment.kind]
+
+    if patient.csc and appointment.kind == FOLLOWUP and appointment.status != NO_SHOW:
+        price = price * 80 // 100
+    return price
