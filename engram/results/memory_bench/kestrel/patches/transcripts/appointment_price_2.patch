 }
 
+# Prices from 1 April 2027, compared against the clinic-local date of the appointment.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
 
 def session_price(kind):
