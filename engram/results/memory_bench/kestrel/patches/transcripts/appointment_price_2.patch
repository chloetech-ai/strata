+class AppointmentPriceTest(unittest.TestCase):
+    def test_before_change_keeps_old_prices(self):
+        self.assertEqual(appointment_price(appt("a1", local(2027, 3, 1, 9), kind=ASSESSMENT), patient()), 9500)
+        self.assertEqual(appointment_price(appt("a2", local(2027, 3, 1, 9), kind=FOLLOWUP), patient()), 7000)
+
+    def test_from_change_uses_new_prices(self):
+        self.assertEqual(appointment_price(appt("a1", local(2027, 4, 1, 9), kind=ASSESSMENT), patient()), 10500)
+        self.assertEqual(appointment_price(appt("a2", local(2027, 4, 1, 9), kind=FOLLOWUP), patient()), 7800)
+
+    def test_late_on_31_march_local_keeps_old_price(self):
+        a = appt("a1", local(2027, 3, 31, 23, 30), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, patient()), 7000)
+
+    def test_date_is_clinic_local_not_utc(self):
+        # 1 April 08:00 in Auckland (NZDT, UTC+13) is still 31 March in UTC.
+        a = appt("a1", local(2027, 4, 1, 8), kind=FOLLOWUP)
+        self.assertEqual(a.start.astimezone(datetime.timezone.utc).date(), datetime.date(2027, 3, 31))
+        self.assertEqual(appointment_price(a, patient()), 7800)
+
+    def test_csc_gets_20_percent_off_followups_only(self):
+        self.assertEqual(appointment_price(appt("a1", local(2027, 4, 1, 9), kind=FOLLOWUP), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appt("a2", local(2027, 4, 1, 9), kind=ASSESSMENT), patient(csc=True)), 10500)
+        self.assertEqual(appointment_price(appt("a3", local(2027, 3, 1, 9), kind=FOLLOWUP), patient(csc=True)), 5600)
+
+    def test_no_show_pays_full_price_even_with_csc(self):
+        a = appt("a1", local(2027, 4, 1, 9), kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(appointment_price(a, patient(csc=True)), 7800)
+
+    def test_cancelled_is_rejected_until_fee_exists(self):
+        a = appt("a1", local(2027, 4, 1, 9), kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(NotImplementedError):
+            appointment_price(a, patient())
+
+    def test_wrong_patient_is_rejected(self):
