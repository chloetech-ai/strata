+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=7000, patient_id="KP-004211", patient_name="Aroha Ngata", description="Follow-up"):
+    return Invoice(number=number, clinic="HB", patient_id=patient_id, patient_name=patient_name,
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.out_dir = tempfile.mkdtemp()
+
+    def read_rows(self, path):
+        with open(path, encoding="utf-8", newline="") as f:
+            return list(csv.DictReader(f))
+
+    def test_writes_only_invoices_issued_in_the_month_and_returns_path(self):
+        invoices = [
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 3)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00009", datetime.date(2025, 10, 15)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2026-10.csv"))
+        rows = self.read_rows(path)
+        self.assertEqual([r["number"] for r in rows], ["INV-HB-2026-00001", "INV-HB-2026-00002"])
+
+    def test_rows_have_patient_id_but_never_patient_name(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15))], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertNotIn("patient_name", text)
+        self.assertNotIn("Aroha", text)
+        self.assertEqual(self.read_rows(path)[0]["patient_id"], "KP-004211")
+
+    def test_amount_in_dollars_with_two_decimals(self):
+        path = export_invoices([
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), amount_cents=9500),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2), amount_cents=7005),
+        ], 2026, 10, self.out_dir)
+        self.assertEqual([r["amount"] for r in self.read_rows(path)], ["95.00", "70.05"])
+
+    def test_description_and_clinic_and_date_written(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15),
+                                        description="Assessment: lower back pain")], 2026, 10, self.out_dir)
+        row = self.read_rows(path)[0]
+        self.assertEqual(row["clinic"], "HB")
+        self.assertEqual(row["issued"], "2026-10-15")
+        self.assertEqual(row["description"], "Assessment: lower back pain")
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15))], 2026, 5, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2026-05.csv"))
+        self.assertEqual(self.read_rows(path), [])
+
+    def test_rejects_bad_month(self):
+        for month in (0, 13):
+            with self.assertRaises(ValueError):
+                export_invoices([], 2026, month, self.out_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
