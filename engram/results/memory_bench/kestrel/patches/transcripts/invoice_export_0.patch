+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+
+# Patient names are left out on purpose: files that leave the system carry the patient ID only.
+FIELDS = ("number", "clinic", "patient_id", "issued", "amount", "description")
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in a given month to a CSV file and return its path.
+
+    An invoice belongs to the month of its issued date, which is already the
+    clinic-local date. The file is named invoices-YYYY-MM.csv, with one row per
+    invoice sorted by invoice number. Amounts are dollars with two decimals.
+    """
+    if not 1 <= month <= 12:
+        raise ValueError(f"month must be 1-12, not {month}")
+    chosen = sorted(
+        (inv for inv in invoices if inv.issued.year == year and inv.issued.month == month),
+        key=lambda inv: inv.number,
+    )
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=FIELDS)
+        writer.writeheader()
+        for inv in chosen:
+            writer.writerow({
+                "number": inv.number,
+                "clinic": inv.clinic,
+                "patient_id": inv.patient_id,
+                "issued": inv.issued.isoformat(),
+                "amount": f"{inv.amount_cents // 100}.{inv.amount_cents % 100:02d}",
+                "description": inv.description,
+            })
+    return path
