diff --git a/src/kestrel/intervals.py b/src/kestrel/intervals.py
new file mode 100644
index 0000000..c3abad3
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,16 @@
+"""Parsing durations typed in by reception."""
+
+import re
+
+_DURATION = re.compile(r"(?:(\d+)h(?:\s*([0-5]?\d)m?)?|(\d+)m)")
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes."""
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, minutes_only = match.groups()
+    if minutes_only is not None:
+        return int(minutes_only)
+    return int(hours) * 60 + int(minutes_after_hours or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..e45b2f9
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,33 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes_without_unit(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+
+    def test_hours_and_minutes_with_space(self):
+        self.assertEqual(parse_duration("1h 30m"), 90)
+
+    def test_hours_and_minutes_with_unit(self):
+        self.assertEqual(parse_duration("2h15m"), 135)
+
+    def test_surrounding_whitespace_and_case(self):
+        self.assertEqual(parse_duration(" 1H30 "), 90)
+
+    def test_rejects_anything_else(self):
+        for raw in ["", "45", "m", "h", "1.5h", "1h60", "1h-30", "-45m", "45 minutes", "1d", "1h 30m 5s"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
