@@ -0,0 +1,144 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, ATTENDED, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+# 2026-10-12 is a Monday. Mid-October Auckland is NZDT (UTC+13).
+MONDAY = datetime.date(2026, 10, 12)
+SATURDAY = datetime.date(2026, 10, 17)
+SUNDAY = datetime.date(2026, 10, 18)
+
+HB_THERAPIST = Therapist("T1", "Hana", "HB")
+NG_THERAPIST = Therapist("T2", "Ned", "NG")
+
+
+def at(day, hh, mm):
+    """A UTC instant for a given Auckland local date and time (NZDT, UTC+13)."""
+    start = datetime.datetime(day.year, day.month, day.day, hh, mm)
+    return (start - datetime.timedelta(hours=13)).replace(tzinfo=datetime.timezone.utc)
+
+
+def t(hh, mm):
+    return datetime.time(hh, mm)
+
+
+def quarter_hours(first, last):
+    """Every quarter-hour start from first to last inclusive, as times."""
+    out = []
+    current = datetime.datetime(2026, 1, 1, first.hour, first.minute)
+    end = datetime.datetime(2026, 1, 1, last.hour, last.minute)
+    while current <= end:
+        out.append(current.time())
+        current += datetime.timedelta(minutes=15)
+    return out
+
+
+class FreeSlotsOpeningHoursTest(unittest.TestCase):
+    def test_empty_weekday_followup_runs_07_30_to_17_30(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, quarter_hours(t(7, 30), t(17, 30)))
+
+    def test_empty_weekday_assessment_must_finish_by_18_00(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 15))
+
+    def test_saturday_only_northgate_open_08_to_12(self):
+        self.assertEqual(free_slots(Calendar(), NG_THERAPIST, SATURDAY, FOLLOWUP),
+                         quarter_hours(t(8, 0), t(11, 30)))
+        self.assertEqual(free_slots(Calendar(), NG_THERAPIST, SATURDAY, ASSESSMENT)[-1], t(11, 15))
+
+    def test_saturday_closed_for_harbour_and_westwick(self):
+        self.assertEqual(free_slots(Calendar(), HB_THERAPIST, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed_everywhere(self):
+        self.assertEqual(free_slots(Calendar(), NG_THERAPIST, SUNDAY, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HB_THERAPIST, SUNDAY, ASSESSMENT), [])
+
+    def test_result_is_sorted_times(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB_THERAPIST, MONDAY, "massage")
+
+
+class FreeSlotsBookingsTest(unittest.TestCase):
+    def test_followup_blocks_only_its_own_30_minutes(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 0), slots)
+        self.assertNotIn(t(9, 45), slots)
+        self.assertIn(t(9, 30), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_assessment_needs_15_minutes_notes_gap_after_it(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10, 0), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        # 10:00-10:45 assessment plus 15 minutes of notes is busy until 11:00.
+        self.assertIn(t(9, 30), slots)  # followup 09:30-10:00 ends as the assessment starts
+        self.assertNotIn(t(9, 45), slots)
+        self.assertNotIn(t(10, 30), slots)
+        self.assertNotIn(t(10, 45), slots)
+        self.assertIn(t(11, 0), slots)
+
+    def test_new_assessment_before_existing_one_needs_its_own_notes_gap(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT)
+        # 09:00-09:45 then 15 minutes of notes ends exactly at 10:00, so it fits.
+        self.assertIn(t(9, 0), slots)
+        self.assertNotIn(t(9, 15), slots)
+
+    def test_existing_assessment_gap_blocks_new_assessment_after(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10, 0), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertNotIn(t(10, 45), slots)
+        self.assertIn(t(11, 0), slots)
+
+    def test_new_appointment_never_overlaps_booked_one(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 15), slots)
+
+    def test_cancelled_attended_and_no_show_do_not_block(self):
+        cal = Calendar([
+            appt("c", at(MONDAY, 10, 0), kind=ASSESSMENT, therapist="T1", status=CANCELLED,
+                 cancelled_at=utc(2026, 10, 1)),
+            appt("v", at(MONDAY, 12, 0), kind=ASSESSMENT, therapist="T1", status=ATTENDED),
+        ])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertIn(t(10, 0), slots)
+        self.assertIn(t(12, 0), slots)
+
+    def test_other_therapists_bookings_do_not_block(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10, 0), kind=ASSESSMENT, therapist="T9")])
+        self.assertEqual(free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT),
+                         free_slots(Calendar(), HB_THERAPIST, MONDAY, ASSESSMENT))
+
+    def test_booking_is_matched_on_local_date_across_utc_midnight(self):
+        # 09:00 Monday local is Sunday 20:00 UTC, which is still Monday in Auckland.
+        cal = Calendar([appt("a1", utc(2026, 10, 11, 20, 0), kind=FOLLOWUP, therapist="T1")])
+        self.assertNotIn(t(9, 0), free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_daily_limit_of_eight_appointments_closes_the_day(self):
+        booked = [appt(f"f{i}", at(MONDAY, 8 + i, 0), kind=FOLLOWUP, therapist="T1") for i in range(8)]
+        self.assertEqual(free_slots(Calendar(booked), HB_THERAPIST, MONDAY, FOLLOWUP), [])
+
+    def test_seven_appointments_still_leaves_room(self):
+        booked = [appt(f"f{i}", at(MONDAY, 8 + i, 0), kind=FOLLOWUP, therapist="T1") for i in range(7)]
+        self.assertIn(t(17, 0), free_slots(Calendar(booked), HB_THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_cancelled_appointments_do_not_count_towards_limit(self):
+        booked = [appt(f"f{i}", at(MONDAY, 8 + i, 0), kind=FOLLOWUP, therapist="T1") for i in range(7)]
+        booked.append(appt("x", at(MONDAY, 17, 0), kind=FOLLOWUP, therapist="T1", status=CANCELLED,
+                           cancelled_at=utc(2026, 10, 1)))
+        self.assertNotEqual(free_slots(Calendar(booked), HB_THERAPIST, MONDAY, FOLLOWUP), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
