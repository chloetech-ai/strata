+"""Finding start times at which a new appointment can be booked."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP, KINDS
+
+# Every appointment starts on a quarter hour.
+START_STEP = datetime.timedelta(minutes=15)
+
+# How long each kind of appointment takes.
+LENGTHS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+# Time the therapist needs after an appointment, before the next patient, to write notes.
+NOTES_GAP = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+
+# Union agreement: no therapist sees more patients than this in a day.
+MAX_APPOINTMENTS_PER_DAY = 8
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+SATURDAY_HOURS = (datetime.time(8, 0), datetime.time(12, 0))
+SATURDAY_CLINICS = ("NG",)  # only Northgate opens on Saturdays
+
+
+def _opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a date, or None if it is closed.
+
+    Public holidays are not handled yet.
+    """
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5 and clinic in SATURDAY_CLINICS:
+        return SATURDAY_HOURS
+    return None
+
+
+def _local_naive(moment):
+    """A timezone-aware datetime as a naive clinic-local wall-clock datetime."""
+    return moment.astimezone(CLINIC_TZ).replace(tzinfo=None)
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) at which a new appointment of this kind
+    could be booked for the therapist on a local (Pacific/Auckland) date.
+
+    A slot is free when the new appointment, plus its own notes gap, fits inside
+    the clinic's opening hours and does not touch any booked appointment for the
+    therapist, including that appointment's notes gap. Nothing is returned on a
+    day the clinic is closed or once the therapist has reached the daily limit.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = _opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status == BOOKED]
+    if len(booked) >= MAX_APPOINTMENTS_PER_DAY:
+        return []
+
+    busy = []
+    for a in booked:
+        start = _local_naive(a.start)
+        busy.append((start, start + LENGTHS[a.kind] + NOTES_GAP[a.kind]))
+
+    length = LENGTHS[kind]
+    gap = NOTES_GAP[kind]
+    open_at, close_at = (datetime.datetime.combine(day, t) for t in hours)
+
+    times = []
+    start = open_at
+    while start + length <= close_at:
+        needed_until = start + length + gap
+        if all(needed_until <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            times.append(start.time())
+        start += START_STEP
+    return times
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..4891279
