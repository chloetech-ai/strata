+def next_invoice_number(clinic, year, existing):
+    """Next number in the INV-<clinic>-<year>-<sequence> series.
+
+    The sequence is counted per clinic and restarts at 00001 each year, so only
+    numbers for this clinic and year are considered. `existing` may hold numbers
+    from any clinic or year; ones that don't fit the pattern are ignored.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year:04d}-(\d{{{SEQUENCE_DIGITS}}})")
+    issued = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    nxt = max(issued, default=0) + 1
+    if nxt >= 10 ** SEQUENCE_DIGITS:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"INV-{clinic}-{year:04d}-{nxt:0{SEQUENCE_DIGITS}d}"
+
