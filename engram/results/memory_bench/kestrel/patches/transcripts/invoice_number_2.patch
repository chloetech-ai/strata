+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_existing_sequence(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00041"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00042")
+
+    def test_ignores_other_clinics_and_years(self):
+        existing = ["INV-HB-2026-00007", "INV-TU-2026-00090", "INV-HB-2025-00500"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+        self.assertEqual(next_invoice_number("TU", 2026, existing), "INV-TU-2026-00091")
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_clinic_code_is_matched_exactly(self):
+        # "H" must not pick up "HB" numbers, and vice versa
+        existing = ["INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("H", 2026, existing), "INV-H-2026-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-HB-2026-7", "INV-HB-2026-000012", "XINV-HB-2026-00009", "INV-HB-2026-00004x"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_raises_when_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
