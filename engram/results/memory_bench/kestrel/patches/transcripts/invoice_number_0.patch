+def next_invoice_number(clinic, year, existing):
+    """Next INV-<clinic>-<year>-<sequence> number.
+
+    The sequence counts per clinic and year, so only numbers with this clinic
+    and year are considered; numbers from other clinics or years are ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    pattern = re.compile(re.escape(prefix) + r"(\d{5})")
+    sequences = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    sequence = max(sequences, default=0) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{sequence:05d}"
+
+
