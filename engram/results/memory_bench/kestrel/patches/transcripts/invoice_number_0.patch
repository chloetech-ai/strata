+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_highest_sequence_for_clinic_and_year(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00007", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_ignores_other_clinics_and_years(self):
+        existing = ["INV-KA-2026-00050", "INV-HB-2025-00099", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_restarts_each_year(self):
+        self.assertEqual(next_invoice_number("HB", 2027, ["INV-HB-2026-00042"]), "INV-HB-2027-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-HB-2026-0008x", "INV-HB-2026-123456", "INV-HB-2026-", "HB-2026-00005"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_rejects_when_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-99999"])
+
