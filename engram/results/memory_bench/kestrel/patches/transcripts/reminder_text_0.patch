+"""Text of the SMS reminders sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Friendly reminder for an appointment, with only the date, time and clinic name.
+
+    The treatment and the patient's name are deliberately left out, by privacy rule.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi, this is a friendly reminder of your appointment at {clinic} "
+        f"on {when}. We look forward to seeing you! "
+        f"If you need to change it, please contact the clinic as soon as you can."
+    )
