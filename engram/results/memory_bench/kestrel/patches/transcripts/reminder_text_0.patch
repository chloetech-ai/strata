+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_clinic_local_date_and_time(self):
+        # 2027-03-01 20:30 UTC is 09:30 on 2 March in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 20, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 2 March at 9:30am", text)
+
+    def test_afternoon_time_uses_12_hour_clock(self):
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 2, 5), clinic="NG"))
+        # 02:05 UTC is 15:05 in Auckland.
+        self.assertIn("at 3:05pm", text)
+
+    def test_midnight_is_twelve_am(self):
+        # 11:00 UTC is 00:00 on 2 March in Auckland.
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 11, 0), clinic="WK"))
+        self.assertIn("at 12:00am", text)
+
+    def test_leaves_out_treatment_and_patient_name(self):
+        text = reminder_text(appt("a1", utc(2027, 3, 1, 20), treatment="lower back pain", patient="KP-004211"))
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
