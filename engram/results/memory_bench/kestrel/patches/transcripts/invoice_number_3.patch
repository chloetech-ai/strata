         amount_cents=amount_cents,
         description=description,
     )
+
+
+def next_invoice_number(clinic, year, existing):
+    """Next number in the INV-<clinic>-<year>-<sequence> series.
+
+    The sequence is counted per clinic and year, from 00001. Numbers in
+    `existing` for other clinics or years are ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = []
+    for number in existing:
+        digits = number[len(prefix):]
+        if number.startswith(prefix) and len(digits) == 5 and all("0" <= c <= "9" for c in digits):
+            sequences.append(int(digits))
+    next_sequence = max(sequences, default=0) + 1
+    if next_sequence > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{next_sequence:05d}"
