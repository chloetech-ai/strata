+"""Working with time intervals, such as busy periods on a calendar."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs into sorted, non-overlapping pairs.
+
+    Input may be in any order. Pairs that overlap or touch are merged,
+    so [(1, 3), (3, 5)] becomes [(1, 5)].
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
