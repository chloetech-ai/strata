+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the reminder for an appointment.
+
+    Only the clinic name, date and time go in the text. The treatment and the
+    patient's name are left out on purpose, since the reminder is an SMS.
+    """
+    start = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    day = f"{start:%A} {start.day} {start:%B}"
+    hour = start.hour % 12 or 12
+    suffix = "am" if start.hour < 12 else "pm"
+    time = f"{hour}:{start.minute:02d}{suffix}"
+    return (
+        f"{clinic}: friendly reminder of your appointment on {day} at {time}. "
+        "See you then! To change it, please call the clinic."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
