@@ -0,0 +1,41 @@
+import datetime
+import unittest
+
+from kestrel.calendar import CLINIC_TZ
+from kestrel.reminders import reminder_text
+
+from helpers import appt
+
+
+class ReminderTextTest(unittest.TestCase):
+    def local(self, y, m, d, hh, mm):
+        return datetime.datetime(y, m, d, hh, mm, tzinfo=CLINIC_TZ)
+
+    def test_gives_clinic_day_and_time(self):
+        a = appt("A1", self.local(2026, 10, 15, 14, 30), clinic="NG")
+        self.assertEqual(
+            reminder_text(a),
+            "Kestrel Physio Northgate: friendly reminder of your appointment on Thursday 15 October at 2:30pm. "
+            "See you then! To change it, please call the clinic.",
+        )
+
+    def test_morning_time_and_utc_start_shown_in_clinic_time(self):
+        # 21:00 UTC on 14 Oct is 10:00am on 15 Oct in Auckland (NZDT, UTC+13).
+        a = appt("A2", datetime.datetime(2026, 10, 14, 21, 0, tzinfo=datetime.timezone.utc), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October at 10:00am", text)
+
+    def test_midnight_is_12am_and_noon_is_12pm(self):
+        self.assertIn("at 12:00am", reminder_text(appt("A3", self.local(2026, 10, 15, 0, 0))))
+        self.assertIn("at 12:05pm", reminder_text(appt("A4", self.local(2026, 10, 15, 12, 5))))
+
+    def test_omits_treatment_and_patient_details(self):
+        a = appt("A5", self.local(2026, 10, 15, 9, 0), treatment="lower back pain", patient="KP-004211")
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
