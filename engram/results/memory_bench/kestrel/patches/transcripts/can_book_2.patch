+"""Checks run by the booking form before an appointment is saved."""
+
+import datetime
+
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added without double-booking the therapist.
+
+    The appointment must be for this therapist, and its time must not overlap
+    any booked appointment for them. Cancelled, attended and no-show
+    appointments don't block the slot. An entry with the same id as the
+    appointment is ignored, so a check on an existing booking doesn't clash
+    with itself.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    start, end = appointment.start, _end(appointment)
+    for other in calendar.for_therapist(therapist.id):
+        if other.id == appointment.id or other.status != BOOKED:
+            continue
+        if start < _end(other) and other.start < end:
+            return False
+    return True
diff --git a/tests/test_booking.py b/tests/test_booking.py
