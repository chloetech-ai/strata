+"""Reading durations typed in by reception."""
+
+import re
+
+_HOURS = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*m?)?")
+_MINUTES = re.compile(r"(\d+)\s*m")
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes."""
+    cleaned = text.strip().lower()
+    match = _HOURS.fullmatch(cleaned)
+    if match is not None:
+        hours, minutes = match.group(1), match.group(2) or "0"
+        if int(minutes) > 59:
+            raise ValueError(f"minutes after the hour must be under 60: {text!r}")
+        return int(hours) * 60 + int(minutes)
+    match = _MINUTES.fullmatch(cleaned)
+    if match is not None:
+        return int(match.group(1))
+    raise ValueError(f"not a duration: {text!r}")
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
