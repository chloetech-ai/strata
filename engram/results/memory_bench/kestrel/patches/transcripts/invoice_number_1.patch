+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_continues_from_highest_sequence(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00007", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_restarts_each_year(self):
+        self.assertEqual(next_invoice_number("HB", 2027, ["INV-HB-2026-00041"]), "INV-HB-2027-00001")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-WN-2026-00009", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+        self.assertEqual(next_invoice_number("WN", 2026, existing), "INV-WN-2026-00010")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-HB-2026-0005", "INV-HB-2026-00002-x", "HB-2026-00009", "INV-HBX-2026-00009"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_raises_when_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
