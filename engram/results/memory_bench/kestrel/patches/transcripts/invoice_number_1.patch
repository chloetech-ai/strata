+def next_invoice_number(clinic, year, existing):
+    """Next INV-<clinic>-<year>-<sequence> number, given all numbers issued so far.
+
+    The sequence is counted per clinic and restarts at 00001 each year.
+    Numbers for other clinics or years are ignored.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year:04d}-(\d{{5}})")
+    sequences = [int(m.group(1)) for n in existing if (m := pattern.fullmatch(n))]
+    sequence = max(sequences, default=0) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"INV-{clinic}-{year:04d}-{sequence:05d}"
+
