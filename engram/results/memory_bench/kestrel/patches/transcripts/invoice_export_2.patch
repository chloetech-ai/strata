+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+
+FIELDS = ["number", "clinic", "issued", "patient_id", "patient_name", "description", "amount"]
+
+
+def _dollars(cents):
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV file in out_dir.
+
+    Invoices are matched on their issue date, which is already the clinic-local
+    date. Rows are sorted by invoice number and amounts are written in dollars
+    with two decimal places. Returns the path of the file written.
+    """
+    chosen = sorted(
+        (inv for inv in invoices if inv.issued.year == year and inv.issued.month == month),
+        key=lambda inv: inv.number,
+    )
+    path = os.path.join(out_dir, f"invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.DictWriter(f, fieldnames=FIELDS)
+        writer.writeheader()
+        for inv in chosen:
+            writer.writerow({
+                "number": inv.number,
+                "clinic": inv.clinic,
+                "issued": inv.issued.isoformat(),
+                "patient_id": inv.patient_id,
+                "patient_name": inv.patient_name,
+                "description": inv.description,
+                "amount": _dollars(inv.amount_cents),
+            })
+    return path
