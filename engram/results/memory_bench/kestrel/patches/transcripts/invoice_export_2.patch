+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents, clinic="HB", description=""):
+    return Invoice(
+        number=number, clinic=clinic, patient_id="KP-004211", patient_name="Aroha Ngata",
+        issued=issued, amount_cents=amount_cents, description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.out_dir = tempfile.mkdtemp()
+
+    def read_rows(self, path):
+        with open(path, encoding="utf-8", newline="") as f:
+            return list(csv.DictReader(f))
+
+    def test_writes_only_invoices_issued_in_the_month(self):
+        invoices = [
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 3), 7000),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30), 9500),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 11, 1), 7000),
+            invoice("INV-HB-2025-00009", datetime.date(2025, 10, 15), 7000),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        rows = self.read_rows(path)
+        self.assertEqual([r["number"] for r in rows], ["INV-HB-2026-00002"])
+
+    def test_returns_path_in_out_dir_named_by_month(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_only_when_no_invoices_in_month(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 9, 1), 7000)], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8", newline="") as f:
+            self.assertEqual(f.read().splitlines(), ["number,clinic,issued,patient_id,patient_name,description,amount"])
+
+    def test_row_contents_and_amount_in_dollars(self):
+        inv = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15), 7000, description="Follow-up: Ankle")
+        rows = self.read_rows(export_invoices([inv], 2026, 10, self.out_dir))
+        self.assertEqual(rows, [{
+            "number": "INV-HB-2026-00001", "clinic": "HB", "issued": "2026-10-15",
+            "patient_id": "KP-004211", "patient_name": "Aroha Ngata",
+            "description": "Follow-up: Ankle", "amount": "70.00",
+        }])
+
+    def test_amount_keeps_cents_and_sign(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), 9505),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2), -700),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 3), 5),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r["amount"] for r in rows], ["95.05", "-7.00", "0.05"])
+
+    def test_rows_sorted_by_invoice_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00010", datetime.date(2026, 10, 1), 7000),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2), 7000),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r["number"] for r in rows], ["INV-HB-2026-00002", "INV-HB-2026-00010"])
+
+    def test_description_with_comma_is_quoted(self):
+        inv = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), 7000, description="Assessment: knee, left")
+        rows = self.read_rows(export_invoices([inv], 2026, 10, self.out_dir))
+        self.assertEqual(rows[0]["description"], "Assessment: knee, left")
+
+
+if __name__ == "__main__":
+    unittest.main()
