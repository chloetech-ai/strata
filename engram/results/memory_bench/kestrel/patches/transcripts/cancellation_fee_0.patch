+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)  # cancelling inside this window is a late cancellation
+LATE_CANCELLATION_PERCENT = 50  # of the session price
+NO_SHOW_PERCENT = 100
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for an appointment that was cancelled or missed.
+
+    A cancelled appointment costs LATE_CANCELLATION_PERCENT of the session price
+    if it was cancelled less than LATE_CANCELLATION_WINDOW before the start, and
+    nothing otherwise. ``cancelled_at`` defaults to the appointment's own
+    cancelled_at. A no-show pays NO_SHOW_PERCENT of the session price; its
+    ``cancelled_at`` is not used.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price * NO_SHOW_PERCENT // 100
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError("cancelled appointment has no cancelled_at time")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price * LATE_CANCELLATION_PERCENT // 100
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..63b085f
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,61 @@
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+from helpers import appt, utc
+
+START = utc(2027, 3, 1, 20)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", START, status=CANCELLED, cancelled_at=utc(2027, 2, 27, 19))
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 27, 19, 1)), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 27, 20)), 0)
+
+    def test_cancelled_inside_48_hours_is_half_the_session_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 27, 20, 1)), 4750)
+
+    def test_late_followup_cancellation_is_35_dollars(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 28, 9)), 3500)
+
+    def test_cancelled_after_start_is_late(self):
+        a = appt("a1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 21)), 3500)
+
+    def test_defaults_to_the_appointments_cancelled_at(self):
+        a = appt("a1", START, status=CANCELLED, cancelled_at=utc(2027, 2, 28, 9))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_argument_overrides_the_appointments_cancelled_at(self):
+        a = appt("a1", START, status=CANCELLED, cancelled_at=utc(2027, 2, 28, 9))
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 20)), 0)
+
+    def test_cancelled_without_a_time_is_rejected(self):
+        a = appt("a1", START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+        self.assertEqual(cancellation_fee(appt("a2", START, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+
+    def test_no_show_ignores_cancelled_at(self):
+        a = appt("a1", START, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a, None), 7000)
+
+    def test_other_statuses_are_rejected(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", START, status=status))
+
+
+if __name__ == "__main__":
+    unittest.main()
