diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index cd6f931..a3e325f 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -53,6 +53,12 @@ class Calendar:
         patient_id = normalize_patient_id(patient_id)
         return [a for a in self.all() if a.patient_id == patient_id]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def for_day(self, therapist_id, day):
         """A therapist's appointments on a local (Pacific/Auckland) date, in start order."""
         return [a for a in self.for_therapist(therapist_id) if a.start.astimezone(CLINIC_TZ).date() == day]
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 2edc833..344b2c6 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -132,6 +132,31 @@ class CalendarTest(unittest.TestCase):
             cal.move("a1", datetime.datetime(2027, 3, 2, 20))
         self.assertEqual(cal.get("a1").start, utc(2027, 3, 1, 20))
 
+    def test_upcoming_booked_after_now_soonest_first(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("late", utc(2027, 3, 3, 9)),
+            appt("soon", utc(2027, 3, 2, 9)),
+            appt("past", utc(2027, 3, 1, 9)),
+            appt("at_now", utc(2027, 3, 1, 12)),
+            appt("cancelled", utc(2027, 3, 2, 10), status="cancelled"),
+            appt("other_patient", utc(2027, 3, 2, 11), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "late"])
+
+    def test_upcoming_accepts_messy_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp4211 ", utc(2027, 3, 1, 12))], ["a1"])
+
+    def test_upcoming_empty(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9))])
+        self.assertEqual(cal.upcoming("KP-000002", utc(2027, 3, 1, 12)), [])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 12))
+
 
 if __name__ == "__main__":
     unittest.main()
