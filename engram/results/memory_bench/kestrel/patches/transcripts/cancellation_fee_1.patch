@@ -0,0 +1,28 @@
+"""Cancellation fees, in cents."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for a cancelled or no-show appointment.
+
+    A no-show pays the full session price. A cancellation made less than
+    48 hours before the start pays 50% of the session price; an earlier
+    cancellation is free. For a no-show, `cancelled_at` is not used.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled_at is required to price a cancellation")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return session_price(appointment.kind) // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..35b8b70
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,67 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import CLINIC_TZ
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, FOLLOWUP
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 10, 9)
+
+    def test_cancel_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", self.start, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 8, 59)), 0)
+
+    def test_cancel_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", self.start, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9)), 0)
+
+    def test_cancel_under_48_hours_ahead_costs_half_the_price(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9, 1)), 3500)
+
+    def test_late_cancel_of_assessment_uses_assessment_price(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 9)), 4750)
+
+    def test_cancel_after_start_costs_half_the_price(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 10)), 3500)
+
+    def test_window_is_measured_in_absolute_time_not_local_time(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status="cancelled")
+        # 09:00 UTC on 10 March is 22:00 on 8 March in Auckland (NZDT, +13): exactly 48 hours before start
+        self.assertEqual(cancellation_fee(a, datetime.datetime(2027, 3, 8, 22, 0, tzinfo=CLINIC_TZ)), 0)
+        self.assertEqual(cancellation_fee(a, datetime.datetime(2027, 3, 8, 22, 1, tzinfo=CLINIC_TZ)), 3500)
+
+    def test_cancelled_without_time_is_rejected(self):
+        a = appt("a1", self.start, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_cancelled_with_naive_time_is_rejected(self):
+        a = appt("a1", self.start, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, self.start.replace(tzinfo=None))
+
+    def test_no_show_pays_full_price_regardless_of_cancelled_at(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status="no_show")
+        self.assertEqual(cancellation_fee(a), 7000)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 9)), 7000)
+
+    def test_no_show_assessment_pays_full_price(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status="no_show")
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_other_statuses_have_no_fee(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                a = appt("a1", self.start, status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
