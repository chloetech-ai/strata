@@ -0,0 +1,28 @@
+"""SMS appointment reminders."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment. It gives the clinic, date and time only, never the treatment."""
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return (f"Reminder: you have an appointment at {clinic} on {local:%A} {local.day} {local:%B} "
+            f"at {local:%H:%M}. Please contact the clinic if you need to change it.")
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment and return the number of messages sent.
+
+    patients maps patient ID to Patient. Every patient is looked up before anything is sent,
+    so an unknown patient ID raises KeyError without sending any messages.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
