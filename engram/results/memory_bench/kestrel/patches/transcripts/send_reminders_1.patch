@@ -0,0 +1,63 @@
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, Appointment, Patient
+from kestrel.reminders import send_reminders
+
+from helpers import utc
+
+
+class FakeClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        self.batches.append(list(messages))
+        return [{"ok": True}]
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.patients = {
+            "KP-000001": Patient("KP-000001", "Ana Silva", "+64211234567"),
+            "KP-000002": Patient("KP-000002", "Ben Ito", "+64219876543"),
+        }
+        self.client = FakeClient()
+
+    def appt(self, id, patient="KP-000001", status="booked", **kw):
+        return Appointment(id=id, patient_id=patient, therapist_id="T1", clinic="HB",
+                           start=utc(2026, 3, 3, 1, 30), kind="followup", treatment="lower back pain",
+                           status=status, **kw)
+
+    def test_sends_one_message_per_booked_appointment_and_returns_count(self):
+        sent = send_reminders([self.appt("A1"), self.appt("A2", patient="KP-000002")], self.patients, self.client)
+        self.assertEqual(sent, 2)
+        self.assertEqual([phone for phone, _ in self.client.batches[0]], ["+64211234567", "+64219876543"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [self.appt("A1"), self.appt("A2", status=CANCELLED), self.appt("A3", status=ATTENDED)]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 1)
+        self.assertEqual(len(self.client.batches[0]), 1)
+
+    def test_no_booked_appointments_sends_nothing_and_returns_zero(self):
+        self.assertEqual(send_reminders([self.appt("A1", status=CANCELLED)], self.patients, self.client), 0)
+        self.assertEqual(self.client.batches, [[]])
+
+    def test_text_gives_clinic_date_and_time_in_clinic_time_but_not_treatment(self):
+        send_reminders([self.appt("A1")], self.patients, self.client)
+        _, text = self.client.batches[0][0]
+        # 01:30 UTC on 3 March 2026 is 14:30 in Auckland (NZDT, UTC+13)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 3 March", text)
+        self.assertIn("14:30", text)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("Ana", text)
+
+    def test_unknown_patient_raises_before_anything_is_sent(self):
+        appointments = [self.appt("A1"), self.appt("A2", patient="KP-999999")]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, self.patients, self.client)
+        self.assertEqual(self.client.batches, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
