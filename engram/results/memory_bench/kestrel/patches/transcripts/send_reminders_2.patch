+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def _reminder_text(appointment):
+    """Date, time and clinic only. The treatment is never included."""
+    start = appointment.start.astimezone(CLINIC_TZ)
+    hour = start.hour % 12 or 12
+    meridiem = "am" if start.hour < 12 else "pm"
+    when = f"{start:%A} {start.day} {start:%B %Y} at {hour}:{start.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: you have an appointment at {clinic} on {when}. To change it, please call the clinic."
+
+
+def send_reminders(appointments, patients, client):
+    """Text each patient about their booked appointments. Returns the number of messages sent.
+
+    patients maps patient ID to Patient. Messages are all built before anything
+    is sent, so a missing patient raises without sending anything.
+    """
+    messages = [
+        (patients[a.patient_id].phone, _reminder_text(a))
+        for a in appointments
+        if a.status == BOOKED
+    ]
+    if messages:
+        client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
