+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP, KINDS
+
+# Clinic opening hours, Pacific/Auckland local time. Saturday: Northgate only.
+WEEKDAY_HOURS = {
+    "NG": (datetime.time(7, 30), datetime.time(18, 0)),
+    "HB": (datetime.time(7, 30), datetime.time(18, 0)),
+    "WK": (datetime.time(7, 30), datetime.time(18, 0)),
+}
+SATURDAY_HOURS = {
+    "NG": (datetime.time(8, 0), datetime.time(12, 0)),
+}
+
+DURATION = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Notes time the therapist needs after an appointment of this kind, before the next patient.
+NOTES_GAP = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+
+SLOT_STEP = datetime.timedelta(minutes=15)  # every appointment starts on a quarter hour
+DAILY_CAP = 8  # union agreement: at most 8 patient appointments per therapist per day
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a date, or None if it is closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS.get(clinic)
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) at which a new appointment of this kind
+    could be booked for the therapist on a local (Pacific/Auckland) date.
+
+    A slot is free when the appointment itself fits inside opening hours, the notes gap
+    after it does not overlap another booked appointment (including that appointment's
+    notes gap), and the therapist is under the daily cap.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown session kind: {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status == BOOKED]
+    if len(booked) >= DAILY_CAP:
+        return []
+    busy = [(a.start, a.start + DURATION[a.kind] + NOTES_GAP[a.kind]) for a in booked]
+
+    opens = datetime.datetime.combine(day, hours[0], tzinfo=CLINIC_TZ)
+    closes = datetime.datetime.combine(day, hours[1], tzinfo=CLINIC_TZ)
+    length = DURATION[kind]
+    occupied = length + NOTES_GAP[kind]
+
+    slots = []
+    start = opens
+    while start + length <= closes:
+        end = start + occupied
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += SLOT_STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..29a0426
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,123 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+HB = Therapist("T1", "Ana", "HB")
+MONDAY = datetime.date(2026, 10, 19)  # Auckland is on NZDT (UTC+13) in October
+
+
+def local(hh, mm=0, day=MONDAY):
+    return datetime.datetime.combine(day, datetime.time(hh, mm), tzinfo=CLINIC_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+def quarter_hours(first, last):
+    """Every quarter-hour start from first to last inclusive, as datetime.time."""
+    out = []
+    minutes = first[0] * 60 + first[1]
+    while minutes <= last[0] * 60 + last[1]:
+        out.append(t(minutes // 60, minutes % 60))
+        minutes += 15
+    return out
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_followup_runs_to_last_start_before_close(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, quarter_hours((7, 30), (17, 30)))
+
+    def test_empty_weekday_assessment_must_end_by_close(self):
+        slots = free_slots(Calendar(), HB, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 15))
+
+    def test_results_are_datetime_times_sorted(self):
+        slots = free_slots(Calendar([appt("a1", local(10), kind=FOLLOWUP)]), HB, MONDAY, FOLLOWUP)
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_saturday_only_northgate_open_8_to_12(self):
+        ng = Therapist("T2", "Ben", "NG")
+        slots = free_slots(Calendar(), ng, datetime.date(2026, 10, 17), FOLLOWUP)
+        self.assertEqual(slots, quarter_hours((8, 0), (11, 30)))
+
+    def test_saturday_other_clinics_closed(self):
+        for clinic in ["HB", "WK"]:
+            with self.subTest(clinic=clinic):
+                therapist = Therapist("T3", "Cy", clinic)
+                self.assertEqual(free_slots(Calendar(), therapist, datetime.date(2026, 10, 17), FOLLOWUP), [])
+
+    def test_sunday_closed_everywhere(self):
+        sunday = datetime.date(2026, 10, 18)
+        for clinic in ["NG", "HB", "WK"]:
+            with self.subTest(clinic=clinic):
+                therapist = Therapist("T3", "Cy", clinic)
+                self.assertEqual(free_slots(Calendar(), therapist, sunday, ASSESSMENT), [])
+
+    def test_followup_blocks_only_its_own_30_minutes(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP)])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)
+        self.assertNotIn(t(9, 45), slots)
+        self.assertNotIn(t(10, 0), slots)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_assessment_blocks_45_minutes_plus_15_notes(self):
+        cal = Calendar([appt("a1", local(10), kind=ASSESSMENT)])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)  # ends at 10:00 exactly
+        self.assertNotIn(t(10, 45), slots)  # inside the notes gap
+        self.assertIn(t(11, 0), slots)  # first start after the gap
+
+    def test_new_assessment_must_leave_its_own_notes_gap_free(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP)])
+        slots = free_slots(cal, HB, MONDAY, ASSESSMENT)
+        # 09:15 would run 09:15 to 10:15 (45 + 15 notes) and hit the 10:00 follow-up.
+        self.assertIn(t(9, 0), slots)  # 09:00 to 10:00 fits in front of the follow-up
+        self.assertNotIn(t(9, 15), slots)
+        self.assertNotIn(t(9, 30), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(10), kind=ASSESSMENT, status="cancelled")])
+        self.assertIn(t(10, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(10), kind=ASSESSMENT, therapist="T2")])
+        self.assertIn(t(10, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_other_days_do_not_block(self):
+        cal = Calendar([appt("a1", local(10, day=datetime.date(2026, 10, 20)), kind=ASSESSMENT)])
+        self.assertIn(t(10, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_daily_cap_of_8_closes_the_day(self):
+        booked = [appt(f"a{i}", local(7, 30) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP) for i in range(8)]
+        self.assertEqual(free_slots(Calendar(booked), HB, MONDAY, FOLLOWUP), [])
+
+    def test_seven_booked_still_has_slots(self):
+        booked = [appt(f"a{i}", local(7, 30) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP) for i in range(7)]
+        self.assertNotEqual(free_slots(Calendar(booked), HB, MONDAY, FOLLOWUP), [])
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        booked = [appt(f"a{i}", local(7, 30) + datetime.timedelta(minutes=30 * i), kind=FOLLOWUP) for i in range(7)]
+        booked.append(appt("c1", local(12), kind=FOLLOWUP, status="cancelled"))
+        booked.append(appt("c2", local(12, 30), kind=FOLLOWUP, status="cancelled"))
+        self.assertNotEqual(free_slots(Calendar(booked), HB, MONDAY, FOLLOWUP), [])
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, MONDAY, "checkup")
+
+    def test_unknown_clinic_has_no_slots(self):
+        self.assertEqual(free_slots(Calendar(), Therapist("T9", "Di", "XX"), MONDAY, FOLLOWUP), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
