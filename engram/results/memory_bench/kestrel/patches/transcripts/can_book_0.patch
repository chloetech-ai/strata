@@ -0,0 +1,94 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+
+THERAPIST = Therapist("T1", "Ruth", "HB")
+DAY = datetime.date(2026, 10, 16)
+
+
+def local(hh, mm=0, ss=0):
+    """A clinic-local time on DAY (Auckland is UTC+13 in mid-October)."""
+    return datetime.datetime(DAY.year, DAY.month, DAY.day, hh, mm, ss, tzinfo=CLINIC_TZ)
+
+
+def new(id, start, kind=FOLLOWUP, therapist="T1"):
+    return appt(id, start, kind=kind, therapist=therapist)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, new("n", local(9))))
+
+    def test_other_therapists_appointment_is_rejected(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, new("n", local(9), therapist="T2")))
+
+    def test_start_must_be_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, new("n", local(9, 10))))
+        self.assertFalse(can_book(Calendar(), THERAPIST, new("n", local(9, 0, 30))))
+        for minute in (0, 15, 30, 45):
+            with self.subTest(minute=minute):
+                self.assertTrue(can_book(Calendar(), THERAPIST, new("n", local(9, minute))))
+
+    def test_followup_overlap(self):
+        cal = Calendar([new("a", local(9))])  # 09:00-09:30
+        self.assertFalse(can_book(cal, THERAPIST, new("n", local(9, 15))))
+        self.assertTrue(can_book(cal, THERAPIST, new("n", local(9, 30))))
+
+    def test_assessment_needs_notes_gap_after_it(self):
+        cal = Calendar([new("a", local(9), kind=ASSESSMENT)])  # 09:00-09:45, notes until 10:00
+        self.assertFalse(can_book(cal, THERAPIST, new("n", local(9, 30))))
+        self.assertFalse(can_book(cal, THERAPIST, new("n", local(9, 45))))
+        self.assertTrue(can_book(cal, THERAPIST, new("n", local(10))))
+
+    def test_no_gap_after_followup(self):
+        cal = Calendar([new("a", local(9))])
+        self.assertTrue(can_book(cal, THERAPIST, new("n", local(9, 30))))
+
+    def test_new_assessment_needs_gap_before_next_appointment(self):
+        cal = Calendar([new("a", local(10))])
+        # 09:15 assessment would hold the room until 10:15, overlapping the 10:00 follow-up.
+        self.assertFalse(can_book(cal, THERAPIST, new("n", local(9, 15), kind=ASSESSMENT)))
+        # 09:00 assessment ends 09:45 with notes until 10:00, which is fine.
+        self.assertTrue(can_book(cal, THERAPIST, new("n", local(9), kind=ASSESSMENT)))
+
+    def test_new_assessment_gap_blocks_next_start(self):
+        cal = Calendar([new("a", local(10, 15))])
+        # 09:30 assessment holds the room until 10:30 (with notes), overlapping 10:15.
+        self.assertFalse(can_book(cal, THERAPIST, new("n", local(9, 30), kind=ASSESSMENT)))
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([new("a", local(9))])
+        cal.cancel("a", datetime.datetime(2026, 10, 1, tzinfo=CLINIC_TZ))
+        self.assertTrue(can_book(cal, THERAPIST, new("n", local(9))))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([new("a", local(9), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, new("n", local(9))))
+
+    def test_rebooking_same_id_does_not_block_itself(self):
+        cal = Calendar([new("a", local(9))])
+        self.assertTrue(can_book(cal, THERAPIST, new("a", local(9))))
+
+    def test_daily_cap_of_eight(self):
+        seven = [new(f"a{k}", local(9) + k * datetime.timedelta(minutes=30)) for k in range(7)]  # starts 09:00 to 12:00
+        self.assertTrue(can_book(Calendar(seven), THERAPIST, new("n", local(12, 30))))
+
+        eight = seven + [new("a7", local(12, 30))]
+        self.assertFalse(can_book(Calendar(eight), THERAPIST, new("n", local(13))))
+
+    def test_daily_cap_ignores_cancelled_and_other_days(self):
+        cal = Calendar(
+            [new(f"a{k}", local(9) + k * datetime.timedelta(minutes=30)) for k in range(7)]
+            + [new("c", local(12, 30))]
+            + [new("d", datetime.datetime(2026, 10, 17, 9, tzinfo=CLINIC_TZ))]
+        )
+        cal.cancel("c", datetime.datetime(2026, 10, 1, tzinfo=CLINIC_TZ))
+        self.assertTrue(can_book(cal, THERAPIST, new("n", local(12, 30))))
+
+
+if __name__ == "__main__":
+    unittest.main()
