+"""Booking rules for the appointment form."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Notes time the therapist needs before the next patient.
+GAP_AFTER = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+START_MINUTES = (0, 15, 30, 45)
+# Union agreement: patient appointments per therapist per clinic-local day.
+DAILY_CAP = 8
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist.
+
+    The appointment must be for this therapist, start on a quarter hour
+    (clinic-local time), leave the notes gap around every other live
+    appointment, and keep the therapist within DAILY_CAP on that day.
+    Cancelled appointments are ignored.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute not in START_MINUTES or local_start.second or local_start.microsecond:
+        return False
+
+    new_start = appointment.start
+    new_block_end = new_start + DURATIONS[appointment.kind] + GAP_AFTER[appointment.kind]
+    for other in calendar.for_therapist(therapist.id):
+        if other.id == appointment.id or other.status == CANCELLED:
+            continue
+        other_block_start = other.start
+        other_block_end = other.start + DURATIONS[other.kind] + GAP_AFTER[other.kind]
+        if new_start < other_block_end and other_block_start < new_block_end:
+            return False
+
+    day = local_start.date()
+    booked_that_day = [
+        a for a in calendar.for_day(therapist.id, day)
+        if a.id != appointment.id and a.status != CANCELLED
+    ]
+    return len(booked_that_day) < DAILY_CAP
diff --git a/tests/test_booking.py b/tests/test_booking.py
