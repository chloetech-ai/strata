+"""Reading durations typed in by reception."""
+
+import re
+
+_DURATION = re.compile(r"(?:(\d+)m|(\d+)h(?:\s*(\d+)m?)?)")
+
+
+def parse_duration(text):
+    """Turn a duration such as '45m', '1h', '1h30' or '1h 30m' into minutes."""
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    minutes, hours, rest = match.groups()
+    if minutes is not None:
+        return int(minutes)
+    extra = int(rest) if rest is not None else 0
+    if extra >= 60:
+        raise ValueError(f"minutes must be under 60 after hours: {text!r}")
+    return int(hours) * 60 + extra
