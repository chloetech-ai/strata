diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index cd6f931..b0dda71 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -60,5 +60,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 2edc833..04ab5fc 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -132,6 +132,38 @@ class CalendarTest(unittest.TestCase):
             cal.move("a1", datetime.datetime(2027, 3, 2, 20))
         self.assertEqual(cal.get("a1").start, utc(2027, 3, 1, 20))
 
+    def test_upcoming_soonest_first_after_now(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("a2", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("a1", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("past", utc(2027, 2, 28, 9), patient="KP-004211"),
+            appt("other", utc(2027, 3, 2, 9), patient="KP-000001"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", now)], ["a1", "a2"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        now = utc(2027, 3, 2, 9)
+        cal = Calendar([appt("a1", now, patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-004211", now), [])
+
+    def test_upcoming_skips_cancelled_and_attended(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 2, 9), patient="KP-004211", status="cancelled"),
+            appt("a2", utc(2027, 3, 2, 10), patient="KP-004211", status="attended"),
+            appt("a3", utc(2027, 3, 2, 11), patient="KP-004211"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", utc(2027, 3, 1))], ["a3"])
+
+    def test_upcoming_accepts_messy_patient_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 1))], ["a1"])
+
+    def test_upcoming_requires_aware_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 1))
+
 
 if __name__ == "__main__":
     unittest.main()
