--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,84 @@
+import unittest
+
+from kestrel.models import CANCELLED, ATTENDED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Aroha Test", "+64211111111", csc=True),
+    "KP-000002": Patient("KP-000002", "Ben Test", "+64222222222"),
+}
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic(self):
+        # 01:30 UTC is 14:30 in Auckland (NZDT, UTC+13) on Thursday 15 October.
+        a = appt("A1", utc(2026, 10, 15, 1, 30), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Reminder: your appointment at Kestrel Physio Harbour is on Thursday 15 October at 2:30pm.",
+        )
+
+    def test_morning_uses_am_and_midnight_is_twelve(self):
+        a = appt("A1", utc(2026, 10, 14, 11, 5), clinic="NG")  # 00:05 NZDT on 15 October
+        self.assertIn("at 12:05am.", reminder_text(a))
+
+    def test_never_mentions_treatment(self):
+        a = appt("A1", utc(2026, 10, 15, 1, 30), treatment="lower back pain")
+        self.assertNotIn("back", reminder_text(a).lower())
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("secret", transport=self.transport)
+
+    def sent(self):
+        return [m for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_sends_one_sms_per_booked_appointment(self):
+        appts = [
+            appt("A1", utc(2026, 10, 15, 1, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 16, 1, 30), patient="KP-000002"),
+        ]
+        count = send_reminders(appts, PATIENTS, self.client)
+        self.assertEqual(count, 2)
+        self.assertEqual([m["to"] for m in self.sent()], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appts = [
+            appt("A1", utc(2026, 10, 15, 1, 30), patient="KP-000001", status=CANCELLED,
+                 cancelled_at=utc(2026, 10, 10)),
+            appt("A2", utc(2026, 10, 15, 2, 30), patient="KP-000002", status=ATTENDED),
+            appt("A3", utc(2026, 10, 16, 1, 30), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appts, PATIENTS, self.client), 1)
+        self.assertEqual([m["to"] for m in self.sent()], ["+64222222222"])
+
+    def test_no_appointments_sends_nothing(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_unknown_patient_sends_nothing(self):
+        appts = [
+            appt("A1", utc(2026, 10, 15, 1, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 16, 1, 30), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appts, PATIENTS, self.client)
+        self.assertEqual(self.transport.calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
