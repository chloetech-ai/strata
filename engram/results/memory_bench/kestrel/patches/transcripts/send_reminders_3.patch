+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment: date, time and clinic only. The treatment is never included."""
+    start = appointment.start.astimezone(CLINIC_TZ)
+    hour = start.hour % 12 or 12
+    meridiem = "am" if start.hour < 12 else "pm"
+    when = f"{start:%A} {start.day} {start:%B} at {hour}:{start.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: your appointment at {clinic} is on {when}."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of each booked appointment. Returns the number of messages sent.
+
+    patients maps patient ID to Patient; client is a BulkieClient. Every
+    message is built before anything is sent, so a missing patient or
+    clinic fails without sending anything.
+    """
+    messages = [
+        (patients[a.patient_id].phone, reminder_text(a))
+        for a in appointments
+        if a.status == BOOKED
+    ]
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
