+class AppointmentPriceTest(unittest.TestCase):
+    def test_before_change_uses_old_prices(self):
+        self.assertEqual(appointment_price(appt(ASSESSMENT, local(2027, 3, 1)), patient()), 9500)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2027, 3, 1)), patient()), 7000)
+
+    def test_late_evening_31_march_keeps_old_price(self):
+        start = local(2027, 3, 31, 23, 30)
+        self.assertEqual(appointment_price(appt(ASSESSMENT, start), patient()), 9500)
+
+    def test_first_moment_of_1_april_gets_new_price(self):
+        start = local(2027, 4, 1, 0, 0)
+        self.assertEqual(appointment_price(appt(ASSESSMENT, start), patient()), 10500)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, start), patient()), 7800)
+
+    def test_local_date_decides_not_utc(self):
+        # 1 April 08:00 in Auckland is 31 March 19:00 UTC: the new price applies.
+        start = local(2027, 4, 1, 8, 0)
+        self.assertEqual(start.astimezone(datetime.timezone.utc).date(), datetime.date(2027, 3, 31))
+        self.assertEqual(appointment_price(appt(FOLLOWUP, start), patient()), 7800)
+
+    def test_csc_discount_on_followups_only(self):
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2027, 3, 1)), patient(csc=True)), 5600)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2027, 4, 2)), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appt(ASSESSMENT, local(2027, 4, 2)), patient(csc=True)), 10500)
+
+    def test_appointment_must_belong_to_patient(self):
+        with self.assertRaises(ValueError):
+            appointment_price(appt(ASSESSMENT, local(2027, 4, 2)), patient(patient_id="KP-000002"))
+
+
