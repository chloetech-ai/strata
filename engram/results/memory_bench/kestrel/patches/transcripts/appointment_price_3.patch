@@ -7,6 +10,15 @@ PRICES_CENTS = {
     FOLLOWUP: 7000,
 }
 
+# Appointments on or after this clinic-local date pay NEW_PRICES_CENTS.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+CSC_FOLLOWUP_PERCENT_OFF = 20  # Community Services Card holders; follow-ups only
+
 
 def session_price(kind):
     """Price in cents for a session of the given kind ('assessment' or 'followup')."""
@@ -14,3 +26,18 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    The rate depends on the appointment's clinic-local date, not on when it was booked.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id} is not for patient {patient.id}")
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    prices = NEW_PRICES_CENTS if day >= NEW_PRICES_FROM else PRICES_CENTS
+    price = prices[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
+    return price
