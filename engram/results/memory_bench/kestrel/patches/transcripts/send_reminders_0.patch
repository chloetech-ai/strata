diff --git a/src/kestrel/reminders.py b/src/kestrel/reminders.py
new file mode 100644
index 0000000..1caff87
--- /dev/null
+++ b/src/kestrel/reminders.py
@@ -0,0 +1,31 @@
+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """Date, time and clinic only. The treatment is never included."""
+    start = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"{clinic}: reminder of your appointment on {start:%A} {start.day} {start:%B}"
+        f" at {start:%H:%M}. Please contact the clinic if you need to change it."
+    )
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment. Returns the number of messages sent.
+
+    patients maps patient ID to Patient. Each booked appointment gets its own
+    message, so a patient with two bookings gets two texts. Every patient is
+    looked up before anything is sent, so a missing patient sends nothing.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..d95b09b
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,83 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import CANCELLED, ATTENDED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+
+
+class FakeClient:
+    def __init__(self):
+        self.sent = []
+
+    def send_batch(self, messages):
+        self.sent.append(list(messages))
+        return [{"ok": True}]
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Alice Example", "+64211111111"),
+    "KP-000002": Patient("KP-000002", "Bob Example", "+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.client = FakeClient()
+
+    def test_one_message_per_booked_appointment(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 15, 20), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 16, 1), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 2)
+        (batch,) = self.client.sent
+        self.assertEqual([phone for phone, _ in batch], ["+64211111111", "+64222222222"])
+
+    def test_skips_cancelled_and_attended(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 1), patient="KP-000001", status=CANCELLED, cancelled_at=utc(2026, 10, 14)),
+            appt("a2", utc(2026, 10, 20, 2), patient="KP-000001", status=ATTENDED),
+            appt("a3", utc(2026, 10, 20, 3), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 1)
+        (batch,) = self.client.sent
+        self.assertEqual([phone for phone, _ in batch], ["+64222222222"])
+
+    def test_patient_with_two_bookings_gets_two_texts(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 1), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 27, 1), patient="KP-000001"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 2)
+
+    def test_no_bookings_sends_nothing(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.client.sent, [[]])
+
+    def test_missing_patient_sends_nothing(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 1), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 20, 2), patient="KP-000999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(self.client.sent, [])
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_date_time_and_clinic(self):
+        # 2026-10-19 09:00 NZDT is 2026-10-18 20:00 UTC.
+        text = reminder_text(appt("a1", utc(2026, 10, 18, 20), clinic="NG"))
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Monday 19 October", text)
+        self.assertIn("09:00", text)
+
+    def test_never_includes_treatment(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 18, 20), treatment="lower back pain"))
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("Assessment", text)
+        self.assertNotIn("Follow-up", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
