@@ -0,0 +1,51 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from kestrel.models import ASSESSMENT, Appointment
+from kestrel.reminders import reminder_text
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+
+
+def appt(start, clinic="HB", treatment="lower back pain"):
+    return Appointment(
+        id="A1", patient_id="KP-000001", therapist_id="T04", clinic=clinic,
+        start=start, kind=ASSESSMENT, treatment=treatment,
+    )
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_day_time_and_clinic(self):
+        start = datetime.datetime(2027, 3, 2, 14, 30, tzinfo=AUCKLAND)
+        text = reminder_text(appt(start))
+        self.assertIn("Tuesday 2 March", text)
+        self.assertIn("2:30pm", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+
+    def test_whole_hour_has_no_minutes(self):
+        start = datetime.datetime(2027, 3, 2, 9, 0, tzinfo=AUCKLAND)
+        self.assertIn("at 9am", reminder_text(appt(start)))
+
+    def test_midday_and_midnight_hours(self):
+        noon = datetime.datetime(2027, 3, 2, 12, 5, tzinfo=AUCKLAND)
+        midnight = datetime.datetime(2027, 3, 2, 0, 15, tzinfo=AUCKLAND)
+        self.assertIn("at 12:05pm", reminder_text(appt(noon)))
+        self.assertIn("at 12:15am", reminder_text(appt(midnight)))
+
+    def test_uses_clinic_local_time(self):
+        # 02:30 UTC on 2 March 2027 is 15:30 in Auckland (NZDT, UTC+13).
+        start = datetime.datetime(2027, 3, 2, 2, 30, tzinfo=datetime.timezone.utc)
+        text = reminder_text(appt(start))
+        self.assertIn("Tuesday 2 March", text)
+        self.assertIn("at 3:30pm", text)
+
+    def test_never_includes_treatment(self):
+        start = datetime.datetime(2027, 3, 2, 14, 30, tzinfo=AUCKLAND)
+        text = reminder_text(appt(start, treatment="lower back pain"))
+        self.assertNotIn("back", text.lower())
+        self.assertNotIn("pain", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
