+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the reminder for an appointment.
+
+    It gives the date, time and clinic name only. The treatment is never
+    included, per the privacy officer's rule for SMS reminders.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    day = f"{local.strftime('%A')} {local.day} {local.strftime('%B')}"
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    if local.minute:
+        clock = f"{hour}:{local.minute:02d}{suffix}"
+    else:
+        clock = f"{hour}{suffix}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! This is a friendly reminder of your appointment "
+        f"on {day} at {clock}. We look forward to seeing you. "
+        f"If you need to change it, please get in touch with the clinic."
+    )
