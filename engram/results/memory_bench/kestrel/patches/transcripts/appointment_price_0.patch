 }
 
+# Prices from 1 April 2027, for appointments on or after that clinic-local date.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+CSC_FOLLOWUP_PERCENT_OFF = 20
+
 
 def session_price(kind):
     """Price in cents for a session of the given kind ('assessment' or 'followup')."""
@@ -14,3 +26,20 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown session kind: {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    The price is the one in force on the appointment's clinic-local date.
+    Community Services Card holders get CSC_FOLLOWUP_PERCENT_OFF off follow-ups
+    only.
+    """
+    if appointment.patient_id != patient.id:
+        raise ValueError(f"appointment {appointment.id} does not belong to patient {patient.id}")
+    local_date = appointment.start.astimezone(CLINIC_TZ).date()
+    prices = NEW_PRICES_CENTS if local_date >= NEW_PRICES_FROM else PRICES_CENTS
+    price = prices[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
+    return price
