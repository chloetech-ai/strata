+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.patient = Patient("KP-000001", "Ana Silva", "+64211234567")
+        self.csc_patient = Patient("KP-000001", "Ana Silva", "+64211234567", csc=True)
+
+    def test_before_cutoff_keeps_old_prices(self):
+        self.assertEqual(appointment_price(appt(ASSESSMENT, local(2027, 3, 31, 10)), self.patient), 9500)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2027, 3, 31, 10)), self.patient), 7000)
+
+    def test_from_cutoff_uses_new_prices(self):
+        self.assertEqual(appointment_price(appt(ASSESSMENT, local(2027, 4, 1, 10)), self.patient), 10500)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2027, 4, 1, 10)), self.patient), 7800)
+
+    def test_late_evening_31_march_local_keeps_old_price(self):
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2027, 3, 31, 23, 0)), self.patient), 7000)
+
+    def test_early_morning_1_april_local_uses_new_price_even_though_utc_is_31_march(self):
+        start = local(2027, 4, 1, 0, 30)
+        self.assertEqual(start.astimezone(datetime.timezone.utc).date(), datetime.date(2027, 3, 31))
+        self.assertEqual(appointment_price(appt(ASSESSMENT, start), self.patient), 10500)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2026, 10, 15, 9)), self.csc_patient), 5600)
+        self.assertEqual(appointment_price(appt(FOLLOWUP, local(2027, 4, 1, 9)), self.csc_patient), 6240)
+
+    def test_csc_does_not_discount_assessments(self):
+        self.assertEqual(appointment_price(appt(ASSESSMENT, local(2026, 10, 15, 9)), self.csc_patient), 9500)
+        self.assertEqual(appointment_price(appt(ASSESSMENT, local(2027, 4, 1, 9)), self.csc_patient), 10500)
+
+    def test_appointment_for_another_patient_is_rejected(self):
+        with self.assertRaises(ValueError):
+            appointment_price(appt(FOLLOWUP, local(2026, 10, 15, 9), patient_id="KP-000002"), self.patient)
+
+
 if __name__ == "__main__":
