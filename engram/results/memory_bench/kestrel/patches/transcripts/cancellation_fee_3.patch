@@ -0,0 +1,65 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, FOLLOWUP, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 10, 9)
+
+    def test_cancel_inside_48_hours_costs_half_the_session(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 10)), 3500)
+
+    def test_assessment_late_cancel_is_half_of_95_dollars(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 8)), 4750)
+
+    def test_cancel_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", self.start, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 7, 8)), 0)
+
+    def test_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", self.start, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9)), 0)
+
+    def test_one_second_inside_the_window_is_charged(self):
+        a = appt("a1", self.start, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9) + datetime.timedelta(seconds=1)), 3500)
+
+    def test_cancel_after_start_is_charged(self):
+        a = appt("a1", self.start, status="cancelled")
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 10)), 3500)
+
+    def test_defaults_to_stored_cancelled_at(self):
+        a = appt("a1", self.start, status="cancelled", cancelled_at=utc(2027, 3, 9, 8))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelled_without_any_time_is_rejected(self):
+        a = appt("a1", self.start, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancelled_at_is_rejected(self):
+        a = appt("a1", self.start, status="cancelled")
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 9, 8))
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", self.start, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+        self.assertEqual(cancellation_fee(appt("a2", self.start, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+
+    def test_no_show_ignores_cancelled_at(self):
+        self.assertEqual(cancellation_fee(appt("a1", self.start, status=NO_SHOW), None), 7000)
+
+    def test_booked_and_attended_have_no_fee(self):
+        for status in (BOOKED, ATTENDED):
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", self.start, status=status), utc(2027, 3, 9, 8))
+
+
+if __name__ == "__main__":
+    unittest.main()
