+"""Monthly invoice export for the accountant (Xero import).
+
+Rules from the accountant and the privacy officer: a CSV with a header row,
+DD/MM/YYYY dates, amounts as plain numbers with two decimals, and no patient
+names, only patient IDs.
+"""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "Clinic", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def _amount(cents):
+    sign = "-" if cents < 0 else ""
+    dollars, rest = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{rest:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year/month to out_dir and return the file's path.
+
+    The file is named kestrel-invoices-YYYY-MM.csv. A month with no invoices
+    still gets a file with just the header row.
+    """
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for inv in invoices:
+            if inv.issued.year != year or inv.issued.month != month:
+                continue
+            writer.writerow([
+                inv.number,
+                inv.clinic,
+                inv.patient_id,
+                inv.issued.strftime("%d/%m/%Y"),
+                inv.description,
+                _amount(inv.amount_cents),
+            ])
+    return path
