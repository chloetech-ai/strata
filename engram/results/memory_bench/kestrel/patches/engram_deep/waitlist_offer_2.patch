+    def test_next_for_empty_waitlist_is_none(self):
+        self.assertIsNone(Waitlist().next_for("followup"))
+
+    def test_next_for_returns_earliest_request_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 12, kind="followup"))
+        wl.add(entry("KP-000002", 9, kind="followup"))
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000002")
+
+    def test_next_for_ignores_other_kinds(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 8, kind="assessment"))
+        wl.add(entry("KP-000002", 10, kind="followup"))
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000002")
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000001")
+
+    def test_next_for_returns_none_when_nobody_waits_for_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 9, kind="followup"))
+        self.assertIsNone(wl.next_for("assessment"))
+
+    def test_next_for_urgent_entry_beats_earlier_request(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 8, kind="followup"))
+        wl.add(entry("KP-000002", 14, kind="followup", urgent=True))
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000002")
+
+    def test_next_for_equal_request_times_keep_add_order(self):
