@@ -0,0 +1,91 @@
+import csv
+import datetime
+import tempfile
+import unittest
+from pathlib import Path
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-000001",
+            patient_name="Test Patient", description="Initial assessment"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        patient_name=patient_name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+def read_rows(path):
+    with open(path, encoding="utf-8", newline="") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = Path(self._tmp.name)
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_writes_named_csv_and_returns_its_path(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, self.out_dir / "kestrel-invoices-2026-10.csv")
+        self.assertTrue(path.exists())
+
+    def test_header_row_then_one_row_per_invoice(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 15))]
+        rows = read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual(rows[0], ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"])
+        self.assertEqual(rows[1], ["INV-HB-2026-00001", "KP-000001", "15/10/2026", "Initial assessment", "95.00"])
+        self.assertEqual(len(rows), 2)
+
+    def test_only_invoices_from_the_requested_month(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00005", datetime.date(2025, 10, 15)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_amounts_are_plain_two_decimal_numbers(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), amount_cents=9500),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1), amount_cents=7000),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 1), amount_cents=5),
+        ]
+        rows = read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[4] for r in rows[1:]], ["95.00", "70.00", "0.05"])
+
+    def test_patient_name_is_never_written(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), patient_name="Jane Secret")]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertNotIn("Jane", path.read_text(encoding="utf-8"))
+
+    def test_dates_are_taken_from_issued_without_shifting(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 4, 1))]
+        rows = read_rows(export_invoices(invoices, 2026, 4, self.out_dir))
+        self.assertEqual(rows[1][2], "01/04/2026")
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 2)),
+            invoice("INV-NG-2026-00001", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2)),
+        ]
+        rows = read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]],
+                         ["INV-NG-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+
+if __name__ == "__main__":
+    unittest.main()
