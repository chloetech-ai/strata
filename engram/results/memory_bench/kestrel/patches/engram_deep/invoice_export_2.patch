+"""Monthly invoice export for the accountants' Xero import."""
+
+import csv
+import datetime
+from decimal import Decimal
+from pathlib import Path
+
+HEADER = ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`/`month` to a CSV file in `out_dir`.
+
+    The file is kestrel-invoices-YYYY-MM.csv. It carries the patient ID only, never
+    the patient name, because files that leave the system must not name patients.
+    Dates are DD/MM/YYYY and amounts are plain numbers with two decimals.
+    Returns the path of the written file.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = Path(out_dir) / f"kestrel-invoices-{year:04d}-{month:02d}.csv"
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in month_invoices:
+            writer.writerow([
+                i.number,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                f"{Decimal(i.amount_cents) / 100:.2f}",
+            ])
+    return path
