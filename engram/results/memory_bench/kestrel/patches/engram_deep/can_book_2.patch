index 0000000..2ee1d7d
--- /dev/null
+++ b/src/kestrel/booking.py
@@ -0,0 +1,24 @@
+"""Checks run by the booking form before an appointment is saved."""
+
+from .calendar import LOCAL_TZ
+from .models import CANCELLED
+
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per day
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist`.
+
+    Cancelled appointments are ignored. `appointment` itself is ignored too,
+    so a check on an appointment already in the calendar does not count it.
+    """
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    others = [
+        a for a in calendar.for_day(therapist.id, day)
+        if a.status != CANCELLED and a.id != appointment.id
+    ]
+    # Overlap is only checked for an identical start for now: the model has no
+    # appointment length yet, so a longer overlap cannot be detected.
+    if any(a.start == appointment.start for a in others):
+        return False
+    return len(others) < DAILY_CAP
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..4441dcf
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,57 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import DAILY_CAP, can_book
+from kestrel.calendar import Calendar
+from kestrel.models import CANCELLED, Therapist
+
+THERAPIST = Therapist("T1", "Ana", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", utc(2026, 10, 15, 3))))
+
+    def test_same_start_for_same_therapist_is_refused(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 15, 3), therapist="T1")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 15, 3), therapist="T1")))
+
+    def test_same_start_for_other_therapist_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 15, 3), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 15, 3), therapist="T1")))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 15, 3), therapist="T1", status=CANCELLED)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 15, 3), therapist="T1")))
+
+    def test_appointment_does_not_conflict_with_itself(self):
+        cal = Calendar([appt("new", utc(2026, 10, 15, 3), therapist="T1")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 15, 3), therapist="T1")))
+
+    def test_daily_cap_refuses_ninth(self):
+        booked = [appt(f"a{i}", utc(2026, 10, 15, i), therapist="T1") for i in range(DAILY_CAP)]
+        cal = Calendar(booked)
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 15, 8), therapist="T1")))
+
+    def test_daily_cap_allows_eighth(self):
+        booked = [appt(f"a{i}", utc(2026, 10, 15, i), therapist="T1") for i in range(DAILY_CAP - 1)]
+        cal = Calendar(booked)
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 15, 8), therapist="T1")))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        booked = [appt(f"a{i}", utc(2026, 10, 15, i), therapist="T1") for i in range(DAILY_CAP - 1)]
+        booked.append(appt("gone", utc(2026, 10, 15, 9), therapist="T1", status=CANCELLED))
+        cal = Calendar(booked)
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 15, 8), therapist="T1")))
+
+    def test_cap_uses_local_date_across_utc_midnight(self):
+        # 22:30 UTC on 15 Oct is 11:30 on 16 Oct in Auckland, so it counts towards 16 Oct only.
+        booked = [appt(f"a{i}", utc(2026, 10, 15, 22, 30 + i), therapist="T1") for i in range(DAILY_CAP)]
+        cal = Calendar(booked)  # 22:30-22:37 UTC on 15 Oct: 11:30-11:37 on 16 Oct local, 8 of them
+        new = appt("new", utc(2026, 10, 15, 2), therapist="T1")  # 15:00 local on 15 Oct: no bookings that day
+        self.assertTrue(can_book(cal, THERAPIST, new))
+        self.assertFalse(can_book(cal, THERAPIST, appt("new2", utc(2026, 10, 15, 23), therapist="T1")))
+
+
+if __name__ == "__main__":
+    unittest.main()
