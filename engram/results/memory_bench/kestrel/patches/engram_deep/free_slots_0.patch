index 0000000..631554a
--- /dev/null
+++ b/src/kestrel/slots.py
@@ -0,0 +1,65 @@
+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, CLINICS, FOLLOWUP, KINDS
+
+STEP = datetime.timedelta(minutes=15)  # every appointment starts on a quarter hour
+DURATION = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Notes time the therapist needs after an assessment before the next patient.
+GAP_AFTER = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+DAILY_CAP = 8  # therapists' union agreement: patient appointments per therapist per day
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))  # all clinics, Monday to Friday
+NORTHGATE_SATURDAY_HOURS = (datetime.time(8, 0), datetime.time(12, 0))  # Northgate only; others closed
+
+
+def _opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a date, or None when the clinic is closed."""
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic {clinic!r}")
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5 and clinic == "NG":
+        return NORTHGATE_SATURDAY_HOURS
+    return None
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (sorted) on the local date `day` at which `therapist` could book a new `kind` appointment.
+
+    A start is offered only when the whole appointment falls within the clinic's opening hours,
+    it does not overlap the therapist's existing appointments (including their notes gap),
+    and the therapist is under the daily cap. Cancelled appointments are ignored.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = _opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= DAILY_CAP:
+        return []
+    busy = [(a.start, a.start + DURATION[a.kind] + GAP_AFTER[a.kind]) for a in booked]
+
+    opens, closes = hours
+    length = DURATION[kind]
+    gap = GAP_AFTER[kind]
+    start = datetime.datetime.combine(day, opens, tzinfo=LOCAL_TZ)
+    latest = datetime.datetime.combine(day, closes, tzinfo=LOCAL_TZ) - length
+
+    slots = []
+    while start <= latest:
+        end = start + length + gap
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..ae4823d
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,114 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar, LOCAL_TZ
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+THURSDAY = datetime.date(2026, 10, 15)  # weekday, local
+SATURDAY = datetime.date(2026, 10, 17)
+SUNDAY = datetime.date(2026, 10, 18)
+HARBOUR = Therapist("T1", "Aroha", "HB")
+NORTHGATE = Therapist("T2", "Mere", "NG")
+
+
+def local(y, m, d, hh, mm):
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=LOCAL_TZ)
+
+
+def t(hh, mm):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_weekday_followup_covers_opening_hours_on_quarter_hours(self):
+        slots = free_slots(Calendar(), HARBOUR, THURSDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # 30 minutes, so it must end by 18:00
+        self.assertEqual(len(slots), 41)
+        self.assertTrue(all(s.minute % 15 == 0 and s.second == 0 for s in slots))
+
+    def test_assessment_must_end_by_closing(self):
+        slots = free_slots(Calendar(), HARBOUR, THURSDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))  # 45 minutes, so 17:15 ends at 18:00
+
+    def test_results_are_datetime_times_in_order(self):
+        slots = free_slots(Calendar(), HARBOUR, THURSDAY, FOLLOWUP)
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_saturday_only_northgate_open_08_to_12(self):
+        slots = free_slots(Calendar(), NORTHGATE, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(8, 0))
+        self.assertEqual(slots[-1], t(11, 30))
+        self.assertEqual(free_slots(Calendar(), HARBOUR, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed_everywhere(self):
+        self.assertEqual(free_slots(Calendar(), NORTHGATE, SUNDAY, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HARBOUR, SUNDAY, ASSESSMENT), [])
+
+    def test_existing_followup_blocks_overlapping_starts(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 14, 20, 0), therapist="T1")])  # 09:00 local
+        slots = free_slots(cal, HARBOUR, THURSDAY, FOLLOWUP)
+        self.assertIn(t(8, 30), slots)  # ends at 09:00, exactly when the booking starts
+        self.assertNotIn(t(8, 45), slots)
+        self.assertNotIn(t(9, 0), slots)
+        self.assertNotIn(t(9, 15), slots)
+        self.assertIn(t(9, 30), slots)
+
+    def test_assessment_gap_blocks_time_after_it(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 14, 20, 0), kind=ASSESSMENT, therapist="T1")])  # 09:00 local
+        slots = free_slots(cal, HARBOUR, THURSDAY, FOLLOWUP)
+        self.assertNotIn(t(9, 45), slots)  # inside the 45 minutes
+        self.assertNotIn(t(9, 30), slots)
+        self.assertIn(t(8, 30), slots)  # ends at 09:00
+        self.assertIn(t(10, 0), slots)  # 45 minutes plus 15 minutes of notes ends at 10:00
+
+    def test_new_assessment_needs_its_own_notes_gap(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 14, 20, 0), kind=FOLLOWUP, therapist="T1")])  # 09:00-09:30 local
+        slots = free_slots(cal, HARBOUR, THURSDAY, ASSESSMENT)
+        self.assertNotIn(t(8, 15), slots)  # 45 minutes ends at 09:00, but its 15-minute gap runs into 09:00
+        self.assertIn(t(8, 0), slots)  # 45 minutes plus 15 minutes of notes ends at 09:00, when the booking starts
+        self.assertIn(t(9, 30), slots)  # no gap after a follow-up
+
+    def test_cancelled_appointments_are_ignored(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 14, 20, 0), status=CANCELLED, therapist="T1")])
+        self.assertIn(t(9, 0), free_slots(cal, HARBOUR, THURSDAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_are_ignored(self):
+        cal = Calendar([appt("a1", utc(2026, 10, 14, 20, 0), therapist="T9")])
+        self.assertIn(t(9, 0), free_slots(cal, HARBOUR, THURSDAY, FOLLOWUP))
+
+    def test_uses_local_date_across_utc_midnight(self):
+        # 22:30 UTC on 14 Oct is 11:30 on 15 Oct in Auckland (NZDT).
+        cal = Calendar([appt("a1", utc(2026, 10, 14, 22, 30), therapist="T1")])
+        slots = free_slots(cal, HARBOUR, THURSDAY, FOLLOWUP)
+        self.assertNotIn(t(11, 15), slots)
+        self.assertNotIn(t(11, 30), slots)
+        self.assertNotIn(t(11, 45), slots)
+        self.assertIn(t(11, 0), slots)
+        self.assertIn(t(12, 0), slots)
+
+    def test_daily_cap_of_eight_closes_the_day(self):
+        booked = [
+            appt(f"a{i}", utc(2026, 10, 14, 19, 0) + datetime.timedelta(minutes=30 * i), therapist="T1")
+            for i in range(8)
+        ]
+        self.assertEqual(free_slots(Calendar(booked), HARBOUR, THURSDAY, FOLLOWUP), [])
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        booked = [
+            appt(f"a{i}", utc(2026, 10, 14, 19, 0) + datetime.timedelta(minutes=30 * i), therapist="T1")
+            for i in range(7)
+        ]
+        booked.append(appt("x", utc(2026, 10, 14, 21, 0), therapist="T1", status=CANCELLED))
+        self.assertNotEqual(free_slots(Calendar(booked), HARBOUR, THURSDAY, FOLLOWUP), [])
+
+    def test_unknown_kind_is_rejected(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HARBOUR, THURSDAY, "massage")
+
+    def test_unknown_clinic_is_rejected(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), Therapist("T3", "X", "ZZ"), THURSDAY, FOLLOWUP)
