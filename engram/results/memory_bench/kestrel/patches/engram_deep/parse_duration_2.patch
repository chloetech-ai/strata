+"""Reading durations typed in by reception."""
+
+import re
+
+# "45m", "1h", "1h30", "1h30m" and "1h 30m" are accepted; the minutes part
+# after the hours may omit its "m", and the hours and minutes may be spaced.
+_DURATION = re.compile(r"(?:([0-9]+)h\s*(?:([0-9]{1,2})m?)?|([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration such as "1h 30m".
+
+    Raises ValueError for anything that is not a positive duration, including
+    minute counts of 60 or more after an hour, such as "1h90".
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration {text!r}")
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration {text!r}")
+    if match.group(3) is not None:
+        hours, minutes = 0, int(match.group(3))
+    else:
+        hours = int(match.group(1))
+        minutes = int(match.group(2)) if match.group(2) is not None else 0
+        if minutes >= 60:
+            raise ValueError(f"invalid duration {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"invalid duration {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
