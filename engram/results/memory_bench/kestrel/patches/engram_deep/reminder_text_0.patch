+"""Text of the SMS appointment reminder sent two days before an appointment."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Reminder for an appointment, with only its date, time and clinic name.
+
+    Privacy rule: the text must never say what the appointment is for, so
+    the treatment and appointment kind are left out on purpose.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{local.strftime('%A')} {local.day} {local.strftime('%B')}"
+    hour = local.hour % 12 or 12
+    when = f"{hour}:{local.minute:02d}{'am' if local.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora from Kestrel Physio! This is a friendly reminder of your appointment "
+        f"at {clinic} on {day} at {when}. "
+        "If you need to change it, please get in touch with the clinic. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..8b64a27
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,48 @@
+import unittest
+
+from kestrel.models import ASSESSMENT, FOLLOWUP
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_states_local_date_time_and_clinic(self):
+        # 2026-10-21 is a Wednesday; 01:00 UTC is 14:00 in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("A1", utc(2026, 10, 21, 1, 0), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Wednesday 21 October", text)
+        self.assertIn("at 2:00pm", text)
+
+    def test_morning_time_is_am(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 21, 19, 30), clinic="NG"))  # 08:30 Auckland
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("at 8:30am", text)
+
+    def test_midnight_hour_is_12am(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 11, 0), clinic="WK"))  # 00:00 Auckland on 21 Oct
+        self.assertIn("Kestrel Physio Westwick", text)
+        self.assertIn("on Wednesday 21 October at 12:00am", text)
+
+    def test_uses_auckland_date_across_utc_midnight(self):
+        # 22:30 UTC on 20 October is already 21 October in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 22, 30), clinic="HB"))
+        self.assertIn("Wednesday 21 October", text)
+        self.assertIn("at 11:30am", text)
+
+    def test_never_mentions_treatment_or_kind(self):
+        for kind in (ASSESSMENT, FOLLOWUP):
+            text = reminder_text(appt("A1", utc(2026, 10, 21, 1, 0), kind=kind, treatment="lower back pain"))
+            lowered = text.lower()
+            self.assertNotIn("lower back", lowered)
+            self.assertNotIn("assessment", lowered)
+            self.assertNotIn("follow", lowered)
+
+    def test_is_friendly_and_plain_text(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 21, 1, 0)))
+        self.assertIn("Kia ora", text)
+        self.assertLess(len(text), 320)
+
+
+if __name__ == "__main__":
+    unittest.main()
