+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, ATTENDED, CANCELLED, FOLLOWUP, Therapist
+
+THERAPIST = Therapist(id="T1", name="Sam", clinic="HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", utc(2027, 3, 1, 10), kind=FOLLOWUP)))
+
+    def test_start_inside_existing_appointment(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10, 15), kind=FOLLOWUP)))
+
+    def test_new_assessment_runs_into_existing_appointment(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 9, 30), kind=ASSESSMENT)))
+
+    def test_existing_assessment_runs_into_new_appointment(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=ASSESSMENT)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10, 40), kind=FOLLOWUP)))
+
+    def test_back_to_back_is_allowed(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("after", utc(2027, 3, 1, 10, 30), kind=FOLLOWUP)))
+        self.assertTrue(can_book(cal, THERAPIST, appt("before", utc(2027, 3, 1, 9, 30), kind=FOLLOWUP)))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP, therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10), kind=FOLLOWUP)))
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP, status=CANCELLED, cancelled_at=utc(2027, 2, 28))])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10), kind=FOLLOWUP)))
+
+    def test_attended_appointments_do_not_block(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP, status=ATTENDED)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10), kind=FOLLOWUP)))
+
+    def test_compares_across_timezones(self):
+        # 22:30 UTC on 31 March is 11:30 on 1 April in Auckland (NZDT ends in April, so UTC+13 still applies).
+        auckland = ZoneInfo("Pacific/Auckland")
+        cal = Calendar([appt("a", utc(2027, 3, 31, 22, 30), kind=FOLLOWUP)])
+        clash = appt("new", datetime.datetime(2027, 4, 1, 11, 45, tzinfo=auckland), kind=FOLLOWUP)
+        clear = appt("new2", datetime.datetime(2027, 4, 1, 11, 0, tzinfo=auckland), kind=FOLLOWUP)
+        self.assertFalse(can_book(cal, THERAPIST, clash))
+        self.assertTrue(can_book(cal, THERAPIST, clear))
