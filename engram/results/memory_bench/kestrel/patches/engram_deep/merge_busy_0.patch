+"""Working with (start, end) time intervals."""
+
+
+def merge_busy(intervals):
+    """Return the intervals merged into sorted, non-overlapping pairs.
+
+    The input may come in any order. Pairs that overlap or touch, such as
+    (1, 3) and (3, 5), are merged into one.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
