@@ -0,0 +1,64 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, ATTENDED, CANCELLED, FOLLOWUP, Therapist
+
+THERAPIST = Therapist("T1", "Dana", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        cal = Calendar()
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_same_slot_is_refused(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_starts_inside_existing_appointment(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP)])  # 10:00-10:30
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10, 15))))
+
+    def test_new_appointment_covers_existing_one(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10, 15), kind=FOLLOWUP)])  # 10:15-10:45
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10), kind=ASSESSMENT)))  # 10:00-10:45
+
+    def test_assessment_length_is_used_for_existing(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=ASSESSMENT)])  # 10:00-10:45
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10, 30))))
+
+    def test_back_to_back_is_allowed(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), kind=FOLLOWUP)])  # ends 10:30
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10, 30))))
+
+    def test_before_existing_appointment_is_allowed(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10, 30), kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 9, 30), kind=ASSESSMENT)))  # ends 10:15
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), status=CANCELLED)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_attended_appointment_still_blocks(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), status=ATTENDED)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_other_therapists_appointments_are_ignored(self):
+        cal = Calendar([appt("a", utc(2027, 3, 1, 10), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_overlap_across_utc_midnight(self):
+        # 23:50 UTC on 15 Oct is 12:50 on 16 Oct in Auckland; the overlap is still found.
+        cal = Calendar([appt("a", utc(2026, 10, 15, 23, 50), kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2026, 10, 16, 0, 10))))
+
+    def test_appointment_already_in_calendar_does_not_block_itself(self):
+        existing = appt("a", utc(2027, 3, 1, 10))
+        cal = Calendar([existing])
+        self.assertTrue(can_book(cal, THERAPIST, existing))
+
+
+if __name__ == "__main__":
+    unittest.main()
