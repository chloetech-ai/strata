@@ -0,0 +1,30 @@
+"""Cancellation and no-show fees, in cents."""
+
+import datetime
+
+from kestrel.models import CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents for a cancelled or no-show appointment.
+
+    A cancellation less than 48 hours before the start costs 50% of the session
+    price; earlier cancellations are free. A no-show pays the full session price.
+    `cancelled_at` is when the patient cancelled (timezone-aware), and is None
+    for a no-show.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no fee for appointment with status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("a cancelled appointment needs cancelled_at")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..a19fb19
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,67 @@
+import datetime
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW, Appointment
+
+START = datetime.datetime(2026, 10, 20, 9, 0, tzinfo=datetime.timezone.utc)
+
+
+def appointment(kind=ASSESSMENT, status=CANCELLED):
+    return Appointment(
+        id="a1",
+        patient_id="KP-004211",
+        therapist_id="t1",
+        clinic="NG",
+        start=START,
+        kind=kind,
+        status=status,
+    )
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_assessment_price(self):
+        self.assertEqual(cancellation_fee(appointment(status=NO_SHOW)), 9500)
+
+    def test_no_show_pays_full_follow_up_price(self):
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP, NO_SHOW)), 7000)
+
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        cancelled_at = START - datetime.timedelta(hours=49)
+        self.assertEqual(cancellation_fee(appointment(), cancelled_at), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        cancelled_at = START - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(appointment(), cancelled_at), 0)
+
+    def test_cancelled_under_48_hours_ahead_costs_half_assessment(self):
+        cancelled_at = START - datetime.timedelta(hours=47)
+        self.assertEqual(cancellation_fee(appointment(), cancelled_at), 4750)
+
+    def test_cancelled_under_48_hours_ahead_costs_half_follow_up(self):
+        cancelled_at = START - datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), cancelled_at), 3500)
+
+    def test_cancelled_after_start_costs_half(self):
+        cancelled_at = START + datetime.timedelta(minutes=5)
+        self.assertEqual(cancellation_fee(appointment(), cancelled_at), 4750)
+
+    def test_cancelled_without_time_raises(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(), None)
+
+    def test_naive_cancelled_at_raises(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(), datetime.datetime(2026, 10, 18, 9, 0))
+
+    def test_booked_appointment_raises(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(status=BOOKED), START)
+
+    def test_attended_appointment_raises(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(status=ATTENDED), START)
+
+
+if __name__ == "__main__":
+    unittest.main()
