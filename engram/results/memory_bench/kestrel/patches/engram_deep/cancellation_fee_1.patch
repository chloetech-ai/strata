index 0000000..cfb2a40
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,72 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+NZDT = datetime.timezone(datetime.timedelta(hours=13))
+START = utc(2026, 10, 20, 2, 0)  # 20 Oct 02:00 UTC
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_followup_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_pays_full_assessment_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_ignores_cancelled_at(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a, cancelled_at=None), 7000)
+
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2026, 10, 17, 1, 59)), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_half_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2026, 10, 18, 2, 0)), 3500)
+
+    def test_cancelled_inside_48_hours_is_half_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2026, 10, 19, 12, 0)), 4750)
+
+    def test_cancelled_after_start_is_half_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, cancelled_at=utc(2026, 10, 20, 3, 0)), 3500)
+
+    def test_window_compares_instants_across_timezones(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        # 16:00 NZDT on 18 Oct is 03:00 UTC, 47 hours before START: inside the window.
+        inside = datetime.datetime(2026, 10, 18, 16, 0, tzinfo=NZDT)
+        self.assertEqual(cancellation_fee(a, cancelled_at=inside), 3500)
+        # 14:00 NZDT on 18 Oct is 01:00 UTC, 49 hours before START: outside the window.
+        outside = datetime.datetime(2026, 10, 18, 14, 0, tzinfo=NZDT)
+        self.assertEqual(cancellation_fee(a, cancelled_at=outside), 0)
+
+    def test_cancelled_without_cancellation_time_raises(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, cancelled_at=None)
+
+    def test_naive_cancellation_time_raises(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, cancelled_at=datetime.datetime(2026, 10, 18, 2, 0))
+
+    def test_booked_appointment_raises(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=BOOKED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_attended_appointment_raises(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=ATTENDED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
