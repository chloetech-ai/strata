@@ -0,0 +1,31 @@
+"""Fees charged when a patient does not attend as booked."""
+
+import datetime
+
+from kestrel.models import BOOKED, CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+# Cancelling inside this window before the start costs half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Return the fee in cents for a cancelled or no-show appointment.
+
+    `cancelled_at` is the timezone-aware time the patient cancelled. It is
+    required for a cancelled appointment and ignored for a no-show.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            raise ValueError(f"cancelled appointment {appointment.id} has no cancellation time")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancelled_at must be timezone-aware")
+        if cancelled_at >= appointment.start - LATE_CANCELLATION_WINDOW:
+            return price // 2
+        return 0
+    if appointment.status == BOOKED:
+        raise ValueError(f"appointment {appointment.id} is still booked; no fee applies")
+    raise ValueError(f"no cancellation fee for appointment status {appointment.status!r}")
diff --git a/tests/test_fees.py b/tests/test_fees.py
