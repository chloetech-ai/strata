+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.ana = Patient("KP-000001", "Ana Silva", "+64211234567")
+        self.csc_ana = Patient("KP-000001", "Ana Silva", "+64211234567", csc=True)
+
+    def test_price_follows_local_date_across_utc_midnight(self):
+        # 22:30 UTC on 31 March 2027 is 11:30 on 1 April in Auckland (NZDT, UTC+13).
+        start = datetime.datetime(2027, 3, 31, 22, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), self.ana), 10500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.ana), 7800)
+
+    def test_last_minute_of_31_march_local_keeps_old_price(self):
+        # 10:59 UTC on 31 March is 23:59 on 31 March in Auckland.
+        start = datetime.datetime(2027, 3, 31, 10, 59, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), self.ana), 9500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.ana), 7000)
+
+    def test_first_minute_of_1_april_local_gets_new_price(self):
+        # 11:00 UTC on 31 March is 00:00 on 1 April in Auckland.
+        start = datetime.datetime(2027, 3, 31, 11, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), self.ana), 10500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.ana), 7800)
+
+    def test_csc_holder_gets_20_percent_off_follow_up(self):
+        start = datetime.datetime(2027, 4, 10, 1, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.csc_ana), 6240)
+
