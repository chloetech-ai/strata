-"""Session prices in cents (NZD)."""
+"""Session prices in cents (NZD), and what each patient pays."""
 
+import datetime
+
+from kestrel.calendar import LOCAL_TZ
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)  # local (Pacific/Auckland) date
+
+# Prices for appointments dated before PRICE_CHANGE_DATE.
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+# Prices for appointments dated on or after PRICE_CHANGE_DATE.
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
-def session_price(kind):
-    """Return the price in cents for an appointment kind (ASSESSMENT or FOLLOWUP)."""
+
+def session_price(kind, day):
+    """Return the price in cents for an appointment kind on a local (Pacific/Auckland) date."""
     if kind not in PRICES_CENTS:
         raise ValueError(f"unknown kind {kind!r}")
+    if day >= PRICE_CHANGE_DATE:
+        return NEW_PRICES_CENTS[kind]
     return PRICES_CENTS[kind]
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price follows the appointment's local date. Community Services Card
+    holders get 20% off follow-ups, not off initial assessments.
+    """
+    day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price -= price * CSC_FOLLOWUP_DISCOUNT_PERCENT // 100
+    return price
