+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_highest_sequence_for_clinic_and_year(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00042", "INV-HB-2026-00007"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00043")
+
+    def test_sequences_are_counted_per_clinic(self):
+        existing = ["INV-NG-2026-00009", "INV-WK-2026-00100"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_sequences_restart_each_year(self):
+        existing = ["INV-HB-2025-00500"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_ignores_other_formats_and_partial_matches(self):
+        existing = [
+            "INV-HB-2026-0003",      # sequence not five digits
+            "INV-HB-2026-000050",    # sequence too long
+            "XINV-HB-2026-00060",
+            "INV-HB-2026-00002x",
+            "INV-HBX-2026-00070",    # clinic code must match exactly
+        ]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_raises_when_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
