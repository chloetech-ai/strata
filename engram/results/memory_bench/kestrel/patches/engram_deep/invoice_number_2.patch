+def next_invoice_number(clinic, year, existing):
+    """Next number in the INV-<clinic>-<year>-<sequence> series.
+
+    The sequence is counted per clinic and restarts at 00001 each year, so
+    only numbers for this clinic and year count; `existing` may hold numbers
+    from any clinic and year.
+    """
+    pattern = re.compile(r"INV-{}-{}-(\d{{5}})$".format(re.escape(clinic), year))
+    sequences = [int(m.group(1)) for m in map(pattern.match, existing) if m]
+    nxt = max(sequences, default=0) + 1
+    if nxt > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} {year}")
+    return f"INV-{clinic}-{year}-{nxt:05d}"
+
