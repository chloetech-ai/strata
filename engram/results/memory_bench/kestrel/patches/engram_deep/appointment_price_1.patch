 """Session prices in cents (NZD)."""
 
-from kestrel.models import ASSESSMENT, FOLLOWUP
+import datetime
+
+from kestrel.calendar import LOCAL_TZ
+from kestrel.models import ASSESSMENT, FOLLOWUP, KINDS
+
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)  # local (Pacific/Auckland) date
 
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+PRICES_FROM_CHANGE_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+CSC_FOLLOWUP_PERCENT_OFF = 20  # Community Services Card holders, follow-ups only
 
-def session_price(kind):
-    """Return the price in cents for an appointment kind (ASSESSMENT or FOLLOWUP)."""
-    if kind not in PRICES_CENTS:
+
+def session_price(kind, day):
+    """Return the undiscounted price in cents for an appointment kind on a local date."""
+    if kind not in KINDS:
         raise ValueError(f"unknown kind {kind!r}")
+    if day >= PRICE_CHANGE_DATE:
+        return PRICES_FROM_CHANGE_CENTS[kind]
     return PRICES_CENTS[kind]
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price follows the appointment's local (Pacific/Auckland) date, not its
+    booking date or its UTC date.
+    """
+    local_day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, local_day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
+    return price
