 - Calendar: `cancel` records cancellation time (`cancelled_at`); `move` reschedules booked appointments; calendar lists appointments in start order; day lookups by patient ID.
 - Patients: Community Services Card (`csc`) flag, saved and loaded, defaulting to off for older files.
-- Pricing: `session_price` returns 9500 cents for an initial assessment and 7000 for a follow-up.
+- Pricing: `session_price(kind, day)` returns 9500 cents for an initial assessment and 7000 for a follow-up, or 10500 and 7800 from 1 April 2027 (Pacific/Auckland date). `appointment_price(appointment, patient)` applies the 20% Community Services Card discount to follow-ups.
 - Invoices: `make_invoice` builds an invoice for an appointment, dated in Pacific/Auckland local time.
 - Reports: `therapist_load` counts booked appointments per therapist per day.
 - Waitlist: urgent entries first, then by request time, then in the order added.
diff --git a/src/kestrel/pricing.py b/src/kestrel/pricing.py
index 95646d9..7a4af6a 100644
--- a/src/kestrel/pricing.py
+++ b/src/kestrel/pricing.py
@@ -1,15 +1,47 @@
 """Session prices in cents (NZD)."""
 
+import datetime
+
+from kestrel.calendar import LOCAL_TZ
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+# Prices for appointments dated before the 2027 increase.
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
 
+# From this local (Pacific/Auckland) date, appointments use NEW_PRICES_CENTS.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+
+# Community Services Card holders get 20% off follow-ups, not assessments.
+CSC_FOLLOWUP_PERCENT = 20
+
 
-def session_price(kind):
-    """Return the price in cents for an appointment kind (ASSESSMENT or FOLLOWUP)."""
+def session_price(kind, day):
+    """Return the price in cents for an appointment kind on a local date.
+
+    kind is ASSESSMENT or FOLLOWUP; day is the appointment's Pacific/Auckland date.
+    """
     if kind not in PRICES_CENTS:
         raise ValueError(f"unknown kind {kind!r}")
+    if day >= PRICE_CHANGE_DATE:
+        return NEW_PRICES_CENTS[kind]
     return PRICES_CENTS[kind]
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for an appointment, in cents.
+
+    The price follows the appointment's local (Pacific/Auckland) date, not the
+    booking date, and CSC discounts apply to follow-ups only.
+    """
+    local_day = appointment.start.astimezone(LOCAL_TZ).date()
+    price = session_price(appointment.kind, local_day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT) // 100
+    return price
