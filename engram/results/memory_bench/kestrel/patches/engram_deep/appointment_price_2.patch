+
+
+def patient(csc=False):
+    return Patient("KP-000001", "Ana Silva", "+64211234567", csc=csc)
 
 
 class SessionPriceTest(unittest.TestCase):
     def test_initial_assessment_is_95_dollars(self):
-        self.assertEqual(session_price(ASSESSMENT), 9500)
+        self.assertEqual(session_price(ASSESSMENT, BEFORE), 9500)
 
     def test_follow_up_is_70_dollars(self):
-        self.assertEqual(session_price(FOLLOWUP), 7000)
+        self.assertEqual(session_price(FOLLOWUP, BEFORE), 7000)
+
+    def test_new_prices_from_1_april_2027(self):
+        self.assertEqual(session_price(ASSESSMENT, AFTER), 10500)
