+
+    def test_just_before_1_april_in_auckland_is_old_price(self):
+        # 10:59 UTC on 31 March 2027 is 23:59 on 31 March in Auckland (NZDT, UTC+13).
+        start = datetime.datetime(2027, 3, 31, 10, 59, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 9500)
+
+    def test_just_after_1_april_in_auckland_is_new_price(self):
+        # 11:00 UTC on 31 March 2027 is 00:00 on 1 April in Auckland.
+        start = datetime.datetime(2027, 3, 31, 11, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 10500)
+
+    def test_utc_date_differs_from_auckland_date(self):
+        # 22:30 UTC on 31 March is already 1 April in Auckland, so the new price applies.
+        start = datetime.datetime(2027, 3, 31, 22, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 10500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7800)
 
 
