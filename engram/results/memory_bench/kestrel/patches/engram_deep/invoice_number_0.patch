+def next_invoice_number(clinic, year, existing):
+    """Next number in INV-<clinic>-<year>-<sequence> form, e.g. INV-HB-2027-00042.
+
+    `existing` is every invoice number issued so far, for any clinic and year.
+    Sequences are counted per clinic and restart at 00001 each year, so only
+    numbers with this clinic code and year count; anything else is ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    last = 0
+    for number in existing:
+        digits = number[len(prefix):] if number.startswith(prefix) else ""
+        if re.fullmatch(r"[0-9]{5}", digits):
+            last = max(last, int(digits))
+    if last >= 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{last + 1:05d}"
+
