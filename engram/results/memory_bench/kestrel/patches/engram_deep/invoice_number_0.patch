+from kestrel.invoices import make_invoice, next_invoice_number
 from kestrel.models import ASSESSMENT, Patient
 
 PATIENT = Patient("KP-000001", "Test Patient", "+64211234567")
 
 
+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_number_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_existing_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_counts_separately_per_clinic(self):
+        existing = ["INV-NG-2027-00009", "INV-WK-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00004")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00815", "INV-HB-2026-00816"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_in_other_formats(self):
+        existing = ["INV-HB-2027-1234", "INV-HB-2027-000ab", "INV-HB-2027-00005x", "old-41"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_raises_when_sequence_is_exhausted(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
