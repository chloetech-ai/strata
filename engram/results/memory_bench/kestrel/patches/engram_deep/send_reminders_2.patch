+"""Appointment reminders sent by SMS."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment.
+
+    Only the local date, the local time and the clinic name appear. The
+    treatment is never mentioned, per the privacy officer's rule.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return f"{clinic}: you have an appointment on {local:%A %d %B %Y} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of each booked appointment.
+
+    `patients` maps patient ID to Patient, and `client` is a BulkieClient.
+    Returns the number of messages sent.
+    """
+    messages = [
+        (patients[a.patient_id].phone, reminder_text(a))
+        for a in appointments
+        if a.status == BOOKED
+    ]
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..df1d95e
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,84 @@
+import datetime
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+def patient(id, phone):
+    return Patient(id=id, name="Test Patient", phone=phone)
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key-123", transport=self.transport)
+        self.patients = {
+            "KP-000001": patient("KP-000001", "+64211111111"),
+            "KP-000002": patient("KP-000002", "+64222222222"),
+        }
+
+    def sent(self):
+        return [m for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_one_sms_per_booked_appointment(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 2, 30), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 2)
+        self.assertEqual([m["to"] for m in self.sent()], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 2, 30), patient="KP-000002", status=CANCELLED),
+            appt("A3", utc(2026, 10, 22, 2, 30), patient="KP-000002", status=ATTENDED),
+            appt("A4", utc(2026, 10, 23, 2, 30), patient="KP-000002", status=NO_SHOW),
+        ]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 1)
+        self.assertEqual(len(self.sent()), 1)
+
+    def test_no_booked_appointments_sends_nothing(self):
+        appointments = [appt("A1", utc(2026, 10, 20, 2, 30), status=CANCELLED)]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_empty_appointments_sends_nothing(self):
+        self.assertEqual(send_reminders([], self.patients, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_count_matches_messages_over_several_calls(self):
+        appointments = [appt(f"A{i}", utc(2026, 10, 20, 2, 30), patient="KP-000001") for i in range(120)]
+        self.assertEqual(send_reminders(appointments, self.patients, self.client), 120)
+        self.assertEqual([len(b["messages"]) for _, b in self.transport.calls], [50, 50, 20])
+
+    def test_text_gives_local_date_time_and_clinic_only(self):
+        a = appt("A1", utc(2026, 10, 20, 2, 30), clinic="HB", treatment="lower back pain")
+        send_reminders([a], self.patients, self.client)
+        text = self.sent()[0]["text"]
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 20 October 2026", text)
+        self.assertIn("at 15:30", text)  # 02:30 UTC is 15:30 in Auckland (NZDT, UTC+13)
+        self.assertNotIn("lower back pain", text)
+
+    def test_date_is_auckland_local_across_utc_midnight(self):
+        # 22:30 UTC on 31 March 2027 is 1 April in Auckland (NZDT, UTC+13)
+        a = appt("A1", utc(2027, 3, 31, 22, 30))
+        self.assertIn("Thursday 01 April 2027 at 11:30", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
