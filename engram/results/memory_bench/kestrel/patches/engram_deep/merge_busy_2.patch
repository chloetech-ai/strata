+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_pair(self):
+        self.assertEqual(merge_busy([(9, 10)]), [(9, 10)])
+
+    def test_disjoint_pairs_sorted(self):
+        self.assertEqual(merge_busy([(13, 14), (9, 10)]), [(9, 10), (13, 14)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(9, 11), (10, 12)]), [(9, 12)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(9, 10), (10, 11)]), [(9, 11)])
+
+    def test_contained_pair_does_not_shrink(self):
+        self.assertEqual(merge_busy([(9, 12), (10, 11)]), [(9, 12)])
+
+    def test_any_order(self):
+        self.assertEqual(
+            merge_busy([(15, 16), (10, 12), (8, 9), (11, 13), (9, 10)]),
+            [(8, 13), (15, 16)],
+        )
+
+    def test_does_not_modify_input(self):
+        pairs = [(12, 13), (9, 10)]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(12, 13), (9, 10)])
