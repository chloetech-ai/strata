diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index 46287b1..d8064ee 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -39,5 +39,12 @@ class Waitlist:
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
 
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it."""
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
+
     def __len__(self):
         return len(self._entries)
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index c1200c4..2af3719 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -97,6 +97,34 @@ class WaitlistTest(unittest.TestCase):
         wl.add(entry("KP-000001", 11))
         self.assertEqual([e.requested_at.hour for e in wl.entries()], [11])
 
+    def test_next_for_empty_waitlist_is_none(self):
+        self.assertIsNone(Waitlist().next_for("assessment"))
+
+    def test_next_for_returns_first_entry_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 9, kind="followup"))
+        wl.add(entry("KP-000002", 10, kind="assessment"))
+        wl.add(entry("KP-000003", 11, kind="assessment"))
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000002")
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000001")
+
+    def test_next_for_prefers_urgent_entry_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 8, kind="assessment"))
+        wl.add(entry("KP-000002", 15, kind="assessment", urgent=True))
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000002")
+
+    def test_next_for_none_when_nobody_waits_for_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 9, kind="followup"))
+        self.assertIsNone(wl.next_for("assessment"))
+
+    def test_next_for_does_not_remove_entry(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", 9, kind="followup"))
+        wl.next_for("followup")
+        self.assertEqual(len(wl), 1)
+
     def test_entries_returns_a_copy(self):
         wl = Waitlist()
         wl.add(entry("KP-000001", 9))
