+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+
+DURATION = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Notes time the therapist needs after an assessment before the next patient.
+GAP_AFTER = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+START_STEP = datetime.timedelta(minutes=15)  # every appointment starts on a quarter hour
+DAILY_CAP = 8  # therapists' union agreement: patient appointments per therapist per day
+
+# Clinic code -> weekday (Monday is 0) -> (open, close) local times. Missing weekdays are closed.
+_MON_TO_FRI = {weekday: (datetime.time(7, 30), datetime.time(18, 0)) for weekday in range(5)}
+_NORTHGATE = dict(_MON_TO_FRI)
+_NORTHGATE[5] = (datetime.time(8, 0), datetime.time(12, 0))  # Saturday
+OPENING_HOURS = {"NG": _NORTHGATE, "HB": _MON_TO_FRI, "WK": _MON_TO_FRI}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on `day` (a Pacific/Auckland date) at which a new `kind` appointment
+    could be booked with `therapist`, sorted.
+
+    A slot must lie within the clinic's opening hours, with the whole appointment finishing by
+    closing time. It must not overlap any non-cancelled appointment of the therapist, counting the
+    gap after an assessment, and the therapist must be under the daily cap on that local day.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    if therapist.clinic not in OPENING_HOURS:
+        raise ValueError(f"unknown clinic {therapist.clinic!r}")
+    hours = OPENING_HOURS[therapist.clinic].get(day.weekday())
+    if hours is None:
+        return []
+    open_time, close_time = hours
+
+    appointments = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+    if sum(1 for a in appointments if a.start.astimezone(LOCAL_TZ).date() == day) >= DAILY_CAP:
+        return []
+
+    busy = []
+    for a in appointments:
+        start = a.start.astimezone(UTC)
+        busy.append((start, start + DURATION[a.kind] + GAP_AFTER[a.kind]))
+
+    first = datetime.datetime.combine(day, open_time, tzinfo=LOCAL_TZ).astimezone(UTC)
+    closes = datetime.datetime.combine(day, close_time, tzinfo=LOCAL_TZ).astimezone(UTC)
+    duration = DURATION[kind]
+    slots = []
+    start = first
+    while start + duration <= closes:
+        end = start + duration + GAP_AFTER[kind]
+        if all(end <= busy_start or busy_end <= start for busy_start, busy_end in busy):
+            slots.append(start.astimezone(LOCAL_TZ).time())
+        start += START_STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..f815396
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,114 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar, LOCAL_TZ
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MONDAY = datetime.date(2027, 3, 1)  # local date
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+HB = Therapist("T1", "Ana", "HB")
+NG = Therapist("T1", "Ana", "NG")
+
+
+def local(day, hh, mm=0):
+    """A timezone-aware Pacific/Auckland datetime on the local date `day`."""
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=LOCAL_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_weekday_follow_up_offers_quarter_hours_within_opening_hours(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # 17:30 + 30 min closes at 18:00
+        self.assertEqual(len(slots), 41)
+        self.assertTrue(all(s.minute % 15 == 0 and s.second == 0 for s in slots))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_assessment_must_finish_by_closing_time(self):
+        slots = free_slots(Calendar(), HB, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))  # 17:15 + 45 min closes at 18:00
+
+    def test_saturday_hours_only_at_northgate(self):
+        slots = free_slots(Calendar(), NG, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(8, 0))
+        self.assertEqual(slots[-1], t(11, 30))  # 11:30 + 30 min closes at 12:00
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+
+    def test_all_clinics_closed_on_sunday(self):
+        for code in ("NG", "HB", "WK"):
+            with self.subTest(clinic=code):
+                therapist = Therapist("T1", "Ana", code)
+                self.assertEqual(free_slots(Calendar(), therapist, SUNDAY, FOLLOWUP), [])
+
+    def test_existing_appointment_blocks_overlapping_slots(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), kind=FOLLOWUP)])  # 10:00 to 10:30
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)  # ends exactly when the existing one starts
+        self.assertNotIn(t(9, 45), slots)
+        self.assertNotIn(t(10, 0), slots)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_assessment_leaves_fifteen_minute_gap_after(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), kind=ASSESSMENT)])  # busy 10:00 to 11:00
+        follow_ups = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 45), follow_ups)
+        self.assertIn(t(11, 0), follow_ups)
+        assessments = free_slots(cal, HB, MONDAY, ASSESSMENT)
+        self.assertIn(t(9, 0), assessments)  # 09:00 to 09:45, then 15 minutes of notes
+        self.assertNotIn(t(9, 15), assessments)
+
+    def test_follow_up_leaves_no_gap_after(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), kind=FOLLOWUP)])  # busy 10:00 to 10:30
+        slots = free_slots(cal, HB, MONDAY, ASSESSMENT)
+        self.assertIn(t(10, 30), slots)
+        self.assertNotIn(t(10, 15), slots)
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), status=CANCELLED, cancelled_at=utc(2027, 2, 28, 0))])
+        self.assertIn(t(10, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), therapist="T2")])
+        self.assertIn(t(10, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_appointment_is_counted_on_its_local_date_across_utc_midnight(self):
+        # 22:30 UTC on 28 Feb is 11:30 on 1 Mar in Auckland, so it blocks 11:30 to 12:00 on 1 Mar.
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 22, 30), kind=FOLLOWUP)])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(t(11, 0), slots)
+        self.assertNotIn(t(11, 15), slots)
+        self.assertNotIn(t(11, 30), slots)
+
+    def test_daily_cap_of_eight_appointments(self):
+        starts = [t(7, 30), t(8, 0), t(8, 30), t(9, 0), t(9, 30), t(10, 0), t(10, 30), t(11, 0)]
+        full = Calendar([appt(f"a{i}", local(MONDAY, s.hour, s.minute), kind=FOLLOWUP) for i, s in enumerate(starts)])
+        self.assertEqual(free_slots(full, HB, MONDAY, FOLLOWUP), [])
+        almost = Calendar([appt(f"a{i}", local(MONDAY, s.hour, s.minute), kind=FOLLOWUP) for i, s in enumerate(starts[:-1])])
+        self.assertIn(t(11, 0), free_slots(almost, HB, MONDAY, FOLLOWUP))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        starts = [t(7, 30), t(8, 0), t(8, 30), t(9, 0), t(9, 30), t(10, 0), t(10, 30), t(11, 0)]
+        cal = Calendar([appt(f"a{i}", local(MONDAY, s.hour, s.minute), kind=FOLLOWUP) for i, s in enumerate(starts)])
+        cal.cancel("a7", utc(2027, 2, 28, 0))
+        self.assertIn(t(11, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_cap_is_per_therapist(self):
+        starts = [t(7, 30), t(8, 0), t(8, 30), t(9, 0), t(9, 30), t(10, 0), t(10, 30), t(11, 0)]
+        cal = Calendar([appt(f"a{i}", local(MONDAY, s.hour, s.minute), kind=FOLLOWUP, therapist="T2") for i, s in enumerate(starts)])
+        self.assertIn(t(7, 30), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_rejects_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, MONDAY, "consult")
+
+
+if __name__ == "__main__":
+    unittest.main()
