@@ -0,0 +1,31 @@
+"""SMS appointment reminders."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment.
+
+    Privacy rule: only the date, the time and the clinic's name. The
+    treatment is never mentioned.
+    """
+    local_start = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic]
+    return f"{clinic.name}: reminder of your appointment on {local_start:%a %d %b %Y} at {local_start:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment. Return the number of messages sent.
+
+    `patients` maps patient ID to Patient. Every message is built before any
+    is sent, so a missing patient raises KeyError without sending anything.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..5af16e9
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,94 @@
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+class FakeClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        self.batches.append(list(messages))
+        return []
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Aroha Test", "+64211111111"),
+    "KP-000002": Patient("KP-000002", "Ben Test", "+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.client = FakeClient()
+
+    def test_one_message_per_booked_appointment(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 3, 0), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 2)
+        self.assertEqual(len(self.client.batches), 1)
+        self.assertEqual([phone for phone, _ in self.client.batches[0]], ["+64211111111", "+64222222222"])
+
+    def test_skips_non_booked_appointments(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 20, 3, 0), patient="KP-000002", status=CANCELLED),
+            appt("A3", utc(2026, 10, 20, 4, 0), patient="KP-000002", status=ATTENDED),
+            appt("A4", utc(2026, 10, 20, 5, 0), patient="KP-000002", status=NO_SHOW),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 1)
+        self.assertEqual(len(self.client.batches[0]), 1)
+
+    def test_no_booked_appointments_sends_nothing_and_returns_zero(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.client.batches, [[]])
+
+    def test_missing_patient_raises_before_sending(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 3, 0), patient="KP-009999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(self.client.batches, [])
+
+    def test_works_with_real_bulkie_client(self):
+        transport = FakeTransport()
+        client = BulkieClient("key-123", transport=transport)
+        appointments = [appt("A1", utc(2026, 10, 20, 2, 30), patient="KP-000001")]
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 1)
+        self.assertEqual(transport.calls[0][1]["messages"][0]["to"], "+64211111111")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_local_date_time_and_clinic_name_only(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 2, 30), clinic="HB", treatment="lower back pain"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("20 Oct 2026", text)
+        self.assertIn("15:30", text)  # 02:30 UTC is 15:30 in Auckland (NZDT, UTC+13)
+        self.assertNotIn("lower back pain", text)
+
+    def test_date_is_auckland_local_across_utc_midnight(self):
+        # 22:30 UTC on 20 Oct is already 21 Oct in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 22, 30), clinic="NG"))
+        self.assertIn("21 Oct 2026", text)
+        self.assertIn("11:30", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
