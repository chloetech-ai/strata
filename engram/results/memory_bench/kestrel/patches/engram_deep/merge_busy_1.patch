+"""Working with time intervals, such as a therapist's booked times."""
+
+
+def merge_busy(intervals):
+    """Return (start, end) pairs merged into sorted, non-overlapping pairs.
+
+    The input may be in any order. Pairs that overlap or touch, so that one
+    ends exactly where the next starts, are joined into a single pair.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
