@@ -0,0 +1,39 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_states_local_date_time_and_clinic(self):
+        # 21 Oct 2026 09:05 UTC is 22:05 on 21 Oct in Auckland (NZDT, UTC+13).
+        a = appt("a1", utc(2026, 10, 21, 9, 5), clinic="NG")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Wednesday 21 October", text)
+        self.assertIn("10:05pm", text)
+
+    def test_uses_local_date_across_utc_midnight(self):
+        # 22:30 UTC on 15 Oct is 11:30 on 16 Oct in Auckland.
+        a = appt("a1", utc(2026, 10, 15, 22, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Friday 16 October", text)
+        self.assertIn("11:30am", text)
+        self.assertNotIn("15 October", text)
+
+    def test_twelve_hour_clock_edges(self):
+        # NZDT is UTC+13: 00:00 local is 11:00 UTC the day before, 12:00 local is 23:00 UTC.
+        midnight = reminder_text(appt("a1", utc(2026, 10, 20, 11, 0), clinic="WK"))
+        noon = reminder_text(appt("a2", utc(2026, 10, 20, 23, 0), clinic="WK"))
+        self.assertIn("12:00am", midnight)
+        self.assertIn("12:00pm", noon)
+
+    def test_never_mentions_treatment(self):
+        a = appt("a1", utc(2026, 10, 21, 9, 0), clinic="HB", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("treatment", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
