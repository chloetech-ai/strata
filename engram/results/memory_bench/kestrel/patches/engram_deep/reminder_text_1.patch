+"""Text of the SMS appointment reminder."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder sent two days before an appointment.
+
+    Deliberately states only the local date, the local time and the clinic's
+    name. It never mentions the treatment, as required by the privacy officer.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    day = f"{local:%A} {local.day} {local:%B}"
+    hour = local.hour % 12 or 12
+    clock = f"{hour}:{local.minute:02d}{'am' if local.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! This is a reminder of your appointment on {day} "
+        f"at {clock}. We look forward to seeing you. "
+        f"If you need to change it, please give us a call."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
