+"""Free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATION_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+# Minutes the therapist needs after an appointment before the next patient (notes).
+NOTES_GAP_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}
+SLOT_STEP_MINUTES = 15  # every appointment starts on a quarter hour
+
+# Opening hours as minutes after midnight. Monday to Friday is the same at every clinic;
+# Saturday is Northgate only; Sunday is closed everywhere.
+WEEKDAY_HOURS = (7 * 60 + 30, 18 * 60)
+SATURDAY_HOURS = {"NG": (8 * 60, 12 * 60)}
+
+
+def opening_hours(clinic, day):
+    """(open, close) in minutes after midnight for a clinic on a local date, or None if closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None
+
+
+def _occupied(start, kind):
+    """The span an appointment of this kind blocks, including its notes gap."""
+    return start, start + datetime.timedelta(minutes=DURATION_MINUTES[kind] + NOTES_GAP_MINUTES[kind])
+
+
+def _overlaps(a, b):
+    return a[0] < b[1] and b[0] < a[1]
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, in order) at which a new `kind` appointment could be booked.
+
+    `day` is a local Pacific/Auckland date. A slot is offered only if the appointment fits inside
+    the therapist's clinic opening hours and does not overlap any non-cancelled appointment for
+    that therapist, counting the notes gap after assessments. Overbooking is never offered.
+    """
+    if kind not in DURATION_MINUTES:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    open_at, close_at = hours
+    busy = [
+        _occupied(a.start, a.kind)
+        for a in calendar.for_therapist(therapist.id)
+        if a.status != CANCELLED
+    ]
+    slots = []
+    for minute in range(open_at, close_at - DURATION_MINUTES[kind] + 1, SLOT_STEP_MINUTES):
+        start = datetime.datetime(day.year, day.month, day.day, minute // 60, minute % 60, tzinfo=LOCAL_TZ)
+        candidate = _occupied(start, kind)
+        if not any(_overlaps(candidate, b) for b in busy):
+            slots.append(datetime.time(minute // 60, minute % 60))
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..cbaa6ac
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,112 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MON = datetime.date(2026, 10, 19)  # Monday
+THU = datetime.date(2026, 10, 15)  # Thursday, NZDT (UTC+13)
+FRI = datetime.date(2026, 10, 16)
+SAT = datetime.date(2026, 10, 17)
+SUN = datetime.date(2026, 10, 18)
+
+HB = Therapist("T1", "Ana", "HB")
+NG = Therapist("T2", "Ben", "NG")
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+def local(y, m, d, hh, mm=0):
+    """UTC instant for a local Auckland time on 15/16 Oct 2026 (UTC+13)."""
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=datetime.timezone.utc) - datetime.timedelta(hours=13)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_followup_runs_from_open_to_last_start(self):
+        slots = free_slots(Calendar(), HB, MON, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # 17:30 + 30 min ends at 18:00
+        self.assertEqual(len(slots), 41)
+
+    def test_empty_weekday_assessment_last_start_leaves_45_minutes(self):
+        slots = free_slots(Calendar(), HB, MON, ASSESSMENT)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 15))  # 17:15 + 45 min ends at 18:00
+        self.assertEqual(len(slots), 40)
+
+    def test_slots_are_datetime_times_on_quarter_hours_in_order(self):
+        slots = free_slots(Calendar(), HB, MON, FOLLOWUP)
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+        self.assertTrue(all(s.minute % 15 == 0 for s in slots))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_saturday_only_northgate_open_8_to_12(self):
+        followups = free_slots(Calendar(), NG, SAT, FOLLOWUP)
+        self.assertEqual(followups[0], t(8))
+        self.assertEqual(followups[-1], t(11, 30))  # 11:30 + 30 min ends at 12:00
+        assessments = free_slots(Calendar(), NG, SAT, ASSESSMENT)
+        self.assertEqual(assessments[-1], t(11, 15))
+
+    def test_saturday_closed_for_harbour(self):
+        self.assertEqual(free_slots(Calendar(), HB, SAT, FOLLOWUP), [])
+
+    def test_sunday_closed_everywhere(self):
+        self.assertEqual(free_slots(Calendar(), NG, SUN, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HB, SUN, ASSESSMENT), [])
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, MON, "massage")
+
+    def test_booked_followup_blocks_overlapping_starts_only(self):
+        cal = Calendar([appt("a1", local(2026, 10, 15, 10, 0), kind=FOLLOWUP, therapist="T1", clinic="HB")])
+        slots = free_slots(cal, HB, THU, FOLLOWUP)
+        # 10:00-10:30 is booked: 09:30 ends exactly as it starts, 10:30 starts exactly as it ends.
+        for blocked in (t(9, 45), t(10), t(10, 15)):
+            self.assertNotIn(blocked, slots)
+        for free in (t(9, 30), t(10, 30)):
+            self.assertIn(free, slots)
+
+    def test_assessment_gap_blocks_following_starts_until_notes_done(self):
+        # Assessment 10:00-10:45, then 15 minutes of notes until 11:00.
+        cal = Calendar([appt("a1", local(2026, 10, 15, 10, 0), kind=ASSESSMENT, therapist="T1", clinic="HB")])
+        slots = free_slots(cal, HB, THU, FOLLOWUP)
+        for blocked in (t(10, 30), t(10, 45)):
+            self.assertNotIn(blocked, slots)
+        self.assertIn(t(11), slots)
+
+    def test_new_assessment_needs_its_own_gap_before_next_booking(self):
+        # Booked follow-up at 11:00. A new assessment at 10:00 runs to 10:45 and its notes to 11:00, so it fits.
+        # Starting at 10:15 would put its notes gap (to 11:15) over the 11:00 follow-up, so it is refused.
+        cal = Calendar([appt("a1", local(2026, 10, 15, 11, 0), kind=FOLLOWUP, therapist="T1", clinic="HB")])
+        slots = free_slots(cal, HB, THU, ASSESSMENT)
+        self.assertIn(t(10), slots)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertNotIn(t(10, 30), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(2026, 10, 15, 10, 0), kind=FOLLOWUP, therapist="T1", clinic="HB")])
+        cal.cancel("a1", utc(2026, 10, 14, 0))
+        self.assertIn(t(10), free_slots(cal, HB, THU, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(2026, 10, 15, 10, 0), kind=FOLLOWUP, therapist="T9", clinic="HB")])
+        self.assertIn(t(10), free_slots(cal, HB, THU, FOLLOWUP))
+
+    def test_same_therapist_at_another_clinic_still_blocks(self):
+        cal = Calendar([appt("a1", local(2026, 10, 15, 10, 0), kind=FOLLOWUP, therapist="T1", clinic="WK")])
+        self.assertNotIn(t(10), free_slots(cal, HB, THU, FOLLOWUP))
+
+    def test_utc_midnight_crossing_uses_auckland_date(self):
+        # 22:30 UTC on 15 Oct is 11:30 on 16 Oct in Auckland, so it blocks 16 Oct, not 15 Oct.
+        cal = Calendar([appt("a1", utc(2026, 10, 15, 22, 30), kind=FOLLOWUP, therapist="T1", clinic="HB")])
+        self.assertNotIn(t(11, 30), free_slots(cal, HB, FRI, FOLLOWUP))
+        self.assertIn(t(11, 30), free_slots(cal, HB, THU, FOLLOWUP))
+
+
+if __name__ == "__main__":
+    unittest.main()
