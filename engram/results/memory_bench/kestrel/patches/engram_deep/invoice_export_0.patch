+"""Monthly invoice export for the accountants' Xero import.
+
+Files that leave the system carry only the patient ID, never the patient name
+(Aroha Ngata's privacy rule), so Invoice.patient_name is not written.
+"""
+
+import csv
+import datetime
+import decimal
+import os
+
+# Xero contact column. It holds the patient ID until Mere or Aroha confirm
+# how Xero should match contacts without a name.
+CONTACT_COLUMN = "ContactName"
+
+COLUMNS = ["InvoiceNumber", CONTACT_COLUMN, "InvoiceDate", "Description", "UnitAmount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir and return the file path."""
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: i.number,
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                _amount(i.amount_cents),
+            ])
+    return path
+
+
+def _amount(cents):
+    """Plain number with two decimals, no dollar sign: 9500 -> '95.00'."""
+    return f"{decimal.Decimal(cents) / 100:.2f}"
