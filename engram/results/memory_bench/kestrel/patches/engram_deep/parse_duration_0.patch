+"""Reading durations typed in by reception."""
+
+import re
+
+_DURATION = re.compile(r"(?:([0-9]+)h\s*(?:([0-9]+)m?)?|([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration such as "45m", "1h" or "1h 30m".
+
+    Accepts "45m", "1h", "1h30", "1h30m" and "1h 30m", with surrounding
+    whitespace ignored. A bare number such as "90" is rejected, because
+    it does not say whether it means minutes or hours.
+    """
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration {text!r}")
+    hours, minutes_after_hours, minutes_only = match.groups()
+    if minutes_only is not None:
+        return int(minutes_only)
+    minutes = int(minutes_after_hours) if minutes_after_hours is not None else 0
+    return int(hours) * 60 + minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
