+"""Exports of invoices for the accountants.
+
+Files that leave the system carry the patient ID only, never patient names.
+"""
+
+import csv
+import datetime
+import os
+
+from .invoices import Invoice
+
+HEADER = ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def _amount(cents):
+    """Plain two-decimal amount with no currency sign: 9500 -> '95.00'."""
+    sign = "-" if cents < 0 else ""
+    dollars, remainder = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{remainder:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year/month to a CSV in out_dir; return its path.
+
+    Dates are the local (Pacific/Auckland) issue dates. Rows are ordered by
+    date, then invoice number.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    os.makedirs(out_dir, exist_ok=True)
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in month_invoices:
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                _amount(invoice.amount_cents),
+            ])
+    return path
