+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-004211", name="Jo Example"):
+    return Invoice(
+        number=number,
+        clinic="NG",
+        patient_id=patient_id,
+        patient_name=name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description="Initial assessment",
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self.tmp.name
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, encoding="utf-8", newline="") as f:
+            return list(csv.reader(f))
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_row_and_only_rows_for_the_month(self):
+        invoices = [
+            invoice("INV-NG-2026-00001", datetime.date(2026, 10, 1)),
+            invoice("INV-NG-2026-00002", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 11, 1)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        rows = self.read_rows(path)
+        self.assertEqual(rows[0], ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"])
+        self.assertEqual(rows[1:], [["INV-NG-2026-00001", "KP-004211", "01/10/2026", "Initial assessment", "95.00"]])
+
+    def test_amounts_are_plain_two_decimal_numbers(self):
+        invoices = [
+            invoice("INV-NG-2026-00001", datetime.date(2026, 10, 1), amount_cents=9500),
+            invoice("INV-NG-2026-00002", datetime.date(2026, 10, 2), amount_cents=7000),
+            invoice("INV-NG-2026-00003", datetime.date(2026, 10, 3), amount_cents=5),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[4] for r in rows[1:]], ["95.00", "70.00", "0.05"])
+
+    def test_never_writes_patient_names(self):
+        invoices = [invoice("INV-NG-2026-00001", datetime.date(2026, 10, 1), name="Jo Example")]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Jo Example", f.read())
+
+    def test_rows_ordered_by_date_then_number(self):
+        invoices = [
+            invoice("INV-NG-2026-00002", datetime.date(2026, 10, 5)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 2)),
+            invoice("INV-NG-2026-00001", datetime.date(2026, 10, 2)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]],
+                         ["INV-HB-2026-00001", "INV-NG-2026-00001", "INV-NG-2026-00002"])
+
+    def test_single_digit_month_is_zero_padded_in_filename(self):
+        path = export_invoices([], 2027, 3, self.out_dir)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2027-03.csv")
+
+    def test_creates_missing_output_directory(self):
+        out_dir = os.path.join(self.out_dir, "exports")
+        path = export_invoices([], 2026, 10, out_dir)
+        self.assertTrue(os.path.isfile(path))
+
+
+if __name__ == "__main__":
+    unittest.main()
