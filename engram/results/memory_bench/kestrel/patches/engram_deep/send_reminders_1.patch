diff --git a/src/kestrel/reminders.py b/src/kestrel/reminders.py
new file mode 100644
index 0000000..4d6ebd1
--- /dev/null
+++ b/src/kestrel/reminders.py
@@ -0,0 +1,34 @@
+"""SMS appointment reminders."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment.
+
+    Per the privacy officer's rule it gives only the date, the time and the
+    clinic's name. It must never mention the treatment.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    return (
+        f"Reminder: you have an appointment at {CLINICS[appointment.clinic].name} "
+        f"on {local:%A} {local.day} {local:%B %Y} at {local:%H:%M}."
+    )
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of every booked appointment.
+
+    `patients` maps patient ID to Patient. Every message is built before any
+    is sent, so a missing patient raises KeyError and nothing is sent.
+    Returns the number of messages sent.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..00b085c
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,107 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ATTENDED, CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+def sent_messages(transport):
+    return [(m["to"], m["text"]) for _, body in transport.calls for m in body["messages"]]
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Aroha Test", "+6421000001", csc=False),
+    "KP-000002": Patient("KP-000002", "Ben Test", "+6421000002", csc=True),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key-123", transport=self.transport)
+
+    def test_one_message_per_booked_appointment(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 21, 2), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 2)
+        recipients = [to for to, _ in sent_messages(self.transport)]
+        self.assertEqual(recipients, ["+6421000001", "+6421000002"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 20, 3), patient="KP-000002", status=CANCELLED),
+            appt("a3", utc(2026, 10, 20, 4), patient="KP-000002", status=ATTENDED),
+            appt("a4", utc(2026, 10, 20, 5), patient="KP-000002", status=NO_SHOW),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 1)
+        self.assertEqual([to for to, _ in sent_messages(self.transport)], ["+6421000001"])
+
+    def test_no_booked_appointments_sends_nothing(self):
+        appointments = [appt("a1", utc(2026, 10, 20, 2), patient="KP-000001", status=CANCELLED)]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_empty_list_sends_nothing(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_accepts_calendar(self):
+        cal = Calendar([
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 20, 3), patient="KP-000002", status=CANCELLED),
+        ])
+        self.assertEqual(send_reminders(cal.all(), PATIENTS, self.client), 1)
+
+    def test_more_than_fifty_splits_into_calls_and_counts_all(self):
+        appointments = [appt(f"a{i}", utc(2026, 10, 20, 2), patient="KP-000001") for i in range(51)]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 51)
+        self.assertEqual([len(b["messages"]) for _, b in self.transport.calls], [50, 1])
+
+    def test_missing_patient_raises_before_anything_is_sent(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 20, 3), patient="KP-009999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_text_has_no_treatment(self):
+        a = appt("a1", utc(2026, 10, 20, 2), patient="KP-000001", treatment="lower back pain")
+        send_reminders([a], PATIENTS, self.client)
+        text = sent_messages(self.transport)[0][1]
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("Aroha", text)
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_date_and_local_time(self):
+        # 20 Oct 2026 is in NZDT (UTC+13), so 02:00 UTC is 15:00 local.
+        a = appt("a1", utc(2026, 10, 20, 2), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Reminder: you have an appointment at Kestrel Physio Harbour on Tuesday 20 October 2026 at 15:00.",
+        )
+
+    def test_uses_auckland_date_across_utc_midnight(self):
+        # 22:30 UTC on 15 Oct is 11:30 on 16 Oct in Auckland.
+        a = appt("a1", utc(2026, 10, 15, 22, 30), clinic="NG")
+        self.assertIn("Friday 16 October 2026 at 11:30.", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
