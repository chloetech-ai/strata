+"""Reading appointment lengths typed in by reception."""
+
+import re
+
+_DURATION = re.compile(r"(?:([0-9]+)h)?\s*(?:([0-9]+)(m)?)?", re.IGNORECASE)
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration such as "45m" or "1h 30m".
+
+    Accepts "45m", "1h", "1h30" and "1h 30m", with surrounding whitespace
+    and any letter case. A bare number such as "45" is rejected because its
+    unit is unclear, and so is a zero-length duration.
+    """
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration {text!r}")
+    hours, minutes, minute_unit = match.groups()
+    if hours is None and (minutes is None or minute_unit is None):
+        raise ValueError(f"invalid duration {text!r}")
+    total = int(hours or 0) * 60 + int(minutes or 0)
+    if total == 0:
+        raise ValueError(f"invalid duration {text!r}")
+    return total
