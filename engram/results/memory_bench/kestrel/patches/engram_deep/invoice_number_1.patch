+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_existing_number(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00010", "INV-WK-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00004")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_years_when_counting(self):
+        existing = ["INV-HB-2027-00002", "INV-HB-2026-00900"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_ignores_numbers_not_in_the_format(self):
+        existing = ["legacy-17", "INV-HB-2027-1", "INV-HB-27-00009", "XINV-HB-2027-00008"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_existing_as_any_iterable(self):
+        existing = (n for n in ["INV-WK-2027-00005"])
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00006")
+
+    def test_rejects_unknown_clinic(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("ZZ", 2027, [])
+
+    def test_rejects_when_sequence_is_exhausted(self):
+        existing = ["INV-NG-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("NG", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
