--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,43 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import MAX_PER_DAY, can_book
+from kestrel.calendar import Calendar
+from kestrel.models import CANCELLED, Therapist
+
+T1 = Therapist("T1", "Ana Lei", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 22))))
+
+    def test_same_start_time_is_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_same_start_for_other_therapist_is_allowed(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_day_limit(self):
+        # Auckland is UTC+13 in March: UTC 00:00-10:00 on 1 March is 13:00-23:00 local on 1 March.
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, i)) for i in range(MAX_PER_DAY)])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_under_day_limit(self):
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, i)) for i in range(MAX_PER_DAY - 1)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10))))
+
+    def test_cancelled_appointments_do_not_count(self):
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, i), status=CANCELLED) for i in range(MAX_PER_DAY)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 0))))
+
+    def test_other_days_do_not_count(self):
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 2, i)) for i in range(MAX_PER_DAY)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10))))
+
+
+if __name__ == "__main__":
+    unittest.main()
