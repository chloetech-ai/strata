 """Session prices."""
 
+import datetime
+
+from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
-# Prices in cents.
+# Prices in cents, for appointments before NEW_PRICES_FROM.
 PRICES = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
 
+# Prices in cents, for appointments on or after NEW_PRICES_FROM.
+NEW_PRICES = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+# First clinic-local (Pacific/Auckland) date on which NEW_PRICES apply.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+
+# Community Services Card holders get this percentage off follow-ups, not assessments.
+CSC_FOLLOWUP_PERCENT_OFF = 20
+
 
 def session_price(kind):
     """Price in cents for a session of the given kind (ASSESSMENT or FOLLOWUP)."""
@@ -15,3 +30,17 @@ def session_price(kind):
         return PRICES[kind]
     except KeyError:
         raise ValueError(f"unknown session kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for an appointment, in cents.
+
+    The price depends on the clinic-local date of the appointment, and CSC
+    holders get a discount on follow-ups.
+    """
+    local_date = appointment.start.astimezone(CLINIC_TZ).date()
+    prices = NEW_PRICES if local_date >= NEW_PRICES_FROM else PRICES
+    price = prices[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
+    return price
