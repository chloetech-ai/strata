+class AppointmentPriceTest(unittest.TestCase):
+    def test_old_prices_before_april_2027(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 3, 1, 9), kind=ASSESSMENT), PATIENT), 9500)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 3, 1, 9), kind=FOLLOWUP), PATIENT), 7000)
+
+    def test_new_prices_from_april_2027(self):
+        self.assertEqual(appointment_price(appt("a1", utc(2027, 4, 10, 9), kind=ASSESSMENT), PATIENT), 10500)
+        self.assertEqual(appointment_price(appt("a2", utc(2027, 4, 10, 9), kind=FOLLOWUP), PATIENT), 7800)
+
+    def test_cutoff_uses_clinic_local_date(self):
+        # 2027-03-31 10:59 UTC is 23:59 on 31 March in Auckland (NZDT, +13).
+        before = appt("a1", utc(2027, 3, 31, 10, 59), kind=FOLLOWUP)
+        # 2027-03-31 11:00 UTC is 00:00 on 1 April in Auckland.
+        after = appt("a2", utc(2027, 3, 31, 11, 0), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(before, PATIENT), 7000)
+        self.assertEqual(appointment_price(after, PATIENT), 7800)
+
+    def test_csc_discount_on_followups_only(self):
+        followup = appt("a1", utc(2027, 4, 10, 9), kind=FOLLOWUP)
+        assessment = appt("a2", utc(2027, 4, 10, 9), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(followup, CSC_PATIENT), 6240)
+        self.assertEqual(appointment_price(assessment, CSC_PATIENT), 10500)
+
+    def test_csc_discount_before_april_2027(self):
+        followup = appt("a1", utc(2027, 3, 1, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(followup, CSC_PATIENT), 5600)
+
+
 if __name__ == "__main__":
     unittest.main()
