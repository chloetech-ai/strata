+++ b/tests/test_export.py
@@ -0,0 +1,87 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from helpers import appt, utc
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=7000, patient_id="KP-004211", patient_name="Test Patient"):
+    return Invoice(
+        number=number, clinic="HB", patient_id=patient_id, patient_name=patient_name,
+        issued=issued, amount_cents=amount_cents, description="Follow-up session",
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.out_dir = self._dir.name
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def read(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5))], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_row_then_one_row_per_invoice(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5))], 2027, 3, self.out_dir)
+        rows = self.read(path)
+        self.assertEqual(rows[0], ["*ContactName", "*InvoiceNumber", "*InvoiceDate", "*Description", "*Quantity", "*UnitAmount"])
+        self.assertEqual(rows[1], ["KP-004211", "INV-HB-2027-00001", "05/03/2027", "Follow-up session", "1", "70.00"])
+        self.assertEqual(len(rows), 2)
+
+    def test_contact_is_patient_id_never_name(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5))], 2027, 3, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Test Patient", f.read())
+
+    def test_only_invoices_issued_in_the_month(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 2, 28)),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 1)),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 31)),
+            invoice("INV-HB-2027-00004", datetime.date(2027, 4, 1)),
+            invoice("INV-HB-2026-00005", datetime.date(2026, 3, 15)),
+        ]
+        rows = self.read(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[1] for r in rows[1:]], ["INV-HB-2027-00002", "INV-HB-2027-00003"])
+
+    def test_sorted_by_invoice_number(self):
+        invoices = [
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 2)),
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 9)),
+        ]
+        rows = self.read(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[1] for r in rows[1:]], ["INV-HB-2027-00001", "INV-HB-2027-00002"])
+
+    def test_amounts_are_plain_two_decimal_numbers(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1), amount_cents=9500),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 2), amount_cents=7005),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 3), amount_cents=100),
+        ]
+        rows = self.read(export_invoices(invoices, 2027, 3, self.out_dir))
+        self.assertEqual([r[5] for r in rows[1:]], ["95.00", "70.05", "1.00"])
+
+    def test_empty_month_writes_header_only(self):
+        rows = self.read(export_invoices([], 2027, 3, self.out_dir))
+        self.assertEqual(len(rows), 1)
+
+    def test_month_is_zero_padded_in_filename(self):
+        path = export_invoices([], 2027, 1, self.out_dir)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2027-01.csv")
+
+
+if __name__ == "__main__":
+    unittest.main()
