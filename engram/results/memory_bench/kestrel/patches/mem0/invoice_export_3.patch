+"""Monthly invoice export for the accountant (Xero import CSV)."""
+
+import csv
+import os
+
+COLUMNS = ["*ContactName", "*InvoiceNumber", "*InvoiceDate", "*Description", "*Quantity", "*UnitAmount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in the given month to out_dir and return the file path.
+
+    Only the patient ID is exported as the contact, never the patient's name.
+    """
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    rows = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: i.number,
+    )
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for invoice in rows:
+            writer.writerow([
+                invoice.patient_id,
+                invoice.number,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                1,
+                f"{invoice.amount_cents // 100}.{invoice.amount_cents % 100:02d}",
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
