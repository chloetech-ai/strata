     description: str = ""
 
 
+def next_invoice_number(clinic, year, existing):
+    """The next number for a clinic's invoice in a year, like INV-HB-2027-00042.
+
+    `existing` holds every issued number, for any clinic and year. Only the
+    ones for this clinic and year count, and the sequence restarts each year.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-(\d{{5}})")
+    sequences = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    return f"INV-{clinic}-{year}-{max(sequences, default=0) + 1:05d}"
+
+
