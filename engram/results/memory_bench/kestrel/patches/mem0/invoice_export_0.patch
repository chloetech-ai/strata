+"""Monthly export of invoices for the accountant (Xero import)."""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as CSV and return the file path.
+
+    The contact is the patient ID, never the patient name, so no names leave the system.
+    Dates are DD/MM/YYYY and amounts are plain numbers with two decimals.
+    """
+    selected = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in selected:
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                1,
+                f"{invoice.amount_cents / 100:.2f}",
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
