diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index e3072fb..c1306ba 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -62,5 +62,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index d02cdca..77ab47b 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -51,6 +51,29 @@ class CalendarTest(unittest.TestCase):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
 
+    def test_upcoming_is_booked_future_for_patient_soonest_first(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("late", utc(2027, 3, 3, 9), patient="KP-000001"),
+            appt("soon", utc(2027, 3, 2, 9), patient="KP-000001"),
+            appt("past", utc(2027, 3, 1, 9), patient="KP-000001"),
+            appt("now", now, patient="KP-000001"),
+            appt("cancelled", utc(2027, 3, 2, 10), patient="KP-000001", status="cancelled"),
+            appt("other", utc(2027, 3, 2, 8), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "late"])
+
+    def test_upcoming_accepts_messy_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2), patient="KP-004211")])
+        for raw in ["kp4211", " KP-004211 "]:
+            with self.subTest(raw=raw):
+                self.assertEqual([a.id for a in cal.upcoming(raw, utc(2027, 3, 1))], ["a1"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1))
+
     def test_cancel_sets_status_and_time(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
         cancelled = cal.cancel("a1", utc(2027, 3, 1, 8))
