@@ -0,0 +1,72 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+NG = Therapist("T1", "Ana", "NG")
+HB = Therapist("T2", "Ben", "HB")
+MONDAY = datetime.date(2027, 3, 1)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+
+
+def at(day, hh, mm=0):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_follows_opening_hours(self):
+        slots = free_slots(Calendar(), NG, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # 30 minutes must end by 18:00
+        self.assertEqual(len(slots), 41)  # quarter hours from 07:30 to 17:30 inclusive
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) and s.minute % 15 == 0 for s in slots))
+
+    def test_assessment_is_45_minutes(self):
+        slots = free_slots(Calendar(), NG, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))  # 45 minutes must end by 18:00
+
+    def test_saturday_only_northgate(self):
+        self.assertEqual(free_slots(Calendar(), NG, SATURDAY, FOLLOWUP)[0], t(8, 0))
+        self.assertEqual(free_slots(Calendar(), NG, SATURDAY, FOLLOWUP)[-1], t(11, 30))
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), NG, SUNDAY, FOLLOWUP), [])
+
+    def test_booked_appointment_blocks_overlapping_starts(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10), kind=FOLLOWUP, therapist="T1", status="booked")])
+        slots = free_slots(cal, NG, MONDAY, ASSESSMENT)
+        self.assertIn(t(9, 15), slots)  # ends at 10:00, just clear
+        self.assertNotIn(t(9, 30), slots)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(10, 30), slots)  # starts when the booking ends
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10), kind=FOLLOWUP, therapist="T1", status=CANCELLED)])
+        self.assertIn(t(10, 0), free_slots(cal, NG, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", at(MONDAY, 10), kind=FOLLOWUP, therapist="T2")])
+        self.assertIn(t(10, 0), free_slots(cal, NG, MONDAY, FOLLOWUP))
+
+    def test_daily_cap_of_eight(self):
+        booked = [appt(f"a{i}", at(MONDAY, 8 + i), kind=FOLLOWUP, therapist="T1") for i in range(8)]
+        self.assertEqual(free_slots(Calendar(booked[:7]), NG, MONDAY, FOLLOWUP)[0], t(7, 30))
+        self.assertEqual(free_slots(Calendar(booked), NG, MONDAY, FOLLOWUP), [])
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), NG, MONDAY, "physio")
+
+
+if __name__ == "__main__":
+    unittest.main()
