+"""Free appointment slots for a therapist on a day."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+SLOT_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+START_STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+MAX_PER_DAY = 8  # union agreement: patient appointments per therapist per day
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a date, or None if the clinic is closed."""
+    if day.weekday() < 5:  # Monday to Friday
+        return datetime.time(7, 30), datetime.time(18, 0)
+    if day.weekday() == 5 and clinic == "NG":  # Saturday: Northgate only
+        return datetime.time(8, 0), datetime.time(12, 0)
+    return None  # Sunday, or Saturday at another clinic
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times, sorted, at which a new appointment of this kind could be booked.
+
+    A slot starts on a quarter hour, ends within the clinic's opening hours, does not
+    overlap any of the therapist's appointments, and the therapist is under the daily cap.
+    `day` is a local (Pacific/Auckland) date.
+    """
+    if kind not in SLOT_MINUTES:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= MAX_PER_DAY:
+        return []
+
+    busy = [(a.start, a.start + datetime.timedelta(minutes=SLOT_MINUTES[a.kind])) for a in booked]
+    length = datetime.timedelta(minutes=SLOT_MINUTES[kind])
+    opens = datetime.datetime.combine(day, hours[0], tzinfo=CLINIC_TZ)
+    closes = datetime.datetime.combine(day, hours[1], tzinfo=CLINIC_TZ)
+
+    slots = []
+    start = opens
+    while start + length <= closes:
+        end = start + length
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += START_STEP
+    return slots
