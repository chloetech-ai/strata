+++ b/tests/test_reminders.py
@@ -0,0 +1,41 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from kestrel.models import ATTENDED, ASSESSMENT
+from kestrel.reminders import reminder_text
+
+from helpers import appt
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_includes_date_time_and_clinic_name(self):
+        start = datetime.datetime(2026, 10, 15, 14, 30, tzinfo=AUCKLAND)
+        text = reminder_text(appt("A1", start, clinic="NG"))
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Thursday 15 October", text)
+        self.assertIn("2:30pm", text)
+
+    def test_morning_time_and_utc_start_converted_to_clinic_time(self):
+        # 20:15 UTC on 14 Oct is 09:15 on 15 Oct in Auckland (NZDT, UTC+13)
+        start = datetime.datetime(2026, 10, 14, 20, 15, tzinfo=datetime.timezone.utc)
+        text = reminder_text(appt("A2", start, clinic="WK"))
+        self.assertIn("Thursday 15 October", text)
+        self.assertIn("9:15am", text)
+        self.assertIn("Kestrel Physio Westwick", text)
+
+    def test_midnight_is_12am(self):
+        start = datetime.datetime(2026, 10, 16, 0, 5, tzinfo=AUCKLAND)
+        self.assertIn("12:05am", reminder_text(appt("A3", start)))
+
+    def test_treatment_is_not_mentioned(self):
+        start = datetime.datetime(2026, 10, 15, 14, 30, tzinfo=AUCKLAND)
+        text = reminder_text(appt("A4", start, kind=ASSESSMENT, treatment="lower back pain", status=ATTENDED))
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
