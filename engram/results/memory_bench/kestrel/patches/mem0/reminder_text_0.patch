+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS, Appointment
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """Return the reminder SMS for an appointment.
+
+    Only the date, time and clinic name are included. The treatment is
+    deliberately left out, so the message reveals nothing about what the
+    appointment is for.
+    """
+    start = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    day = f"{start.strftime('%A')} {start.day} {start.strftime('%B')}"
+    hour = start.hour % 12 or 12
+    ampm = "am" if start.hour < 12 else "pm"
+    time = f"{hour}:{start.minute:02d}{ampm}"
+    return (
+        f"Hi, this is a friendly reminder of your appointment at {clinic} "
+        f"on {day} at {time}. We look forward to seeing you! "
+        f"If you need to change it, please call the clinic."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
