+    def test_upcoming_booked_after_now_soonest_first(self):
+        now = utc(2027, 3, 1, 20)
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("a2", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("a3", utc(2027, 3, 1, 19), patient="KP-004211"),  # before now
+            appt("a4", utc(2027, 3, 1, 20), patient="KP-004211"),  # exactly now
+            appt("a5", utc(2027, 3, 2, 10), patient="KP-004211", status="cancelled"),
+            appt("a6", utc(2027, 3, 2, 11), patient="KP-000007"),  # other patient
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", now)], ["a2", "a1"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 1, 8))
+
     def test_booked(self):
