+"""Finding times when a new appointment can be booked."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+LENGTH = {ASSESSMENT: datetime.timedelta(minutes=45), FOLLOWUP: datetime.timedelta(minutes=30)}
+GAP_AFTER = {ASSESSMENT: datetime.timedelta(minutes=15), FOLLOWUP: datetime.timedelta(0)}  # notes time
+STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+MAX_PER_DAY = 8  # union agreement: patient appointments per therapist per day
+
+WEEKDAY_HOURS = {day: (datetime.time(7, 30), datetime.time(18, 0)) for day in range(5)}  # Monday=0
+OPENING_HOURS = {
+    "NG": {**WEEKDAY_HOURS, 5: (datetime.time(8, 0), datetime.time(12, 0))},
+    "HB": WEEKDAY_HOURS,
+    "WK": WEEKDAY_HOURS,
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times at which a new appointment of this kind could be booked for the therapist on a date.
+
+    A slot is free when the appointment, plus the notes gap after it, clashes with none of the therapist's
+    other (not cancelled) appointments, the appointment itself fits within the clinic's opening hours, and the
+    therapist has fewer than MAX_PER_DAY appointments that day. Returns sorted datetime.time values in CLINIC_TZ.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = OPENING_HOURS[therapist.clinic].get(day.weekday())
+    if hours is None:
+        return []
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= MAX_PER_DAY:
+        return []
+    busy = [(a.start, a.start + LENGTH[a.kind] + GAP_AFTER[a.kind]) for a in booked]
+    opens, closes = (datetime.datetime.combine(day, t) for t in hours)
+    occupied = LENGTH[kind] + GAP_AFTER[kind]
+    slots = []
+    start = opens
+    while start + LENGTH[kind] <= closes:
+        begin = start.replace(tzinfo=CLINIC_TZ).astimezone(datetime.timezone.utc)
+        end = begin + occupied
+        if all(end <= busy_start or busy_end <= begin for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..8da2638
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,117 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+THERAPIST = Therapist("T1", "Test Therapist", "HB")
+MONDAY = datetime.date(2027, 3, 1)  # Monday, NZDT
+SATURDAY = datetime.date(2027, 3, 6)
+
+
+def local(hh, mm=0, day=MONDAY):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+def quarter_hours(first, last):
+    """Every quarter hour from first to last inclusive."""
+    out = []
+    current = datetime.datetime.combine(MONDAY, first)
+    while current.time() <= last:
+        out.append(current.time())
+        current += datetime.timedelta(minutes=15)
+    return out
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_follow_up_runs_from_opening_to_last_fit(self):
+        slots = free_slots(Calendar(), THERAPIST, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, quarter_hours(t(7, 30), t(17, 30)))
+
+    def test_empty_weekday_assessment_must_end_by_closing(self):
+        slots = free_slots(Calendar(), THERAPIST, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 15))
+
+    def test_results_are_sorted_times(self):
+        slots = free_slots(Calendar(), THERAPIST, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+
+    def test_saturday_only_northgate_open(self):
+        northgate = Therapist("T2", "Test Therapist", "NG")
+        self.assertEqual(free_slots(Calendar(), northgate, SATURDAY, ASSESSMENT)[-1], t(11, 15))
+        self.assertEqual(free_slots(Calendar(), northgate, SATURDAY, FOLLOWUP)[-1], t(11, 30))
+        self.assertEqual(free_slots(Calendar(), THERAPIST, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), THERAPIST, MONDAY + datetime.timedelta(days=6), FOLLOWUP), [])
+
+    def test_follow_up_blocks_only_its_own_half_hour(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, MONDAY, FOLLOWUP)
+        for blocked in [t(9, 45), t(10, 0), t(10, 15)]:
+            self.assertNotIn(blocked, slots)
+        self.assertIn(t(9, 30), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_assessment_keeps_a_fifteen_minute_notes_gap_after_it(self):
+        cal = Calendar([appt("a1", local(10), kind=ASSESSMENT, therapist="T1")])
+        follow_ups = free_slots(cal, THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(10, 45), follow_ups)  # would run into the notes gap
+        self.assertIn(t(11, 0), follow_ups)
+        assessments = free_slots(cal, THERAPIST, MONDAY, ASSESSMENT)
+        self.assertIn(t(9, 0), assessments)
+        self.assertNotIn(t(9, 15), assessments)  # would run into the existing assessment
+        self.assertIn(t(11, 0), assessments)
+
+    def test_new_assessment_cannot_run_into_existing_appointment(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, MONDAY, ASSESSMENT)
+        self.assertNotIn(t(9, 30), slots)  # 9:30 to 10:30 with the gap, overlapping the follow-up
+        self.assertIn(t(9, 0), slots)  # 9:00 to 10:00 with the gap, touching the follow-up
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T1", status=CANCELLED,
+                             cancelled_at=local(9))])
+        self.assertIn(t(10, 0), free_slots(cal, THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T2")])
+        self.assertIn(t(10, 0), free_slots(cal, THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_day_is_local_date(self):
+        # 21:00 UTC on 28 Feb is 10:00 on 1 March in Auckland (NZDT).
+        cal = Calendar([appt("a1", datetime.datetime(2027, 2, 28, 21, 0, tzinfo=datetime.timezone.utc),
+                             kind=FOLLOWUP, therapist="T1")])
+        self.assertNotIn(t(10, 0), free_slots(cal, THERAPIST, MONDAY, FOLLOWUP))
+        self.assertIn(t(10, 0), free_slots(cal, THERAPIST, MONDAY + datetime.timedelta(days=1), FOLLOWUP))
+
+    def test_no_slots_once_therapist_has_eight_appointments(self):
+        booked = [appt(f"a{h}", local(h), kind=FOLLOWUP, therapist="T1") for h in range(8, 16)]
+        self.assertEqual(len(booked), 8)
+        self.assertEqual(free_slots(Calendar(booked), THERAPIST, MONDAY, FOLLOWUP), [])
+
+    def test_seven_appointments_still_leaves_slots(self):
+        booked = [appt(f"a{h}", local(h), kind=FOLLOWUP, therapist="T1") for h in range(8, 15)]
+        self.assertTrue(free_slots(Calendar(booked), THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        booked = [appt(f"a{h}", local(h), kind=FOLLOWUP, therapist="T1") for h in range(8, 16)]
+        booked[0].status = CANCELLED
+        booked[0].cancelled_at = local(7)
+        self.assertTrue(free_slots(Calendar(booked), THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, MONDAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
