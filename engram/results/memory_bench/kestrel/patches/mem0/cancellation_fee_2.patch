+"""Cancellation fees."""
+
+import datetime
+
+from .models import ATTENDED, BOOKED, CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation this close to the start (or later) is charged half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for an appointment that was cancelled or missed.
+
+    For a cancelled appointment, `cancelled_at` is when the patient cancelled;
+    it defaults to the appointment's own `cancelled_at`. For a no-show it is
+    not needed. Attended and booked appointments have no fee.
+    """
+    if appointment.status == NO_SHOW:
+        return session_price(appointment.kind)
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            cancelled_at = appointment.cancelled_at
+        if cancelled_at is None:
+            raise ValueError("cancelled appointment needs a cancellation time")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancelled_at must be timezone-aware")
+        if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+            return session_price(appointment.kind) // 2
+        return 0
+    if appointment.status in (ATTENDED, BOOKED):
+        return 0
+    raise ValueError(f"unknown status {appointment.status!r}")
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..1c41fd4
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_inside_48_hours_is_half_price(self):
+        a = appt("a1", utc(2027, 3, 3, 10), status=CANCELLED, cancelled_at=utc(2027, 3, 1, 11))
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 11)), 3500)
+
+    def test_cancelled_inside_48_hours_assessment(self):
+        a = appt("a1", utc(2027, 3, 3, 10), kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 2, 10, 1)), 4750)
+
+    def test_cancelled_exactly_48_hours_before_is_free(self):
+        a = appt("a1", utc(2027, 3, 3, 10), status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 10)), 0)
+
+    def test_cancelled_well_ahead_is_free(self):
+        a = appt("a1", utc(2027, 3, 10, 10), status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 10)), 0)
+
+    def test_cancelled_after_start_is_half_price(self):
+        a = appt("a1", utc(2027, 3, 3, 10), status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 3, 11)), 3500)
+
+    def test_cancellation_time_defaults_to_appointment_field(self):
+        a = appt("a1", utc(2027, 3, 3, 10), status=CANCELLED, cancelled_at=utc(2027, 3, 2, 10))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelled_without_time_is_an_error(self):
+        a = appt("a1", utc(2027, 3, 3, 10), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_rejects_naive_cancellation_time(self):
+        a = appt("a1", utc(2027, 3, 3, 10), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 1, 10))
+
+    def test_no_show_is_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", utc(2027, 3, 3, 10), status=NO_SHOW)), 7000)
+        self.assertEqual(cancellation_fee(appt("a1", utc(2027, 3, 3, 10), kind=ASSESSMENT, status=NO_SHOW)), 9500)
+
+    def test_attended_and_booked_have_no_fee(self):
+        for status in [ATTENDED, BOOKED]:
+            with self.subTest(status=status):
+                self.assertEqual(cancellation_fee(appt("a1", utc(2027, 3, 3, 10), status=status)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
