+import datetime
+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty_input_gives_empty_list(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_pair_is_returned_as_is(self):
+        self.assertEqual(merge_busy([(1, 3)]), [(1, 3)])
+
+    def test_disjoint_pairs_are_sorted_and_kept_apart(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_pair_does_not_shrink_the_range(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_any_order_gives_same_result(self):
+        pairs = [(8, 9), (1, 2), (2, 4), (7, 8), (3, 5)]
+        self.assertEqual(merge_busy(pairs), [(1, 5), (7, 9)])
+        self.assertEqual(merge_busy(list(reversed(pairs))), [(1, 5), (7, 9)])
+
+    def test_does_not_modify_input(self):
+        pairs = [(3, 4), (1, 2)]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(3, 4), (1, 2)])
+
+    def test_works_with_datetimes(self):
+        d = datetime.datetime
+        self.assertEqual(
+            merge_busy([(d(2027, 3, 1, 10), d(2027, 3, 1, 11)), (d(2027, 3, 1, 9), d(2027, 3, 1, 10))]),
+            [(d(2027, 3, 1, 9), d(2027, 3, 1, 11))],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
