--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,73 @@
+import datetime
+import unittest
+
+from kestrel.models import CANCELLED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+def patients_by_id():
+    return {
+        "KP-000001": Patient("KP-000001", "Ana", "+64211111111"),
+        "KP-000002": Patient("KP-000002", "Ben", "+64222222222"),
+    }
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_only(self):
+        # 2026-10-18 20:30 UTC is Monday 19 October 09:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 18, 20, 30), clinic="HB", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertEqual(text, "Kestrel Physio Harbour: reminder of your appointment on Monday 19 October at 09:30.")
+        self.assertNotIn("lower back pain", text)
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_message_per_booked_appointment(self):
+        transport = FakeTransport()
+        client = BulkieClient("key", transport)
+        appointments = [
+            appt("A1", utc(2026, 10, 19, 1, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 19, 2, 0), patient="KP-000002"),
+        ]
+        sent = send_reminders(appointments, patients_by_id(), client)
+        self.assertEqual(sent, 2)
+        messages = [m for _, body in transport.calls for m in body["messages"]]
+        self.assertEqual([m["to"] for m in messages], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        transport = FakeTransport()
+        client = BulkieClient("key", transport)
+        cancelled = appt("A2", utc(2026, 10, 19, 2, 0), patient="KP-000002", status=CANCELLED,
+                         cancelled_at=utc(2026, 10, 10))
+        sent = send_reminders([appt("A1", utc(2026, 10, 19, 1, 0)), cancelled], patients_by_id(), client)
+        self.assertEqual(sent, 1)
+        messages = [m for _, body in transport.calls for m in body["messages"]]
+        self.assertEqual([m["to"] for m in messages], ["+64211111111"])
+
+    def test_no_appointments_sends_nothing(self):
+        transport = FakeTransport()
+        self.assertEqual(send_reminders([], patients_by_id(), BulkieClient("key", transport)), 0)
+        self.assertEqual(transport.calls, [])
+
+    def test_more_than_one_batch(self):
+        transport = FakeTransport()
+        appointments = [appt(f"A{i}", utc(2026, 10, 19, 1, 0) + datetime.timedelta(minutes=i), patient="KP-000001")
+                        for i in range(120)]
+        self.assertEqual(send_reminders(appointments, patients_by_id(), BulkieClient("key", transport)), 120)
+        self.assertEqual([len(body["messages"]) for _, body in transport.calls], [50, 50, 20])
+
+
+if __name__ == "__main__":
+    unittest.main()
