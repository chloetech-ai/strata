+"""Checks run before an appointment is saved."""
+
+from .calendar import CLINIC_TZ
+from .models import CANCELLED
+
+MAX_PATIENTS_PER_DAY = 8  # therapists' union agreement
+
+
+def can_book(calendar, therapist, appointment):
+    """True if appointment can be added to calendar for therapist.
+
+    Rejects a start time already taken by one of the therapist's live (not cancelled)
+    appointments, and a day where the therapist already has MAX_PATIENTS_PER_DAY.
+    """
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    live = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if any(a.start == appointment.start for a in live):
+        return False
+    return len(live) < MAX_PATIENTS_PER_DAY
diff --git a/tests/test_booking.py b/tests/test_booking.py
