@@ -0,0 +1,28 @@
+import unittest
+
+from helpers import appt, utc
+
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_clinic_day_and_local_time(self):
+        # 03:30 UTC on 20 Oct 2026 is 16:30 in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("a1", utc(2026, 10, 20, 3, 30), clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tuesday 20 October at 16:30", text)
+
+    def test_uses_clinic_local_date_not_utc_date(self):
+        # 11:00 UTC on 19 Oct is already 00:00 on 20 Oct in Auckland.
+        text = reminder_text(appt("a1", utc(2026, 10, 19, 11, 0), clinic="NG"))
+        self.assertIn("Tuesday 20 October at 00:00", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_leaves_out_treatment_and_patient_details(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 20, 3, 30), treatment="lower back pain", patient="KP-004211"))
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
