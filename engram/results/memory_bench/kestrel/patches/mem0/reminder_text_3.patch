+"""Text of the appointment reminder SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Only the clinic, date and time are included: the treatment is private.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    when = f"{local:%A} {local.day} {local:%B} at {local:%H:%M}"
+    return (
+        f"Hi there, this is a reminder of your appointment at {clinic} "
+        f"on {when}. We look forward to seeing you! "
+        f"If you need to change it, please call the clinic."
+    )
