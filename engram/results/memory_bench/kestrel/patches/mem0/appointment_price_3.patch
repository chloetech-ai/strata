 # Prices in cents.
@@ -8,10 +11,33 @@ PRICES = {
     FOLLOWUP: 7000,
 }
 
+# Prices from 1 April 2027, in cents. Appointments before this date keep PRICES.
+NEW_PRICES = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+
+# Community Services Card holders get this percentage off follow-ups only.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
-def session_price(kind):
-    """Price in cents for a session of the given kind (ASSESSMENT or FOLLOWUP)."""
+def session_price(kind, on=None):
+    """Price in cents for a session of the given kind (ASSESSMENT or FOLLOWUP).
+
+    `on` is the date the session takes place; if omitted, the old prices apply.
+    """
+    table = PRICES if on is None or on < NEW_PRICES_FROM else NEW_PRICES
     try:
-        return PRICES[kind]
+        return table[kind]
     except KeyError:
         raise ValueError(f"unknown session kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Price in cents the patient pays for the appointment, after any concession."""
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, on=day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
