+class AppointmentPriceTest(unittest.TestCase):
+    def test_standard_prices(self):
+        before = datetime.datetime(2027, 3, 1, 10, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, before), patient()), 9500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, before), patient()), 7000)
+
+    def test_new_prices_apply_from_april_2027(self):
+        after = datetime.datetime(2027, 4, 2, 10, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, after), patient()), 10500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, after), patient()), 7800)
+
+    def test_date_is_taken_in_clinic_time(self):
+        # 31 March 23:30 in Auckland is 1 April UTC, but the clinic's date is still 31 March.
+        late = datetime.datetime(2027, 3, 31, 23, 30, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, late), patient()), 7000)
+
+    def test_csc_discount_on_followups_only(self):
+        before = datetime.datetime(2027, 3, 1, 10, 0, tzinfo=AUCKLAND)
+        after = datetime.datetime(2027, 4, 2, 10, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, before), patient(csc=True)), 5600)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, after), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, after), patient(csc=True)), 10500)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, before), patient(csc=True)), 9500)
+
