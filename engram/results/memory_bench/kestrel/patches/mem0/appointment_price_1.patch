+from kestrel.models import ASSESSMENT, FOLLOWUP, Patient
+from kestrel.pricing import appointment_price, session_price
+from helpers import appt, utc
+
+
+def patient(csc=False):
+    return Patient("KP-000001", "Ana Silva", "+64211234567", csc=csc)
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def test_old_prices_before_change(self):
+        self.assertEqual(appointment_price(appt("a", utc(2027, 3, 1), kind=ASSESSMENT), patient()), 9500)
+        self.assertEqual(appointment_price(appt("b", utc(2027, 3, 1), kind=FOLLOWUP), patient()), 7000)
+
+    def test_new_prices_from_change_date(self):
+        self.assertEqual(appointment_price(appt("a", utc(2027, 4, 10), kind=ASSESSMENT), patient()), 10500)
+        self.assertEqual(appointment_price(appt("b", utc(2027, 4, 10), kind=FOLLOWUP), patient()), 7800)
+
+    def test_change_is_judged_on_clinic_local_date(self):
+        # 2027-03-31 11:30 UTC is 2027-04-01 00:30 in Auckland (NZDT, UTC+13).
+        self.assertEqual(appointment_price(appt("a", utc(2027, 3, 31, 11, 30), kind=FOLLOWUP), patient()), 7800)
+        # 2027-03-31 10:59 UTC is still 2027-03-31 23:59 in Auckland.
+        self.assertEqual(appointment_price(appt("b", utc(2027, 3, 31, 10, 59), kind=FOLLOWUP), patient()), 7000)
+
+    def test_csc_discount_on_followup_only(self):
+        self.assertEqual(appointment_price(appt("a", utc(2027, 3, 1), kind=FOLLOWUP), patient(csc=True)), 5600)
+        self.assertEqual(appointment_price(appt("b", utc(2027, 4, 10), kind=FOLLOWUP), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appt("c", utc(2027, 4, 10), kind=ASSESSMENT), patient(csc=True)), 10500)
+        self.assertEqual(appointment_price(appt("d", utc(2027, 3, 1), kind=ASSESSMENT), patient(csc=True)), 9500)
 
 
 class SessionPriceTest(unittest.TestCase):
