 """Session prices."""
 
+import datetime
+
+from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
 # Prices in cents.
@@ -8,6 +11,15 @@ PRICES = {
     FOLLOWUP: 7000,
 }
 
+# New prices apply to appointments on or after this clinic-local date.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
 def session_price(kind):
     """Price in cents for a session of the given kind (ASSESSMENT or FOLLOWUP)."""
@@ -15,3 +27,19 @@ def session_price(kind):
         return PRICES[kind]
     except KeyError:
         raise ValueError(f"unknown session kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    The price depends on the appointment's clinic-local date. Community Services
+    Card holders get a discount on follow-ups only.
+    """
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    if day >= PRICE_CHANGE_DATE:
+        price = NEW_PRICES[appointment.kind]
+    else:
+        price = session_price(appointment.kind)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
