+"""Text of the appointment reminder SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Only the date, time and clinic name go in the message. It must not say what the appointment is for.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    meridiem = f"{local:%p}".lower()
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local:%M}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi there, this is a friendly reminder of your appointment at {clinic} "
+        f"on {when}. If you need to change it, please get in touch with the clinic. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
