@@ -0,0 +1,50 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from kestrel.models import Appointment, FOLLOWUP
+from kestrel.reminders import reminder_text
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def appointment(self, start, clinic="NG", treatment="lower back pain"):
+        return Appointment(
+            id="A1", patient_id="KP-004211", therapist_id="T1", clinic=clinic,
+            start=start, kind=FOLLOWUP, treatment=treatment,
+        )
+
+    def test_includes_clinic_name_local_date_and_time(self):
+        start = datetime.datetime(2026, 10, 20, 9, 30, tzinfo=AUCKLAND)
+        text = reminder_text(self.appointment(start))
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Tuesday 20 October at 9:30am", text)
+
+    def test_converts_utc_start_to_clinic_time(self):
+        # 21:30 UTC on 20 October is 10:30am on 21 October in Auckland (NZDT, UTC+13).
+        start = datetime.datetime(2026, 10, 20, 21, 30, tzinfo=datetime.timezone.utc)
+        text = reminder_text(self.appointment(start, clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Wednesday 21 October at 10:30am", text)
+
+    def test_afternoon_time_uses_pm_and_twelve_hour_clock(self):
+        start = datetime.datetime(2026, 10, 22, 13, 5, tzinfo=AUCKLAND)
+        self.assertIn("at 1:05pm", reminder_text(self.appointment(start, clinic="WK")))
+
+    def test_midday_and_midnight_hours(self):
+        noon = datetime.datetime(2026, 10, 22, 12, 0, tzinfo=AUCKLAND)
+        midnight = datetime.datetime(2026, 10, 22, 0, 15, tzinfo=AUCKLAND)
+        self.assertIn("at 12:00pm", reminder_text(self.appointment(noon)))
+        self.assertIn("at 12:15am", reminder_text(self.appointment(midnight)))
+
+    def test_does_not_mention_treatment_or_kind(self):
+        start = datetime.datetime(2026, 10, 20, 9, 30, tzinfo=AUCKLAND)
+        text = reminder_text(self.appointment(start, treatment="lower back pain"))
+        self.assertNotIn("lower back", text.lower())
+        self.assertNotIn("physio session", text.lower())
+        self.assertNotIn("follow", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
