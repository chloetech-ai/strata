+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_interval(self):
+        self.assertEqual(merge_busy([(9, 10)]), [(9, 10)])
+
+    def test_sorts_out_of_order_input(self):
+        self.assertEqual(merge_busy([(12, 13), (8, 9), (9.5, 10)]), [(8, 9), (9.5, 10), (12, 13)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(8, 10), (9, 11), (10.5, 12)]), [(8, 12)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(8, 9), (9, 10)]), [(8, 10)])
+
+    def test_contained_pair_does_not_shrink_result(self):
+        self.assertEqual(merge_busy([(8, 12), (9, 10)]), [(8, 12)])
+
+    def test_disjoint_pairs_stay_separate(self):
+        self.assertEqual(merge_busy([(8, 9), (10, 11)]), [(8, 9), (10, 11)])
+
+    def test_does_not_modify_input(self):
+        pairs = [(9, 10), (8, 9)]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(9, 10), (8, 9)])
+
+    def test_rejects_interval_ending_before_it_starts(self):
+        with self.assertRaises(ValueError):
+            merge_busy([(10, 9)])
+
+
+if __name__ == "__main__":
+    unittest.main()
