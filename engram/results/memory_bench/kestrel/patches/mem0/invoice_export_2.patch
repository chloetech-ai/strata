+"""Monthly export of invoices for the accountant (Mere at Tui Accounting, imported into Xero)."""
+
+import csv
+import os
+from decimal import Decimal
+
+# Xero invoice import columns. The contact is the patient ID, never the name.
+COLUMNS = ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"]
+DATE_FORMAT = "%d/%m/%Y"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as CSV and return the file's path.
+
+    Invoices are matched on their local (clinic) issue date. The file is named
+    kestrel-invoices-YYYY-MM.csv and has a header row, DD/MM/YYYY dates and
+    amounts with two decimals and no currency sign.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: i.number,
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for invoice in month_invoices:
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.issued.strftime(DATE_FORMAT),
+                invoice.description,
+                1,
+                f"{Decimal(invoice.amount_cents) / 100:.2f}",
+            ])
+    return path
