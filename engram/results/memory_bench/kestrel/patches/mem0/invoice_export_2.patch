@@ -0,0 +1,87 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, cents=7000, patient_id="KP-004211", patient_name="Test Patient", description="Follow-up session"):
+    return Invoice(
+        number=number, clinic="HB", patient_id=patient_id, patient_name=patient_name,
+        issued=issued, amount_cents=cents, description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", datetime.date(2027, 3, 2))], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_and_row_format(self):
+        path = export_invoices(
+            [invoice("INV-HB-2027-00042", datetime.date(2027, 3, 2), cents=9500, description="Initial assessment")],
+            2027, 3, self.out_dir,
+        )
+        self.assertEqual(self.read(path), [
+            ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"],
+            ["INV-HB-2027-00042", "KP-004211", "02/03/2027", "Initial assessment", "1", "95.00"],
+        ])
+
+    def test_amounts_have_two_decimals_and_no_currency_sign(self):
+        path = export_invoices(
+            [invoice("INV-1", datetime.date(2027, 3, 1), cents=7005), invoice("INV-2", datetime.date(2027, 3, 1), cents=7000)],
+            2027, 3, self.out_dir,
+        )
+        amounts = [row[5] for row in self.read(path)[1:]]
+        self.assertEqual(amounts, ["70.05", "70.00"])
+
+    def test_only_invoices_from_the_given_month(self):
+        invoices = [
+            invoice("INV-1", datetime.date(2027, 2, 28)),
+            invoice("INV-2", datetime.date(2027, 3, 1)),
+            invoice("INV-3", datetime.date(2027, 3, 31)),
+            invoice("INV-4", datetime.date(2027, 4, 1)),
+            invoice("INV-5", datetime.date(2026, 3, 15)),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual([row[0] for row in self.read(path)[1:]], ["INV-2", "INV-3"])
+
+    def test_never_includes_patient_names(self):
+        path = export_invoices(
+            [invoice("INV-1", datetime.date(2027, 3, 1), patient_name="Jane Example")], 2027, 3, self.out_dir,
+        )
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Jane Example", f.read())
+
+    def test_rows_sorted_by_invoice_number(self):
+        invoices = [invoice("INV-3", datetime.date(2027, 3, 1)), invoice("INV-1", datetime.date(2027, 3, 1))]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual([row[0] for row in self.read(path)[1:]], ["INV-1", "INV-3"])
+
+    def test_month_with_no_invoices_writes_header_only(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2027, 3, 1))], 2027, 5, self.out_dir)
+        self.assertEqual(len(self.read(path)), 1)
+
+    def test_rerun_overwrites_file(self):
+        export_invoices([invoice("INV-1", datetime.date(2027, 3, 1))], 2027, 3, self.out_dir)
+        path = export_invoices([], 2027, 3, self.out_dir)
+        self.assertEqual(len(self.read(path)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
