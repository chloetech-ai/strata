+"""Cancellation and no-show fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# Cancelling less than this long before the start incurs half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for an appointment that was cancelled or missed.
+
+    A cancelled appointment is charged half the session price when the patient
+    cancelled inside LATE_CANCELLATION_WINDOW before the start, and nothing
+    otherwise. A no-show is charged the full session price; cancelled_at is
+    None for a no-show.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled_at is required for a cancelled appointment")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..664ba1a
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,57 @@
+import datetime
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW, Appointment
+
+START = datetime.datetime(2026, 11, 2, 10, 0, tzinfo=datetime.timezone.utc)
+
+
+def appointment(kind=FOLLOWUP, status=CANCELLED):
+    return Appointment(
+        id="A1",
+        patient_id="KP-004211",
+        therapist_id="T1",
+        clinic="NG",
+        start=START,
+        kind=kind,
+        status=status,
+    )
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_inside_window_is_half_price(self):
+        cancelled_at = START - datetime.timedelta(hours=47)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), cancelled_at), 3500)
+        self.assertEqual(cancellation_fee(appointment(ASSESSMENT), cancelled_at), 4750)
+
+    def test_cancelled_outside_window_is_free(self):
+        cancelled_at = START - datetime.timedelta(hours=49)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), cancelled_at), 0)
+
+    def test_window_boundary_is_outside(self):
+        cancelled_at = START - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), cancelled_at), 0)
+
+    def test_no_show_is_full_price(self):
+        appt = appointment(ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(appt), 9500)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP, status=NO_SHOW)), 7000)
+
+    def test_cancelled_requires_cancelled_at(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(FOLLOWUP), None)
+
+    def test_rejects_naive_cancelled_at(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(FOLLOWUP), datetime.datetime(2026, 11, 1, 10, 0))
+
+    def test_rejects_statuses_without_fee(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appointment(FOLLOWUP, status=status), START)
+
+
+if __name__ == "__main__":
+    unittest.main()
