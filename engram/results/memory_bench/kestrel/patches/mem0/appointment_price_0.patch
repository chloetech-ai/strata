 """Session prices."""
 
+import datetime
+
+from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
 # Prices in cents.
@@ -8,6 +11,16 @@ PRICES = {
     FOLLOWUP: 7000,
 }
 
+# Appointments on or after this clinic-local date pay NEW_PRICES.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+CSC_DISCOUNT_PERCENT = 20  # Community Services Card holders
+CSC_DISCOUNTED_KINDS = (FOLLOWUP,)  # not initial assessments
+
 
 def session_price(kind):
     """Price in cents for a session of the given kind (ASSESSMENT or FOLLOWUP)."""
@@ -15,3 +28,17 @@ def session_price(kind):
         return PRICES[kind]
     except KeyError:
         raise ValueError(f"unknown session kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Price in cents the patient pays for an appointment.
+
+    The price in force is chosen by the appointment's local (clinic) date, and
+    Community Services Card holders get the discount on follow-ups.
+    """
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    table = NEW_PRICES if day >= PRICE_CHANGE_DATE else PRICES
+    price = table[appointment.kind]
+    if patient.csc and appointment.kind in CSC_DISCOUNTED_KINDS:
+        price = price * (100 - CSC_DISCOUNT_PERCENT) // 100
+    return price
