+from helpers import appt, utc
+
+from kestrel.models import ASSESSMENT, FOLLOWUP, Patient
+from kestrel.pricing import appointment_price, session_price
+
+PATIENT = Patient(id="KP-004211", name="Test Patient", phone="+64211234567")
+CSC_PATIENT = Patient(id="KP-004212", name="CSC Patient", phone="+64211234568", csc=True)
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def test_old_prices_before_change(self):
+        a = appt("a1", utc(2027, 3, 1, 9), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, PATIENT), 9500)
+        a = appt("a2", utc(2027, 3, 1, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, PATIENT), 7000)
+
+    def test_new_prices_from_change(self):
+        a = appt("a1", utc(2027, 4, 10, 9), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, PATIENT), 10500)
+        a = appt("a2", utc(2027, 4, 10, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, PATIENT), 7800)
+
+    def test_change_date_uses_clinic_local_date(self):
+        # 2027-03-31 23:30 in Auckland (NZDT, UTC+13) is still the old price.
+        before = appt("a1", utc(2027, 3, 31, 10, 30), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(before, PATIENT), 7000)
+        # 2027-04-01 00:00 in Auckland is 2027-03-31 11:00 UTC: already the new price.
+        after = appt("a2", utc(2027, 3, 31, 11, 0), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(after, PATIENT), 7800)
+
+    def test_csc_discount_on_followup(self):
+        a = appt("a1", utc(2027, 3, 1, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, CSC_PATIENT), 5600)
+        a = appt("a2", utc(2027, 4, 10, 9), kind=FOLLOWUP)
+        self.assertEqual(appointment_price(a, CSC_PATIENT), 6240)
+
+    def test_no_csc_discount_on_assessment(self):
+        a = appt("a1", utc(2027, 4, 10, 9), kind=ASSESSMENT)
+        self.assertEqual(appointment_price(a, CSC_PATIENT), 10500)
+
+    def test_price_is_in_cents(self):
+        a = appt("a1", utc(2027, 4, 10, 9), kind=FOLLOWUP)
+        self.assertIsInstance(appointment_price(a, CSC_PATIENT), int)
 
 
 class SessionPriceTest(unittest.TestCase):
