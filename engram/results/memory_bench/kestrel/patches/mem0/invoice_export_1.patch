+"""Exports for the accountant."""
+
+import csv
+import decimal
+import os
+
+HEADER = ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"]
+
+
+def _amount(cents):
+    # Plain number with two decimals and no currency symbol, e.g. 95.00.
+    return format(decimal.Decimal(cents) / 100, ".2f")
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as a Xero-importable CSV, and return its path.
+
+    Only patient IDs are written, never names. Rows are ordered by issue date, then invoice number.
+    """
+    in_month = [i for i in invoices if i.issued.year == year and i.issued.month == month]
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in sorted(in_month, key=lambda i: (i.issued, i.number)):
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                1,
+                _amount(invoice.amount_cents),
+            ])
+    return path
