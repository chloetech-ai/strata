+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, patient_id="KP-004211", patient_name="Test Patient", amount_cents=7000,
+            description="Follow-up session"):
+    return Invoice(number=number, clinic="HB", patient_id=patient_id, patient_name=patient_name,
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, encoding="utf-8", newline="") as f:
+            return list(csv.reader(f))
+
+    def test_writes_named_file_in_out_dir_and_returns_its_path(self):
+        path = export_invoices([invoice("INV-HB-2027-00001", datetime.date(2027, 3, 2))], 2027, 3, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2027-03.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_and_row_format(self):
+        path = export_invoices(
+            [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 2), amount_cents=9500,
+                     description="Initial assessment")],
+            2027, 3, self.out_dir)
+        self.assertEqual(self.read_rows(path), [
+            ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"],
+            ["INV-HB-2027-00001", "KP-004211", "02/03/2027", "Initial assessment", "1", "95.00"],
+        ])
+
+    def test_amounts_have_two_decimals_and_no_symbol(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2027, 3, 2), amount_cents=7050)], 2027, 3, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][5], "70.50")
+
+    def test_never_writes_patient_names(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2027, 3, 2), patient_name="Jane Secret")], 2027, 3,
+                               self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Jane Secret", f.read())
+
+    def test_only_includes_invoices_issued_in_the_month(self):
+        invoices = [
+            invoice("INV-A", datetime.date(2027, 2, 28)),
+            invoice("INV-B", datetime.date(2027, 3, 1)),
+            invoice("INV-C", datetime.date(2027, 3, 31)),
+            invoice("INV-D", datetime.date(2027, 4, 1)),
+            invoice("INV-E", datetime.date(2026, 3, 15)),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual([row[0] for row in self.read_rows(path)[1:]], ["INV-B", "INV-C"])
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-2", datetime.date(2027, 3, 5)),
+            invoice("INV-3", datetime.date(2027, 3, 1)),
+            invoice("INV-1", datetime.date(2027, 3, 5)),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.out_dir)
+        self.assertEqual([row[0] for row in self.read_rows(path)[1:]], ["INV-3", "INV-1", "INV-2"])
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([], 2027, 3, self.out_dir)
+        self.assertEqual(len(self.read_rows(path)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
