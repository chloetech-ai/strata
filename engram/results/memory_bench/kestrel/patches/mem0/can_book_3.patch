@@ -0,0 +1,25 @@
+"""Checks run by the booking form before an appointment is saved."""
+
+from .calendar import CLINIC_TZ
+from .models import CANCELLED
+
+MAX_PER_DAY = 8  # union agreement: patient appointments per therapist per day
+
+
+def can_book(calendar, therapist, appointment):
+    """True if appointment can be added to calendar for therapist, else False.
+
+    Refuses an appointment for another therapist, an id already in the calendar,
+    a second appointment at the same start time (no overbooking), and any
+    appointment that would take the therapist past MAX_PER_DAY on its local date.
+    Cancelled appointments do not count.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if any(a.id == appointment.id for a in calendar.all()):
+        return False
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    existing = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if any(a.start == appointment.start for a in existing):
+        return False
+    return len(existing) < MAX_PER_DAY
