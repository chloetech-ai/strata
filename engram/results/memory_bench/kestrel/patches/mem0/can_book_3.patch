@@ -0,0 +1,58 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import MAX_PER_DAY, can_book
+from kestrel.calendar import Calendar
+from kestrel.models import Therapist
+
+T1 = Therapist("T1", "Ana", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_rejects_same_start_for_same_therapist(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_allows_same_start_for_other_therapist(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_ignores_cancelled_at_same_start(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), status="cancelled")])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 20))))
+
+    def test_rejects_appointment_for_other_therapist(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("new", utc(2027, 3, 1, 20), therapist="T2")))
+
+    def test_rejects_duplicate_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, T1, appt("a1", utc(2027, 3, 1, 22))))
+
+    def test_day_cap(self):
+        # Eight appointments on 1 March local (13:00-20:00 NZDT), then a ninth on the same day.
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, i)) for i in range(MAX_PER_DAY)])
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 8))))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 2, 0))))
+
+    def test_day_cap_ignores_cancelled(self):
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, i)) for i in range(MAX_PER_DAY - 1)])
+        cal.add(appt("c1", utc(2027, 3, 1, 7), status="cancelled"))
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 8))))
+
+    def test_day_cap_is_per_therapist(self):
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, i), therapist="T2") for i in range(MAX_PER_DAY)])
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 8))))
+
+    def test_day_uses_auckland_date(self):
+        # 10:59 UTC on 1 March is 23:59 on 1 March in Auckland; 11:00 UTC is 00:00 on 2 March.
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, 0, i)) for i in range(MAX_PER_DAY)])  # 13:00-13:07 local
+        self.assertTrue(can_book(cal, T1, appt("new", utc(2027, 3, 1, 11, 0))))
+        cal = Calendar([appt(f"a{i}", utc(2027, 3, 1, 10, i)) for i in range(MAX_PER_DAY)])  # 23:00-23:07 local
+        self.assertFalse(can_book(cal, T1, appt("new", utc(2027, 3, 1, 10, 30))))
+
+
+if __name__ == "__main__":
+    unittest.main()
