diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index a373258..208fa23 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -41,3 +41,10 @@ class Waitlist:
     def entries(self):
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries, key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it."""
+        for e in self.entries():
+            if e.kind == kind:
+                return e
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 21b1a43..de5e9c3 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -82,5 +82,40 @@ class WaitlistTest(unittest.TestCase):
         self.assertEqual(len(w.entries()), 1)
 
 
+class NextForTest(unittest.TestCase):
+    def test_none_when_waitlist_is_empty(self):
+        self.assertIsNone(Waitlist().next_for("followup"))
+
+    def test_none_when_nobody_waits_for_that_kind(self):
+        w = Waitlist()
+        w.add(entry("KP-000001", kind="followup"))
+        self.assertIsNone(w.next_for("assessment"))
+
+    def test_returns_earliest_request_of_that_kind(self):
+        w = Waitlist()
+        w.add(entry("KP-000001", day=3, kind="assessment"))
+        w.add(entry("KP-000002", day=1, kind="assessment"))
+        w.add(entry("KP-000003", day=2, kind="followup"))
+        self.assertEqual(w.next_for("assessment").patient_id, "KP-000002")
+
+    def test_urgent_entry_of_that_kind_beats_earlier_request(self):
+        w = Waitlist()
+        w.add(entry("KP-000001", day=1, kind="followup"))
+        w.add(entry("KP-000002", day=4, kind="followup", urgent=True))
+        self.assertEqual(w.next_for("followup").patient_id, "KP-000002")
+
+    def test_urgent_entry_of_other_kind_is_ignored(self):
+        w = Waitlist()
+        w.add(entry("KP-000001", day=1, kind="assessment", urgent=True))
+        w.add(entry("KP-000002", day=2, kind="followup"))
+        self.assertEqual(w.next_for("followup").patient_id, "KP-000002")
+
+    def test_does_not_remove_entry(self):
+        w = Waitlist()
+        w.add(entry("KP-000001", kind="followup"))
+        w.next_for("followup")
+        self.assertEqual(len(w.entries()), 1)
+
+
 if __name__ == "__main__":
     unittest.main()
