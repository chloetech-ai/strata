+# INV-<clinic code>-<year>-<five-digit sequence>, e.g. INV-HB-2027-00042
+NUMBER_PATTERN = re.compile(r"^INV-(?P<clinic>.+)-(?P<year>\d{4})-(?P<seq>\d{5})$")
+
 
 @dataclass
 class Invoice:
@@ -34,3 +38,19 @@ def make_invoice(appointment, patient, number, amount_cents):
         amount_cents=amount_cents,
         description=DESCRIPTIONS[appointment.kind],
     )
+
+
+def next_invoice_number(clinic, year, existing):
+    """The next INV-<clinic>-<year>-<sequence> number after those in `existing`.
+
+    The sequence is counted per clinic and per year, so numbers from other
+    clinics or years are ignored. It restarts at 00001 each year.
+    """
+    highest = 0
+    for number in existing:
+        match = NUMBER_PATTERN.match(number)
+        if match and match["clinic"] == clinic and int(match["year"]) == year:
+            highest = max(highest, int(match["seq"]))
+    if highest >= 99999:
+        raise ValueError(f"invoice sequence for {clinic} {year} is exhausted")
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
