+"""Appointment reminder messages."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Only the clinic name, date and time are included. The treatment, the
+    session kind and the patient's name are deliberately left out (privacy).
+    """
+    start = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    when = f"{start:%A} {start.day} {start:%B} at {start:%H:%M}"
+    return (
+        f"Hi from {clinic}. This is a friendly reminder of your appointment "
+        f"on {when}. We look forward to seeing you!"
+    )
