@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from kestrel.calendar import CLINIC_TZ
+from kestrel.models import Appointment, ASSESSMENT
+from kestrel.reminders import reminder_text
+
+
+def appointment(**overrides):
+    fields = dict(
+        id="A1",
+        patient_id="KP-004211",
+        therapist_id="T1",
+        clinic="HB",
+        start=datetime.datetime(2026, 10, 22, 14, 30, tzinfo=CLINIC_TZ),
+        kind=ASSESSMENT,
+        treatment="lower back pain",
+    )
+    fields.update(overrides)
+    return Appointment(**fields)
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_includes_clinic_date_and_time(self):
+        text = reminder_text(appointment())
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 22 October at 14:30", text)
+
+    def test_time_is_clinic_local_not_utc(self):
+        # 01:30 UTC is 14:30 in Auckland (NZDT, UTC+13) in October.
+        start = datetime.datetime(2026, 10, 22, 1, 30, tzinfo=datetime.timezone.utc)
+        self.assertIn("at 14:30", reminder_text(appointment(start=start)))
+
+    def test_excludes_treatment_kind_and_patient(self):
+        text = reminder_text(appointment(treatment="lower back pain", kind=ASSESSMENT))
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("KP-004211", text)
+
+    def test_is_one_plain_sms_segment(self):
+        for clinic in ["NG", "HB", "WK"]:
+            with self.subTest(clinic=clinic):
+                text = reminder_text(appointment(clinic=clinic))
+                self.assertLessEqual(len(text), 160)
+                self.assertTrue(text.isascii())
+
+
+if __name__ == "__main__":
+    unittest.main()
