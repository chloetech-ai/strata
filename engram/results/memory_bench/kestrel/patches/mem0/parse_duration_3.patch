@@ -0,0 +1,30 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes_only(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours_only(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h30m"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("1h 30"), 90)
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_duration("  2h15m\n"), 135)
+
+    def test_rejects_garbage(self):
+        for raw in ["", "30", "m", "h", "1.5h", "-5m", "1x", "1h60m", "1h90", "0m", "0h", "1 h", "45 minutes"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
