+"""Interval helpers."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?")
+
+
+def parse_duration(text):
+    """Turn a typed duration into minutes, e.g. '1h 30m' -> 90. Raises ValueError otherwise."""
+    stripped = text.strip()
+    match = _MINUTES.fullmatch(stripped)
+    if match is not None:
+        minutes = int(match.group(1))
+    else:
+        match = _HOURS.fullmatch(stripped)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        extra = match.group(2)
+        if extra is not None and int(extra) >= 60:
+            raise ValueError(f"not a duration: {text!r}")
+        minutes = int(match.group(1)) * 60 + int(extra or 0)
+    if minutes == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
