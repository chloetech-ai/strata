@@ -0,0 +1,54 @@
+import datetime
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, NO_SHOW, Appointment
+
+START = datetime.datetime(2026, 10, 20, 9, 0, tzinfo=datetime.timezone.utc)
+
+
+def appointment(kind=FOLLOWUP, status=CANCELLED):
+    return Appointment(
+        id="A1",
+        patient_id="KP-004211",
+        therapist_id="T1",
+        clinic="NG",
+        start=START,
+        kind=kind,
+        status=status,
+    )
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_inside_48_hours_charges_half(self):
+        cancelled_at = START - datetime.timedelta(hours=47)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), cancelled_at), 3500)
+        self.assertEqual(cancellation_fee(appointment(ASSESSMENT), cancelled_at), 4750)
+
+    def test_cancelled_exactly_48_hours_before_is_free(self):
+        cancelled_at = START - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(appointment(), cancelled_at), 0)
+
+    def test_cancelled_outside_window_is_free(self):
+        cancelled_at = START - datetime.timedelta(days=3)
+        self.assertEqual(cancellation_fee(appointment(), cancelled_at), 0)
+
+    def test_cancelled_after_start_charges_half(self):
+        cancelled_at = START + datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), cancelled_at), 3500)
+
+    def test_cancelled_requires_cancelled_at(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(), None)
+
+    def test_cancelled_at_must_be_timezone_aware(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(), datetime.datetime(2026, 10, 19, 9, 0))
+
+    def test_no_show_charges_full_price(self):
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP, NO_SHOW)), 7000)
+        self.assertEqual(cancellation_fee(appointment(ASSESSMENT, NO_SHOW)), 9500)
+
+
+if __name__ == "__main__":
+    unittest.main()
