@@ -0,0 +1,33 @@
+"""Cancellation fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation made less than this long before the start is charged.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for an appointment.
+
+    A cancelled appointment is charged 50% of the session price when it was
+    cancelled inside the 48-hour window before the start, and nothing otherwise.
+    `cancelled_at` is when the patient cancelled and is required for a
+    cancelled appointment. A no-show is charged the full session price.
+    `cancelled_at` is not used for a no-show. Other statuses have no fee.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            raise ValueError("cancelled_at is required for a cancelled appointment")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancelled_at must be timezone-aware")
+        if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+            return price * LATE_CANCELLATION_PERCENT // 100
+        return 0
+    return 0
