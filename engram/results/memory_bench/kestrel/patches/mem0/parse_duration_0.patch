index 0000000..cc22c96
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,17 @@
+"""Interval helpers."""
+
+import re
+
+_DURATION = re.compile(
+    r"(?:(?P<hours>[0-9]+)h\s*(?:(?P<minutes>[0-9]+)m?)?|(?P<minutes_only>[0-9]+)m)"
+)
+
+
+def parse_duration(text):
+    """Turn a typed duration into minutes, e.g. '1h 30m' -> 90, '1h30' -> 90, '45m' -> 45."""
+    match = _DURATION.fullmatch(text.strip().lower())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if match.group("minutes_only") is not None:
+        return int(match.group("minutes_only"))
+    return int(match.group("hours")) * 60 + int(match.group("minutes") or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..cd2fd74
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,26 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes_only(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours_only(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes(self):
+        for raw in ["1h30", "1h30m", "1h 30m", "1h 30", " 1H30 "]:
+            with self.subTest(raw=raw):
+                self.assertEqual(parse_duration(raw), 90)
+
+    def test_rejects_garbage(self):
+        for raw in ["", "m", "h", "45", "1h30m5", "1.5h", "-45m", "1 h", "90 min", "1h-30", "abc"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
