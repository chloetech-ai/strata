+++ b/tests/test_booking.py
@@ -0,0 +1,52 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+
+from kestrel.booking import MAX_PER_DAY, can_book
+from kestrel.calendar import Calendar
+from kestrel.models import CANCELLED, Therapist
+
+THERAPIST = Therapist("T1", "Sam", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar_allows_booking(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("a1", utc(2027, 3, 1, 20))))
+
+    def test_same_start_time_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("a2", utc(2027, 3, 1, 20))))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("a2", utc(2027, 3, 1, 20))))
+
+    def test_appointment_for_other_therapist_refused(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("a1", utc(2027, 3, 1, 20), therapist="T2")))
+
+    def test_day_limit_refuses_ninth(self):
+        base = utc(2027, 3, 1, 20)
+        cal = Calendar([appt(f"a{i}", base + datetime.timedelta(minutes=30 * i)) for i in range(MAX_PER_DAY)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", base + datetime.timedelta(hours=8))))
+
+    def test_seventh_allowed_when_under_limit(self):
+        base = utc(2027, 3, 1, 20)
+        cal = Calendar([appt(f"a{i}", base + datetime.timedelta(minutes=30 * i)) for i in range(MAX_PER_DAY - 1)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", base + datetime.timedelta(hours=8))))
+
+    def test_cancelled_appointments_do_not_count_toward_limit(self):
+        base = utc(2027, 3, 1, 20)
+        cal = Calendar([appt(f"a{i}", base + datetime.timedelta(minutes=30 * i)) for i in range(MAX_PER_DAY)])
+        cal.cancel("a0", base)
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", base + datetime.timedelta(hours=8))))
+
+    def test_limit_counts_local_clinic_date(self):
+        # 23:30 UTC on 1 March is 12:30 on 2 March in Auckland, so it is on a different local day.
+        base = utc(2027, 3, 1, 10, 0)
+        cal = Calendar([appt(f"a{i}", base + datetime.timedelta(minutes=30 * i)) for i in range(MAX_PER_DAY)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 23, 30))))
+
+
+if __name__ == "__main__":
+    unittest.main()
