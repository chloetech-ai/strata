+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "HB-2027-0001")
+
+    def test_follows_highest_existing_number(self):
+        existing = ["HB-2027-0001", "HB-2027-0002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "HB-2027-0003")
+
+    def test_gap_does_not_reuse_a_number(self):
+        existing = ["HB-2027-0001", "HB-2027-0005"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "HB-2027-0006")
+
+    def test_ignores_other_clinics(self):
+        existing = ["WN-2027-0009", "HB-2027-0002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "HB-2027-0003")
+
+    def test_ignores_other_years(self):
+        existing = ["HB-2026-0040", "HB-2028-0007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "HB-2027-0001")
+
+    def test_ignores_numbers_in_other_formats(self):
+        existing = ["INV-1", "HB-2027-0002-A", "XHB-2027-0009"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "HB-2027-0001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["HB-2027-0004"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "HB-2027-0005")
+
+    def test_clinic_code_is_matched_literally(self):
+        existing = ["H.B-2027-0003", "HXB-2027-0009"]
+        self.assertEqual(next_invoice_number("H.B", 2027, existing), "H.B-2027-0004")
+
+
 if __name__ == "__main__":
     unittest.main()
