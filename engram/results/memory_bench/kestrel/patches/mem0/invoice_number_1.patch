     description: str = ""
 
 
+def next_invoice_number(clinic, year, existing):
+    """The next invoice number for a clinic in a year, e.g. 'HB-2027-0001'.
+
+    `existing` may hold numbers from any clinic and year; only this clinic's
+    numbers for this year count. Going from the highest sequence number, not
+    the count, means gaps can't cause a number to be reused.
+    """
+    prefix = f"{clinic}-{year}-"
+    pattern = re.compile(re.escape(prefix) + r"([0-9]+)")
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match:
+            highest = max(highest, int(match.group(1)))
+    return f"{prefix}{highest + 1:04d}"
+
