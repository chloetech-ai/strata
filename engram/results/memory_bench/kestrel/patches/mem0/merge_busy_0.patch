+"""Interval helpers."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs into sorted, non-overlapping pairs.
+
+    Input may be in any order. Pairs that touch (one ends where the next
+    starts) are merged too. Each pair must have start <= end.
+    """
+    pairs = sorted(intervals)
+    merged = []
+    for start, end in pairs:
+        if start > end:
+            raise ValueError(f"interval starts after it ends: {(start, end)!r}")
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
