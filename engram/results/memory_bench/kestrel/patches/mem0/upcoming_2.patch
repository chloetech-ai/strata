+    def test_upcoming_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 1, 22), patient="KP-000007"),
+            appt("a2", utc(2027, 3, 1, 20), patient="KP-000007"),
+            appt("a3", utc(2027, 3, 1, 18), patient="KP-000007"),  # before now
+            appt("a4", utc(2027, 3, 1, 21), patient="KP-000007", status="cancelled"),
+            appt("a5", utc(2027, 3, 1, 23), patient="KP-000008"),  # other patient
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000007", utc(2027, 3, 1, 19))], ["a2", "a1"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-000007")])
+        self.assertEqual(cal.upcoming("KP-000007", utc(2027, 3, 1, 20)), [])
+
+    def test_upcoming_accepts_messy_patient_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        for raw in ["kp4211", " KP-004211 "]:
+            with self.subTest(raw=raw):
+                self.assertEqual([a.id for a in cal.upcoming(raw, utc(2027, 3, 1, 8))], ["a1"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-000007")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000007", datetime.datetime(2027, 3, 1, 8))
+
     def test_booked(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
