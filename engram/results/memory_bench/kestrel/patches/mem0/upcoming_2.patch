diff --git a/CHANGELOG.md b/CHANGELOG.md
index 6b019d6..fc88080 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -4,6 +4,7 @@
 
 - Calendar: `for_day` lists a therapist's appointments on a local date, and `move` reschedules booked appointments.
 - Calendar: fixed ordering; patient IDs are normalized on lookup (`normalize_patient_id`).
+- Calendar: `upcoming` lists a patient's booked appointments starting after a given time, soonest first.
 - Appointments can be cancelled; patients have a Community Services Card (CSC) flag.
 - Pricing: `session_price` for assessments and follow-ups.
 - Invoices: `make_invoice` for appointments.
diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index e3072fb..0a88009 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -59,6 +59,12 @@ class Calendar:
         patient_id = normalize_patient_id(patient_id)
         return [a for a in self.all() if a.patient_id == patient_id]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
