+"""Cancellation and no-show fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation this close to the start (or later) is charged half the session price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for an appointment that was cancelled or missed.
+
+    A no-show is charged the full session price. A cancellation is charged
+    half the session price when it was made less than 48 hours before the
+    start, and nothing otherwise. ``cancelled_at`` is when the patient
+    cancelled; it defaults to the appointment's own ``cancelled_at``. Other
+    statuses incur no fee.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            cancelled_at = appointment.cancelled_at
+        if cancelled_at is None:
+            raise ValueError("cancelled appointment has no cancellation time")
+        if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+            return price // 2
+        return 0
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..c956dda
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,53 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, BOOKED, ATTENDED, CANCELLED, FOLLOWUP, NO_SHOW
+
+START = utc(2027, 3, 1, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_no_show_charges_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+
+    def test_no_show_ignores_cancelled_at(self):
+        fee = cancellation_fee(appt("a1", START, kind=FOLLOWUP, status=NO_SHOW), None)
+        self.assertEqual(fee, 7000)
+
+    def test_cancelled_inside_48_hours_charges_half(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47)), 4750)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=1)), 4750)
+
+    def test_cancelled_exactly_48_hours_before_is_free(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+
+    def test_cancelled_well_ahead_is_free(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 2, 20, 9)), 0)
+
+    def test_cancelled_after_start_charges_half(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(hours=1)), 3500)
+
+    def test_uses_appointment_cancelled_at_when_not_given(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED, cancelled_at=START - datetime.timedelta(hours=2))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_cancelled_without_a_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status=CANCELLED))
+
+    def test_booked_and_attended_have_no_fee(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                self.assertEqual(cancellation_fee(appt("a1", START, status=status)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
