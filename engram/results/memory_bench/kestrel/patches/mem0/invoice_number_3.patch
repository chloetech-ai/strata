     description: str = ""
 
 
+def next_invoice_number(clinic, year, existing):
+    """The next number for a clinic in a year, given all numbers issued so far.
+
+    Numbers look like INV-<clinic>-<year>-<sequence>, with the sequence restarting
+    at 00001 for each clinic and year. Numbers for other clinics or years are ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [
+        int(number[len(prefix):])
+        for number in existing
+        if number.startswith(prefix) and number[len(prefix):].isdigit()
+    ]
+    sequence = max(sequences, default=0) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{sequence:05d}"
+
+
