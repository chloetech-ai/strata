+"""SMS reminders for booked appointments."""
+
+from .models import BOOKED, CLINICS
+from .calendar import AUCKLAND
+
+
+def reminder_text(appointment):
+    """The reminder text. Privacy rule: only the date, time and clinic name, never the treatment."""
+    local = appointment.start.astimezone(AUCKLAND)
+    date = f"{local.strftime('%A')} {local.day} {local.strftime('%B %Y')}"
+    time = local.strftime("%I:%M %p").lstrip("0")
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: you have an appointment at {clinic} on {date} at {time}."
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of each booked appointment. Returns the number sent."""
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
