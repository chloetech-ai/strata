@@ -0,0 +1,80 @@
+import datetime
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from helpers import UTC, appt, utc
+
+
+class FakeClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        self.batches.append(list(messages))
+        return [{"ok": True}]
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Alex Example", "+64211111111", csc=True),
+    "KP-000002": Patient("KP-000002", "Sam Sample", "+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_one_sms_per_booked_appointment_returns_count(self):
+        client = FakeClient()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 2, 0), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 2)
+        self.assertEqual(len(client.batches), 1)
+        self.assertEqual([to for to, _ in client.batches[0]], ["+64211111111", "+64222222222"])
+
+    def test_skips_cancelled_attended_and_no_show(self):
+        client = FakeClient()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 20, 3, 0), patient="KP-000002", status=CANCELLED, cancelled_at=utc(2026, 10, 19)),
+            appt("A3", utc(2026, 10, 20, 4, 0), patient="KP-000002", status=ATTENDED),
+            appt("A4", utc(2026, 10, 20, 5, 0), patient="KP-000002", status=NO_SHOW),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 1)
+        self.assertEqual([to for to, _ in client.batches[0]], ["+64211111111"])
+
+    def test_no_booked_appointments_sends_nothing(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([], PATIENTS, client), 0)
+        self.assertEqual(client.batches, [[]])
+
+    def test_unknown_patient_raises(self):
+        with self.assertRaises(KeyError):
+            send_reminders([appt("A1", utc(2026, 10, 20, 2, 0), patient="KP-999999")], PATIENTS, FakeClient())
+
+    def test_text_has_no_name_treatment_or_kind(self):
+        a = appt("A1", utc(2026, 10, 20, 2, 0), patient="KP-000001", kind="assessment", treatment="lower back pain")
+        client = FakeClient()
+        send_reminders([a], PATIENTS, client)
+        text = client.batches[0][0][1]
+        for secret in ("Alex", "Example", "lower back", "assessment", "KP-000001"):
+            self.assertNotIn(secret, text)
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_uses_auckland_local_date_and_time(self):
+        # 2026-10-20 02:30 UTC is Tuesday 20 October, 15:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 20, 2, 30), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Reminder: you have an appointment at Kestrel Physio Harbour on Tuesday 20 October 2026 at 3:30 PM.",
+        )
+
+    def test_date_rolls_over_in_auckland_time(self):
+        # 2026-10-20 13:00 UTC is 2026-10-21 02:00 in Auckland.
+        a = appt("A1", datetime.datetime(2026, 10, 20, 13, 0, tzinfo=UTC), clinic="NG")
+        self.assertIn("Wednesday 21 October 2026 at 2:00 AM", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
