@@ -1,12 +1,27 @@
 """Session prices in cents."""
 
+import datetime
+import zoneinfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+AUCKLAND = zoneinfo.ZoneInfo("Pacific/Auckland")
+
+# Appointments starting on or after this local Auckland date pay NEW_PRICES_CENTS.
+PRICE_RISE_DATE = datetime.date(2027, 4, 1)
+
 PRICES_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
 
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
 def session_price(kind):
     """Return the price in cents for a session of the given kind."""
@@ -14,3 +29,19 @@ def session_price(kind):
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price depends on the local Auckland date the appointment starts on.
+    Community Services Card holders get a discount on follow-ups only.
+    """
+    local_date = appointment.start.astimezone(AUCKLAND).date()
+    if local_date >= PRICE_RISE_DATE:
+        price = NEW_PRICES_CENTS[appointment.kind]
+    else:
+        price = PRICES_CENTS[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price -= price * CSC_FOLLOWUP_DISCOUNT_PERCENT // 100
+    return price
