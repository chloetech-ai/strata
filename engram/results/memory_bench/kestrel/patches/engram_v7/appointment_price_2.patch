+class AppointmentPriceTest(unittest.TestCase):
+    def test_assessment_before_price_rise_is_95_dollars(self):
+        start = datetime.datetime(2027, 3, 30, 10, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(start, "assessment"), patient()), 9500)
+
+    def test_followup_before_price_rise_is_70_dollars(self):
+        start = datetime.datetime(2027, 3, 30, 10, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(start, "followup"), patient()), 7000)
+
+    def test_assessment_from_1_april_2027_is_105_dollars(self):
+        start = datetime.datetime(2027, 4, 1, 10, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(start, "assessment"), patient()), 10500)
+
+    def test_followup_from_1_april_2027_is_78_dollars(self):
+        start = datetime.datetime(2027, 4, 1, 10, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(start, "followup"), patient()), 7800)
+
+    def test_date_is_taken_in_auckland_time(self):
+        # 23:30 on 31 March 2027 in Auckland (NZDT, UTC+13) is still before the rise.
+        before = datetime.datetime(2027, 3, 31, 10, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(before, "followup"), patient()), 7000)
+        # 00:30 on 1 April 2027 in Auckland is already after the rise, though it is still 31 March in UTC.
+        after = datetime.datetime(2027, 3, 31, 11, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(after, "followup"), patient()), 7800)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        start = datetime.datetime(2027, 3, 30, 10, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(start, "followup"), patient(csc=True)), 5600)
+
+    def test_csc_followup_discount_applies_to_new_price(self):
+        start = datetime.datetime(2027, 4, 1, 10, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(start, "followup"), patient(csc=True)), 6240)
+
+    def test_csc_does_not_discount_assessment(self):
+        start = datetime.datetime(2027, 4, 1, 10, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(start, "assessment"), patient(csc=True)), 10500)
+
