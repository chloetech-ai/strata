@@ -0,0 +1,34 @@
+"""SMS reminders for booked appointments."""
+
+from .calendar import AUCKLAND
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The reminder for one appointment.
+
+    Privacy rule: the text gives only the date, the time and the clinic name.
+    It must not mention the treatment or the kind of appointment.
+    """
+    local = appointment.start.astimezone(AUCKLAND)
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: you have an appointment at {clinic} on {local:%d %B %Y} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of each booked appointment.
+
+    patients maps patient ID to Patient. Returns the number of messages sent.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        if appointment.patient_id not in patients:
+            raise ValueError(f"no patient {appointment.patient_id} for appointment {appointment.id}")
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    if not messages:
+        return 0
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..805f6e4
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,85 @@
+import unittest
+
+from kestrel.models import ATTENDED, CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+def patients_by_id(*patients):
+    return {p.id: p for p in patients}
+
+
+ANA = Patient("KP-000001", "Ana Example", "+64211111111")
+BEN = Patient("KP-000002", "Ben Example", "+64222222222", csc=True)
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_date_time_and_clinic_only(self):
+        # 20:00 UTC on 14 October is 09:00 on 15 October in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 14, 20, 0), kind="assessment", treatment="lower back pain", clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("15 October 2026", text)
+        self.assertIn("09:00", text)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("Ana", text)
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_sms_per_booked_appointment_and_returns_count(self):
+        transport = FakeTransport()
+        client = BulkieClient("key", transport)
+        appointments = [
+            appt("A1", utc(2026, 10, 14, 20, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 15, 2, 0), patient="KP-000002"),
+        ]
+        sent = send_reminders(appointments, patients_by_id(ANA, BEN), client)
+        self.assertEqual(sent, 2)
+        sent_messages = [m for _, body in transport.calls for m in body["messages"]]
+        self.assertEqual([m["to"] for m in sent_messages], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        transport = FakeTransport()
+        client = BulkieClient("key", transport)
+        appointments = [
+            appt("A1", utc(2026, 10, 14, 20, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 14, 21, 0), patient="KP-000002", status=CANCELLED),
+            appt("A3", utc(2026, 10, 14, 22, 0), patient="KP-000002", status=NO_SHOW),
+            appt("A4", utc(2026, 10, 14, 23, 0), patient="KP-000002", status=ATTENDED),
+        ]
+        self.assertEqual(send_reminders(appointments, patients_by_id(ANA, BEN), client), 1)
+        self.assertEqual(len(transport.calls), 1)
+        self.assertEqual(len(transport.calls[0][1]["messages"]), 1)
+
+    def test_no_booked_appointments_sends_nothing(self):
+        transport = FakeTransport()
+        client = BulkieClient("key", transport)
+        self.assertEqual(send_reminders([], patients_by_id(ANA), client), 0)
+        self.assertEqual(transport.calls, [])
+
+    def test_unknown_patient_raises_and_sends_nothing(self):
+        transport = FakeTransport()
+        client = BulkieClient("key", transport)
+        appointments = [
+            appt("A1", utc(2026, 10, 14, 20, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 14, 21, 0), patient="KP-999999"),
+        ]
+        with self.assertRaises(ValueError):
+            send_reminders(appointments, patients_by_id(ANA), client)
+        self.assertEqual(transport.calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
