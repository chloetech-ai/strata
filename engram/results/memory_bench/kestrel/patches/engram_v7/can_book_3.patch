+"""Checks run by the booking form before it saves an appointment."""
+
+import datetime
+
+from .models import ASSESSMENT, ATTENDED, BOOKED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+# Statuses that hold the slot. Cancelled and no-show appointments free it.
+HOLDS_SLOT = (BOOKED, ATTENDED)
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist.
+
+    It must belong to the therapist and must not overlap any other
+    appointment of theirs that still holds its slot.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    start = appointment.start
+    end = _end(appointment)
+    for other in calendar.for_therapist(therapist.id):
+        if other.status not in HOLDS_SLOT:
+            continue
+        if start < _end(other) and other.start < end:
+            return False
+    return True
diff --git a/tests/test_booking.py b/tests/test_booking.py
