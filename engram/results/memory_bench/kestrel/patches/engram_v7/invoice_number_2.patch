+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_next_follows_the_highest_existing_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_other_clinics_do_not_count(self):
+        existing = ["INV-NG-2027-00099", "INV-WK-2027-00050"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_other_years_do_not_count(self):
+        existing = ["INV-HB-2026-00300"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_sequence_is_only_counted_from_this_clinic_and_year(self):
+        existing = ["INV-HB-2026-00300", "INV-NG-2027-00010", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_existing_order_does_not_matter(self):
+        existing = ["INV-HB-2027-00009", "INV-HB-2027-00010"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00011")
+
+    def test_last_sequence_number_is_99999(self):
+        existing = ["INV-HB-2027-99998"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-99999")
+
+    def test_running_out_of_numbers_raises(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+    def test_numbers_not_in_the_format_are_ignored(self):
+        existing = ["HB-2027-00500", "INV-HB-2027-5", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+
 if __name__ == "__main__":
     unittest.main()
