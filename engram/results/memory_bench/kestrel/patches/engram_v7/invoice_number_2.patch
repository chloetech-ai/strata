+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number, INV-<clinic>-<year>-<sequence>, for a clinic in a year.
+
+    existing is every invoice number issued so far, for any clinic and year;
+    only those for this clinic and year count, and the sequence restarts at
+    00001 each year.
+    """
+    highest = 0
+    for number in existing:
+        match = _INVOICE_NUMBER.fullmatch(number)
+        if match and match.group("clinic") == clinic and int(match.group("year")) == year:
+            highest = max(highest, int(match.group("sequence")))
+    if highest >= 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
+
