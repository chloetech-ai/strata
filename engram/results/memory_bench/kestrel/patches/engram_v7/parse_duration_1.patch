+"""Durations as reception types them, such as '45m', '1h' and '1h 30m'."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)m")
+_HOURS = re.compile(r"(\d+)h\s*(?:(\d+)m?)?")
+
+
+def parse_duration(text):
+    """Turn '45m', '1h', '1h30' or '1h 30m' into a number of minutes.
+
+    Raises ValueError if the text isn't a duration in one of those forms.
+    """
+    stripped = text.strip()
+    match = _MINUTES.fullmatch(stripped)
+    if match is not None:
+        return int(match.group(1))
+    match = _HOURS.fullmatch(stripped)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes = match.groups()
+    minutes = int(minutes or 0)
+    if minutes >= 60:
+        raise ValueError(f"minutes after hours must be under 60: {text!r}")
+    return int(hours) * 60 + minutes
