+"""Checks run before an appointment is saved."""
+
+import datetime
+
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# How long each kind of appointment occupies a therapist's time.
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added for this therapist without overbooking.
+
+    It must belong to the therapist, not already be in the calendar, and not
+    overlap any of the therapist's appointments that have not been cancelled.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if any(a.id == appointment.id for a in calendar.all()):
+        return False
+
+    new_start = appointment.start
+    new_end = new_start + DURATIONS[appointment.kind]
+    for existing in calendar.for_therapist(therapist.id):
+        if existing.status == CANCELLED:
+            continue
+        existing_end = existing.start + DURATIONS[existing.kind]
+        if new_start < existing_end and existing.start < new_end:
+            return False
+    return True
