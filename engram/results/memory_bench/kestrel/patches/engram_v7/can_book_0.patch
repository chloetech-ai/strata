+++ b/tests/test_booking.py
@@ -0,0 +1,48 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, Therapist
+
+THERAPIST = Therapist("T1", "Sam", "HB")
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", utc(2027, 3, 1, 9))))
+
+    def test_exact_overlap_refused(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 9))))
+
+    def test_partial_overlap_refused(self):
+        # a1 is a 30-minute follow-up 09:00-09:30; new assessment 09:15-10:00 overlaps it.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 9, 15), kind=ASSESSMENT)))
+
+    def test_new_longer_than_gap_before_existing_refused(self):
+        # New assessment 08:30-09:15 runs into a1 at 09:00.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9))])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 8, 30), kind=ASSESSMENT)))
+
+    def test_back_to_back_allowed(self):
+        # a1 is 09:00-09:30, so a follow-up at 09:30 starts exactly when it ends.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9))])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 9, 30))))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 8, 30))))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 9))))
+
+    def test_cancelled_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 9), status=CANCELLED)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", utc(2027, 3, 1, 9))))
+
+    def test_appointment_for_other_therapist_refused(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("new", utc(2027, 3, 1, 9), therapist="T2")))
+
+
+if __name__ == "__main__":
+    unittest.main()
