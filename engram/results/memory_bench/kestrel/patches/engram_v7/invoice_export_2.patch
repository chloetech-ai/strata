+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, patient_id="KP-004211", clinic="HB", amount_cents=7000, description="Follow-up session"):
+    return Invoice(number=number, clinic=clinic, patient_id=patient_id, patient_name="",
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self.tmp.name
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_file_is_named_for_the_month_in_out_dir(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_header_row_comes_first(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path), [["InvoiceNumber", "InvoiceDate", "PatientID", "Clinic", "Description", "Amount"]])
+
+    def test_row_fields_and_formats(self):
+        i = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), amount_cents=9500, description="Initial assessment")
+        path = export_invoices([i], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1], ["INV-HB-2026-00001", "03/10/2026", "KP-004211", "HB", "Initial assessment", "95.00"])
+
+    def test_only_invoices_from_the_requested_month_are_included(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00001", datetime.date(2025, 10, 15)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_rows_are_ordered_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 2)),
+            invoice("INV-WK-2026-00001", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-WK-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), amount_cents=7000),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1), amount_cents=5),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 1), amount_cents=10500),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[5] for r in rows[1:]], ["70.00", "0.05", "105.00"])
+
+    def test_patient_names_never_appear(self):
+        i = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1))
+        i.patient_name = "Aroha Test"
+        path = export_invoices([i], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_dates_are_day_first_with_leading_zeros(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 1, 9))], 2026, 1, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][1], "09/01/2026")
+
+
+if __name__ == "__main__":
+    unittest.main()
