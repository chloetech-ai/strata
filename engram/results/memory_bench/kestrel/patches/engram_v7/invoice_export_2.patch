+"""Monthly export of invoices for Mere at Tui Accounting (imported into Xero).
+
+The export never contains patient names, only patient ids.
+"""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "InvoiceDate", "PatientID", "Clinic", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir and return the file path.
+
+    The file is kestrel-invoices-YYYY-MM.csv. Rows are dated by the invoice's
+    issued date (the Auckland date of the appointment), ordered by date then number.
+    """
+    rows = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in rows:
+            writer.writerow([
+                i.number,
+                i.issued.strftime("%d/%m/%Y"),
+                i.patient_id,
+                i.clinic,
+                i.description,
+                _amount(i.amount_cents),
+            ])
+    return path
+
+
+def _amount(cents):
+    """Dollars as a plain number with two decimals, e.g. 7000 -> '70.00'."""
+    sign = "-" if cents < 0 else ""
+    dollars, rem = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{rem:02d}"
