+"""Find the start times at which a new appointment could be booked."""
+
+import datetime
+
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATION = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+# Clinic opening hours by weekday (Monday is 0). Public holidays are not covered yet.
+_WEEKDAYS = range(0, 5)
+_HOURS = {
+    "NG": {
+        **{d: (datetime.time(7, 30), datetime.time(18, 0)) for d in _WEEKDAYS},
+        5: (datetime.time(8, 0), datetime.time(12, 0)),
+    },
+    "HB": {d: (datetime.time(7, 30), datetime.time(18, 0)) for d in _WEEKDAYS},
+    "WK": {d: (datetime.time(7, 30), datetime.time(18, 0)) for d in _WEEKDAYS},
+}
+
+_STEP = datetime.timedelta(minutes=15)
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times at which a new appointment of this kind could be booked.
+
+    Considers the therapist's clinic hours on the local Auckland date `day`, and
+    returns the start times, sorted, where the appointment fits without overlapping
+    any of the therapist's appointments that are not cancelled. Starts fall on
+    quarter hours.
+    """
+    if kind not in DURATION:
+        raise ValueError(f"unknown kind {kind!r}")
+    duration = DURATION[kind]
+
+    hours = _HOURS[therapist.clinic].get(day.weekday())
+    if hours is None:
+        return []
+    opens, closes = hours
+
+    busy = [
+        (a.start, a.start + DURATION[a.kind])
+        for a in calendar.for_day(therapist.id, day)
+        if a.status != CANCELLED
+    ]
+
+    slots = []
+    start = datetime.datetime.combine(day, opens, tzinfo=AUCKLAND)
+    last_start = datetime.datetime.combine(day, closes, tzinfo=AUCKLAND) - duration
+    while start <= last_start:
+        end = start + duration
+        if all(end <= b_start or start >= b_end for b_start, b_end in busy):
+            slots.append(start.time())
+        start += _STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..630d605
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,116 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import AUCKLAND, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MONDAY = datetime.date(2027, 3, 1)  # Monday 1 March 2027 (NZDT, UTC+13)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+
+HB = Therapist(id="T1", name="Tui", clinic="HB")
+NG = Therapist(id="T2", name="Hine", clinic="NG")
+
+
+def local(day, hh, mm=0):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=AUCKLAND)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+def quarter_hours(first, last):
+    """Times from first to last inclusive, every 15 minutes."""
+    out = []
+    minutes = first.hour * 60 + first.minute
+    while minutes <= last.hour * 60 + last.minute:
+        out.append(t(minutes // 60, minutes % 60))
+        minutes += 15
+    return out
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_offers_every_quarter_hour_that_fits(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        # A 30-minute follow-up can start 07:30 to 17:30 on a 07:30-18:00 day.
+        self.assertEqual(slots, quarter_hours(t(7, 30), t(17, 30)))
+
+    def test_assessment_is_45_minutes_so_last_start_is_1715(self):
+        slots = free_slots(Calendar(), HB, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 15))
+
+    def test_results_are_sorted_local_times(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) and s.tzinfo is None for s in slots))
+
+    def test_booked_appointment_blocks_overlapping_starts(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        # The 09:00 follow-up runs to 09:30: 08:45 to 09:15 overlap it; 08:30 and 09:30 only touch it.
+        for blocked in (t(8, 45), t(9, 0), t(9, 15)):
+            self.assertNotIn(blocked, slots)
+        self.assertIn(t(8, 30), slots)
+        self.assertIn(t(9, 30), slots)
+
+    def test_assessment_needs_its_full_45_minutes_free(self):
+        cal = Calendar([appt("a1", local(MONDAY, 12), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, ASSESSMENT)
+        self.assertIn(t(11, 15), slots)  # 11:15 to 12:00 touches the booking but does not overlap
+        self.assertNotIn(t(11, 30), slots)  # 11:30 to 12:15 overlaps 12:00
+        self.assertNotIn(t(12, 0), slots)
+
+    def test_existing_assessment_blocks_for_45_minutes(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(9, 15), slots)  # 09:15 to 09:45 overlaps the 09:00 to 09:45 assessment
+        self.assertIn(t(9, 45), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), therapist="T1", status="cancelled")])
+        self.assertIn(t(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_attended_and_no_show_still_block(self):
+        cal = Calendar([
+            appt("a1", local(MONDAY, 9), therapist="T1", status="attended"),
+            appt("a2", local(MONDAY, 10), therapist="T1", status="no_show"),
+        ])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertNotIn(t(9, 0), slots)
+        self.assertNotIn(t(10, 0), slots)
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), therapist="T9")])
+        self.assertIn(t(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_utc_stored_appointment_is_matched_on_local_date(self):
+        # 07:30 local on Tuesday 2 March is 18:30 UTC on Monday 1 March, so it is on Tuesday, not Monday.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 18, 30), therapist="T1")])
+        tuesday = datetime.date(2027, 3, 2)
+        self.assertNotIn(t(7, 30), free_slots(cal, HB, tuesday, FOLLOWUP))
+        self.assertIn(t(7, 30), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_saturday_only_northgate_open_8_to_12(self):
+        self.assertEqual(
+            free_slots(Calendar(), NG, SATURDAY, FOLLOWUP),
+            quarter_hours(t(8, 0), t(11, 30)),
+        )
+
+    def test_saturday_closed_at_harbour(self):
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed_everywhere(self):
+        self.assertEqual(free_slots(Calendar(), NG, SUNDAY, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HB, SUNDAY, ASSESSMENT), [])
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, MONDAY, "physio")
+
+
+if __name__ == "__main__":
+    unittest.main()
