+"""Free appointment slots for a therapist on a local date."""
+
+import datetime
+
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+
+# Length of each kind of appointment, in minutes.
+MINUTES = {
+    ASSESSMENT: 45,
+    FOLLOWUP: 30,
+}
+
+# Candidate starts are this far apart.
+STEP = datetime.timedelta(minutes=15)
+
+WEEKDAYS = {day: (datetime.time(7, 30), datetime.time(18, 0)) for day in range(5)}  # Monday to Friday
+SATURDAY = (datetime.time(8, 0), datetime.time(12, 0))
+
+# (open, close) per clinic code and weekday (Monday is 0). Clinics are closed on days not listed.
+OPENING_HOURS = {
+    "NG": {**WEEKDAYS, 5: SATURDAY},  # Northgate is the only clinic open on Saturdays
+    "HB": WEEKDAYS,
+    "WK": WEEKDAYS,
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times at which a new appointment of this kind could be booked.
+
+    day is a local Pacific/Auckland date. A slot is offered only if the whole
+    appointment falls within the therapist's clinic opening hours and overlaps no
+    appointment that is not cancelled. Returns a sorted list of datetime.time.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = OPENING_HOURS.get(therapist.clinic, {}).get(day.weekday())
+    if hours is None:
+        return []
+    opens, closes = hours
+
+    busy = []
+    for appointment in calendar.for_therapist(therapist.id):
+        if appointment.status == CANCELLED:
+            continue
+        busy_start = appointment.start.astimezone(UTC)
+        busy_end = busy_start + datetime.timedelta(minutes=MINUTES[appointment.kind])
+        busy.append((busy_start, busy_end))
+
+    length = datetime.timedelta(minutes=MINUTES[kind])
+    start = datetime.datetime.combine(day, opens, tzinfo=AUCKLAND)
+    closing = datetime.datetime.combine(day, closes, tzinfo=AUCKLAND)
+    slots = []
+    while start + length <= closing:
+        slot_start = start.astimezone(UTC)
+        slot_end = slot_start + length
+        if not any(b_start < slot_end and slot_start < b_end for b_start, b_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..248e422
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,82 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, ATTENDED, CANCELLED, FOLLOWUP, NO_SHOW, Therapist
+from kestrel.slots import free_slots
+
+T = datetime.time
+MONDAY = datetime.date(2027, 3, 1)  # NZDT is UTC+13 in March
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+HB = Therapist("T1", "Jo Park", "HB")
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_offers_quarter_hours_within_opening_hours(self):
+        slots = free_slots(Calendar(), HB, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[0], T(7, 30))
+        self.assertEqual(slots[-1], T(17, 15))  # a 45-minute assessment must finish by 18:00
+        self.assertEqual(len(slots), 40)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) and s.minute % 15 == 0 for s in slots))
+
+    def test_followup_length(self):
+        slots = free_slots(Calendar(), HB, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[-1], T(17, 30))  # a 30-minute follow-up must finish by 18:00
+
+    def test_saturday_northgate_hours(self):
+        slots = free_slots(Calendar(), Therapist("T2", "Sam Lee", "NG"), SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], T(8, 0))
+        self.assertEqual(slots[-1], T(11, 30))
+
+    def test_saturday_closed_except_northgate(self):
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), Therapist("T2", "Sam Lee", "NG"), SUNDAY, FOLLOWUP), [])
+
+    def test_booked_appointment_blocks_overlapping_starts_only(self):
+        # 09:00 local is 20:00 UTC on 28 February.
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 20), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, FOLLOWUP)
+        self.assertIn(T(8, 30), slots)  # ends exactly when the booking starts
+        self.assertNotIn(T(8, 45), slots)
+        self.assertNotIn(T(9, 0), slots)
+        self.assertNotIn(T(9, 15), slots)
+        self.assertIn(T(9, 30), slots)  # starts exactly when the booking ends
+
+    def test_assessment_length_is_checked_against_next_booking(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 20), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, MONDAY, ASSESSMENT)
+        self.assertIn(T(8, 15), slots)  # 08:15 to 09:00
+        self.assertNotIn(T(8, 30), slots)  # 08:30 to 09:15 runs into the 09:00 booking
+
+    def test_cancelled_appointment_frees_its_time(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 20), kind=FOLLOWUP, therapist="T1", status=CANCELLED)])
+        self.assertIn(T(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_attended_and_no_show_still_block(self):
+        for status in (ATTENDED, NO_SHOW):
+            with self.subTest(status=status):
+                cal = Calendar([appt("a1", utc(2027, 2, 28, 20), kind=FOLLOWUP, therapist="T1", status=status)])
+                self.assertNotIn(T(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 20), kind=FOLLOWUP, therapist="T2")])
+        self.assertIn(T(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+
+    def test_day_is_local_auckland_date(self):
+        # 09:00 on Tuesday 2 March is 20:00 UTC on Monday 1 March, so it blocks Tuesday, not Monday.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), kind=FOLLOWUP, therapist="T1")])
+        self.assertIn(T(9, 0), free_slots(cal, HB, MONDAY, FOLLOWUP))
+        self.assertNotIn(T(9, 0), free_slots(cal, HB, MONDAY + datetime.timedelta(days=1), FOLLOWUP))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, MONDAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
