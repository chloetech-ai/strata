@@ -0,0 +1,63 @@
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ATTENDED, BOOKED, CANCELLED, NO_SHOW
+from helpers import appt, utc
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2026, 10, 20, 9, 0)
+
+    def test_cancel_under_48_hours_costs_half_the_followup_price(self):
+        a = appt("A1", self.start, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9, 1)), 3500)
+
+    def test_cancel_under_48_hours_costs_half_the_assessment_price(self):
+        a = appt("A1", self.start, kind="assessment", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 19, 0, 0)), 4750)
+
+    def test_cancel_after_start_is_late(self):
+        a = appt("A1", self.start, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 20, 10, 0)), 3500)
+
+    def test_cancel_exactly_48_hours_before_is_free(self):
+        a = appt("A1", self.start, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9, 0)), 0)
+
+    def test_cancel_well_in_advance_is_free(self):
+        a = appt("A1", self.start, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 1, 9, 0)), 0)
+
+    def test_cancelled_without_cancelled_at_raises(self):
+        a = appt("A1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancelled_at_raises(self):
+        a = appt("A1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, self.start.replace(tzinfo=None))
+
+
+class NoShowFeeTest(unittest.TestCase):
+    def test_no_show_followup_costs_full_price(self):
+        a = appt("A1", utc(2026, 10, 20, 9, 0), kind="followup", status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_assessment_costs_full_price(self):
+        a = appt("A1", utc(2026, 10, 20, 9, 0), kind="assessment", status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+
+class OtherStatusTest(unittest.TestCase):
+    def test_booked_has_no_fee(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("A1", utc(2026, 10, 20, 9, 0), status=BOOKED))
+
+    def test_attended_has_no_fee(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("A1", utc(2026, 10, 20, 9, 0), status=ATTENDED))
+
+
+if __name__ == "__main__":
+    unittest.main()
