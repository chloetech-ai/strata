+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number="INV-HB-2026-00001", patient_id="KP-004211", issued=datetime.date(2026, 10, 15),
+            amount_cents=7000, description="Follow-up session", clinic="HB", patient_name=""):
+    return Invoice(number=number, clinic=clinic, patient_id=patient_id, patient_name=patient_name,
+                   issued=issued, amount_cents=amount_cents, description=description)
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_file_is_named_by_year_and_month_in_out_dir(self):
+        path = export_invoices([invoice()], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_writes_header_row_then_one_row_per_invoice(self):
+        path = export_invoices([invoice()], 2026, 10, self.out_dir)
+        rows = self.read_rows(path)
+        self.assertEqual(rows[0], ["InvoiceNumber", "ClinicCode", "PatientID", "InvoiceDate", "Description", "Amount"])
+        self.assertEqual(rows[1], ["INV-HB-2026-00001", "HB", "KP-004211", "15/10/2026", "Follow-up session", "70.00"])
+        self.assertEqual(len(rows), 2)
+
+    def test_dates_are_day_month_year(self):
+        path = export_invoices([invoice(issued=datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][3], "03/10/2026")
+
+    def test_amounts_are_plain_numbers_with_two_decimals(self):
+        path = export_invoices([invoice(amount_cents=9500), invoice(number="INV-HB-2026-00002", amount_cents=10)],
+                               2026, 10, self.out_dir)
+        rows = self.read_rows(path)
+        self.assertEqual(rows[1][5], "95.00")
+        self.assertEqual(rows[2][5], "0.10")
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("$", f.read())
+
+    def test_only_invoices_issued_in_that_month_are_exported(self):
+        invoices = [
+            invoice(number="INV-HB-2026-00001", issued=datetime.date(2026, 9, 30)),
+            invoice(number="INV-HB-2026-00002", issued=datetime.date(2026, 10, 1)),
+            invoice(number="INV-HB-2026-00003", issued=datetime.date(2026, 10, 31)),
+            invoice(number="INV-HB-2026-00004", issued=datetime.date(2026, 11, 1)),
+            invoice(number="INV-HB-2025-00005", issued=datetime.date(2025, 10, 15)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_rows_are_ordered_by_date_then_number(self):
+        invoices = [
+            invoice(number="INV-HB-2026-00003", issued=datetime.date(2026, 10, 20)),
+            invoice(number="INV-HB-2026-00002", issued=datetime.date(2026, 10, 20)),
+            invoice(number="INV-HB-2026-00001", issued=datetime.date(2026, 10, 5)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]],
+                         ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_no_invoices_gives_header_only(self):
+        rows = self.read_rows(export_invoices([], 2026, 10, self.out_dir))
+        self.assertEqual(len(rows), 1)
+
+    def test_patient_names_never_appear_in_the_file(self):
+        invoices = [invoice(patient_name="Aroha Test")]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_patient_id_that_is_not_kp_format_raises(self):
+        with self.assertRaises(ValueError):
+            export_invoices([invoice(patient_id="Aroha Test")], 2026, 10, self.out_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
