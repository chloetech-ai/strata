+"""Monthly export of invoices for Mere at Tui Accounting (imported into Xero).
+
+The export never contains patient names, only patient ids.
+"""
+
+import csv
+import os
+import re
+
+PATIENT_ID = re.compile(r"KP-[0-9]{6}")
+
+HEADER = ["InvoiceNumber", "ClinicCode", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir and return the file's path.
+
+    The file is kestrel-invoices-YYYY-MM.csv: a header row, dates as DD/MM/YYYY and
+    amounts as plain dollars with two decimals. Invoices are ordered by date, then number.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in month_invoices:
+            if not PATIENT_ID.fullmatch(invoice.patient_id):
+                raise ValueError(f"invoice {invoice.number} has a patient id that is not KP- plus six digits")
+            writer.writerow([
+                invoice.number,
+                invoice.clinic,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                f"{invoice.amount_cents / 100:.2f}",
+            ])
+    return path
