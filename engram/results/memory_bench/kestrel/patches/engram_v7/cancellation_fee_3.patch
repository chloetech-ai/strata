index 0000000..1e0a916
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,58 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ATTENDED, BOOKED, CANCELLED, NO_SHOW
+
+START = utc(2027, 5, 10, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_followup_price(self):
+        a = appt("A1", START, kind="followup", status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_pays_full_assessment_price(self):
+        a = appt("A1", START, kind="assessment", status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_cancelled_under_48_hours_before_costs_half(self):
+        a = appt("A1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47, minutes=59)), 3500)
+
+    def test_cancelled_under_48_hours_before_assessment_costs_half(self):
+        a = appt("A1", START, kind="assessment", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=1)), 4750)
+
+    def test_cancelled_exactly_48_hours_before_is_free(self):
+        a = appt("A1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+
+    def test_cancelled_well_ahead_is_free(self):
+        a = appt("A1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 5, 1, 9)), 0)
+
+    def test_cancelled_after_start_costs_half(self):
+        a = appt("A1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(minutes=5)), 3500)
+
+    def test_cancelled_without_cancelled_at_raises(self):
+        a = appt("A1", START, kind="followup", status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancelled_at_raises(self):
+        a = appt("A1", START, kind="followup", status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 5, 10, 8))
+
+    def test_booked_or_attended_has_no_fee_and_raises(self):
+        for status in (BOOKED, ATTENDED):
+            a = appt("A1", START, kind="followup", status=status)
+            with self.assertRaises(ValueError):
+                cancellation_fee(a, utc(2027, 5, 10, 8))
+
+
+if __name__ == "__main__":
+    unittest.main()
