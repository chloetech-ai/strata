+"""Appointment reminders sent by SMS."""
+
+from .calendar import AUCKLAND
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    # Privacy rule: say only the date, the time and the clinic name. No treatment.
+    local = appointment.start.astimezone(AUCKLAND)
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: you have an appointment at {clinic} on {local:%d/%m/%Y} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Text each patient with a booked appointment. Returns the number of messages sent.
+
+    patients maps patient ID to Patient. Every booked appointment needs its
+    patient in that mapping; this is checked before anything is sent.
+    """
+    booked = [a for a in appointments if a.status == BOOKED]
+    missing = sorted({a.patient_id for a in booked if a.patient_id not in patients})
+    if missing:
+        raise KeyError(f"no patient for appointments: {', '.join(missing)}")
+    messages = [(patients[a.patient_id].phone, reminder_text(a)) for a in booked]
+    if messages:
+        client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..4a888b1
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,77 @@
+import unittest
+
+from kestrel.models import CANCELLED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+
+from helpers import appt, utc
+
+
+class FakeClient:
+    def __init__(self):
+        self.sent = []
+
+    def send_batch(self, messages):
+        self.sent.extend(messages)
+        return [{"ok": True}]
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Alice Example", "+64211111111", csc=False),
+    "KP-000002": Patient("KP-000002", "Bob Example", "+64222222222", csc=True),
+}
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_date_time_and_clinic_name_in_auckland_time(self):
+        # 2026-10-15 20:30 UTC is 2026-10-16 09:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 15, 20, 30), clinic="HB", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertIn("16/10/2026", text)
+        self.assertIn("09:30", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+
+    def test_does_not_mention_treatment_or_kind(self):
+        a = appt("A1", utc(2026, 10, 15, 20, 30), kind="assessment", treatment="lower back pain")
+        text = reminder_text(a).lower()
+        self.assertNotIn("lower back", text)
+        self.assertNotIn("assessment", text)
+        self.assertNotIn("follow", text)
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_one_message_per_booked_appointment(self):
+        client = FakeClient()
+        appts = [
+            appt("A1", utc(2026, 10, 15, 20, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 16, 3, 0), patient="KP-000002"),
+        ]
+        count = send_reminders(appts, PATIENTS, client)
+        self.assertEqual(count, 2)
+        self.assertEqual([to for to, _ in client.sent], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        client = FakeClient()
+        cancelled = appt("A1", utc(2026, 10, 15, 20, 30), patient="KP-000001", status=CANCELLED,
+                         cancelled_at=utc(2026, 10, 10))
+        booked = appt("A2", utc(2026, 10, 16, 3, 0), patient="KP-000002")
+        self.assertEqual(send_reminders([cancelled, booked], PATIENTS, client), 1)
+        self.assertEqual([to for to, _ in client.sent], ["+64222222222"])
+
+    def test_no_appointments_sends_nothing(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([], PATIENTS, client), 0)
+        self.assertEqual(client.sent, [])
+
+    def test_missing_patient_raises_before_sending_anything(self):
+        client = FakeClient()
+        appts = [
+            appt("A1", utc(2026, 10, 15, 20, 30), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 16, 3, 0), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appts, PATIENTS, client)
+        self.assertEqual(client.sent, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
