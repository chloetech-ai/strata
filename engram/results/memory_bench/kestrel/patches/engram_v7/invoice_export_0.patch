+"""Exports for the accountant.
+
+Exports leave the system, so they must never contain patient names, only patient ids.
+"""
+
+import csv
+import os
+
+COLUMNS = ["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV file in out_dir and return its path.
+
+    The file is named kestrel-invoices-YYYY-MM.csv. Rows are sorted by date, then invoice number.
+    Dates are DD/MM/YYYY and amounts are plain numbers with two decimals, e.g. 95.00.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.clinic,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
