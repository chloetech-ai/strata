+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_sequence_for_the_clinic_and_year(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_sequences_are_counted_separately_per_clinic(self):
+        existing = ["INV-NG-2027-00900", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_sequence_restarts_in_a_new_year(self):
+        existing = ["INV-HB-2026-00042"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_that_are_not_in_the_format(self):
+        existing = [
+            "INV-HB-2027-0009",     # too few digits
+            "INV-HB-2027-000099",   # too many digits
+            "INV-HB-2027-0000a",    # not digits
+            "INV-HB-2027-00050 ",   # trailing space
+            "INV-HBX-2027-00060",   # longer clinic code
+            "XINV-HB-2027-00070",   # wrong prefix
+        ]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_raises_when_the_year_runs_out_of_sequence_numbers(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
