+def next_invoice_number(clinic, year, existing):
+    """Return the next INV-<clinic>-<year>-<sequence> number after those in existing.
+
+    The sequence is counted per clinic and per year, so only numbers with the
+    same clinic and year are considered; numbers for other clinics or years,
+    and anything not in the INV-<clinic>-<year>-<5 digits> form, are ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [
+        int(number[len(prefix):])
+        for number in existing
+        if re.fullmatch(re.escape(prefix) + r"[0-9]{5}", number)
+    ]
+    sequence = max(sequences, default=0) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{sequence:05d}"
+
+
