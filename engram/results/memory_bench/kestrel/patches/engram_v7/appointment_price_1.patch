+class AppointmentPriceTest(unittest.TestCase):
+    def patient(self, csc=False):
+        return Patient("KP-000001", "Ana Silva", "+64211234567", csc=csc)
+
+    def appointment(self, kind, start):
+        return Appointment("A1", "KP-000001", "T1", "HB", start, kind)
+
+    def test_assessment_price(self):
+        start = datetime.datetime(2027, 3, 10, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient()), 9500)
+
+    def test_followup_price(self):
+        start = datetime.datetime(2027, 3, 10, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient()), 7000)
+
+    def test_new_prices_apply_from_1_april_auckland_time(self):
+        start = datetime.datetime(2027, 4, 1, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient()), 10500)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient()), 7800)
+
+    def test_old_prices_apply_until_the_end_of_31_march_auckland_time(self):
+        start = datetime.datetime(2027, 3, 31, 23, 59, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient()), 7000)
+
+    def test_price_uses_auckland_date_not_utc_date(self):
+        # NZDT is UTC+13 until 4 April 2027, so 10:59 UTC on 31 March is still 31 March
+        # in Auckland, and 11:00 UTC on 31 March is 00:00 on 1 April.
+        before = datetime.datetime(2027, 3, 31, 10, 59, tzinfo=datetime.timezone.utc)
+        on = datetime.datetime(2027, 3, 31, 11, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("followup", before), self.patient()), 7000)
+        self.assertEqual(appointment_price(self.appointment("followup", on), self.patient()), 7800)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        start = datetime.datetime(2027, 3, 10, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(csc=True)), 5600)
+
+    def test_csc_followup_discount_uses_new_price_from_april_2027(self):
