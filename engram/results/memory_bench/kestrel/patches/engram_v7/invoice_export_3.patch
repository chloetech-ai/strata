+"""Exports for the accountant."""
+
+import csv
+import os
+
+HEADER = ["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as CSV, and return the file's path.
+
+    The file is named kestrel-invoices-YYYY-MM.csv for import into Xero. Patients
+    appear only by patient ID: patient names must never leave the system.
+    """
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in invoices:
+            if invoice.issued.year == year and invoice.issued.month == month:
+                writer.writerow([
+                    invoice.number,
+                    invoice.clinic,
+                    invoice.patient_id,
+                    invoice.issued.strftime("%d/%m/%Y"),
+                    invoice.description,
+                    _amount(invoice.amount_cents),
+                ])
+    return path
+
+
+def _amount(cents):
+    """Plain dollars with two decimals, e.g. 9500 -> '95.00', no dollar sign."""
+    sign = "-" if cents < 0 else ""
+    dollars, remainder = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{remainder:02d}"
diff --git a/tests/test_export.py b/tests/test_export.py
