diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index 56509bd..974a222 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -38,5 +38,15 @@ class Waitlist:
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
 
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it.
+
+        Does not remove the entry; it stays on the list until the caller removes it.
+        """
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
+
     def __len__(self):
         return len(self._entries)
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 1cabda3..1c240bd 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -86,6 +86,34 @@ class WaitlistTest(unittest.TestCase):
         wl.entries().clear()
         self.assertEqual(len(wl), 1)
 
+    def test_next_for_returns_earliest_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2027, 3, 1, 12), kind=FOLLOWUP))
+        wl.add(entry("KP-000002", utc(2027, 3, 1, 9), kind=ASSESSMENT))
+        wl.add(entry("KP-000003", utc(2027, 3, 1, 10), kind=FOLLOWUP))
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000003")
+        self.assertEqual(wl.next_for(ASSESSMENT).patient_id, "KP-000002")
+
+    def test_next_for_prefers_urgent_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", utc(2027, 3, 1, 9), kind=FOLLOWUP))
+        wl.add(entry("KP-000002", utc(2027, 3, 1, 12), kind=FOLLOWUP, urgent=True))
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000002")
+
+    def test_next_for_returns_none_when_nobody_waits_for_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", kind=FOLLOWUP))
+        self.assertIsNone(wl.next_for(ASSESSMENT))
+
+    def test_next_for_empty_waitlist_is_none(self):
+        self.assertIsNone(Waitlist().next_for(FOLLOWUP))
+
+    def test_next_for_does_not_remove_entry(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", kind=FOLLOWUP))
+        wl.next_for(FOLLOWUP)
+        self.assertEqual(len(wl), 1)
+
 
 if __name__ == "__main__":
     unittest.main()
