diff --git a/src/kestrel/pricing.py b/src/kestrel/pricing.py
index 39b964b..7614147 100644
--- a/src/kestrel/pricing.py
+++ b/src/kestrel/pricing.py
@@ -1,16 +1,46 @@
 """Session prices in cents."""
 
+import datetime
+
+from kestrel.calendar import AUCKLAND
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+# Prices for appointments starting before PRICE_CHANGE_DATE.
 PRICES_CENTS = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
 
+# Prices for appointments starting on or after PRICE_CHANGE_DATE (Auckland date).
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+# Community Services Card holders get this discount on follow-ups, not assessments.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
+
 
 def session_price(kind):
-    """Return the price in cents for a session of the given kind."""
+    """Return the price in cents for a session of the given kind, before PRICE_CHANGE_DATE."""
     try:
         return PRICES_CENTS[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """Return what the patient pays for the appointment, in cents.
+
+    The price table is chosen by the appointment's Auckland date. CSC holders
+    get CSC_FOLLOWUP_DISCOUNT_PERCENT off follow-ups.
+    """
+    if patient.id != appointment.patient_id:
+        raise ValueError(f"patient {patient.id} does not match appointment patient {appointment.patient_id}")
+    day = appointment.start.astimezone(AUCKLAND).date()
+    prices = NEW_PRICES_CENTS if day >= PRICE_CHANGE_DATE else PRICES_CENTS
+    price = prices[appointment.kind]
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price -= price * CSC_FOLLOWUP_DISCOUNT_PERCENT // 100
+    return price
