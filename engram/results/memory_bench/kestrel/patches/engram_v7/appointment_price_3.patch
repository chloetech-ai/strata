+class AppointmentPriceTest(unittest.TestCase):
+    # NZDT is UTC+13 until 4 April 2027.
+    def test_before_price_change_keeps_old_prices(self):
+        # 10:30 UTC on 31 March is 23:30 on 31 March in Auckland.
+        start = datetime.datetime(2027, 3, 31, 10, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appt("assessment", start), patient()), 9500)
+        self.assertEqual(appointment_price(appt("followup", start), patient()), 7000)
+
+    def test_price_change_applies_from_auckland_midnight_on_1_april(self):
+        # 11:30 UTC on 31 March is 00:30 on 1 April in Auckland.
+        start = datetime.datetime(2027, 3, 31, 11, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appt("assessment", start), patient()), 10500)
+        self.assertEqual(appointment_price(appt("followup", start), patient()), 7800)
+
+    def test_csc_discount_applies_to_followups_only(self):
+        start = datetime.datetime(2027, 4, 2, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appt("followup", start), patient(csc=True)), 6240)
+        self.assertEqual(appointment_price(appt("assessment", start), patient(csc=True)), 10500)
+
+    def test_csc_discount_before_price_change(self):
+        start = datetime.datetime(2027, 3, 1, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appt("followup", start), patient(csc=True)), 5600)
+        self.assertEqual(appointment_price(appt("assessment", start), patient(csc=True)), 9500)
+
+    def test_patient_must_match_appointment(self):
+        start = datetime.datetime(2027, 4, 2, 9, 0, tzinfo=UTC)
+        with self.assertRaises(ValueError):
+            appointment_price(appt("followup", start, patient_id="KP-000002"), patient())
+
+
 if __name__ == "__main__":
     unittest.main()
