diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index 2d8ecc9..b121f46 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -60,6 +60,12 @@ class Calendar:
             key=lambda a: a.start,
         )
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 71ed543..ac4a5db 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -47,6 +47,32 @@ class CalendarTest(unittest.TestCase):
             with self.subTest(typed=typed):
                 self.assertEqual([a.id for a in cal.for_patient(typed)], ["a1"])
 
+    def test_upcoming_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("later", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("soon", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("past", utc(2027, 3, 1, 9), patient="KP-004211"),
+            appt("now", utc(2027, 3, 1, 12), patient="KP-004211"),
+            appt("cancelled", utc(2027, 3, 4, 9), patient="KP-004211", status="cancelled"),
+            appt("other", utc(2027, 3, 2, 10), patient="KP-000007"),
+        ])
+        result = cal.upcoming("kp4211", utc(2027, 3, 1, 12))
+        self.assertEqual([a.id for a in result], ["soon", "later"])
+
+    def test_upcoming_empty_when_none(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-004211", utc(2027, 3, 2, 0)), [])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 1, 12))
+
+    def test_upcoming_rejects_malformed_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("not-an-id", utc(2027, 3, 1, 12))
+
     def test_booked(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
