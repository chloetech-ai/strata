+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import AUCKLAND
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+
+STEP = datetime.timedelta(minutes=15)
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+# Only Northgate opens on Saturdays; every clinic is closed on Sundays.
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a local date, or None if closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5:
+        return SATURDAY_HOURS.get(clinic)
+    return None
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times, sorted, at which a new appointment of this kind could be booked.
+
+    A slot is free when the whole appointment fits within the clinic's opening
+    hours and overlaps no appointment of the therapist's that is not cancelled.
+    Times are on a 15-minute grid.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    duration = DURATIONS[kind]
+    start = datetime.datetime.combine(day, hours[0], tzinfo=AUCKLAND)
+    close = datetime.datetime.combine(day, hours[1], tzinfo=AUCKLAND)
+    busy = [
+        (a.start, a.start + DURATIONS[a.kind])
+        for a in calendar.for_therapist(therapist.id)
+        if a.status != CANCELLED
+    ]
+    slots = []
+    while start + duration <= close:
+        end = start + duration
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            slots.append(start.time())
+        start += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..6ee38c3
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,75 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+MONDAY = datetime.date(2027, 3, 1)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def setUp(self):
+        self.therapist = Therapist("T1", "Ana", "HB")
+
+    def test_empty_weekday_covers_opening_hours(self):
+        slots = free_slots(Calendar(), self.therapist, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))
+        self.assertEqual(len(slots), 41)
+
+    def test_assessment_must_finish_by_close(self):
+        slots = free_slots(Calendar(), self.therapist, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))
+        self.assertEqual(len(slots), 40)
+
+    def test_booked_assessment_blocks_overlapping_followup_starts(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), kind=ASSESSMENT, therapist="T1")])  # 10:00 NZDT
+        slots = free_slots(cal, self.therapist, MONDAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)
+        for blocked in (t(9, 45), t(10, 0), t(10, 15), t(10, 30)):
+            self.assertNotIn(blocked, slots)
+        self.assertIn(t(10, 45), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T1", status=CANCELLED)])
+        self.assertIn(t(10, 0), free_slots(cal, self.therapist, MONDAY, FOLLOWUP))
+
+    def test_attended_and_no_show_still_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T1", status="no_show")])
+        self.assertNotIn(t(10, 0), free_slots(cal, self.therapist, MONDAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T2")])
+        self.assertIn(t(10, 0), free_slots(cal, self.therapist, MONDAY, FOLLOWUP))
+
+    def test_utc_booking_blocks_the_local_time(self):
+        # 21:00 UTC on 28 February is 10:00 on 1 March in Auckland (NZDT, UTC+13).
+        cal = Calendar([appt("a1", utc(2027, 2, 28, 21, 0), therapist="T1")])
+        self.assertNotIn(t(10, 0), free_slots(cal, self.therapist, MONDAY, FOLLOWUP))
+        self.assertIn(t(10, 0), free_slots(cal, self.therapist, datetime.date(2027, 2, 26), FOLLOWUP))
+
+    def test_saturday_only_northgate_open(self):
+        northgate = Therapist("T2", "Ben", "NG")
+        slots = free_slots(Calendar(), northgate, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(8, 0))
+        self.assertEqual(slots[-1], t(11, 30))
+        self.assertEqual(free_slots(Calendar(), self.therapist, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), self.therapist, SUNDAY, FOLLOWUP), [])
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), self.therapist, MONDAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
