+def next_invoice_number(clinic, year, existing):
+    """Return the next number for a clinic's invoices in a year, e.g. INV-HB-2027-00001.
+
+    The sequence is counted separately for each clinic and restarts every year,
+    so only numbers with this clinic's code and year are considered; the rest
+    of `existing` is ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        sequence = number[len(prefix):]
+        if number.startswith(prefix) and re.fullmatch(r"[0-9]{5}", sequence):
+            highest = max(highest, int(sequence))
+    if highest >= 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{highest + 1:05d}"
+
+
