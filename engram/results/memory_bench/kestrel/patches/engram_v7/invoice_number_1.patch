+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_sequence_for_clinic_and_year(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_other_clinics_do_not_affect_the_sequence(self):
+        existing = ["INV-NG-2027-00900", "INV-WK-2027-00500", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_other_years_do_not_affect_the_sequence(self):
+        existing = ["INV-HB-2026-00815", "INV-HB-2028-00100"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_only_clinic_with_no_numbers_yet_starts_at_00001(self):
+        existing = ["INV-NG-2027-00010"]
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2027-00009"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00010")
+
+    def test_ignores_numbers_that_are_not_in_the_expected_form(self):
+        existing = ["INV-HB-2027-0005", "INV-HB-2027-000003", "INV-HB-2027-00004x", "INV-HB-2027-abcde"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_raises_when_the_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
