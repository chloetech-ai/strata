+++ b/tests/test_fees.py
@@ -0,0 +1,57 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 10, 9)
+
+    def test_late_cancellation_is_half_the_assessment_price(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9, 1)), 4750)
+
+    def test_late_cancellation_is_half_the_followup_price(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 0)), 3500)
+
+    def test_cancellation_exactly_48_hours_before_is_not_late(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9)), 0)
+
+    def test_early_cancellation_is_free(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 9)), 0)
+
+    def test_cancellation_after_start_is_late(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 10)), 3500)
+
+    def test_cancelled_without_time_raises(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancelled_at_raises(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, self.start.replace(tzinfo=None))
+
+    def test_no_show_is_full_assessment_price(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_is_full_followup_price(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_attended_or_booked_has_no_cancellation_fee(self):
+        for status in (ATTENDED, BOOKED):
+            a = appt("a1", self.start, status=status)
+            with self.assertRaises(ValueError):
+                cancellation_fee(a)
+
+
+if __name__ == "__main__":
+    unittest.main()
