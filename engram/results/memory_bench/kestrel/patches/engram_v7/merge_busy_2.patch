+"""Helpers for working with time intervals."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs into sorted, non-overlapping pairs.
+
+    The pairs may come in any order. Pairs that overlap or touch
+    (one ends exactly where the next starts) are merged into one.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
