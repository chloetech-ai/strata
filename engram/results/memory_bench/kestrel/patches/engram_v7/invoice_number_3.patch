+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_increments_highest_existing_sequence(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+
+    def test_uses_highest_not_last_listed(self):
+        existing = ["INV-HB-2026-00007", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_other_clinics_do_not_affect_sequence(self):
+        existing = ["INV-NG-2026-00009", "INV-WK-2026-00004"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_other_years_do_not_affect_sequence(self):
+        existing = ["INV-HB-2025-00500"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_restarts_at_00001_in_new_year_after_previous_year(self):
+        existing = ["INV-HB-2025-00500", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_numbers_that_do_not_match_the_format(self):
+        existing = ["INV-HB-2026-0003", "INV-HB-2026-000040", "INV-HB-2026-00002x",
+                    "INV-HB-2026-ABCDE", "XINV-HB-2026-00050", "INV-HBX-2026-00050"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2026-00004"])
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00005")
+
+    def test_last_sequence_number_is_available(self):
+        existing = ["INV-HB-2026-99998"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-99999")
+
+    def test_raises_when_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2026, ["INV-HB-2026-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
