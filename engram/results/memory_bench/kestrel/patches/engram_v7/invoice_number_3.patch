+
+
+SEQUENCE_DIGITS = 5
+
+
+def next_invoice_number(clinic, year, existing):
+    """Return the next invoice number, INV-<clinic>-<year>-<sequence>.
+
+    Sequences are counted per clinic and per year, so only numbers with this
+    clinic and year count; `existing` may hold numbers for any clinic or year.
+    The first invoice of each year is 00001.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    pattern = re.compile(re.escape(prefix) + r"[0-9]{%d}" % SEQUENCE_DIGITS)
+    highest = 0
+    for number in existing:
+        if pattern.fullmatch(number):
+            highest = max(highest, int(number[len(prefix):]))
+    if highest + 1 >= 10 ** SEQUENCE_DIGITS:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{highest + 1:0{SEQUENCE_DIGITS}d}"
