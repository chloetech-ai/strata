+class AppointmentPriceTest(unittest.TestCase):
+    def test_assessment_before_rise_is_95_dollars(self):
+        start = datetime.datetime(2027, 3, 15, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 9500)
+
+    def test_followup_before_rise_is_70_dollars(self):
+        start = datetime.datetime(2027, 3, 15, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7000)
+
+    def test_assessment_from_rise_is_105_dollars(self):
+        start = datetime.datetime(2027, 6, 1, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient()), 10500)
+
+    def test_followup_from_rise_is_78_dollars(self):
+        start = datetime.datetime(2027, 6, 1, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7800)
+
+    def test_last_moment_before_rise_uses_old_price(self):
+        # 23:30 on 31 March in Auckland (NZDT, UTC+13) is 10:30 UTC.
+        start = datetime.datetime(2027, 3, 31, 10, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7000)
+
+    def test_first_moment_of_rise_uses_new_price(self):
+        # 00:30 on 1 April in Auckland is 11:30 UTC on 31 March.
+        start = datetime.datetime(2027, 3, 31, 11, 30, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient()), 7800)
+
+    def test_csc_followup_gets_20_percent_off(self):
+        start = datetime.datetime(2027, 6, 1, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient(csc=True)), 6240)
+
+    def test_csc_followup_before_rise_gets_20_percent_off(self):
+        start = datetime.datetime(2027, 3, 15, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), patient(csc=True)), 5600)
+
+    def test_csc_assessment_gets_no_discount(self):
+        start = datetime.datetime(2027, 6, 1, 9, 0, tzinfo=UTC)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), patient(csc=True)), 10500)
+
