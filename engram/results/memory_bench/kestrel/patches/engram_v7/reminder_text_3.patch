+"""Text of the SMS reminders sent to patients."""
+
+import zoneinfo
+
+from .models import CLINICS
+
+AUCKLAND = zoneinfo.ZoneInfo("Pacific/Auckland")
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Privacy rule: the text gives only the date, the time and the clinic name.
+    It must not mention the patient or the treatment.
+    """
+    local = appointment.start.astimezone(AUCKLAND)
+    date = f"{local:%A} {local.day} {local:%B}"
+    hour = local.hour % 12 or 12
+    time = f"{hour}:{local.minute:02d}{'am' if local.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Friendly reminder from {clinic}: you have an appointment on {date} "
+        f"at {time}. We look forward to seeing you!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..e119027
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,40 @@
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 20:30 UTC on 15 Oct is 9:30am on Friday 16 Oct in Auckland (NZDT, UTC+13)
+        a = appt("A1", utc(2026, 10, 15, 20, 30), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Friendly reminder from Kestrel Physio Harbour: you have an appointment on "
+            "Friday 16 October at 9:30am. We look forward to seeing you!",
+        )
+
+    def test_afternoon_time_uses_pm_and_twelve_hour_clock(self):
+        # 03:05 UTC is 4:05pm in Auckland
+        a = appt("A1", utc(2026, 10, 15, 3, 5), clinic="NG")
+        self.assertIn("at 4:05pm.", reminder_text(a))
+        self.assertIn("Kestrel Physio Northgate", reminder_text(a))
+
+    def test_midday_and_midnight_are_twelve(self):
+        noon = appt("A1", utc(2026, 10, 15, 23, 0), clinic="WK")  # 12:00pm NZDT
+        midnight = appt("A2", utc(2026, 10, 15, 11, 0), clinic="WK")  # 12:00am NZDT
+        self.assertIn("at 12:00pm.", reminder_text(noon))
+        self.assertIn("at 12:00am.", reminder_text(midnight))
+
+    def test_does_not_mention_patient_or_treatment(self):
+        a = appt("A1", utc(2026, 10, 15, 3, 0), patient="KP-004211",
+                 treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("KP-004211", text)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("back", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
