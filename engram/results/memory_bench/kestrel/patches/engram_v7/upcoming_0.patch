@@ -108,6 +108,31 @@ class CalendarTest(unittest.TestCase):
             cal.cancel("a1", datetime.datetime(2027, 2, 28, 9))
         self.assertEqual(cal.get("a1").status, "booked")
 
+    def test_upcoming_booked_after_now_soonest_first(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("later", utc(2027, 3, 3, 9), patient="KP-000001"),
+            appt("soon", utc(2027, 3, 2, 9), patient="KP-000001"),
+            appt("past", utc(2027, 3, 1, 9), patient="KP-000001"),
+            appt("cancelled", utc(2027, 3, 2, 10), patient="KP-000001", status="cancelled"),
+            appt("other", utc(2027, 3, 2, 8), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "later"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        now = utc(2027, 3, 2, 9)
+        cal = Calendar([appt("a1", now, patient="KP-000001")])
+        self.assertEqual(cal.upcoming("KP-000001", now), [])
+
+    def test_upcoming_accepts_messy_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 1, 12))], ["a1"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 12))
+
 
 if __name__ == "__main__":
     unittest.main()
