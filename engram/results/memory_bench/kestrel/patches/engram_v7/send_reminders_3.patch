index 0000000..d3f8791
--- /dev/null
+++ b/src/kestrel/reminders.py
@@ -0,0 +1,28 @@
+"""Appointment reminders sent by SMS."""
+
+from .calendar import AUCKLAND
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS body. Privacy rule: date, time and clinic name only, never the treatment."""
+    start = appointment.start.astimezone(AUCKLAND)
+    clinic = CLINICS[appointment.clinic]
+    return f"{clinic.name}: reminder of your appointment on {start:%d/%m/%Y} at {start:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of each booked appointment. Returns the number sent.
+
+    patients maps patient ID to Patient. Every message is built before anything
+    is sent, so a missing patient or clinic raises without sending a partial batch.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[appointment.patient_id]
+        messages.append((patient.phone, reminder_text(appointment)))
+    if messages:
+        client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..d9dbbc1
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,78 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import CANCELLED, NO_SHOW, Patient
+from kestrel.reminders import reminder_text, send_reminders
+
+
+class FakeClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        messages = list(messages)
+        self.batches.append(messages)
+        return [{"ok": True}]
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Alex Example", "+64211000001"),
+    "KP-000002": Patient("KP-000002", "Sam Sample", "+64211000002"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_one_sms_per_booked_appointment_returns_count(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 2, 20), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 2)
+        self.assertEqual(len(client.batches), 1)
+        self.assertEqual([to for to, _ in client.batches[0]], ["+64211000001", "+64211000002"])
+
+    def test_skips_cancelled_and_no_show(self):
+        client = FakeClient()
+        cancelled = appt("a1", utc(2027, 3, 1, 20), patient="KP-000001", status=CANCELLED,
+                         cancelled_at=utc(2027, 2, 28, 1))
+        no_show = appt("a2", utc(2027, 3, 1, 21), patient="KP-000002", status=NO_SHOW)
+        booked = appt("a3", utc(2027, 3, 1, 22), patient="KP-000002")
+        self.assertEqual(send_reminders([cancelled, no_show, booked], PATIENTS, client), 1)
+        self.assertEqual([to for to, _ in client.batches[0]], ["+64211000002"])
+
+    def test_no_booked_appointments_sends_nothing(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([], PATIENTS, client), 0)
+        self.assertEqual(client.batches, [])
+
+    def test_missing_patient_sends_nothing(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, client)
+        self.assertEqual(client.batches, [])
+
+    def test_text_has_date_time_and_clinic_name_in_auckland_time(self):
+        # 20:30 UTC on 1 March is 09:30 on 2 March in Auckland (NZDT, UTC+13).
+        client = FakeClient()
+        send_reminders([appt("a1", utc(2027, 3, 1, 20, 30), patient="KP-000001", clinic="HB")], PATIENTS, client)
+        ((_, text),) = client.batches[0]
+        self.assertEqual(text, "Kestrel Physio Harbour: reminder of your appointment on 02/03/2027 at 09:30.")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_never_contains_treatment_or_patient_name(self):
+        a = appt("a1", utc(2027, 3, 1, 20), patient="KP-000001", treatment="lower back pain", clinic="NG")
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("Alex", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
