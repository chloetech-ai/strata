+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import AUCKLAND
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS reminder for an appointment, sent two days before it.
+
+    Says only the date, the time and the clinic name. The privacy officer does
+    not allow reminders to say what the appointment is for, so the treatment
+    and the patient's details are left out.
+    """
+    local = appointment.start.astimezone(AUCKLAND)
+    clinic = CLINICS[appointment.clinic].name
+    when = f"{local:%A} {local.day} {local:%B} at {_clock(local)}"
+    return (
+        f"{clinic}: friendly reminder of your appointment on {when}. "
+        "We look forward to seeing you! If you need to change it, please contact the clinic."
+    )
+
+
+def _clock(moment):
+    """Twelve-hour time such as 9:30am or 2pm."""
+    hour = moment.hour % 12 or 12
+    suffix = "am" if moment.hour < 12 else "pm"
+    if moment.minute:
+        return f"{hour}:{moment.minute:02d}{suffix}"
+    return f"{hour}{suffix}"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
