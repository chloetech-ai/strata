index 0000000..5adb9ad
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,14 @@
+import re
+
+_DURATION = re.compile(r"^(?:([0-9]+)h(?: ?([0-5]?[0-9])m?)?|([0-9]+)m)$")
+
+
+def parse_duration(text):
+    """Return the number of minutes in a duration such as '45m', '1h', '1h30' or '1h 30m'."""
+    match = _DURATION.match(text)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours, minutes, only_minutes = match.groups()
+    if only_minutes is not None:
+        return int(only_minutes)
+    return int(hours) * 60 + int(minutes or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
