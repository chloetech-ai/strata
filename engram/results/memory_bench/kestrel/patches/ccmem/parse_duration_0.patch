diff --git a/src/kestrel/intervals.py b/src/kestrel/intervals.py
new file mode 100644
index 0000000..34dfcf2
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,28 @@
+"""Parsing for hand-typed appointment lengths."""
+
+import re
+
+_DURATION = re.compile(r"(?:(\d+)h\s*(\d+)?m?|(\d+)h|(\d+)m)", re.IGNORECASE)
+
+
+def parse_duration(text):
+    """Turn a typed length such as '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Raises ValueError if the text is not a duration.
+    """
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, hours_only, minutes_only = match.groups()
+    if minutes_only is not None:
+        total = int(minutes_only)
+    elif hours_only is not None:
+        total = int(hours_only) * 60
+    else:
+        minutes = int(minutes_after_hours or 0)
+        if minutes >= 60:
+            raise ValueError(f"not a duration: {text!r}")
+        total = int(hours) * 60 + minutes
+    if total == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return total
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..51eb6c4
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,30 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes_only(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours_only(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes(self):
+        cases = {"1h30": 90, "1h 30m": 90, "1h30m": 90, "2h 15": 135}
+        for raw, minutes in cases.items():
+            with self.subTest(raw=raw):
+                self.assertEqual(parse_duration(raw), minutes)
+
+    def test_ignores_outer_whitespace(self):
+        self.assertEqual(parse_duration(" 45m\n"), 45)
+
+    def test_rejects_anything_else(self):
+        for raw in ["", "m", "h", "45", "45 m", "1.5h", "-30m", "1h60", "1h 90m", "0m", "0h", "1 h", "30min", "1h30m15"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
