+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.patient = Patient("KP-004211", "Test Patient", "+64211234567")
+        self.start = datetime.datetime(2026, 10, 15, 9, 0, tzinfo=datetime.timezone.utc)
+
+    def appointment(self, kind, patient_id="KP-004211"):
+        return Appointment("A1", patient_id, "T1", "NG", self.start, kind)
+
+    def test_assessment_price_matches_session_price(self):
+        self.assertEqual(
+            appointment_price(self.appointment(ASSESSMENT), self.patient),
