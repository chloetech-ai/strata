+        )
+
+    def test_followup_price_matches_session_price(self):
+        self.assertEqual(
+            appointment_price(self.appointment(FOLLOWUP), self.patient),
+            session_price(FOLLOWUP),
+        )
+
+    def test_other_patients_appointment_is_rejected(self):
+        other = self.appointment(FOLLOWUP, patient_id="KP-000001")
+        with self.assertRaises(ValueError):
