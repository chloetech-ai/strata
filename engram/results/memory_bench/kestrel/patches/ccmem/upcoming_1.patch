diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index 3c4ed58..3349b3e 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -66,5 +66,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now` (timezone-aware), soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 9e07db3..7783072 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -118,6 +118,39 @@ class CalendarTest(unittest.TestCase):
                     cal.move("a1", utc(2027, 3, 8, 9))
                 self.assertEqual(cal.get("a1").start, utc(2027, 3, 1, 20))
 
+    def test_upcoming_soonest_first_and_only_after_now(self):
+        now = utc(2027, 3, 2, 12)
+        cal = Calendar([
+            appt("late", utc(2027, 3, 5, 9)),
+            appt("past", utc(2027, 3, 1, 9)),
+            appt("soon", utc(2027, 3, 2, 13)),
+            appt("exactly_now", utc(2027, 3, 2, 12)),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["soon", "late"])
+
+    def test_upcoming_only_booked_and_only_this_patient(self):
+        now = utc(2027, 3, 2, 12)
+        cal = Calendar([
+            appt("booked", utc(2027, 3, 5, 9)),
+            appt("cancelled", utc(2027, 3, 5, 10), status="cancelled"),
+            appt("other", utc(2027, 3, 5, 11), patient="KP-000002"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["booked"])
+
+    def test_upcoming_accepts_typed_ids(self):
+        now = utc(2027, 3, 2, 12)
+        cal = Calendar([appt("a1", utc(2027, 3, 5, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", now)], ["a1"])
+
+    def test_upcoming_empty_for_unknown_patient(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 5, 9))])
+        self.assertEqual(cal.upcoming("KP-999999", utc(2027, 3, 2, 12)), [])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 5, 9))])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 2, 12))
+
 
 if __name__ == "__main__":
     unittest.main()
