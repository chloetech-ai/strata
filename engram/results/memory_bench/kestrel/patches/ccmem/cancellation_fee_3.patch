+++ b/tests/test_fees.py
@@ -0,0 +1,63 @@
+import datetime
+import unittest
+
+from helpers import UTC, appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
+START = utc(2027, 3, 10, 2)  # 2027-03-10 02:00 UTC
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status="no_show")), 7000)
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=ASSESSMENT, status="no_show")), 9500)
+
+    def test_no_show_ignores_none_cancelled_at(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status="no_show"), None), 7000)
+
+    def test_cancelled_inside_48_hours_pays_half(self):
+        cancelled = appt("a1", START, kind=FOLLOWUP, status="cancelled")
+        self.assertEqual(cancellation_fee(cancelled, utc(2027, 3, 8, 3)), 3500)  # 47 hours before
+        self.assertEqual(cancellation_fee(cancelled, utc(2027, 3, 10, 1)), 3500)  # 1 hour before
+
+    def test_assessment_late_cancellation_is_half_of_95_dollars(self):
+        cancelled = appt("a1", START, kind=ASSESSMENT, status="cancelled")
+        self.assertEqual(cancellation_fee(cancelled, utc(2027, 3, 9, 2)), 4750)
+
+    def test_cancelled_after_start_pays_half(self):
+        cancelled = appt("a1", START, status="cancelled")
+        self.assertEqual(cancellation_fee(cancelled, utc(2027, 3, 10, 3)), 3500)
+
+    def test_cancelled_exactly_48_hours_before_is_free(self):
+        cancelled = appt("a1", START, status="cancelled")
+        self.assertEqual(cancellation_fee(cancelled, utc(2027, 3, 8, 2)), 0)
+
+    def test_cancelled_outside_48_hours_is_free(self):
+        cancelled = appt("a1", START, status="cancelled")
+        self.assertEqual(cancellation_fee(cancelled, utc(2027, 3, 1, 9)), 0)
+
+    def test_window_is_by_instant_across_time_zones(self):
+        # 2027-03-08 15:00 at UTC+13 is 02:00 UTC, exactly 48 hours before START.
+        nz = datetime.timezone(datetime.timedelta(hours=13))
+        cancelled = appt("a1", START, status="cancelled")
+        self.assertEqual(cancellation_fee(cancelled, datetime.datetime(2027, 3, 8, 15, tzinfo=nz)), 0)
+        self.assertEqual(cancellation_fee(cancelled, datetime.datetime(2027, 3, 8, 16, tzinfo=nz)), 3500)
+
+    def test_cancelled_needs_cancelled_at(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status="cancelled"))
+
+    def test_cancelled_at_must_be_aware(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("a1", START, status="cancelled"), datetime.datetime(2027, 3, 9, 2))
+
+    def test_other_statuses_have_no_fee_rule(self):
+        for status in ["booked", "attended"]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", START, status=status), utc(2027, 3, 9, 2))
+
+
+if __name__ == "__main__":
+    unittest.main()
