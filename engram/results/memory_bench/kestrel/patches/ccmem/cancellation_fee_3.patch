+"""Cancellation and no-show fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation less than this long before the start is late.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for an appointment that was cancelled or missed.
+
+    A no-show pays the full session price. A cancelled appointment pays
+    LATE_CANCELLATION_PERCENT of the session price if it was cancelled inside
+    LATE_CANCELLATION_WINDOW before the start, and nothing otherwise. For a
+    cancelled appointment, `cancelled_at` is when the patient cancelled
+    (timezone-aware); for a no-show it should be None.
+
+    Raises ValueError for any other status, and for a cancelled appointment
+    with no `cancelled_at`.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled appointment needs cancelled_at")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price * LATE_CANCELLATION_PERCENT // 100
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
