@@ -0,0 +1,48 @@
+"""Booking rules: whether a new appointment fits in a therapist's calendar."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+LENGTHS = {ASSESSMENT: datetime.timedelta(minutes=45), FOLLOWUP: datetime.timedelta(minutes=30)}
+NOTE_GAP = {ASSESSMENT: datetime.timedelta(minutes=15), FOLLOWUP: datetime.timedelta(0)}
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per local day
+
+
+def busy_span(appointment):
+    """The time a therapist is tied up by an appointment: its length plus any note gap."""
+    end = appointment.start + LENGTHS[appointment.kind] + NOTE_GAP[appointment.kind]
+    return appointment.start, end
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for the therapist with id `therapist`.
+
+    It must be for that therapist, have a new id, start on a quarter hour (clinic time),
+    not overlap any other non-cancelled appointment for the therapist (including the note
+    gap after an assessment), and leave the therapist within DAILY_CAP that day.
+    """
+    if appointment.therapist_id != therapist:
+        return False
+    try:
+        calendar.get(appointment.id)
+    except KeyError:
+        pass
+    else:
+        return False
+
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    new_start, new_end = busy_span(appointment)
+    for other in calendar.for_therapist(therapist):
+        if other.status == CANCELLED:
+            continue
+        other_start, other_end = busy_span(other)
+        if new_start < other_end and other_start < new_end:
+            return False
+
+    booked_that_day = [a for a in calendar.for_day(therapist, local_start.date()) if a.status != CANCELLED]
+    return len(booked_that_day) < DAILY_CAP
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..3a25c41
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,95 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP
+
+
+def local(hh, mm=0, day=2):
+    """A timezone-aware Auckland time on 2027-03-<day>."""
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+def half_hours_from_8(i):
+    """The i-th half-hour slot counting from 08:00 on 2027-03-02."""
+    return local(8) + datetime.timedelta(minutes=30 * i)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), "T1", appt("new", local(9), therapist="T1")))
+
+    def test_rejects_overlapping_followup(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])
+        self.assertFalse(can_book(cal, "T1", appt("new", local(9, 15), therapist="T1")))
+
+    def test_allows_back_to_back_followups(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])
+        self.assertTrue(can_book(cal, "T1", appt("new", local(9, 30), therapist="T1")))
+
+    def test_assessment_needs_15_minute_gap_after(self):
+        cal = Calendar([appt("a1", local(9), kind=ASSESSMENT, therapist="T1")])  # busy 09:00-10:00
+        self.assertFalse(can_book(cal, "T1", appt("new", local(9, 45), therapist="T1")))
+        self.assertTrue(can_book(cal, "T1", appt("new", local(10), therapist="T1")))
+
+    def test_followup_has_no_gap_after(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])  # busy 09:00-09:30
+        self.assertTrue(can_book(cal, "T1", appt("new", local(9, 30), kind=ASSESSMENT, therapist="T1")))
+
+    def test_new_assessment_cannot_run_into_existing_appointment_or_its_gap(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1")])  # busy 10:00-10:30
+        self.assertFalse(can_book(cal, "T1", appt("new", local(9, 30), kind=ASSESSMENT, therapist="T1")))
+        self.assertTrue(can_book(cal, "T1", appt("new", local(9), kind=ASSESSMENT, therapist="T1")))
+
+    def test_rejects_start_off_the_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), "T1", appt("new", local(9, 10), therapist="T1")))
+
+    def test_rejects_seconds_past_the_quarter_hour(self):
+        start = local(9) + datetime.timedelta(seconds=1)
+        self.assertFalse(can_book(Calendar(), "T1", appt("new", start, therapist="T1")))
+
+    def test_quarter_hour_is_checked_in_clinic_time(self):
+        # 09:00 Auckland is 20:00 UTC the day before, which is still a quarter hour.
+        start = datetime.datetime(2027, 3, 1, 20, 0, tzinfo=datetime.timezone.utc)
+        self.assertTrue(can_book(Calendar(), "T1", appt("new", start, therapist="T1")))
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(9), kind=ASSESSMENT, therapist="T1", status="cancelled")])
+        self.assertTrue(can_book(cal, "T1", appt("new", local(9), therapist="T1")))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(9), therapist="T2")])
+        self.assertTrue(can_book(cal, "T1", appt("new", local(9), therapist="T1")))
+
+    def test_rejects_appointment_for_another_therapist(self):
+        self.assertFalse(can_book(Calendar(), "T1", appt("new", local(9), therapist="T2")))
+
+    def test_rejects_duplicate_id(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])
+        self.assertFalse(can_book(cal, "T1", appt("a1", local(11), therapist="T1")))
+
+    def test_daily_cap_of_eight(self):
+        booked = [appt(f"a{i}", half_hours_from_8(i), therapist="T1") for i in range(7)]
+        cal = Calendar(booked)
+        self.assertTrue(can_book(cal, "T1", appt("ok", local(12), therapist="T1")))
+        cal.add(appt("a7", local(12), therapist="T1"))
+        self.assertFalse(can_book(cal, "T1", appt("ninth", local(13), therapist="T1")))
+
+    def test_cap_is_per_therapist(self):
+        booked = [appt(f"a{i}", half_hours_from_8(i), therapist="T2") for i in range(8)]
+        self.assertTrue(can_book(Calendar(booked), "T1", appt("new", local(12), therapist="T1")))
+
+    def test_cap_is_per_local_day(self):
+        booked = [appt(f"a{i}", half_hours_from_8(i), therapist="T1") for i in range(8)]
+        self.assertTrue(can_book(Calendar(booked), "T1", appt("new", local(8, 0, day=3), therapist="T1")))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        booked = [appt(f"a{i}", half_hours_from_8(i), therapist="T1") for i in range(7)]
+        booked.append(appt("gone", local(12), therapist="T1", status="cancelled"))
+        self.assertTrue(can_book(Calendar(booked), "T1", appt("new", local(13), therapist="T1")))
+
+
+if __name__ == "__main__":
+    unittest.main()
