+"""Cancellation fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation with less notice than this is a late cancellation.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for an appointment that was cancelled or missed.
+
+    A cancelled appointment is charged 50% of the session price if it was cancelled
+    inside LATE_CANCELLATION_WINDOW before the start, and nothing otherwise.
+    A no-show is charged the full session price. `cancelled_at` is when the patient
+    cancelled (timezone-aware); it is None for a no-show.
+
+    Raises ValueError for an appointment that is neither cancelled nor a no-show,
+    for a cancelled appointment without a `cancelled_at`, and for a naive `cancelled_at`.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no fee for appointment {appointment.id} with status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled_at is required for a cancelled appointment")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..4b841ef
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,61 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 10, 9)
+
+    def test_late_cancellation_is_half_price(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9, 1)), 3500)
+
+    def test_late_cancellation_assessment_is_half_price(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 0)), 4750)
+
+    def test_cancellation_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9)), 0)
+
+    def test_cancellation_with_plenty_of_notice_is_free(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 9)), 0)
+
+    def test_cancellation_after_start_is_late(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 10)), 3500)
+
+    def test_window_compares_absolute_times_across_time_zones(self):
+        nz = datetime.timezone(datetime.timedelta(hours=13))
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        # 2027-03-08 22:00 UTC is 2027-03-09 11:00 NZDT: 46 hours before the start, so late.
+        self.assertEqual(cancellation_fee(a, datetime.datetime(2027, 3, 9, 11, tzinfo=nz)), 3500)
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", self.start, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+        self.assertEqual(cancellation_fee(appt("a2", self.start, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+
+    def test_cancelled_requires_time(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, None)
+
+    def test_cancelled_time_must_be_aware(self):
+        a = appt("a1", self.start, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 8, 9))
+
+    def test_no_fee_for_other_statuses(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                a = appt("a1", self.start, status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a, utc(2027, 3, 9, 9))
+
+
+if __name__ == "__main__":
+    unittest.main()
