+"""Monthly export of invoices for the accountants (Tui Accounting, imported into Xero by Mere).
+
+Format rules from Mere: CSV with a header row, dates as DD/MM/YYYY, amounts as plain
+dollars with two decimal places, and the file name kestrel-invoices-YYYY-MM.csv.
+The file leaves the system, so it carries the patient id only, never the patient's name.
+"""
+
+import csv
+import io
+import decimal
+import os
+
+from .storage import _write_atomic
+
+COLUMNS = ["Invoice Number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to out_dir and return the path of the file.
+
+    Invoices are matched on their issue date (the clinic's local date). The file is always
+    written, with just the header row if no invoices were issued that month.
+    """
+    selected = [i for i in invoices if i.issued.year == year and i.issued.month == month]
+
+    buffer = io.StringIO()
+    writer = csv.writer(buffer, lineterminator="\n")
+    writer.writerow(COLUMNS)
+    for invoice in selected:
+        writer.writerow([
+            invoice.number,
+            invoice.clinic,
+            invoice.patient_id,
+            invoice.issued.strftime("%d/%m/%Y"),
+            invoice.description,
+            _dollars(invoice.amount_cents),
+        ])
+
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    _write_atomic(path, buffer.getvalue())
+    return path
+
+
+def _dollars(cents):
+    """Cents as a plain dollar amount with two decimal places, e.g. 9500 -> "95.00"."""
+    return f"{decimal.Decimal(cents) / 100:.2f}"
