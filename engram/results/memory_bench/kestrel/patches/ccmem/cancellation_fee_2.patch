+"""Cancellation and no-show fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation this close to the start (or later) is a late cancellation.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for an appointment that was cancelled or missed.
+
+    For a cancelled appointment, `cancelled_at` is when the patient cancelled
+    (timezone-aware). Cancelling less than 48 hours before the start is a late
+    cancellation and costs 50% of the session price; earlier is free.
+
+    For a no-show, `cancelled_at` must be None and the full session price is charged.
+
+    Raises ValueError for any other status, or for a cancelled appointment
+    without `cancelled_at`.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError("a no-show has no cancellation time")
+        return price
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            raise ValueError(f"cancelled appointment {appointment.id} needs a cancellation time")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancellation time must be timezone-aware")
+        if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+            return price // 2
+        return 0
+    raise ValueError(f"no cancellation fee for appointment {appointment.id} with status {appointment.status!r}")
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..b586d01
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,63 @@
+import datetime
+import unittest
+import zoneinfo
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW, Appointment
+
+START = datetime.datetime(2026, 10, 20, 9, 0, tzinfo=datetime.timezone.utc)
+
+
+def appointment(kind=FOLLOWUP, status=CANCELLED):
+    return Appointment(id="A1", patient_id="KP-004211", therapist_id="T1", clinic="NG",
+                       start=START, kind=kind, status=status)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        at = START - datetime.timedelta(hours=49)
+        self.assertEqual(cancellation_fee(appointment(), at), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        at = START - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(appointment(), at), 0)
+
+    def test_cancelled_inside_48_hours_is_half_price(self):
+        at = START - datetime.timedelta(hours=47, minutes=59)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), at), 3500)
+        self.assertEqual(cancellation_fee(appointment(ASSESSMENT), at), 4750)
+
+    def test_cancelled_after_start_is_half_price(self):
+        at = START + datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), at), 3500)
+
+    def test_window_is_compared_across_time_zones(self):
+        # 2026-10-18 22:01 in Auckland is 2026-10-18 09:01 UTC, under 48 hours before 2026-10-20 09:00 UTC.
+        at = datetime.datetime(2026, 10, 18, 22, 1, tzinfo=zoneinfo.ZoneInfo("Pacific/Auckland"))
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP), at), 3500)
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appointment(FOLLOWUP, NO_SHOW)), 7000)
+        self.assertEqual(cancellation_fee(appointment(ASSESSMENT, NO_SHOW)), 9500)
+
+    def test_no_show_with_cancellation_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(FOLLOWUP, NO_SHOW), START)
+
+    def test_cancelled_without_cancellation_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(FOLLOWUP, CANCELLED))
+
+    def test_naive_cancellation_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment(FOLLOWUP, CANCELLED), datetime.datetime(2026, 10, 18, 10, 0))
+
+    def test_other_statuses_have_no_fee(self):
+        for status in (BOOKED, ATTENDED):
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appointment(FOLLOWUP, status))
+
+
+if __name__ == "__main__":
+    unittest.main()
