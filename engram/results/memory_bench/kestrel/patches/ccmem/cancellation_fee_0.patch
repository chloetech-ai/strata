+"""Cancellation fees."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for a cancelled or no-show appointment.
+
+    A no-show pays the full session price. A cancellation made less than 48 hours
+    before the start pays 50% of the session price; earlier cancellations pay nothing.
+    `cancelled_at` (timezone-aware) is when the patient cancelled; it is required for
+    a cancelled appointment and must be None for a no-show.
+
+    Raises ValueError for any other status, or a `cancelled_at` that does not fit.
+    """
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError("a no-show has no cancellation time")
+        return session_price(appointment.kind)
+
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for appointment with status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("a cancelled appointment needs its cancellation time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancellation time must be timezone-aware")
+
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return session_price(appointment.kind) // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..6c0c70b
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,58 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, FOLLOWUP, NO_SHOW, CANCELLED
+
+START = utc(2027, 3, 10, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 8, 59)), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9)), 0)
+
+    def test_cancelled_inside_48_hours_is_half_the_session_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 9, 1)), 3500)
+
+    def test_late_cancellation_of_assessment_is_half_its_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 8)), 4750)
+
+    def test_cancelled_after_start_is_charged_as_late(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 10)), 3500)
+
+    def test_no_show_pays_full_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)), 7000)
+        self.assertEqual(cancellation_fee(appt("a2", START, kind=ASSESSMENT, status=NO_SHOW)), 9500)
+
+    def test_no_show_with_a_cancellation_time_is_an_error(self):
+        a = appt("a1", START, status=NO_SHOW)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, utc(2027, 3, 8))
+
+    def test_cancelled_without_a_cancellation_time_is_an_error(self):
+        a = appt("a1", START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancellation_time_is_an_error(self):
+        a = appt("a1", START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, START.replace(tzinfo=None))
+
+    def test_other_statuses_are_an_error(self):
+        for status in [BOOKED, ATTENDED]:
+            with self.subTest(status=status):
+                with self.assertRaises(ValueError):
+                    cancellation_fee(appt("a1", START, status=status), utc(2027, 3, 8))
+
+
+if __name__ == "__main__":
+    unittest.main()
