+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_disjoint_pairs_are_sorted(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 2), (2, 3)]), [(1, 3)])
+
+    def test_contained_pair_does_not_shrink(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_any_order(self):
+        self.assertEqual(merge_busy([(7, 8), (1, 3), (2, 5), (6, 7)]), [(1, 5), (6, 8)])
+
+    def test_does_not_mutate_input(self):
+        pairs = [(3, 4), (1, 2)]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(3, 4), (1, 2)])
+
+
+if __name__ == "__main__":
+    unittest.main()
