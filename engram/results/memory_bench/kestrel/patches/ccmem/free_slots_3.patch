+"""Finding the start times at which a therapist can take a new appointment."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+LENGTHS = {ASSESSMENT: datetime.timedelta(minutes=45), FOLLOWUP: datetime.timedelta(minutes=30)}
+NOTE_GAPS = {ASSESSMENT: datetime.timedelta(minutes=15), FOLLOWUP: datetime.timedelta(0)}
+DAILY_CAP = 8  # the therapists' union limit on patient appointments per day
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (sorted `datetime.time`s) on the Auckland date `day` where a new `kind` appointment fits.
+
+    A slot fits when the appointment, plus the note gap an assessment needs after it, does not overlap any
+    other non-cancelled appointment for the therapist, and the therapist is under the daily cap. The
+    appointment must finish on `day` itself. Cancelled appointments do not block anything.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+
+    live = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+    if sum(1 for a in live if a.start.astimezone(CLINIC_TZ).date() == day) >= DAILY_CAP:
+        return []
+
+    # Each existing appointment occupies its length plus any note gap after it. Compare in UTC so that
+    # daylight-saving changes cannot confuse the intervals.
+    busy = []
+    for a in live:
+        start = a.start.astimezone(UTC)
+        busy.append((start, start + LENGTHS[a.kind] + NOTE_GAPS[a.kind]))
+
+    length = LENGTHS[kind]
+    gap = NOTE_GAPS[kind]
+    next_midnight = (datetime.datetime.combine(day + datetime.timedelta(days=1), datetime.time())
+                     .replace(tzinfo=CLINIC_TZ).astimezone(UTC))
+    midnight = datetime.datetime.combine(day, datetime.time())
+    slots = []
+    for i in range(24 * 60 // 15):
+        naive = midnight + i * STEP
+        start = naive.replace(tzinfo=CLINIC_TZ).astimezone(UTC)
+        if start.astimezone(CLINIC_TZ).replace(tzinfo=None) != naive:
+            continue  # this local time does not exist: it is skipped by a daylight-saving change
+        end = start + length
+        if end > next_midnight:
+            continue
+        if any(start < b_end and b_start < end + gap for b_start, b_end in busy):
+            continue
+        slots.append(naive.time())
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
