@@ -0,0 +1,127 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+DAY = datetime.date(2027, 3, 2)  # NZDT, UTC+13
+THERAPIST = Therapist("T1", "Ana", "HB")
+
+
+def local(hh, mm=0, day=DAY):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_has_every_quarter_hour_the_appointment_fits_in(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(len(slots), 95)  # 00:00 to 23:30; a 30-minute visit at 23:45 would run past midnight
+        self.assertEqual(slots[0], t(0))
+        self.assertEqual(slots[-1], t(23, 30))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_assessment_that_ends_after_midnight_is_not_offered(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(23, 15))  # 23:15 ends at midnight; 23:30 would run past it
+
+    def test_slots_are_local_times_from_the_clinic_zone(self):
+        # 2027-03-01 11:30 UTC is 00:30 on the 2nd in Auckland, so it blocks 00:30 on that day.
+        cal = Calendar([appt("a1", datetime.datetime(2027, 3, 1, 11, 30, tzinfo=datetime.timezone.utc),
+                             therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(t(0, 30), slots)
+        self.assertIn(t(0, 0), slots)
+        self.assertIn(t(1, 0), slots)
+
+    def test_followup_after_followup_needs_no_gap(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)  # ends exactly as the booking starts
+        self.assertNotIn(t(9, 45), slots)
+        self.assertNotIn(t(10), slots)
+        self.assertIn(t(10, 30), slots)  # starts exactly as the booking ends
+
+    def test_assessment_needs_the_gap_after_an_existing_followup(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertIn(t(9), slots)  # 09:00 to 09:45, gap to 10:00
+        self.assertNotIn(t(9, 15), slots)  # would run into the booking at 10:00
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_followup_needs_to_clear_the_gap_after_an_existing_assessment(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind=ASSESSMENT)])  # busy 10:00 to 11:00
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)  # 09:30 to 10:00
+        self.assertNotIn(t(9, 45), slots)
+        self.assertNotIn(t(10, 30), slots)  # inside the notes gap
+        self.assertIn(t(11), slots)
+
+    def test_new_assessment_gap_blocks_a_later_booking(self):
+        # A new assessment at 09:15 would run to 10:00 with its gap to 10:15, so it clashes with the 10:00 booking.
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind=FOLLOWUP)])
+        self.assertNotIn(t(9, 15), free_slots(cal, THERAPIST, DAY, ASSESSMENT))
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", status="cancelled")])
+        self.assertIn(t(10), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_no_show_and_attended_appointments_still_block(self):
+        cal = Calendar([
+            appt("a1", local(10), therapist="T1", status="no_show"),
+            appt("a2", local(12), therapist="T1", status="attended"),
+        ])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(t(10), slots)
+        self.assertNotIn(t(12), slots)
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(10), therapist="T2")])
+        self.assertIn(t(10), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_other_days_do_not_block(self):
+        cal = Calendar([appt("a1", local(10, day=datetime.date(2027, 3, 3)), therapist="T1")])
+        self.assertIn(t(10), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_daily_cap_of_eight_patients(self):
+        booked = [appt(f"a{i}", local(8 + i), therapist="T1") for i in range(7)]  # 08:00 to 14:00, one an hour
+        self.assertNotEqual(free_slots(Calendar(booked), THERAPIST, DAY, FOLLOWUP), [])
+        cal = Calendar(booked + [appt("a7", local(15), therapist="T1")])
+        self.assertEqual(free_slots(cal, THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_cap_counts_only_this_therapists_appointments_on_this_day(self):
+        cal = Calendar(
+            [appt(f"a{i}", local(8 + i), therapist="T2") for i in range(8)]
+            + [appt("b1", local(8, day=datetime.date(2027, 3, 3)), therapist="T1")]
+        )
+        self.assertNotEqual(free_slots(cal, THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        cal = Calendar(
+            [appt(f"a{i}", local(8 + i), therapist="T1") for i in range(7)]
+            + [appt("c1", local(15), therapist="T1", status="cancelled")]
+        )
+        self.assertNotEqual(free_slots(cal, THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_daylight_saving_gap_has_no_slot_for_the_missing_hour(self):
+        # Auckland springs forward from 02:00 to 03:00 on 2027-09-26, so 02:00 to 02:45 do not exist that day.
+        spring = datetime.date(2027, 9, 26)
+        slots = free_slots(Calendar(), THERAPIST, spring, FOLLOWUP)
+        self.assertNotIn(t(2, 0), slots)
+        self.assertNotIn(t(2, 30), slots)
+        self.assertIn(t(1, 30), slots)
+        self.assertIn(t(3, 0), slots)
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "consult")
+
+
+if __name__ == "__main__":
+    unittest.main()
