@@ -0,0 +1,97 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+DAY = datetime.date(2027, 3, 2)  # NZDT, UTC+13
+THERAPIST = Therapist("T1", "Test Therapist", "HB")
+
+
+def local(hh, mm=0):
+    """The UTC instant of clinic-local time hh:mm on DAY, for `appt`."""
+    return datetime.datetime.combine(DAY, datetime.time(hh, mm), tzinfo=CLINIC_TZ).astimezone(datetime.timezone.utc)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_followup_starts_every_quarter_hour(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(len(slots), 95)  # 00:00 to 23:30 inclusive
+        self.assertEqual(slots[0], t(0))
+        self.assertEqual(slots[-1], t(23, 30))
+
+    def test_empty_day_assessment_must_finish_before_midnight(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(23, 15))
+        self.assertEqual(len(slots), 94)  # 00:00 to 23:15 inclusive
+
+    def test_results_are_sorted_times(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) for s in slots))
+
+    def test_booked_followup_blocks_its_half_hour(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(t(9), slots)
+        self.assertNotIn(t(8, 45), slots)
+        self.assertIn(t(8, 30), slots)  # 08:30-09:00 fits before it
+        self.assertIn(t(9, 30), slots)  # no gap after a follow-up
+
+    def test_assessment_needs_note_gap_after_it(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1", kind=ASSESSMENT)])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        # Busy 09:00-10:00 (45 minutes plus the 15-minute gap).
+        self.assertNotIn(t(9, 45), slots)
+        self.assertIn(t(10), slots)
+        self.assertNotIn(t(8, 45), slots)  # a follow-up at 08:45 would run into 09:00
+        self.assertIn(t(8, 30), slots)
+
+    def test_new_assessment_needs_its_own_gap_free(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        # 09:15 would end at 10:00 and then need the gap until 10:15, which runs into the follow-up.
+        self.assertNotIn(t(9, 15), slots)
+        self.assertIn(t(9), slots)  # 09:00-09:45, gap 09:45-10:00
+
+    def test_cancelled_appointment_frees_its_time(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1", status="cancelled")])
+        self.assertIn(t(9), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(9), therapist="T2")])
+        self.assertIn(t(9), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_appointment_from_previous_day_running_past_midnight_blocks(self):
+        # Assessment at 23:30 on the 1st holds the therapist until 00:15 on the 2nd.
+        cal = Calendar([appt("a1", local(23, 30) - datetime.timedelta(days=1), therapist="T1", kind=ASSESSMENT)])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(t(0), slots)
+        self.assertNotIn(t(0, 15), slots)
+        self.assertIn(t(0, 30), slots)
+
+    def test_daily_cap_of_eight_patients(self):
+        booked = [appt(f"a{i}", local(8 + i), therapist="T1") for i in range(7)]
+        self.assertNotEqual(free_slots(Calendar(booked), THERAPIST, DAY, FOLLOWUP), [])
+        booked.append(appt("a7", local(16), therapist="T1"))
+        self.assertEqual(free_slots(Calendar(booked), THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        booked = [appt(f"a{i}", local(8 + i), therapist="T1") for i in range(7)]
+        booked.append(appt("a7", local(16), therapist="T1", status="cancelled"))
+        self.assertNotEqual(free_slots(Calendar(booked), THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
