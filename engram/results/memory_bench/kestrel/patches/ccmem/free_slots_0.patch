+"""Free appointment slots for a therapist on a local (clinic) date."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+DURATION = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+NOTE_GAP = datetime.timedelta(minutes=15)  # the therapist's notes time after an assessment
+STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+DAILY_CAP = 8  # the therapists' union cap on patient appointments per day
+UTC = datetime.timezone.utc
+
+
+def _holds(kind):
+    """How long an appointment of `kind` keeps its therapist busy, including the note gap after an assessment."""
+    return DURATION[kind] + (NOTE_GAP if kind == ASSESSMENT else datetime.timedelta(0))
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) at which a new appointment of `kind` could be booked.
+
+    A slot is free when the new appointment and its note gap (if it is an assessment) overlap no
+    non-cancelled appointment of the therapist's, and the therapist is under the daily cap of 8 on `day`.
+    Appointments that run over midnight from the day before still count. Cancelled ones do not.
+    The search covers the whole local day; clinic hours are not in the data yet.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+
+    midnight = datetime.datetime.combine(day, datetime.time(), tzinfo=CLINIC_TZ)
+    next_midnight = datetime.datetime.combine(day + datetime.timedelta(days=1), datetime.time(), tzinfo=CLINIC_TZ)
+
+    today = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(today) >= DAILY_CAP:
+        return []
+
+    holds = []
+    for a in calendar.for_therapist(therapist.id):
+        if a.status == CANCELLED:
+            continue
+        start = a.start.astimezone(UTC)
+        holds.append((start, start + _holds(a.kind)))
+
+    new_hold = _holds(kind)
+    times = []
+    slot = midnight
+    while slot + DURATION[kind] <= next_midnight:
+        slot_utc = slot.astimezone(UTC)
+        slot_end = slot_utc + new_hold
+        if not any(start < slot_end and slot_utc < end for start, end in holds):
+            times.append(slot.time())
+        slot += STEP  # wall-clock step in the clinic zone
+    return times
diff --git a/tests/test_slots.py b/tests/test_slots.py
