+def next_invoice_number(clinic, year, existing):
+    """The next invoice number for a clinic in a year, like INV-HB-2026-00001.
+
+    `existing` is every invoice number issued so far, for any clinic and year.
+    Numbers after the highest one already issued for this clinic and year are
+    used, so a gap is never refilled. Numbers in other formats are ignored.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-(\d{{5}})")
+    issued = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    return f"INV-{clinic}-{year}-{max(issued, default=0) + 1:05d}"
+
