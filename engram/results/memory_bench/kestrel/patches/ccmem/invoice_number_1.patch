+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_highest_number_for_clinic_and_year(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00007"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_ignores_other_clinics_and_years(self):
+        existing = ["INV-HB-2025-00009", "INV-WG-2026-00012", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00004")
+
+    def test_clinic_code_is_matched_exactly(self):
+        existing = ["INV-HBX-2026-00005"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_ignores_numbers_in_other_formats(self):
+        existing = ["N1", "INV-HB-2026-1", "INV-HB-2026-00002-x"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_does_not_refill_gaps(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00004")
+
+
