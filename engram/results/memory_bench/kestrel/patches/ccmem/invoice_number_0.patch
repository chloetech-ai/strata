     description: str = ""
 
 
+def next_invoice_number(clinic, year, existing):
+    """The number for the next invoice from a clinic in a year.
+
+    Numbers look like INV-HB-2026-00001: the clinic code, the year, then a
+    sequence that counts up per clinic per year. `existing` is every invoice
+    number issued so far, from any clinic and year; ones that do not match
+    this clinic and year are ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        if number.startswith(prefix) and number[len(prefix):].isdigit():
+            highest = max(highest, int(number[len(prefix):]))
+    return f"{prefix}{highest + 1:05d}"
+
+
