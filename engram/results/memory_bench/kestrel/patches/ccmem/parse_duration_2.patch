+++ b/src/kestrel/intervals.py
@@ -0,0 +1,19 @@
+"""Parsing for hand-typed durations."""
+
+import re
+
+_DURATION = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?|([0-9]+)m")
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes.
+
+    Raises ValueError if the text is not a duration.
+    """
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hours, minutes_alone = match.groups()
+    if minutes_alone is not None:
+        return int(minutes_alone)
+    return int(hours) * 60 + int(minutes_after_hours or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..a3d4eda
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,26 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes(self):
+        for raw in ["1h30", "1h30m", "1h 30m", "1h 30", " 1h 30m\n"]:
+            with self.subTest(raw=raw):
+                self.assertEqual(parse_duration(raw), 90)
+
+    def test_rejects_other_text(self):
+        for raw in ["", "45", "h", "m", "1hm", "1h30s", "1.5h", "-45m", "45 m", "1 h", "1h30m5", "forty-five minutes"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
