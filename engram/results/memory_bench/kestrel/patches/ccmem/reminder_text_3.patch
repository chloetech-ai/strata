diff --git a/src/kestrel/reminders.py b/src/kestrel/reminders.py
new file mode 100644
index 0000000..6e9aba3
--- /dev/null
+++ b/src/kestrel/reminders.py
@@ -0,0 +1,18 @@
+"""Text of the SMS reminders sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS reminder for an appointment, in clinic (Auckland) local time.
+
+    Per the privacy rules, the text gives only the date, the time and the clinic's
+    name. It never names the patient or the treatment.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return f"Kia ora! This is a friendly reminder from {clinic}: you have an appointment on {when}. We look forward to seeing you!"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..68cfaf3
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,47 @@
+import datetime
+import unittest
+
+from kestrel.calendar import CLINIC_TZ
+from kestrel.models import ASSESSMENT, Patient
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+PATIENT = Patient(id="KP-004211", name="Aroha Test", phone="+64211234567")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 21:30 UTC on 14 Oct is 10:30 on 15 Oct in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 14, 21, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October at 10:30am", text)
+
+    def test_afternoon_time_uses_pm_and_12_hour_clock(self):
+        # 02:15 UTC is 15:15 in Auckland.
+        a = appt("A1", utc(2026, 10, 15, 2, 15), clinic="NG")
+        self.assertIn("at 3:15pm", reminder_text(a))
+
+    def test_midday_and_midnight_hours(self):
+        noon = appt("A1", datetime.datetime(2026, 10, 15, 12, 0, tzinfo=CLINIC_TZ))
+        midnight = appt("A2", datetime.datetime(2026, 10, 15, 0, 5, tzinfo=CLINIC_TZ))
+        self.assertIn("at 12:00pm", reminder_text(noon))
+        self.assertIn("at 12:05am", reminder_text(midnight))
+
+    def test_uses_clinic_of_the_appointment(self):
+        for code, name in [("NG", "Northgate"), ("HB", "Harbour"), ("WK", "Westwick")]:
+            text = reminder_text(appt("A1", utc(2026, 10, 15, 2, 0), clinic=code))
+            self.assertIn(f"Kestrel Physio {name}", text)
+
+    def test_patient_name_and_treatment_are_kept_out(self):
+        a = appt("A1", utc(2026, 10, 15, 2, 0), patient=PATIENT.id, kind=ASSESSMENT, treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("Aroha", text)
+        self.assertNotIn(PATIENT.id, text)
+        self.assertNotIn("lower back", text)
+        self.assertNotIn("assessment", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
