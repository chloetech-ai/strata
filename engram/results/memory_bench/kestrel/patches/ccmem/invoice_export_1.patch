+"""Exports for the accountants."""
+
+import csv
+import datetime
+import io
+import os
+from decimal import Decimal
+
+from .storage import _write_atomic
+
+# Columns for the Xero import (Mere at Tui Accounting). Patient names are never exported, see the privacy rules.
+COLUMNS = ["Invoice number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to kestrel-invoices-YYYY-MM.csv in out_dir. Returns its path.
+
+    The file has a header row, dates as DD/MM/YYYY and amounts with two decimal places. Invoices are matched on
+    their issue date (the clinic's local date). A month with no invoices gives a file with just the header row.
+    The patient's name is not written, even if an invoice carries one.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    buffer = io.StringIO()
+    writer = csv.writer(buffer, lineterminator="\n")
+    writer.writerow(COLUMNS)
+    for invoice in chosen:
+        writer.writerow([
+            invoice.number,
+            invoice.clinic,
+            invoice.patient_id,
+            _date(invoice.issued),
+            invoice.description,
+            _amount(invoice.amount_cents),
+        ])
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    _write_atomic(path, buffer.getvalue())
+    return path
+
+
+def _date(day):
+    return day.strftime("%d/%m/%Y")
+
+
+def _amount(cents):
+    return f"{Decimal(cents) / 100:.2f}"
