@@ -0,0 +1,87 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-004211", patient_name="", description="Physiotherapy assessment"):
+    return Invoice(
+        number=number, clinic="HB", patient_id=patient_id, patient_name=patient_name,
+        issued=issued, amount_cents=amount_cents, description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, encoding="utf-8", newline="") as f:
+            return list(csv.reader(f))
+
+    def test_writes_only_the_requested_month_to_named_file(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 11, 1)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        rows = self.read_rows(path)
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00001"])
+
+    def test_header_row_comes_first(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        rows = self.read_rows(path)
+        self.assertEqual(rows[0], ["Invoice number", "Clinic", "Patient ID", "Date", "Description", "Amount"])
+
+    def test_dates_are_day_first(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][3], "03/10/2026")
+
+    def test_amounts_have_two_decimal_places(self):
+        invoices = [
+            invoice("N1", datetime.date(2026, 10, 3), amount_cents=9500),
+            invoice("N2", datetime.date(2026, 10, 3), amount_cents=7000),
+            invoice("N3", datetime.date(2026, 10, 3), amount_cents=5),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[5] for r in rows[1:]], ["95.00", "70.00", "0.05"])
+
+    def test_patient_name_is_never_written(self):
+        invoices = [invoice("N1", datetime.date(2026, 10, 3), patient_name="Aroha Test", description="Physiotherapy follow-up")]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertNotIn("Aroha", text)
+        self.assertIn("KP-004211", text)
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-2", datetime.date(2026, 10, 9)),
+            invoice("INV-3", datetime.date(2026, 10, 2)),
+            invoice("INV-1", datetime.date(2026, 10, 9)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-3", "INV-1", "INV-2"])
+
+    def test_month_with_no_invoices_has_only_the_header(self):
+        path = export_invoices([invoice("N1", datetime.date(2026, 9, 1))], 2026, 10, self.out_dir)
+        self.assertEqual(len(self.read_rows(path)), 1)
+
+    def test_overwrites_an_existing_export(self):
+        export_invoices([invoice("OLD", datetime.date(2026, 10, 1))], 2026, 10, self.out_dir)
+        path = export_invoices([invoice("NEW", datetime.date(2026, 10, 1))], 2026, 10, self.out_dir)
+        self.assertEqual([r[0] for r in self.read_rows(path)[1:]], ["NEW"])
+
+
+if __name__ == "__main__":
+    unittest.main()
