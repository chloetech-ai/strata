+++ b/src/kestrel/reminders.py
@@ -0,0 +1,31 @@
+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment.
+
+    Privacy rule: only the date, the time and the clinic name. No patient name
+    and no treatment, since SMS can be seen or forwarded by others.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: you have an appointment at {clinic} on {local:%d/%m/%Y} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of every booked appointment.
+
+    `patients` maps patient ID to Patient. Messages are all built before any
+    is sent, so a missing patient stops the run before anything goes out.
+    Returns the number of messages sent.
+    """
+    messages = [
+        (patients[a.patient_id].phone, reminder_text(a))
+        for a in appointments
+        if a.status == BOOKED
+    ]
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..0421bac
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,83 @@
+import unittest
+
+from kestrel.models import CANCELLED, NO_SHOW, ATTENDED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Alice Example", "+64211111111", False),
+    "KP-000002": Patient("KP-000002", "Bob Example", "+64222222222", True),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key", self.transport)
+
+    def sent(self):
+        return [(m["to"], m["text"]) for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_one_sms_per_booked_appointment(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 16, 1, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 16, 2, 0), patient="KP-000002"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 2)
+        self.assertEqual([to for to, _ in self.sent()], ["+64211111111", "+64222222222"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 16, 1, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 16, 2, 0), patient="KP-000002", status=CANCELLED),
+            appt("A3", utc(2026, 10, 16, 3, 0), patient="KP-000002", status=ATTENDED),
+            appt("A4", utc(2026, 10, 16, 4, 0), patient="KP-000002", status=NO_SHOW),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 1)
+        self.assertEqual(len(self.sent()), 1)
+
+    def test_no_booked_appointments_sends_nothing(self):
+        self.assertEqual(send_reminders([], PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_missing_patient_sends_nothing(self):
+        appointments = [
+            appt("A1", utc(2026, 10, 16, 1, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 16, 2, 0), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_text_has_date_time_and_clinic_only(self):
+        # 2026-10-16 01:30 UTC is 14:30 NZDT, Friday 16 October.
+        a = appt("A1", utc(2026, 10, 16, 1, 30), patient="KP-000001", clinic="HB", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertIn("16/10/2026", text)
+        self.assertIn("14:30", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertNotIn("Alice", text)
+        self.assertNotIn("KP-000001", text)
+        self.assertNotIn("lower back pain", text)
+
+    def test_text_uses_clinic_local_date(self):
+        # 2026-10-15 12:00 UTC is already 16 October in Auckland.
+        a = appt("A1", utc(2026, 10, 15, 12, 0), patient="KP-000001", clinic="NG")
+        self.assertIn("16/10/2026", reminder_text(a))
+        self.assertIn("Northgate", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
