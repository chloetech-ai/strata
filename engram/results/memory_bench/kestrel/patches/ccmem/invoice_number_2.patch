+def next_invoice_number(clinic, year, existing):
+    """The next invoice number for a clinic in a year, such as 'INV-HB-2026-00002'.
+
+    Numbers look like INV-<clinic>-<year>-<five-digit sequence>. The sequence
+    counts per clinic and year, so only `existing` numbers for this clinic and
+    year count; the rest are ignored. The first invoice of a year is 00001.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year:04d}-(\d{{5}})")
+    sequences = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    return f"INV-{clinic}-{year:04d}-{max(sequences, default=0) + 1:05d}"
+
