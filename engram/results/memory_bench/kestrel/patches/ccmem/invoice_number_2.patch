+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_one(self):
+        self.assertEqual(next_invoice_number("HB", 2026, []), "INV-HB-2026-00001")
+
+    def test_follows_the_highest_sequence_not_the_count(self):
+        existing = ["INV-HB-2026-00001", "INV-HB-2026-00007", "INV-HB-2026-00003"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00008")
+
+    def test_ignores_other_clinics_and_years(self):
+        existing = ["INV-WN-2026-00009", "INV-HB-2025-00012", "INV-HB-2027-00020", "INV-HB-2026-00002"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00003")
+        self.assertEqual(next_invoice_number("HB", 2025, existing), "INV-HB-2025-00013")
+
+    def test_ignores_numbers_that_do_not_match_the_format(self):
+        existing = ["INV-HB-2026-0005", "INV-HB-2026-000050", "INV-HBX-2026-00004", "xINV-HB-2026-00006"]
+        self.assertEqual(next_invoice_number("HB", 2026, existing), "INV-HB-2026-00001")
+
+    def test_clinic_code_is_matched_literally(self):
+        self.assertEqual(next_invoice_number("H.B", 2026, ["INV-HXB-2026-00005"]), "INV-H.B-2026-00001")
+
+
 if __name__ == "__main__":
     unittest.main()
