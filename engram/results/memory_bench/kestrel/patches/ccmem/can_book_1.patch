@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+T1 = Therapist("T1", "Ana", "HB")
+NZDT = datetime.timezone(datetime.timedelta(hours=13))  # Auckland in March
+
+
+def local(hh, mm=0, day=1):
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=NZDT)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("n", local(9), therapist="T1")))
+
+    def test_overlap_rejected(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1", kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, T1, appt("n", local(9, 15), therapist="T1")))
+        self.assertFalse(can_book(cal, T1, appt("n", local(8, 45), therapist="T1", kind=ASSESSMENT)))
+
+    def test_back_to_back_followups_allowed(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1", kind=FOLLOWUP)])
+        self.assertTrue(can_book(cal, T1, appt("n", local(9, 30), therapist="T1", kind=FOLLOWUP)))
+
+    def test_gap_after_assessment(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1", kind=ASSESSMENT)])  # busy 09:00-10:00
+        self.assertFalse(can_book(cal, T1, appt("n", local(9, 45), therapist="T1", kind=FOLLOWUP)))
+        self.assertTrue(can_book(cal, T1, appt("n", local(10), therapist="T1", kind=FOLLOWUP)))
+
+    def test_new_assessment_needs_gap_before_next(self):
+        cal = Calendar([appt("a1", local(10), therapist="T1", kind=FOLLOWUP)])
+        self.assertFalse(can_book(cal, T1, appt("n", local(9, 30), therapist="T1", kind=ASSESSMENT)))
+        self.assertTrue(can_book(cal, T1, appt("n", local(9), therapist="T1", kind=ASSESSMENT)))
+
+    def test_cancelled_does_not_block(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1", status=CANCELLED)])
+        self.assertTrue(can_book(cal, T1, appt("n", local(9), therapist="T1")))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", local(9), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("n", local(9), therapist="T1")))
+
+    def test_quarter_hour_start(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("n", local(9, 10), therapist="T1")))
+        self.assertTrue(can_book(Calendar(), T1, appt("n", local(9, 45), therapist="T1")))
+
+    def test_wrong_therapist_rejected(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("n", local(9), therapist="T2")))
+
+    def test_daily_cap(self):
+        existing = [appt(f"a{i}", local(8 + i // 2, 30 * (i % 2)), therapist="T1", patient=f"KP-{i:06d}") for i in range(8)]
+        cal = Calendar(existing)
+        self.assertFalse(can_book(cal, T1, appt("n", local(16), therapist="T1")))
+
+    def test_daily_cap_ignores_cancelled(self):
+        existing = [appt(f"a{i}", local(8 + i // 2, 30 * (i % 2)), therapist="T1") for i in range(7)]
+        existing.append(appt("c", local(14), therapist="T1", status=CANCELLED))
+        self.assertTrue(can_book(Calendar(existing), T1, appt("n", local(16), therapist="T1")))
+
+    def test_daily_cap_is_per_local_day(self):
+        existing = [appt(f"a{i}", local(8 + i // 2, 30 * (i % 2)), therapist="T1") for i in range(8)]
+        self.assertTrue(can_book(Calendar(existing), T1, appt("n", local(9, day=2), therapist="T1")))
+
+
+if __name__ == "__main__":
+    unittest.main()
