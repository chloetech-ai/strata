+"""Booking checks for the booking form."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+LENGTHS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+NOTE_GAP = datetime.timedelta(minutes=15)  # after an assessment, for notes
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per day
+
+
+def _busy_until(appointment):
+    """When the therapist is occupied by `appointment`, including any note gap."""
+    end = appointment.start + LENGTHS[appointment.kind]
+    if appointment.kind == ASSESSMENT:
+        end += NOTE_GAP
+    return end
+
+
+def can_book(calendar, therapist, appointment):
+    """Return True if `appointment` can be added to `calendar` for `therapist`.
+
+    `therapist` is a Therapist (or therapist id string). The checks are: the
+    appointment belongs to this therapist, it starts on a local quarter hour,
+    it does not overlap another booked appointment (including the note gap
+    after an assessment), and the therapist has fewer than DAILY_CAP booked
+    appointments that local day.
+    """
+    therapist_id = getattr(therapist, "id", therapist)
+    if appointment.therapist_id != therapist_id:
+        return False
+
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    new_start = appointment.start
+    new_end = _busy_until(appointment)
+    for existing in calendar.for_therapist(therapist_id):
+        if existing.status != BOOKED:
+            continue
+        if new_start < _busy_until(existing) and existing.start < new_end:
+            return False
+
+    booked_today = [a for a in calendar.for_day(therapist_id, local_start.date()) if a.status == BOOKED]
+    return len(booked_today) < DAILY_CAP
diff --git a/tests/test_booking.py b/tests/test_booking.py
