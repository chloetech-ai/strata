+"""Finding the start times at which a therapist can take a new appointment."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+ASSESSMENT_LENGTH = datetime.timedelta(minutes=45)
+FOLLOWUP_LENGTH = datetime.timedelta(minutes=30)
+LENGTHS = {ASSESSMENT: ASSESSMENT_LENGTH, FOLLOWUP: FOLLOWUP_LENGTH}
+
+START_STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+NOTE_GAP = datetime.timedelta(minutes=15)  # therapist's note time after an assessment
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per local day
+
+_UTC = datetime.timezone.utc
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on `day` (a date in the clinic's timezone) when `therapist`
+    could book a new appointment of `kind`, sorted.
+
+    A slot is free when the new appointment and its note gap fit around every
+    live appointment for the therapist, and the therapist is under the daily cap.
+    Cancelled appointments do not block anything or count towards the cap.
+    """
+    if kind not in LENGTHS:
+        raise ValueError(f"unknown kind {kind!r}")
+
+    live = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+    if sum(1 for a in live if a.start.astimezone(CLINIC_TZ).date() == day) >= DAILY_CAP:
+        return []
+
+    new_length = LENGTHS[kind]
+    new_gap = NOTE_GAP if kind == ASSESSMENT else datetime.timedelta(0)
+    # Existing appointments as (start, end-plus-gap) in UTC, so arithmetic never mixes wall-clock times.
+    busy = []
+    for a in live:
+        start = a.start.astimezone(_UTC)
+        gap = NOTE_GAP if a.kind == ASSESSMENT else datetime.timedelta(0)
+        busy.append((start, start + LENGTHS[a.kind] + gap))
+
+    times = []
+    midnight = datetime.datetime.combine(day, datetime.time(0))
+    step = datetime.timedelta(0)
+    while step < datetime.timedelta(days=1):
+        local = midnight + step
+        step += START_STEP
+        start = local.replace(tzinfo=CLINIC_TZ).astimezone(_UTC)
+        if start.astimezone(CLINIC_TZ).replace(tzinfo=None) != local:
+            continue  # wall-clock time skipped by a daylight saving change
+        end = start + new_length + new_gap
+        if all(end <= busy_start or start >= busy_end for busy_start, busy_end in busy):
+            times.append(local.time())
+    return times
diff --git a/tests/test_slots.py b/tests/test_slots.py
