+"""Text of the SMS reminders sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS, Appointment
+
+
+def reminder_text(appointment: Appointment) -> str:
+    """The SMS for an appointment: its date, time and clinic name, and nothing else.
+
+    SMS can be forwarded or seen by others, so the text never includes the
+    patient's name or the treatment (see the privacy rules).
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    hour = local.hour % 12 or 12
+    period = "am" if local.hour < 12 else "pm"
+    day = f"{local.strftime('%A')} {local.day} {local.strftime('%B')}"
+    time = f"{hour}:{local.minute:02d}{period}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora! This is a friendly reminder of your physio appointment at {clinic} "
+        f"on {day} at {time}. We look forward to seeing you. "
+        f"Please call us if you can't make it."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..d990a32
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,40 @@
+import unittest
+
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_clinic_date_and_time_in_auckland_time(self):
+        # 02:30 UTC on 16 Oct is 15:30 on 16 Oct in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 16, 2, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Friday 16 October at 3:30pm", text)
+
+    def test_morning_time_uses_am_and_no_hour_zero(self):
+        # 20:05 UTC on 15 Oct is 09:05 on 16 Oct in Auckland.
+        a = appt("A1", utc(2026, 10, 15, 20, 5), clinic="NG")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Northgate", text)
+        self.assertIn("Friday 16 October at 9:05am", text)
+
+    def test_midnight_is_twelve_am(self):
+        # 11:00 UTC on 15 Oct is 00:00 on 16 Oct in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 15, 11, 0), clinic="WK")
+        self.assertIn("at 12:00am", reminder_text(a))
+
+    def test_patient_name_and_treatment_are_kept_out(self):
+        a = appt("A1", utc(2026, 10, 16, 2, 30), patient="KP-004211", clinic="HB",
+                 kind=ASSESSMENT, treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("KP-004211", text)
+        self.assertNotIn("Aroha", text)
+        self.assertNotIn("lower back", text)
+        self.assertNotIn("assessment", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
