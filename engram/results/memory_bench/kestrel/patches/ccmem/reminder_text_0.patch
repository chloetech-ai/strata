+"""Text of the reminder SMS sent two days before an appointment."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the SMS body for `appointment`.
+
+    Privacy: the text carries only the date, the time and the clinic's name.
+    It never includes the patient's name or what the appointment is for.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    day = f"{local:%A} {local.day} {local:%B}"
+    clock = f"{local.hour % 12 or 12}:{local.minute:02d}{'am' if local.hour < 12 else 'pm'}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi, this is a friendly reminder of your appointment at {clinic} "
+        f"on {day} at {clock}. We look forward to seeing you!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..fa13906
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,46 @@
+import datetime
+import unittest
+
+from kestrel.calendar import CLINIC_TZ
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_date_time_and_clinic_name(self):
+        # 2026-10-22 09:30 Auckland time is NZDT (UTC+13) in October.
+        start = utc(2026, 10, 21, 20, 30)
+        text = reminder_text(appt("A1", start, clinic="HB"))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 22 October", text)
+        self.assertIn("9:30am", text)
+
+    def test_afternoon_time_uses_pm_and_12_hour_clock(self):
+        start = datetime.datetime(2026, 10, 22, 13, 15, tzinfo=CLINIC_TZ)
+        text = reminder_text(appt("A1", start, clinic="NG"))
+        self.assertIn("1:15pm", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_midnight_and_noon_read_correctly(self):
+        midnight = datetime.datetime(2026, 10, 22, 0, 5, tzinfo=CLINIC_TZ)
+        noon = datetime.datetime(2026, 10, 22, 12, 0, tzinfo=CLINIC_TZ)
+        self.assertIn("12:05am", reminder_text(appt("A1", midnight)))
+        self.assertIn("12:00pm", reminder_text(appt("A2", noon)))
+
+    def test_uses_clinic_local_date_not_utc_date(self):
+        # 2026-10-21 23:30 UTC is already 22 October in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 21, 23, 30)))
+        self.assertIn("Thursday 22 October", text)
+        self.assertIn("12:30pm", text)
+
+    def test_leaves_out_patient_name_and_treatment(self):
+        start = utc(2026, 10, 21, 20, 30)
+        a = appt("A1", start, patient="KP-004211", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("KP-004211", text)
+        self.assertNotIn("lower back", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
