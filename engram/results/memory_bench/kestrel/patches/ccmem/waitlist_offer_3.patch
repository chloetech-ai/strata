diff --git a/CHANGELOG.md b/CHANGELOG.md
index b0609c1..84dcecd 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -14,7 +14,7 @@
 - `BulkieClient.send_batch` sends at most 50 messages per call, because Bulkie rejects a whole call that has more.
 - `models.py` uses `Optional` instead of `X | None`, so the package imports on Python 3.9.
 - `python -m kestrel day THERAPIST_ID DATE --data kestrel.json` prints a therapist's appointments on a local date: time, kind and patient ID, one per line. Cancelled and other non-booked appointments are listed too, without their status.
-- `Waitlist` holds `WaitlistEntry(patient_id, kind, requested_at, urgent=False)` records. `entries()` lists urgent entries first, then the rest in request order. Offering freed slots is not built yet.
+- `Waitlist` holds `WaitlistEntry(patient_id, kind, requested_at, urgent=False)` records. `entries()` lists urgent entries first, then the rest in request order. `next_for(kind)` returns the entry to offer a freed slot of that kind to, or `None` if nobody is waiting for it. It does not remove the entry; call `remove` once the slot is taken.
 - `Calendar.cancel(appointment_id, at)` cancels a booked appointment and records `cancelled_at`.
 - `Calendar.move(appointment_id, new_start)` reschedules a booked appointment. Cancelled and other non-booked appointments cannot be moved.
 - `make_invoice(appointment, patient, number, amount_cents)` builds an `Invoice` dated the appointment's local date. The patient name is left out, as the privacy rules require for files that leave the system.
diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index 75dfe7d..befe928 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -37,3 +37,12 @@ class Waitlist:
     def entries(self):
         """Urgent entries first, then the rest; each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it."""
+        if kind not in KINDS:
+            raise ValueError(f"unknown kind {kind!r}")
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 2394b65..3923c72 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -70,3 +70,33 @@ class WaitlistTest(unittest.TestCase):
 
     def test_empty(self):
         self.assertEqual(Waitlist().entries(), [])
+
+    def test_next_for_picks_first_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(WaitlistEntry("KP-000001", FOLLOWUP, utc(2027, 3, 1, 9)))
+        wl.add(WaitlistEntry("KP-000002", ASSESSMENT, utc(2027, 3, 1, 8)))
+        wl.add(WaitlistEntry("KP-000003", FOLLOWUP, utc(2027, 3, 1, 10)))
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000001")
+        self.assertEqual(wl.next_for(ASSESSMENT).patient_id, "KP-000002")
+
+    def test_next_for_prefers_urgent(self):
+        wl = Waitlist()
+        wl.add(WaitlistEntry("KP-000001", FOLLOWUP, utc(2027, 3, 1, 9)))
+        wl.add(WaitlistEntry("KP-000002", FOLLOWUP, utc(2027, 3, 1, 10), urgent=True))
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000002")
+
+    def test_next_for_none_when_nobody_waits_for_that_kind(self):
+        wl = Waitlist()
+        wl.add(WaitlistEntry("KP-000001", FOLLOWUP, utc(2027, 3, 1, 9)))
+        self.assertIsNone(wl.next_for(ASSESSMENT))
+        self.assertIsNone(Waitlist().next_for(FOLLOWUP))
+
+    def test_next_for_does_not_remove_entry(self):
+        wl = Waitlist()
+        wl.add(WaitlistEntry("KP-000001", FOLLOWUP, utc(2027, 3, 1, 9)))
+        wl.next_for(FOLLOWUP)
+        self.assertEqual(len(wl.entries()), 1)
+
+    def test_next_for_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            Waitlist().next_for("massage")
