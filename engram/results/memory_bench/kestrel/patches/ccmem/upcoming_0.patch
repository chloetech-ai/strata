diff --git a/src/kestrel/calendar.py b/src/kestrel/calendar.py
index 3c4ed58..3349b3e 100644
--- a/src/kestrel/calendar.py
+++ b/src/kestrel/calendar.py
@@ -66,5 +66,11 @@ class Calendar:
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now` (timezone-aware), soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        return [a for a in self.for_patient(patient_id) if a.status == BOOKED and a.start > now]
+
     def __len__(self):
         return len(self._appointments)
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index 9e07db3..2fb67b4 100644
--- a/tests/test_calendar.py
+++ b/tests/test_calendar.py
@@ -49,6 +49,34 @@ class CalendarTest(unittest.TestCase):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
 
+    def test_upcoming_booked_after_now_soonest_first(self):
+        now = utc(2027, 3, 1, 12)
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 3, 9), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 2, 9), patient="KP-000001"),
+            appt("a3", utc(2027, 3, 1, 11), patient="KP-000001"),   # before now
+            appt("a4", utc(2027, 3, 1, 12), patient="KP-000001"),   # exactly now, not after
+            appt("a5", utc(2027, 3, 2, 9), patient="KP-000002"),    # other patient
+            appt("a6", utc(2027, 3, 4, 9), patient="KP-000001", status="cancelled"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["a2", "a1"])
+
+    def test_upcoming_accepts_typed_ids(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 1, 12))], ["a1"])
+
+    def test_upcoming_compares_instants_across_zones(self):
+        # `now` is 2027-03-01 23:00 at UTC+12, i.e. 11:00 UTC, so a 11:30 UTC start is still upcoming
+        # even though its wall-clock hour (23:30 at UTC+12) is not the same as `now`'s.
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 11, 30), patient="KP-000001")])
+        now = datetime.datetime(2027, 3, 1, 23, 0, tzinfo=datetime.timezone(datetime.timedelta(hours=12)))
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", now)], ["a1"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-000001")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-000001", datetime.datetime(2027, 3, 1, 12))
+
     def test_cancel_sets_status_and_time(self):
         cal = Calendar([appt("a1", utc(2027, 3, 1, 20))])
         returned = cal.cancel("a1", utc(2027, 2, 28, 9))
