+def next_invoice_number(clinic, year, existing):
+    """The next invoice number for a clinic in a year, such as INV-HB-2026-00002.
+
+    `existing` is every invoice number issued so far, for any clinic and year.
+    Only numbers with this clinic's code and this year count; others are ignored.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year}-(\d+)")
+    highest = 0
+    for number in existing:
+        match = pattern.fullmatch(number)
+        if match:
+            highest = max(highest, int(match.group(1)))
+    return f"INV-{clinic}-{year}-{highest + 1:05d}"
+
