+"""Monthly invoice export for the accountants (imported into Xero)."""
+
+import csv
+import os
+
+COLUMNS = ["InvoiceNumber", "InvoiceDate", "Clinic", "PatientID", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in the given month to kestrel-invoices-YYYY-MM.csv in out_dir.
+
+    Returns the path of the file written. Dates are DD/MM/YYYY and amounts are dollars to two decimal places.
+    Patient names are never written (only the patient id), per the privacy rules.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(COLUMNS)
+        for i in month_invoices:
+            writer.writerow([
+                i.number,
+                i.issued.strftime("%d/%m/%Y"),
+                i.clinic,
+                i.patient_id,
+                i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
