@@ -0,0 +1,21 @@
+"""Text of the reminder SMS sent two days before an appointment."""
+
+from kestrel.models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the SMS text for an appointment.
+
+    Only the date, time and clinic name go in the message. The patient's
+    name and the treatment are left out (privacy rule from Aroha Ngata).
+    """
+    start = appointment.start
+    hour = start.hour % 12 or 12
+    meridiem = "am" if start.hour < 12 else "pm"
+    date = f"{start:%A} {start.day} {start:%B}"
+    time = f"{hour}:{start.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! Friendly reminder of your appointment on {date} at {time}. "
+        "We look forward to seeing you. Need to change it? Just get in touch with the clinic."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..dce1d1d
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,56 @@
+import datetime
+import unittest
+
+from kestrel.models import Appointment, ASSESSMENT
+from kestrel.reminders import reminder_text
+
+NZ = datetime.timezone(datetime.timedelta(hours=13))
+
+
+def appointment(start, clinic="HB", treatment="lower back pain"):
+    return Appointment(
+        id="A-1",
+        patient_id="KP-004211",
+        therapist_id="T-1",
+        clinic=clinic,
+        start=start,
+        kind=ASSESSMENT,
+        treatment=treatment,
+    )
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_includes_date_time_and_clinic(self):
+        text = reminder_text(appointment(datetime.datetime(2026, 10, 17, 9, 30, tzinfo=NZ)))
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Saturday 17 October", text)
+        self.assertIn("9:30am", text)
+
+    def test_afternoon_time(self):
+        text = reminder_text(appointment(datetime.datetime(2026, 10, 17, 14, 15, tzinfo=NZ)))
+        self.assertIn("at 2:15pm", text)
+
+    def test_midnight_and_noon(self):
+        midnight = reminder_text(appointment(datetime.datetime(2026, 10, 17, 0, 0, tzinfo=NZ)))
+        noon = reminder_text(appointment(datetime.datetime(2026, 10, 17, 12, 0, tzinfo=NZ)))
+        self.assertIn("at 12:00am", midnight)
+        self.assertIn("at 12:00pm", noon)
+
+    def test_day_has_no_leading_zero(self):
+        text = reminder_text(appointment(datetime.datetime(2026, 10, 5, 10, 0, tzinfo=NZ)))
+        self.assertIn("Monday 5 October", text)
+
+    def test_each_clinic_name_is_used(self):
+        start = datetime.datetime(2026, 10, 17, 9, 0, tzinfo=NZ)
+        self.assertIn("Kestrel Physio Northgate", reminder_text(appointment(start, "NG")))
+        self.assertIn("Kestrel Physio Westwick", reminder_text(appointment(start, "WK")))
+
+    def test_no_patient_name_or_treatment(self):
+        text = reminder_text(appointment(datetime.datetime(2026, 10, 17, 9, 0, tzinfo=NZ)))
+        self.assertNotIn("KP-004211", text)
+        self.assertNotIn("lower back pain", text.lower())
+        self.assertNotIn("treatment", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
