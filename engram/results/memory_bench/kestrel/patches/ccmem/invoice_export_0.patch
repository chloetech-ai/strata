+"""Exports for the accountants."""
+
+import csv
+import io
+import os
+
+from .storage import _write_atomic
+
+HEADER = ["Invoice Number", "Clinic", "Patient ID", "Invoice Date", "Amount", "Description"]
+
+
+def _dollars(cents):
+    """Plain dollars with two decimal places, e.g. 9500 -> "95.00", 7 -> "0.07"."""
+    sign = "-" if cents < 0 else ""
+    cents = abs(cents)
+    return f"{sign}{cents // 100}.{cents % 100:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in `year`-`month` to kestrel-invoices-YYYY-MM.csv in out_dir.
+
+    The file is in the layout Mere (Tui Accounting) imports into Xero: a header row, DD/MM/YYYY dates
+    and amounts with two decimal places. Patient names are never written, only the patient id.
+    A month with no invoices gives a file with just the header row.
+
+    Returns the path of the file written.
+    """
+    rows = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    buffer = io.StringIO()
+    writer = csv.writer(buffer, lineterminator="\n")
+    writer.writerow(HEADER)
+    for i in rows:
+        writer.writerow([
+            i.number, i.clinic, i.patient_id, i.issued.strftime("%d/%m/%Y"),
+            _dollars(i.amount_cents), i.description,
+        ])
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    _write_atomic(path, buffer.getvalue())
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..1116f7f
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,100 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-004211", clinic="HB", description="Physiotherapy assessment"):
+    return Invoice(
+        number=number, clinic=clinic, patient_id=patient_id, patient_name="", issued=issued,
+        amount_cents=amount_cents, description=description,
+    )
+
+
+def read_rows(path):
+    with open(path, encoding="utf-8", newline="") as f:
+        return list(csv.reader(f))
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_writes_named_file_and_returns_its_path(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2026, 10, 15))], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_header_row_then_one_row_per_invoice(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2026, 10, 15))], 2026, 10, self.out_dir)
+        rows = read_rows(path)
+        self.assertEqual(rows[0], ["Invoice Number", "Clinic", "Patient ID", "Invoice Date", "Amount", "Description"])
+        self.assertEqual(rows[1], ["INV-1", "HB", "KP-004211", "15/10/2026", "95.00", "Physiotherapy assessment"])
+        self.assertEqual(len(rows), 2)
+
+    def test_only_invoices_from_the_requested_month(self):
+        invoices = [
+            invoice("SEP", datetime.date(2026, 9, 30)),
+            invoice("OCT-1", datetime.date(2026, 10, 1)),
+            invoice("OCT-2", datetime.date(2026, 10, 31)),
+            invoice("NOV", datetime.date(2026, 11, 1)),
+            invoice("OCT-2025", datetime.date(2025, 10, 15)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertEqual([r[0] for r in read_rows(path)[1:]], ["OCT-1", "OCT-2"])
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("B", datetime.date(2026, 10, 20)),
+            invoice("A", datetime.date(2026, 10, 20)),
+            invoice("C", datetime.date(2026, 10, 2)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertEqual([r[0] for r in read_rows(path)[1:]], ["C", "A", "B"])
+
+    def test_dates_are_day_first(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2026, 3, 4))], 2026, 3, self.out_dir)
+        self.assertEqual(read_rows(path)[1][3], "04/03/2026")
+
+    def test_amounts_have_two_decimal_places_and_no_dollar_sign(self):
+        invoices = [
+            invoice("A", datetime.date(2026, 10, 1), amount_cents=9500),
+            invoice("B", datetime.date(2026, 10, 2), amount_cents=7000),
+            invoice("C", datetime.date(2026, 10, 3), amount_cents=7),
+            invoice("D", datetime.date(2026, 10, 4), amount_cents=12345),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertEqual([r[4] for r in read_rows(path)[1:]], ["95.00", "70.00", "0.07", "123.45"])
+
+    def test_patient_names_are_never_written(self):
+        # Names are kept out of invoices by make_invoice; the export must not add them back in either.
+        a = invoice("INV-1", datetime.date(2026, 10, 15), patient_id="KP-004211")
+        a.patient_name = "Aroha Test"
+        path = export_invoices([a], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_empty_month_gives_header_only(self):
+        path = export_invoices([invoice("INV-1", datetime.date(2026, 9, 15))], 2026, 10, self.out_dir)
+        self.assertEqual(read_rows(path), [["Invoice Number", "Clinic", "Patient ID", "Invoice Date", "Amount", "Description"]])
+
+    def test_file_has_unix_line_endings_and_writes_over_an_old_export(self):
+        export_invoices([invoice("OLD", datetime.date(2026, 10, 1))], 2026, 10, self.out_dir)
+        path = export_invoices([invoice("NEW", datetime.date(2026, 10, 2))], 2026, 10, self.out_dir)
+        with open(path, "rb") as f:
+            data = f.read()
+        self.assertNotIn(b"\r", data)
+        self.assertNotIn(b"OLD", data)
+        self.assertEqual(sorted(os.listdir(self.out_dir)), ["kestrel-invoices-2026-10.csv"])
+
+
+if __name__ == "__main__":
+    unittest.main()
