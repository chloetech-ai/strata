+"""Finding free appointment slots for a therapist."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+LENGTHS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# The therapist writes notes for 15 minutes after an assessment; nothing follows a follow-up.
+NOTE_GAP = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per local day
+
+UTC = datetime.timezone.utc
+
+
+def _blocked(start, kind):
+    """The UTC interval [begin, end) that an appointment of `kind` starting at `start` (UTC) occupies, note gap included."""
+    return start, start + LENGTHS[kind] + NOTE_GAP[kind]
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) on `day` (a local Auckland date) where a new `kind` appointment fits.
+
+    A slot is free when it, plus the note gap it needs, does not overlap any
+    non-cancelled appointment of the therapist, and the therapist is under the
+    daily cap for that date. Cancelled appointments hold no time.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+
+    booked = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+    if sum(1 for a in booked if a.start.astimezone(CLINIC_TZ).date() == day) >= DAILY_CAP:
+        return []
+
+    busy = [_blocked(a.start.astimezone(UTC), a.kind) for a in booked]
+
+    slots = []
+    midnight = datetime.datetime.combine(day, datetime.time(0), tzinfo=CLINIC_TZ)
+    for minutes in range(0, 24 * 60, 15):  # appointments start on a quarter hour
+        local = midnight + datetime.timedelta(minutes=minutes)
+        # Skip wall-clock times that do not exist on this date (clocks moving forward).
+        if local.astimezone(UTC).astimezone(CLINIC_TZ).replace(tzinfo=None) != local.replace(tzinfo=None):
+            continue
+        begin, end = _blocked(local.astimezone(UTC), kind)
+        if any(begin < b_end and b_begin < end for b_begin, b_end in busy):
+            continue
+        slots.append(local.time())
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..e7dae27
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,104 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+THERAPIST = Therapist(id="T1", name="Test Therapist", clinic="HB")
+DAY = datetime.date(2027, 3, 2)  # NZDT, no clock change
+
+
+def local(d, hh, mm=0):
+    return datetime.datetime.combine(d, datetime.time(hh, mm), tzinfo=CLINIC_TZ)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_offers_every_quarter_hour(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(len(slots), 96)
+        self.assertEqual(slots[0], datetime.time(0, 0))
+        self.assertEqual(slots[-1], datetime.time(23, 45))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_followup_after_followup(self):
+        cal = Calendar([appt("a1", local(DAY, 9), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        # 08:45 would run into 09:00; 08:30 ends exactly as 09:00 starts, which is fine.
+        self.assertIn(datetime.time(8, 30), slots)
+        self.assertNotIn(datetime.time(8, 45), slots)
+        self.assertNotIn(datetime.time(9, 0), slots)
+        self.assertNotIn(datetime.time(9, 15), slots)
+        self.assertIn(datetime.time(9, 30), slots)
+
+    def test_followup_after_assessment_needs_note_gap(self):
+        cal = Calendar([appt("a1", local(DAY, 9), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        # The assessment runs 09:00-09:45 and the note gap holds the therapist until 10:00.
+        self.assertNotIn(datetime.time(9, 30), slots)
+        self.assertNotIn(datetime.time(9, 45), slots)
+        self.assertIn(datetime.time(10, 0), slots)
+
+    def test_assessment_must_leave_gap_before_next_patient(self):
+        cal = Calendar([appt("a1", local(DAY, 10), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        # An assessment starting 09:15 would finish 10:00 and need the gap until 10:15.
+        self.assertNotIn(datetime.time(9, 15), slots)
+        self.assertNotIn(datetime.time(9, 45), slots)
+        self.assertIn(datetime.time(9, 0), slots)  # ends 09:45, gap until 10:00
+
+    def test_assessment_fits_before_followup_with_gap(self):
+        cal = Calendar([appt("a1", local(DAY, 9), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertNotIn(datetime.time(8, 30), slots)  # would run into 09:00
+        self.assertIn(datetime.time(8, 0), slots)  # 08:00-08:45, gap until 09:00
+
+    def test_appointment_from_previous_day_blocks_after_midnight(self):
+        # An assessment at 23:45 on the 1st runs to 00:30 and holds the therapist until 00:45 on the 2nd.
+        cal = Calendar([appt("a1", local(DAY - datetime.timedelta(days=1), 23, 45), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(datetime.time(0, 0), slots)
+        self.assertNotIn(datetime.time(0, 30), slots)
+        self.assertIn(datetime.time(0, 45), slots)
+
+    def test_cancelled_appointments_hold_no_time(self):
+        cal = Calendar([appt("a1", local(DAY, 9), kind=ASSESSMENT, therapist="T1", status=CANCELLED)])
+        self.assertIn(datetime.time(9, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(DAY, 9), therapist="T2")])
+        self.assertIn(datetime.time(9, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_no_slots_when_daily_cap_reached(self):
+        cal = Calendar([appt(f"a{i}", local(DAY, 7 + i), kind=FOLLOWUP, therapist="T1") for i in range(8)])
+        self.assertEqual(free_slots(cal, THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_cap_counts_only_non_cancelled_appointments(self):
+        cal = Calendar(
+            [appt(f"a{i}", local(DAY, 7 + i), kind=FOLLOWUP, therapist="T1") for i in range(7)]
+            + [appt("c1", local(DAY, 15), kind=FOLLOWUP, therapist="T1", status=CANCELLED)]
+        )
+        # Seven patients is under the cap, so the cancelled 15:00 is simply a free slot again.
+        self.assertIn(datetime.time(15, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_cap_is_per_day(self):
+        other_day = DAY + datetime.timedelta(days=1)
+        cal = Calendar([appt(f"a{i}", local(other_day, 7 + i), kind=FOLLOWUP, therapist="T1") for i in range(8)])
+        self.assertIn(datetime.time(9, 0), free_slots(cal, THERAPIST, DAY, FOLLOWUP))
+
+    def test_nonexistent_local_times_are_skipped(self):
+        # NZ clocks jump from 02:00 to 03:00 on 2027-09-26.
+        day = datetime.date(2027, 9, 26)
+        slots = free_slots(Calendar(), THERAPIST, day, FOLLOWUP)
+        self.assertNotIn(datetime.time(2, 0), slots)
+        self.assertNotIn(datetime.time(2, 30), slots)
+        self.assertIn(datetime.time(3, 0), slots)
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "consult")
+
+
+if __name__ == "__main__":
+    unittest.main()
