+"""Durations of appointments and gaps, as typed in the booking form."""
+
+import re
+
+# "45m", "1h", "1h30", "1h 30m": hours, then optional minutes. The "m" suffix is optional
+# after hours, so "1h30" and "1h30m" both mean 90 minutes.
+_DURATION = re.compile(r"^(?:(?P<hours>[0-9]+)h(?: ?(?P<h_minutes>[0-5]?[0-9])m?)?|(?P<minutes>[0-9]+)m)$")
+
+
+def parse_duration(text):
+    """Turn a duration such as '45m', '1h', '1h30' or '1h 30m' into whole minutes.
+
+    Raises ValueError for anything else, including a zero duration.
+    """
+    match = _DURATION.match(text) if isinstance(text, str) else None
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if match.group("minutes") is not None:
+        minutes = int(match.group("minutes"))
+    else:
+        hours = int(match.group("hours"))
+        minutes = hours * 60 + (int(match.group("h_minutes")) if match.group("h_minutes") else 0)
+    if minutes == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..5295e24
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,36 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_then_bare_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+
+    def test_hours_space_minutes(self):
+        self.assertEqual(parse_duration("1h 30m"), 90)
+
+    def test_hours_and_minutes_with_suffix(self):
+        self.assertEqual(parse_duration("1h30m"), 90)
+
+    def test_rejects_other_text(self):
+        for text in ["", "m", "h", "45", "45 m", "1.5h", "-45m", "1h60", "1h 60m", "1 h", "0m", "0h", "45min", " 45m", "45m "]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_rejects_non_string(self):
+        with self.assertRaises(ValueError):
+            parse_duration(None)
+        with self.assertRaises(ValueError):
+            parse_duration(45)
+
+
+if __name__ == "__main__":
+    unittest.main()
