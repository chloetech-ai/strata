+def next_invoice_number(clinic, year, existing):
+    """The next number in the INV-<clinic>-<year>-<sequence> series.
+
+    `existing` holds invoice numbers from any clinic and year; only those
+    for this clinic and year count, so the sequence restarts at 00001 each year.
+    """
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic {clinic!r}")
+    last = 0
+    for number in existing:
+        match = INVOICE_NUMBER.match(number)
+        if match and match.group(1) == clinic and int(match.group(2)) == year:
+            last = max(last, int(match.group(3)))
+    if last >= 99999:
+        raise ValueError(f"clinic {clinic} has no invoice numbers left for {year}")
+    return f"INV-{clinic}-{year}-{last + 1:05d}"
