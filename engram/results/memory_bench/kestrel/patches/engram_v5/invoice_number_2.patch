+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_highest_existing_sequence_for_clinic_and_year(self):
+        existing = ["INV-HB-2027-00003", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_ignores_other_clinics(self):
+        existing = ["INV-NG-2027-00900", "INV-WK-2027-00500", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_restarts_at_00001_in_a_new_year(self):
+        existing = ["INV-HB-2026-00815"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["HB-2027-00009", "INV-HB-2027-9", "INV-HB-2027-00002 "]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_rejects_unknown_clinic(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("XX", 2027, [])
+
+    def test_rejects_when_sequence_is_exhausted(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
