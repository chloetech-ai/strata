@@ -0,0 +1,19 @@
+"""Durations as typed in the booking form, such as '45m', '1h' or '1h 30m'."""
+
+import re
+
+# Either minutes alone ("45m"), or hours with optional minutes ("1h", "1h30", "1h 30m").
+_DURATION = re.compile(r"(?:([0-9]+)m|([0-9]+)h(?: ?([0-9]+)m?)?)")
+
+
+def parse_duration(text):
+    """Turn a duration such as '1h 30m' into a number of minutes. Raises ValueError otherwise."""
+    match = _DURATION.fullmatch(text) if isinstance(text, str) else None
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    minutes_only, hours, minutes = match.groups()
+    if minutes_only is not None:
+        return int(minutes_only)
+    if minutes is not None and int(minutes) >= 60:
+        raise ValueError(f"minutes must be under 60: {text!r}")
+    return int(hours) * 60 + int(minutes or 0)
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..0007a9e
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,27 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_and_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+        self.assertEqual(parse_duration("1h30m"), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+        self.assertEqual(parse_duration("1h 30"), 90)
+
+    def test_rejects_anything_else(self):
+        for raw in ["", "45", "h", "m", "1.5h", "1h60", "1h 90m", "1 h", "45 m", "-45m", "1d", "1h30s", "1h30 m", "45m\n", None]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(ValueError):
+                    parse_duration(raw)
+
+
+if __name__ == "__main__":
+    unittest.main()
