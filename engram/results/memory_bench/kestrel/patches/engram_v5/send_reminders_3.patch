+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .ids import normalize_patient_id
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment: only its date, time and clinic name."""
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic]
+    return f"Reminder: you have an appointment at {clinic.name} on {local:%d/%m/%Y} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment. Returns the number of messages sent.
+
+    patients maps patient ID to Patient. Every message is built before anything
+    is sent, so an unknown patient raises without sending a partial batch.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[normalize_patient_id(appointment.patient_id)]
+        messages.append((patient.phone, reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..995d553
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,99 @@
+import unittest
+
+from kestrel.models import ATTENDED, BOOKED, CANCELLED, NO_SHOW, FOLLOWUP, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+PATIENTS = {
+    "KP-004211": Patient("KP-004211", "Alex Example", "+64211234567"),
+    "KP-000007": Patient("KP-000007", "Sam Sample", "+64279876543"),
+}
+
+
+def sent(transport):
+    return [m for _, body in transport.calls for m in body["messages"]]
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_sms_per_booked_appointment_and_returns_count(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2, 0), patient="KP-004211"),
+            appt("a2", utc(2026, 10, 21, 2, 0), patient="KP-000007"),
+        ]
+        count = send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        self.assertEqual(count, 2)
+        self.assertEqual([m["to"] for m in sent(transport)], ["+64211234567", "+64279876543"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2, 0), patient="KP-004211", status=BOOKED),
+            appt("a2", utc(2026, 10, 20, 3, 0), patient="KP-004211", status=CANCELLED),
+            appt("a3", utc(2026, 10, 20, 4, 0), patient="KP-004211", status=ATTENDED),
+            appt("a4", utc(2026, 10, 20, 5, 0), patient="KP-004211", status=NO_SHOW),
+        ]
+        count = send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        self.assertEqual(count, 1)
+        self.assertEqual(len(sent(transport)), 1)
+
+    def test_normalizes_patient_id_before_lookup(self):
+        transport = FakeTransport()
+        appointments = [appt("a1", utc(2026, 10, 20, 2, 0), patient="kp 4211")]
+        self.assertEqual(send_reminders(appointments, PATIENTS, BulkieClient("k", transport)), 1)
+        self.assertEqual(sent(transport)[0]["to"], "+64211234567")
+
+    def test_unknown_patient_raises_before_anything_is_sent(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 2, 0), patient="KP-004211"),
+            appt("a2", utc(2026, 10, 20, 3, 0), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        self.assertEqual(transport.calls, [])
+
+    def test_no_booked_appointments_sends_nothing(self):
+        transport = FakeTransport()
+        self.assertEqual(send_reminders([], PATIENTS, BulkieClient("k", transport)), 0)
+        self.assertEqual(transport.calls, [])
+
+    def test_large_run_is_split_by_the_client(self):
+        transport = FakeTransport()
+        appointments = [appt(f"a{i}", utc(2026, 10, 20, 2, 0), patient="KP-004211") for i in range(120)]
+        self.assertEqual(send_reminders(appointments, PATIENTS, BulkieClient("k", transport)), 120)
+        self.assertEqual([len(body["messages"]) for _, body in transport.calls], [50, 50, 20])
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name_only(self):
+        # 02:00 UTC on 20 Oct 2026 is 15:00 NZDT (UTC+13) on the same day.
+        text = reminder_text(appt("a1", utc(2026, 10, 20, 2, 0), clinic="HB", kind=FOLLOWUP, treatment="lower back pain"))
+        self.assertEqual(text, "Reminder: you have an appointment at Kestrel Physio Harbour on 20/10/2026 at 15:00.")
+
+    def test_local_date_can_differ_from_utc_date(self):
+        # 14:00 UTC on 20 Oct is 03:00 on 21 Oct in Auckland.
+        text = reminder_text(appt("a1", utc(2026, 10, 20, 14, 0), clinic="NG"))
+        self.assertIn("on 21/10/2026 at 03:00.", text)
+        self.assertIn("Kestrel Physio Northgate", text)
+
+    def test_never_mentions_treatment(self):
+        text = reminder_text(appt("a1", utc(2026, 10, 20, 2, 0), treatment="lower back pain"))
+        self.assertNotIn("back", text.lower())
+        self.assertNotIn("pain", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
