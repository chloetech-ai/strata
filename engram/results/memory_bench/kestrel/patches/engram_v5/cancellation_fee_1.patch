+++ b/tests/test_fees.py
@@ -0,0 +1,59 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW, ATTENDED
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2027, 3, 10, 10)
+
+    def test_no_show_pays_full_assessment_price(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_pays_full_follow_up_price(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_cancelled_less_than_48_hours_out_pays_half(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 11)), 4750)
+
+    def test_cancelled_exactly_48_hours_out_is_free(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 10)), 0)
+
+    def test_cancelled_more_than_48_hours_out_is_free(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 9)), 0)
+
+    def test_cancelled_after_start_pays_half(self):
+        a = appt("a1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 11)), 3500)
+
+    def test_cancelled_at_defaults_to_recorded_time(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED, cancelled_at=utc(2027, 3, 9, 10))
+        self.assertEqual(cancellation_fee(a), 4750)
+
+    def test_explicit_cancelled_at_overrides_recorded_time(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED, cancelled_at=utc(2027, 3, 1, 10))
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 10)), 4750)
+
+    def test_cancelled_without_any_time_is_an_error(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_naive_cancelled_at_is_an_error(self):
+        a = appt("a1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 9, 10))
+
+    def test_booked_and_attended_have_no_fee(self):
+        for status in (BOOKED, ATTENDED):
+            with self.subTest(status=status):
+                a = appt("a1", self.start, kind=FOLLOWUP, status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a, utc(2027, 3, 9, 10))
