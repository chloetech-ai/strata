+"""Booking rules for new appointments."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, BOOKED, FOLLOWUP
+
+ASSESSMENT_MINUTES = 45
+FOLLOWUP_MINUTES = 30
+GAP_AFTER_ASSESSMENT = datetime.timedelta(minutes=15)  # time for notes before the next patient
+MAX_PATIENTS_PER_DAY = 8  # therapists' union agreement
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=ASSESSMENT_MINUTES),
+    FOLLOWUP: datetime.timedelta(minutes=FOLLOWUP_MINUTES),
+}
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def _gap_after(appointment):
+    return GAP_AFTER_ASSESSMENT if appointment.kind == ASSESSMENT else datetime.timedelta(0)
+
+
+def _clashes(a, b):
+    """True if two appointments overlap, or if the gap after either one is intruded on."""
+    return a.start < _end(b) + _gap_after(b) and b.start < _end(a) + _gap_after(a)
+
+
+def can_book(calendar, therapist, appointment):
+    """True if appointment can be added to calendar for therapist, else False.
+
+    Refuses an appointment that is not for this therapist, reuses an id, starts
+    off a quarter hour (Auckland time), clashes with a booked appointment for
+    the same therapist (including the gap after an assessment), or would be the
+    therapist's ninth booked patient appointment on that Auckland day.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if any(a.id == appointment.id for a in calendar.all()):
+        return False
+
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    booked = [a for a in calendar.for_therapist(therapist.id) if a.status == BOOKED]
+    if sum(1 for a in booked if a.start.astimezone(CLINIC_TZ).date() == local_start.date()) >= MAX_PATIENTS_PER_DAY:
+        return False
+    return not any(_clashes(appointment, a) for a in booked)
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..918e483
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,97 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import CANCELLED, Therapist
+
+THERAPIST = Therapist(id="T1", name="Sam", clinic="HB")
+OTHER = Therapist(id="T2", name="Lee", clinic="HB")
+
+
+def local(hh, mm=0, day=1):
+    """A timezone-aware start on 1 March 2027 (NZDT, UTC+13) at a local Auckland time."""
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_allows_a_slot_in_an_empty_calendar(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("n", local(9), kind="assessment", therapist="T1")))
+
+    def test_refuses_an_appointment_for_a_different_therapist(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("n", local(9), therapist="T2")))
+
+    def test_refuses_an_id_already_in_the_calendar(self):
+        cal = Calendar([appt("n", local(14), therapist="T1")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(9), therapist="T1")))
+
+    def test_refuses_a_start_off_the_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, appt("n", local(9, 10), therapist="T1")))
+
+    def test_allows_each_quarter_hour(self):
+        for minute in (0, 15, 30, 45):
+            with self.subTest(minute=minute):
+                self.assertTrue(can_book(Calendar(), THERAPIST, appt("n", local(9, minute), therapist="T1")))
+
+    def test_quarter_hour_is_checked_in_auckland_time(self):
+        # 09:15 Auckland is 20:15 UTC the day before; still a quarter hour.
+        start = datetime.datetime(2027, 2, 28, 20, 15, tzinfo=datetime.timezone.utc)
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("n", start, therapist="T1")))
+
+    def test_refuses_overlap_with_a_booked_followup(self):
+        cal = Calendar([appt("a", local(9), therapist="T1")])  # 09:00-09:30
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(9, 15), therapist="T1")))
+
+    def test_refuses_a_new_appointment_that_covers_an_existing_one(self):
+        cal = Calendar([appt("a", local(9, 15), therapist="T1")])  # 09:15-09:45
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(9), kind="assessment", therapist="T1")))
+
+    def test_allows_back_to_back_followups(self):
+        cal = Calendar([appt("a", local(9), therapist="T1")])  # 09:00-09:30
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(9, 30), therapist="T1")))
+
+    def test_refuses_a_followup_inside_the_gap_after_an_assessment(self):
+        cal = Calendar([appt("a", local(9), kind="assessment", therapist="T1")])  # 09:00-09:45, then 15 min
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(9, 45), therapist="T1")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(10), therapist="T1")))
+
+    def test_refuses_an_assessment_that_leaves_no_gap_before_an_existing_appointment(self):
+        cal = Calendar([appt("a", local(10, 15), therapist="T1")])  # 10:15 follow-up
+        # Assessment 09:30-10:15 has no 15-minute gap before the 10:15 patient.
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(9, 30), kind="assessment", therapist="T1")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(9), kind="assessment", therapist="T1")))
+
+    def test_allows_an_assessment_right_after_a_followup(self):
+        cal = Calendar([appt("a", local(9), therapist="T1")])  # 09:00-09:30 follow-up, no gap needed
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(9, 30), kind="assessment", therapist="T1")))
+
+    def test_ignores_cancelled_appointments(self):
+        cal = Calendar([appt("a", local(9), therapist="T1", status=CANCELLED)])
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(9), therapist="T1")))
+
+    def test_ignores_other_therapists(self):
+        cal = Calendar([appt("a", local(9), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(9), therapist="T1")))
+
+    def test_allows_eight_booked_patients_in_a_day_but_not_nine(self):
+        bookings = [appt(f"a{i}", local(9 + i // 2, 30 * (i % 2)), therapist="T1") for i in range(7)]
+        cal = Calendar(bookings)  # 09:00 to 12:30 follow-ups, seven of them
+        self.assertTrue(can_book(cal, THERAPIST, appt("n8", local(12, 30), therapist="T1")))
+        cal.add(appt("n8", local(12, 30), therapist="T1"))
+        self.assertFalse(can_book(cal, THERAPIST, appt("n9", local(13), therapist="T1")))
+
+    def test_cancelled_appointments_do_not_count_towards_the_day_limit(self):
+        bookings = [appt(f"a{i}", local(9 + i // 2, 30 * (i % 2)), therapist="T1") for i in range(7)]
+        bookings.append(appt("gone", local(13), therapist="T1", status=CANCELLED))
+        cal = Calendar(bookings)
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(13, 30), therapist="T1")))
+
+    def test_day_limit_is_per_auckland_day(self):
+        bookings = [appt(f"a{i}", local(9 + i // 2, 30 * (i % 2), day=1), therapist="T1") for i in range(8)]
+        cal = Calendar(bookings)  # full on 1 March
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(9, day=2), therapist="T1")))
+
+
+if __name__ == "__main__":
+    unittest.main()
