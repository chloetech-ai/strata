+"""SMS appointment reminders."""
+
+from .calendar import CLINIC_TZ
+from .ids import normalize_patient_id
+from .models import BOOKED, CLINICS
+from .sms import MAX_PER_CALL
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of each booked appointment.
+
+    patients maps patient ID to Patient. A message gives only the clinic name,
+    date and time, never the treatment or the kind of appointment. Every
+    patient is looked up before anything is sent, so a missing patient sends
+    nothing. Returns the number of messages sent. If a call fails partway, the
+    RuntimeError says how many messages were already sent.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[normalize_patient_id(appointment.patient_id)]
+        local = appointment.start.astimezone(CLINIC_TZ)
+        clinic = CLINICS[appointment.clinic].name
+        text = f"Reminder: you have an appointment at {clinic} on {local:%d/%m/%Y} at {local:%H:%M}."
+        messages.append((patient.phone, text))
+
+    sent = 0
+    for start in range(0, len(messages), MAX_PER_CALL):
+        chunk = messages[start:start + MAX_PER_CALL]
+        try:
+            client.send_batch(chunk)
+        except Exception as exc:
+            raise RuntimeError(f"reminders stopped after {sent} of {len(messages)} messages were sent") from exc
+        sent += len(chunk)
+    return sent
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..bf7912c
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,102 @@
+import unittest
+
+from kestrel.models import ASSESSMENT, CANCELLED, Patient
+from kestrel.reminders import send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import UTC, appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+PATIENTS = {
+    "KP-004211": Patient("KP-004211", "Ana Lee", "+64211234567"),
+    "KP-000002": Patient("KP-000002", "Ben Ng", "+64219876543"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_message_per_booked_appointment_and_counts_them(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 0), patient="KP-004211"),
+            appt("A2", utc(2026, 10, 21, 2, 0), patient="KP-000002"),
+        ]
+        sent = send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        self.assertEqual(sent, 2)
+        messages = transport.calls[0][1]["messages"]
+        self.assertEqual([m["to"] for m in messages], ["+64211234567", "+64219876543"])
+
+    def test_skips_cancelled_appointments(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 0), patient="KP-004211"),
+            appt("A2", utc(2026, 10, 21, 2, 0), patient="KP-000002", status=CANCELLED),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, BulkieClient("k", transport)), 1)
+        self.assertEqual(len(transport.calls[0][1]["messages"]), 1)
+
+    def test_message_has_date_time_and_clinic_only(self):
+        transport = FakeTransport()
+        # 2026-10-20 02:30 UTC is 15:30 on 20/10/2026 in Auckland (NZDT, UTC+13).
+        appointments = [appt("A1", utc(2026, 10, 20, 2, 30), kind=ASSESSMENT, treatment="lower back pain", patient="KP-004211", clinic="HB")]
+        send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        text = transport.calls[0][1]["messages"][0]["text"]
+        self.assertEqual(text, "Reminder: you have an appointment at Kestrel Physio Harbour on 20/10/2026 at 15:30.")
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("lower back", text.lower())
+
+    def test_date_is_the_local_auckland_date_not_the_utc_date(self):
+        transport = FakeTransport()
+        # 2026-10-20 12:30 UTC is 01:30 on 21/10/2026 in Auckland.
+        appointments = [appt("A1", utc(2026, 10, 20, 12, 30), patient="KP-004211")]
+        send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        self.assertIn("on 21/10/2026 at 01:30.", transport.calls[0][1]["messages"][0]["text"])
+
+    def test_normalizes_appointment_patient_id(self):
+        transport = FakeTransport()
+        appointments = [appt("A1", utc(2026, 10, 20, 2, 0), patient="kp4211")]
+        self.assertEqual(send_reminders(appointments, PATIENTS, BulkieClient("k", transport)), 1)
+
+    def test_missing_patient_sends_nothing(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 2, 0), patient="KP-004211"),
+            appt("A2", utc(2026, 10, 21, 2, 0), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        self.assertEqual(transport.calls, [])
+
+    def test_sends_in_calls_of_at_most_50_and_reports_progress_on_failure(self):
+        class FailingSecondCall:
+            def __init__(self):
+                self.calls = 0
+
+            def post(self, path, body):
+                self.calls += 1
+                if self.calls == 2:
+                    raise OSError("gateway down")
+                return {"ok": True}
+
+        transport = FailingSecondCall()
+        appointments = [appt(f"A{i}", utc(2026, 10, 20, 2, 0), patient="KP-004211") for i in range(60)]
+        with self.assertRaises(RuntimeError) as ctx:
+            send_reminders(appointments, PATIENTS, BulkieClient("k", transport))
+        self.assertIn("after 50 of 60", str(ctx.exception))
+
+    def test_no_booked_appointments_sends_nothing(self):
+        transport = FakeTransport()
+        self.assertEqual(send_reminders([], PATIENTS, BulkieClient("k", transport)), 0)
+        self.assertEqual(transport.calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
