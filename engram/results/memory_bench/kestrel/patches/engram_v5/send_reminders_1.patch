+++ b/src/kestrel/reminders.py
@@ -0,0 +1,38 @@
+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .ids import normalize_patient_id
+from .models import BOOKED, CLINICS
+from .sms import MAX_PER_CALL
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment and return how many were sent.
+
+    patients maps patient ID to Patient. The message gives only the date, the
+    time and the clinic name, never the treatment. Every message is built before
+    anything is sent, so a missing patient raises before any SMS goes out.
+    Batches are not atomic, so if one fails the RuntimeError says how many
+    messages were already sent.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[normalize_patient_id(appointment.patient_id)]
+        local = appointment.start.astimezone(CLINIC_TZ)
+        clinic = CLINICS[appointment.clinic]
+        text = (
+            f"Reminder: you have an appointment at {clinic.name} "
+            f"on {local:%a %d %b %Y} at {local:%H:%M}."
+        )
+        messages.append((patient.phone, text))
+    sent = 0
+    for start in range(0, len(messages), MAX_PER_CALL):
+        batch = messages[start:start + MAX_PER_CALL]
+        try:
+            client.send_batch(batch)
+        except Exception as exc:
+            raise RuntimeError(f"sent {sent} of {len(messages)} reminders before a batch failed") from exc
+        sent += len(batch)
+    return sent
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..8febbc4
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,99 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ATTENDED, CANCELLED, Patient
+from kestrel.reminders import send_reminders
+
+
+class FakeClient:
+    def __init__(self, fail_on_call=None):
+        self.batches = []
+        self.fail_on_call = fail_on_call
+
+    def send_batch(self, messages):
+        if len(self.batches) == self.fail_on_call:
+            raise OSError("gateway down")
+        self.batches.append(list(messages))
+        return [{"ok": True}]
+
+
+def patients_for(n):
+    return {f"KP-{i:06d}": Patient(f"KP-{i:06d}", f"Name {i}", f"+6421{i:07d}") for i in range(1, n + 1)}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_one_sms_per_booked_appointment(self):
+        patients = patients_for(2)
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"),
+            appt("a2", utc(2027, 3, 1, 21), patient="KP-000002"),
+            appt("a3", utc(2027, 3, 1, 22), patient="KP-000001"),
+        ]
+        client = FakeClient()
+        self.assertEqual(send_reminders(appointments, patients, client), 3)
+        sent = [m for batch in client.batches for m in batch]
+        self.assertEqual([to for to, _ in sent], ["+64210000001", "+64210000002", "+64210000001"])
+
+    def test_skips_cancelled_and_attended(self):
+        patients = patients_for(1)
+        appointments = [
+            appt("a1", utc(2027, 3, 1, 20)),
+            appt("a2", utc(2027, 3, 1, 21), status=CANCELLED, cancelled_at=utc(2027, 2, 28)),
+            appt("a3", utc(2027, 3, 1, 22), status=ATTENDED),
+        ]
+        client = FakeClient()
+        self.assertEqual(send_reminders(appointments, patients, client), 1)
+        self.assertEqual(len(client.batches), 1)
+        self.assertEqual(len(client.batches[0]), 1)
+
+    def test_text_has_date_time_and_clinic_only(self):
+        patients = patients_for(1)
+        # 2027-03-01 20:00 UTC is 09:00 on 2027-03-02 in Auckland (NZDT).
+        appointments = [appt("a1", utc(2027, 3, 1, 20), clinic="HB", treatment="lower back pain")]
+        client = FakeClient()
+        send_reminders(appointments, patients, client)
+        (_, text), = client.batches[0]
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tue 02 Mar 2027", text)
+        self.assertIn("09:00", text)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("Name 1", text)
+
+    def test_looks_up_untidy_stored_patient_id(self):
+        patients = patients_for(1)
+        appointments = [appt("a1", utc(2027, 3, 1, 20), patient="kp1")]
+        client = FakeClient()
+        self.assertEqual(send_reminders(appointments, patients, client), 1)
+
+    def test_missing_patient_sends_nothing(self):
+        patients = patients_for(1)
+        appointments = [appt("a1", utc(2027, 3, 1, 20), patient="KP-000001"), appt("a2", utc(2027, 3, 1, 21), patient="KP-000009")]
+        client = FakeClient()
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, patients, client)
+        self.assertEqual(client.batches, [])
+
+    def test_splits_into_batches_of_50(self):
+        patients = patients_for(1)
+        appointments = [appt(f"a{i}", utc(2027, 3, 1, 20), patient="KP-000001") for i in range(120)]
+        client = FakeClient()
+        self.assertEqual(send_reminders(appointments, patients, client), 120)
+        self.assertEqual([len(b) for b in client.batches], [50, 50, 20])
+
+    def test_no_booked_appointments_returns_zero(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([], {}, client), 0)
+        self.assertEqual(client.batches, [])
+
+    def test_failed_batch_reports_how_many_were_sent(self):
+        patients = patients_for(1)
+        appointments = [appt(f"a{i}", utc(2027, 3, 1, 20), patient="KP-000001") for i in range(120)]
+        client = FakeClient(fail_on_call=1)
+        with self.assertRaises(RuntimeError) as ctx:
+            send_reminders(appointments, patients, client)
+        self.assertIn("sent 50 of 120", str(ctx.exception))
+        self.assertEqual([len(b) for b in client.batches], [50])
+
+
+if __name__ == "__main__":
+    unittest.main()
