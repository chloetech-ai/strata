+def next_invoice_number(clinic, year, existing):
+    """The next number in INV-<clinic>-<year>-<sequence> for this clinic and year.
+
+    `existing` may hold numbers from any clinic and year; only those for this
+    clinic and year count. The sequence is one past the highest one issued, so
+    a gap left by a deleted invoice is never reused.
+    """
+    if clinic not in CLINICS:
+        raise ValueError(f"unknown clinic {clinic!r}")
+    prefix = f"INV-{clinic}-{year}-"
+    issued = [
+        int(n[len(prefix):])
+        for n in existing
+        if n.startswith(prefix) and re.fullmatch(r"[0-9]{5}", n[len(prefix):])
+    ]
+    sequence = max(issued, default=0) + 1
+    if sequence > MAX_SEQUENCE:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{sequence:05d}"
