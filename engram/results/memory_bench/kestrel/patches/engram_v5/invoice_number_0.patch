+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_one_past_the_highest_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00009", "INV-WK-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00010")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00108"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_formats(self):
+        existing = ["N", "INV-HB-2027-0009", "INV-HB-2027-000090", "INV-HB-2027-0000x"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_does_not_reuse_a_gap(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_rejects_unknown_clinic(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("ZZ", 2027, [])
+
+    def test_rejects_when_sequence_would_overflow(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
