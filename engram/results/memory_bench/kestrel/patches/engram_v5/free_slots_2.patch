@@ -0,0 +1,65 @@
+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+# Appointment lengths, and the notes gap a therapist needs after an assessment.
+DURATION = {ASSESSMENT: datetime.timedelta(minutes=45), FOLLOWUP: datetime.timedelta(minutes=30)}
+NOTES_GAP = {ASSESSMENT: datetime.timedelta(minutes=15), FOLLOWUP: datetime.timedelta(0)}
+SLOT_STEP = datetime.timedelta(minutes=15)  # every appointment starts on a quarter hour
+DAILY_CAP = 8  # therapists' union agreement: patient appointments per therapist per day
+
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+SATURDAY_HOURS = (datetime.time(8, 0), datetime.time(12, 0))  # Northgate only
+SATURDAY_CLINIC = "NG"
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times at which a new appointment of this kind could be booked.
+
+    therapist is a Therapist and day a local Auckland date. Returns sorted
+    datetime.time values, on quarter hours, within the clinic's opening hours.
+    A slot is offered only if the appointment, plus the notes gap after an
+    assessment, does not overlap the therapist's non-cancelled appointments that
+    day, and only if the therapist is still under the daily cap.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = _opening_hours(therapist, day)
+    if hours is None:
+        return []
+
+    taken = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(taken) >= DAILY_CAP:
+        return []
+
+    open_time, close_time = hours
+    start = datetime.datetime.combine(day, open_time, tzinfo=CLINIC_TZ)
+    close = datetime.datetime.combine(day, close_time, tzinfo=CLINIC_TZ)
+    block = _block(kind)
+    slots = []
+    while start + DURATION[kind] <= close:
+        if all(not _overlaps(start, block, a.start, _block(a.kind)) for a in taken):
+            slots.append(start.time())
+        start += SLOT_STEP
+    return slots
+
+
+def _opening_hours(therapist, day):
+    """(open, close) local times for the therapist's clinic on day, or None if closed."""
+    if day.weekday() < 5:
+        return WEEKDAY_HOURS
+    if day.weekday() == 5 and therapist.clinic == SATURDAY_CLINIC:
+        return SATURDAY_HOURS
+    return None
+
+
+def _block(kind):
+    """Time an appointment of this kind occupies, including any notes gap after it."""
+    return DURATION[kind] + NOTES_GAP[kind]
+
+
+def _overlaps(start_a, length_a, start_b, length_b):
+    return start_a < start_b + length_b and start_b < start_a + length_a
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..e2c9466
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,117 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+# 2027-03-01 is a Monday, and NZDT (UTC+13) applies.
+MONDAY = datetime.date(2027, 3, 1)
+SATURDAY = datetime.date(2027, 3, 6)
+SUNDAY = datetime.date(2027, 3, 7)
+T = datetime.time
+
+
+def local(day, hh, mm=0):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+HB_THERAPIST = Therapist("T1", "Ana", "HB")
+NG_THERAPIST = Therapist("T1", "Ana", "NG")
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_assessment_runs_from_opening_to_last_start_that_fits(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertEqual(slots[0], T(7, 30))
+        self.assertEqual(slots[-1], T(17, 15))  # 17:15 + 45 min ends at 18:00
+        self.assertEqual(len(slots), 40)
+
+    def test_empty_weekday_followup_last_start_is_1730(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertEqual(slots[-1], T(17, 30))
+        self.assertEqual(len(slots), 41)
+
+    def test_returns_sorted_times_on_quarter_hours(self):
+        slots = free_slots(Calendar(), HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(t.minute % 15 == 0 and t.second == 0 for t in slots))
+
+    def test_followup_overlapping_existing_followup_is_excluded(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), therapist="T1", kind=FOLLOWUP)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        for taken in (T(8, 45), T(9, 0), T(9, 15)):
+            self.assertNotIn(taken, slots)
+        self.assertIn(T(8, 30), slots)  # ends exactly when the existing one starts
+        self.assertIn(T(9, 30), slots)  # starts exactly when it ends
+
+    def test_no_gap_needed_after_followup(self):
+        cal = Calendar([appt("a1", local(MONDAY, 9), therapist="T1", kind=FOLLOWUP)])
+        self.assertIn(T(9, 30), free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_fifteen_minute_notes_gap_after_assessment(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), therapist="T1", kind=ASSESSMENT)])  # busy 10:00-10:45, gap to 11:00
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(T(10, 30), slots)
+        self.assertNotIn(T(10, 45), slots)
+        self.assertIn(T(11, 0), slots)
+
+    def test_assessment_may_finish_exactly_when_next_assessment_gap_starts(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), therapist="T1", kind=ASSESSMENT)])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT)
+        self.assertIn(T(9, 0), slots)  # 09:00 + 60 min (including gap) ends at 10:00
+        self.assertNotIn(T(9, 15), slots)
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(MONDAY, 10), therapist="T1", kind=ASSESSMENT, status="cancelled")])
+        self.assertIn(T(10, 0), free_slots(cal, HB_THERAPIST, MONDAY, ASSESSMENT))
+
+    def test_other_therapists_and_other_days_do_not_block(self):
+        cal = Calendar([
+            appt("a1", local(MONDAY, 10), therapist="T2"),
+            appt("a2", local(MONDAY + datetime.timedelta(days=1), 10), therapist="T1"),
+        ])
+        self.assertIn(T(10, 0), free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_daily_cap_of_eight_leaves_no_slots(self):
+        cal = Calendar([appt(f"a{i}", local(MONDAY, 7, 30) + datetime.timedelta(minutes=30 * i), therapist="T1") for i in range(8)])
+        self.assertEqual(free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP), [])
+
+    def test_seven_appointments_still_leave_slots(self):
+        cal = Calendar([appt(f"a{i}", local(MONDAY, 7, 30) + datetime.timedelta(minutes=30 * i), therapist="T1") for i in range(7)])
+        self.assertIn(T(15, 0), free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        cal = Calendar([
+            appt(f"a{i}", local(MONDAY, 7, 30) + datetime.timedelta(minutes=30 * i), therapist="T1", status="cancelled")
+            for i in range(8)
+        ])
+        self.assertTrue(free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP))
+
+    def test_saturday_northgate_only_eight_to_twelve(self):
+        slots = free_slots(Calendar(), NG_THERAPIST, SATURDAY, FOLLOWUP)
+        self.assertEqual(slots[0], T(8, 0))
+        self.assertEqual(slots[-1], T(11, 30))
+        self.assertEqual(len(slots), 15)
+
+    def test_saturday_closed_for_other_clinics(self):
+        self.assertEqual(free_slots(Calendar(), HB_THERAPIST, SATURDAY, FOLLOWUP), [])
+
+    def test_sunday_closed(self):
+        self.assertEqual(free_slots(Calendar(), NG_THERAPIST, SUNDAY, FOLLOWUP), [])
+
+    def test_uses_auckland_day_for_existing_appointments(self):
+        # 18:30 UTC on 28 Feb is 07:30 on Monday 1 March in Auckland.
+        cal = Calendar([appt("a1", datetime.datetime(2027, 2, 28, 18, 30, tzinfo=datetime.timezone.utc), therapist="T1")])
+        slots = free_slots(cal, HB_THERAPIST, MONDAY, FOLLOWUP)
+        self.assertNotIn(T(7, 30), slots)
+        self.assertIn(T(8, 0), slots)
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB_THERAPIST, MONDAY, "physio")
+
+
+if __name__ == "__main__":
+    unittest.main()
