+"""Checks the booking form runs before it saves an appointment."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Gap the therapist needs for notes before the next patient.
+GAP_AFTER = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+DAILY_CAP = 8  # patient appointments per therapist per day, from the union agreement
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist.
+
+    The calendar itself does not check any of these, so the booking form relies on this.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    if any(a.id == appointment.id for a in calendar.all()):
+        return False
+
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    # Cancelled appointments free their slot and do not count towards the cap.
+    existing = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+
+    start = appointment.start
+    end = start + DURATIONS[appointment.kind]
+    gap = GAP_AFTER[appointment.kind]
+    for other in existing:
+        other_end = other.start + DURATIONS[other.kind]
+        # Two appointments clash unless one (plus its gap) finishes before the other starts.
+        if start < other_end + GAP_AFTER[other.kind] and other.start < end + gap:
+            return False
+
+    day = local_start.date()
+    booked_that_day = [a for a in existing if a.start.astimezone(CLINIC_TZ).date() == day]
+    if len(booked_that_day) >= DAILY_CAP:
+        return False
+
+    return True
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..3aae50f
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,88 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+T1 = Therapist("T1", "Ann", "HB")
+
+
+def local(hh, mm=0, days=0):
+    """A start on 2027-03-02 (NZDT, UTC+13) at the given Auckland time, `days` later."""
+    base = utc(2027, 3, 1, 20)  # 09:00 on 2027-03-02 local
+    return base + datetime.timedelta(days=days, hours=hh - 9, minutes=mm)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        self.assertTrue(can_book(Calendar(), T1, appt("new", local(9), therapist="T1")))
+
+    def test_overlap_refused(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])
+        self.assertFalse(can_book(cal, T1, appt("new", local(9, 15), therapist="T1")))
+
+    def test_back_to_back_followups_allowed(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])
+        self.assertTrue(can_book(cal, T1, appt("new", local(9, 30), therapist="T1")))
+
+    def test_gap_after_assessment(self):
+        # Assessment 09:00-09:45, then 15 minutes for notes until 10:00.
+        cal = Calendar([appt("a1", local(9), kind=ASSESSMENT, therapist="T1")])
+        self.assertFalse(can_book(cal, T1, appt("new", local(9, 45), therapist="T1")))
+        self.assertTrue(can_book(cal, T1, appt("new", local(10), therapist="T1")))
+
+    def test_no_gap_after_followup(self):
+        cal = Calendar([appt("a1", local(9), kind=FOLLOWUP, therapist="T1")])
+        self.assertTrue(can_book(cal, T1, appt("new", local(9, 30), kind=ASSESSMENT, therapist="T1")))
+
+    def test_gap_before_following_appointment(self):
+        # A new assessment 09:00-09:45 needs its 15-minute gap before a followup at 09:45.
+        cal = Calendar([appt("f1", local(9, 45), kind=FOLLOWUP, therapist="T1")])
+        self.assertFalse(can_book(cal, T1, appt("new", local(9), kind=ASSESSMENT, therapist="T1")))
+        cal = Calendar([appt("f1", local(10), kind=FOLLOWUP, therapist="T1")])
+        self.assertTrue(can_book(cal, T1, appt("new", local(9), kind=ASSESSMENT, therapist="T1")))
+
+    def test_assessment_length(self):
+        # An assessment at 09:00 runs to 09:45, so a followup at 09:30 clashes.
+        cal = Calendar([appt("a1", local(9), kind=ASSESSMENT, therapist="T1")])
+        self.assertFalse(can_book(cal, T1, appt("new", local(9, 30), therapist="T1")))
+
+    def test_quarter_hour_start(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("new", local(9, 10), therapist="T1")))
+        self.assertTrue(can_book(Calendar(), T1, appt("new", local(9, 15), therapist="T1")))
+
+    def test_cancelled_does_not_block(self):
+        cal = Calendar([appt("a1", local(9), status=CANCELLED, therapist="T1")])
+        self.assertTrue(can_book(cal, T1, appt("new", local(9), therapist="T1")))
+
+    def test_other_therapist_does_not_block(self):
+        cal = Calendar([appt("a1", local(9), therapist="T2")])
+        self.assertTrue(can_book(cal, T1, appt("new", local(9), therapist="T1")))
+
+    def test_appointment_for_other_therapist_refused(self):
+        self.assertFalse(can_book(Calendar(), T1, appt("new", local(9), therapist="T2")))
+
+    def test_duplicate_id_refused(self):
+        cal = Calendar([appt("a1", local(9), therapist="T1")])
+        self.assertFalse(can_book(cal, T1, appt("a1", local(14), therapist="T1")))
+
+    def test_daily_cap(self):
+        # Eight followups from 09:00 to 12:30 fill the cap for the day.
+        eight = [appt(f"a{i}", local(9, 30 * i), therapist="T1") for i in range(8)]
+        self.assertFalse(can_book(Calendar(eight), T1, appt("new", local(13), therapist="T1")))
+        self.assertTrue(can_book(Calendar(eight[:7]), T1, appt("new", local(13), therapist="T1")))
+
+    def test_daily_cap_ignores_cancelled(self):
+        eight = [appt(f"a{i}", local(9, 30 * i), therapist="T1") for i in range(8)]
+        eight[0].status = CANCELLED
+        self.assertTrue(can_book(Calendar(eight), T1, appt("new", local(13), therapist="T1")))
+
+    def test_daily_cap_is_per_local_day(self):
+        eight = [appt(f"a{i}", local(9, 30 * i), therapist="T1") for i in range(8)]
+        self.assertTrue(can_book(Calendar(eight), T1, appt("new", local(9, days=1), therapist="T1")))
+
+
+if __name__ == "__main__":
+    unittest.main()
