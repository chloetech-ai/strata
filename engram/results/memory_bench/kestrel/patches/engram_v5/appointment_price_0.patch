 """Session prices for Kestrel Physio."""
 
+import datetime
+
+from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
-# Prices in cents (NZD).
-_PRICES = {
+# Prices in cents (NZD), by the Auckland date of the appointment.
+PRICE_RISE_DATE = datetime.date(2027, 4, 1)
+_PRICES_BEFORE_RISE = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
+_PRICES_FROM_RISE = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
 
 
-def session_price(kind):
-    """The price in cents for a session of the given kind."""
+def session_price(kind, day):
+    """The price in cents for a session of the given kind on a local Auckland date."""
+    if day < PRICE_RISE_DATE:
+        prices = _PRICES_BEFORE_RISE
+    else:
+        prices = _PRICES_FROM_RISE
     try:
-        return _PRICES[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for the appointment, in cents.
+
+    Patients holding a Community Services Card get 20% off follow-ups,
+    but not off initial assessments.
+    """
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * 80 // 100
+    return price
