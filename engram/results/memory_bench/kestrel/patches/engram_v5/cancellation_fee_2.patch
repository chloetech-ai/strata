@@ -0,0 +1,35 @@
+"""Fees charged to patients who do not attend."""
+
+import datetime
+from typing import Optional
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# Cancelling inside this window before the start costs half the session price.
+LATE_CANCEL_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at: Optional[datetime.datetime] = None):
+    """The fee in cents for an appointment that was cancelled or missed.
+
+    A cancelled appointment costs 50% of the session price if it was cancelled
+    less than 48 hours before its start, and nothing otherwise. Pass
+    `cancelled_at` (timezone-aware), or leave it None to use the time recorded
+    on the appointment. A no-show costs the full session price; `cancelled_at`
+    is not used for it.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError("cancelled appointment needs a cancelled_at time")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCEL_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..e5314ec
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,70 @@
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+from helpers import appt, utc
+
+
+START = utc(2026, 10, 20, 9)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        a = appt("a1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 8, 59)), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        a = appt("a1", START, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9)), 0)
+
+    def test_cancelled_under_48_hours_ahead_costs_half_a_followup(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9, 1)), 3500)
+
+    def test_cancelled_under_48_hours_ahead_costs_half_an_assessment(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 19, 0)), 4750)
+
+    def test_cancelled_after_start_costs_half(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 20, 10)), 3500)
+
+    def test_uses_cancelled_at_recorded_on_appointment_when_not_passed(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED, cancelled_at=utc(2026, 10, 19, 0))
+        self.assertEqual(cancellation_fee(a), 3500)
+
+    def test_passed_cancelled_at_overrides_recorded_one(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=CANCELLED, cancelled_at=utc(2026, 10, 19, 0))
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 10, 0)), 0)
+
+    def test_cancelled_without_any_time_is_an_error(self):
+        a = appt("a1", START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_rejects_naive_cancelled_at(self):
+        a = appt("a1", START, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, START.replace(tzinfo=None))
+
+    def test_no_show_pays_full_assessment_price(self):
+        a = appt("a1", START, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_pays_full_followup_price(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_ignores_cancelled_at(self):
+        a = appt("a1", START, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a, None), 7000)
+
+    def test_attended_and_booked_have_no_cancellation_fee(self):
+        for status in (ATTENDED, BOOKED):
+            a = appt("a1", START, status=status)
+            with self.assertRaises(ValueError):
+                cancellation_fee(a, utc(2026, 10, 19, 0))
+
+
+if __name__ == "__main__":
+    unittest.main()
