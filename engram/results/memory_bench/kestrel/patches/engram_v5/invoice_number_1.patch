+def next_invoice_number(clinic, year, existing):
+    """The next number in the INV-<clinic>-<year>-<sequence> series.
+
+    `existing` may hold numbers from any clinic and year; only those in the
+    same clinic and year count, so the sequence restarts at 00001 each year.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    sequences = [0]
+    for number in existing:
+        digits = number[len(prefix):]
+        if number.startswith(prefix) and digits.isascii() and digits.isdigit():
+            sequences.append(int(digits))
+    sequence = max(sequences) + 1
+    if sequence > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{sequence:05d}"
+
+
