 """Session prices for Kestrel Physio."""
 
+import datetime
+
+from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
-# Prices in cents (NZD).
-_PRICES = {
+# Prices in cents (NZD). Appointments dated on or after CUTOVER (local Auckland date) pay the new prices.
+CUTOVER = datetime.date(2027, 4, 1)
+_PRICES_BEFORE_CUTOVER = {
     ASSESSMENT: 9500,
     FOLLOWUP: 7000,
 }
+_PRICES_FROM_CUTOVER = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+# Patients holding a Community Services Card get this percentage off follow-ups, not assessments.
+CSC_FOLLOWUP_DISCOUNT_PERCENT = 20
 
 
-def session_price(kind):
-    """The price in cents for a session of the given kind."""
+def session_price(kind, day):
+    """The price in cents for a session of the given kind on a local Auckland date."""
+    prices = _PRICES_FROM_CUTOVER if day >= CUTOVER else _PRICES_BEFORE_CUTOVER
     try:
-        return _PRICES[kind]
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for an appointment, in cents."""
+    if patient.id != appointment.patient_id:
+        raise ValueError(f"appointment {appointment.id} is not for patient {patient.id}")
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_DISCOUNT_PERCENT) // 100
+    return price
