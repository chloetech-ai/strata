+    def test_upcoming_excludes_past_and_cancelled(self):
+        cal = Calendar([
+            appt("past", utc(2027, 3, 1, 1)),
+            appt("cancelled", utc(2027, 3, 3, 1), status="cancelled"),
+            appt("attended", utc(2027, 3, 3, 2), status="attended"),
+            appt("next", utc(2027, 3, 3, 3)),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 0))], ["next"])
