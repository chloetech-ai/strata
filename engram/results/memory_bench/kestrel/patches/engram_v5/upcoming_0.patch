+    def test_upcoming_soonest_first(self):
+        cal = Calendar([
+            appt("a2", utc(2027, 3, 3, 1), patient="KP-000002"),
+            appt("a1", utc(2027, 3, 3, 3)),
+            appt("a3", utc(2027, 3, 2, 1)),
