+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 0))], ["a3", "a1"])
+
+    def test_upcoming_excludes_start_equal_to_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 1)), appt("a2", utc(2027, 3, 2, 2))])
+        self.assertEqual([a.id for a in cal.upcoming("KP-000001", utc(2027, 3, 2, 1))], ["a2"])
