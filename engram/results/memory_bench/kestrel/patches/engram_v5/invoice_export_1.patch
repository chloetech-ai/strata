+"""Exports for the accountant."""
+
+import csv
+import pathlib
+
+HEADER = ["Invoice number", "Clinic", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write one month's invoices to a CSV file in out_dir and return its path.
+
+    Only invoices issued in the given year and month are included. Dates are
+    DD/MM/YYYY and amounts are dollars with two decimals and no dollar sign.
+    Patients appear by ID only, never by name.
+    """
+    path = pathlib.Path(out_dir) / f"kestrel-invoices-{year:04d}-{month:02d}.csv"
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in invoices:
+            if invoice.issued.year != year or invoice.issued.month != month:
+                continue
+            writer.writerow([
+                invoice.number,
+                invoice.clinic,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                f"{invoice.amount_cents / 100:.2f}",
+            ])
+    return path
