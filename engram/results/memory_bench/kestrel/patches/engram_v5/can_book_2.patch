@@ -0,0 +1,56 @@
+"""Checks that run before a booking is saved."""
+
+import datetime
+
+from .calendar import CLINIC_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+DURATIONS = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Notes time a therapist needs after an assessment, before the next patient.
+ASSESSMENT_GAP = datetime.timedelta(minutes=15)
+SLOT_MINUTES = 15
+DAILY_CAP = 8  # patient appointments per therapist per day, union agreement
+
+
+def _end(appointment):
+    return appointment.start + DURATIONS[appointment.kind]
+
+
+def _gap_after(appointment):
+    return ASSESSMENT_GAP if appointment.kind == ASSESSMENT else datetime.timedelta(0)
+
+
+def _clear_of(earlier, later):
+    """True if later starts after earlier ends, plus any gap earlier needs."""
+    return later.start >= _end(earlier) + _gap_after(earlier)
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for the therapist.
+
+    Refuses an appointment for another therapist, one not starting on a quarter hour,
+    one that overlaps or leaves no notes gap after an assessment, and one that takes
+    the therapist past the daily cap on its Auckland local date.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    if local_start.minute % SLOT_MINUTES or local_start.second or local_start.microsecond:
+        return False
+
+    others = [
+        a for a in calendar.for_therapist(therapist.id)
+        if a.id != appointment.id and a.status != CANCELLED
+    ]
+    for other in others:
+        if other.start < appointment.start:
+            if not _clear_of(other, appointment):
+                return False
+        elif not _clear_of(appointment, other):
+            return False
+
+    same_day = [a for a in others if a.start.astimezone(CLINIC_TZ).date() == local_start.date()]
+    return len(same_day) < DAILY_CAP
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..b3c48b7
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,102 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import CLINIC_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+THERAPIST = Therapist("T1", "Ava Ruru", "HB")
+
+
+def local(hh, mm=0, day=1):
+    # 2027-03-01 is NZDT (UTC+13), so these are Auckland local times on that day.
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=CLINIC_TZ)
+
+
+def booking(id, start, kind=FOLLOWUP, therapist="T1", **kw):
+    return appt(id, start, kind=kind, therapist=therapist, **kw)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar_accepts_slot(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, booking("n", local(9))))
+
+    def test_other_therapists_appointment_is_not_a_clash(self):
+        cal = Calendar([booking("a", local(9), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9))))
+
+    def test_rejects_appointment_for_a_different_therapist(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, booking("n", local(9), therapist="T2")))
+
+    def test_rejects_start_off_the_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, booking("n", local(9, 10))))
+        self.assertFalse(can_book(Calendar(), THERAPIST, booking("n", local(9, 0).replace(second=30))))
+
+    def test_accepts_each_quarter_hour(self):
+        for mm in (0, 15, 30, 45):
+            self.assertTrue(can_book(Calendar(), THERAPIST, booking("n", local(9, mm))), mm)
+
+    def test_rejects_overlap_with_booked_followup(self):
+        cal = Calendar([booking("a", local(9))])  # 09:00 to 09:30
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9, 15))))
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(8, 45))))
+
+    def test_rejects_same_start(self):
+        cal = Calendar([booking("a", local(9))])
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9))))
+
+    def test_followup_back_to_back_is_allowed(self):
+        cal = Calendar([booking("a", local(9))])  # ends 09:30
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9, 30))))
+        self.assertTrue(can_book(Calendar([booking("a", local(10))]), THERAPIST, booking("n", local(9, 30))))
+
+    def test_assessment_needs_15_minute_gap_before_next_patient(self):
+        cal = Calendar([booking("a", local(9), kind=ASSESSMENT)])  # 09:00 to 09:45, gap to 10:00
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9, 45))))
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(10))))
+
+    def test_assessment_gap_applies_to_new_assessment_before_existing_appointment(self):
+        cal = Calendar([booking("a", local(10))])
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9, 30), kind=ASSESSMENT)))
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9, 15), kind=ASSESSMENT)))  # ends 10:00, no gap
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9), kind=ASSESSMENT)))  # ends 09:45, gap to 10:00
+
+    def test_followup_before_existing_assessment_needs_no_gap(self):
+        cal = Calendar([booking("a", local(10), kind=ASSESSMENT)])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9, 30))))
+
+    def test_new_assessment_overlapping_existing_followup_is_rejected(self):
+        cal = Calendar([booking("a", local(9, 30))])
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9), kind=ASSESSMENT)))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([booking("a", local(9))])
+        cal.cancel("a", datetime.datetime(2027, 2, 28, 12, 0, tzinfo=datetime.timezone.utc))
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9))))
+
+    def test_rebooking_same_appointment_id_does_not_clash_with_itself(self):
+        cal = Calendar([booking("a", local(9))])
+        self.assertTrue(can_book(cal, THERAPIST, booking("a", local(9))))
+
+    def test_daily_cap_of_eight(self):
+        cal = Calendar([booking(f"a{i}", local(8 + i // 2, 30 * (i % 2))) for i in range(7)])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(16))))
+        cal.add(booking("a7", local(16)))
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(17))))
+
+    def test_daily_cap_counts_auckland_local_date(self):
+        # Day two's local 08:00 to 15:00 starts fall on two UTC dates, so counting UTC dates would miss the cap.
+        full_day_two = [booking(f"b{i}", local(8 + i, day=2)) for i in range(8)]
+        cal = Calendar(full_day_two)
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(17, day=2))))
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(17, day=1))))
+
+    def test_daily_cap_ignores_cancelled(self):
+        cal = Calendar([booking(f"a{i}", local(8 + i)) for i in range(8)])
+        cal.cancel("a0", datetime.datetime(2027, 2, 28, 12, 0, tzinfo=datetime.timezone.utc))
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(17))))
+
+
+if __name__ == "__main__":
+    unittest.main()
