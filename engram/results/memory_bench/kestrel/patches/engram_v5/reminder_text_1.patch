+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Privacy rule: states only the date, the time and the clinic name. It never
+    mentions the treatment or any other purpose of the appointment.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    day = f"{local:%A} {local.day} {local:%B}"
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    time = f"{hour}:{local.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi, this is a friendly reminder of your appointment at {clinic} "
+        f"on {day} at {time}. We look forward to seeing you!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
