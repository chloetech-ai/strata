+"""Time intervals, such as a therapist's busy periods."""
+
+
+def merge_busy(intervals):
+    """Merge (start, end) pairs given in any order into sorted, non-overlapping pairs.
+
+    Pairs that touch (one ends where the next starts) are merged too.
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if end < start:
+            raise ValueError(f"interval ends before it starts: {(start, end)!r}")
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
