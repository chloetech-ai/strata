+"""SMS reminders sent to patients before their appointments."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS sent two days before an appointment.
+
+    Only the local Auckland date, the local time and the clinic name appear.
+    The treatment and the kind of appointment are left out on purpose.
+    """
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Hi from {clinic}! Friendly reminder of your appointment on "
+        f"{_date(local)} at {_time(local)}. To change it, please contact "
+        f"the clinic. See you then!"
+    )
+
+
+def _date(local):
+    # Written out by hand so the output does not depend on platform strftime flags.
+    return f"{local:%A} {local.day} {local:%B}"
+
+
+def _time(local):
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    return f"{hour}:{local.minute:02d}{suffix}"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
