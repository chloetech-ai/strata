+++ b/tests/test_reminders.py
@@ -0,0 +1,38 @@
+import unittest
+
+from helpers import appt, utc
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic_name(self):
+        # 2026-10-20 21:30 UTC is 2026-10-21 10:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 20, 21, 30), clinic="HB")
+        self.assertIn("Wednesday 21 October at 10:30am", reminder_text(a))
+        self.assertIn("Kestrel Physio Harbour", reminder_text(a))
+
+    def test_uses_clinic_name_for_each_clinic(self):
+        a = appt("A1", utc(2026, 10, 20, 21, 30), clinic="WK")
+        self.assertIn("Kestrel Physio Westwick", reminder_text(a))
+
+    def test_afternoon_and_midnight_hours(self):
+        afternoon = appt("A1", utc(2026, 10, 20, 2, 30))  # 15:30 Auckland
+        self.assertIn("at 3:30pm", reminder_text(afternoon))
+        midnight = appt("A2", utc(2026, 10, 19, 11, 0))  # 00:00 Auckland
+        self.assertIn("at 12:00am", reminder_text(midnight))
+
+    def test_does_not_mention_treatment_or_kind(self):
+        a = appt("A1", utc(2026, 10, 20, 21, 30), kind=ASSESSMENT, treatment="lower back pain")
+        text = reminder_text(a).lower()
+        self.assertNotIn("lower back", text)
+        self.assertNotIn("assessment", text)
+        self.assertNotIn("follow", text)
+
+    def test_does_not_mention_patient(self):
+        a = appt("A1", utc(2026, 10, 20, 21, 30), patient="KP-004211")
+        self.assertNotIn("KP-004211", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
