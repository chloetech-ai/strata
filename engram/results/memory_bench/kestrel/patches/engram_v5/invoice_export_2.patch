@@ -0,0 +1,76 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, cents=9500, patient_id="KP-004211", name="Aroha Test", description="Initial assessment"):
+    return Invoice(
+        number=number, clinic="HB", patient_id=patient_id, patient_name=name,
+        issued=issued, amount_cents=cents, description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_only_the_month_to_named_file(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1), cents=7000, description="Follow-up appointment"),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2026-10.csv")
+        self.assertEqual(os.path.dirname(path), self.out_dir)
+        self.assertEqual(self.read_rows(path), [
+            ["Invoice Number", "Patient ID", "Date", "Description", "Amount"],
+            ["INV-HB-2026-00002", "KP-004211", "01/10/2026", "Follow-up appointment", "70.00"],
+            ["INV-HB-2026-00003", "KP-004211", "31/10/2026", "Initial assessment", "95.00"],
+        ])
+
+    def test_never_writes_patient_names(self):
+        path = export_invoices(
+            [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 2), name="Aroha Test")], 2026, 10, self.out_dir,
+        )
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_amounts_are_plain_two_decimal_numbers(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 2), cents=5),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2), cents=12345),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))[1:]
+        self.assertEqual([r[4] for r in rows], ["0.05", "123.45"])
+
+    def test_rows_in_date_then_number_order(self):
+        invoices = [
+            invoice("INV-HB-2026-00009", datetime.date(2026, 10, 20)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 5)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 5)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out_dir))[1:]
+        self.assertEqual([r[0] for r in rows], ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00009"])
+
+    def test_month_with_no_invoices_has_header_only(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path), [["Invoice Number", "Patient ID", "Date", "Description", "Amount"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
