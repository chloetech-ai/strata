+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+
+# Columns for the accountant. Patient names never leave the system, so the
+# export carries the patient ID only.
+HEADER = ["Invoice Number", "Patient ID", "Date", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write one month's invoices to a CSV file in out_dir and return its path.
+
+    Invoices are included by their issue date. Dates are DD/MM/YYYY and amounts
+    are dollars with two decimals, e.g. 95.00.
+    """
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in month_invoices:
+            writer.writerow([
+                i.number,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                f"{i.amount_cents / 100:.2f}",
+            ])
+    return path
