+"""Cancellation and no-show fees for Kestrel Physio."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation less than this long before the start is a late cancellation.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for an appointment that was cancelled or missed.
+
+    A cancelled appointment takes cancelled_at, when the patient cancelled.
+    Cancelling less than 48 hours before the start costs 50% of the session
+    price; earlier cancellations are free. A no-show pays the full session
+    price; cancelled_at is None for a no-show.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no fee applies to status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled_at is required for a cancelled appointment")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..957d6ed
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,59 @@
+import unittest
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+from helpers import appt, utc
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2026, 10, 20, 9, 0)
+
+    def test_cancelling_less_than_48_hours_before_costs_half_the_price(self):
+        a = appt("A1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9, 1)), 3500)
+
+    def test_late_assessment_cancellation_costs_half_of_95_dollars(self):
+        a = appt("A1", self.start, kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 19, 0, 0)), 4750)
+
+    def test_cancelling_exactly_48_hours_before_is_free(self):
+        a = appt("A1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 18, 9, 0)), 0)
+
+    def test_cancelling_more_than_48_hours_before_is_free(self):
+        a = appt("A1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 10, 9, 0)), 0)
+
+    def test_cancelling_after_the_start_costs_half_the_price(self):
+        a = appt("A1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2026, 10, 20, 10, 0)), 3500)
+
+    def test_no_show_pays_the_full_follow_up_price(self):
+        a = appt("A1", self.start, kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_no_show_pays_the_full_assessment_price(self):
+        a = appt("A1", self.start, kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_cancelled_appointment_requires_cancelled_at(self):
+        a = appt("A1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_rejects_naive_cancelled_at(self):
+        a = appt("A1", self.start, kind=FOLLOWUP, status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, self.start.replace(tzinfo=None))
+
+    def test_rejects_statuses_with_no_fee(self):
+        for status in (BOOKED, ATTENDED):
+            with self.subTest(status=status):
+                a = appt("A1", self.start, kind=FOLLOWUP, status=status)
+                with self.assertRaises(ValueError):
+                    cancellation_fee(a, utc(2026, 10, 18, 9, 0))
+
+
+if __name__ == "__main__":
+    unittest.main()
