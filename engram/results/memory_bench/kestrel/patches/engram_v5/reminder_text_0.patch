+++ b/tests/test_reminders.py
@@ -0,0 +1,31 @@
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_states_local_date_time_and_clinic_name(self):
+        # 02:30 UTC on 20 October 2026 is 15:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 20, 2, 30), clinic="HB")
+        self.assertEqual(
+            reminder_text(a),
+            "Hi, this is a friendly reminder of your appointment at Kestrel Physio Harbour "
+            "on Tuesday 20 October at 15:30. See you then!",
+        )
+
+    def test_date_is_the_auckland_date_not_the_utc_date(self):
+        # 13:00 UTC on 19 October is already 02:00 on 20 October in Auckland.
+        a = appt("A1", utc(2026, 10, 19, 13, 0), clinic="NG")
+        self.assertIn("on Tuesday 20 October at 02:00", reminder_text(a))
+
+    def test_never_mentions_treatment_or_patient(self):
+        a = appt("A1", utc(2026, 10, 20, 2, 30), treatment="lower back pain", patient="KP-004211")
+        text = reminder_text(a)
+        self.assertNotIn("lower back", text)
+        self.assertNotIn("KP-004211", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
