+"""Text of the SMS reminders sent to patients."""
+
+from .calendar import CLINIC_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """Return the SMS reminder for an appointment, sent two days before it.
+
+    Only the date, the time and the clinic name appear. The treatment and any
+    other purpose of the appointment are never included.
+    """
+    local_start = appointment.start.astimezone(CLINIC_TZ)
+    date = f"{local_start.strftime('%A')} {local_start.day} {local_start.strftime('%B')}"
+    time = local_start.strftime("%H:%M")
+    clinic = CLINICS[appointment.clinic].name
+    return f"Hi, this is a friendly reminder of your appointment at {clinic} on {date} at {time}. See you then!"
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
