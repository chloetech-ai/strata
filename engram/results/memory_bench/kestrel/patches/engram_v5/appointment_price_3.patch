@@ -1,5 +1,8 @@
 """Session prices for Kestrel Physio."""
 
+import datetime
+
+from .calendar import CLINIC_TZ
 from .models import ASSESSMENT, FOLLOWUP
 
 # Prices in cents (NZD).
@@ -8,10 +11,34 @@ _PRICES = {
     FOLLOWUP: 7000,
 }
 
+# From this local Auckland date, appointments are charged the new prices.
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)
+_NEW_PRICES = {
+    ASSESSMENT: 10500,
+    FOLLOWUP: 7800,
+}
+
+# Patients holding a Community Services Card get this percentage off follow-ups.
+CSC_FOLLOW_UP_DISCOUNT_PERCENT = 20
+
 
-def session_price(kind):
-    """The price in cents for a session of the given kind."""
+def session_price(kind, day):
+    """The price in cents for a session of the given kind on a local Auckland date."""
     try:
-        return _PRICES[kind]
+        prices = _NEW_PRICES if day >= NEW_PRICES_FROM else _PRICES
+        return prices[kind]
     except KeyError:
         raise ValueError(f"unknown kind {kind!r}") from None
+
+
+def appointment_price(appointment, patient):
+    """What the patient pays for an appointment, in cents.
+
+    The price is set by the appointment's local Auckland date. A CSC discount
+    applies to follow-ups only.
+    """
+    day = appointment.start.astimezone(CLINIC_TZ).date()
+    price = session_price(appointment.kind, day)
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOW_UP_DISCOUNT_PERCENT) // 100
+    return price
