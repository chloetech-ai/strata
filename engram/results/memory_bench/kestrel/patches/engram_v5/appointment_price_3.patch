+class AppointmentPriceTest(unittest.TestCase):
+    def setUp(self):
+        self.standard = Patient(id="KP-004211", name="Ana", phone="+64211234567")
+        self.csc = Patient(id="KP-004211", name="Ana", phone="+64211234567", csc=True)
+
+    def test_standard_patient_pays_full_price(self):
+        start = datetime.datetime(2026, 10, 15, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), self.standard), 9500)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.standard), 7000)
+
+    def test_csc_patient_gets_20_percent_off_follow_up(self):
+        start = datetime.datetime(2026, 10, 15, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.csc), 5600)
+
+    def test_csc_patient_pays_full_price_for_assessment(self):
+        start = datetime.datetime(2026, 10, 15, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, start), self.csc), 9500)
+
+    def test_csc_discount_applies_to_new_follow_up_price(self):
+        start = datetime.datetime(2027, 4, 1, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(appointment(FOLLOWUP, start), self.csc), 6240)
+
+    def test_price_uses_the_local_auckland_date(self):
+        # 10:00 UTC on 31 March is 23:00 on 31 March in Auckland (NZDT), so the old price applies.
+        before = datetime.datetime(2027, 3, 31, 10, 0, tzinfo=datetime.timezone.utc)
+        # 12:00 UTC on 31 March is 01:00 on 1 April in Auckland, so the new price applies.
+        after = datetime.datetime(2027, 3, 31, 12, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, before), self.standard), 9500)
+        self.assertEqual(appointment_price(appointment(ASSESSMENT, after), self.standard), 10500)
+
+
+if __name__ == "__main__":
+    unittest.main()
