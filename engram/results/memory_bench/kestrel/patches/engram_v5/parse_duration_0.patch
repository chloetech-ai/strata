+"""Appointment lengths as typed in the booking form."""
+
+import re
+
+# "45m", "1h", "1h30", "1h 30m" or "1h30m". Minutes after an hour must be below 60.
+_DURATION = re.compile(r"(\d+)h(?:\s*(\d+)m?)?|(\d+)m")
+
+
+def parse_duration(text):
+    """Turn a duration such as '45m', '1h' or '1h 30m' into a number of minutes."""
+    match = _DURATION.fullmatch(text.strip()) if isinstance(text, str) else None
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes_after_hour, minutes_only = match.groups()
+    if minutes_only is not None:
+        return int(minutes_only)
+    minutes = int(minutes_after_hour or 0)
+    if minutes >= 60:
+        raise ValueError(f"minutes after an hour must be under 60: {text!r}")
+    return int(hours) * 60 + minutes
