@@ -0,0 +1,85 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-004211", description="Initial assessment", name="Aroha Test"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        patient_name=name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def read(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_only_the_requested_month_to_named_file(self):
+        invoices = [
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 1)),
+            invoice("INV-HB-2027-00002", datetime.date(2027, 4, 1)),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 31)),
+        ]
+        path = export_invoices(invoices, 2027, 3, self.dir.name)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2027-03.csv")
+        self.assertEqual(os.path.dirname(path), self.dir.name)
+        rows = self.read(path)
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2027-00001", "INV-HB-2027-00003"])
+
+    def test_header_dates_and_amounts(self):
+        invoices = [invoice("INV-HB-2027-00001", datetime.date(2027, 3, 5), amount_cents=7000, description="Follow-up appointment")]
+        rows = self.read(export_invoices(invoices, 2027, 3, self.dir.name))
+        self.assertEqual(rows[0], ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"])
+        self.assertEqual(rows[1], ["INV-HB-2027-00001", "KP-004211", "05/03/2027", "Follow-up appointment", "70.00"])
+
+    def test_amount_has_two_decimals_and_no_dollar_sign(self):
+        invoices = [
+            invoice("N1", datetime.date(2027, 3, 1), amount_cents=9505),
+            invoice("N2", datetime.date(2027, 3, 1), amount_cents=5),
+            invoice("N3", datetime.date(2027, 3, 1), amount_cents=0),
+        ]
+        rows = self.read(export_invoices(invoices, 2027, 3, self.dir.name))
+        self.assertEqual([r[4] for r in rows[1:]], ["95.05", "0.05", "0.00"])
+
+    def test_never_writes_patient_names(self):
+        invoices = [invoice("N1", datetime.date(2027, 3, 1), name="Aroha Test")]
+        path = export_invoices(invoices, 2027, 3, self.dir.name)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_rows_are_ordered_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2027-00002", datetime.date(2027, 3, 9)),
+            invoice("INV-HB-2027-00003", datetime.date(2027, 3, 2)),
+            invoice("INV-HB-2027-00001", datetime.date(2027, 3, 9)),
+        ]
+        rows = self.read(export_invoices(invoices, 2027, 3, self.dir.name))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2027-00003", "INV-HB-2027-00001", "INV-HB-2027-00002"])
+
+    def test_empty_month_writes_header_only(self):
+        rows = self.read(export_invoices([], 2027, 3, self.dir.name))
+        self.assertEqual(len(rows), 1)
+
+    def test_overwrites_existing_export(self):
+        export_invoices([invoice("N1", datetime.date(2027, 3, 1))], 2027, 3, self.dir.name)
+        path = export_invoices([], 2027, 3, self.dir.name)
+        self.assertEqual(len(self.read(path)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
