+"""Monthly export of invoices for the accountant."""
+
+import csv
+import os
+from decimal import Decimal
+
+HEADER = ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV file in out_dir.
+
+    Returns the path of the file. Only patient IDs are written, never names.
+    Dates are DD/MM/YYYY and amounts are plain dollars with two decimals.
+    """
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    month_invoices = [i for i in invoices if i.issued.year == year and i.issued.month == month]
+    month_invoices.sort(key=lambda i: (i.issued, i.number))
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in month_invoices:
+            writer.writerow([
+                i.number,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                format(Decimal(i.amount_cents) / 100, ".2f"),
+            ])
+    return path
