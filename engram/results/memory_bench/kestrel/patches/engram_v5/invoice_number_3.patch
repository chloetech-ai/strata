+MAX_SEQUENCE = 99999
+
+
+def next_invoice_number(clinic, year, existing):
+    """The next invoice number, INV-<clinic>-<year>-<sequence>, for a clinic and year.
+
+    The sequence counts separately per clinic and restarts at 00001 each year.
+    `existing` holds every invoice number issued so far; numbers for other
+    clinics or years are ignored.
+    """
+    pattern = re.compile(rf"INV-{re.escape(clinic)}-{year:04d}-(\d{{5}})")
+    sequences = [int(m.group(1)) for m in map(pattern.fullmatch, existing) if m]
+    sequence = max(sequences, default=0) + 1
+    if sequence > MAX_SEQUENCE:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"INV-{clinic}-{year:04d}-{sequence:05d}"
