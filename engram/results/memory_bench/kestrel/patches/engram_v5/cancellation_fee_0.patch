+"""Cancellation and no-show fees for Kestrel Physio."""
+
+import datetime
+
+from .models import CANCELLED, NO_SHOW
+from .pricing import session_price
+
+# A cancellation this close to the start (or later) is charged half price.
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """The fee in cents for an appointment that was cancelled or missed.
+
+    A cancelled appointment needs `cancelled_at`, the time the patient cancelled:
+    less than 48 hours before the start costs 50% of the session price, otherwise
+    there is no fee. A no-show pays the full session price and `cancelled_at`
+    is not used.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no cancellation fee for status {appointment.status!r}")
+    if cancelled_at is None:
+        raise ValueError("cancelled_at is required for a cancelled appointment")
+    if cancelled_at.tzinfo is None:
+        raise ValueError("cancelled_at must be timezone-aware")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
index 0000000..4bae676
--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,52 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_cancelled_under_48_hours_costs_half_the_price(self):
+        a = appt("a1", utc(2027, 3, 10, 20), kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 9, 21)), 4750)
+
+    def test_cancelled_exactly_48_hours_before_is_free(self):
+        a = appt("a1", utc(2027, 3, 10, 20), kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 20)), 0)
+
+    def test_cancelled_just_inside_48_hours_costs_half_the_price(self):
+        a = appt("a1", utc(2027, 3, 10, 20), kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 8, 20, 1)), 3500)
+
+    def test_cancelled_after_start_costs_half_the_price(self):
+        a = appt("a1", utc(2027, 3, 10, 20), kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 10, 21)), 3500)
+
+    def test_cancelled_well_ahead_is_free(self):
+        a = appt("a1", utc(2027, 3, 10, 20), kind=ASSESSMENT, status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, utc(2027, 3, 1, 9)), 0)
+
+    def test_cancelled_needs_cancelled_at(self):
+        a = appt("a1", utc(2027, 3, 10, 20), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a)
+
+    def test_cancelled_at_must_be_timezone_aware(self):
+        a = appt("a1", utc(2027, 3, 10, 20), status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 9, 21))
+
+    def test_no_show_pays_full_assessment_price(self):
+        a = appt("a1", utc(2027, 3, 10, 20), kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 9500)
+
+    def test_no_show_pays_full_follow_up_price(self):
+        a = appt("a1", utc(2027, 3, 10, 20), kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(a), 7000)
+
+    def test_booked_or_attended_has_no_cancellation_fee(self):
+        for status in (BOOKED, ATTENDED):
+            a = appt("a1", utc(2027, 3, 10, 20), status=status)
+            with self.assertRaises(ValueError):
+                cancellation_fee(a)
