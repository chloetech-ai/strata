diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index cf3b87d..f889bf4 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -44,5 +44,12 @@ class Waitlist:
         """Urgent entries first, then everyone else; each group in the order they asked."""
         return sorted(self._entries, key=lambda e: (not e.urgent, e.requested_at))
 
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody waits for that kind."""
+        for e in self.entries():
+            if e.kind == kind:
+                return e
+        return None
+
     def __len__(self):
         return len(self._entries)
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index bb87181..a252fef 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -52,6 +52,32 @@ class WaitlistTest(unittest.TestCase):
         wl.add(entry("KP-000001", day=1))
         self.assertEqual([e.patient_id for e in wl.entries()], ["KP-000002", "KP-000001"])
 
+    def test_next_for_takes_urgent_entry_of_that_kind_first(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", day=1, kind="followup"))
+        wl.add(entry("KP-000002", day=2, kind="followup", urgent=True))
+        wl.add(entry("KP-000003", day=3, kind="assessment"))
+        self.assertEqual(wl.next_for("followup").patient_id, "KP-000002")
+
+    def test_next_for_takes_earliest_request_of_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000003", day=3, kind="assessment"))
+        wl.add(entry("KP-000002", day=2, kind="assessment"))
+        wl.add(entry("KP-000001", day=1, kind="followup"))
+        self.assertEqual(wl.next_for("assessment").patient_id, "KP-000002")
+
+    def test_next_for_does_not_remove_the_entry(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", day=1))
+        wl.next_for("followup")
+        self.assertEqual(len(wl), 1)
+
+    def test_next_for_none_when_nobody_waits_for_that_kind(self):
+        wl = Waitlist()
+        wl.add(entry("KP-000001", day=1, kind="followup"))
+        self.assertIsNone(wl.next_for("assessment"))
+        self.assertIsNone(Waitlist().next_for("followup"))
+
     def test_add_normalizes_patient_id(self):
         wl = Waitlist()
         wl.add(entry("kp4211"))
