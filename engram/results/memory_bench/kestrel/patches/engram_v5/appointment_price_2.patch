+from kestrel.models import ASSESSMENT, FOLLOWUP, Appointment, Patient
+from kestrel.pricing import appointment_price, session_price
+
+BEFORE_RISE = datetime.date(2027, 3, 31)
+ON_RISE = datetime.date(2027, 4, 1)
+TODAY = datetime.date(2026, 10, 15)
 
 
 class SessionPriceTest(unittest.TestCase):
     def test_initial_assessment_is_95_dollars(self):
-        self.assertEqual(session_price(ASSESSMENT), 9500)
+        self.assertEqual(session_price(ASSESSMENT, TODAY), 9500)
 
     def test_follow_up_is_70_dollars(self):
-        self.assertEqual(session_price(FOLLOWUP), 7000)
+        self.assertEqual(session_price(FOLLOWUP, TODAY), 7000)
+
+    def test_old_prices_apply_before_1_april_2027(self):
+        self.assertEqual(session_price(ASSESSMENT, BEFORE_RISE), 9500)
+        self.assertEqual(session_price(FOLLOWUP, BEFORE_RISE), 7000)
+
+    def test_new_prices_apply_from_1_april_2027(self):
+        self.assertEqual(session_price(ASSESSMENT, ON_RISE), 10500)
+        self.assertEqual(session_price(FOLLOWUP, ON_RISE), 7800)
 
     def test_rejects_unknown_kind(self):
         with self.assertRaises(ValueError):
-            session_price("massage")
+            session_price("massage", TODAY)
+
+
+def _appointment(kind, start=datetime.datetime(2026, 10, 15, 10, 0, tzinfo=datetime.timezone.utc)):
+    return Appointment(
+        id="A1", patient_id="KP-004211", therapist_id="T1", clinic="NG",
+        start=start, kind=kind,
+    )
+
+
+def _patient(csc):
+    return Patient(id="KP-004211", name="Test", phone="+64211234567", csc=csc)
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def test_standard_patient_pays_session_price(self):
+        self.assertEqual(appointment_price(_appointment(ASSESSMENT), _patient(False)), 9500)
+        self.assertEqual(appointment_price(_appointment(FOLLOWUP), _patient(False)), 7000)
+
+    def test_csc_patient_gets_20_percent_off_follow_up(self):
+        self.assertEqual(appointment_price(_appointment(FOLLOWUP), _patient(True)), 5600)
+
+    def test_csc_patient_pays_full_price_for_assessment(self):
+        self.assertEqual(appointment_price(_appointment(ASSESSMENT), _patient(True)), 9500)
+
+    def test_csc_discount_applies_to_new_follow_up_price(self):
+        start = datetime.datetime(2027, 6, 1, 10, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(_appointment(FOLLOWUP, start), _patient(True)), 6240)
+
+    def test_cutover_uses_auckland_local_date(self):
+        # 2027-03-31 10:30 UTC is 23:30 on 31 March in Auckland (NZDT, UTC+13): old price.
+        before = datetime.datetime(2027, 3, 31, 10, 30, tzinfo=datetime.timezone.utc)
+        # 2027-03-31 11:30 UTC is 00:30 on 1 April in Auckland: new price.
+        after = datetime.datetime(2027, 3, 31, 11, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(_appointment(FOLLOWUP, before), _patient(False)), 7000)
+        self.assertEqual(appointment_price(_appointment(FOLLOWUP, after), _patient(False)), 7800)
+
+    def test_rejects_appointment_for_another_patient(self):
+        other = Patient(id="KP-000001", name="Other", phone="+64211234567")
+        with self.assertRaises(ValueError):
+            appointment_price(_appointment(FOLLOWUP), other)
