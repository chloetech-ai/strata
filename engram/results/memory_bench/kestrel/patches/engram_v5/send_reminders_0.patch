@@ -0,0 +1,28 @@
+"""Appointment reminders sent by SMS."""
+
+from .calendar import CLINIC_TZ
+from .ids import normalize_patient_id
+from .models import BOOKED, CLINICS
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS to the patient of each booked appointment; return how many were sent.
+
+    patients maps patient ID to Patient. Every message is built before anything is
+    sent, so a missing patient or clinic raises without sending any reminders.
+    """
+    messages = []
+    for appointment in appointments:
+        if appointment.status != BOOKED:
+            continue
+        patient = patients[normalize_patient_id(appointment.patient_id)]
+        messages.append((patient.phone, _reminder_text(appointment)))
+    client.send_batch(messages)
+    return len(messages)
+
+
+def _reminder_text(appointment):
+    # Privacy rule: state only the date, time and clinic name, never the treatment.
+    local = appointment.start.astimezone(CLINIC_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: you have an appointment at {clinic} on {local:%d/%m/%Y} at {local:%H:%M}."
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..2f2bfbc
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,74 @@
+import unittest
+
+from kestrel.models import CANCELLED, ATTENDED, Patient
+from kestrel.reminders import send_reminders
+from helpers import appt, utc
+
+
+class FakeClient:
+    def __init__(self):
+        self.batches = []
+
+    def send_batch(self, messages):
+        self.batches.append(list(messages))
+        return [{"ok": True}]
+
+
+PATIENTS = {
+    "KP-004211": Patient("KP-004211", "Alex Example", "+64211234567"),
+    "KP-000002": Patient("KP-000002", "Sam Sample", "+64217654321"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_sms_per_booked_appointment_and_counts_them(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2026, 10, 14, 21, 30), patient="KP-004211", treatment="lower back pain"),
+            appt("a2", utc(2026, 10, 15, 2, 0), patient="KP-000002"),
+        ]
+        sent = send_reminders(appointments, PATIENTS, client)
+        self.assertEqual(sent, 2)
+        self.assertEqual(len(client.batches), 1)
+        self.assertEqual([phone for phone, _ in client.batches[0]], ["+64211234567", "+64217654321"])
+
+    def test_skips_appointments_that_are_not_booked(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 1, 0), patient="KP-004211"),
+            appt("a2", utc(2026, 10, 20, 2, 0), patient="KP-000002", status=CANCELLED),
+            appt("a3", utc(2026, 10, 20, 3, 0), patient="KP-000002", status=ATTENDED),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, client), 1)
+        self.assertEqual(len(client.batches[0]), 1)
+
+    def test_text_gives_local_date_and_time_and_clinic_only(self):
+        client = FakeClient()
+        send_reminders([appt("a1", utc(2026, 10, 14, 21, 30), patient="KP-004211", clinic="HB", treatment="lower back pain")], PATIENTS, client)
+        (_, text), = client.batches[0]
+        self.assertEqual(text, "Reminder: you have an appointment at Kestrel Physio Harbour on 15/10/2026 at 10:30.")
+        self.assertNotIn("lower back", text)
+
+    def test_patient_id_is_normalized_before_lookup(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([appt("a1", utc(2026, 10, 20, 1, 0), patient="kp4211")], PATIENTS, client), 1)
+        self.assertEqual(client.batches[0][0][0], "+64211234567")
+
+    def test_missing_patient_raises_before_anything_is_sent(self):
+        client = FakeClient()
+        appointments = [
+            appt("a1", utc(2026, 10, 20, 1, 0), patient="KP-000002"),
+            appt("a2", utc(2026, 10, 20, 2, 0), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, client)
+        self.assertEqual(client.batches, [])
+
+    def test_no_appointments_sends_nothing(self):
+        client = FakeClient()
+        self.assertEqual(send_reminders([], PATIENTS, client), 0)
+        self.assertEqual(client.batches, [[]])
+
+
+if __name__ == "__main__":
+    unittest.main()
