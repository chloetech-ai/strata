+"""Exports for the accountant."""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write one month's invoices to a CSV file in out_dir and return its path.
+
+    Only invoices issued in the given year and month (local Auckland dates) are
+    included. Patient names are left out; each row carries the patient ID only.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in chosen:
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                f"{invoice.amount_cents / 100:.2f}",
+            ])
+    return path
