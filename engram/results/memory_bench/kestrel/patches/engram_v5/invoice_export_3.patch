@@ -0,0 +1,72 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, cents, patient_id="KP-004211", name="Aroha Test", description="Initial assessment"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        patient_name=name,
+        issued=issued,
+        amount_cents=cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_writes_only_the_requested_month_with_header(self):
+        invoices = [
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 20), 9500),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), 7000, description="Follow-up appointment"),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 9, 30), 7000),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1), 7000),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.dir.name)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2026-10.csv")
+        self.assertEqual(
+            self.read_rows(path),
+            [
+                ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"],
+                ["INV-HB-2026-00001", "KP-004211", "03/10/2026", "Follow-up appointment", "70.00"],
+                ["INV-HB-2026-00002", "KP-004211", "20/10/2026", "Initial assessment", "95.00"],
+            ],
+        )
+
+    def test_never_writes_patient_names(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), 9500, name="Aroha Test")]
+        path = export_invoices(invoices, 2026, 10, self.dir.name)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Aroha", f.read())
+
+    def test_amounts_have_two_decimals_and_no_dollar_sign(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), 10005)]
+        path = export_invoices(invoices, 2026, 10, self.dir.name)
+        self.assertEqual(self.read_rows(path)[1][4], "100.05")
+
+    def test_month_with_no_invoices_has_only_header(self):
+        path = export_invoices([], 2026, 10, self.dir.name)
+        self.assertEqual(self.read_rows(path), [["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"]])
+
+    def test_quotes_fields_containing_commas(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), 7000, description="Follow-up, long session")]
+        path = export_invoices(invoices, 2026, 10, self.dir.name)
+        self.assertEqual(self.read_rows(path)[1][3], "Follow-up, long session")
+
+
+if __name__ == "__main__":
+    unittest.main()
