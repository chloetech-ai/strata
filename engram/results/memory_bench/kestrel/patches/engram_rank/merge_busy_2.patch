+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_single_pair(self):
+        self.assertEqual(merge_busy([(1, 2)]), [(1, 2)])
+
+    def test_sorts_out_of_order_input(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_pairs_merge(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_pair_does_not_shorten_merged_pair(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_chain_of_overlaps_merges_into_one(self):
+        self.assertEqual(merge_busy([(4, 5), (1, 2), (2, 3), (3, 4)]), [(1, 5)])
+
+    def test_disjoint_pairs_stay_separate(self):
+        self.assertEqual(merge_busy([(1, 2), (4, 5), (7, 8)]), [(1, 2), (4, 5), (7, 8)])
+
+    def test_does_not_modify_input(self):
+        pairs = [(3, 4), (1, 2)]
+        merge_busy(pairs)
+        self.assertEqual(pairs, [(3, 4), (1, 2)])
+
+
+if __name__ == "__main__":
+    unittest.main()
