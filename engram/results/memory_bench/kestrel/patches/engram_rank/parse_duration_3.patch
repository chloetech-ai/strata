@@ -0,0 +1,21 @@
+"""Reading the durations that reception types in by hand."""
+
+import re
+
+_DURATION = re.compile(
+    r"(?:(?P<hours>[0-9]+)h\s*(?:(?P<h_minutes>[0-9]+)m?)?|(?P<minutes>[0-9]+)m)",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes."""
+    match = _DURATION.fullmatch(text.strip()) if isinstance(text, str) else None
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    if match.group("minutes") is not None:
+        return int(match.group("minutes"))
+    minutes = int(match.group("h_minutes") or 0)
+    if minutes > 59:
+        raise ValueError(f"minutes after hours must be under 60: {text!r}")
+    return int(match.group("hours")) * 60 + minutes
