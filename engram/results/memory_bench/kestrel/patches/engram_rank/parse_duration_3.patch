@@ -0,0 +1,47 @@
+import unittest
+
+from kestrel.intervals import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_minutes_only(self):
+        self.assertEqual(parse_duration("45m"), 45)
+
+    def test_hours_only(self):
+        self.assertEqual(parse_duration("1h"), 60)
+
+    def test_hours_then_bare_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+
+    def test_hours_with_space_then_minutes(self):
+        self.assertEqual(parse_duration("1h 30m"), 90)
+
+    def test_hours_then_minutes_with_unit(self):
+        self.assertEqual(parse_duration("1h30m"), 90)
+
+    def test_surrounding_whitespace_and_case(self):
+        self.assertEqual(parse_duration(" 2H 15M "), 135)
+
+    def test_rejects_bare_number(self):
+        with self.assertRaises(ValueError):
+            parse_duration("30")
+
+    def test_rejects_minutes_of_sixty_or_more_after_hours(self):
+        with self.assertRaises(ValueError):
+            parse_duration("1h90")
+
+    def test_rejects_empty(self):
+        with self.assertRaises(ValueError):
+            parse_duration("   ")
+
+    def test_rejects_words(self):
+        with self.assertRaises(ValueError):
+            parse_duration("forty-five minutes")
+
+    def test_rejects_negative(self):
+        with self.assertRaises(ValueError):
+            parse_duration("-45m")
+
+    def test_rejects_non_string(self):
+        with self.assertRaises(ValueError):
+            parse_duration(45)
