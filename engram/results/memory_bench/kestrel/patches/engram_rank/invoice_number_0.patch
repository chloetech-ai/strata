+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_increments_the_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00007", "INV-WK-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00008")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_uses_highest_sequence_not_count(self):
+        # A gap (say an invoice was deleted) must not make a number get reused.
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00005"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00006")
+
+    def test_ignores_numbers_that_are_not_in_the_format(self):
+        existing = ["INV-HB-2027-0001", "INV-HB-2027-abcde", "INV-HB-2027-00002x", "INV-HB-202700009"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_does_not_match_a_longer_clinic_code(self):
+        existing = ["INV-HBX-2027-00009"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-WK-2027-00004"])
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00005")
+
+    def test_raises_when_the_year_is_full(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
