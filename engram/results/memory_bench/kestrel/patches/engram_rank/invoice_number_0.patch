+def next_invoice_number(clinic, year, existing):
+    """Next number in the INV-<clinic>-<year>-<sequence> form, e.g. INV-HB-2027-00042.
+
+    The sequence is counted per clinic and restarts at 00001 each year. It is one
+    more than the highest sequence already issued for this clinic and year, so a
+    gap or a deleted invoice never causes a number to be reused. ``existing`` may
+    hold numbers from any clinic or year; other ones are ignored.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        if not number.startswith(prefix):
+            continue
+        sequence = number[len(prefix):]
+        if len(sequence) == 5 and sequence.isdigit():
+            highest = max(highest, int(sequence))
+    if highest + 1 > 99999:
+        raise ValueError(f"no invoice numbers left for {clinic} in {year}")
+    return f"{prefix}{highest + 1:05d}"
