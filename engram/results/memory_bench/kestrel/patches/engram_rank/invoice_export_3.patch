@@ -0,0 +1,102 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-004211", patient_name="", description="Physiotherapy assessment session"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        patient_name=patient_name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_filename_is_kestrel_invoices_year_month(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2026-10.csv")
+        self.assertEqual(os.path.dirname(path), self.out_dir)
+        self.assertTrue(os.path.exists(path))
+
+    def test_writes_header_row_first(self):
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path), [["InvoiceNumber", "ContactName", "InvoiceDate", "Total", "Description"]])
+
+    def test_only_includes_invoices_from_that_month(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00005", datetime.date(2025, 10, 15)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        numbers = [row[0] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_dates_are_dd_mm_yyyy(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 5))], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][2], "05/10/2026")
+
+    def test_amounts_are_two_decimals_without_dollar_sign(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), amount_cents=9500),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1), amount_cents=5600),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 1), amount_cents=7),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 10, 1), amount_cents=10500),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        totals = [row[3] for row in self.read_rows(path)[1:]]
+        self.assertEqual(totals, ["95.00", "56.00", "0.07", "105.00"])
+
+    def test_amount_formatting_has_no_float_error(self):
+        # 0.29 * 100 is 28.999... as a float; integer cents must still give 0.29.
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), amount_cents=29)], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][3], "0.29")
+
+    def test_patient_name_is_never_written(self):
+        inv = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), patient_name="Test Patient")
+        path = export_invoices([inv], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            contents = f.read()
+        self.assertNotIn("Test Patient", contents)
+        self.assertEqual(self.read_rows(path)[1][1], "KP-004211")
+
+    def test_description_with_comma_is_quoted(self):
+        inv = invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), description="Physiotherapy, follow-up session")
+        path = export_invoices([inv], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][4], "Physiotherapy, follow-up session")
+
+    def test_rows_are_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 2)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1)),
+        ]
+        path = export_invoices(invoices, 2026, 10, self.out_dir)
+        numbers = [row[0] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2026-00001", "INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+
+if __name__ == "__main__":
+    unittest.main()
