+"""Monthly export of invoices for the accountant (imported into Xero)."""
+
+import csv
+import os
+
+HEADER = ["InvoiceNumber", "ContactName", "InvoiceDate", "Total", "Description"]
+
+
+def _money(cents):
+    """Plain amount with two decimals and no dollar sign, from integer cents."""
+    sign = "-" if cents < 0 else ""
+    dollars, rem = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{rem:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV in out_dir and return its path.
+
+    Only the patient ID leaves the system: the ContactName column holds the
+    patient ID, never the patient's name.
+    """
+    month_invoices = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for i in month_invoices:
+            writer.writerow([
+                i.number,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                _money(i.amount_cents),
+                i.description,
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
