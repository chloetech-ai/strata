@@ -0,0 +1,47 @@
+"""Booking rules: whether a new appointment may be added to a therapist's calendar."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Appointment lengths in minutes, by kind.
+DURATIONS = {ASSESSMENT: 45, FOLLOWUP: 30}
+# Gap after an assessment so the therapist can write notes before the next patient.
+ASSESSMENT_GAP = datetime.timedelta(minutes=15)
+# Union agreement: at most this many patient appointments per therapist per day.
+DAILY_LIMIT = 8
+
+
+def _blocked_until(appointment):
+    """When an appointment stops blocking the therapist, including any gap after it."""
+    end = appointment.start + datetime.timedelta(minutes=DURATIONS[appointment.kind])
+    if appointment.kind == ASSESSMENT:
+        end += ASSESSMENT_GAP
+    return end
+
+
+def can_book(calendar, therapist, appointment):
+    """True if `appointment` can be added to `calendar` for `therapist`.
+
+    Checks that it is for this therapist, starts on a quarter hour (local time),
+    does not overlap another live appointment (including the gap after an
+    assessment), and keeps the therapist within the daily limit.
+    """
+    if appointment.therapist_id != therapist.id:
+        return False
+    local_start = appointment.start.astimezone(LOCAL_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    day = local_start.date()
+    new_end = _blocked_until(appointment)
+    same_day = 0
+    for other in calendar.for_therapist(therapist.id):
+        if other.id == appointment.id or other.status == CANCELLED:
+            continue
+        if other.start.astimezone(LOCAL_TZ).date() == day:
+            same_day += 1
+        if appointment.start < _blocked_until(other) and other.start < new_end:
+            return False
+    return same_day < DAILY_LIMIT
diff --git a/tests/test_booking.py b/tests/test_booking.py
new file mode 100644
index 0000000..b78bba5
--- /dev/null
+++ b/tests/test_booking.py
@@ -0,0 +1,82 @@
+import datetime
+from zoneinfo import ZoneInfo
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import Calendar
+from kestrel.models import Therapist
+
+LOCAL = ZoneInfo("Pacific/Auckland")
+THERAPIST = Therapist("T1", "Sam", "HB")
+
+
+def local(y, m, d, hh=0, mm=0):
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=LOCAL)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar_allows_booking(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, appt("new", local(2027, 3, 1, 9).astimezone(datetime.timezone.utc))))
+
+    def test_rejects_other_therapists_appointment(self):
+        new = appt("new", local(2027, 3, 1, 9), therapist="T2")
+        self.assertFalse(can_book(Calendar(), THERAPIST, new))
+
+    def test_rejects_start_off_the_quarter_hour(self):
+        new = appt("new", local(2027, 3, 1, 9, 10))
+        self.assertFalse(can_book(Calendar(), THERAPIST, new))
+
+    def test_overlapping_followup_rejected(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind="followup")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 9, 15))))
+
+    def test_back_to_back_followups_allowed(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind="followup")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 9, 30))))
+
+    def test_assessment_gap_blocks_next_appointment(self):
+        # Assessment 09:00-09:45 plus a 15-minute gap, so 10:00 is the first free start.
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind="assessment")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 9, 45))))
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 9, 45), kind="followup")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 10))))
+
+    def test_new_assessment_needs_gap_before_next_existing_appointment(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 10), kind="followup")])
+        # A 45-minute assessment at 09:15 would end 10:00, and its 15-minute gap runs into 10:00.
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 9, 15), kind="assessment")))
+        # At 09:00 it ends 09:45 and its gap ends 10:00, exactly when the next appointment starts.
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 9), kind="assessment")))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), status="cancelled", cancelled_at=utc(2027, 2, 1))])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 9))))
+
+    def test_appointment_does_not_clash_with_itself(self):
+        existing = appt("a1", local(2027, 3, 1, 9))
+        cal = Calendar([existing])
+        self.assertTrue(can_book(cal, THERAPIST, existing))
+
+    def test_daily_limit_of_eight(self):
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 8 + i // 2, 30 * (i % 2))) for i in range(8)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 14))))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local(2027, 3, 2, 9))))
+
+    def test_cancelled_appointments_do_not_count_toward_daily_limit(self):
+        cal = Calendar([
+            appt(f"a{i}", local(2027, 3, 1, 8 + i // 2, 30 * (i % 2)), status="cancelled", cancelled_at=utc(2027, 2, 1))
+            for i in range(8)
+        ])
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 14))))
+
+    def test_daily_limit_uses_auckland_date(self):
+        # 23:00 Auckland on 1 March is 10:00 UTC on 1 March; 08:00 Auckland on 2 March is 19:00 UTC on 1 March.
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 9 + i), kind="followup") for i in range(7)])
+        cal.add(appt("late", local(2027, 3, 1, 23)))
+        self.assertTrue(can_book(cal, THERAPIST, appt("new", local(2027, 3, 2, 8))))
+        self.assertFalse(can_book(cal, THERAPIST, appt("new", local(2027, 3, 1, 22))))
+
+
+if __name__ == "__main__":
+    unittest.main()
