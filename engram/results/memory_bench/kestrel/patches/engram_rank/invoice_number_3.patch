+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_sequence(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00002", "INV-HB-2027-00041"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00042")
+
+    def test_does_not_reuse_a_gap(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00003"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00004")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00007", "INV-WK-2027-00009"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00008")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_years_when_numbering_this_year(self):
+        existing = ["INV-HB-2026-00150", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_ignores_numbers_not_in_the_form(self):
+        existing = [
+            "INV-HB-2027-42",          # sequence not five digits
+            "INV-HB-2027-000001",      # six digits
+            "INV-HB-2027-0000A",       # not digits
+            "INV-HBX-2027-00009",      # different clinic code
+            "XINV-HB-2027-00009",
+            "INV-HB-2027-00002-X",
+        ]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_raises_when_the_year_sequence_is_used_up(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
