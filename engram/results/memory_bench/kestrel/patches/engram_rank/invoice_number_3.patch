+def next_invoice_number(clinic, year, existing):
+    """Next number in INV-<clinic>-<year>-<sequence> form.
+
+    The sequence is five digits, counted per clinic and restarting at 00001
+    each year. `existing` is every invoice number issued so far, for any clinic
+    and year; numbers that do not fit the form are ignored. The next number is
+    one past the highest sequence used, so gaps are never reused.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        if not number.startswith(prefix):
+            continue
+        digits = number[len(prefix):]
+        if len(digits) == 5 and digits.isdigit() and digits.isascii():
+            highest = max(highest, int(digits))
+    if highest >= 99999:
+        raise ValueError(f"invoice sequence for {clinic} {year} is exhausted")
+    return f"{prefix}{highest + 1:05d}"
