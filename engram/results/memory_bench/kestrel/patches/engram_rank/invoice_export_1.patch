+"""Monthly export of invoices for the accountant, as a CSV that Xero imports."""
+
+import csv
+import io
+import os
+
+from .storage import _write_atomic
+
+COLUMNS = ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"]
+
+
+def _format_amount(cents):
+    """Plain two-decimal amount from integer cents, e.g. 9500 -> '95.00', -250 -> '-2.50'."""
+    sign = "-" if cents < 0 else ""
+    dollars, remainder = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{remainder:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir and return the file's path.
+
+    Only the patient ID leaves the system, never a name. Dates are DD/MM/YYYY and
+    amounts are plain two-decimal numbers, as Xero's import expects.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(COLUMNS)
+    for invoice in chosen:
+        writer.writerow([
+            invoice.number,
+            invoice.patient_id,
+            invoice.issued.strftime("%d/%m/%Y"),
+            invoice.description,
+            1,
+            _format_amount(invoice.amount_cents),
+        ])
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    _write_atomic(path, buf.getvalue())
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..bc19403
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,96 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import _format_amount, export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-004211", description="Physiotherapy follow-up session"):
+    return Invoice(
+        number=number, clinic="HB", patient_id=patient_id, patient_name="",
+        issued=issued, amount_cents=amount_cents, description=description,
+    )
+
+
+class FormatAmountTest(unittest.TestCase):
+    def test_two_decimals_no_dollar_sign(self):
+        self.assertEqual(_format_amount(9500), "95.00")
+        self.assertEqual(_format_amount(7800), "78.00")
+        self.assertEqual(_format_amount(5), "0.05")
+        self.assertEqual(_format_amount(0), "0.00")
+
+    def test_negative_amount(self):
+        self.assertEqual(_format_amount(-250), "-2.50")
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.out_dir = self._tmp.name
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_file_name_and_return_value(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        self.assertEqual(path, os.path.join(self.out_dir, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.isfile(path))
+
+    def test_writes_header_then_one_row_per_invoice(self):
+        path = export_invoices([
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 9), amount_cents=7800),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), amount_cents=9500),
+        ], 2026, 10, self.out_dir)
+        rows = self.read_rows(path)
+        self.assertEqual(rows[0], ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"])
+        self.assertEqual(rows[1], ["INV-HB-2026-00001", "KP-004211", "03/10/2026", "Physiotherapy follow-up session", "1", "95.00"])
+        self.assertEqual(rows[2], ["INV-HB-2026-00002", "KP-004211", "09/10/2026", "Physiotherapy follow-up session", "1", "78.00"])
+        self.assertEqual(len(rows), 3)
+
+    def test_only_the_requested_month_is_exported(self):
+        path = export_invoices([
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00005", datetime.date(2025, 10, 15)),
+        ], 2026, 10, self.out_dir)
+        numbers = [row[0] for row in self.read_rows(path)[1:]]
+        self.assertEqual(numbers, ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_empty_month_writes_header_only(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 9, 1))], 2026, 10, self.out_dir)
+        self.assertEqual(len(self.read_rows(path)), 1)
+
+    def test_uses_patient_id_and_never_a_name(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertIn("KP-004211", text)
+        self.assertNotIn("Test Patient", text)
+
+    def test_description_with_comma_is_quoted(self):
+        path = export_invoices([
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), description="Physiotherapy, follow-up"),
+        ], 2026, 10, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][3], "Physiotherapy, follow-up")
+
+    def test_date_is_day_month_year(self):
+        path = export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 1, 2))], 2026, 1, self.out_dir)
+        self.assertEqual(self.read_rows(path)[1][2], "02/01/2026")
+
+    def test_overwrites_an_existing_export(self):
+        export_invoices([invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3))], 2026, 10, self.out_dir)
+        path = export_invoices([], 2026, 10, self.out_dir)
+        self.assertEqual(len(self.read_rows(path)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
