index ef522e6..76226b6 100644
--- a/src/kestrel/pricing.py
+++ b/src/kestrel/pricing.py
@@ -1,11 +1,22 @@
 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+# Prices from PRICE_CHANGE_DATE, by Auckland local date of the appointment start.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
 CSC_FOLLOWUP_PERCENT_OFF = 20  # CSC holders: follow-ups only, not assessments
 
 
@@ -17,9 +28,25 @@ def session_price(kind):
         raise ValueError(f"unknown kind {kind!r}") from None
 
 
-def price_for(patient, kind):
-    """Price in cents for this patient, after any Community Services Card discount."""
-    price = session_price(kind)
+def _after_csc_discount(price, patient, kind):
     if patient.csc and kind == FOLLOWUP:
         price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
     return price
+
+
+def price_for(patient, kind):
+    """Price in cents for this patient, after any Community Services Card discount."""
+    return _after_csc_discount(session_price(kind), patient, kind)
+
+
+def appointment_price(appointment, patient):
+    """Price in cents the patient pays for this appointment.
+
+    The price schedule is chosen by the appointment's Auckland local start date,
+    not its UTC date, so an appointment on 1 April 2027 local time uses the new prices.
+    """
+    local_date = appointment.start.astimezone(LOCAL_TZ).date()
+    prices = NEW_PRICES_CENTS if local_date >= PRICE_CHANGE_DATE else PRICES_CENTS
+    if appointment.kind not in prices:
+        raise ValueError(f"unknown kind {appointment.kind!r}")
+    return _after_csc_discount(prices[appointment.kind], patient, appointment.kind)
