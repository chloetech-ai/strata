             session_price("massage")
 
 
+class AppointmentPriceTest(unittest.TestCase):
+    def patient(self, csc=False):
+        return Patient("KP-004211", "Test Patient", "+64211234567", csc=csc)
+
+    def appt(self, kind, start):
+        return Appointment("a1", "KP-004211", "T1", "NG", start, kind)
+
+    def utc(self, *args):
+        return datetime.datetime(*args, tzinfo=datetime.timezone.utc)
+
+    def test_before_price_change_pays_old_prices(self):
+        start = self.utc(2027, 3, 1, 1)  # 1 March 2027 14:00 Auckland
+        self.assertEqual(appointment_price(self.appt("assessment", start), self.patient()), 9500)
+        self.assertEqual(appointment_price(self.appt("followup", start), self.patient()), 7000)
+
+    def test_from_price_change_pays_new_prices(self):
+        start = self.utc(2027, 5, 1, 1)  # 1 May 2027 13:00 Auckland
+        self.assertEqual(appointment_price(self.appt("assessment", start), self.patient()), 10500)
+        self.assertEqual(appointment_price(self.appt("followup", start), self.patient()), 7800)
+
+    def test_cutoff_uses_auckland_date_not_utc_date(self):
+        # 31 March 2027 23:59 Auckland (NZDT, UTC+13) is 10:59 UTC: still the old price.
+        last_old = self.utc(2027, 3, 31, 10, 59)
+        self.assertEqual(appointment_price(self.appt("followup", last_old), self.patient()), 7000)
+        # 1 April 2027 00:00 Auckland is 11:00 UTC on 31 March: already the new price.
+        first_new = self.utc(2027, 3, 31, 11, 0)
+        self.assertEqual(appointment_price(self.appt("followup", first_new), self.patient()), 7800)
+
+    def test_csc_followup_is_20_percent_off_new_price(self):
+        start = self.utc(2027, 5, 1, 1)
+        self.assertEqual(appointment_price(self.appt("followup", start), self.patient(True)), 6240)
+
+    def test_csc_followup_before_price_change(self):
+        start = self.utc(2027, 3, 1, 1)
+        self.assertEqual(appointment_price(self.appt("followup", start), self.patient(True)), 5600)
+
+    def test_csc_assessment_is_not_discounted(self):
+        start = self.utc(2027, 5, 1, 1)
+        self.assertEqual(appointment_price(self.appt("assessment", start), self.patient(True)), 10500)
+
+    def test_rejects_unknown_kind(self):
+        # Appointment validates its kind, so bypass that to reach the pricing check.
+        appt = self.appt("assessment", self.utc(2027, 5, 1, 1))
+        appt.kind = "massage"
+        with self.assertRaises(ValueError):
+            appointment_price(appt, self.patient())
+
+
 if __name__ == "__main__":
     unittest.main()
