+"""Text of the SMS reminder sent two days before an appointment."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+_WEEKDAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
+_MONTHS = (
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+)
+
+
+def reminder_text(appointment):
+    """Reminder SMS for an appointment, with the local (Auckland) date, time and clinic.
+
+    The text never names the treatment: SMS reminders carry only the date, the
+    time and the clinic's name.
+    """
+    start = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    date = f"{_WEEKDAYS[start.weekday()]} {start.day} {_MONTHS[start.month - 1]}"
+    hour = start.hour % 12 or 12
+    time = f"{hour}:{start.minute:02d}{'am' if start.hour < 12 else 'pm'}"
+    return (
+        f"Hi from {clinic}! This is a reminder of your appointment on {date} at {time}. "
+        "If you can't make it, please let us know as soon as possible. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..3ab70bc
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,36 @@
+import unittest
+
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_time_and_clinic(self):
+        # 20:30 UTC on 16 October is 9:30am on 17 October in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 16, 20, 30), clinic="HB")
+        self.assertIn("Kestrel Physio Harbour", reminder_text(a))
+        self.assertIn("Saturday 17 October at 9:30am", reminder_text(a))
+
+    def test_uses_auckland_date_not_utc_date(self):
+        # 22:00 UTC on 16 October is 11:00am on 17 October in Auckland.
+        a = appt("A1", utc(2026, 10, 16, 22, 0))
+        self.assertIn("Saturday 17 October at 11:00am", reminder_text(a))
+
+    def test_afternoon_time_uses_pm(self):
+        # 01:05 UTC on 17 October is 2:05pm on 17 October in Auckland.
+        a = appt("A1", utc(2026, 10, 17, 1, 5))
+        self.assertIn("at 2:05pm", reminder_text(a))
+
+    def test_midday_and_midnight_use_twelve(self):
+        self.assertIn("at 12:00pm", reminder_text(appt("A1", utc(2026, 10, 16, 23, 0))))
+        self.assertIn("at 12:00am", reminder_text(appt("A2", utc(2026, 10, 16, 11, 0))))
+
+    def test_does_not_name_the_treatment(self):
+        a = appt("A1", utc(2026, 10, 16, 20, 30), kind=ASSESSMENT, treatment="lower back pain")
+        self.assertNotIn("lower back pain", reminder_text(a).lower())
+        self.assertNotIn("back", reminder_text(a).lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
