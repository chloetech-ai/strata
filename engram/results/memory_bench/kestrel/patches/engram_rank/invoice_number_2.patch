+def next_invoice_number(clinic, year, existing):
+    """Next invoice number for a clinic in a year, e.g. INV-HB-2027-00042.
+
+    `existing` is every invoice number issued so far, for any clinic and year.
+    The sequence is counted per clinic and restarts at 00001 each year; it
+    follows the highest number already issued, so gaps are never reused.
+    """
+    prefix = f"INV-{clinic}-{year:04d}-"
+    last = 0
+    for number in existing:
+        digits = number[len(prefix):] if number.startswith(prefix) else ""
+        if re.fullmatch(r"[0-9]{5}", digits):
+            last = max(last, int(digits))
+    if last == 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{last + 1:05d}"
