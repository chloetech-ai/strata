+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_issued_number(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_does_not_reuse_a_gap(self):
+        self.assertEqual(next_invoice_number("HB", 2027, ["INV-HB-2027-00003"]), "INV-HB-2027-00004")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-NG-2027-00009", "INV-WK-2027-00020"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00021")
+
+    def test_restarts_each_year(self):
+        existing = ["INV-HB-2026-00150"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_malformed_numbers(self):
+        existing = [
+            "INV-HB-2027-0005",    # too short
+            "INV-HB-2027-000005X",  # too long
+            "INV-HB-2027-0000a",   # not digits
+            "INV-HB-2027",         # no sequence
+            "7",                   # not an invoice number
+        ]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_accepts_any_iterable(self):
+        existing = (n for n in ["INV-HB-2027-00002"])
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_raises_when_the_year_runs_out_of_numbers(self):
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, ["INV-HB-2027-99999"])
+
+
 if __name__ == "__main__":
     unittest.main()
