+"""Reading durations that reception types in by hand."""
+
+import re
+
+# Hours with optional minutes ('1h', '1h30', '1h 30m'), or minutes alone ('45m').
+_DURATION = re.compile(r"(?:([0-9]+)h\s*(?:([0-9]{1,2})m?)?|([0-9]+)m)")
+
+
+def parse_duration(text):
+    """Turn a duration such as '45m', '1h', '1h30' or '1h 30m' into whole minutes."""
+    match = _DURATION.fullmatch(text)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+    hours, minutes, minutes_only = match.group(1), match.group(2), match.group(3)
+    if minutes_only is not None:
+        total = int(minutes_only)
+    else:
+        total = int(hours) * 60 + int(minutes or 0)
+        if minutes is not None and int(minutes) >= 60:
+            raise ValueError(f"not a duration: {text!r}")
+    if total == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return total
