@@ -0,0 +1,41 @@
+import datetime
+import unittest
+
+from kestrel.reminders import reminder_text
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_and_time_and_clinic_name(self):
+        # 2026-10-15 21:30 UTC is 2026-10-16 10:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 15, 21, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Friday 16 October at 10:30am", text)
+
+    def test_uses_local_date_not_utc_date(self):
+        # 2026-10-16 12:00 UTC is 2026-10-17 01:00 in Auckland.
+        a = appt("A1", utc(2026, 10, 16, 12, 0), clinic="NG")
+        self.assertIn("Saturday 17 October at 1:00am", reminder_text(a))
+
+    def test_afternoon_time_uses_pm(self):
+        # 2026-10-16 03:15 UTC is 16:15 in Auckland.
+        a = appt("A1", utc(2026, 10, 16, 3, 15), clinic="WK")
+        self.assertIn("at 4:15pm", reminder_text(a))
+
+    def test_midday_and_midnight_are_12(self):
+        midday = appt("A1", utc(2026, 10, 15, 23, 0), clinic="WK")  # 12:00 local
+        self.assertIn("at 12:00pm", reminder_text(midday))
+        midnight = appt("A2", utc(2026, 10, 15, 11, 0), clinic="WK")  # 00:00 local
+        self.assertIn("at 12:00am", reminder_text(midnight))
+
+    def test_never_names_the_treatment_or_kind(self):
+        a = appt("A1", utc(2026, 10, 15, 21, 30), kind="assessment", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("follow", text.lower())
+
+
+if __name__ == "__main__":
+    unittest.main()
