+"""Appointment reminders."""
+
+from .calendar import LOCAL_TZ
+from .models import CLINICS
+
+
+def reminder_text(appointment):
+    """SMS text sent two days before an appointment.
+
+    Reminders carry only the date, the time and the clinic's name. They never
+    say what the appointment is for, so the treatment is left out.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    hour = local.hour % 12 or 12
+    ampm = "am" if local.hour < 12 else "pm"
+    when = f"{local:%A} {local.day} {local:%B} at {hour}:{local.minute:02d}{ampm}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora! This is a friendly reminder of your appointment at {clinic} "
+        f"on {when}. If you can't make it, please let the clinic know as soon as "
+        "you can. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
