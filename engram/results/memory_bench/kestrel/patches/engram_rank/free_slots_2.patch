+"""Free appointment slots for the booking form."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+# Booking-form lengths and the gap after each kind, in minutes.
+LENGTH = {ASSESSMENT: 45, FOLLOWUP: 30}
+GAP_AFTER = {ASSESSMENT: 15, FOLLOWUP: 0}  # the gap lets the therapist write notes
+
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per day
+STEP = datetime.timedelta(minutes=15)  # every appointment starts on a quarter hour
+
+
+def _busy(kind):
+    """How long an appointment of this kind keeps the therapist busy, gap included."""
+    return datetime.timedelta(minutes=LENGTH[kind] + GAP_AFTER[kind])
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on a local (Auckland) date at which a new `kind` appointment fits.
+
+    A start fits when it falls on a quarter hour, its busy time (length plus gap)
+    does not overlap any other non-cancelled appointment of the therapist, and the
+    therapist still has fewer than DAILY_CAP appointments on that local date.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+
+    live = [a for a in calendar.for_therapist(therapist.id) if a.status != CANCELLED]
+    if sum(1 for a in live if a.start.astimezone(LOCAL_TZ).date() == day) >= DAILY_CAP:
+        return []
+
+    new_busy = _busy(kind)
+    slots = []
+    wall = datetime.datetime.combine(day, datetime.time())
+    for _ in range(24 * 4):
+        start = wall.replace(tzinfo=LOCAL_TZ)
+        # Skip wall-clock times that do not exist (the DST spring-forward gap).
+        if start.astimezone(datetime.timezone.utc).astimezone(LOCAL_TZ).replace(tzinfo=None) == wall:
+            if all(
+                start >= a.start + _busy(a.kind) or a.start >= start + new_busy
+                for a in live
+            ):
+                slots.append(wall.time())
+        wall += STEP
+    return slots
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..811a8f9
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,109 @@
+import datetime
+from zoneinfo import ZoneInfo
+import unittest
+
+from helpers import appt
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+DAY = datetime.date(2026, 10, 15)
+THERAPIST = Therapist("T1", "Jo Park", "HB")
+
+
+def local(hh, mm, day=DAY):
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=AUCKLAND)
+
+
+def times(*hhmm):
+    return [datetime.time(h, m) for h, m in hhmm]
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_offers_every_quarter_hour(self):
+        slots = free_slots(Calendar(), THERAPIST, DAY, FOLLOWUP)
+        self.assertEqual(len(slots), 96)
+        self.assertEqual(slots[0], datetime.time(0, 0))
+        self.assertEqual(slots[-1], datetime.time(23, 45))
+        self.assertEqual(slots, sorted(slots))
+
+    def test_unknown_kind(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), THERAPIST, DAY, "review")
+
+    def test_assessment_blocks_60_minutes_including_gap(self):
+        cal = Calendar([appt("a1", local(9, 0), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertIn(datetime.time(8, 0), slots)  # ends exactly as a1 starts
+        self.assertNotIn(datetime.time(8, 15), slots)
+        self.assertNotIn(datetime.time(9, 0), slots)
+        self.assertNotIn(datetime.time(9, 45), slots)  # would run into a1's gap
+        self.assertIn(datetime.time(10, 0), slots)  # first start after a1's gap
+
+    def test_followup_after_assessment_needs_no_gap_before_it(self):
+        cal = Calendar([appt("a1", local(9, 0), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertIn(datetime.time(8, 30), slots)  # 30-minute follow-up ends at 09:00
+        self.assertNotIn(datetime.time(8, 45), slots)
+        self.assertNotIn(datetime.time(9, 30), slots)
+        self.assertIn(datetime.time(10, 0), slots)
+
+    def test_followup_blocks_30_minutes_with_no_gap(self):
+        cal = Calendar([appt("f1", local(9, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(datetime.time(9, 0), slots)
+        self.assertNotIn(datetime.time(8, 45), slots)
+        self.assertIn(datetime.time(9, 30), slots)  # starts as f1 ends
+
+    def test_assessment_must_finish_its_gap_before_next_appointment(self):
+        cal = Calendar([appt("f1", local(10, 0), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, ASSESSMENT)
+        self.assertIn(datetime.time(9, 0), slots)  # busy 09:00-10:00 ends as f1 starts
+        self.assertNotIn(datetime.time(9, 15), slots)  # busy 09:15-10:15 overlaps f1
+        self.assertNotIn(datetime.time(9, 30), slots)
+        self.assertIn(datetime.time(10, 30), slots)  # starts as f1 ends
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(9, 0), kind=ASSESSMENT, therapist="T1", status="cancelled")])
+        self.assertIn(datetime.time(9, 0), free_slots(cal, THERAPIST, DAY, ASSESSMENT))
+
+    def test_other_therapists_do_not_block(self):
+        cal = Calendar([appt("a1", local(9, 0), kind=ASSESSMENT, therapist="T2")])
+        self.assertIn(datetime.time(9, 0), free_slots(cal, THERAPIST, DAY, ASSESSMENT))
+
+    def test_day_is_auckland_local_date(self):
+        # 09:00 Auckland on 15 Oct is 20:00 UTC on 14 Oct.
+        cal = Calendar([appt("f1", datetime.datetime(2026, 10, 14, 20, 0, tzinfo=datetime.timezone.utc), therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(datetime.time(9, 0), slots)
+        self.assertIn(datetime.time(9, 30), slots)
+
+    def test_appointment_from_previous_day_still_blocks_early_start(self):
+        # Assessment 23:30 on 14 Oct runs to 00:30 on 15 Oct, gap included.
+        cal = Calendar([appt("a1", local(23, 30, day=datetime.date(2026, 10, 14)), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, THERAPIST, DAY, FOLLOWUP)
+        self.assertNotIn(datetime.time(0, 0), slots)
+        self.assertIn(datetime.time(0, 30), slots)
+
+    def test_daily_cap_of_eight(self):
+        seven = [appt(f"f{i}", local(9 + i // 2, 30 * (i % 2)), therapist="T1") for i in range(7)]
+        self.assertNotEqual(free_slots(Calendar(seven), THERAPIST, DAY, FOLLOWUP), [])
+
+        eight = seven + [appt("f7", local(13, 0), therapist="T1")]
+        self.assertEqual(free_slots(Calendar(eight), THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_daily_cap_ignores_cancelled_and_other_days(self):
+        booked = [appt(f"f{i}", local(9 + i // 2, 30 * (i % 2)), therapist="T1") for i in range(7)]
+        cancelled = appt("c1", local(14, 0), therapist="T1", status="cancelled")
+        next_day = appt("n1", local(9, 0, day=datetime.date(2026, 10, 16)), therapist="T1")
+        cal = Calendar(booked + [cancelled, next_day])
+        self.assertNotEqual(free_slots(cal, THERAPIST, DAY, FOLLOWUP), [])
+
+    def test_cap_is_per_therapist(self):
+        others = [appt(f"f{i}", local(9 + i // 2, 30 * (i % 2)), therapist="T2") for i in range(8)]
+        self.assertNotEqual(free_slots(Calendar(others), THERAPIST, DAY, FOLLOWUP), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
