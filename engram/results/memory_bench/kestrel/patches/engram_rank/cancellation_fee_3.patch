@@ -0,0 +1,70 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+from helpers import appt, utc
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2026, 10, 20, 9, 0)
+
+    def cancelled(self, kind, status=CANCELLED):
+        return appt("A1", self.start, kind=kind, status=status)
+
+    def test_cancelled_under_48_hours_costs_half_the_followup_price(self):
+        at = self.start - datetime.timedelta(hours=47, minutes=59)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), at), 3500)
+
+    def test_cancelled_under_48_hours_costs_half_the_assessment_price(self):
+        at = self.start - datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(self.cancelled(ASSESSMENT), at), 4750)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        at = self.start - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), at), 0)
+
+    def test_cancelled_well_ahead_is_free(self):
+        at = self.start - datetime.timedelta(days=7)
+        self.assertEqual(cancellation_fee(self.cancelled(ASSESSMENT), at), 0)
+
+    def test_cancelled_after_start_costs_half_the_price(self):
+        at = self.start + datetime.timedelta(minutes=5)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), at), 3500)
+
+    def test_window_is_measured_as_an_instant_across_timezones(self):
+        # The start is 2026-10-20 09:00 UTC, so 48 hours before is 2026-10-18 22:00 in Auckland (NZDT, UTC+13).
+        auckland = ZoneInfo("Pacific/Auckland")
+        just_outside = datetime.datetime(2026, 10, 18, 21, 59, tzinfo=auckland)
+        just_inside = datetime.datetime(2026, 10, 18, 22, 1, tzinfo=auckland)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), just_outside), 0)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), just_inside), 3500)
+
+    def test_cancelled_without_a_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled(FOLLOWUP), None)
+
+    def test_cancelled_with_a_naive_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled(FOLLOWUP), datetime.datetime(2026, 10, 19, 9, 0))
+
+
+class NoShowFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_assessment_price(self):
+        self.assertEqual(cancellation_fee(appt("A1", utc(2026, 10, 20, 9), kind=ASSESSMENT, status=NO_SHOW)), 9500)
+
+    def test_no_show_pays_full_followup_price(self):
+        self.assertEqual(cancellation_fee(appt("A1", utc(2026, 10, 20, 9), kind=FOLLOWUP, status=NO_SHOW)), 7000)
+
+
+class NoFeeStatusTest(unittest.TestCase):
+    def test_booked_and_attended_appointments_cost_nothing(self):
+        for status in (BOOKED, ATTENDED):
+            with self.subTest(status=status):
+                self.assertEqual(cancellation_fee(appt("A1", utc(2026, 10, 20, 9), status=status)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
