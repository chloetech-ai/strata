+"""Appointment reminders sent by SMS."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment: clinic, local date and time, nothing about the treatment."""
+    local = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic]
+    return f"{clinic.name}: reminder of your appointment on {local:%a %d %b} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Send one SMS per booked appointment to its patient. Returns the number sent.
+
+    Every message is built before any is sent, so a missing patient raises
+    without sending part of the batch.
+    """
+    messages = [
+        (patients[a.patient_id].phone, reminder_text(a))
+        for a in appointments
+        if a.status == BOOKED
+    ]
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..4c82d72
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,86 @@
+import unittest
+
+from kestrel.models import CANCELLED, NO_SHOW, ATTENDED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Aroha Test", "+64211111111", csc=True),
+    "KP-000002": Patient("KP-000002", "Ben Test", "+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def setUp(self):
+        self.transport = FakeTransport()
+        self.client = BulkieClient("key", self.transport)
+
+    def sent(self):
+        return [m for _, body in self.transport.calls for m in body["messages"]]
+
+    def test_one_sms_per_booked_appointment_to_the_patient_phone(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 15, 1, 30), patient="KP-000001", clinic="HB"),
+            appt("a2", utc(2026, 10, 16, 2, 0), patient="KP-000002", clinic="NG"),
+        ]
+        count = send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(count, 2)
+        self.assertEqual([m["to"] for m in self.sent()], ["+64211111111", "+64222222222"])
+
+    def test_patient_with_two_bookings_gets_two_messages(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 15, 1, 30), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 22, 1, 30), patient="KP-000001"),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 2)
+
+    def test_only_booked_appointments_are_reminded(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 15, 1, 30), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 15, 2, 30), patient="KP-000001", status=CANCELLED),
+            appt("a3", utc(2026, 10, 15, 3, 30), patient="KP-000001", status=ATTENDED),
+            appt("a4", utc(2026, 10, 15, 4, 30), patient="KP-000001", status=NO_SHOW),
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 1)
+        self.assertEqual(len(self.sent()), 1)
+
+    def test_no_booked_appointments_sends_nothing(self):
+        appointments = [appt("a1", utc(2026, 10, 15, 1, 30), patient="KP-000001", status=CANCELLED)]
+        self.assertEqual(send_reminders(appointments, PATIENTS, self.client), 0)
+        self.assertEqual(self.transport.calls, [])
+
+    def test_text_gives_clinic_local_date_and_time_only(self):
+        # 14 Oct 13:00 UTC is 15 Oct 02:00 in Auckland (NZDT, UTC+13).
+        a = appt("a1", utc(2026, 10, 14, 13, 0), patient="KP-000001", clinic="HB", kind="assessment", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("15 Oct", text)
+        self.assertIn("02:00", text)
+        self.assertNotIn("lower back pain", text)
+        self.assertNotIn("assessment", text.lower())
+        self.assertNotIn("Aroha", text)
+
+    def test_missing_patient_raises_before_anything_is_sent(self):
+        appointments = [
+            appt("a1", utc(2026, 10, 15, 1, 30), patient="KP-000001"),
+            appt("a2", utc(2026, 10, 15, 2, 30), patient="KP-999999"),
+        ]
+        with self.assertRaises(KeyError):
+            send_reminders(appointments, PATIENTS, self.client)
+        self.assertEqual(self.transport.calls, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
