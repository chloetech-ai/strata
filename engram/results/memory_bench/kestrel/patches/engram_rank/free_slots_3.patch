+"""Free appointment slots for a therapist on a local day."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+LENGTH = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Time kept clear after an appointment: assessments leave 15 minutes for notes.
+GAP = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+STEP = datetime.timedelta(minutes=15)  # appointments start on a quarter hour
+DAILY_CAP = 8  # union agreement: patient appointments per therapist per day
+
+# Opening hours by clinic code, then weekday (Monday is 0). A weekday missing
+# from a clinic's dict is closed.
+_WEEKDAY = (datetime.time(7, 30), datetime.time(18, 0))
+OPENING_HOURS = {
+    "NG": {**{day: _WEEKDAY for day in range(5)}, 5: (datetime.time(8, 0), datetime.time(12, 0))},
+    "HB": {day: _WEEKDAY for day in range(5)},
+    "WK": {day: _WEEKDAY for day in range(5)},
+}
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times on `day` (an Auckland date) when a new `kind` appointment fits.
+
+    Returns sorted datetime.time values. A slot fits when the appointment and
+    its trailing gap clear every other appointment for the therapist, the
+    appointment ends before the clinic closes, and the therapist is under the
+    daily cap. Cancelled appointments do not block anything.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = OPENING_HOURS.get(therapist.clinic, {}).get(day.weekday())
+    if hours is None:
+        return []
+
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= DAILY_CAP:
+        return []
+    taken = [(a.start, a.start + LENGTH[a.kind] + GAP[a.kind]) for a in booked]
+
+    opens = datetime.datetime.combine(day, hours[0], tzinfo=LOCAL_TZ)
+    closes = datetime.datetime.combine(day, hours[1], tzinfo=LOCAL_TZ)
+    length = LENGTH[kind]
+    end_gap = length + GAP[kind]
+
+    free = []
+    start = opens
+    while start + length <= closes:
+        end = start + end_gap
+        if all(end <= t_start or start >= t_end for t_start, t_end in taken):
+            free.append(start.time())
+        start += STEP
+    return free
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..d08da99
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,105 @@
+import datetime
+from zoneinfo import ZoneInfo
+import unittest
+
+from helpers import appt
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+THURSDAY = datetime.date(2026, 10, 15)
+SATURDAY = datetime.date(2026, 10, 17)
+SUNDAY = datetime.date(2026, 10, 18)
+
+
+def local(hh, mm=0, day=THURSDAY):
+    """An Auckland wall-clock time on `day`, as a timezone-aware datetime."""
+    return datetime.datetime(day.year, day.month, day.day, hh, mm, tzinfo=AUCKLAND)
+
+
+def t(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+HB = Therapist(id="T1", name="Ana", clinic="HB")
+NG = Therapist(id="T2", name="Ben", clinic="NG")
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_weekday_runs_from_opening_to_last_fitting_start(self):
+        slots = free_slots(Calendar(), HB, THURSDAY, FOLLOWUP)
+        self.assertEqual(slots[0], t(7, 30))
+        self.assertEqual(slots[-1], t(17, 30))  # a 30-minute follow-up must end by 18:00
+        self.assertEqual(len(slots), 41)
+
+    def test_assessment_must_end_by_closing(self):
+        slots = free_slots(Calendar(), HB, THURSDAY, ASSESSMENT)
+        self.assertEqual(slots[-1], t(17, 15))  # 45 minutes ends at 18:00
+
+    def test_results_are_sorted_times_on_quarter_hours(self):
+        slots = free_slots(Calendar(), HB, THURSDAY, ASSESSMENT)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(isinstance(s, datetime.time) and s.minute % 15 == 0 for s in slots))
+
+    def test_closed_on_sunday(self):
+        self.assertEqual(free_slots(Calendar(), HB, SUNDAY, FOLLOWUP), [])
+
+    def test_saturday_only_northgate_open_8_to_12(self):
+        self.assertEqual(free_slots(Calendar(), HB, SATURDAY, FOLLOWUP), [])
+        slots = free_slots(Calendar(), NG, SATURDAY, ASSESSMENT)
+        self.assertEqual(slots[0], t(8, 0))
+        self.assertEqual(slots[-1], t(11, 15))  # 45 minutes ends at 12:00
+
+    def test_followup_booked_blocks_its_30_minutes_only(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, THURSDAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)  # ends exactly when the booking starts
+        self.assertNotIn(t(10, 0), slots)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertIn(t(10, 30), slots)  # no gap after a follow-up
+
+    def test_assessment_booked_leaves_15_minute_gap_after(self):
+        cal = Calendar([appt("a1", local(10), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB, THURSDAY, FOLLOWUP)
+        self.assertIn(t(9, 30), slots)
+        self.assertNotIn(t(10, 15), slots)
+        self.assertNotIn(t(10, 30), slots)  # inside the 15-minute gap
+        self.assertIn(t(11, 0), slots)
+
+    def test_new_assessment_needs_gap_before_next_booking(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, THURSDAY, ASSESSMENT)
+        self.assertIn(t(9, 0), slots)  # 45 minutes plus 15 minutes of gap ends at 10:00
+        self.assertNotIn(t(9, 15), slots)
+        self.assertIn(t(10, 30), slots)
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T1", status=CANCELLED)])
+        self.assertIn(t(10, 0), free_slots(cal, HB, THURSDAY, FOLLOWUP))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(10), kind=FOLLOWUP, therapist="T9")])
+        self.assertIn(t(10, 0), free_slots(cal, HB, THURSDAY, FOLLOWUP))
+
+    def test_blocking_uses_auckland_local_time(self):
+        # 10:00 NZDT on 15 October is 21:00 UTC on 14 October.
+        cal = Calendar([appt("a1", datetime.datetime(2026, 10, 14, 21, tzinfo=datetime.timezone.utc), kind=FOLLOWUP, therapist="T1")])
+        self.assertNotIn(t(10, 0), free_slots(cal, HB, THURSDAY, FOLLOWUP))
+
+    def test_daily_cap_of_eight_closes_the_day(self):
+        booked = [appt(f"a{i}", local(7 + i, 30), kind=FOLLOWUP, therapist="T1") for i in range(8)]
+        self.assertEqual(free_slots(Calendar(booked), HB, THURSDAY, FOLLOWUP), [])
+
+    def test_cancelled_appointments_do_not_count_toward_cap(self):
+        booked = [appt(f"a{i}", local(7 + i, 30), kind=FOLLOWUP, therapist="T1") for i in range(7)]
+        booked.append(appt("c1", local(12), kind=FOLLOWUP, therapist="T1", status=CANCELLED))
+        self.assertIn(t(12, 0), free_slots(Calendar(booked), HB, THURSDAY, FOLLOWUP))
+
+    def test_unknown_kind_is_rejected(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, THURSDAY, "massage")
+
+
+if __name__ == "__main__":
+    unittest.main()
