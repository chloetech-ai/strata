+class AppointmentPriceTest(unittest.TestCase):
+    def patient(self, csc):
+        return Patient("KP-004211", "Test Patient", "+64211234567", csc=csc)
+
+    def appointment(self, kind, start):
+        return Appointment("A-1", "KP-004211", "T-1", "HB", start, kind)
+
+    def test_before_change_keeps_old_prices(self):
+        # 2027-03-31 10:30 UTC is 23:30 on 31 March in Auckland (NZDT, +13).
+        start = datetime.datetime(2027, 3, 31, 10, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient(False)), 9500)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(False)), 7000)
+
+    def test_change_date_uses_auckland_date_not_utc_date(self):
+        # 2027-03-31 11:30 UTC is 00:30 on 1 April in Auckland, so the new prices apply
+        # even though the UTC date is still 31 March.
+        start = datetime.datetime(2027, 3, 31, 11, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient(False)), 10500)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(False)), 7800)
+
+    def test_new_csc_followup_is_20_percent_off_new_price(self):
+        start = datetime.datetime(2027, 6, 1, 1, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(True)), 6240)
+
+    def test_old_csc_followup_is_20_percent_off_old_price(self):
+        start = datetime.datetime(2026, 10, 15, 1, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(True)), 5600)
+
+    def test_csc_assessment_is_not_discounted(self):
+        start = datetime.datetime(2027, 6, 1, 1, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient(True)), 10500)
+
+
 class SessionPriceTest(unittest.TestCase):
