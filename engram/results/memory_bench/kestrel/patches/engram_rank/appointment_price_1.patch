 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+# Kestrel's clinics are all in Auckland; appointment times are stored in UTC.
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+# Prices from PRICE_CHANGE_DATE (Auckland local date of the appointment start) on.
+PRICE_CHANGE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
 CSC_FOLLOWUP_PERCENT_OFF = 20  # CSC holders: follow-ups only, not assessments
 
 
@@ -23,3 +35,20 @@ def price_for(patient, kind):
     if patient.csc and kind == FOLLOWUP:
         price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
     return price
+
+
+def appointment_price(appointment, patient):
+    """Price in cents the patient pays for this appointment, after any CSC discount.
+
+    The price is set by the Auckland local date of the appointment's start, so an
+    appointment starting before PRICE_CHANGE_DATE keeps the old prices.
+    """
+    local_date = appointment.start.astimezone(LOCAL_TZ).date()
+    prices = NEW_PRICES_CENTS if local_date >= PRICE_CHANGE_DATE else PRICES_CENTS
+    try:
+        price = prices[appointment.kind]
+    except KeyError:
+        raise ValueError(f"unknown kind {appointment.kind!r}") from None
+    if patient.csc and appointment.kind == FOLLOWUP:
+        price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
+    return price
