+++ b/src/kestrel/calendar.py
@@ -65,6 +65,13 @@ class Calendar:
         ]
         return sorted(appointments, key=lambda a: a.start)
 
+    def upcoming(self, patient_id, now):
+        """A patient's booked appointments starting after `now`, soonest first."""
+        if now.tzinfo is None:
+            raise ValueError("now must be timezone-aware")
+        patient_id = normalize_patient_id(patient_id)
+        return [a for a in self.booked() if a.patient_id == patient_id and a.start > now]
+
     def booked(self):
         return [a for a in self.all() if a.status == BOOKED]
 
diff --git a/tests/test_calendar.py b/tests/test_calendar.py
index b631aa8..e32e0c4 100644
--- a/tests/test_calendar.py
