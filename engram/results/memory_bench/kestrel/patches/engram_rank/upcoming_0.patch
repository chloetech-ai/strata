@@ -151,6 +151,55 @@ class CalendarTest(unittest.TestCase):
         self.assertEqual([a.id for a in cal.for_day("T1", day)], ["a1", "a2", "a4"])
         self.assertEqual([a.id for a in cal.for_day("T2", day)], ["a3"])
 
+    def test_upcoming_soonest_first_for_one_patient(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 3, 20), patient="KP-004211"),
+            appt("a2", utc(2027, 3, 1, 20), patient="KP-004211"),
+            appt("a3", utc(2027, 3, 2, 20), patient="KP-000007"),
+        ])
+        now = utc(2027, 2, 28, 9)
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", now)], ["a2", "a1"])
+
+    def test_upcoming_accepts_messy_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming(" kp4211 ", utc(2027, 2, 28, 9))], ["a1"])
+
+    def test_upcoming_excludes_past_and_starting_now(self):
+        cal = Calendar([
+            appt("past", utc(2027, 2, 28, 8), patient="KP-004211"),
+            appt("now", utc(2027, 2, 28, 9), patient="KP-004211"),
+            appt("later", utc(2027, 2, 28, 10), patient="KP-004211"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", utc(2027, 2, 28, 9))], ["later"])
+
+    def test_upcoming_excludes_cancelled_attended_and_no_show(self):
+        cal = Calendar([
+            appt("cancelled", utc(2027, 3, 1, 20), patient="KP-004211", status="cancelled"),
+            appt("attended", utc(2027, 3, 1, 21), patient="KP-004211", status="attended"),
+            appt("no_show", utc(2027, 3, 1, 22), patient="KP-004211", status="no_show"),
+            appt("booked", utc(2027, 3, 1, 23), patient="KP-004211"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", utc(2027, 2, 28, 9))], ["booked"])
+
+    def test_upcoming_compares_instants_across_timezones(self):
+        # 2027-03-02 09:00 Auckland (NZDT, UTC+13) is 2027-03-01 20:00 UTC.
+        auckland = ZoneInfo("Pacific/Auckland")
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        now = datetime.datetime(2027, 3, 2, 9, 0, tzinfo=auckland)
+        self.assertEqual(cal.upcoming("KP-004211", now), [])
+        now = datetime.datetime(2027, 3, 2, 8, 0, tzinfo=auckland)
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", now)], ["a1"])
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 2, 28, 9))
+
+    def test_upcoming_rejects_malformed_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 20), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("4211", utc(2027, 2, 28, 9))
+
 
 if __name__ == "__main__":
