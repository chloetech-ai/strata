@@ -0,0 +1,54 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ATTENDED, BOOKED, CANCELLED, NO_SHOW
+
+START = utc(2027, 3, 10, 2)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_assessment_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind="assessment", status=NO_SHOW)), 9500)
+
+    def test_no_show_pays_full_followup_price(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, kind="followup", status=NO_SHOW)), 7000)
+
+    def test_cancelled_under_48_hours_costs_half(self):
+        a = appt("a1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=47, minutes=59)), 3500)
+
+    def test_cancelled_under_48_hours_assessment_costs_half(self):
+        a = appt("a1", START, kind="assessment", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=1)), 4750)
+
+    def test_cancelled_after_start_costs_half(self):
+        a = appt("a1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START + datetime.timedelta(hours=2)), 3500)
+
+    def test_cancelled_exactly_48_hours_before_is_free(self):
+        a = appt("a1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(hours=48)), 0)
+
+    def test_cancelled_more_than_48_hours_before_is_free(self):
+        a = appt("a1", START, kind="followup", status=CANCELLED)
+        self.assertEqual(cancellation_fee(a, START - datetime.timedelta(days=5)), 0)
+
+    def test_cancelled_without_time_is_rejected(self):
+        a = appt("a1", START, kind="followup", status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, None)
+
+    def test_cancelled_time_must_be_timezone_aware(self):
+        a = appt("a1", START, kind="followup", status=CANCELLED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(a, datetime.datetime(2027, 3, 8, 2))
+
+    def test_booked_and_attended_cost_nothing(self):
+        self.assertEqual(cancellation_fee(appt("a1", START, status=BOOKED)), 0)
+        self.assertEqual(cancellation_fee(appt("a2", START, status=ATTENDED)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
