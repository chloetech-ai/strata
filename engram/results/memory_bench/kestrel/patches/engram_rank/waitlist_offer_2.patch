diff --git a/src/kestrel/waitlist.py b/src/kestrel/waitlist.py
index 39c0e22..33cc05d 100644
--- a/src/kestrel/waitlist.py
+++ b/src/kestrel/waitlist.py
@@ -44,3 +44,10 @@ class Waitlist:
     def entries(self):
         """Urgent entries first, then everyone else, each group in the order they asked."""
         return sorted(self._entries.values(), key=lambda e: (not e.urgent, e.requested_at))
+
+    def next_for(self, kind):
+        """The entry to offer a freed slot of this kind to, or None if nobody is waiting for it."""
+        for entry in self.entries():
+            if entry.kind == kind:
+                return entry
+        return None
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
index 3492a1b..7a50134 100644
--- a/tests/test_waitlist.py
+++ b/tests/test_waitlist.py
@@ -88,6 +88,35 @@ class WaitlistTest(unittest.TestCase):
         wl.add(entry("KP-000001", 9))
         self.assertEqual([e.requested_at.day for e in wl.entries()], [9])
 
+    def test_next_for_none_when_empty(self):
+        self.assertIsNone(Waitlist().next_for(FOLLOWUP))
+
+    def test_next_for_none_when_nobody_wants_that_kind(self):
+        wl = Waitlist([entry("KP-000001", 1, kind=FOLLOWUP)])
+        self.assertIsNone(wl.next_for(ASSESSMENT))
+
+    def test_next_for_returns_earliest_of_that_kind(self):
+        wl = Waitlist([
+            entry("KP-000001", 1, kind=ASSESSMENT),
+            entry("KP-000002", 2, kind=FOLLOWUP),
+            entry("KP-000003", 3, kind=FOLLOWUP),
+        ])
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000002")
+        self.assertEqual(wl.next_for(ASSESSMENT).patient_id, "KP-000001")
+
+    def test_next_for_prefers_urgent_of_that_kind(self):
+        wl = Waitlist([
+            entry("KP-000001", 1, kind=FOLLOWUP),
+            entry("KP-000002", 2, kind=FOLLOWUP, urgent=True),
+            entry("KP-000003", 3, kind=ASSESSMENT, urgent=True),
+        ])
+        self.assertEqual(wl.next_for(FOLLOWUP).patient_id, "KP-000002")
+
+    def test_next_for_does_not_remove_entry(self):
+        wl = Waitlist([entry("KP-000001", 1)])
+        wl.next_for(FOLLOWUP)
+        self.assertEqual([e.patient_id for e in wl.entries()], ["KP-000001"])
+
     def test_add_does_not_change_caller_entry(self):
