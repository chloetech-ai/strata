@@ -0,0 +1,40 @@
+import unittest
+
+from kestrel.models import ASSESSMENT
+from kestrel.reminders import reminder_text
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_names_clinic_date_and_time_in_auckland_local_time(self):
+        # 14 Oct 2026 21:30 UTC is 15 Oct 10:30 in Auckland (NZDT, UTC+13).
+        a = appt("A1", utc(2026, 10, 14, 21, 30), clinic="HB")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Thursday 15 October at 10:30am", text)
+
+    def test_afternoon_time_uses_12_hour_clock(self):
+        a = appt("A1", utc(2026, 10, 15, 2, 0), clinic="NG")  # 15:00 Auckland
+        self.assertIn("at 3:00pm", reminder_text(a))
+
+    def test_midnight_is_12am_and_one_pm_is_1pm(self):
+        midnight = appt("A1", utc(2026, 10, 14, 11, 0), clinic="WK")  # 00:00 local
+        self.assertIn("at 12:00am", reminder_text(midnight))
+        one_pm = appt("A2", utc(2026, 10, 15, 0, 0), clinic="WK")  # 13:00 local
+        self.assertIn("at 1:00pm", reminder_text(one_pm))
+
+    def test_does_not_state_the_treatment(self):
+        a = appt("A1", utc(2026, 10, 15, 2, 0), kind=ASSESSMENT, treatment="lower back pain")
+        self.assertNotIn("lower back pain", reminder_text(a))
+
+    def test_does_not_include_patient_name(self):
+        a = appt("A1", utc(2026, 10, 15, 2, 0), patient="KP-004211")
+        self.assertNotIn("KP-004211", reminder_text(a))
+
+    def test_is_friendly(self):
+        a = appt("A1", utc(2026, 10, 15, 2, 0))
+        self.assertIn("Kia ora", reminder_text(a))
+
+
+if __name__ == "__main__":
+    unittest.main()
