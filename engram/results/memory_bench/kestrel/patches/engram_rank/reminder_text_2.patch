+"""SMS reminders for patients."""
+
+from kestrel.calendar import LOCAL_TZ
+from kestrel.models import CLINICS
+
+
+def _time_text(local):
+    hour = local.hour % 12 or 12
+    suffix = "am" if local.hour < 12 else "pm"
+    return f"{hour}:{local.minute:02d}{suffix}"
+
+
+def reminder_text(appointment):
+    """Text of the SMS reminder sent two days before an appointment.
+
+    Privacy: the text names only the clinic, the date and the time. It never
+    says what the appointment is for, and it never includes the patient's name.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    when = f"{local:%A} {local.day} {local:%B} at {_time_text(local)}"
+    return (
+        f"Kia ora! This is a friendly reminder of your appointment at {clinic} "
+        f"on {when}. We look forward to seeing you. "
+        f"If you can't make it, please let the clinic know as soon as you can. Thanks!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
