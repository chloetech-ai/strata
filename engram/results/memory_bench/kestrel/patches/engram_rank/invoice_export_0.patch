+"""Monthly export of invoices for the accountant (CSV for Xero import)."""
+
+import csv
+import datetime
+import os
+
+HEADER = ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"]
+
+
+def _format_amount(cents):
+    """Plain dollars with two decimals, from integer cents: 9500 -> "95.00"."""
+    sign = "-" if cents < 0 else ""
+    dollars, rem = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{rem:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to a CSV in out_dir and return its path.
+
+    Invoices are matched on their Auckland local issue date. Only the patient ID
+    is written, never the patient's name. A month with no invoices still gets a
+    file with just the header row.
+    """
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: (i.issued, i.number),
+    )
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=",")
+        writer.writerow(HEADER)
+        for i in chosen:
+            writer.writerow([
+                i.number,
+                i.patient_id,
+                i.issued.strftime("%d/%m/%Y"),
+                i.description,
+                1,
+                _format_amount(i.amount_cents),
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
