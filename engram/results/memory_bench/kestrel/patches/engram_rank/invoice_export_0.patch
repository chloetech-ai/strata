@@ -0,0 +1,100 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents, patient_id="KP-004211", description="Physiotherapy follow-up session"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        patient_name="",
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.out = self.tmp.name
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_file_is_named_by_year_and_month_and_path_returned(self):
+        path = export_invoices([], 2026, 10, self.out)
+        self.assertEqual(path, os.path.join(self.out, "kestrel-invoices-2026-10.csv"))
+        self.assertTrue(os.path.exists(path))
+
+    def test_writes_header_then_one_row_per_invoice(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), 7000)]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out))
+        self.assertEqual(rows[0], ["InvoiceNumber", "ContactName", "InvoiceDate", "Description", "Quantity", "UnitAmount"])
+        self.assertEqual(rows[1], ["INV-HB-2026-00001", "KP-004211", "03/10/2026", "Physiotherapy follow-up session", "1", "70.00"])
+        self.assertEqual(len(rows), 2)
+
+    def test_empty_month_gets_header_only(self):
+        rows = self.read_rows(export_invoices([], 2026, 10, self.out))
+        self.assertEqual(len(rows), 1)
+
+    def test_only_invoices_from_that_month_are_written(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30), 7000),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1), 7000),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31), 7000),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1), 7000),
+            invoice("INV-HB-2025-00005", datetime.date(2025, 10, 15), 7000),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_amounts_formatted_from_cents_without_float_error(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), 9500),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1), 5600),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 1), 6240),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 10, 1), 10),
+            invoice("INV-HB-2026-00005", datetime.date(2026, 10, 1), 10500),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out))
+        self.assertEqual([r[5] for r in rows[1:]], ["95.00", "56.00", "62.40", "0.10", "105.00"])
+
+    def test_dates_are_day_month_year_in_local_date(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 5), 7000)]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out))
+        self.assertEqual(rows[1][2], "05/10/2026")
+
+    def test_rows_sorted_by_date_then_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 2), 7000),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 9), 7000),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 2), 7000),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.out))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003", "INV-HB-2026-00001"])
+
+    def test_never_writes_patient_name(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), 7000)]
+        invoices[0].patient_name = "Test Patient"
+        path = export_invoices(invoices, 2026, 10, self.out)
+        with open(path, encoding="utf-8") as f:
+            self.assertNotIn("Test Patient", f.read())
+
+    def test_uses_comma_delimiter(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 1), 7000)]
+        path = export_invoices(invoices, 2026, 10, self.out)
+        with open(path, encoding="utf-8") as f:
+            self.assertEqual(f.readline().count(","), 5)
+
+
+if __name__ == "__main__":
+    unittest.main()
