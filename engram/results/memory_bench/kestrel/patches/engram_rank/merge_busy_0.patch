@@ -0,0 +1,23 @@
+import unittest
+
+from kestrel.intervals import merge_busy
+
+
+class MergeBusyTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(merge_busy([]), [])
+
+    def test_disjoint_kept_in_order(self):
+        self.assertEqual(merge_busy([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_merged(self):
+        self.assertEqual(merge_busy([(1, 4), (3, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_touching_merged(self):
+        self.assertEqual(merge_busy([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_interval_does_not_shorten(self):
+        self.assertEqual(merge_busy([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_any_order(self):
+        self.assertEqual(merge_busy([(7, 8), (4, 5), (1, 2), (2, 4)]), [(1, 5), (7, 8)])
