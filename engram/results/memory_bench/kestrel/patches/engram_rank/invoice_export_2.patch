@@ -0,0 +1,104 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from kestrel.export import export_invoices
+from kestrel.invoices import Invoice
+
+
+def invoice(number, issued, amount_cents=9500, patient_id="KP-004211", patient_name="", description="Physiotherapy follow-up session"):
+    return Invoice(
+        number=number,
+        clinic="HB",
+        patient_id=patient_id,
+        patient_name=patient_name,
+        issued=issued,
+        amount_cents=amount_cents,
+        description=description,
+    )
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_filename_is_kestrel_invoices_year_month(self):
+        path = export_invoices([], 2026, 10, self.tmp.name)
+        self.assertEqual(os.path.basename(path), "kestrel-invoices-2026-10.csv")
+        self.assertEqual(os.path.dirname(path), self.tmp.name)
+        self.assertTrue(os.path.exists(path))
+
+    def test_writes_header_row_then_one_row_per_invoice(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3))]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.tmp.name))
+        self.assertEqual(rows[0], ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"])
+        self.assertEqual(rows[1], ["INV-HB-2026-00001", "KP-004211", "03/10/2026", "Physiotherapy follow-up session", "95.00"])
+        self.assertEqual(len(rows), 2)
+
+    def test_only_invoices_from_the_requested_month(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 9, 30)),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 1)),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 31)),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 11, 1)),
+            invoice("INV-HB-2025-00005", datetime.date(2025, 10, 15)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.tmp.name))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00002", "INV-HB-2026-00003"])
+
+    def test_amounts_are_two_decimal_plain_numbers_from_cents(self):
+        invoices = [
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), amount_cents=10500),
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 3), amount_cents=5600),
+            invoice("INV-HB-2026-00003", datetime.date(2026, 10, 3), amount_cents=7),
+            invoice("INV-HB-2026-00004", datetime.date(2026, 10, 3), amount_cents=0),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.tmp.name))
+        self.assertEqual([r[4] for r in rows[1:]], ["105.00", "56.00", "0.07", "0.00"])
+
+    def test_negative_amount_keeps_sign_and_two_decimals(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), amount_cents=-2500)]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.tmp.name))
+        self.assertEqual(rows[1][4], "-25.00")
+
+    def test_no_patient_name_in_the_file(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), patient_name="Test Patient")]
+        path = export_invoices(invoices, 2026, 10, self.tmp.name)
+        with open(path, encoding="utf-8") as f:
+            text = f.read()
+        self.assertNotIn("Test Patient", text)
+        self.assertNotIn("PatientName", text)
+
+    def test_description_with_comma_is_quoted_and_round_trips(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3), description="Session, follow-up")]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.tmp.name))
+        self.assertEqual(rows[1][3], "Session, follow-up")
+        self.assertEqual(len(rows[1]), 5)
+
+    def test_dates_are_day_month_year(self):
+        invoices = [invoice("INV-HB-2026-00001", datetime.date(2026, 10, 5))]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.tmp.name))
+        self.assertEqual(rows[1][2], "05/10/2026")
+
+    def test_rows_sorted_by_invoice_number(self):
+        invoices = [
+            invoice("INV-HB-2026-00002", datetime.date(2026, 10, 3)),
+            invoice("INV-HB-2026-00001", datetime.date(2026, 10, 3)),
+        ]
+        rows = self.read_rows(export_invoices(invoices, 2026, 10, self.tmp.name))
+        self.assertEqual([r[0] for r in rows[1:]], ["INV-HB-2026-00001", "INV-HB-2026-00002"])
+
+    def test_empty_month_writes_header_only(self):
+        rows = self.read_rows(export_invoices([], 2026, 10, self.tmp.name))
+        self.assertEqual(len(rows), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
