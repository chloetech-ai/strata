+"""Monthly export of invoices for the accountant, in the CSV layout Xero imports."""
+
+import csv
+import os
+
+# Columns are fixed: the privacy officer's rule allows only the patient ID to leave
+# the system, so the invoice's patient_name is deliberately not exported.
+HEADER = ["InvoiceNumber", "PatientID", "InvoiceDate", "Description", "Amount"]
+
+
+def _money(cents):
+    """Plain number with two decimals, formatted from integer cents: 9500 -> '95.00'."""
+    sign = "-" if cents < 0 else ""
+    dollars, rem = divmod(abs(cents), 100)
+    return f"{sign}{dollars}.{rem:02d}"
+
+
+def export_invoices(invoices, year, month, out_dir):
+    """Write the invoices issued in year-month to out_dir as a Xero CSV and return its path."""
+    path = os.path.join(out_dir, f"kestrel-invoices-{year:04d}-{month:02d}.csv")
+    chosen = sorted(
+        (i for i in invoices if i.issued.year == year and i.issued.month == month),
+        key=lambda i: i.number,
+    )
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for invoice in chosen:
+            writer.writerow([
+                invoice.number,
+                invoice.patient_id,
+                invoice.issued.strftime("%d/%m/%Y"),
+                invoice.description,
+                _money(invoice.amount_cents),
+            ])
+    return path
diff --git a/tests/test_export.py b/tests/test_export.py
