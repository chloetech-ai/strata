         cal = Calendar([appt("a1", utc(2027, 3, 1, 20)), appt("a2", utc(2027, 3, 1, 21), status="cancelled")])
         self.assertEqual([a.id for a in cal.booked()], ["a1"])
 
+    def test_upcoming_booked_after_now_soonest_first(self):
+        cal = Calendar([
+            appt("past", utc(2027, 3, 1, 9), patient="KP-004211"),
+            appt("later", utc(2027, 3, 3, 9), patient="KP-004211"),
+            appt("soon", utc(2027, 3, 2, 9), patient="KP-004211"),
+            appt("other", utc(2027, 3, 2, 10), patient="KP-000007"),
+        ])
+        now = utc(2027, 3, 1, 12)
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", now)], ["soon", "later"])
+
+    def test_upcoming_excludes_start_exactly_at_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 1, 12), patient="KP-004211")])
+        self.assertEqual(cal.upcoming("KP-004211", utc(2027, 3, 1, 12)), [])
+
+    def test_upcoming_excludes_cancelled_attended_and_no_show(self):
+        cal = Calendar([
+            appt("a1", utc(2027, 3, 2, 9), patient="KP-004211", status="cancelled"),
+            appt("a2", utc(2027, 3, 2, 10), patient="KP-004211", status="attended"),
+            appt("a3", utc(2027, 3, 2, 11), patient="KP-004211", status="no_show"),
+            appt("a4", utc(2027, 3, 2, 12), patient="KP-004211"),
+        ])
+        self.assertEqual([a.id for a in cal.upcoming("KP-004211", utc(2027, 3, 1))], ["a4"])
+
+    def test_upcoming_accepts_messy_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        self.assertEqual([a.id for a in cal.upcoming("kp4211", utc(2027, 3, 1))], ["a1"])
+        self.assertEqual([a.id for a in cal.upcoming(" Kp-4211 ", utc(2027, 3, 1))], ["a1"])
+
+    def test_upcoming_rejects_malformed_patient_id(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("4211", utc(2027, 3, 1))
+
+    def test_upcoming_rejects_naive_now(self):
+        cal = Calendar([appt("a1", utc(2027, 3, 2, 9), patient="KP-004211")])
+        with self.assertRaises(ValueError):
+            cal.upcoming("KP-004211", datetime.datetime(2027, 3, 1, 12))
+
