@@ -0,0 +1,27 @@
+"""Reading durations that reception types in by hand."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?")
+
+
+def parse_duration(text):
+    """Turn a typed duration such as '45m', '1h', '1h30' or '1h 30m' into minutes."""
+    raw = text.strip()
+    match = _MINUTES.fullmatch(raw)
+    if match is not None:
+        minutes = int(match.group(1))
+    else:
+        match = _HOURS.fullmatch(raw)
+        if match is None:
+            raise ValueError(f"not a duration: {text!r}")
+        minutes = int(match.group(1)) * 60
+        if match.group(2) is not None:
+            extra = int(match.group(2))
+            if extra >= 60:
+                raise ValueError(f"minutes out of range: {text!r}")
+            minutes += extra
+    if minutes == 0:
+        raise ValueError(f"duration must be positive: {text!r}")
+    return minutes
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
