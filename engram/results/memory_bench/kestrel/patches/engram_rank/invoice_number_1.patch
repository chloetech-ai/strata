+class NextInvoiceNumberTest(unittest.TestCase):
+    def test_first_invoice_of_the_year_is_00001(self):
+        self.assertEqual(next_invoice_number("HB", 2027, []), "INV-HB-2027-00001")
+
+    def test_follows_the_highest_existing_number(self):
+        existing = ["INV-HB-2027-00001", "INV-HB-2027-00042", "INV-HB-2027-00007"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00043")
+
+    def test_counts_each_clinic_separately(self):
+        existing = ["INV-HB-2027-00042", "INV-NG-2027-00003"]
+        self.assertEqual(next_invoice_number("NG", 2027, existing), "INV-NG-2027-00004")
+        self.assertEqual(next_invoice_number("WK", 2027, existing), "INV-WK-2027-00001")
+
+    def test_restarts_at_00001_each_year(self):
+        existing = ["INV-HB-2026-00310"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00001")
+
+    def test_ignores_other_years_when_counting(self):
+        existing = ["INV-HB-2026-00310", "INV-HB-2027-00002"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_ignores_malformed_numbers(self):
+        existing = ["INV-HB-2027-00002", "INV-HB-2027-99", "INV-HB-2027-00005x", "junk"]
+        self.assertEqual(next_invoice_number("HB", 2027, existing), "INV-HB-2027-00003")
+
+    def test_raises_when_the_year_runs_out_of_numbers(self):
+        existing = ["INV-HB-2027-99999"]
+        with self.assertRaises(ValueError):
+            next_invoice_number("HB", 2027, existing)
+
+
 if __name__ == "__main__":
     unittest.main()
