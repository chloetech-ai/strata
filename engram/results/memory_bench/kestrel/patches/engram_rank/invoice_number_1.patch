+
+_NUMBER_RE = re.compile(r"INV-([A-Z]+)-(\d{4})-(\d{5})")
+
+
+def next_invoice_number(clinic, year, existing):
+    """Next number in the form INV-<clinic>-<year>-<sequence>.
+
+    The sequence is five digits, counted separately per clinic and restarting
+    at 00001 each year. `existing` may hold numbers from any clinic and year;
+    only those for this clinic and year count towards the sequence.
+    """
+    prefix = f"INV-{clinic}-{year}-"
+    highest = 0
+    for number in existing:
+        match = _NUMBER_RE.fullmatch(number)
+        if match and number.startswith(prefix):
+            highest = max(highest, int(match.group(3)))
+    if highest + 1 > 99999:
+        raise ValueError(f"no invoice numbers left for clinic {clinic} in {year}")
+    return f"{prefix}{highest + 1:05d}"
