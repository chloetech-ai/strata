new file mode 100644
index 0000000..fd84933
--- /dev/null
+++ b/src/kestrel/intervals.py
@@ -0,0 +1,21 @@
+"""Reading the lengths of appointments that reception types in by hand."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)m")
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m?)?")
+
+
+def parse_duration(text):
+    """Turn a typed length such as '45m', '1h', '1h30' or '1h 30m' into minutes."""
+    raw = text.strip().lower()
+    match = _MINUTES.fullmatch(raw)
+    if match is not None:
+        return int(match.group(1))
+    match = _HOURS.fullmatch(raw)
+    if match is not None:
+        minutes = int(match.group(2) or 0)
+        if minutes >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+        return int(match.group(1)) * 60 + minutes
+    raise ValueError(f"not a duration: {text!r}")
diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
