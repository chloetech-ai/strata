-from kestrel.models import Patient
-from kestrel.pricing import price_for, session_price
+from kestrel.models import Appointment, Patient
+from kestrel.pricing import appointment_price, price_for, session_price
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def patient(self, csc):
+        return Patient("KP-004211", "Test Patient", "+64211234567", csc=csc)
+
+    def appointment(self, kind, start):
+        return Appointment("A1", "KP-004211", "T1", "NG", start, kind)
+
+    def test_before_price_rise_pays_old_prices(self):
+        start = datetime.datetime(2027, 3, 31, 10, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient(False)), 9500)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(False)), 7000)
+
+    def test_on_price_rise_date_pays_new_prices(self):
+        start = datetime.datetime(2027, 4, 1, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient(False)), 10500)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(False)), 7800)
+
+    def test_cutoff_uses_auckland_date_not_utc_date(self):
+        # 31 March 11:00 UTC is 1 April 00:00 in Auckland (NZDT, UTC+13), so the new prices apply.
+        start = datetime.datetime(2027, 3, 31, 11, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient(False)), 10500)
+
+    def test_just_before_cutoff_in_auckland_pays_old_prices(self):
+        # 31 March 10:59 UTC is 31 March 23:59 in Auckland.
+        start = datetime.datetime(2027, 3, 31, 10, 59, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(self.appointment("followup", start), self.patient(False)), 7000)
+
+    def test_csc_followup_is_20_percent_off_old_and_new_prices(self):
+        before = datetime.datetime(2027, 3, 31, 10, 0, tzinfo=AUCKLAND)
+        after = datetime.datetime(2027, 4, 1, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("followup", before), self.patient(True)), 5600)
+        self.assertEqual(appointment_price(self.appointment("followup", after), self.patient(True)), 6240)
+
+    def test_csc_assessment_is_not_discounted(self):
+        start = datetime.datetime(2027, 4, 1, 9, 0, tzinfo=AUCKLAND)
+        self.assertEqual(appointment_price(self.appointment("assessment", start), self.patient(True)), 10500)
 
 
