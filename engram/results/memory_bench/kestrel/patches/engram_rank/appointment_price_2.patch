@@ -1,11 +1,23 @@
 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
+# Kestrel's clinics are all in Auckland; appointment times are stored in UTC.
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+# From this Auckland local date, appointments pay the new prices.
+PRICE_RISE_DATE = datetime.date(2027, 4, 1)
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
 CSC_FOLLOWUP_PERCENT_OFF = 20  # CSC holders: follow-ups only, not assessments
 
 
@@ -17,9 +29,26 @@ def session_price(kind):
         raise ValueError(f"unknown kind {kind!r}") from None
 
 
-def price_for(patient, kind):
-    """Price in cents for this patient, after any Community Services Card discount."""
-    price = session_price(kind)
+def _with_csc_discount(price, patient, kind):
     if patient.csc and kind == FOLLOWUP:
         price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
     return price
+
+
+def price_for(patient, kind):
+    """Price in cents for this patient, after any Community Services Card discount."""
+    return _with_csc_discount(session_price(kind), patient, kind)
+
+
+def appointment_price(appointment, patient):
+    """What this patient pays for this appointment, in cents.
+
+    The price in force on the appointment's Auckland local start date,
+    after any Community Services Card discount.
+    """
+    local_date = appointment.start.astimezone(LOCAL_TZ).date()
+    if local_date >= PRICE_RISE_DATE:
+        price = NEW_PRICES_CENTS[appointment.kind]
+    else:
+        price = session_price(appointment.kind)
+    return _with_csc_discount(price, patient, appointment.kind)
