+++ b/tests/test_fees.py
@@ -0,0 +1,69 @@
+import datetime
+import unittest
+from zoneinfo import ZoneInfo
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, BOOKED, FOLLOWUP
+
+
+class CancellationFeeTest(unittest.TestCase):
+    start = utc(2026, 11, 10, 9, 0)
+
+    def cancelled(self, kind=FOLLOWUP, cancelled_at=None):
+        return appt("A1", self.start, kind=kind, status="cancelled", cancelled_at=cancelled_at)
+
+    def test_cancelled_more_than_48_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(self.cancelled(cancelled_at=utc(2026, 11, 8, 8, 59))), 0)
+
+    def test_cancelled_exactly_48_hours_ahead_is_free(self):
+        self.assertEqual(cancellation_fee(self.cancelled(cancelled_at=utc(2026, 11, 8, 9, 0))), 0)
+
+    def test_cancelled_under_48_hours_ahead_costs_half_the_session_price(self):
+        self.assertEqual(cancellation_fee(self.cancelled(cancelled_at=utc(2026, 11, 8, 9, 1))), 3500)
+
+    def test_late_cancelled_assessment_costs_half_the_assessment_price(self):
+        fee = cancellation_fee(self.cancelled(ASSESSMENT, utc(2026, 11, 9, 0, 0)))
+        self.assertEqual(fee, 4750)
+
+    def test_cancelled_after_start_costs_half_the_session_price(self):
+        self.assertEqual(cancellation_fee(self.cancelled(cancelled_at=utc(2026, 11, 10, 10, 0))), 3500)
+
+    def test_explicit_cancelled_at_overrides_the_stored_one(self):
+        appointment = self.cancelled(cancelled_at=utc(2026, 11, 1, 0, 0))
+        self.assertEqual(cancellation_fee(appointment, utc(2026, 11, 9, 0, 0)), 3500)
+
+    def test_uses_the_stored_cancelled_at_when_none_given(self):
+        appointment = self.cancelled(cancelled_at=utc(2026, 11, 9, 0, 0))
+        self.assertEqual(cancellation_fee(appointment), 3500)
+
+    def test_compares_instants_across_timezones(self):
+        # 21:00 on 9 Nov in Auckland (NZDT, UTC+13) is 08:00 UTC: 25 hours before the start.
+        cancelled_at = datetime.datetime(2026, 11, 9, 21, 0, tzinfo=ZoneInfo("Pacific/Auckland"))
+        self.assertEqual(cancellation_fee(self.cancelled(cancelled_at=cancelled_at)), 3500)
+
+    def test_cancelled_without_a_time_is_an_error(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled())
+
+
+class NoShowFeeTest(unittest.TestCase):
+    def test_no_show_pays_full_assessment_price(self):
+        self.assertEqual(cancellation_fee(appt("N1", utc(2026, 11, 10, 9), kind=ASSESSMENT, status="no_show")), 9500)
+
+    def test_no_show_pays_full_followup_price(self):
+        self.assertEqual(cancellation_fee(appt("N1", utc(2026, 11, 10, 9), kind=FOLLOWUP, status="no_show")), 7000)
+
+
+class NoFeeStatusTest(unittest.TestCase):
+    def test_booked_appointment_has_no_fee(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("B1", utc(2026, 11, 10, 9), status=BOOKED))
+
+    def test_attended_appointment_has_no_fee(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(appt("B1", utc(2026, 11, 10, 9), status="attended"))
+
+
+if __name__ == "__main__":
+    unittest.main()
