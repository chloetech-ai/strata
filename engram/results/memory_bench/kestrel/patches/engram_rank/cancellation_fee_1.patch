diff --git a/src/kestrel/fees.py b/src/kestrel/fees.py
new file mode 100644
index 0000000..1dd678b
--- /dev/null
+++ b/src/kestrel/fees.py
@@ -0,0 +1,30 @@
+"""Cancellation and no-show fees."""
+
+import datetime
+
+from kestrel.models import CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+LATE_CANCELLATION_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCELLATION_PERCENT = 50  # of the session price
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for a cancelled or no-show appointment.
+
+    A cancellation less than 48 hours before the start costs 50% of the session
+    price; earlier cancellations are free. A no-show pays the full session price.
+    cancelled_at defaults to the appointment's own cancelled_at.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        return price
+    if appointment.status != CANCELLED:
+        raise ValueError(f"no fee for {appointment.status} appointment {appointment.id}")
+    if cancelled_at is None:
+        cancelled_at = appointment.cancelled_at
+    if cancelled_at is None:
+        raise ValueError(f"cancelled appointment {appointment.id} has no cancellation time")
+    if appointment.start - cancelled_at < LATE_CANCELLATION_WINDOW:
+        return price * LATE_CANCELLATION_PERCENT // 100
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
