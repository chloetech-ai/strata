+from kestrel.models import Appointment, Patient
+from kestrel.pricing import appointment_price, price_for, session_price
+
+
+def appointment(kind, start):
+    return Appointment("A-1", "KP-004211", "T-1", "NG", start, kind)
+
+
+class AppointmentPriceTest(unittest.TestCase):
+    def patient(self, csc):
+        return Patient("KP-004211", "Test Patient", "+64211234567", csc=csc)
+
+    def test_before_1_april_2027_pays_old_prices(self):
+        start = datetime.datetime(2027, 3, 31, 9, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment("assessment", start), self.patient(False)), 9500)
+        self.assertEqual(appointment_price(appointment("followup", start), self.patient(False)), 7000)
+
+    def test_from_1_april_2027_pays_new_prices(self):
+        start = datetime.datetime(2027, 4, 1, 9, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment("assessment", start), self.patient(False)), 10500)
+        self.assertEqual(appointment_price(appointment("followup", start), self.patient(False)), 7800)
+
+    def test_cutoff_uses_auckland_date_not_utc_date(self):
+        # 2027-04-01 09:30 in Auckland (NZDT, UTC+13) is 2027-03-31 20:30 UTC
+        start = datetime.datetime(2027, 3, 31, 20, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment("followup", start), self.patient(False)), 7800)
+        # 2027-03-31 23:30 in Auckland is 2027-03-31 10:30 UTC
+        start = datetime.datetime(2027, 3, 31, 10, 30, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment("followup", start), self.patient(False)), 7000)
+
+    def test_csc_followup_discount_on_new_price(self):
+        start = datetime.datetime(2027, 4, 2, 9, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment("followup", start), self.patient(True)), 6240)
+
+    def test_csc_followup_discount_on_old_price(self):
+        start = datetime.datetime(2026, 10, 15, 9, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment("followup", start), self.patient(True)), 5600)
+
+    def test_csc_assessment_is_not_discounted(self):
+        start = datetime.datetime(2027, 4, 2, 9, 0, tzinfo=datetime.timezone.utc)
+        self.assertEqual(appointment_price(appointment("assessment", start), self.patient(True)), 10500)
+
+    def test_returns_integer_cents(self):
+        start = datetime.datetime(2027, 4, 2, 9, 0, tzinfo=datetime.timezone.utc)
+        price = appointment_price(appointment("followup", start), self.patient(True))
+        self.assertIsInstance(price, int)
 
 
 class PriceForTest(unittest.TestCase):
