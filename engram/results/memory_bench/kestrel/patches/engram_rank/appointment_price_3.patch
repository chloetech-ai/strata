diff --git a/src/kestrel/pricing.py b/src/kestrel/pricing.py
index ef522e6..d1c5abb 100644
--- a/src/kestrel/pricing.py
+++ b/src/kestrel/pricing.py
@@ -1,11 +1,20 @@
 """Session prices."""
 
+import datetime
+from zoneinfo import ZoneInfo
+
 from kestrel.models import ASSESSMENT, FOLLOWUP
 
 PRICES_CENTS = {
     ASSESSMENT: 9500,  # $95
     FOLLOWUP: 7000,  # $70
 }
+NEW_PRICES_FROM = datetime.date(2027, 4, 1)  # by Auckland local date
+NEW_PRICES_CENTS = {
+    ASSESSMENT: 10500,  # $105
+    FOLLOWUP: 7800,  # $78
+}
+CLINIC_TIMEZONE = ZoneInfo("Pacific/Auckland")
 CSC_FOLLOWUP_PERCENT_OFF = 20  # CSC holders: follow-ups only, not assessments
 
 
@@ -19,7 +28,25 @@ def session_price(kind):
 
 def price_for(patient, kind):
     """Price in cents for this patient, after any Community Services Card discount."""
-    price = session_price(kind)
+    return _after_csc_discount(patient, kind, session_price(kind))
+
+
+def appointment_price(appointment, patient):
+    """Price in cents the patient pays for this appointment.
+
+    Uses the list price in force on the appointment's Auckland local date,
+    then applies any Community Services Card discount.
+    """
+    kind = appointment.kind
+    local_date = appointment.start.astimezone(CLINIC_TIMEZONE).date()
+    if local_date >= NEW_PRICES_FROM:
+        price = NEW_PRICES_CENTS[kind]
+    else:
+        price = session_price(kind)
+    return _after_csc_discount(patient, kind, price)
+
+
+def _after_csc_discount(patient, kind, price):
     if patient.csc and kind == FOLLOWUP:
         price = price * (100 - CSC_FOLLOWUP_PERCENT_OFF) // 100
     return price
