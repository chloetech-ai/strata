diff --git a/src/kestrel/fees.py b/src/kestrel/fees.py
new file mode 100644
index 0000000..eec662f
--- /dev/null
+++ b/src/kestrel/fees.py
@@ -0,0 +1,33 @@
+"""Cancellation and no-show fees."""
+
+import datetime
+
+from kestrel.models import CANCELLED, NO_SHOW
+from kestrel.pricing import session_price
+
+LATE_CANCEL_WINDOW = datetime.timedelta(hours=48)
+LATE_CANCEL_PERCENT = 50  # of the session price
+NO_SHOW_PERCENT = 100  # of the session price
+
+
+def cancellation_fee(appointment, cancelled_at=None):
+    """Fee in cents for a cancelled or no-show appointment.
+
+    A cancellation less than 48 hours before the start costs 50% of the session
+    price, otherwise nothing. A no-show costs the full session price. cancelled_at
+    is when the patient cancelled; it must be None for a no-show.
+    """
+    price = session_price(appointment.kind)
+    if appointment.status == NO_SHOW:
+        if cancelled_at is not None:
+            raise ValueError(f"no-show appointment {appointment.id} has no cancellation time")
+        return price * NO_SHOW_PERCENT // 100
+    if appointment.status == CANCELLED:
+        if cancelled_at is None:
+            raise ValueError(f"cancelled appointment {appointment.id} needs cancelled_at")
+        if cancelled_at.tzinfo is None:
+            raise ValueError("cancelled_at must be timezone-aware")
+        if appointment.start - cancelled_at < LATE_CANCEL_WINDOW:
+            return price * LATE_CANCEL_PERCENT // 100
+        return 0
+    raise ValueError(f"no fee for {appointment.status} appointment {appointment.id}")
diff --git a/tests/test_fees.py b/tests/test_fees.py
