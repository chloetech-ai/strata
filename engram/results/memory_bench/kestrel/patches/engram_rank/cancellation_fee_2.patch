--- /dev/null
+++ b/tests/test_fees.py
@@ -0,0 +1,82 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.fees import cancellation_fee
+from kestrel.models import ASSESSMENT, ATTENDED, BOOKED, CANCELLED, FOLLOWUP, NO_SHOW
+
+NZ = datetime.timezone(datetime.timedelta(hours=13))  # Pacific/Auckland in NZDT
+
+
+class LateCancellationTest(unittest.TestCase):
+    def start(self):
+        return utc(2026, 11, 2, 9, 0)
+
+    def cancelled(self, kind):
+        return appt("A1", self.start(), kind=kind, status=CANCELLED)
+
+    def test_cancel_more_than_48_hours_ahead_is_free(self):
+        at = self.start() - datetime.timedelta(hours=49)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), at), 0)
+
+    def test_cancel_exactly_48_hours_ahead_is_free(self):
+        at = self.start() - datetime.timedelta(hours=48)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), at), 0)
+
+    def test_cancel_inside_48_hours_costs_half_the_assessment_price(self):
+        at = self.start() - datetime.timedelta(hours=47, minutes=59)
+        self.assertEqual(cancellation_fee(self.cancelled(ASSESSMENT), at), 4750)
+
+    def test_cancel_inside_48_hours_costs_half_the_followup_price(self):
+        at = self.start() - datetime.timedelta(hours=24)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), at), 3500)
+
+    def test_cancel_after_start_costs_half_the_price(self):
+        at = self.start() + datetime.timedelta(hours=1)
+        self.assertEqual(cancellation_fee(self.cancelled(FOLLOWUP), at), 3500)
+
+    def test_window_is_absolute_time_across_timezones(self):
+        start = datetime.datetime(2026, 11, 2, 9, 0, tzinfo=NZ)
+        at = start.astimezone(datetime.timezone.utc) - datetime.timedelta(hours=47)
+        appointment = appt("A1", start, kind=FOLLOWUP, status=CANCELLED)
+        self.assertEqual(cancellation_fee(appointment, at), 3500)
+
+    def test_rejects_naive_cancelled_at(self):
+        at = datetime.datetime(2026, 11, 1, 9, 0)
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled(FOLLOWUP), at)
+
+    def test_rejects_cancelled_without_cancelled_at(self):
+        with self.assertRaises(ValueError):
+            cancellation_fee(self.cancelled(FOLLOWUP), None)
+
+
+class NoShowTest(unittest.TestCase):
+    def test_no_show_assessment_pays_full_price(self):
+        appointment = appt("A1", utc(2026, 11, 2, 9, 0), kind=ASSESSMENT, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(appointment), 9500)
+
+    def test_no_show_followup_pays_full_price(self):
+        appointment = appt("A1", utc(2026, 11, 2, 9, 0), kind=FOLLOWUP, status=NO_SHOW)
+        self.assertEqual(cancellation_fee(appointment), 7000)
+
+    def test_rejects_no_show_with_cancelled_at(self):
+        appointment = appt("A1", utc(2026, 11, 2, 9, 0), kind=FOLLOWUP, status=NO_SHOW)
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment, utc(2026, 11, 1, 9, 0))
+
+
+class NoFeeStatusTest(unittest.TestCase):
+    def test_rejects_booked_appointment(self):
+        appointment = appt("A1", utc(2026, 11, 2, 9, 0), status=BOOKED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment)
+
+    def test_rejects_attended_appointment(self):
+        appointment = appt("A1", utc(2026, 11, 2, 9, 0), status=ATTENDED)
+        with self.assertRaises(ValueError):
+            cancellation_fee(appointment)
+
+
+if __name__ == "__main__":
+    unittest.main()
