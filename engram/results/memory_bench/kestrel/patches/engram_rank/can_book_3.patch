+"""Checks the booking form runs before an appointment is saved."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+GAP_AFTER_MINUTES = {ASSESSMENT: 15, FOLLOWUP: 0}  # so the therapist can write notes
+MAX_PER_DAY = 8  # union agreement: patient appointments per therapist per day
+START_MINUTES = 15  # appointments start on a quarter hour
+
+
+def _blocked(appointment):
+    """The span an appointment occupies, including the gap after it."""
+    minutes = MINUTES[appointment.kind] + GAP_AFTER_MINUTES[appointment.kind]
+    return appointment.start, appointment.start + datetime.timedelta(minutes=minutes)
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist."""
+    if appointment.therapist_id != therapist.id:
+        return False
+    local = appointment.start.astimezone(LOCAL_TZ)
+    if local.minute % START_MINUTES or local.second or local.microsecond:
+        return False
+    new_start, new_end = _blocked(appointment)
+    booked_that_day = 0
+    for other in calendar.for_therapist(therapist.id):
+        if other.status == CANCELLED or other.id == appointment.id:
+            continue
+        other_start, other_end = _blocked(other)
+        if new_start < other_end and other_start < new_end:
+            return False
+        if other.start.astimezone(LOCAL_TZ).date() == local.date():
+            booked_that_day += 1
+    return booked_that_day < MAX_PER_DAY
diff --git a/tests/test_booking.py b/tests/test_booking.py
