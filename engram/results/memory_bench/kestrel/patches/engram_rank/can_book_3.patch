+++ b/tests/test_booking.py
@@ -0,0 +1,80 @@
+import datetime
+import unittest
+
+from helpers import appt, utc
+from kestrel.booking import can_book
+from kestrel.calendar import LOCAL_TZ, Calendar
+from kestrel.models import CANCELLED, Therapist
+
+THERAPIST = Therapist(id="T1", name="Sam", clinic="HB")
+
+
+def local(y, m, d, hh=0, mm=0):
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=LOCAL_TZ)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_free_slot(self):
+        self.assertTrue(can_book(_cal(), THERAPIST, appt("n", local(2027, 3, 1, 9), kind="followup")))
+
+    def test_follow_up_overlapping_existing_follow_up(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind="followup")])
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 9, 15), kind="followup")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 9, 30), kind="followup")))
+
+    def test_assessment_needs_15_minute_gap_after_assessment(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 10), kind="assessment")])  # blocks 10:00-11:00
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 10, 45), kind="assessment")))
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 10, 30), kind="followup")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 11), kind="assessment")))
+
+    def test_follow_up_has_no_gap_after_it(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 10), kind="followup")])  # blocks 10:00-10:30
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 10, 30), kind="followup")))
+
+    def test_new_assessment_must_leave_gap_before_next_appointment(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 10, 30), kind="followup")])
+        # 10:00 assessment would run 10:00-11:00 plus the gap, into the 10:30 follow-up
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 10), kind="assessment")))
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 9), kind="assessment")))
+
+    def test_start_must_be_on_quarter_hour(self):
+        self.assertFalse(can_book(_cal(), THERAPIST, appt("n", local(2027, 3, 1, 9, 10), kind="followup")))
+        self.assertTrue(can_book(_cal(), THERAPIST, appt("n", local(2027, 3, 1, 9, 45), kind="followup")))
+
+    def test_cancelled_appointment_does_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind="followup", status=CANCELLED, cancelled_at=utc(2027, 2, 28))])
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 9), kind="followup")))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 1, 9), kind="followup", therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 9), kind="followup")))
+
+    def test_appointment_for_another_therapist_is_refused(self):
+        self.assertFalse(can_book(_cal(), THERAPIST, appt("n", local(2027, 3, 1, 9), kind="followup", therapist="T2")))
+
+    def test_daily_cap_of_eight(self):
+        cal = Calendar([appt(f"a{i}", local(2027, 3, 1, 9) + datetime.timedelta(minutes=30 * i), kind="followup") for i in range(8)])
+        self.assertFalse(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 13), kind="followup")))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        appts = [appt(f"a{i}", local(2027, 3, 1, 9) + datetime.timedelta(minutes=30 * i), kind="followup") for i in range(8)]
+        appts[0].status = CANCELLED
+        appts[0].cancelled_at = utc(2027, 2, 28)
+        cal = Calendar(appts)
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 13), kind="followup")))
+
+    def test_cap_counts_by_auckland_date(self):
+        # Seven on 1 March and one on 2 March, by Auckland date
+        appts = [appt(f"a{i}", local(2027, 3, 1, 9) + datetime.timedelta(minutes=30 * i), kind="followup") for i in range(7)]
+        appts.append(appt("late", local(2027, 3, 2, 9), kind="followup"))
+        cal = Calendar(appts)
+        self.assertTrue(can_book(cal, THERAPIST, appt("n", local(2027, 3, 1, 13), kind="followup")))
+
+
+def _cal():
+    return Calendar()
+
+
+if __name__ == "__main__":
+    unittest.main()
