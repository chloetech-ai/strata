+"""Free appointment slots for a therapist on a day."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+SLOT_STEP = datetime.timedelta(minutes=15)  # every appointment starts on a quarter hour
+MAX_PATIENTS_PER_DAY = 8  # union agreement
+
+LENGTH = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+# Time kept free after an appointment so the therapist can write notes.
+GAP = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a date, or None if closed."""
+    if day.weekday() < 5:
+        return datetime.time(7, 30), datetime.time(18, 0)
+    if day.weekday() == 5 and clinic == "NG":  # Saturday hours: Northgate only
+        return datetime.time(8, 0), datetime.time(12, 0)
+    return None
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) when a new appointment of this kind
+    could be booked for the therapist on a local (Auckland) date."""
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+    booked = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(booked) >= MAX_PATIENTS_PER_DAY:
+        return []
+
+    # Busy spans in UTC, including each appointment's own gap, so the
+    # comparisons are not affected by wall-clock arithmetic across DST.
+    busy = []
+    for a in booked:
+        begin = a.start.astimezone(UTC)
+        busy.append((begin, begin + LENGTH[a.kind] + GAP[a.kind]))
+
+    opens = datetime.datetime.combine(day, hours[0], tzinfo=LOCAL_TZ).astimezone(UTC)
+    closes = datetime.datetime.combine(day, hours[1], tzinfo=LOCAL_TZ).astimezone(UTC)
+    length, gap = LENGTH[kind], GAP[kind]
+
+    times = []
+    start = opens
+    while start + length <= closes:
+        # The new appointment and its gap must not touch any busy span.
+        end = start + length + gap
+        if all(end <= begin or start >= finish for begin, finish in busy):
+            times.append(start.astimezone(LOCAL_TZ).time())
+        start += SLOT_STEP
+    return times
diff --git a/tests/test_slots.py b/tests/test_slots.py
