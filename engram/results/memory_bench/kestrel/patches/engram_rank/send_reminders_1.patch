+"""Appointment reminders sent by SMS."""
+
+from .calendar import LOCAL_TZ
+from .models import BOOKED, CLINICS
+
+
+def reminder_text(appointment):
+    """The SMS for one appointment: clinic name, date and time only, no treatment."""
+    local = appointment.start.astimezone(LOCAL_TZ)
+    clinic = CLINICS[appointment.clinic].name
+    return f"Reminder: {clinic} appointment on {local:%a %d %b} at {local:%H:%M}."
+
+
+def send_reminders(appointments, patients, client):
+    """Text the patient of every booked appointment; return how many messages were sent.
+
+    patients maps patient ID to Patient; client is a BulkieClient. Appointments
+    that are not booked (cancelled, attended, no-show) are skipped.
+    """
+    messages = [
+        (patients[a.patient_id].phone, reminder_text(a))
+        for a in appointments
+        if a.status == BOOKED
+    ]
+    client.send_batch(messages)
+    return len(messages)
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..f75e4f1
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,83 @@
+import datetime
+import unittest
+
+from kestrel.models import CANCELLED, NO_SHOW, ATTENDED, Patient
+from kestrel.reminders import reminder_text, send_reminders
+from kestrel.sms import BulkieClient
+from helpers import appt, utc
+
+
+class FakeTransport:
+    def __init__(self):
+        self.calls = []
+
+    def post(self, path, body):
+        self.calls.append((path, body))
+        return {"ok": True}
+
+
+PATIENTS = {
+    "KP-000001": Patient("KP-000001", "Aroha", "+64211111111"),
+    "KP-000002": Patient("KP-000002", "Ben", "+64222222222"),
+}
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_sends_one_sms_per_booked_appointment_and_counts_them(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 3, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 21, 3, 0), patient="KP-000002"),
+        ]
+        sent = send_reminders(appointments, PATIENTS, BulkieClient("key", transport))
+        self.assertEqual(sent, 2)
+        (path, body), = transport.calls
+        self.assertEqual(path, "/v2/messages")
+        self.assertEqual([m["to"] for m in body["messages"]], ["+64211111111", "+64222222222"])
+
+    def test_skips_cancelled_attended_and_no_show(self):
+        transport = FakeTransport()
+        appointments = [
+            appt("A1", utc(2026, 10, 20, 3, 0), patient="KP-000001"),
+            appt("A2", utc(2026, 10, 20, 4, 0), patient="KP-000002", status=CANCELLED,
+                 cancelled_at=utc(2026, 10, 15, 0, 0)),
+            appt("A3", utc(2026, 10, 20, 5, 0), patient="KP-000002", status=ATTENDED),
+            appt("A4", utc(2026, 10, 20, 6, 0), patient="KP-000002", status=NO_SHOW),
+        ]
+        sent = send_reminders(appointments, PATIENTS, BulkieClient("key", transport))
+        self.assertEqual(sent, 1)
+        self.assertEqual(len(transport.calls[0][1]["messages"]), 1)
+
+    def test_no_booked_appointments_sends_nothing(self):
+        transport = FakeTransport()
+        self.assertEqual(send_reminders([], PATIENTS, BulkieClient("key", transport)), 0)
+        self.assertEqual(transport.calls, [])
+
+    def test_more_than_50_is_split_by_send_batch(self):
+        transport = FakeTransport()
+        appointments = [
+            appt(f"A{i}", utc(2026, 10, 20, 0, 0) + datetime.timedelta(minutes=i), patient="KP-000001")
+            for i in range(51)
+        ]
+        self.assertEqual(send_reminders(appointments, PATIENTS, BulkieClient("key", transport)), 51)
+        sizes = [len(body["messages"]) for _, body in transport.calls]
+        self.assertEqual(sizes, [50, 1])
+
+    def test_text_gives_local_date_and_time_and_clinic_only(self):
+        # 03:00 UTC on 20 Oct is 16:00 NZDT (UTC+13) on the same day.
+        a = appt("A1", utc(2026, 10, 20, 3, 0), clinic="HB", treatment="lower back pain")
+        text = reminder_text(a)
+        self.assertIn("Kestrel Physio Harbour", text)
+        self.assertIn("Tue 20 Oct", text)
+        self.assertIn("16:00", text)
+        self.assertNotIn("lower back", text)
+
+    def test_local_date_used_not_utc_date(self):
+        # 14:00 UTC on 20 Oct is 03:00 on 21 Oct in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 20, 14, 0)))
+        self.assertIn("Wed 21 Oct", text)
+        self.assertIn("03:00", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
