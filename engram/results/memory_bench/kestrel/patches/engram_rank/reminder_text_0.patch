@@ -0,0 +1,43 @@
+import unittest
+
+from kestrel.reminders import reminder_text
+
+from helpers import appt, utc
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_gives_local_date_and_time_and_clinic_name(self):
+        # 01:30 UTC on 22 October 2026 is 2:30pm in Auckland (NZDT, UTC+13).
+        text = reminder_text(appt("A1", utc(2026, 10, 22, 1, 30), clinic="HB"))
+        self.assertIn("Thursday 22 October at 2:30pm", text)
+        self.assertIn("Kestrel Physio Harbour", text)
+
+    def test_uses_auckland_date_not_utc_date(self):
+        # 20:00 UTC on 21 October is 9:00am on 22 October in Auckland.
+        text = reminder_text(appt("A1", utc(2026, 10, 21, 20, 0)))
+        self.assertIn("Thursday 22 October at 9:00am", text)
+
+    def test_midnight_and_noon_are_12(self):
+        # 12:00 UTC is 1:00am NZDT; 00:00 local is 11:00 UTC the day before.
+        self.assertIn("at 12:00am", reminder_text(appt("A1", utc(2026, 10, 21, 11, 0))))
+        self.assertIn("at 12:00pm", reminder_text(appt("A1", utc(2026, 10, 22, 23, 0))))
+
+    def test_uses_each_clinic_name(self):
+        for code, name in (("NG", "Northgate"), ("WK", "Westwick")):
+            with self.subTest(clinic=code):
+                text = reminder_text(appt("A1", utc(2026, 10, 22, 1, 30), clinic=code))
+                self.assertIn(f"Kestrel Physio {name}", text)
+
+    def test_never_mentions_treatment(self):
+        text = reminder_text(appt("A1", utc(2026, 10, 22, 1, 30), treatment="lower back pain"))
+        self.assertNotIn("lower back pain", text.lower())
+        self.assertNotIn("treatment", text.lower())
+
+    def test_does_not_depend_on_appointment_kind(self):
+        assessment = reminder_text(appt("A1", utc(2026, 10, 22, 1, 30), kind="assessment"))
+        followup = reminder_text(appt("A2", utc(2026, 10, 22, 1, 30), kind="followup"))
+        self.assertEqual(assessment, followup)
+
+
+if __name__ == "__main__":
+    unittest.main()
