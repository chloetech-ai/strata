+"""SMS appointment reminders."""
+
+from zoneinfo import ZoneInfo
+
+from .models import CLINICS
+
+# Kestrel's clinics are all in Auckland; appointment times are stored in UTC.
+LOCAL_TZ = ZoneInfo("Pacific/Auckland")
+
+WEEKDAYS = ("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
+MONTHS = (
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+)
+
+
+def reminder_text(appointment):
+    """Text of the SMS reminder sent two days before an appointment.
+
+    Privacy: the text names the date, time and clinic only. It must never
+    mention the treatment, so this function takes no patient details.
+    """
+    local = appointment.start.astimezone(LOCAL_TZ)
+    hour = local.hour % 12 or 12
+    meridiem = "am" if local.hour < 12 else "pm"
+    when = f"{WEEKDAYS[local.weekday()]} {local.day} {MONTHS[local.month - 1]} at {hour}:{local.minute:02d}{meridiem}"
+    clinic = CLINICS[appointment.clinic].name
+    return (
+        f"Kia ora from {clinic}. This is a friendly reminder of your appointment "
+        f"on {when}. If you need to change or cancel, please call us as soon as "
+        f"you can. See you then!"
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
