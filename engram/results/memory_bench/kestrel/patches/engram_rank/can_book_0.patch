+++ b/tests/test_booking.py
@@ -0,0 +1,94 @@
+import datetime
+import unittest
+
+from helpers import appt
+from kestrel.booking import can_book
+from kestrel.calendar import LOCAL_TZ, Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+
+THERAPIST = Therapist("T1", "Ruth", "HB")
+
+
+def local(hh, mm=0, day=1):
+    return datetime.datetime(2027, 3, day, hh, mm, tzinfo=LOCAL_TZ)
+
+
+def booking(id, start, kind=FOLLOWUP, therapist="T1", **kw):
+    return appt(id, start, kind=kind, therapist=therapist, **kw)
+
+
+class CanBookTest(unittest.TestCase):
+    def test_empty_calendar_allows_booking(self):
+        self.assertTrue(can_book(Calendar(), THERAPIST, booking("n", local(9))))
+
+    def test_rejects_overlapping_followup(self):
+        cal = Calendar([booking("a1", local(9))])
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9, 15))))
+
+    def test_allows_back_to_back_followups(self):
+        cal = Calendar([booking("a1", local(9))])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9, 30))))
+
+    def test_assessment_blocks_gap_after_it(self):
+        cal = Calendar([booking("a1", local(9), kind=ASSESSMENT)])
+        # The assessment runs 09:00-09:45 and keeps 09:45-10:00 free for notes.
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9, 45))))
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(10))))
+
+    def test_new_assessment_needs_gap_before_next_appointment(self):
+        cal = Calendar([booking("a1", local(10))])
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(9, 30), kind=ASSESSMENT)))
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9), kind=ASSESSMENT)))
+
+    def test_assessment_then_followup_at_gap_end_is_allowed(self):
+        cal = Calendar([booking("a1", local(9), kind=ASSESSMENT)])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(10), kind=FOLLOWUP)))
+
+    def test_other_therapists_do_not_clash(self):
+        cal = Calendar([booking("a1", local(9), therapist="T2")])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9))))
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([booking("a1", local(9), status=CANCELLED)])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9))))
+
+    def test_rejects_start_not_on_quarter_hour(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, booking("n", local(9, 10))))
+        self.assertTrue(can_book(Calendar(), THERAPIST, booking("n", local(9, 45))))
+
+    def test_quarter_hour_is_checked_in_local_time(self):
+        # 21:00 UTC on 31 Mar 2027 is 10:00 NZDT on 1 Apr, which is on the hour.
+        start = datetime.datetime(2027, 3, 31, 21, 0, tzinfo=datetime.timezone.utc)
+        self.assertTrue(can_book(Calendar(), THERAPIST, booking("n", start)))
+
+    def test_rejects_ninth_appointment_on_a_day(self):
+        existing = [booking(f"a{i}", local(8 + i)) for i in range(8)]
+        cal = Calendar(existing)
+        self.assertFalse(can_book(cal, THERAPIST, booking("n", local(17))))
+
+    def test_eighth_appointment_on_a_day_is_allowed(self):
+        existing = [booking(f"a{i}", local(8 + i)) for i in range(7)]
+        cal = Calendar(existing)
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(17))))
+
+    def test_daily_cap_counts_auckland_date(self):
+        # Eight full days on 1 March leave 2 March open.
+        cal = Calendar([booking(f"a{i}", local(8 + i)) for i in range(8)])
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(9, day=2))))
+
+    def test_cancelled_appointments_do_not_count_toward_cap(self):
+        existing = [booking(f"a{i}", local(8 + i)) for i in range(7)]
+        existing.append(booking("c1", local(16), status=CANCELLED))
+        cal = Calendar(existing)
+        self.assertTrue(can_book(cal, THERAPIST, booking("n", local(17))))
+
+    def test_rejects_appointment_for_another_therapist(self):
+        self.assertFalse(can_book(Calendar(), THERAPIST, booking("n", local(9), therapist="T2")))
+
+    def test_rejects_id_already_in_calendar(self):
+        cal = Calendar([booking("a1", local(9))])
+        self.assertFalse(can_book(cal, THERAPIST, booking("a1", local(11))))
+
+
+if __name__ == "__main__":
+    unittest.main()
