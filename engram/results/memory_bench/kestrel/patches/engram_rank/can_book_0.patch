@@ -0,0 +1,47 @@
+"""Checks the booking form runs before saving an appointment."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP
+
+# Appointment lengths, in minutes, by kind.
+LENGTH_MINUTES = {ASSESSMENT: 45, FOLLOWUP: 30}
+
+# Free time the therapist keeps after an assessment to write notes.
+ASSESSMENT_GAP_MINUTES = 15
+
+# Union agreement: at most this many patient appointments per therapist per day.
+DAILY_LIMIT = 8
+
+
+def _occupied_end(appointment):
+    """When the appointment stops blocking the therapist, including any gap after it."""
+    minutes = LENGTH_MINUTES[appointment.kind]
+    if appointment.kind == ASSESSMENT:
+        minutes += ASSESSMENT_GAP_MINUTES
+    return appointment.start + datetime.timedelta(minutes=minutes)
+
+
+def can_book(calendar, therapist, appointment):
+    """True if the appointment can be added to the calendar for this therapist."""
+    if appointment.therapist_id != therapist.id:
+        return False
+
+    local_start = appointment.start.astimezone(LOCAL_TZ)
+    if local_start.minute % 15 or local_start.second or local_start.microsecond:
+        return False
+
+    new_end = _occupied_end(appointment)
+    same_day = []
+    for existing in calendar.for_therapist(therapist.id):
+        if existing.id == appointment.id:
+            return False
+        if existing.status == CANCELLED:
+            continue
+        if existing.start.astimezone(LOCAL_TZ).date() == local_start.date():
+            same_day.append(existing)
+        if appointment.start < _occupied_end(existing) and existing.start < new_end:
+            return False
+
+    return len(same_day) < DAILY_LIMIT
diff --git a/tests/test_booking.py b/tests/test_booking.py
