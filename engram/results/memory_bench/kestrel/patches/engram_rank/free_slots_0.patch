diff --git a/src/kestrel/slots.py b/src/kestrel/slots.py
new file mode 100644
index 0000000..e015d7e
--- /dev/null
+++ b/src/kestrel/slots.py
@@ -0,0 +1,71 @@
+"""Free appointment slots for a therapist on a clinic day."""
+
+import datetime
+
+from .calendar import LOCAL_TZ
+from .models import ASSESSMENT, CANCELLED, FOLLOWUP, KINDS
+
+UTC = datetime.timezone.utc
+
+# How long each kind of appointment lasts, and the gap the therapist needs
+# after it before the next patient (time to write notes after an assessment).
+LENGTH = {
+    ASSESSMENT: datetime.timedelta(minutes=45),
+    FOLLOWUP: datetime.timedelta(minutes=30),
+}
+GAP_AFTER = {
+    ASSESSMENT: datetime.timedelta(minutes=15),
+    FOLLOWUP: datetime.timedelta(0),
+}
+START_STEP = datetime.timedelta(minutes=15)  # every start is on a quarter hour
+MAX_PER_DAY = 8  # union agreement: patient appointments per therapist per day
+
+# Opening hours, local time. Weekdays at every clinic, Saturday at Northgate
+# only, Sundays closed.
+WEEKDAY_HOURS = (datetime.time(7, 30), datetime.time(18, 0))
+SATURDAY_HOURS = {"NG": (datetime.time(8, 0), datetime.time(12, 0))}
+
+
+def opening_hours(clinic, day):
+    """(open, close) local times for a clinic on a local date, or None if closed."""
+    if day.weekday() == 6:  # Sunday
+        return None
+    if day.weekday() == 5:  # Saturday
+        return SATURDAY_HOURS.get(clinic)
+    return WEEKDAY_HOURS
+
+
+def free_slots(calendar, therapist, day, kind):
+    """Local start times (datetime.time, sorted) when a new `kind` appointment could be booked.
+
+    A start is free when the appointment and its after-gap fit within opening
+    hours and overlap no live appointment for this therapist, including the
+    gap after an existing assessment. Cancelled appointments are ignored.
+    Returns nothing once the therapist has MAX_PER_DAY appointments that day.
+    """
+    if kind not in KINDS:
+        raise ValueError(f"unknown kind {kind!r}")
+    hours = opening_hours(therapist.clinic, day)
+    if hours is None:
+        return []
+
+    live = [a for a in calendar.for_day(therapist.id, day) if a.status != CANCELLED]
+    if len(live) >= MAX_PER_DAY:
+        return []
+    # Each existing appointment occupies its time plus its after-gap.
+    busy = [(a.start, a.start + LENGTH[a.kind] + GAP_AFTER[a.kind]) for a in live]
+
+    length = LENGTH[kind]
+    block = length + GAP_AFTER[kind]
+    open_at, close_at = hours
+    start = datetime.datetime.combine(day, open_at, tzinfo=LOCAL_TZ)
+    close = datetime.datetime.combine(day, close_at, tzinfo=LOCAL_TZ)
+
+    times = []
+    while start + length <= close:
+        begin = start.astimezone(UTC)
+        end = begin + block
+        if all(end <= busy_start or begin >= busy_end for busy_start, busy_end in busy):
+            times.append(start.time())
+        start += START_STEP
+    return times
diff --git a/tests/test_slots.py b/tests/test_slots.py
new file mode 100644
index 0000000..f6fe5ee
--- /dev/null
+++ b/tests/test_slots.py
@@ -0,0 +1,112 @@
+import datetime
+from zoneinfo import ZoneInfo
+import unittest
+
+from helpers import appt
+from kestrel.calendar import Calendar
+from kestrel.models import ASSESSMENT, CANCELLED, FOLLOWUP, Therapist
+from kestrel.slots import free_slots
+
+AUCKLAND = ZoneInfo("Pacific/Auckland")
+THU = datetime.date(2027, 3, 4)  # a Thursday
+SAT = datetime.date(2027, 3, 6)
+SUN = datetime.date(2027, 3, 7)
+HB = Therapist("T1", "Ann", "HB")
+NG = Therapist("T2", "Ben", "NG")
+
+
+def local(y, m, d, hh=0, mm=0):
+    """An Auckland local time, so each test states the clinic day it means."""
+    return datetime.datetime(y, m, d, hh, mm, tzinfo=AUCKLAND)
+
+
+def at(hh, mm=0):
+    return datetime.time(hh, mm)
+
+
+class FreeSlotsTest(unittest.TestCase):
+    def test_empty_day_assessment_runs_from_opening_to_last_fitting_start(self):
+        slots = free_slots(Calendar(), HB, THU, ASSESSMENT)
+        self.assertEqual(slots[0], at(7, 30))
+        self.assertEqual(slots[-1], at(17, 15))  # 17:15 + 45 min ends at 18:00
+        self.assertEqual(len(slots), 40)
+
+    def test_empty_day_followup_last_start_is_1730(self):
+        slots = free_slots(Calendar(), HB, THU, FOLLOWUP)
+        self.assertEqual(slots[-1], at(17, 30))
+
+    def test_starts_are_on_quarter_hours_and_sorted(self):
+        slots = free_slots(Calendar(), HB, THU, FOLLOWUP)
+        self.assertEqual(slots, sorted(slots))
+        self.assertTrue(all(t.minute in (0, 15, 30, 45) and t.second == 0 for t in slots))
+
+    def test_saturday_only_northgate_open_08_to_12(self):
+        self.assertEqual(free_slots(Calendar(), HB, SAT, FOLLOWUP), [])
+        slots = free_slots(Calendar(), NG, SAT, ASSESSMENT)
+        self.assertEqual(slots[0], at(8, 0))
+        self.assertEqual(slots[-1], at(11, 15))  # 11:15 + 45 min ends at 12:00
+
+    def test_sunday_closed_everywhere(self):
+        self.assertEqual(free_slots(Calendar(), NG, SUN, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(), HB, SUN, FOLLOWUP), [])
+
+    def test_unknown_kind_raises(self):
+        with self.assertRaises(ValueError):
+            free_slots(Calendar(), HB, THU, "massage")
+
+    def test_booked_assessment_blocks_its_time_and_the_gap_after_it(self):
+        cal = Calendar([appt("a1", local(2027, 3, 4, 9), kind=ASSESSMENT, therapist="T1")])
+        slots = free_slots(cal, HB, THU, FOLLOWUP)
+        self.assertNotIn(at(9, 0), slots)
+        self.assertNotIn(at(9, 15), slots)
+        self.assertNotIn(at(9, 30), slots)
+        self.assertNotIn(at(9, 45), slots)  # inside the 15-minute gap after 9:00-9:45
+        self.assertNotIn(at(8, 45), slots)  # a 30-minute follow-up would run into the 9:00 assessment
+        self.assertIn(at(8, 30), slots)  # ends at 9:00, when the assessment starts
+        self.assertIn(at(10, 0), slots)
+
+    def test_new_assessment_needs_its_own_gap_free(self):
+        cal = Calendar([appt("a1", local(2027, 3, 4, 9), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, THU, ASSESSMENT)
+        self.assertNotIn(at(8, 30), slots)  # 45 min from 8:30 runs into the 9:00 follow-up
+        self.assertIn(at(8, 0), slots)  # 8:00-8:45 plus 15-min gap ends at 9:00
+        self.assertIn(at(9, 30), slots)  # no gap after a follow-up
+
+    def test_no_gap_after_a_followup(self):
+        cal = Calendar([appt("a1", local(2027, 3, 4, 9), kind=FOLLOWUP, therapist="T1")])
+        slots = free_slots(cal, HB, THU, FOLLOWUP)
+        self.assertNotIn(at(9, 15), slots)
+        self.assertIn(at(9, 30), slots)
+
+    def test_cancelled_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 4, 9), kind=ASSESSMENT, therapist="T1",
+                             status=CANCELLED, cancelled_at=local(2027, 3, 3, 12))])
+        self.assertIn(at(9, 0), free_slots(cal, HB, THU, ASSESSMENT))
+
+    def test_other_therapists_appointments_do_not_block(self):
+        cal = Calendar([appt("a1", local(2027, 3, 4, 9), kind=ASSESSMENT, therapist="T2")])
+        self.assertIn(at(9, 0), free_slots(cal, HB, THU, ASSESSMENT))
+
+    def test_day_is_the_auckland_date_not_the_utc_date(self):
+        # 09:00 Auckland on 4 March (NZDT, UTC+13) is 20:00 UTC on 3 March.
+        cal = Calendar([appt("a1", datetime.datetime(2027, 3, 3, 20, 0, tzinfo=datetime.timezone.utc),
+                             kind=FOLLOWUP, therapist="T1")])
+        self.assertNotIn(at(9, 0), free_slots(cal, HB, THU, FOLLOWUP))
+        self.assertIn(at(9, 0), free_slots(cal, HB, datetime.date(2027, 3, 3), FOLLOWUP))
+
+    def test_daily_cap_of_eight_appointments(self):
+        seven = [appt(f"a{h}", local(2027, 3, 4, h), kind=FOLLOWUP, therapist="T1") for h in range(8, 15)]
+        self.assertTrue(free_slots(Calendar(seven), HB, THU, FOLLOWUP))
+        eight = seven + [appt("a15", local(2027, 3, 4, 15), kind=FOLLOWUP, therapist="T1")]
+        self.assertEqual(free_slots(Calendar(eight), HB, THU, FOLLOWUP), [])
+        self.assertEqual(free_slots(Calendar(eight), HB, THU, ASSESSMENT), [])
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        seven = [appt(f"a{h}", local(2027, 3, 4, h), kind=FOLLOWUP, therapist="T1") for h in range(8, 15)]
+        cancelled = appt("c", local(2027, 3, 4, 15), kind=FOLLOWUP, therapist="T1",
+                         status=CANCELLED, cancelled_at=local(2027, 3, 3, 12))
+        self.assertTrue(free_slots(Calendar(seven + [cancelled]), HB, THU, FOLLOWUP))
+
+
+if __name__ == "__main__":
+    unittest.main()
