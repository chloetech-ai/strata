+    def test_suggest_orders_restocks_to_three_reorder_points(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 25, "BR-2": 20})
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-01-4", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})  # shortfall 25 -> 3 cases
+
+    def test_suggest_orders_skips_zero_quantity(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-01-5", reorder_point=0)])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
