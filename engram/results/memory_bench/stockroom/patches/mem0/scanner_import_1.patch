diff --git a/src/stockroom/scanner.py b/src/stockroom/scanner.py
new file mode 100644
index 0000000..c6fcc74
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,35 @@
+"""Reading the counts exported by the handheld scanners."""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Return the counted quantity per SKU from a scanner export.
+
+    The export is plain text with one line per count, ``bin;sku;qty``, and no
+    header. A SKU may appear on several lines when stock sits in an overflow
+    bin, so its quantities are summed. The bin is not used here.
+    """
+    counts = {}  # type: Dict[str, int]
+    # utf-8-sig tolerates the byte-order mark some Windows sync tools add.
+    with open(path, encoding="utf-8-sig") as f:
+        for line_no, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{line_no}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _, sku, qty_text = (field.strip() for field in fields)
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{line_no}: missing SKU")
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError(f"{path}:{line_no}: quantity is not a whole number: {qty_text!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{line_no}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..3cd63d9
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,56 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerFileTest(unittest.TestCase):
+    def _read(self, text, encoding="utf-8"):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding=encoding, newline="") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_counts_per_sku(self):
+        counts = self._read("A-1;BR-1042;12\nA-2;GS-7;3\n")
+        self.assertEqual(counts, {"BR-1042": 12, "GS-7": 3})
+
+    def test_sums_overflow_bins(self):
+        counts = self._read("A-1;BR-1042;12\nZ-9;BR-1042;5\n")
+        self.assertEqual(counts, {"BR-1042": 17})
+
+    def test_normalizes_sku_and_whitespace(self):
+        counts = self._read(" A-1 ; br-1042 ;4\r\nA-1;BR-1042 ; 1 \r\n")
+        self.assertEqual(counts, {"BR-1042": 5})
+
+    def test_skips_blank_lines_and_accepts_bom(self):
+        counts = self._read("﻿A-1;BR-1042;2\n\n   \nA-1;GS-7;1\n")
+        self.assertEqual(counts, {"BR-1042": 2, "GS-7": 1})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self._read("A-1;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_empty_file(self):
+        self.assertEqual(self._read(""), {})
+
+    def test_wrong_field_count_names_line(self):
+        with self.assertRaisesRegex(ValueError, ":2: expected bin;sku;qty"):
+            self._read("A-1;BR-1042;12\nA-1;BR-1042\n")
+
+    def test_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity is not a whole number"):
+            self._read("A-1;BR-1042;1.5\n")
+
+    def test_negative_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity must not be negative"):
+            self._read("A-1;BR-1042;-3\n")
+
+    def test_missing_sku(self):
+        with self.assertRaisesRegex(ValueError, ":1: missing SKU"):
+            self._read("A-1; ;3\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
