+    def test_aisle_is_uppercased(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_ignores_surrounding_whitespace(self):
+        self.assertEqual(parse_location("  B-12-3\n"), ("B", 12, 3))
+
+    def test_rejects_malformed_codes(self):
+        for bad in ("", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                    "B-12-", "B--3", "B 12 3", " B - 12 - 3", "B-+12-3", "B-12.5-3"):
+            with self.subTest(code=bad):
+                with self.assertRaises(ValueError):
+                    parse_location(bad)
