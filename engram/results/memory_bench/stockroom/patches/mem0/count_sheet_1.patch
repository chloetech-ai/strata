@@ -0,0 +1,32 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-2", "Nut", "C-03-1"),
+        Item("BR-1", "Bolt", "A-01-1", reorder_point=10),
+        Item("BR-3", "Washer", "B-02-4"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1", 5, 10)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_bin_order(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 4)  # header plus three items
+        self.assertEqual([line.split()[1] for line in lines[1:]], ["BR-1", "BR-3", "BR-2"])
+
+    def test_blind_count_omits_quantity_on_hand(self):
+        text = count_sheet(make_inventory())
+        self.assertNotIn("5", text.split("\n", 1)[1])
+        self.assertIn("________", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
