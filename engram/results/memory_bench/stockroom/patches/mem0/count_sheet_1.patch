+"""The printable count sheet for a stock-take."""
+
+COUNT_BLANK = "_" * 8
+
+
+def count_sheet(inventory):
+    """Blind count sheet as text, one line per catalog item in bin walking order.
+
+    The system's quantity on hand is deliberately left off: staff must count the
+    stock themselves, so the counted-quantity column is left empty.
+    """
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    lines = [f"{'BIN':<8} {'SKU':<10} {'ITEM':<30} {'UNIT':<5} {'COUNTED':<8}"]
+    for item in items:
+        lines.append(f"{item.location:<8} {item.sku:<10} {item.name:<30} {item.unit:<5} {COUNT_BLANK}")
+    return "\n".join(lines) + "\n"
