diff --git a/src/stockroom/scanner.py b/src/stockroom/scanner.py
new file mode 100644
index 0000000..a96179c
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,30 @@
+"""Reading the counts exported by the handheld scanners."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is ``bin;sku;qty`` with no header. A SKU can appear on several
+    lines when stock sits in an overflow bin, so its quantities are summed.
+    """
+    counts = {}
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.strip()
+            if not line:
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line!r}")
+            _bin, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {qty!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..4ac9e55
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,43 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+def _write(d, text):
+    path = os.path.join(d, "scan.txt")
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+class ScannerTest(unittest.TestCase):
+    def test_sums_overflow_bins_and_normalizes_sku(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "B-12-3;br-1042;40\nOVF-1;BR-1042 ;15\nA-1-1;NL-7;3\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 55, "NL-7": 3})
+
+    def test_skips_blank_lines_and_accepts_bom(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "﻿B-12-3;BR-1042;4\n\n   \nB-12-3;NL-7;0\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 4, "NL-7": 0})
+
+    def test_empty_file(self):
+        with tempfile.TemporaryDirectory() as d:
+            self.assertEqual(read_scanner_file(_write(d, "")), {})
+
+    def test_rejects_wrong_field_count(self):
+        with tempfile.TemporaryDirectory() as d:
+            with self.assertRaises(ValueError):
+                read_scanner_file(_write(d, "B-12-3;BR-1042\n"))
+
+    def test_rejects_non_integer_quantity(self):
+        with tempfile.TemporaryDirectory() as d:
+            with self.assertRaises(ValueError):
+                read_scanner_file(_write(d, "B-12-3;BR-1042;2.5\n"))
+
+    def test_rejects_negative_quantity(self):
+        with tempfile.TemporaryDirectory() as d:
+            with self.assertRaises(ValueError):
+                read_scanner_file(_write(d, "B-12-3;BR-1042;-1\n"))
