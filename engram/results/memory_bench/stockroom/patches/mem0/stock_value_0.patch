+"""Stock valuation."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each receipt forms a cost layer. Issues consume the oldest layers first, so the
+    stock left on hand is valued at the cost of the most recent receipts. Issues
+    beyond the stock received (negative stock) consume nothing and carry no value.
+    """
+    layers = deque()  # [qty, unit_cost in cents], oldest first
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{m.sku}: goods in on {m.date} have no unit cost to value them by")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
