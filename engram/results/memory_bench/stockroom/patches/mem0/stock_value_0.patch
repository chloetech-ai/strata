+++ b/tests/test_valuation.py
@@ -0,0 +1,77 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY1 = datetime.date(2026, 9, 1)
+DAY2 = datetime.date(2026, 9, 2)
+DAY3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_nothing_on_hand_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 250, DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2500)
+
+    def test_issues_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 300, DAY2)
+        inv.issue("BR-1042", 15, DAY3)
+        # The first receipt (cost 100) is used up; 5 of the second (cost 300) remain.
+        self.assertEqual(inv.on_hand("BR-1042"), 5)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_fifo_not_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 300, DAY2)
+        inv.issue("BR-1042", 10, DAY3)
+        # Average cost would give 10 * 200 = 2000; FIFO leaves the 300-cost stock.
+        self.assertEqual(stock_value(inv, "BR-1042"), 3000)
+
+    def test_receipts_dated_out_of_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 300, DAY2)
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.issue("BR-1042", 10, DAY3)
+        # The DAY1 receipt is the oldest, so it is the one sold.
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 300)
+
+    def test_negative_stock_has_no_value_beyond_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY1)
+        inv.issue("BR-1042", 8, DAY2)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_value_follows_on_hand_after_mixed_movements(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 50, DAY1)
+        inv.issue("BR-1042", 1, DAY1)
+        inv.receive("BR-1042", 6, 80, DAY2)
+        inv.issue("BR-1042", 5, DAY2)
+        self.assertEqual(inv.on_hand("BR-1042"), 4)
+        self.assertEqual(stock_value(inv, "BR-1042"), 4 * 80)
+
+    def test_other_skus_ignored_and_spelling_normalized(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 2, 100, DAY1)
+        inv.receive("BR-2210", 9, 999, DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042 "), 200)
+
+    def test_goods_in_without_cost_rejected(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 100, DAY1)
+        inv._record(Movement("BR-1042", 1, DAY2, None, "", "COUNT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
