+"""ABC analysis of annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by cumulative share of annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken from highest
+    to lowest value (ties broken by SKU). A SKU is 'A' if the cumulative share
+    up to and including it is at most 80% of the total, 'B' if at most 95%,
+    otherwise 'C'. If the total is zero, every SKU is 'C'.
+    """
+    total = sum(values.values())
+    ordered = sorted(values.items(), key=lambda kv: (-kv[1], kv[0]))
+    classes = {}
+    running = 0
+    for sku, value in ordered:
+        running += value
+        share = running / total if total else 1.0
+        if share <= 0.80:
+            classes[sku] = "A"
+        elif share <= 0.95:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
