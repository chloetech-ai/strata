+"""The printable count sheet for a stock-take."""
+
+
+def _walk_key(location):
+    """Sort bin codes "aisle-bay-shelf" in walking order: numeric parts as numbers, so 2 comes before 10."""
+    return tuple((0, int(part), "") if part.isdigit() else (1, 0, part) for part in location.split("-"))
+
+
+def count_sheet(inventory):
+    """A blind count sheet as text, one line per catalog item in bin walking order.
+
+    The sheet leaves out the quantity on hand, so the count is made by hand and not copied from the system.
+    """
+    if inventory.catalog is None:
+        raise ValueError("no catalog to build a count sheet from")
+    items = sorted(inventory.catalog, key=lambda item: (_walk_key(item.location), item.sku))
+    lines = [
+        f"{item.location:<10} {item.sku:<12} {item.name:<24} {item.unit:<5} ________"
+        for item in items
+    ]
+    return "".join(line + "\n" for line in lines)
