+"""Reading the handheld scanner's count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Total counted quantity per SKU from a scanner file.
+
+    The file has no header; each line is ``bin;sku;qty``. A SKU may appear on
+    several lines (e.g. stock in an overflow bin), so quantities are summed.
+    Returns a dict mapping normalized SKU to its counted quantity.
+    """
+    counts = {}
+    # utf-8-sig tolerates a byte-order mark, which some handheld exports add.
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        for lineno, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{lineno}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _bin, sku, qty_text = fields
+            try:
+                qty = int(qty_text.strip())
+            except ValueError:
+                raise ValueError(f"{path}:{lineno}: quantity is not a whole number: {qty_text.strip()!r}")
+            if qty < 0:
+                raise ValueError(f"{path}:{lineno}: quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{lineno}: missing SKU")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
