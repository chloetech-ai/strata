+"""Valuation of stock on hand, FIFO."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each positive movement is a cost layer at its `unit_cost`. Each negative
+    movement consumes the oldest layers first. Movements are taken in log order.
+    Quantity issued beyond the layers received (negative stock) is a deficit;
+    later receipts cover it before adding to the layers, so the value always
+    matches the quantity on hand.
+    """
+    layers = deque()  # [qty remaining, unit cost in cents], oldest first
+    deficit = 0  # units issued that no earlier receipt covered
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{m.sku}: incoming movement on {m.date} has no unit cost")
+            covered = min(deficit, m.qty)
+            deficit -= covered
+            if m.qty > covered:
+                layers.append([m.qty - covered, m.unit_cost])
+        elif m.qty < 0:
+            to_issue = -m.qty
+            while to_issue and layers:
+                take = min(to_issue, layers[0][0])
+                layers[0][0] -= take
+                to_issue -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            deficit += to_issue
+    return sum(qty * cost for qty, cost in layers)
