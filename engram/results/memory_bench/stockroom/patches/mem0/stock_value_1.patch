@@ -0,0 +1,72 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2500)
+
+    def test_fifo_issues_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 12, DAY)
+        # 10 @ 100 are gone, 2 of the 10 @ 300 are issued, 8 @ 300 remain
+        self.assertEqual(stock_value(inv, "BR-1042"), 2400)
+
+    def test_partial_layer_consumed_across_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.receive("BR-1042", 5, 200, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        # 7 issued: the first layer of 5 @ 100 is used up, then 2 @ 200 are taken; 3 @ 200 remain
+        self.assertEqual(stock_value(inv, "BR-1042"), 600)
+
+    def test_negative_stock_values_remaining_layers_only(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 100, DAY)
+        inv.issue("BR-1042", 6, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_receipt_after_negative_stock_is_costed_fresh(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 100, DAY)
+        inv.issue("BR-1042", 6, DAY)
+        inv.receive("BR-1042", 5, 400, DAY)
+        # the 2 units issued without stock are covered by the new receipt, leaving 3 @ 400
+        self.assertEqual(inv.on_hand("BR-1042"), 3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1200)
+
+    def test_only_the_given_sku_counts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 5, 999, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_spellings_refer_to_same_item(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 10, 100, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042 "), 1000)
+
+    def test_incoming_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.movements[-1].unit_cost = None
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
