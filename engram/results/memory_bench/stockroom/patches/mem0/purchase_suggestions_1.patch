+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 25})
+
+    def test_rounds_shortfall_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # shortfall is 25, which rounds up to 3 cases of 12
+        self.assertEqual(suggest_orders(inv), {"BR-1": 36})
+
+    def test_exact_case_multiple_is_not_rounded(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=5)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 25})
+
+    def test_negative_stock_increases_order(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.issue("BR-1", 4)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 34})
+
+    def test_skips_skus_that_do_not_need_reorder(self):
+        orders = suggest_orders(make_inventory())
+        self.assertNotIn("BR-3", orders)
+        self.assertEqual(set(orders), {"BR-1", "BR-2"})
+
+    def test_skips_zero_quantity_orders(self):
+        # reorder point 0 and nothing on hand: shortfall is 0, so nothing to order
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=0)])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
