 """Reorder checks."""
 
+TARGET_MULTIPLE = 3  # restock up to this many times the reorder point
+
 
 def needs_reorder(inventory):
     """SKUs whose quantity on hand is at or below their reorder point."""
@@ -8,3 +10,20 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU that needs reordering to the quantity to order.
+
+    The target is three times the reorder point. The shortfall is rounded up
+    to whole cases, because the supplier ships only full cases.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = TARGET_MULTIPLE * item.reorder_point - inventory.on_hand(sku)
+        if shortfall <= 0:
+            continue
+        cases = -(-shortfall // item.case_size)  # ceiling division
+        orders[sku] = cases * item.case_size
+    return orders
