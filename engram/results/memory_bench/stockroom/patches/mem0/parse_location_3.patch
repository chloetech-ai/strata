+            "B-x-3",
+            "B-12-",
+            "B--3",
+            "B-+12-3",
+            "B-12-3.5",
+            "B 12 3",
+            "B-12 -3",
+            "B-12-3 extra",
+        )
+        for code in bad:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
