+"""What stock on hand is worth."""
+
+import collections
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed first in, first out.
+
+    Each receipt starts a cost layer at its unit cost, and each outgoing movement
+    uses up the oldest layers first. Outgoing stock with no receipt left to cover
+    it (negative stock) carries no cost and is not valued.
+    """
+    layers = collections.deque()  # [qty, unit_cost] pairs, oldest first
+    # Stable sort: movements on the same day keep their log order.
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{m.sku}: {m.reason} of {m.qty} on {m.date} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
