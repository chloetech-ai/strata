@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+NEXT = datetime.date(2026, 9, 2)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2500)
+
+    def test_fifo_not_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 200, NEXT)
+        inv.issue("BR-1042", 15, NEXT)
+        # FIFO leaves 5 units from the second receipt: 5 * 200. Average cost would give 750.
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_issue_consumes_exactly_one_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 200, NEXT)
+        inv.issue("BR-1042", 10, NEXT)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2000)
+
+    def test_negative_stock_is_not_valued(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 8, NEXT)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_skus_ignored_and_spellings_match(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 4, 100, DAY)
+        inv.receive("BR-2210", 9, 999, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042 "), 400)
+
+    def test_receipt_without_unit_cost_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY, None, "", "RECEIPT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
