diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index f09c4c5..432f707 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -53,3 +53,8 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """Most recent RECEIPT for `sku` by date; ties go to the later-logged movement, or None."""
+        receipts = [m for m in self.movements_for(sku) if m.reason == "RECEIPT"]
+        return max(reversed(receipts), key=lambda m: m.date, default=None)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 7145561..d8806ea 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -59,6 +59,27 @@ class InventoryTest(unittest.TestCase):
         inv.issue("BR-1042", 4, DAY)
         self.assertEqual([m.qty for m in inv.movements_for("BR-1042")], [10, -4])
 
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_is_latest_receipt_for_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        later = inv.receive("br-1042 ", 5, 13, datetime.date(2026, 9, 5))
+        inv.issue("BR-1042", 4, datetime.date(2026, 9, 9))
+        inv.receive("BR-2210", 7, 30, datetime.date(2026, 9, 9))
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+        self.assertIsNone(Inventory().last_receipt("BR-9999"))
+
+    def test_last_receipt_ties_go_to_later_logged(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 5, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
 
 if __name__ == "__main__":
     unittest.main()
