diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index f09c4c5..b090af3 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -53,3 +53,8 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """Most recent RECEIPT for `sku` by date, or None. Ties go to the later-logged movement."""
+        receipts = [(m.date, i, m) for i, m in enumerate(self.movements) if m.sku == normalize_sku(sku) and m.reason == "RECEIPT"]
+        return max(receipts, key=lambda r: r[:2])[2] if receipts else None
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 7145561..2b96be7 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -59,6 +59,25 @@ class InventoryTest(unittest.TestCase):
         inv.issue("BR-1042", 4, DAY)
         self.assertEqual([m.qty for m in inv.movements_for("BR-1042")], [10, -4])
 
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_is_latest_by_date(self):
+        inv = Inventory()
+        newer = inv.receive(" br-1042", 10, 12, datetime.date(2026, 9, 5))
+        inv.receive("BR-1042", 20, 12, datetime.date(2026, 9, 1))
+        inv.issue("BR-1042", 4, datetime.date(2026, 9, 9))
+        self.assertIs(inv.last_receipt("bR-1042 "), newer)
+
+    def test_last_receipt_tie_goes_to_later_logged(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        later = inv.receive("BR-1042", 20, 12, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
 
 if __name__ == "__main__":
     unittest.main()
