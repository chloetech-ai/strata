@@ -0,0 +1,37 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def make_inventory(self):
+        catalog = Catalog([
+            Item("BR-2", "Nut", "B-02-1"),
+            Item("BR-1", "Bolt", "A-01-1", unit="box"),
+            Item("BR-3", "Washer", "A-01-1"),
+        ])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        inv.receive("BR-2", 7, 10)
+        return inv
+
+    def test_one_line_per_item(self):
+        self.assertEqual(len(count_sheet(self.make_inventory()).splitlines()), 3)
+
+    def test_sorted_by_bin_location_not_sku(self):
+        lines = count_sheet(self.make_inventory()).splitlines()
+        self.assertEqual([line.split()[1] for line in lines], ["BR-1", "BR-3", "BR-2"])
+
+    def test_blind_count_omits_quantity_on_hand(self):
+        sheet = count_sheet(self.make_inventory())
+        self.assertNotIn("5", sheet)
+        self.assertNotIn("7", sheet)
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
