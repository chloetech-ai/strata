+"""The printable count sheet for a stock-take.
+
+The sheet is a blind count: it shows where to count and what the item is, but
+not the quantity on hand, so staff must count the stock rather than copy a number.
+Lines follow bin location (walking order), not SKU.
+"""
+
+COUNT_BOX = "_" * 8
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin-location order, with a blank column for the counted quantity."""
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    lines = [
+        f"{item.location:<8} {item.sku:<12} {COUNT_BOX:<8} {item.unit:<6} {item.name}"
+        for item in items
+    ]
+    return "".join(f"{line}\n" for line in lines)
