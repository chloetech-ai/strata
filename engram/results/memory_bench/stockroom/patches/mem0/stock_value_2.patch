@@ -0,0 +1,27 @@
+"""Value of stock on hand, costed first-in, first-out."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each receipt opens a layer at its unit cost. Every outgoing movement uses up
+    the oldest layers first, and whatever layers remain make up the value on hand.
+    Outgoing stock with no layer left to draw from (negative stock) carries no value.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{m.sku}: incoming movement on {m.date} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..e759e3b
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,67 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2500)
+
+    def test_sales_consume_oldest_layer_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 15, DAY + datetime.timedelta(days=2))
+        # the 100-cent layer is used up first, then 5 units come from the 300-cent layer
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_issue_spanning_exactly_one_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 100, DAY)
+        inv.receive("BR-1042", 4, 200, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 4 * 200)
+
+    def test_all_stock_gone_is_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 100, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_negative_stock_carries_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_skus_ignored_and_sku_normalized(self):
+        inv = Inventory()
+        inv.receive("br-1042", 2, 100, DAY)
+        inv.receive("BR-9999", 7, 999, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 200)
+
+    def test_return_adds_a_layer_at_its_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        inv._record(Movement("BR-1042", 2, DAY, 150, "", "RETURN"))
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 150)
+
+    def test_incoming_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 2, DAY, None, "", "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
