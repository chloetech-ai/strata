@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,22 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_fills_to_three_times_reorder_point(self):
+        # BR-1 has 5 of a 10 reorder point: 30 - 5 = 25, one case of 1 each
+        self.assertEqual(suggest_orders(make_inventory()), {"BR-1": 25, "BR-2": 20})
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-01-4", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 4, 10)
+        # shortfall 30 - 4 = 26, rounded up to 3 cases of 12
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_suggest_orders_skips_skus_without_shortfall(self):
+        # reorder point 0 and on hand 0: at the reorder point, but nothing to order
+        catalog = Catalog([Item("BR-5", "Pin", "A-01-5", reorder_point=0)])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
+
 
 if __name__ == "__main__":
     unittest.main()
