diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..3b98c70 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,20 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU to reorder to the quantity to order.
+
+    An order brings stock back up to three times the reorder point, rounded
+    up to whole cases because the supplier ships only full cases.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        if shortfall <= 0:
+            continue
+        cases = -(-shortfall // item.case_size)  # ceiling division
+        orders[sku] = cases * item.case_size
+    return orders
diff --git a/tests/test_reorder.py b/tests/test_reorder.py
index 62219cf..a574fa7 100644
