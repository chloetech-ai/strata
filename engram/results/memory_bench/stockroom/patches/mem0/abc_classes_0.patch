+++ b/tests/test_analysis.py
@@ -0,0 +1,29 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A=50 (50%), B=30 (80%), C=15 (95%), D=5 (100%)
+        values = {"D": 5, "A": 50, "C": 15, "B": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_exact_boundaries_are_inclusive(self):
+        # Sorted: X=80 (80% exactly -> A), Y=15 (95% exactly -> B), Z=5 -> C
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_last_sku_reaching_total_is_c(self):
+        # Cumulative share is 100%, which is above both 80% and 95%
+        self.assertEqual(abc_classes({"ONLY": 12}), {"ONLY": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
