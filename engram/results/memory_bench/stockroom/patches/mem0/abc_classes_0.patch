@@ -0,0 +1,26 @@
+"""ABC analysis of annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to 'A', 'B' or 'C' by its cumulative share of total value.
+
+    SKUs are taken highest value first. A SKU is 'A' if the running total up
+    to and including it is at most 80% of the grand total, 'B' if at most 95%,
+    otherwise 'C'. Comparisons are done with integers to avoid float rounding
+    at the boundaries.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: pair[1], reverse=True)
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if 5 * running <= 4 * total:
+            out[sku] = "A"
+        elif 20 * running <= 19 * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
