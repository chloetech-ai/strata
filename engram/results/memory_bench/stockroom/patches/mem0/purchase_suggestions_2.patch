+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,20 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_fills_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 25, "BR-2": 20})
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("CS-1", "Case item", "B-01-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("CS-1", 7, 10)
+        self.assertEqual(suggest_orders(inv), {"CS-1": 24})  # need 23, round up to 24
+
+    def test_suggest_orders_skips_zero_reorder_point_with_no_stock(self):
+        catalog = Catalog([Item("Z-1", "Zero", "B-01-2", reorder_point=0)])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
+
 
 if __name__ == "__main__":
     unittest.main()
