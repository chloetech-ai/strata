+"""The stock-take count sheet: a blind count in bin walking order."""
+
+BLANK = "[________]"
+
+
+def _bin_key(location):
+    """Sort key for a bin code "aisle-bay-shelf": numeric parts compare as numbers, so B-2-1 comes before B-10-1."""
+    return tuple((0, int(part), "") if part.isdigit() else (1, 0, part.upper()) for part in location.split("-"))
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin walking order, for staff to write their count in.
+
+    The sheet deliberately omits the quantity on hand: the count must be a real count, not a copy of the system figure.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to build a count sheet from")
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    lines = [
+        f"{item.location:<8} {item.sku:<12} {item.name:<30} {item.unit:<5} {BLANK}"
+        for item in items
+    ]
+    return "".join(line + "\n" for line in lines)
