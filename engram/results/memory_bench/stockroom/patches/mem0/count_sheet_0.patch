@@ -0,0 +1,38 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-10", "Bolt", "B-10-1"),
+        Item("BR-2", "Nut", "B-2-1"),
+        Item("BR-1", "Washer", "A-01-1"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-2", 37, 10)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_catalog_item(self):
+        self.assertEqual(len(count_sheet(make_inventory()).splitlines()), 3)
+
+    def test_lines_follow_bin_walking_order(self):
+        skus = [line.split()[1] for line in count_sheet(make_inventory()).splitlines()]
+        self.assertEqual(skus, ["BR-1", "BR-2", "BR-10"])
+
+    def test_omits_quantity_on_hand(self):
+        sheet = count_sheet(make_inventory())
+        self.assertNotIn("37", sheet)
+        self.assertEqual(sheet.count("[________]"), 3)
+
+    def test_requires_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
