@@ -0,0 +1,27 @@
+"""Printable blind count sheet for the stock-take."""
+
+
+def _bin_key(location):
+    """Sort key for an "aisle-bay-shelf" code so that B-2-1 comes before B-10-1."""
+    key = []
+    for part in location.split("-"):
+        if part.isdigit():
+            key.append((0, int(part), ""))
+        else:
+            key.append((1, 0, part))
+    return key
+
+
+def count_sheet(inventory):
+    """Return the count sheet as text, one line per catalog item in bin walking order.
+
+    This is a blind count: on-hand quantities are never printed. The last column
+    is left empty for the counter to write the counted figure in.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog")
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<10} {item.sku:<12} {item.name:<30} {item.unit:<5} {'':<8}")
+    return "\n".join(lines)
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..8f58267
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,47 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_lines_follow_bin_walking_order_not_sku(self):
+        catalog = Catalog([
+            Item("BR-1", "Bolt", "B-10-1"),
+            Item("BR-2", "Nut", "B-2-1"),
+            Item("BR-3", "Washer", "A-09-4"),
+        ])
+        lines = count_sheet(Inventory(catalog)).split("\n")
+        self.assertEqual([line.split()[1] for line in lines], ["BR-3", "BR-2", "BR-1"])
+
+    def test_same_bin_is_ordered_by_sku(self):
+        catalog = Catalog([Item("BR-2", "Nut", "A-01-1"), Item("BR-1", "Bolt", "A-01-1")])
+        lines = count_sheet(Inventory(catalog)).split("\n")
+        self.assertEqual([line.split()[1] for line in lines], ["BR-1", "BR-2"])
+
+    def test_one_line_per_catalog_item(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1"), Item("BR-2", "Nut", "A-01-2")])
+        self.assertEqual(len(count_sheet(Inventory(catalog)).split("\n")), 2)
+
+    def test_never_shows_on_hand_quantity(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt M8x40", "C-03-2", reorder_point=5)])
+        inv = Inventory(catalog)
+        inv.receive("br-1042", 37, 250)
+        self.assertNotIn("37", count_sheet(inv))
+
+    def test_counted_column_is_blank(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt M8x40", "C-03-2", unit="pcs")])
+        line = count_sheet(Inventory(catalog))
+        self.assertEqual(line.rstrip(), "C-03-2     BR-1042      Hex bolt M8x40                 pcs")
+
+    def test_requires_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
