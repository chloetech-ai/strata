+    def test_write_off_records_damage(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        movement = inv.write_off(" br-1042", 3, DAY, "dropped case")
+        self.assertEqual(movement.reason, "DAMAGE")
+        self.assertEqual(movement.qty, -3)
+        self.assertEqual(movement.sku, "BR-1042")
+        self.assertEqual(movement.note, "dropped case")
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_allows_negative_stock(self):
+        inv = Inventory()
+        inv.write_off("BR-1042", 2, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+
