@@ -0,0 +1,31 @@
+"""Valuing stock on hand."""
+
+import collections
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed first-in, first-out.
+
+    Receipts open cost layers at their unit cost; issues consume the oldest layers
+    first, in date order (log order within a day). Negative on-hand stock has no
+    layers left to consume, so the shortfall adds nothing to the value.
+    """
+    sku = normalize_sku(sku)
+    movements = sorted(inventory.movements_for(sku), key=lambda m: m.date)
+    layers = collections.deque()  # [qty, unit_cost] pairs, oldest first
+    for m in movements:
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"receipt of {sku} on {m.date} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..4bf3b6b
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,68 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_issues_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 10, DAY)
+        inv.receive("BR-1042", 10, 20, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 5, DAY + datetime.timedelta(days=2))
+        # 5 left from the first layer at 10, all 10 from the second at 20
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 10 + 10 * 20)
+
+    def test_fifo_uses_date_order_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 30, DAY + datetime.timedelta(days=5))
+        inv.receive("BR-1042", 5, 10, DAY)  # backdated, logged later
+        inv.issue("BR-1042", 5, DAY + datetime.timedelta(days=6))
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 30)
+
+    def test_issue_spanning_layers(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 5, DAY)
+        inv.receive("BR-1042", 4, 7, DAY)
+        inv.issue("BR-1042", 6, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 7)
+
+    def test_negative_stock_adds_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 8, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_sku_variants_are_normalized(self):
+        inv = Inventory()
+        inv.receive(" br-1042 ", 3, 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 12)
+
+    def test_other_skus_are_excluded(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 4, DAY)
+        inv.receive("BR-9999", 100, 50, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12)
+
+    def test_receipt_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, None, DAY)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
