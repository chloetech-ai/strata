+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_aisle_is_uppercased_and_whitespace_ignored(self):
+        self.assertEqual(parse_location(" b-12-3\n"), ("B", 12, 3))
+
+    def test_rejects_malformed_codes(self):
+        for bad in ("", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                    "B-12-", "B-+12-3", "B-1 2-3", "B_12_3", "B-12.5-3"):
+            with self.assertRaises(ValueError, msg=bad):
+                parse_location(bad)
+
