index 0000000..2690c03
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,36 @@
+"""Import the counted quantities from a handheld scanner's text export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is semicolon-separated with no header line and columns
+    bin;sku;qty. A SKU may appear on several lines (e.g. part of it in an
+    overflow bin); their quantities are summed. The bin is not checked here.
+
+    Raises ValueError, naming the line, on any malformed line; nothing is
+    returned for a partly valid file.
+    """
+    counts = {}
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.strip()
+            if not line:
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected 3 fields, got {len(fields)}")
+            _bin, raw_sku, raw_qty = (field.strip() for field in fields)
+            sku = normalize_sku(raw_sku)
+            if not sku:
+                raise ValueError(f"line {number}: blank SKU")
+            try:
+                qty = int(raw_qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity {raw_qty!r} is not a whole number") from None
+            if qty < 0:
+                raise ValueError(f"line {number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..58554ca
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,66 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def write(self, text):
+        path = os.path.join(self.dir.name, "scan.txt")
+        with open(path, "w", encoding="utf-8") as f:
+            f.write(text)
+        return path
+
+    def test_counts_per_sku(self):
+        path = self.write("B-12-3;BR-1042;14\nC-03-2;HX-0008;6\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 14, "HX-0008": 6})
+
+    def test_sums_sku_split_across_bins(self):
+        path = self.write("B-12-3;BR-1042;14\nOVF-1-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 19})
+
+    def test_normalizes_sku_variants(self):
+        path = self.write("B-12-3;br-1042;2\nOVF-1-1; BR-1042 ;3\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 5})
+
+    def test_skips_blank_lines_and_accepts_bom(self):
+        path = self.write("﻿B-12-3;BR-1042;4\n\n   \nC-03-2;HX-0008;1\n\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 4, "HX-0008": 1})
+
+    def test_zero_count_is_kept(self):
+        path = self.write("B-12-3;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 0})
+
+    def test_rejects_wrong_field_count_with_line_number(self):
+        path = self.write("B-12-3;BR-1042;4\nB-12-3;BR-1042\n")
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            read_scanner_file(path)
+
+    def test_rejects_non_integer_quantity(self):
+        path = self.write("B-12-3;BR-1042;4.5\n")
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            read_scanner_file(path)
+
+    def test_rejects_negative_quantity(self):
+        path = self.write("B-12-3;BR-1042;-2\n")
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            read_scanner_file(path)
+
+    def test_rejects_blank_sku(self):
+        path = self.write("B-12-3;   ;4\n")
+        with self.assertRaisesRegex(ValueError, "blank SKU"):
+            read_scanner_file(path)
+
+    def test_bad_line_rejects_whole_file(self):
+        path = self.write("B-12-3;BR-1042;4\nB-12-3;HX-0008;x\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
