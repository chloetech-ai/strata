diff --git a/src/stockroom/scanner.py b/src/stockroom/scanner.py
new file mode 100644
index 0000000..a0f29e0
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,37 @@
+"""Reading the handheld scanners' plain-text count export."""
+
+from .items import normalize_sku
+
+# Each line is bin;sku;qty with no header. The bin is only checked for presence:
+# a SKU can be counted in an overflow bin that differs from Item.location.
+
+
+def read_scanner_file(path):
+    """Return {sku: counted quantity}, summing a SKU that appears on several lines.
+
+    Raises ValueError, naming the line number, on the first malformed line;
+    the whole file is rejected rather than partially loaded.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.rstrip("\r\n")
+            if not line.strip():
+                continue
+            parts = line.split(";")
+            if len(parts) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line!r}")
+            bin_code, sku, qty_text = parts
+            if not bin_code.strip():
+                raise ValueError(f"line {number}: missing bin")
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"line {number}: missing SKU")
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity is not a whole number: {qty_text!r}") from None
+            if qty < 0:
+                raise ValueError(f"line {number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..27f11ab
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,57 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def _read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_counts_per_sku(self):
+        counts = self._read("B-12-3;BR-1042;12\nB-12-4;BR-2001;5\n")
+        self.assertEqual(counts, {"BR-1042": 12, "BR-2001": 5})
+
+    def test_sums_sku_across_overflow_bin(self):
+        counts = self._read("B-12-3;BR-1042;12\nZ-01-1;BR-1042;4\n")
+        self.assertEqual(counts, {"BR-1042": 16})
+
+    def test_normalizes_sku_case_and_padding(self):
+        counts = self._read("B-12-3;br-1042;3\nB-12-3; BR-1042 ;2\n")
+        self.assertEqual(counts, {"BR-1042": 5})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self._read("B-12-3;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_blank_lines_and_crlf_are_ignored(self):
+        counts = self._read("B-12-3;BR-1042;1\r\n\r\nB-12-3;BR-2001;2\r\n")
+        self.assertEqual(counts, {"BR-1042": 1, "BR-2001": 2})
+
+    def test_wrong_column_count_rejects_file(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self._read("B-12-3;BR-1042;1\nB-12-3;BR-2001\n")
+
+    def test_non_integer_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1.*whole number"):
+            self._read("B-12-3;BR-1042;12.5\n")
+
+    def test_negative_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1.*negative"):
+            self._read("B-12-3;BR-1042;-3\n")
+
+    def test_missing_sku_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1.*missing SKU"):
+            self._read("B-12-3;   ;3\n")
+
+    def test_missing_bin_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1.*missing bin"):
+            self._read(";BR-1042;3\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
