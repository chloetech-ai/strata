+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,14 @@
+"""Blind count sheet for the stock-take."""
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in walking order (bin location), with no on-hand quantity.
+
+    The last column is left empty for staff to write the counted figure, so the sheet
+    never shows what the system thinks is on hand.
+    """
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<10} {item.sku:<12} {item.name:<20} {item.unit:<6} [        ]")
+    return "\n".join(lines) + "\n" if lines else ""
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
