--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,40 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-2", "Nut", "B-02-1"),
+        Item("BR-1", "Bolt", "A-10-3"),
+        Item("BR-3", "Washer", "A-01-1"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1", 4321, 10)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+
+    def test_walking_order_by_location(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertTrue(lines[0].startswith("A-01-1"))
+        self.assertTrue(lines[1].startswith("A-10-3"))
+        self.assertTrue(lines[2].startswith("B-02-1"))
+
+    def test_blind_count_hides_on_hand(self):
+        sheet = count_sheet(make_inventory())
+        self.assertNotIn("4321", sheet)
+        self.assertIn("[        ]", sheet)
+
+    def test_empty_catalog(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
