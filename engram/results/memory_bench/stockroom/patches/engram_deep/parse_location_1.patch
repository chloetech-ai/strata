diff --git a/src/stockroom/items.py b/src/stockroom/items.py
index 7b09ded..ac89ffc 100644
--- a/src/stockroom/items.py
+++ b/src/stockroom/items.py
@@ -1,13 +1,29 @@
 """The item catalog."""
 
+import re
 from dataclasses import dataclass
 
+_LOCATION_RE = re.compile(r"\s*([A-Za-z])-([0-9]+)-([0-9]+)\s*")
+
 
 def normalize_sku(sku):
     """Canonical SKU form: surrounding whitespace trimmed, uppercased."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like 'B-12-3' into ('B', 12, 3).
+
+    The aisle is a single letter, returned uppercase; bay and shelf are
+    integers. Surrounding whitespace is ignored. Anything else raises ValueError.
+    """
+    match = _LOCATION_RE.fullmatch(code)
+    if match is None:
+        raise ValueError(f"invalid bin code {code!r}, expected 'aisle-bay-shelf' like 'B-12-3'")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
