diff --git a/src/stockroom/scanner.py b/src/stockroom/scanner.py
new file mode 100644
index 0000000..74ce2be
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,34 @@
+"""Importing the handheld scanners' counted quantities."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is plain text, semicolon-separated, with no header line and the
+    columns bin;sku;qty. A SKU may appear on several lines (e.g. part of it in
+    an overflow bin), so its quantities are summed. The bin is not checked
+    against the catalog here. A malformed line rejects the whole file.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.rstrip("\r\n")
+            if not line.strip():
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line!r}")
+            _bin, sku, raw_qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: empty SKU")
+            try:
+                qty = int(raw_qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {raw_qty!r}")
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..fd40a0d
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,66 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+
+    def write(self, text):
+        path = os.path.join(self.dir.name, "scan.txt")
+        with open(path, "w", encoding="utf-8", newline="") as f:
+            f.write(text)
+        return path
+
+    def test_reads_counts_per_sku(self):
+        path = self.write("B-12-3;BR-1042;24\nC-03-2;NL-0007;100\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 24, "NL-0007": 100})
+
+    def test_sums_sku_split_across_bins(self):
+        path = self.write("B-12-3;BR-1042;24\nOVF-1;BR-1042;6\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 30})
+
+    def test_normalizes_sku(self):
+        path = self.write("B-12-3;br-1042;5\nOVF-1; BR-1042 ;2\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 7})
+
+    def test_accepts_crlf_and_skips_blank_lines(self):
+        path = self.write("B-12-3;BR-1042;3\r\n\r\nC-03-2;NL-0007;4\r\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 3, "NL-0007": 4})
+
+    def test_zero_count_is_kept(self):
+        path = self.write("B-12-3;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 0})
+
+    def test_rejects_wrong_field_count_with_line_number(self):
+        path = self.write("B-12-3;BR-1042;3\nB-12-3;BR-1042\n")
+        with self.assertRaisesRegex(ValueError, ":2:"):
+            read_scanner_file(path)
+
+    def test_rejects_non_integer_quantity(self):
+        path = self.write("B-12-3;BR-1042;1.5\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+    def test_rejects_negative_quantity(self):
+        path = self.write("B-12-3;BR-1042;-2\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+    def test_rejects_empty_sku(self):
+        path = self.write("B-12-3;  ;2\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+    def test_bad_line_rejects_whole_file(self):
+        path = self.write("B-12-3;BR-1042;3\nB-12-3;NL-0007;x\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
