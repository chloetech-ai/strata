@@ -0,0 +1,29 @@
+"""ABC analysis of stock by annual consumption value."""
+
+
+A_LIMIT = 0.80
+B_LIMIT = 0.95
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by cumulative share of annual value.
+
+    ``values`` maps SKU to annual consumption value. SKUs are sorted highest
+    value first; a SKU is 'A' if the running total up to and including it is
+    at most 80% of the grand total, 'B' if at most 95%, otherwise 'C'.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= A_LIMIT * total:
+            out[sku] = "A"
+        elif running <= B_LIMIT * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..f9c1612
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,39 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: 50, 30, 15, 5 of 100 -> cumulative 50%, 80%, 95%, 100%.
+        values = {"BR-1": 15, "BR-2": 50, "BR-3": 5, "BR-4": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-2": "A", "BR-4": "A", "BR-1": "B", "BR-3": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative exactly 80% stays A; exactly 95% stays B.
+        values = {"A": 80, "B": 15, "C": 5}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "B", "C": "C"})
+
+    def test_item_crossing_80_percent_is_b(self):
+        values = {"A": 60, "B": 30, "C": 10}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "B", "C": "C"})
+
+    def test_single_sku_cumulative_share_is_100_percent_so_c(self):
+        self.assertEqual(abc_classes({"BR-1": 12}), {"BR-1": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        values = {"BR-2": 10, "BR-1": 10}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "C"})
+
+    def test_all_zero_values_are_a(self):
+        self.assertEqual(abc_classes({"BR-1": 0, "BR-2": 0}), {"BR-1": "A", "BR-2": "A"})
+
+
+if __name__ == "__main__":
+    unittest.main()
