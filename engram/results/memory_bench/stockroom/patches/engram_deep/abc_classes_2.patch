+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs into ABC classes by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted highest
+    value first and a running total is kept. A SKU is 'A' if the cumulative
+    share up to and including it is at most 80% of the grand total, 'B' if
+    at most 95%, otherwise 'C'. If the grand total is zero, shares are
+    undefined and every SKU is 'C'.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if total == 0:
+            classes[sku] = "C"
+        elif running <= 0.8 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..e1c78c7
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,35 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 50 (50%), B 30 (80%), C 15 (95%), D 5 (100%)
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_crossing_item_is_included_in_its_class(self):
+        # The 80% threshold is crossed by the second item, which is still A.
+        values = {"X": 60, "Y": 20, "Z": 20}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "A", "Z": "C"})
+
+    def test_input_order_does_not_matter(self):
+        values = {"D": 5, "C": 15, "B": 30, "A": 50}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_zero_total_is_all_c(self):
+        self.assertEqual(abc_classes({"A": 0, "B": 0}), {"A": "C", "B": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
