+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_picks_latest_date_not_latest_position(self):
+        inv = Inventory()
+        later = datetime.date(2026, 9, 5)
+        inv.receive("BR-1042", 10, 12, later)
+        inv.receive("BR-1042", 20, 12, DAY)
+        inv.issue("BR-1042", 4, later)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_last_receipt_tie_goes_to_later_logged(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 20, 12, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
+    def test_last_receipt_normalizes_sku(self):
+        inv = Inventory()
+        first = inv.receive("br-1042", 10, 12, DAY)
+        self.assertIs(inv.last_receipt(" BR-1042 "), first)
