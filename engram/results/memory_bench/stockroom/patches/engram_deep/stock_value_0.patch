@@ -0,0 +1,29 @@
+"""Value of stock on hand, costed first-in, first-out."""
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Each receipt is a cost layer; goods out consume the oldest layers first.
+    Stock issued beyond what was received (negative on hand) consumes no
+    layer and adds no value.
+    """
+    sku = normalize_sku(sku)
+    layers = []  # [qty, unit_cost] pairs, oldest first
+    # Stable sort: movements on the same date keep their log order.
+    for movement in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if movement.qty > 0:
+            if movement.unit_cost is None:
+                raise ValueError(f"{sku}: goods in on {movement.date} have no unit cost")
+            layers.append([movement.qty, movement.unit_cost])
+            continue
+        remaining = -movement.qty
+        while remaining and layers:
+            taken = min(remaining, layers[0][0])
+            layers[0][0] -= taken
+            remaining -= taken
+            if layers[0][0] == 0:
+                del layers[0]
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..2921cff
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,69 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_values_receipts_at_their_unit_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 125, DAY)
+        inv.receive("BR-1042", 5, 200, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 125 + 5 * 200)
+
+    def test_sales_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, datetime.date(2026, 9, 1))
+        inv.receive("BR-1042", 10, 300, datetime.date(2026, 9, 2))
+        inv.issue("BR-1042", 15, datetime.date(2026, 9, 3))
+        # 10 @ 100 are gone, 5 @ 300 remain.
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_sale_partly_through_a_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100 + 10 * 300)
+
+    def test_fifo_follows_date_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 300, datetime.date(2026, 9, 2))
+        inv.receive("BR-1042", 10, 100, datetime.date(2026, 9, 1))
+        inv.issue("BR-1042", 10, datetime.date(2026, 9, 3))
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 300)
+
+    def test_negative_stock_adds_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive(" br-1042 ", 2, 50, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 100)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 100)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 50, DAY)
+        inv.receive("BR-2000", 9, 999, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 100)
+
+    def test_goods_in_without_unit_cost_is_an_error(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, None, DAY)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
