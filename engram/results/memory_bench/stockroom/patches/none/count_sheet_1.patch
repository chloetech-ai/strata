+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def make_inventory(self):
+        catalog = Catalog([
+            Item("br-2", "Nut", "A-01-2", unit="pcs"),
+            Item("BR-1", "Bolt", "A-01-1", unit="pcs"),
+            Item("PN-9", "Paint", "C-03-1", unit="tin"),
+        ])
+        return Inventory(catalog)
+
+    def test_one_line_per_item_in_sku_order(self):
+        lines = count_sheet(self.make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+        self.assertTrue(lines[0].startswith("BR-1"))
+        self.assertTrue(lines[1].startswith("BR-2"))
+        self.assertTrue(lines[2].startswith("PN-9"))
+
+    def test_line_has_location_name_unit_and_blank(self):
+        line = count_sheet(self.make_inventory()).splitlines()[2]
+        self.assertIn("C-03-1", line)
+        self.assertIn("Paint", line)
+        self.assertIn("tin", line)
+        self.assertTrue(line.endswith("________"))
+
+    def test_expected_quantity_is_not_printed(self):
+        inv = self.make_inventory()
+        inv.receive("BR-1", 37, 10)
+        self.assertNotIn("37", count_sheet(inv))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
