+"""The count sheet for a stock-take: one line per catalog item, in SKU order."""
+
+
+def count_sheet(inventory):
+    """Text for a blind count: SKU, bin location, name, unit, and a blank to write the count in.
+
+    The expected quantity is left off on purpose so the counter isn't tempted to copy it.
+    """
+    lines = []
+    for item in inventory.catalog:
+        lines.append(
+            f"{item.sku:<10}{item.location:<10}{item.name:<24}{item.unit:<6}________"
+        )
+    return "".join(line + "\n" for line in lines)
