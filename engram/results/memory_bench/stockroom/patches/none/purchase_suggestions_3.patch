+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_enough_to_get_above_reorder_point(self):
+        # on hand 5, reorder point 10: 6 takes it to 11
+        self.assertEqual(suggest_orders(make_inventory())["BR-1"], 6)
+
+    def test_at_reorder_point_orders_one_case(self):
+        # on hand 10, reorder point 10: one more unit takes it to 11
+        self.assertEqual(suggest_orders(make_inventory())["BR-2"], 1)
+
+    def test_skips_skus_with_enough_stock(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_orders_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # short by 5: one case of 12 is enough
+        self.assertEqual(suggest_orders(inv), {"BR-1": 12})
+
+    def test_orders_several_cases_when_shortfall_exceeds_one(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=30, case_size=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # short by 25: three cases of 10 bring it to 35
+        self.assertEqual(suggest_orders(inv), {"BR-1": 30})
+
+    def test_negative_stock_is_reordered(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=0)])
+        inv = Inventory(catalog)
+        inv.issue("BR-1", 3)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 4})
+
+
 if __name__ == "__main__":
     unittest.main()
