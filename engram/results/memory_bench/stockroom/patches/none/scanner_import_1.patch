+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+def _write(d, text):
+    path = os.path.join(d, "count.csv")
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+class ScannerTest(unittest.TestCase):
+    def test_counts_per_sku(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "sku,qty\nBR-1042,12\nHX-7,3\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 12, "HX-7": 3})
+
+    def test_normalizes_sku_and_sums_repeats(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "sku,qty\n br-1042 ,5\nBR-1042,7\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 12})
+
+    def test_zero_count_is_kept(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "sku,qty\nBR-1042,0\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 0})
+
+    def test_rejects_negative_qty(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "sku,qty\nBR-1042,-1\n")
+            with self.assertRaisesRegex(ValueError, ":2:"):
+                read_scanner_file(path)
+
+    def test_rejects_non_integer_qty(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "sku,qty\nBR-1042,2.5\n")
+            with self.assertRaisesRegex(ValueError, "whole number"):
+                read_scanner_file(path)
+
+    def test_rejects_blank_sku(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "sku,qty\n  ,4\n")
+            with self.assertRaisesRegex(ValueError, "missing SKU"):
+                read_scanner_file(path)
+
+    def test_rejects_missing_columns(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "sku,count\nBR-1042,4\n")
+            with self.assertRaisesRegex(ValueError, "header"):
+                read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
