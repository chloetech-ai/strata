+"""Reading counts from handheld scanner files."""
+
+import csv
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a handheld scanner export.
+
+    The file is CSV with a header row containing `sku` and `qty` columns.
+    A SKU that appears on several lines (one per count pass) is summed.
+    Returns a dict mapping normalized SKU to a non-negative int.
+    """
+    counts = {}
+    with open(path, newline="", encoding="utf-8") as f:
+        reader = csv.DictReader(f)
+        if not {"sku", "qty"} <= set(reader.fieldnames or []):
+            raise ValueError(f"{path}: header must include 'sku' and 'qty'")
+        for line in reader:
+            sku = normalize_sku(line["sku"] or "")
+            if not sku:
+                raise ValueError(f"{path}:{reader.line_num}: missing SKU")
+            try:
+                qty = int(line["qty"])
+            except (TypeError, ValueError):
+                raise ValueError(f"{path}:{reader.line_num}: qty must be a whole number, got {line['qty']!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{reader.line_num}: qty must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
