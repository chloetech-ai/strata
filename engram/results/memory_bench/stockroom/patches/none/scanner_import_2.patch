@@ -0,0 +1,44 @@
+"""Reading the counts exported from handheld scanners.
+
+A scanner file has one line per scan: a bare SKU counts as one unit, or
+"SKU,QTY" (or "SKU<TAB>QTY") gives the quantity for that line. A header
+row starting with "sku" is skipped. Repeated SKUs are summed.
+"""
+
+from .items import normalize_sku
+
+HEADER_WORDS = ("sku", "item", "barcode")
+
+
+def read_scanner_file(path):
+    """Counted quantity per normalized SKU, e.g. {"BR-1042": 12}."""
+    counts = {}
+    with open(path, encoding="utf-8-sig") as f:
+        for lineno, line in enumerate(f, start=1):
+            line = line.strip()
+            if not line:
+                continue
+            fields = [field.strip() for field in line.replace("\t", ",").split(",")]
+            if lineno == 1 and fields[0].lower() in HEADER_WORDS:
+                continue
+            try:
+                sku, qty = _parse_scan(fields)
+            except ValueError as exc:
+                raise ValueError(f"{path}:{lineno}: {exc}") from None
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
+
+
+def _parse_scan(fields):
+    if len(fields) > 2 or not fields[0]:
+        raise ValueError(f"expected SKU or SKU,QTY, got {','.join(fields)!r}")
+    sku = normalize_sku(fields[0])
+    if len(fields) == 1:
+        return sku, 1
+    try:
+        qty = int(fields[1])
+    except ValueError:
+        raise ValueError(f"quantity must be a whole number, got {fields[1]!r}") from None
+    if qty < 0:
+        raise ValueError(f"quantity must not be negative, got {qty}")
+    return sku, qty
