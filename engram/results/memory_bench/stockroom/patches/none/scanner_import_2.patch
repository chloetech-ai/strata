@@ -0,0 +1,65 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+def scan_file(text):
+    d = tempfile.TemporaryDirectory()
+    path = os.path.join(d.name, "scan.txt")
+    with open(path, "w", encoding="utf-8", newline="") as f:
+        f.write(text)
+    return d, path
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        d, path = scan_file(text)
+        with d:
+            return read_scanner_file(path)
+
+    def test_bare_sku_counts_one_per_line(self):
+        self.assertEqual(self.read("BR-1042\nBR-1042\nBR-9999\n"), {"BR-1042": 2, "BR-9999": 1})
+
+    def test_sku_with_quantity_comma_or_tab(self):
+        self.assertEqual(self.read("BR-1042,12\nBR-9999\t3\n"), {"BR-1042": 12, "BR-9999": 3})
+
+    def test_repeated_skus_are_summed(self):
+        self.assertEqual(self.read("BR-1042,5\nBR-1042,7\nBR-1042\n"), {"BR-1042": 13})
+
+    def test_normalizes_sku(self):
+        self.assertEqual(self.read(" br-1042 ,4\nBR-1042,1\n"), {"BR-1042": 5})
+
+    def test_skips_header_blank_lines_and_bom(self):
+        self.assertEqual(self.read("﻿sku,qty\n\nBR-1042,2\n\n"), {"BR-1042": 2})
+
+    def test_zero_quantity_is_kept(self):
+        self.assertEqual(self.read("BR-1042,0\n"), {"BR-1042": 0})
+
+    def test_empty_file(self):
+        self.assertEqual(self.read(""), {})
+
+    def test_rejects_negative_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":2: .*negative"):
+            self.read("BR-1042,3\nBR-1042,-1\n")
+
+    def test_rejects_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":1: .*whole number"):
+            self.read("BR-1042,1.5\n")
+
+    def test_rejects_too_many_fields(self):
+        with self.assertRaisesRegex(ValueError, ":1: "):
+            self.read("BR-1042,1,extra\n")
+
+    def test_rejects_empty_sku(self):
+        with self.assertRaisesRegex(ValueError, ":2: "):
+            self.read("BR-1042\n,3\n")
+
+    def test_header_only_on_first_line(self):
+        with self.assertRaises(ValueError):
+            self.read("BR-1042\nsku,qty\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
