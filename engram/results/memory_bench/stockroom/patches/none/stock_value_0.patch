@@ -0,0 +1,53 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_issues_take_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 15, DAY)
+        inv.issue("BR-1042", 14, DAY)  # 10 at 12, then 4 at 15
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 15)
+
+    def test_fully_issued_is_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_issue_beyond_stock_does_not_go_negative(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_only_the_given_sku_counts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+        self.assertEqual(stock_value(inv, " br-2210 "), 150)
+
+    def test_incoming_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv.movements.append(Movement("BR-1042", 3, DAY, "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
