+"""What stock is worth."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value, in cents, of the stock of `sku` currently on hand.
+
+    Costed FIFO: each receipt opens a layer at its unit cost, and goods out
+    are taken from the oldest layers first. Goods out beyond what was on
+    hand don't reduce the value below zero.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for incoming {m.reason} of {m.sku}")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
