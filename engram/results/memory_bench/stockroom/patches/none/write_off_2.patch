+    def test_write_off_records_damage_and_reduces_on_hand(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off(" br-1042", 3, DAY)
+        self.assertEqual((m.qty, m.reason, m.sku, m.date), (-3, "DAMAGE", "BR-1042", DAY))
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_quantity_must_be_positive(self):
+        inv = Inventory()
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", 0)
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", -2)
+        self.assertEqual(inv.movements, [])
+
     def test_receive_and_issue(self):
         inv = Inventory()
         inv.receive("BR-1042", 100, 12, DAY)
