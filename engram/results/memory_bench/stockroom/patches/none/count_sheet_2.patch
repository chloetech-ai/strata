+"""The count sheet for a stock-take: one line per catalog item, for the counter to fill in."""
+
+
+def count_sheet(inventory):
+    """Tab-separated lines: bin, SKU, name, unit, quantity on hand, and an empty column to write the count in."""
+    lines = []
+    for item in inventory.catalog:
+        on_hand = inventory.on_hand(item.sku)
+        lines.append(f"{item.location}\t{item.sku}\t{item.name}\t{item.unit}\t{on_hand}\t")
+    return "\n".join(lines)
