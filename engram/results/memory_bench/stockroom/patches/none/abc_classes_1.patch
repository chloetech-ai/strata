+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B, or C by annual consumption value.
+
+    SKUs are sorted highest value first. A SKU is 'A' while the cumulative
+    value up to and including it is at most 80% of the total, 'B' while it
+    is at most 95%, and 'C' otherwise.
+    """
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.80 * total:
+            out[sku] = "A"
+        elif running <= 0.95 * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
