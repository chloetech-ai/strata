+++ b/tests/test_analysis.py
@@ -0,0 +1,25 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        values = {"D": 5, "A": 50, "C": 15, "B": 30}
+        # Sorted: A 50 (50%), B 30 (80%), C 15 (95%), D 5 (100%)
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative shares land exactly on 80% and 95%.
+        values = {"A": 80, "B": 15, "C": 5}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "B", "C": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
