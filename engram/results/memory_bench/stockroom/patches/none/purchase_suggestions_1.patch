+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -29,5 +29,30 @@ class ReorderTest(unittest.TestCase):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
 
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_past_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        # BR-1 has 5 on hand, reorder point 10: 6 brings it to 11.
+        self.assertEqual(orders["BR-1"], 6)
+        # BR-2 has 10 on hand, at the reorder point: 1 brings it to 11.
+        self.assertEqual(orders["BR-2"], 1)
+
+    def test_skips_skus_with_enough_stock(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("CS-1", "Case item", "B-01-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("CS-1", 3, 10)
+        # Shortfall is 8 (3 -> 11), rounded up to one case of 12.
+        self.assertEqual(suggest_orders(inv), {"CS-1": 12})
+
+    def test_empty_when_nothing_needs_reorder(self):
+        catalog = Catalog([Item("OK-1", "Fine", "C-01-1", reorder_point=2)])
+        inv = Inventory(catalog)
+        inv.receive("OK-1", 50, 10)
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
