+"""The count sheet for a stock-take: one line per catalog item, to write the counted quantity on."""
+
+
+def count_sheet(inventory):
+    """Tab-separated lines: SKU, location, name, unit, quantity on hand, and an empty
+    column for the counted quantity. Items come in catalog (SKU) order."""
+    lines = []
+    for item in inventory.catalog:
+        on_hand = inventory.on_hand(item.sku)
+        lines.append(f"{item.sku}\t{item.location}\t{item.name}\t{item.unit}\t{on_hand}\t")
+    return "".join(f"{line}\n" for line in lines)
