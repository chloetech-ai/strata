@@ -0,0 +1,24 @@
+"""What the stock on hand is worth."""
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, at moving-average cost.
+
+    Each receipt adds its units at its unit cost. Units leaving (sales, damage, ...)
+    go out at the average cost in force at the time. Units that arrive without a
+    cost (e.g. a count that finds extra stock) are valued at the current average.
+    Units sold beyond what was on hand carry no value. Amounts are rounded to
+    whole cents at each step.
+    """
+    qty = 0    # units on hand, may go negative if more is issued than received
+    value = 0  # cents; always 0 when qty is not positive
+    for m in inventory.movements_for(sku):
+        if m.qty > 0 and m.unit_cost is not None:
+            # Units that fill a negative balance are not stock yet, so they add no value.
+            value += (m.qty if qty >= 0 else max(qty + m.qty, 0)) * m.unit_cost
+        elif m.qty > 0 and qty > 0:
+            value += round(value * m.qty / qty)
+        elif m.qty < 0 and qty > 0:
+            value = 0 if -m.qty >= qty else value - round(value * -m.qty / qty)
+        qty += m.qty
+    return value
