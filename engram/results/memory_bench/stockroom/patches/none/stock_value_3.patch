@@ -0,0 +1,63 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_nothing_on_hand_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_receipts_at_one_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 125, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1250)
+
+    def test_sales_leave_at_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)  # average is now 200
+        inv.issue("BR-1042", 5, DAY)           # 5 units leave at 200
+        self.assertEqual(stock_value(inv, "BR-1042"), 15 * 200)
+
+    def test_selling_everything_leaves_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 77, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_rounds_average_to_whole_cents(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 100, DAY)
+        inv.receive("BR-1042", 3, 101, DAY)  # 603 cents over 6 units
+        inv.issue("BR-1042", 1, DAY)          # 100.5 cents out, rounds to 100
+        self.assertEqual(stock_value(inv, "BR-1042"), 503)
+
+    def test_selling_more_than_on_hand_then_restocking(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 5, DAY)
+        inv.issue("BR-1042", 15, DAY)          # 5 units were never there
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+        inv.receive("BR-1042", 10, 7, DAY)     # on hand is now 5
+        self.assertEqual(inv.on_hand("BR-1042"), 5)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 7)
+
+    def test_movement_without_cost_is_valued_at_current_average(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 100, DAY)
+        inv._record(Movement("BR-1042", 2, DAY, "COUNT"))
+        self.assertEqual(stock_value(inv, "BR-1042"), 600)
+
+    def test_only_the_given_sku_counts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(stock_value(inv, "br-1042 "), 1000)
+        self.assertEqual(stock_value(inv, "BR-2210"), 150)
+
+
+if __name__ == "__main__":
+    unittest.main()
