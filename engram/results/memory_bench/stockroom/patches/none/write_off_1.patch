 ## Unreleased
 
+- `Inventory.write_off(sku, qty, date=None)` records broken or damaged stock as a `DAMAGE` movement.
 - Command line: `python -m stockroom onhand SKU --log FILE`, `receive SKU QTY UNIT_COST --log FILE` and `moves SKU --log FILE`.
 
 ## 0.1.0
diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 6c1193e..8944564 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -53,6 +53,15 @@ class Inventory:
             reason="SALE", note=note,
         ))
 
+    def write_off(self, sku, qty, date=None):
+        """Stock that got broken or damaged and can't be sold."""
+        if qty <= 0:
+            raise ValueError("quantity must be positive")
+        return self._record(Movement(
+            sku=normalize_sku(sku), qty=-qty, date=date or datetime.date.today(),
+            reason="DAMAGE",
+        ))
+
     def on_hand(self, sku):
         sku = normalize_sku(sku)
         return sum(m.qty for m in self.movements if m.sku == sku)
