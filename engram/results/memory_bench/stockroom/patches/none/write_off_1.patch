+        m = inv.write_off(" br-1042 ", 4, DAY)
+        self.assertEqual((m.sku, m.qty, m.reason, m.date), ("BR-1042", -4, "DAMAGE", DAY))
+        self.assertEqual(inv.on_hand("BR-1042"), 6)
+
+    def test_write_off_quantity_must_be_positive(self):
