@@ -0,0 +1,40 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        values = {"BR-1": 50, "BR-2": 30, "BR-3": 15, "BR-4": 5}
+        # Cumulative shares: 50%, 80%, 95%, 100%.
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        # Cumulative 80% lands exactly on the A boundary, 95% on the B one.
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_top_sku_over_80_percent_is_b(self):
+        values = {"BR-1": 90, "BR-2": 10}
+        self.assertEqual(abc_classes(values), {"BR-1": "B", "BR-2": "C"})
+
+    def test_input_order_does_not_matter(self):
+        values = {"BR-3": 5, "BR-1": 50, "BR-4": 5, "BR-2": 40}
+        # Cumulative: 50% (A), 90% (B), 95% (B), 100% (C).
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "B", "BR-4": "C"},
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
