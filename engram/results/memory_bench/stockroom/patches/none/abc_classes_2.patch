+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by share of total annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted highest
+    value first, and each gets the class of its cumulative share including
+    itself: A up to 80% of the grand total, B up to 95%, C otherwise.
+    """
+    total = sum(values.values())
+    classes = {}
+    cumulative = 0
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        cumulative += value
+        if cumulative <= 0.80 * total:
+            classes[sku] = "A"
+        elif cumulative <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
