@@ -0,0 +1,42 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 800 (80%), B 150 (95%), C 30 (98%), D 20 (100%)
+        values = {"A": 800, "B": 150, "C": 30, "D": 20}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "B", "C": "C", "D": "C"},
+        )
+
+    def test_boundary_at_80_percent_is_a(self):
+        values = {"X": 80, "Y": 15, "Z": 5}
+        # Cumulative: 80 (80%), 95 (95%), 100 (100%)
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_boundary_at_95_percent_is_b(self):
+        values = {"X": 50, "Y": 30, "Z": 15, "W": 5}
+        # Cumulative: 50 (50%), 80 (80%), 95 (95%), 100 (100%)
+        self.assertEqual(
+            abc_classes(values),
+            {"X": "A", "Y": "A", "Z": "B", "W": "C"},
+        )
+
+    def test_order_is_by_value_not_insertion(self):
+        values = {"b": 10, "a": 30, "c": 60}
+        # Sorted: c (60%), a (90%), b (100%)
+        self.assertEqual(abc_classes(values), {"c": "A", "a": "B", "b": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above both thresholds.
+        self.assertEqual(abc_classes({"ONLY": 42}), {"ONLY": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
