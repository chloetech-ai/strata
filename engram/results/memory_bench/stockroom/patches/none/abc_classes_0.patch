+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value using ABC analysis.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first (ties broken by SKU). A SKU is 'A' if the cumulative share
+    of the grand total up to and including it is at most 80%, 'B' if at most
+    95%, otherwise 'C'.
+    """
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        # Multiply instead of dividing so a zero total cannot raise.
+        if running <= 0.8 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
