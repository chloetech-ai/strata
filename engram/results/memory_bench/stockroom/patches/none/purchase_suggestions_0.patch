+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,27 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_brings_stock_above_reorder_point(self):
+        self.assertEqual(suggest_orders(make_inventory()), {"BR-1": 6, "BR-2": 1})
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 3, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 12})
+
+    def test_suggest_orders_multiple_cases(self):
+        catalog = Catalog([Item("BR-5", "Rivet", "A-02-2", reorder_point=20, case_size=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-5", 1, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-5": 20})
+
+    def test_suggest_orders_empty_when_nothing_needed(self):
+        catalog = Catalog([Item("BR-6", "Pin", "A-02-3", reorder_point=5)])
+        inv = Inventory(catalog)
+        inv.receive("BR-6", 100, 10)
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
