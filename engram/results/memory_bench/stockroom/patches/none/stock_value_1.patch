+"""Valuing the stock on hand."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed FIFO.
+
+    Each positive movement opens a cost layer at its `unit_cost`; each
+    negative movement consumes the oldest layers first. A positive movement
+    without a cost can't be valued, so it raises rather than guessing.
+    """
+    layers = deque()  # [qty, unit_cost], oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for {m.reason} of {m.sku}")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
