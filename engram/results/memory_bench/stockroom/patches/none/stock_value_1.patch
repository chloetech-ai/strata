@@ -0,0 +1,52 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_sales_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 20, DAY)
+        inv.issue("BR-1042", 15, DAY)  # 10 @ 12 and 5 @ 20
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 20)
+
+    def test_fully_sold_is_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+        self.assertEqual(stock_value(inv, " br-2210"), 150)
+
+    def test_sku_spellings_are_the_same_item(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 120)
+
+    def test_positive_movement_without_cost_raises(self):
+        inv = Inventory()
+        inv.movements.append(Movement("BR-1042", 3, DAY, "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
