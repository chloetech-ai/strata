@@ -0,0 +1,28 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_boundaries_are_inclusive(self):
+        # Running shares: 50%, 80%, 95%, 100% of a total of 100.
+        values = {"BR-1": 5, "BR-2": 15, "BR-3": 30, "BR-4": 50}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-4": "A", "BR-3": "A", "BR-2": "B", "BR-1": "C"},
+        )
+
+    def test_crossing_sku_goes_to_next_class(self):
+        # Running shares: 60%, 90%, 100%. The second SKU crosses 80%, so it is B.
+        values = {"BR-1": 60, "BR-2": 30, "BR-3": 10}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
