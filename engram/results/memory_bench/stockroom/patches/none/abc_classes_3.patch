+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B, or C by their share of total annual consumption.
+
+    `values` maps SKU to annual consumption value. SKUs are walked from highest
+    to lowest value with a running total; a SKU is 'A' while the cumulative
+    share through it is at most 80% of the grand total, 'B' while it is at most
+    95%, and 'C' otherwise.
+    """
+    total = sum(values.values())
+    ranked = sorted(values, key=lambda sku: values[sku], reverse=True)
+    classes = {}
+    running = 0
+    for sku in ranked:
+        running += values[sku]
+        if running <= 0.8 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
