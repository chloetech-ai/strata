+"""The count sheet for a stock-take."""
+
+
+def count_sheet(inventory):
+    """One tab-separated line per catalog item: bin, SKU, name, expected on hand.
+
+    Lines follow catalog order (by SKU). The counter writes the counted
+    quantity beside each line.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count against")
+    lines = []
+    for item in inventory.catalog:
+        expected = inventory.on_hand(item.sku)
+        lines.append(f"{item.location}\t{item.sku}\t{item.name}\t{expected}")
+    return "\n".join(lines)
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
