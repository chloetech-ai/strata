@@ -0,0 +1,35 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_catalog_item_in_sku_order(self):
+        catalog = Catalog([
+            Item("BR-2", "Nut", "A-01-2"),
+            Item("BR-1", "Bolt", "A-01-1"),
+        ])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        inv.receive("BR-2", 10, 10)
+        self.assertEqual(
+            count_sheet(inv),
+            "A-01-1\tBR-1\tBolt\t5\nA-01-2\tBR-2\tNut\t10",
+        )
+
+    def test_item_with_no_movements_shows_zero(self):
+        inv = Inventory(Catalog([Item("BR-1", "Bolt", "A-01-1")]))
+        self.assertEqual(count_sheet(inv), "A-01-1\tBR-1\tBolt\t0")
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_requires_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
