@@ -0,0 +1,24 @@
+"""What the stock on hand is worth."""
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Costed at moving average: a receipt adds its unit cost to the stock, and
+    every other movement is valued at the average cost held when it happens.
+    Movements are taken in log order. Stock that is not on hand is worth 0.
+    """
+    quantity = 0
+    value = 0  # cents
+    for m in inventory.movements_for(sku):
+        average = value / quantity if quantity > 0 else 0
+        if m.qty > 0 and m.unit_cost is not None:
+            value += m.qty * m.unit_cost
+        elif m.qty > 0:
+            value += round(m.qty * average)
+        else:
+            value -= round(-m.qty * average)
+        quantity += m.qty
+        if quantity <= 0:
+            value = 0
+    return value
