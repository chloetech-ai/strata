diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 6c1193e..3523777 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -60,3 +60,11 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """Latest receipt for `sku` by date; a later-recorded one wins ties."""
+        latest = None
+        for m in self.movements_for(sku):
+            if m.reason == "RECEIPT" and (latest is None or m.date >= latest.date):
+                latest = m
+        return latest
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 12a58fb..5ed6777 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -55,6 +55,27 @@ class InventoryTest(unittest.TestCase):
         inv.issue("BR-1042", 4, DAY)
         self.assertEqual([m.qty for m in inv.movements_for("BR-1042")], [10, -4])
 
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_is_the_latest_by_date(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        later = inv.receive("BR-1042", 5, 13, DAY + datetime.timedelta(days=3))
+        inv.receive("BR-1042", 7, 11, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 4, DAY + datetime.timedelta(days=5))
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
+    def test_last_receipt_ties_go_to_the_later_recorded(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 5, 13, DAY)
+        self.assertIs(inv.last_receipt(" br-1042"), second)
+
 
 if __name__ == "__main__":
     unittest.main()
