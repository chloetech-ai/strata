diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..dffd321 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,19 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU needing reorder to the quantity to order.
+
+    The quantity is the fewest whole cases that take stock above the reorder
+    point again.
+    """
+    orders = {}
+    for item in inventory.catalog:
+        on_hand = inventory.on_hand(item.sku)
+        if on_hand <= item.reorder_point:
+            short = item.reorder_point - on_hand + 1  # units needed to get above the point
+            cases = -(-short // item.case_size)  # ceiling division
+            orders[item.sku] = cases * item.case_size
+    return orders
diff --git a/tests/test_reorder.py b/tests/test_reorder.py
