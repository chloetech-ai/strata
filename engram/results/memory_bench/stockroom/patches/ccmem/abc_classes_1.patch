@@ -0,0 +1,24 @@
+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted highest
+    value first, and each gets the class of its cumulative share of the grand
+    total up to and including it: 'A' at most 80%, 'B' at most 95%, else 'C'.
+    """
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: pair[1], reverse=True)
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        share = running / total
+        if share <= 0.80:
+            out[sku] = "A"
+        elif share <= 0.95:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
