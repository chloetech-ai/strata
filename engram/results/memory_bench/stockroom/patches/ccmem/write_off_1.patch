+    def write_off(self, sku, qty, date=None):
+        """Stock that was broken or damaged; `qty` is the number of units lost."""
+        if qty <= 0:
+            raise ValueError("quantity must be positive")
+        return self._record(Movement(normalize_sku(sku), -qty, date or datetime.date.today(), "DAMAGE", None))
