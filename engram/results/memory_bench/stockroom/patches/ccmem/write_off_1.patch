+    def test_write_off_records_damage_as_goods_out(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        movement = inv.write_off("BR-1042", 3, DAY)
+        self.assertEqual((movement.reason, movement.qty, movement.date), ("DAMAGE", -3, DAY))
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_rejects_zero_or_negative_quantity(self):
+        inv = Inventory()
+        for bad in [0, -2]:
+            with self.assertRaises(ValueError):
+                inv.write_off("BR-1042", bad, DAY)
+        self.assertEqual(inv.movements, [])
+
+    def test_write_off_normalizes_sku_and_defaults_to_today(self):
