diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index aef508a..30046e7 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -62,3 +62,11 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The most recently logged RECEIPT for `sku`, or None if it has never been received."""
+        sku = normalize_sku(sku)
+        for m in reversed(self.movements):
+            if m.sku == sku and m.reason == "RECEIPT":
+                return m
+        return None
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 5aa3ccb..e46256b 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -69,6 +69,28 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual(len(inv.movements_for(" br-1042")), 3)
         self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
 
+    def test_last_receipt_is_the_most_recent_receipt_for_the_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        second = inv.receive("BR-1042", 6, 13, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+        self.assertEqual(inv.last_receipt(" br-1042").unit_cost, 13)
+
+    def test_last_receipt_ignores_adjustments_and_sales(self):
+        inv = Inventory()
+        receipt = inv.receive("BR-1042", 10, 12, DAY)
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), receipt)
+
+    def test_last_receipt_is_none_without_a_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.adjust("BR-1042", 2, "COUNT", DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
 
 if __name__ == "__main__":
     unittest.main()
