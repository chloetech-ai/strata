+"""Stock valuation. Stock is costed FIFO: the oldest units leave first."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value, in cents, of the units of `sku` currently on hand, costed FIFO.
+
+    Each positive movement opens a layer at its unit cost (movements without a
+    cost, such as a RETURN, are valued at zero). Each negative movement consumes
+    the oldest layers first. Units issued beyond what was on hand carry no cost;
+    if stock later comes in, it first covers that shortfall before opening a layer.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    shortfall = 0  # units issued without stock to draw from
+
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            covered = min(shortfall, m.qty)
+            shortfall -= covered
+            if m.qty > covered:
+                layers.append([m.qty - covered, m.unit_cost or 0])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(layers[0][0], remaining)
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            shortfall += remaining
+
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..e24e89a
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,76 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_issues_consume_oldest_layers_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 15, DAY)
+        inv.issue("BR-1042", 14, DAY)  # 10 at 12, then 4 at 15
+        # 6 units left, all from the 15-cent layer
+        self.assertEqual(inv.on_hand("BR-1042"), 6)
+        self.assertEqual(stock_value(inv, "BR-1042"), 90)
+
+    def test_partial_layer_keeps_its_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 72)
+
+    def test_damage_and_count_consume_fifo(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 10, DAY)
+        inv.receive("BR-1042", 5, 20, DAY)
+        inv.adjust("BR-1042", -6, "DAMAGE", DAY)  # 5 at 10, then 1 at 20
+        inv.adjust("BR-1042", -2, "COUNT", DAY)   # 2 more at 20
+        self.assertEqual(stock_value(inv, "BR-1042"), 40)
+
+    def test_positive_adjustment_without_cost_is_valued_at_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 12)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_negative_stock_carries_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 12, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_receipt_after_negative_stock_covers_the_shortfall_first(self):
+        inv = Inventory()
+        inv.issue("BR-1042", 4, DAY)
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 6)
+        self.assertEqual(stock_value(inv, "BR-1042"), 72)
+
+    def test_only_the_given_sku_is_valued(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(stock_value(inv, "BR-2210"), 150)
+
+    def test_sku_spelling_is_normalized(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 120)
+
+
+if __name__ == "__main__":
+    unittest.main()
