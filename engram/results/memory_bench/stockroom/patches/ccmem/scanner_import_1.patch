+"""Reading the count files exported by the handheld scanners."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per normalized SKU.
+
+    The file is plain text with one `bin;sku;qty` line per count and no header.
+    A SKU may appear on several lines (part of it in an overflow bin), so its
+    quantities are added up.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {qty!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: counted quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
