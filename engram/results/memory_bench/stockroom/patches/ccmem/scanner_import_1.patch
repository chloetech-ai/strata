@@ -0,0 +1,65 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self._dir.cleanup)
+
+    def write(self, text):
+        path = os.path.join(self._dir.name, "count.txt")
+        with open(path, "w", encoding="utf-8", newline="") as f:
+            f.write(text)
+        return path
+
+    def test_reads_bin_sku_qty_without_header(self):
+        path = self.write("C-03-2;BR-1042;12\nA-01-1;NU-7;4\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 12, "NU-7": 4})
+
+    def test_sums_sku_across_overflow_bins(self):
+        path = self.write("C-03-2;BR-1042;12\nZ-09-9;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 17})
+
+    def test_normalizes_sku(self):
+        path = self.write("C-03-2; br-1042 ;3\nZ-09-9;BR-1042;2\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 5})
+
+    def test_skips_blank_lines_and_handles_crlf(self):
+        path = self.write("C-03-2;BR-1042;1\r\n\r\n\nC-03-2;NU-7;2\r\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 1, "NU-7": 2})
+
+    def test_empty_file_gives_no_counts(self):
+        self.assertEqual(read_scanner_file(self.write("")), {})
+
+    def test_wrong_column_count_names_the_line(self):
+        path = self.write("C-03-2;BR-1042;1\nBR-1042;2\n")
+        with self.assertRaisesRegex(ValueError, r":2: expected bin;sku;qty"):
+            read_scanner_file(path)
+
+    def test_header_row_is_rejected(self):
+        path = self.write("bin;sku;qty\nC-03-2;BR-1042;1\n")
+        with self.assertRaisesRegex(ValueError, r":1: quantity is not a whole number"):
+            read_scanner_file(path)
+
+    def test_non_integer_quantity_rejected(self):
+        path = self.write("C-03-2;BR-1042;1.5\n")
+        with self.assertRaisesRegex(ValueError, r":1: quantity is not a whole number"):
+            read_scanner_file(path)
+
+    def test_negative_quantity_rejected(self):
+        path = self.write("C-03-2;BR-1042;-1\n")
+        with self.assertRaisesRegex(ValueError, r":1: counted quantity must not be negative"):
+            read_scanner_file(path)
+
+    def test_empty_sku_rejected(self):
+        path = self.write("C-03-2;  ;3\n")
+        with self.assertRaisesRegex(ValueError, r":1: empty SKU"):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
