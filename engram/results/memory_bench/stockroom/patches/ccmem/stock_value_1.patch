+"""Stock valuation at FIFO cost."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value, in cents, of the stock of `sku` currently on hand, at FIFO cost.
+
+    Receipts form cost layers in log order; goods out (sales and negative
+    adjustments) consume the oldest layers first. Goods out beyond the received
+    stock have no layer and carry no value.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            # A return or count surplus without a recorded cost can't be valued.
+            if m.unit_cost is None:
+                raise ValueError(f"cannot value {sku}: positive {m.reason} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
