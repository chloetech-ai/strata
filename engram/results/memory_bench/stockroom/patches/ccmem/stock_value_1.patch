+++ b/tests/test_valuation.py
@@ -0,0 +1,62 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt_values_on_hand_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_sales_consume_oldest_layers_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 15, DAY)
+        inv.issue("BR-1042", 12, DAY)  # 10 at 12 plus 2 at 15
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 15)
+
+    def test_partial_layer_is_split_across_sales(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 15, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        inv.issue("BR-1042", 8, DAY)  # 6 more from first layer, then 2 from second
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 15)
+
+    def test_sold_beyond_receipts_has_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_costed_count_surplus_opens_a_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, DAY)
+        inv.adjust("BR-1042", 3, "COUNT", DAY)
+        inv.movements[-1].unit_cost = 20
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 12 + 3 * 20)
+
+    def test_uncosted_positive_adjustment_is_rejected(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, DAY)
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+    def test_sku_is_normalized_and_other_skus_ignored(self):
+        inv = Inventory()
+        inv.receive(" br-1042 ", 4, 12, DAY)
+        inv.receive("XY-9", 100, 50, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 48)
+
+
+if __name__ == "__main__":
+    unittest.main()
