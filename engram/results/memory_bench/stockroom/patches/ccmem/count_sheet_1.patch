diff --git a/src/stockroom/countsheet.py b/src/stockroom/countsheet.py
new file mode 100644
index 0000000..9684abe
--- /dev/null
+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,16 @@
+"""The stock-take count sheet: a blind count, so quantities on hand are never printed."""
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin-location order, with a blank column to write the count in.
+
+    The sheet deliberately leaves out the quantity on hand so the counter cannot copy it.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count")
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    lines = [
+        f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<6}  ________"
+        for item in items
+    ]
+    return "\n".join(lines) + "\n" if lines else ""
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..c7fc4ae
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,40 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-2", "Nut", "B-02-1", unit="pcs"),
+        Item("BR-1", "Bolt", "A-01-1", unit="pcs"),
+        Item("BR-3", "Washer", "A-09-4", unit="pcs"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1", 7319, 10)  # distinctive quantity, so a leak would be easy to spot
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_catalog_item(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+
+    def test_sorted_by_bin_location(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual([line.split()[0] for line in lines], ["A-01-1", "A-09-4", "B-02-1"])
+
+    def test_does_not_print_quantities_on_hand(self):
+        self.assertNotIn("7319", count_sheet(make_inventory()))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_no_catalog_is_an_error(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
