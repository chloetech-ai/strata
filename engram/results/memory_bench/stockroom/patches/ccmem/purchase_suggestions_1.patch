@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,28 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_for_items_at_or_below_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 6, "BR-2": 1})
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 4, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 24})
+
+    def test_suggest_orders_counts_negative_stock(self):
+        catalog = Catalog([Item("BR-5", "Rivet", "A-03-1", reorder_point=5)])
+        inv = Inventory(catalog)
+        inv.issue("BR-5", 3)
+        self.assertEqual(suggest_orders(inv), {"BR-5": 9})
+
+    def test_no_orders_when_stock_is_enough(self):
+        catalog = Catalog([Item("BR-6", "Pin", "A-04-1", reorder_point=2)])
+        inv = Inventory(catalog)
+        inv.receive("BR-6", 50, 10)
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
