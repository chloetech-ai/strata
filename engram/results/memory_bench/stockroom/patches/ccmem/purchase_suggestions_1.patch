diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..190cfc2 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,19 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU needing reorder to the quantity to order.
+
+    The order brings stock to the reorder point plus one case, rounded up to
+    whole cases. Negative stock counts as on hand, so it gets a larger order.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        target = item.reorder_point + item.case_size
+        shortfall = target - inventory.on_hand(sku)
+        cases = -(-shortfall // item.case_size)  # ceiling division
+        orders[sku] = cases * item.case_size
+    return orders
