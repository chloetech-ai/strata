 """Reorder checks."""
 
+import math
+
 
 def needs_reorder(inventory):
     """SKUs whose quantity on hand is at or below their reorder point."""
@@ -8,3 +10,19 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU needing reorder to the units to order.
+
+    The quantity is the fewest whole cases that take stock on hand above the
+    reorder point, so it is always a multiple of the item's case size.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        # Units needed to get on hand strictly above the reorder point.
+        shortfall = item.reorder_point - inventory.on_hand(sku) + 1
+        cases = math.ceil(shortfall / item.case_size)
+        orders[sku] = cases * item.case_size
+    return orders
