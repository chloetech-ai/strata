@@ -28,6 +28,37 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_lifts_stock_above_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 6, "BR-2": 1})
+
+    def test_suggest_orders_omits_well_stocked_items(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-9", "Screw", "A-02-1", reorder_point=50, case_size=100)])
+        inv = Inventory(catalog)
+        inv.receive("BR-9", 20, 5)
+        self.assertEqual(suggest_orders(inv), {"BR-9": 100})
+
+    def test_suggest_orders_multiple_cases_when_far_below(self):
+        catalog = Catalog([Item("BR-9", "Screw", "A-02-1", reorder_point=250, case_size=100)])
+        inv = Inventory(catalog)
+        inv.receive("BR-9", 20, 5)
+        self.assertEqual(suggest_orders(inv), {"BR-9": 300})
+
+    def test_suggest_orders_counts_negative_stock(self):
+        catalog = Catalog([Item("BR-4", "Pin", "A-03-1", reorder_point=5)])
+        inv = Inventory(catalog)
+        inv.issue("BR-4", 3)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 9})
+
+    def test_suggest_orders_empty_when_nothing_needed(self):
