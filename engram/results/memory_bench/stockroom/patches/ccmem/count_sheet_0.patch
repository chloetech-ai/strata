+"""The stock-take count sheet: a blind count, so quantities on hand are never printed."""
+
+
+def _bin_key(location):
+    """Walk order for bin codes like "B-12-3": numeric parts compare as numbers, so B-2-1 comes before B-12-3."""
+    return tuple((0, int(part), "") if part.isdigit() else (1, 0, part) for part in location.split("-"))
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin-location order, with a blank column to write the counted quantity in."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to build a count sheet from")
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<10} {item.sku:<12} {item.name:<30} {item.unit:<6} ________")
+    return "\n".join(lines)
