+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-1", "Bolt", "B-12-3", reorder_point=10),
+        Item("BR-2", "Nut", "A-01-2", reorder_point=10, unit="box"),
+        Item("BR-3", "Washer", "B-2-1", reorder_point=10),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1", 5, 10)
+    inv.receive("BR-2", 1234, 10)
+    inv.receive("BR-3", 50, 10)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_catalog_item(self):
+        self.assertEqual(len(count_sheet(make_inventory()).splitlines()), 3)
+
+    def test_sorted_by_bin_location_with_numeric_parts(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertTrue(lines[0].startswith("A-01-2"))
+        self.assertTrue(lines[1].startswith("B-2-1"))
+        self.assertTrue(lines[2].startswith("B-12-3"))
+
+    def test_shows_sku_name_unit_and_blank_count_column(self):
+        line = count_sheet(make_inventory()).splitlines()[0]
+        self.assertIn("BR-2", line)
+        self.assertIn("Nut", line)
+        self.assertIn("box", line)
+        self.assertTrue(line.endswith("________"))
+
+    def test_never_prints_quantities_on_hand(self):
+        sheet = count_sheet(make_inventory())
+        self.assertNotIn("1234", sheet)
+        self.assertNotIn("50", sheet)
+        self.assertNotIn("1229", sheet)
+
+    def test_items_without_stock_are_listed(self):
+        inv = Inventory(Catalog([Item("BR-9", "Spare", "C-1-1")]))
+        self.assertEqual(len(count_sheet(inv).splitlines()), 1)
+
+    def test_no_catalog_is_an_error(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
