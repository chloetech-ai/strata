+"""Stock valuation at FIFO cost."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed first-in first-out.
+
+    Each receipt opens a layer at its unit cost; goods out consume the oldest
+    layers first, and whatever is left in the layers is on hand. Goods out with
+    no layer left to consume (negative stock) add no value.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{m.reason} of {m.sku} has no unit cost; cannot value it at FIFO")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            taken = min(remaining, layers[0][0])
+            layers[0][0] -= taken
+            remaining -= taken
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
