+++ b/tests/test_valuation.py
@@ -0,0 +1,60 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_values_remaining_stock_at_receipt_costs(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 5, 15, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 12 + 5 * 15)
+
+    def test_sales_consume_oldest_layers_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 20, DAY)
+        inv.issue("BR-1042", 14, DAY)  # 10 at 12, then 4 at 20
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 20)
+
+    def test_partial_layer_keeps_its_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 7 * 12)
+
+    def test_damage_consumes_layers_like_a_sale(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 10, DAY)
+        inv.receive("BR-1042", 4, 30, DAY)
+        inv.adjust("BR-1042", -6, "DAMAGE", DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 30)
+
+    def test_negative_stock_adds_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 12, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_nothing_on_hand_is_worth_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_only_the_given_sku_is_valued(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("NL-7", 3, 100, DAY)
+        self.assertEqual(stock_value(inv, " br-1042 "), 10 * 12)
+
+    def test_positive_adjustment_without_cost_is_refused(self):
+        inv = Inventory()
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
