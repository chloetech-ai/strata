+++ b/tests/test_scanner.py
@@ -0,0 +1,49 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerFileTest(unittest.TestCase):
+    def _read(self, text, encoding="utf-8"):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "count.txt")
+            with open(path, "w", newline="", encoding=encoding) as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_reads_quantity_per_sku(self):
+        counted = self._read("B-12-3;BR-1042;7\r\nC-01-1;WS-200;0\r\n")
+        self.assertEqual(counted, {"BR-1042": 7, "WS-200": 0})
+
+    def test_sums_overflow_bins(self):
+        counted = self._read("B-12-3;BR-1042;7\nOVF-1;BR-1042;5\n")
+        self.assertEqual(counted, {"BR-1042": 12})
+
+    def test_normalizes_sku(self):
+        counted = self._read("B-12-3; br-1042 ;7\nOVF-1;BR-1042;5\n")
+        self.assertEqual(counted, {"BR-1042": 12})
+
+    def test_skips_blank_lines_and_byte_order_mark(self):
+        counted = self._read("﻿B-12-3;BR-1042;7\n\n")
+        self.assertEqual(counted, {"BR-1042": 7})
+
+    def test_empty_file_gives_no_counts(self):
+        self.assertEqual(self._read(""), {})
+
+    def test_rejects_wrong_field_count(self):
+        with self.assertRaisesRegex(ValueError, "line 2: expected bin;sku;qty"):
+            self._read("B-12-3;BR-1042;7\nBR-1042,7\n")
+
+    def test_rejects_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, "line 1: quantity must be a whole number"):
+            self._read("B-12-3;BR-1042;7.5\n")
+
+    def test_rejects_negative_quantity(self):
+        with self.assertRaisesRegex(ValueError, "line 1: quantity must not be negative"):
+            self._read("B-12-3;BR-1042;-2\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
