+"""Reading the count files exported by the handheld scanners."""
+
+import csv
+from collections import defaultdict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is `bin;sku;qty` with no header. A SKU may be counted in several bins
+    (overflow locations), so its quantities are summed across all of them.
+    """
+    counted = defaultdict(int)
+    # utf-8-sig: the scanner firmware may write a byte order mark at the start of the file.
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        for number, row in enumerate(csv.reader(f, delimiter=";"), start=1):
+            if not row:
+                continue
+            if len(row) != 3:
+                raise ValueError(f"{path}, line {number}: expected bin;sku;qty, got {len(row)} fields")
+            _bin, sku, text = row
+            try:
+                qty = int(text)
+            except ValueError:
+                raise ValueError(f"{path}, line {number}: quantity must be a whole number, got {text!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}, line {number}: quantity must not be negative, got {qty}")
+            counted[normalize_sku(sku)] += qty
+    return dict(counted)
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
