@@ -0,0 +1,29 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 50 (50%), B 30 (80%), C 15 (95%), D 5 (100%)
+        values = {"D": 5, "A": 50, "C": 15, "B": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        # Cumulative share reaches exactly 80% at the second SKU, so it is A.
+        values = {"X": 40, "Y": 40, "Z": 20}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "A", "Z": "C"})
+
+    def test_last_sku_is_always_c(self):
+        # Its cumulative share is 100%, which is above both thresholds.
+        self.assertEqual(abc_classes({"ONLY": 7}), {"ONLY": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
