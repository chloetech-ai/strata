+"""Stock analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by ABC analysis of their annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and walked with a running total. A SKU is 'A' if the
+    cumulative share up to and including it is at most 80% of the grand
+    total, 'B' if at most 95%, otherwise 'C'. Returns a dict of SKU to class.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    out = {}
+    cumulative = 0
+    for sku, value in ranked:
+        cumulative += value
+        if cumulative <= 0.80 * total:
+            out[sku] = "A"
+        elif cumulative <= 0.95 * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
