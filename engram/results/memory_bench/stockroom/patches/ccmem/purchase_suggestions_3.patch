@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,26 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_maps_sku_to_quantity(self):
+        self.assertEqual(suggest_orders(make_inventory()), {"BR-1": 6, "BR-2": 1})
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-01-4", reorder_point=50, case_size=100)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 20, 5)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 100})
+
+    def test_suggest_orders_covers_negative_stock(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-01-5", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.issue("BR-5", 3)
+        self.assertEqual(suggest_orders(inv), {"BR-5": 24})
+
+    def test_suggest_orders_empty_when_stocked(self):
+        inv = Inventory(Catalog([Item("BR-6", "Clip", "A-01-6", reorder_point=5)]))
+        inv.receive("BR-6", 9, 1)
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
