@@ -0,0 +1,23 @@
+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by cumulative share of annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted highest
+    value first and accumulated; a SKU is 'A' if the cumulative share up to
+    and including it is at most 80%, 'B' if at most 95%, otherwise 'C'.
+    """
+    total = sum(values.values())
+    out = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        running += value
+        # Compare cross-multiplied to avoid dividing by the total.
+        if running * 5 <= total * 4:
+            out[sku] = "A"
+        elif running * 20 <= total * 19:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
