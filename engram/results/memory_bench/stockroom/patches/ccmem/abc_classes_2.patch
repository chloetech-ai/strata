@@ -0,0 +1,28 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: X 50 (50%), Y 30 (80%), Z 15 (95%), W 5 (100%)
+        values = {"W": 5, "X": 50, "Y": 30, "Z": 15}
+        self.assertEqual(
+            abc_classes(values),
+            {"X": "A", "Y": "A", "Z": "B", "W": "C"},
+        )
+
+    def test_boundary_at_80_and_95_percent_is_inclusive(self):
+        # Cumulative shares: 80% exactly after P, 95% exactly after Q
+        values = {"P": 80, "Q": 15, "R": 5}
+        self.assertEqual(abc_classes(values), {"P": "A", "Q": "B", "R": "C"})
+
+    def test_single_sku_cumulative_share_is_100_percent_so_c(self):
+        self.assertEqual(abc_classes({"ONLY": 12}), {"ONLY": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
