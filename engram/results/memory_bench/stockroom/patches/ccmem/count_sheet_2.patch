+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_sorted_by_bin_location(self):
+        catalog = Catalog([
+            Item("BR-3", "Washer", "B-12-3"),
+            Item("BR-1", "Bolt", "B-9-1", unit="box"),
+            Item("BR-2", "Nut", "A-01-2"),
+        ])
+        lines = count_sheet(Inventory(catalog)).splitlines()
+        self.assertEqual(
+            lines,
+            [
+                "A-01-2\tBR-2\tNut\tpcs\t",
+                "B-9-1\tBR-1\tBolt\tbox\t",
+                "B-12-3\tBR-3\tWasher\tpcs\t",
+            ],
+        )
+
+    def test_quantities_on_hand_are_not_printed(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1")])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 37, 10)
+        self.assertNotIn("37", count_sheet(inv))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_inventory_without_catalog_is_an_error(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
