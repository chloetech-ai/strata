+"""The blind count sheet for a stock-take."""
+
+
+def _bin_key(location):
+    """Sort bin codes like "B-9-1" before "B-12-3": digit parts compare as numbers."""
+    return tuple((0, int(part), "") if part.isdigit() else (1, 0, part) for part in location.split("-"))
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin-location order, for counting by hand.
+
+    Quantities on hand are deliberately left off so the count is blind.
+    Columns: bin, SKU, name, unit, then an empty column for the counted quantity.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count")
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    return "".join(f"{item.location}\t{item.sku}\t{item.name}\t{item.unit}\t\n" for item in items)
