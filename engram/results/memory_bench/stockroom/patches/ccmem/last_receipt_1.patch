diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index aef508a..cac9ed7 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -62,3 +62,10 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The most recent RECEIPT for `sku` by date, or None. Ties go to the later-logged movement."""
+        receipts = [(m.date, i, m) for i, m in enumerate(self.movements) if m.sku == normalize_sku(sku) and m.reason == "RECEIPT"]
+        if not receipts:
+            return None
+        return max(receipts, key=lambda r: (r[0], r[1]))[2]
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 5aa3ccb..e97b600 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -69,6 +69,28 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual(len(inv.movements_for(" br-1042")), 3)
         self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
 
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.issue("BR-1042", 1, DAY)
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_returns_most_recent_receipt_for_sku(self):
+        inv = Inventory()
+        first = inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), first)
+        second = inv.receive("br-1042 ", 6, 13, DAY + datetime.timedelta(days=1))
+        self.assertIs(inv.last_receipt(" BR-1042"), second)
+
+    def test_last_receipt_prefers_later_date_over_later_log_entry(self):
+        inv = Inventory()
+        newer = inv.receive("BR-1042", 10, 12, DAY + datetime.timedelta(days=5))
+        inv.receive("BR-1042", 3, 11, DAY)  # back-dated, logged after
+        self.assertIs(inv.last_receipt("BR-1042"), newer)
+
 
 if __name__ == "__main__":
     unittest.main()
