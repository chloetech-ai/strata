diff --git a/src/stockroom/countsheet.py b/src/stockroom/countsheet.py
new file mode 100644
index 0000000..01c718e
--- /dev/null
+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,23 @@
+"""The printable stock-take count sheet.
+
+It is a blind count: the system's on-hand figure is deliberately left off, so the
+counter writes what is actually on the shelf. Lines follow the walking order of the
+shop (bin location), not SKU order.
+"""
+
+import re
+
+
+def _location_key(location):
+    """Sort "B-2-1" before "B-12-3": digit runs compare as numbers, the rest as text."""
+    return [(0, int(part), "") if part.isdigit() else (1, 0, part)
+            for part in re.split(r"(\d+)", location) if part]
+
+
+def count_sheet(inventory):
+    """The count sheet as text, one line per catalog item, in bin-location order."""
+    items = sorted(inventory.catalog, key=lambda item: (_location_key(item.location), item.sku))
+    lines = [f"{'LOCATION':<12}{'SKU':<16}{'ITEM':<32}{'UNIT':<8}COUNTED"]
+    for item in items:
+        lines.append(f"{item.location:<12}{item.sku:<16}{item.name:<32}{item.unit:<8}")
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..971f540
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,19 @@
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def test_count_sheet_lists_each_item_in_bin_order_without_on_hand():
+    catalog = Catalog([
+        Item("sku-b", "Hinge", "B-12-3"),
+        Item("sku-a", "Screw", "B-2-1"),
+        Item("sku-c", "Bolt", "A-9-9"),
+    ])
+    inventory = Inventory(catalog)
+    inventory.receive("sku-a", 40, 15)
+
+    lines = count_sheet(inventory).splitlines()
+
+    assert len(lines) == 1 + 3  # header plus one line per item
+    assert [line.split()[0] for line in lines[1:]] == ["A-9-9", "B-2-1", "B-12-3"]
+    assert "40" not in count_sheet(inventory)
