+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_accepts_lowercase_aisle_and_ignores_surrounding_whitespace(self):
+        self.assertEqual(parse_location("  b-12-3\t"), ("B", 12, 3))
+
+    def test_rejects_malformed_codes(self):
+        for code in ["", "B-12", "B-12-3-1", "BB-12-3", "1-12-3", "B-x-3",
+                     "B-12-", "-12-3", "B--3", "B-12-3.5", "B-+12-3", "B - 12-3"]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
+
