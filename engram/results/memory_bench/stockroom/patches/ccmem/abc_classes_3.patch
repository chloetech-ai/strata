@@ -0,0 +1,30 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A=50 (50%), B=30 (80%), C=15 (95%), D=5 (100%)
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        # Running total reaches exactly 80% at "B" and exactly 95% at "C".
+        values = {"A": 80, "B": 15, "C": 5}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "B", "C": "C"})
+
+    def test_order_independent_of_input(self):
+        values = {"D": 5, "C": 15, "B": 30, "A": 50}
+        self.assertEqual(abc_classes(values)["A"], "A")
+        self.assertEqual(abc_classes(values)["D"], "C")
+
+
+if __name__ == "__main__":
+    unittest.main()
