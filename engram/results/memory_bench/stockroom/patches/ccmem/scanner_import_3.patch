+"""Reading the handheld scanner's count export."""
+
+import csv
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is ``bin;sku;qty`` with no header. A SKU counted in several bins
+    (overflow bins) is summed across those lines.
+    """
+    counts = {}
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        for lineno, row in enumerate(csv.reader(f, delimiter=";"), start=1):
+            if not any(field.strip() for field in row):
+                continue
+            if len(row) != 3:
+                raise ValueError(f"{path}:{lineno}: expected bin;sku;qty, got {len(row)} fields")
+            _bin, sku, qty_text = row
+            try:
+                qty = int(qty_text.strip())
+            except ValueError:
+                raise ValueError(f"{path}:{lineno}: quantity is not a whole number: {qty_text!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{lineno}: counted quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
