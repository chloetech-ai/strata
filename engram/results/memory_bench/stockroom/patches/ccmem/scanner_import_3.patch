@@ -0,0 +1,49 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def _read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "count.txt")
+            with open(path, "w", encoding="utf-8", newline="") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_reads_quantity_per_sku(self):
+        counts = self._read("B-12-3;BR-1042;40\r\nC-01-1;WS-7;5\r\n")
+        self.assertEqual(counts, {"BR-1042": 40, "WS-7": 5})
+
+    def test_sums_overflow_bins(self):
+        counts = self._read("B-12-3;BR-1042;40\nOVF-1;BR-1042;12\n")
+        self.assertEqual(counts, {"BR-1042": 52})
+
+    def test_normalizes_sku_and_trims_fields(self):
+        counts = self._read(" B-12-3 ; br-1042 ; 7 \n")
+        self.assertEqual(counts, {"BR-1042": 7})
+
+    def test_skips_blank_lines_and_strips_bom(self):
+        counts = self._read("﻿B-12-3;BR-1042;3\n\n\n")
+        self.assertEqual(counts, {"BR-1042": 3})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self._read("B-12-3;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_rejects_wrong_field_count(self):
+        with self.assertRaisesRegex(ValueError, ":1: expected bin;sku;qty"):
+            self._read("B-12-3,BR-1042,40\n")
+
+    def test_rejects_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":2: quantity is not a whole number"):
+            self._read("B-12-3;BR-1042;40\nB-12-3;WS-7;2.5\n")
+
+    def test_rejects_negative_quantity(self):
+        with self.assertRaisesRegex(ValueError, "must not be negative"):
+            self._read("B-12-3;BR-1042;-1\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
