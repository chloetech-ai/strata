diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index aef508a..7757abf 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -62,3 +62,10 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The most recent RECEIPT movement for `sku`, or None if it has never been received."""
+        for m in reversed(self.movements_for(sku)):
+            if m.reason == "RECEIPT":
+                return m
+        return None
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 5aa3ccb..020fefd 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -69,6 +69,28 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual(len(inv.movements_for(" br-1042")), 3)
         self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
 
+    def test_last_receipt_returns_most_recent_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 5, 13, datetime.date(2026, 9, 5))
+        inv.issue("BR-1042", 4, DAY)
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 5)
+        self.assertEqual(inv.last_receipt("BR-1042").unit_cost, 13)
+
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_normalizes_sku(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 12, DAY)
+        self.assertEqual(inv.last_receipt(" BR-1042 ").qty, 10)
+        self.assertIsNone(inv.last_receipt("BR-9999"))
+
 
 if __name__ == "__main__":
     unittest.main()
