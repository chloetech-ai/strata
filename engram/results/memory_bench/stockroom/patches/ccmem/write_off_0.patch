+    def test_write_off_records_damage_and_reduces_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off("BR-1042", 3, DAY)
+        self.assertEqual((m.qty, m.reason, m.date), (-3, "DAMAGE", DAY))
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_rejects_non_positive_quantity(self):
+        inv = Inventory()
+        for bad in [0, -2]:
+            with self.assertRaises(ValueError):
+                inv.write_off("BR-1042", bad, DAY)
+        self.assertEqual(inv.movements, [])
+
+    def test_write_off_does_not_refuse_when_short(self):
+        inv = Inventory()
+        inv.write_off("BR-1042", 2, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+
