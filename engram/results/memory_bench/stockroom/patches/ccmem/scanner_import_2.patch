@@ -0,0 +1,32 @@
+"""Reading the handheld scanner's count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export has no header and one line per count: `bin;sku;qty`. A SKU
+    counted in several bins (overflow bins) is summed across those lines.
+    """
+    counts = {}
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.strip()
+            if not line:
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line!r}")
+            _bin, sku, qty_text = (field.strip() for field in fields)
+            if not sku:
+                raise ValueError(f"{path}:{number}: missing SKU")
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity must be a whole number, got {qty_text!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: counted quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
