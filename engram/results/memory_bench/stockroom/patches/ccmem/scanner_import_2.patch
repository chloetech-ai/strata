index 0000000..ea0d4a7
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,62 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+def _write(d, text):
+    path = os.path.join(d, "count.txt")
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def test_reads_quantity_per_sku(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "C-03-2;BR-1042;12\nC-03-3;WS-0007;4\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 12, "WS-0007": 4})
+
+    def test_sums_overflow_bins_for_same_sku(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "C-03-2;BR-1042;12\nOVF-1;BR-1042;5\nOVF-2;BR-1042;0\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 17})
+
+    def test_normalizes_sku_and_keeps_zero_counts(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "C-03-2; br-1042 ;3\r\nC-03-3;WS-0007;0\r\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 3, "WS-0007": 0})
+
+    def test_skips_blank_lines_and_accepts_bom(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "﻿C-03-2;BR-1042;2\n\n   \nC-03-2;BR-1042;1\n")
+            self.assertEqual(read_scanner_file(path), {"BR-1042": 3})
+
+    def test_rejects_wrong_field_count_with_line_number(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "C-03-2;BR-1042;2\nBR-1042;2\n")
+            with self.assertRaisesRegex(ValueError, ":2: expected bin;sku;qty"):
+                read_scanner_file(path)
+
+    def test_rejects_non_integer_quantity(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "C-03-2;BR-1042;two\n")
+            with self.assertRaisesRegex(ValueError, ":1: quantity must be a whole number"):
+                read_scanner_file(path)
+
+    def test_rejects_negative_quantity(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "C-03-2;BR-1042;-1\n")
+            with self.assertRaisesRegex(ValueError, "must not be negative"):
+                read_scanner_file(path)
+
+    def test_rejects_missing_sku(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = _write(d, "C-03-2; ;4\n")
+            with self.assertRaisesRegex(ValueError, "missing SKU"):
+                read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
