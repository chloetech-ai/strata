+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        # BR-1: 3 * 10 - 5 = 25; BR-2: 3 * 10 - 10 = 20
+        self.assertEqual(suggest_orders(make_inventory()), {"BR-1": 25, "BR-2": 20})
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-01-4", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 4, 10)
+        # 3 * 10 - 4 = 26, rounded up to 36 (three cases of 12)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_skips_items_with_nothing_to_order(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-01-5")])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {})
+
+    def test_skips_items_with_enough_stock(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+
 if __name__ == "__main__":
     unittest.main()
