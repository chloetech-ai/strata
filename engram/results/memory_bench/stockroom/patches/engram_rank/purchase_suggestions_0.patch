diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..59e4b18 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,21 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU needing reorder to the quantity to order.
+
+    Brings stock up to three times the reorder point, rounded up to whole
+    cases because the supplier only ships full cases. SKUs with nothing to
+    order are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        short = 3 * item.reorder_point - inventory.on_hand(sku)
+        # Round up to whole cases with integer arithmetic.
+        qty = -(-short // item.case_size) * item.case_size
+        if qty > 0:
+            orders[sku] = qty
+    return orders
