@@ -0,0 +1,35 @@
+"""Inventory analysis."""
+
+from stockroom.items import normalize_sku
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value (ABC analysis).
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and walked with a running total: a SKU is 'A' while the
+    cumulative share up to and including it is at most 80% of the grand total,
+    'B' while it is at most 95%, and 'C' otherwise. Returns a dict mapping
+    normalized SKU to class. If the grand total is zero there is no share to
+    speak of, so every SKU is 'C'.
+    """
+    normalized = {}
+    for sku, value in values.items():
+        normalized[normalize_sku(sku)] = value
+
+    total = sum(normalized.values())
+    ordered = sorted(normalized.items(), key=lambda pair: (-pair[1], pair[0]))
+
+    classes = {}
+    running = 0
+    for sku, value in ordered:
+        running += value
+        if total == 0:
+            classes[sku] = "C"
+        elif running / total <= 0.80:
+            classes[sku] = "A"
+        elif running / total <= 0.95:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
