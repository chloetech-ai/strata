+++ b/tests/test_analysis.py
@@ -0,0 +1,42 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        values = {"BR-1": 50, "BR-2": 30, "BR-3": 15, "BR-4": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # BR-1 brings the cumulative share to exactly 80%, so it is still A.
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_input_order_does_not_matter(self):
+        values = {"BR-4": 5, "BR-3": 15, "BR-2": 30, "BR-1": 50}
+        self.assertEqual(abc_classes(values)["BR-1"], "A")
+        self.assertEqual(abc_classes(values)["BR-4"], "C")
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above 95%.
+        self.assertEqual(abc_classes({"BR-1": 12}), {"BR-1": "C"})
+
+    def test_zero_total_is_c(self):
+        self.assertEqual(
+            abc_classes({"BR-1": 0, "BR-2": 0}),
+            {"BR-1": "C", "BR-2": "C"},
+        )
+
+    def test_skus_are_normalized(self):
+        values = {" br-1 ": 80, "Br-2 ": 20}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "C"})
