+++ b/src/stockroom/inventory.py
@@ -49,6 +49,13 @@ class Inventory:
         return self._record(
             Movement(normalize_sku(sku), -qty, date or datetime.date.today(), None, note, "SALE"))
 
+    def write_off(self, sku, qty, date=None):
+        """Goods out that are broken or damaged, not sold."""
+        if qty <= 0:
+            raise ValueError("quantity must be positive")
+        return self._record(
+            Movement(normalize_sku(sku), -qty, date or datetime.date.today(), None, "", "DAMAGE"))
+
     def on_hand(self, sku):
         sku = normalize_sku(sku)
         return sum(m.qty for m in self.movements if m.sku == sku)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 5eaa9d8..ddfe65a 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -47,6 +47,33 @@ class InventoryTest(unittest.TestCase):
         for code in ("RETURN", "DAMAGE", "COUNT"):
             self.assertEqual(Movement("BR-1042", 1, DAY, reason=code).reason, code)
 
+    def test_write_off_records_damage(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off("BR-1042", 3, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+        self.assertEqual((m.qty, m.reason, m.date), (-3, "DAMAGE", DAY))
+        self.assertEqual(m.unit_cost, None)
+
+    def test_write_off_normalizes_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.write_off(" br-1042 ", 2, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 8)
+        self.assertEqual(inv.movements[-1].sku, "BR-1042")
+
+    def test_write_off_quantity_must_be_positive(self):
+        inv = Inventory()
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", 0, DAY)
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", -5, DAY)
+
+    def test_write_off_may_take_stock_negative(self):
+        inv = Inventory()
+        inv.write_off("BR-1042", 4, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -4)
+
     def test_movements_for(self):
