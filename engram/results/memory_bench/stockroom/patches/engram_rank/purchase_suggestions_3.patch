 """Reorder checks."""
 
+# Brandt & Sons restock up to this many times the reorder point.
+RESTOCK_MULTIPLE = 3
+
 
 def needs_reorder(inventory):
     """SKUs whose quantity on hand is at or below their reorder point."""
@@ -8,3 +11,20 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU needing reorder to the quantity to order.
+
+    The quantity brings stock up to RESTOCK_MULTIPLE times the reorder point,
+    rounded up to whole cases. SKUs that would need nothing are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        short = RESTOCK_MULTIPLE * item.reorder_point - inventory.on_hand(sku)
+        if short <= 0:
+            continue
+        cases = -(-short // item.case_size)  # ceiling division on integers
+        orders[sku] = cases * item.case_size
+    return orders
