+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_lowercase_aisle_returned_uppercase(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  B-12-3\n"), ("B", 12, 3))
+
+    def test_numbers_compare_as_integers(self):
+        self.assertEqual(parse_location("B-12-10"), ("B", 12, 10))
+
+    def test_malformed_codes_rejected(self):
+        for code in ["", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "B-12.5-3", "B-+12-3", "B-12-3 4", "B 12 3"]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
+    def test_non_string_rejected(self):
+        with self.assertRaises(ValueError):
+            parse_location(None)
+
+
 if __name__ == "__main__":
     unittest.main()
