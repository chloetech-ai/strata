+"""Reading the handheld scanners' plain-text count export."""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is `bin;sku;qty` with no header. A SKU may appear on several lines
+    (part of it in an overflow bin), so its quantities are added together.
+    Blank lines are skipped; a malformed line raises ValueError naming its line number.
+    """
+    counts = {}  # type: Dict[str, int]
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _bin, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"line {number}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity must be a whole number, got {qty.strip()!r}") from None
+            if qty < 0:
+                raise ValueError(f"line {number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
