@@ -0,0 +1,64 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self._dir.cleanup)
+
+    def _write(self, text):
+        path = os.path.join(self._dir.name, "scan.txt")
+        with open(path, "w", encoding="utf-8", newline="") as f:
+            f.write(text)
+        return path
+
+    def test_reads_quantity_per_sku(self):
+        path = self._write("A-01-1;BR-1042;12\nB-02-3;BR-2000;5\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 12, "BR-2000": 5})
+
+    def test_adds_quantities_for_sku_in_several_bins(self):
+        path = self._write("A-01-1;BR-1042;12\nOVF-1;BR-1042;4\nA-01-1;BR-2000;7\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 16, "BR-2000": 7})
+
+    def test_normalizes_sku(self):
+        path = self._write("A-01-1;br-1042;2\nOVF-1; BR-1042 ;3\nA-01-1;Br-1042;1\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 6})
+
+    def test_handles_crlf_blank_lines_and_zero_count(self):
+        path = self._write("A-01-1;BR-1042;0\r\n\r\nA-01-1;BR-2000;3\r\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 0, "BR-2000": 3})
+
+    def test_empty_file_gives_no_counts(self):
+        self.assertEqual(read_scanner_file(self._write("")), {})
+
+    def test_wrong_field_count_names_line(self):
+        path = self._write("A-01-1;BR-1042;12\nA-01-1;BR-2000\n")
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            read_scanner_file(path)
+
+    def test_non_numeric_quantity_rejected(self):
+        path = self._write("A-01-1;BR-1042;twelve\n")
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            read_scanner_file(path)
+
+    def test_negative_quantity_rejected(self):
+        path = self._write("A-01-1;BR-1042;-1\n")
+        with self.assertRaisesRegex(ValueError, "negative"):
+            read_scanner_file(path)
+
+    def test_empty_sku_rejected(self):
+        path = self._write("A-01-1; ;3\n")
+        with self.assertRaisesRegex(ValueError, "empty SKU"):
+            read_scanner_file(path)
+
+    def test_missing_file_raises_oserror(self):
+        with self.assertRaises(OSError):
+            read_scanner_file(os.path.join(self._dir.name, "missing.txt"))
+
+
+if __name__ == "__main__":
+    unittest.main()
