+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-01-4", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        # target 30, on hand 5, shortfall 25 -> 3 cases of 12
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_no_suggestion_when_stocked(self):
+        self.assertEqual(suggest_orders(make_inventory()).get("BR-3"), None)
+
+    def test_zero_reorder_point_with_no_stock_orders_nothing(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-01-5", reorder_point=0)])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
+
 
 if __name__ == "__main__":
