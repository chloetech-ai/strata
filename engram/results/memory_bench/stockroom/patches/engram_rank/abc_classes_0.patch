+"""Stock analysis."""
+
+from stockroom.items import normalize_sku
+
+
+def abc_classes(values):
+    """ABC classes for SKUs from their annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken in order of
+    value, highest first, and a SKU is 'A' if the cumulative share of the
+    grand total up to and including it is at most 80%, 'B' if at most 95%,
+    and 'C' otherwise. Returns a dict mapping SKU to class.
+    """
+    totals = {}
+    for sku, value in values.items():
+        key = normalize_sku(sku)
+        totals[key] = totals.get(key, 0) + value
+
+    grand_total = sum(totals.values())
+    ordered = sorted(totals.items(), key=lambda pair: (-pair[1], pair[0]))
+
+    classes = {}
+    running = 0
+    for sku, value in ordered:
+        running += value
+        if running <= 0.8 * grand_total:
+            classes[sku] = "A"
+        elif running <= 0.95 * grand_total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..4f9e01c
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,35 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        values = {"A1": 800, "B1": 100, "B2": 50, "C1": 50}
+        self.assertEqual(
+            abc_classes(values),
+            {"A1": "A", "B1": "B", "B2": "B", "C1": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative shares are exactly 80% and then 95%.
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_order_of_input_does_not_matter(self):
+        values = {"C1": 50, "A1": 800, "B1": 100, "B2": 50}
+        self.assertEqual(
+            abc_classes(values),
+            {"A1": "A", "B1": "B", "B2": "B", "C1": "C"},
+        )
+
+    def test_sku_keys_are_normalized(self):
+        values = {" a1 ": 800, "b1": 200}
+        self.assertEqual(abc_classes(values), {"A1": "A", "B1": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
