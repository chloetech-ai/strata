+++ b/tests/test_analysis.py
@@ -0,0 +1,33 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 80 (80%), B 15 (95%), C 5 (100%)
+        values = {"C-1": 5, "A-1": 80, "B-1": 15}
+        self.assertEqual(
+            abc_classes(values),
+            {"A-1": "A", "B-1": "B", "C-1": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        values = {"A-1": 80, "B-1": 15, "C-1": 5}
+        result = abc_classes(values)
+        self.assertEqual(result["A-1"], "A")  # exactly 80%
+        self.assertEqual(result["B-1"], "B")  # exactly 95%
+        self.assertEqual(result["C-1"], "C")
+
+    def test_just_over_boundary_drops_class(self):
+        # Sorted: 50, 40, 10. Running share: 50%, 90%, 100%.
+        # 90% > 80% so the second SKU is B, not A.
+        result = abc_classes({"X": 50, "Y": 40, "Z": 10})
+        self.assertEqual(result, {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_sku_normalized(self):
+        result = abc_classes({" br-1042": 70, "BR-2000": 30})
+        self.assertEqual(result, {"BR-1042": "A", "BR-2000": "C"})
