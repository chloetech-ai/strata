+"""Stock analysis: ABC classification of SKUs by annual consumption value."""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def abc_classes(values: Dict[str, float]) -> Dict[str, str]:
+    """Classify each SKU as 'A', 'B' or 'C' by annual consumption value.
+
+    SKUs are sorted by value, highest first, and a running total is kept.
+    A SKU is 'A' if the cumulative share up to and including it is at most
+    80% of the grand total, 'B' if at most 95%, otherwise 'C'.
+    """
+    totals = {}
+    for sku, value in values.items():
+        key = normalize_sku(sku)
+        totals[key] = totals.get(key, 0) + value
+
+    grand_total = sum(totals.values())
+    ranked = sorted(totals.items(), key=lambda pair: (-pair[1], pair[0]))
+
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.8 * grand_total:
+            classes[sku] = "A"
+        elif running <= 0.95 * grand_total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
