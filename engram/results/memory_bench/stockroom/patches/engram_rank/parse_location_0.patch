+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_lowercase_aisle_is_uppercased(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  B-12-3\t"), ("B", 12, 3))
+
+    def test_numbers_compare_as_integers(self):
+        self.assertEqual(parse_location("B-10-1"), ("B", 10, 1))
+        self.assertEqual(parse_location("B-2-10")[2], 10)
+
+    def test_invalid_codes_rejected(self):
+        for code in ["", "B-12", "B-12-3-1", "BB-12-3", "1-12-3", "B-x-3",
+                     "B-12-", "B-(-3", "B - 12-3", "B-12.5-3", "B-−12-3", "B-12-3\n-"]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
+
