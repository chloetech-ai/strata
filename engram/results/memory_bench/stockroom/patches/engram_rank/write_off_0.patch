@@ -47,6 +47,22 @@ class InventoryTest(unittest.TestCase):
         for code in ("RETURN", "DAMAGE", "COUNT"):
             self.assertEqual(Movement("BR-1042", 1, DAY, reason=code).reason, code)
 
+    def test_write_off_records_damage_and_reduces_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        movement = inv.write_off(" br-1042 ", 3, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+        self.assertEqual(movement.reason, "DAMAGE")
+        self.assertEqual(movement.sku, "BR-1042")
+        self.assertEqual(movement.qty, -3)
+
+    def test_write_off_quantity_must_be_positive(self):
+        inv = Inventory()
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", 0, DAY)
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", -2, DAY)
+
     def test_movements_for(self):
