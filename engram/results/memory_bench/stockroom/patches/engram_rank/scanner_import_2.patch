index 0000000..0d75039
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,37 @@
+"""Reading the handheld scanners' count export."""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path) -> Dict[str, int]:
+    """Counted quantity per SKU from a scanner export.
+
+    The export is semicolon-separated with no header, one `bin;sku;qty` line per
+    count. A SKU may appear on several lines (part of it in an overflow bin), so
+    the quantities for each SKU are added up. Raises ValueError, naming the line,
+    for a malformed line rather than skipping it, since a dropped line would
+    understate the count.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.rstrip("\r\n")
+            if not line.strip():
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line!r}")
+            _, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {qty!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: missing SKU")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..0ac7bb3
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,54 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_sums_quantities_per_sku(self):
+        counts = self.read("A-1-1;BR-1042;12\nA-1-2;BR-2000;5\nOVF-9-9;BR-1042;3\n")
+        self.assertEqual(counts, {"BR-1042": 15, "BR-2000": 5})
+
+    def test_normalizes_sku_case_and_spacing(self):
+        counts = self.read("A-1-1; br-1042 ;4\nA-1-2;BR-1042;1\nA-1-3;Br-1042 ;2\n")
+        self.assertEqual(counts, {"BR-1042": 7})
+
+    def test_blank_lines_are_skipped(self):
+        self.assertEqual(self.read("\nA-1-1;BR-1042;2\n\n"), {"BR-1042": 2})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self.read("A-1-1;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_empty_file(self):
+        self.assertEqual(self.read(""), {})
+
+    def test_wrong_field_count_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, ":2: expected bin;sku;qty"):
+            self.read("A-1-1;BR-1042;2\nA-1-2;BR-2000\n")
+
+    def test_non_numeric_quantity_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity is not a whole number"):
+            self.read("A-1-1;BR-1042;two\n")
+
+    def test_negative_quantity_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity must not be negative"):
+            self.read("A-1-1;BR-1042;-3\n")
+
+    def test_missing_sku_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, ":1: missing SKU"):
+            self.read("A-1-1;   ;3\n")
+
+    def test_crlf_line_endings(self):
+        self.assertEqual(self.read("A-1-1;BR-1042;2\r\nA-1-2;BR-1042;3\r\n"), {"BR-1042": 5})
+
+
+if __name__ == "__main__":
+    unittest.main()
