+    def test_last_receipt_is_most_recent_receipt_for_sku(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        first = inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 5, 13, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        inv.receive("BR-9999", 7, 99, DAY)
+        self.assertEqual(inv.last_receipt(" br-1042").qty, 5)
+        self.assertEqual(inv.last_receipt("BR-1042").unit_cost, 13)
+        self.assertIsNot(inv.last_receipt("BR-1042"), first)
+        self.assertIsNone(Inventory().last_receipt("BR-1042"))
+
+    def test_last_receipt_uses_date_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 10))
+        inv.receive("BR-1042", 4, 13, datetime.date(2026, 9, 2))  # backdated, logged later
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_last_receipt_ignores_non_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+        inv.issue("BR-1042", 2, DAY)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
