@@ -0,0 +1,64 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 125000)
+
+    def test_issues_are_costed_fifo(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 15, DAY + datetime.timedelta(days=1))  # takes all 10 at 100 and 5 at 300
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_fifo_follows_date_not_entry_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 300, DAY + datetime.timedelta(days=1))
+        inv.receive("BR-1042", 10, 100, DAY)  # recorded later but received earlier
+        inv.issue("BR-1042", 10, DAY + datetime.timedelta(days=2))
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 300)
+
+    def test_outflow_beyond_receipts_adds_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 200, DAY)
+        inv.issue("BR-1042", 8, DAY)  # stock goes to -3, which has no cost
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_outgoing_reasons_consume_layers(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.movements.append(Movement("BR-1042", -4, DAY, reason="DAMAGE"))
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100)
+
+    def test_positive_movement_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv.movements.append(Movement("BR-1042", 3, DAY, reason="RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+    def test_sku_variants_hit_the_same_stock(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 100, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 1000)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 10, 999, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+
+if __name__ == "__main__":
+    unittest.main()
