+"""Stock valuation."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each receipt starts a layer at its unit cost; each outgoing movement uses up the
+    oldest layers first, so what is left is valued at the cost of the most recent receipts.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost recorded for {sku} movement on {m.date}")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(layers[0][0], remaining)
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
