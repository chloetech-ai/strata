+    def test_last_receipt_is_most_recent_receipt_for_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 20, 13, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 20)
+        self.assertEqual(inv.last_receipt("BR-1042").unit_cost, 13)
+        self.assertEqual(inv.last_receipt(" br-2210 ").qty, 5)
+
+    def test_last_receipt_ignores_other_reasons(self):
+        from stockroom.inventory import Movement
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.movements.append(Movement("BR-1042", 2, DAY, reason="RETURN"))
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_last_receipt_none_when_no_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
 
