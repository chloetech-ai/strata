 """The item catalog."""
 
+import re
 from dataclasses import dataclass, replace
 
+_BIN_CODE = re.compile(r"([A-Za-z])-([0-9]+)-([0-9]+)")
+
 
 def normalize_sku(sku):
     """Canonical form of a SKU: surrounding whitespace removed, uppercased."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like 'B-12-3' into ('B', 12, 3).
+
+    The aisle is a single letter (returned uppercase); bay and shelf are
+    integers. Surrounding whitespace is ignored. Anything else raises ValueError.
+    """
+    match = _BIN_CODE.fullmatch(code.strip()) if isinstance(code, str) else None
+    if match is None:
+        raise ValueError(f"invalid bin code: {code!r}")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
