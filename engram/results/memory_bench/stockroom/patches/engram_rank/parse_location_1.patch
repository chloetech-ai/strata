+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code_into_numbers(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_lowercase_aisle_is_uppercased(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  C-1-10 \t"), ("C", 1, 10))
+
+    def test_bay_and_shelf_are_integers_so_they_sort_numerically(self):
+        _, bay, shelf = parse_location("A-2-10")
+        self.assertIsInstance(bay, int)
+        self.assertIsInstance(shelf, int)
+        self.assertLess(parse_location("B-2-1")[1], parse_location("B-12-1")[1])
+        self.assertLess(parse_location("B-12-2")[2], parse_location("B-12-10")[2])
+
+    def test_malformed_codes_rejected(self):
+        for code in ["", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "B-+12-3", "B-12.5-3", "B 12 3", "B-12-3 x",
+                     None, 123]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
