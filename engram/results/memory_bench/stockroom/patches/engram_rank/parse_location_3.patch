+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_aisle_is_uppercased_and_whitespace_ignored(self):
+        self.assertEqual(parse_location(" b-12-3 "), ("B", 12, 3))
+
+    def test_parts_compare_as_numbers(self):
+        self.assertEqual(parse_location("B-12-10"), ("B", 12, 10))
+        self.assertEqual(parse_location("B-012-3"), ("B", 12, 3))
+
+    def test_malformed_codes_rejected(self):
+        for code in ["", "B-12", "B-12-3-1", "BB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "-12-3", "B-+12-3", "B-12 -3", "B_12_3"]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
