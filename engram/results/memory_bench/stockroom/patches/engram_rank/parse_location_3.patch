diff --git a/src/stockroom/items.py b/src/stockroom/items.py
index 951a68e..a525119 100644
--- a/src/stockroom/items.py
+++ b/src/stockroom/items.py
@@ -1,13 +1,29 @@
 """The item catalog."""
 
+import re
 from dataclasses import dataclass, replace
 
+_BIN_CODE = re.compile(r"([A-Za-z])-([0-9]+)-([0-9]+)")
+
 
 def normalize_sku(sku):
     """Canonical form of a SKU: surrounding whitespace removed, uppercased."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like 'B-12-3' into (aisle, bay, shelf) = ('B', 12, 3).
+
+    The aisle is returned uppercased; bay and shelf are integers.
+    Raises ValueError for anything that is not a bin code.
+    """
+    match = _BIN_CODE.fullmatch(code.strip())
+    if match is None:
+        raise ValueError(f"invalid bin code {code!r}, expected like 'B-12-3'")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
