+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,39 @@
+"""Printable blind count sheet for the stock-take.
+
+The sheet lists every catalog item in walking order (by bin location) and
+deliberately omits the on-hand quantity, so counters write what they count.
+"""
+
+COUNT_WIDTH = 10
+
+
+def bin_key(location):
+    """Sort key for bin codes like "B-12-3": numeric parts compare as numbers.
+
+    A plain string sort would put "B-12-10" before "B-12-2".
+    """
+    key = []
+    for part in location.split("-"):
+        part = part.strip()
+        if part.isdecimal():
+            key.append((0, int(part), ""))
+        else:
+            key.append((1, 0, part.upper()))
+    return tuple(key)
+
+
+def count_sheet(inventory):
+    """Return the blind count sheet for `inventory`'s catalog as text.
+
+    One line per catalog item: bin location, SKU, name, unit, and an empty
+    column for the counted quantity. Ties in bin location fall back to SKU.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count")
+    items = sorted(inventory.catalog, key=lambda item: (bin_key(item.location), item.sku))
+    lines = []
+    for item in items:
+        lines.append(
+            f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  "
+            f"{'':<{COUNT_WIDTH}}")
+    return "\n".join(lines) + "\n" if lines else ""
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..73cb695
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,47 @@
+import unittest
+
+from stockroom.countsheet import bin_key, count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_lines_follow_walking_order_not_sku_order(self):
+        catalog = Catalog([
+            Item("BR-0001", "Hex bolt", "B-12-10"),
+            Item("BR-0002", "Washer", "B-12-2"),
+            Item("BR-0003", "Nut", "A-3-1"),
+        ])
+        lines = count_sheet(Inventory(catalog)).splitlines()
+        skus = [line.split()[1] for line in lines]
+        self.assertEqual(skus, ["BR-0003", "BR-0002", "BR-0001"])
+
+    def test_sheet_has_no_on_hand_quantity_and_blank_count_column(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt", "B-12-3", unit="box")])
+        inv = Inventory(catalog)
+        inv.receive("BR-1042", 77, 12)
+        sheet = count_sheet(inv)
+        self.assertNotIn("77", sheet)
+        self.assertEqual(len(sheet.splitlines()), 1)
+        self.assertTrue(sheet.rstrip("\n").endswith(" " * 10))
+
+    def test_one_line_per_catalog_item(self):
+        catalog = Catalog([
+            Item("BR-1042", "Hex bolt", "B-12-3"),
+            Item("BR-2000", "Washer", "B-12-3"),
+        ])
+        lines = count_sheet(Inventory(catalog)).splitlines()
+        self.assertEqual(len(lines), 2)
+        self.assertEqual([line.split()[1] for line in lines], ["BR-1042", "BR-2000"])
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_inventory_without_catalog_is_an_error(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+    def test_bin_key_compares_parts_numerically(self):
+        self.assertLess(bin_key("B-12-2"), bin_key("B-12-10"))
+        self.assertLess(bin_key("B-2-9"), bin_key("B-12-1"))
+        self.assertLess(bin_key("A-99-9"), bin_key("B-1-1"))
