+    def test_last_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        second = inv.receive(" br-1042", 5, 13, DAY)
+        inv.issue("BR-1042", 2, DAY)
+        self.assertIs(inv.last_receipt("br-1042"), second)
+        self.assertIsNone(inv.last_receipt("BR-9999"))
+
+    def test_last_receipt_ignores_non_receipts(self):
+        from stockroom.inventory import Movement
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.movements.append(Movement("BR-1042", 1, DAY, reason="RETURN"))
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_last_receipt_is_latest_by_date(self):
+        inv = Inventory()
+        later = inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 10))
+        inv.receive("BR-1042", 5, 13, datetime.date(2026, 9, 2))  # backdated
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
 
 if __name__ == "__main__":
