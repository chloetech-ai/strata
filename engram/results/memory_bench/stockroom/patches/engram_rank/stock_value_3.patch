+"""Stock valuation at FIFO cost."""
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed first in, first out.
+
+    Each receipt is a layer at its unit cost. Outflows consume the oldest layers
+    first. Negative stock has no layers left to cost, so any shortfall is worth zero.
+    """
+    layers = []  # [qty, unit_cost] pairs, oldest first
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for stock coming in on {m.sku}")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.pop(0)
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
