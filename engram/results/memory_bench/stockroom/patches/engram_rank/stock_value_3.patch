+++ b/tests/test_valuation.py
@@ -0,0 +1,75 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_no_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 125000)
+
+    def test_issues_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 1500, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 15, DAY + datetime.timedelta(days=1))
+        # 10 at 1000 are gone; 5 left at 1500
+        self.assertEqual(stock_value(inv, "BR-1042"), 7500)
+
+    def test_partial_layer_consumed(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6000)
+
+    def test_receipts_costed_by_date_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1500, DAY + datetime.timedelta(days=1))
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.issue("BR-1042", 10, DAY + datetime.timedelta(days=1))
+        # the older receipt at 1000 is consumed first
+        self.assertEqual(stock_value(inv, "BR-1042"), 15000)
+
+    def test_negative_stock_is_worth_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 1000, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_stock_after_negative_is_costed_from_later_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 1000, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        inv.receive("BR-1042", 10, 2000, DAY)
+        # the shortfall of 3 is not carried forward; 10 at 2000 remain
+        self.assertEqual(stock_value(inv, "BR-1042"), 20000)
+
+    def test_other_skus_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-2000", 10, 3000, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10000)
+
+    def test_sku_variants_hit_the_same_stock(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 1000, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 10000)
+
+    def test_positive_movement_without_cost_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY, None, "", "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
