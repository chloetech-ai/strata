@@ -0,0 +1,39 @@
+"""Inventory analysis."""
+
+from typing import Dict
+
+from stockroom.items import normalize_sku
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value.
+
+    Walks the SKUs from highest value to lowest, keeping a running total. A SKU
+    is 'A' while the cumulative share up to and including it is at most 80% of
+    the grand total, 'B' while it is at most 95%, and 'C' otherwise.
+    """
+    for sku, value in values.items():
+        if value < 0:
+            raise ValueError("negative value for SKU %r" % sku)
+
+    normalized = {}
+    for sku, value in values.items():
+        key = normalize_sku(sku)
+        if key in normalized:
+            raise ValueError("duplicate SKU %r" % key)
+        normalized[key] = value
+
+    total = sum(normalized.values())
+    ranked = sorted(normalized.items(), key=lambda pair: (-pair[1], pair[0]))
+
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.8 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..563af95
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,45 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 50 (50%), B 30 (80%), C 15 (95%), D 5 (100%)
+        values = {"BR-1": 15, "BR-2": 50, "BR-3": 5, "BR-4": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-2": "A", "BR-4": "A", "BR-1": "B", "BR-3": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # 80 of 100 is exactly 80% (A); 95 of 100 is exactly 95% (B)
+        self.assertEqual(
+            abc_classes({"BR-1": 80, "BR-2": 15, "BR-3": 5}),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above both thresholds
+        self.assertEqual(abc_classes({"BR-1": 7}), {"BR-1": "C"})
+
+    def test_sku_is_normalized(self):
+        self.assertEqual(
+            abc_classes({" br-1042 ": 10, "BR-2": 1}),
+            {"BR-1042": "B", "BR-2": "C"},
+        )
+
+    def test_duplicate_after_normalization_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 1, " br-1 ": 2})
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
