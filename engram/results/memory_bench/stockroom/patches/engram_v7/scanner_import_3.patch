+++ b/src/stockroom/scanner.py
@@ -0,0 +1,34 @@
+"""Importing counts from the handheld scanner export."""
+
+import csv
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is semicolon-separated with no header line and the columns
+    bin;sku;qty. A SKU may appear on several lines (overflow bins), so its
+    quantities are added together. Returns {sku: counted_qty}.
+    """
+    counts = {}  # type: Dict[str, int]
+    with open(path, newline="", encoding="utf-8") as f:
+        for line_no, row in enumerate(csv.reader(f, delimiter=";"), start=1):
+            if not any(field.strip() for field in row):
+                continue
+            if len(row) != 3:
+                raise ValueError(f"line {line_no}: expected 3 fields (bin;sku;qty), got {len(row)}")
+            _bin, sku, qty = row
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"line {line_no}: quantity is not a whole number: {qty!r}")
+            if qty < 0:
+                raise ValueError(f"line {line_no}: quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"line {line_no}: missing SKU")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
