index 0000000..18ebdd1
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,61 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self._dir.cleanup)
+
+    def write(self, text):
+        path = os.path.join(self._dir.name, "scan.txt")
+        with open(path, "w", encoding="utf-8") as f:
+            f.write(text)
+        return path
+
+    def test_counts_per_sku(self):
+        path = self.write("A-1-1;BR-1042;12\nB-2-3;HX-7;4\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 12, "HX-7": 4})
+
+    def test_sums_sku_across_bins(self):
+        path = self.write("A-1-1;BR-1042;12\nOVF-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 17})
+
+    def test_normalizes_sku_spelling(self):
+        path = self.write("A-1-1;br-1042;2\nOVF-1; BR-1042 ;3\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 5})
+
+    def test_zero_count_is_kept(self):
+        path = self.write("A-1-1;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 0})
+
+    def test_skips_blank_lines(self):
+        path = self.write("\nA-1-1;BR-1042;1\n\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 1})
+
+    def test_rejects_negative_quantity(self):
+        path = self.write("A-1-1;BR-1042;-1\n")
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            read_scanner_file(path)
+
+    def test_rejects_non_integer_quantity(self):
+        path = self.write("A-1-1;BR-1042;1.5\n")
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            read_scanner_file(path)
+
+    def test_rejects_wrong_field_count(self):
+        path = self.write("A-1-1;BR-1042\n")
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            read_scanner_file(path)
+
+    def test_rejects_missing_sku(self):
+        path = self.write("A-1-1;  ;3\n")
+        with self.assertRaisesRegex(ValueError, "missing SKU"):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
