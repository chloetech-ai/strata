+    def test_write_off_is_a_damage_movement(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off("BR-1042", 3, DAY)
+        self.assertEqual((m.qty, m.reason, m.date), (-3, "DAMAGE", DAY))
+        self.assertIsNone(m.unit_cost)
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_normalizes_sku_and_defaults_to_today(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off(" br-1042 ", 1)
+        self.assertEqual(m.sku, "BR-1042")
+        self.assertEqual(m.date, datetime.date.today())
+        self.assertEqual(inv.on_hand("BR-1042"), 9)
+
+    def test_write_off_may_take_stock_below_zero(self):
+        inv = Inventory()
+        inv.write_off("BR-1042", 4, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -4)
+
