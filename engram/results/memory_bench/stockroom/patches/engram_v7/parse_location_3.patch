             Catalog([Item("BR-1042", "Hex bolt M8x40", "C-03-2", case_size=0)])
 
 
+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_uppercases_aisle(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_ignores_surrounding_whitespace(self):
+        self.assertEqual(parse_location(" B-12-3\n"), ("B", 12, 3))
+
+    def test_rejects_malformed_codes(self):
+        for code in ("", "B-12", "BB-12-3", "1-12-3", "B-x-3", "B-12-3-4",
+                     "B 12 3", "B--3", "B-+1-3", "B-1.5-3", "B-12-"):
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
+    def test_rejects_non_string(self):
+        with self.assertRaises(ValueError):
+            parse_location(None)
+
+
 if __name__ == "__main__":
     unittest.main()
