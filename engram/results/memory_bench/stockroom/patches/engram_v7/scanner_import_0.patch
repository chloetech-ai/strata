@@ -0,0 +1,33 @@
+"""Reading the handheld scanner export.
+
+The export is plain text with no header line, one count per line, with the
+columns bin;sku;qty separated by semicolons.
+"""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path) -> Dict[str, int]:
+    """Counted quantity per SKU. A SKU on several lines (overflow bins) is summed."""
+    counts = {}  # type: Dict[str, int]
+    with open(path, newline="", encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty_text = fields
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity is not a whole number: {qty_text.strip()!r}")
+            if qty < 0:
+                raise ValueError(f"line {number}: quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"line {number}: SKU is empty")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
