index 0000000..77f7f23
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,56 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        fd, path = tempfile.mkstemp(suffix=".txt")
+        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
+            f.write(text)
+        self.addCleanup(os.remove, path)
+        return read_scanner_file(path)
+
+    def test_reads_bin_sku_qty(self):
+        counts = self.read("B-12-3;BR-1042;7\nC-03-2;HX-0009;12\n")
+        self.assertEqual(counts, {"BR-1042": 7, "HX-0009": 12})
+
+    def test_sums_a_sku_across_bins(self):
+        counts = self.read("B-12-3;BR-1042;7\nOVR-1;BR-1042;5\n")
+        self.assertEqual(counts, {"BR-1042": 12})
+
+    def test_normalizes_sku_spelling(self):
+        counts = self.read("B-12-3; br-1042 ;2\nOVR-1;Br-1042 ;3\n")
+        self.assertEqual(counts, {"BR-1042": 5})
+
+    def test_zero_quantity_is_a_counted_empty_bin(self):
+        self.assertEqual(self.read("B-12-3;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_blank_lines_and_crlf_are_ignored(self):
+        counts = self.read("B-12-3;BR-1042;7\r\n\r\n   \r\nC-03-2;HX-0009;1\r\n")
+        self.assertEqual(counts, {"BR-1042": 7, "HX-0009": 1})
+
+    def test_empty_file_gives_empty_dict(self):
+        self.assertEqual(self.read(""), {})
+
+    def test_negative_quantity_is_rejected_with_line_number(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self.read("B-12-3;BR-1042;7\nB-12-3;BR-1042;-1\n")
+
+    def test_non_integer_quantity_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("B-12-3;BR-1042;seven\n")
+
+    def test_wrong_column_count_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("B-12-3,BR-1042,7\n")
+
+    def test_empty_sku_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("B-12-3;  ;7\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
