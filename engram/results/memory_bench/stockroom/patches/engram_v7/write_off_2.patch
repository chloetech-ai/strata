diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index c78cfd3..adf1d1b 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -59,6 +59,17 @@ class Inventory:
             note=note,
         ))
 
+    def write_off(self, sku, qty, date=None):
+        """Stock that is broken or damaged, taken off the shelf."""
+        if qty <= 0:
+            raise ValueError("quantity must be positive")
+        return self._record(Movement(
+            sku=normalize_sku(sku),
+            qty=-qty,
+            date=date or datetime.date.today(),
+            reason="DAMAGE",
+        ))
+
     def on_hand(self, sku):
         sku = normalize_sku(sku)
         return sum(m.qty for m in self.movements if m.sku == sku)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 432eb30..3c24f29 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -39,6 +39,33 @@ class InventoryTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             inv.issue("BR-1042", -5)
 
+    def test_write_off_is_a_damage_movement_out_of_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        movement = inv.write_off(" br-1042 ", 3, DAY)
+        self.assertEqual(movement.reason, "DAMAGE")
+        self.assertEqual(movement.qty, -3)
+        self.assertEqual(movement.sku, "BR-1042")
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_defaults_to_today(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(inv.write_off("BR-1042", 1).date, datetime.date.today())
+
+    def test_write_off_may_take_stock_below_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 12, DAY)
+        inv.write_off("BR-1042", 5, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+
+    def test_write_off_quantity_must_be_positive(self):
+        inv = Inventory()
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", 0)
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", -2)
+
     def test_movements_for(self):
         inv = Inventory()
         inv.receive("BR-1042", 10, 12, DAY)
