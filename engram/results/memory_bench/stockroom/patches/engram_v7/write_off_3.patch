+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off(" br-1042 ", 3, DAY)
+        self.assertEqual((m.reason, m.qty, m.sku), ("DAMAGE", -3, "BR-1042"))
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_defaults_date_to_today(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off("BR-1042", 1)
+        self.assertEqual(m.date, datetime.date.today())
