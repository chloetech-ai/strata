+    def test_suggest_orders_tops_up_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 25})  # 30 wanted, 5 on hand
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})  # 25 short -> 3 cases
+
+    def test_suggest_orders_normalizes_sku(self):
+        inv = make_inventory()
+        inv.receive("  br-1 ", 2, 10)  # 7 on hand under the normalized SKU
+        self.assertEqual(suggest_orders(inv), {"BR-1": 23})
+
 
 if __name__ == "__main__":
     unittest.main()
