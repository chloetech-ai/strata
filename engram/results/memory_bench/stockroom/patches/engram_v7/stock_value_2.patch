+++ b/tests/test_valuation.py
@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_sale_takes_the_oldest_stock_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 1500, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 12, DAY + datetime.timedelta(days=2))
+        # 10 @ 1000 gone, 2 @ 1500 gone, 8 @ 1500 left
+        self.assertEqual(stock_value(inv, "BR-1042"), 12000)
+
+    def test_sales_are_costed_in_date_order_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 1000, DAY + datetime.timedelta(days=1))
+        inv.receive("BR-1042", 5, 2000, DAY)
+        inv.issue("BR-1042", 5, DAY + datetime.timedelta(days=2))
+        # the 2000 lot arrived first, so it is the one sold
+        self.assertEqual(stock_value(inv, "BR-1042"), 5000)
+
+    def test_spellings_of_the_sku_are_the_same_stock(self):
+        inv = Inventory()
+        inv.receive("br-1042", 4, 250, DAY)
+        inv.issue(" BR-1042", 1, DAY)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 750)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 250, DAY)
+        inv.receive("BR-2210", 9, 9999, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_receipt_without_cost_cannot_be_valued(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY, "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+    def test_negative_stock_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 500, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_later_receipt_first_covers_a_shortfall(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 500, DAY)
+        inv.issue("BR-1042", 3, DAY + datetime.timedelta(days=1))
+        inv.receive("BR-1042", 5, 700, DAY + datetime.timedelta(days=2))
+        # one unit of the 5 makes up the shortfall, leaving 4 on hand
+        self.assertEqual(inv.on_hand("BR-1042"), 4)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2800)
+
+
+if __name__ == "__main__":
+    unittest.main()
