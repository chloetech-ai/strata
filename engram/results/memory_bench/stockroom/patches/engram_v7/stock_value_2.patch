+"""What the stock on hand is worth."""
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each receipt is a lot at its unit cost. Sales and other outgoing
+    movements use up the oldest lots first, and the value is what the
+    units still on the shelf cost. Stock can go negative; a shortfall is
+    carried against later receipts, which fill it before they add stock.
+    """
+    lots = []  # [qty, unit_cost] pairs, oldest first
+    short = 0  # units out beyond the lots we hold
+    for movement in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if movement.qty > 0:
+            if movement.unit_cost is None:
+                raise ValueError(f"no unit cost for {movement.reason} of {sku}")
+            covered = min(movement.qty, short)
+            short -= covered
+            if movement.qty > covered:
+                lots.append([movement.qty - covered, movement.unit_cost])
+            continue
+        remaining = -movement.qty
+        while remaining and lots:
+            take = min(remaining, lots[0][0])
+            lots[0][0] -= take
+            remaining -= take
+            if lots[0][0] == 0:
+                lots.pop(0)
+        short += remaining
+    return sum(qty * unit_cost for qty, unit_cost in lots)
