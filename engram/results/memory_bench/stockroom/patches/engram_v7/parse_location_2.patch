diff --git a/src/stockroom/items.py b/src/stockroom/items.py
index edc9e66..f254e62 100644
--- a/src/stockroom/items.py
+++ b/src/stockroom/items.py
@@ -1,13 +1,29 @@
 """The item catalog."""
 
+import re
 from dataclasses import dataclass, replace
 
+_BIN_CODE = re.compile(r"\s*([A-Za-z])-([0-9]+)-([0-9]+)\s*")
+
 
 def normalize_sku(sku):
     """Canonical form of a SKU: surrounding whitespace trimmed, uppercased."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like 'B-12-3' into (aisle, bay, shelf).
+
+    The aisle is a single letter, returned uppercase; bay and shelf are integers.
+    Surrounding whitespace is ignored. Anything else raises ValueError.
+    """
+    match = _BIN_CODE.fullmatch(code) if isinstance(code, str) else None
+    if match is None:
+        raise ValueError(f"invalid bin code: {code!r}")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
