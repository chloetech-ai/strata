@@ -0,0 +1,31 @@
+"""Inventory analysis."""
+
+from typing import Dict
+
+
+def abc_classes(values: Dict[str, float]) -> Dict[str, str]:
+    """Classify SKUs A, B or C by annual consumption value.
+
+    Walks the SKUs from highest value to lowest, keeping a running total. A SKU
+    is 'A' while the cumulative share up to and including it is at most 80% of
+    the grand total, 'B' while it is at most 95%, and 'C' otherwise.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    if total <= 0:
+        raise ValueError(f"total consumption value must be positive, got {total}")
+
+    # Compare with integer multipliers (80% = 4/5, 95% = 19/20) so the
+    # boundaries are exact rather than subject to float rounding.
+    classes = {}
+    cumulative = 0
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        cumulative += value
+        if cumulative * 5 <= total * 4:
+            classes[sku] = "A"
+        elif cumulative * 20 <= total * 19:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..3393af0
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,40 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 50 (50%), B 30 (80%), C 15 (95%), D 5 (100%)
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        # The first SKU reaches exactly 80% and the second exactly 95%.
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, above both the 80% and 95% cut-offs.
+        self.assertEqual(abc_classes({"ONLY": 10}), {"ONLY": "C"})
+
+    def test_input_order_does_not_matter(self):
+        values = {"C": 15, "A": 50, "D": 5, "B": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_zero_total_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"A": 0, "B": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
