+++ b/src/stockroom/analysis.py
@@ -0,0 +1,30 @@
+"""ABC analysis of SKUs by annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to class 'A', 'B' or 'C' by cumulative share of total value.
+
+    SKUs are taken highest value first. A SKU is 'A' if the cumulative share
+    up to and including it is at most 80%, 'B' if at most 95%, otherwise 'C'.
+    """
+    if not values:
+        return {}
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    if total == 0:
+        raise ValueError("total consumption value must be greater than zero")
+
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        share = running / total
+        if share <= 0.80:
+            out[sku] = "A"
+        elif share <= 0.95:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..8a7c99d
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,40 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: 50 (50%), 30 (80%), 15 (95%), 5 (100%)
+        values = {"BR-1": 5, "BR-2": 30, "BR-3": 15, "BR-4": 50}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-4": "A", "BR-2": "A", "BR-3": "B", "BR-1": "C"},
+        )
+
+    def test_boundary_at_80_and_95_percent_is_inclusive(self):
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_single_sku_over_80_percent_is_b_not_a(self):
+        values = {"BIG": 90, "SMALL": 10}
+        self.assertEqual(abc_classes(values), {"BIG": "B", "SMALL": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        values = {"BR-2": 10, "BR-1": 10}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "C"})
+
+    def test_zero_total_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 0, "BR-2": 0})
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
