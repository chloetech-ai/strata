@@ -0,0 +1,31 @@
+"""What the stock on hand is worth."""
+
+import collections
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed FIFO.
+
+    Each receipt is a layer at its unit cost. Goods out use up the oldest
+    layers first. Movements are taken in date order, ties in log order.
+    Goods out beyond the receipts on record have no layer to take from and
+    add nothing to the value.
+    """
+    sku = normalize_sku(sku)
+    layers = collections.deque()  # [qty, unit_cost], oldest first
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"receipt of {m.qty} {sku} on {m.date} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..ef4de3c
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,67 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt_is_quantity_times_unit_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_issues_take_the_oldest_stock_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 12, DAY + datetime.timedelta(days=2))
+        # 10 @ 100 and 2 @ 300 are gone, 8 @ 300 are left
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 300)
+
+    def test_partial_layer_is_costed_at_its_own_price(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 100 + 10 * 300)
+
+    def test_fifo_is_by_date_not_by_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 300, DAY + datetime.timedelta(days=5))
+        inv.receive("BR-1042", 10, 100, DAY)  # logged later, but older
+        inv.issue("BR-1042", 10, DAY + datetime.timedelta(days=6))
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 300)
+
+    def test_issue_beyond_receipts_adds_no_negative_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 250, DAY)
+        self.assertEqual(stock_value(inv, " br-1042 "), 1000)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 250, DAY)
+        inv.receive("BR-2000", 9, 999, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_receipt_without_unit_cost_is_an_error(self):
+        inv = Inventory()
+        inv.movements.append(Movement(sku="BR-1042", qty=3, date=DAY, reason="RECEIPT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
