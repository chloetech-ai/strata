+"""What the stock on hand is worth."""
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed first in, first out.
+
+    Each positive movement adds a layer at its unit cost. Each negative
+    movement takes goods from the oldest layers first. Movements are
+    ordered by date; movements on the same day keep their logged order.
+    """
+    sku = normalize_sku(sku)
+    moves = sorted(
+        (m for m in inventory.movements if m.sku == sku),
+        key=lambda m: m.date,
+    )
+    layers = []  # [qty, unit_cost] pairs, oldest first
+    for m in moves:
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{sku} movement of {m.qty} on {m.date} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                taken = min(remaining, layers[0][0])
+                layers[0][0] -= taken
+                remaining -= taken
+                if layers[0][0] == 0:
+                    layers.pop(0)
+    return sum(qty * unit_cost for qty, unit_cost in layers)
