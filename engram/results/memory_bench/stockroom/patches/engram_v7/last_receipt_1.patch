diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index c78cfd3..16a790e 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -66,3 +66,11 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The most recently logged receipt for `sku`, or None if there is none."""
+        sku = normalize_sku(sku)
+        for m in reversed(self.movements):
+            if m.sku == sku and m.reason == "RECEIPT":
+                return m
+        return None
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 432eb30..1b04620 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -56,6 +56,23 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual([m.qty for m in inv.movements_for(" br-1042")], [10, -3, 5])
         self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
 
+    def test_last_receipt_is_the_latest_receipt_for_the_sku(self):
+        inv = Inventory()
+        first = inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), first)
+        second = inv.receive(" br-1042 ", 6, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+        self.assertIs(inv.last_receipt("br-2210").qty, 5)
+
+    def test_last_receipt_is_none_without_a_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
 
 if __name__ == "__main__":
     unittest.main()
