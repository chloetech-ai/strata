diff --git a/src/stockroom/countsheet.py b/src/stockroom/countsheet.py
new file mode 100644
index 0000000..1c2edd7
--- /dev/null
+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,26 @@
+"""Printable blind count sheet for a stock-take."""
+
+
+def _walk_key(item):
+    """Sort bin codes like "B-12-3" by their numeric parts, so B-2-1 comes before B-12-3."""
+    key = []
+    for part in item.location.split("-"):
+        if part.isdigit():
+            key.append((0, int(part), ""))
+        else:
+            key.append((1, 0, part))
+    return key + [item.sku]
+
+
+def count_sheet(inventory):
+    """One line per catalog item in walking order, with no on-hand quantity.
+
+    The last column is blank so the counter writes what they counted.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to build a count sheet from")
+    items = sorted(inventory.catalog, key=_walk_key)
+    return "\n".join(
+        f"{item.location:<10}{item.sku:<12}{item.name:<30}{item.unit:<6}____________"
+        for item in items
+    )
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..cb7eafc
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,48 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_walking_order(self):
+        catalog = Catalog([
+            Item("BR-1", "Bolt", "B-12-3"),
+            Item("BR-2", "Nut", "B-2-1"),
+            Item("BR-3", "Washer", "A-9-9"),
+        ])
+        lines = count_sheet(Inventory(catalog)).split("\n")
+        self.assertEqual([line[:10].strip() for line in lines], ["A-9-9", "B-2-1", "B-12-3"])
+
+    def test_sorts_by_location_not_sku(self):
+        catalog = Catalog([
+            Item("BR-1", "Bolt", "C-1-1"),
+            Item("BR-9", "Nut", "A-1-1"),
+        ])
+        lines = count_sheet(Inventory(catalog)).split("\n")
+        self.assertIn("BR-9", lines[0])
+        self.assertIn("BR-1", lines[1])
+
+    def test_blind_count_shows_no_on_hand_quantity(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-1-1")])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 42, 10)
+        sheet = count_sheet(inv)
+        self.assertNotIn("42", sheet)
+        self.assertTrue(sheet.endswith("____________"))
+
+    def test_lists_items_with_no_movements(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-1-1")])
+        self.assertEqual(len(count_sheet(Inventory(catalog)).split("\n")), 1)
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_requires_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
