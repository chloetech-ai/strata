@@ -0,0 +1,33 @@
+"""What the stock on hand is worth, costed first-in first-out."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Each receipt opens a layer at its unit cost. Each outgoing movement
+    consumes the oldest layers first; what is left is on hand. Outgoing
+    quantity beyond the layers is a shortfall (stock went negative); the
+    next receipts cover it before adding any value.
+    """
+    layers = deque()  # [qty, unit_cost in cents], oldest first
+    shortfall = 0
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{m.reason} of {m.sku} has no unit cost")
+            covered = min(m.qty, shortfall)
+            shortfall -= covered
+            if m.qty > covered:
+                layers.append([m.qty - covered, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+        shortfall += remaining
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..8b692d4
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,72 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_sales_are_costed_from_the_oldest_receipt_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 1500, DAY)
+        inv.issue("BR-1042", 12, DAY)
+        # 10 at 1000 consumed, 2 at 1500 consumed: 8 left at 1500
+        self.assertEqual(stock_value(inv, "BR-1042"), 12000)
+
+    def test_differs_from_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 1500, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        # FIFO leaves 10 at 1500; average cost would give 10 at 1250
+        self.assertEqual(stock_value(inv, "BR-1042"), 15000)
+
+    def test_sale_spanning_layers_then_later_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        inv.receive("BR-1042", 4, 200, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        # 2 at 100 left after first sale; second sale takes those 2 and 2 of the 4 at 200
+        self.assertEqual(stock_value(inv, "BR-1042"), 400)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 500, DAY)
+        self.assertEqual(stock_value(inv, " br-1042 "), 1000)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 500, DAY)
+        inv.receive("BR-9999", 7, 900, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_oversold_quantity_is_covered_by_the_next_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 500, DAY)
+        inv.issue("BR-1042", 5, DAY)  # on hand is -3
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+        inv.receive("BR-1042", 4, 700, DAY)  # on hand is 1
+        self.assertEqual(inv.on_hand("BR-1042"), 1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 700)
+
+    def test_positive_movement_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY, "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
