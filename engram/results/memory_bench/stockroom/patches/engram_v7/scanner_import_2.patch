index 0000000..f959719
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,33 @@
+"""Importer for the handheld scanner export.
+
+The export is a plain-text file with no header line and semicolon-separated
+columns: bin;sku;qty. A SKU can appear on several lines (for example when part
+of it sits in an overflow bin), so its quantities are added together.
+"""
+
+import csv
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Return the counted quantity per normalized SKU, summed over all bins."""
+    counts = {}
+    with open(path, newline="", encoding="utf-8") as f:
+        for line_no, row in enumerate(csv.reader(f, delimiter=";"), start=1):
+            if not any(field.strip() for field in row):
+                continue
+            if len(row) != 3:
+                raise ValueError(f"{path}:{line_no}: expected bin;sku;qty, got {len(row)} fields")
+            _bin, sku, qty = row
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{line_no}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{line_no}: quantity is not a whole number: {qty!r}")
+            if qty < 0:
+                raise ValueError(f"{path}:{line_no}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..e57bc4a
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,54 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def write(self, text):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        path = Path(directory.name) / "scan.txt"
+        path.write_text(text, encoding="utf-8")
+        return path
+
+    def test_sums_a_sku_across_bins(self):
+        path = self.write("B-12-3;BR-1042;4\nOVF-1-1;BR-1042;6\nB-12-3;NL-200;2\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 10, "NL-200": 2})
+
+    def test_normalizes_sku_spelling(self):
+        path = self.write("B-12-3;br-1042;4\nB-12-4; BR-1042 ;1\nB-12-5;Br-1042 ;2\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 7})
+
+    def test_zero_quantity_is_kept(self):
+        path = self.write("B-12-3;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 0})
+
+    def test_skips_blank_lines(self):
+        path = self.write("\nB-12-3;BR-1042;4\n\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 4})
+
+    def test_rejects_wrong_field_count(self):
+        path = self.write("B-12-3;BR-1042\n")
+        with self.assertRaisesRegex(ValueError, ":1: expected bin;sku;qty"):
+            read_scanner_file(path)
+
+    def test_rejects_non_whole_quantity(self):
+        path = self.write("B-12-3;BR-1042;1.5\n")
+        with self.assertRaisesRegex(ValueError, "not a whole number"):
+            read_scanner_file(path)
+
+    def test_rejects_negative_quantity(self):
+        path = self.write("B-12-3;BR-1042;-2\n")
+        with self.assertRaisesRegex(ValueError, "must not be negative"):
+            read_scanner_file(path)
+
+    def test_rejects_empty_sku(self):
+        path = self.write("B-12-3;  ;4\n")
+        with self.assertRaisesRegex(ValueError, "empty SKU"):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
