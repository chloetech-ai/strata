+"""Stock analysis."""
+
+from typing import Dict
+
+
+def abc_classes(values: Dict[str, float]) -> Dict[str, str]:
+    """Classify SKUs A, B or C by annual consumption value.
+
+    SKUs are taken highest value first. A SKU is 'A' while the cumulative
+    share of the grand total, up to and including it, is at most 80%; 'B'
+    while it is at most 95%; otherwise 'C'. Ties in value are ordered by SKU
+    so the result is deterministic. If every value is zero there is no
+    consumption to share out, so every SKU is 'C'.
+    """
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda pair: (-pair[1], pair[0])):
+        running += value
+        # Compare cross-multiplied to avoid dividing by the total.
+        if total > 0 and running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif total > 0 and running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..6d27ea3
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,46 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        values = {"BR-1": 50, "BR-2": 30, "BR-3": 15, "BR-4": 4, "BR-5": 1}
+        # Running shares: 50%, 80%, 95%, 99%, 100%
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C", "BR-5": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Running shares hit exactly 80% and 95%.
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "B", "BR-3": "C"})
+
+    def test_sorts_by_value_not_by_sku(self):
+        values = {"BR-1": 10, "BR-2": 70, "BR-3": 20}
+        # Highest first: BR-2 70%, BR-3 90%, BR-1 100%
+        self.assertEqual(abc_classes(values), {"BR-2": "A", "BR-3": "B", "BR-1": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        values = {"BR-2": 10, "BR-1": 10, "BR-3": 10}
+        # Shares: BR-1 33.3%, BR-2 66.7%, BR-3 100%
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "A", "BR-3": "C"})
+
+    def test_zero_value_skus_are_c(self):
+        values = {"BR-1": 80, "BR-2": 20, "BR-3": 0}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "C", "BR-3": "C"})
+
+    def test_all_zero_values_are_c(self):
+        self.assertEqual(abc_classes({"BR-1": 0, "BR-2": 0}), {"BR-1": "C", "BR-2": "C"})
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
