+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,26 @@
+"""Printable blind count sheet for the stock-take."""
+
+
+def _walk_key(item):
+    """Order bin codes like 'B-2-1' before 'B-12-3', then break ties by SKU."""
+    parts = []
+    for part in item.location.split("-"):
+        if part.isdecimal():
+            parts.append((0, int(part), ""))
+        else:
+            parts.append((1, 0, part))
+    return parts, item.sku
+
+
+def count_sheet(inventory):
+    """The blind count sheet: one line per catalog item, in bin walking order.
+
+    No system on-hand quantity is printed, so counters count rather than copy it.
+    The COUNTED column is left empty for them to write in.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to print a count sheet from")
+    lines = [f"{'BIN':<10}  {'SKU':<12}  {'ITEM':<30}  {'UNIT':<5}  COUNTED"]
+    for item in sorted(inventory.catalog, key=_walk_key):
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}")
+    return "\n".join(line.rstrip() for line in lines) + "\n"
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..5a7b172
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,51 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def _sheet_rows(text):
+    return text.splitlines()[1:]  # skip the header line
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_catalog_item_after_header(self):
+        inventory = Inventory(Catalog([
+            Item("BR-1042", "Hex bolt M8x40", "C-03-2"),
+            Item("BR-2001", "Washer M8", "A-01-1"),
+        ]))
+        lines = count_sheet(inventory).splitlines()
+        self.assertEqual(len(lines), 3)
+        self.assertTrue(lines[0].startswith("BIN"))
+
+    def test_lines_in_bin_walking_order_not_sku_order(self):
+        inventory = Inventory(Catalog([
+            Item("AA-0001", "Shelf item", "B-12-3"),
+            Item("ZZ-9999", "Bay two", "B-2-1"),
+            Item("MM-5000", "Aisle A", "A-10-1"),
+            Item("BB-0002", "Bay ten", "B-2-10"),
+        ]))
+        bins = [row.split()[0] for row in _sheet_rows(count_sheet(inventory))]
+        self.assertEqual(bins, ["A-10-1", "B-2-1", "B-2-10", "B-12-3"])
+
+    def test_no_on_hand_quantity_shown(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt M8x40", "C-03-2")])
+        inventory = Inventory(catalog)
+        inventory.receive("BR-1042", 7319, 125)
+        sheet = count_sheet(inventory)
+        self.assertNotIn("7319", sheet)
+
+    def test_counted_column_left_empty(self):
+        inventory = Inventory(Catalog([Item("BR-1042", "Hex bolt M8x40", "C-03-2", unit="pcs")]))
+        (row,) = _sheet_rows(count_sheet(inventory))
+        self.assertEqual(row.split(), ["C-03-2", "BR-1042", "Hex", "bolt", "M8x40", "pcs"])
+        self.assertEqual(row, row.rstrip())  # nothing written after the empty COUNTED column
+
+    def test_requires_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
