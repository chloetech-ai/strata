+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders["BR-1"], 25)  # 30 wanted, 5 on hand
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 4, 10)
+        # 30 wanted, 4 on hand -> 26 short -> 3 cases of 12
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_no_suggestion_when_stock_is_sufficient(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_skips_items_not_needing_reorder(self):
+        self.assertEqual(set(suggest_orders(make_inventory())), {"BR-1"})
+
+
 if __name__ == "__main__":
     unittest.main()
