diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index c78cfd3..dc7e570 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -66,3 +66,13 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The most recent RECEIPT for `sku` by date, or None.
+
+        Ties on date go to the movement logged last.
+        """
+        sku = normalize_sku(sku)
+        receipts = [m for m in reversed(self.movements)
+                    if m.sku == sku and m.reason == "RECEIPT"]
+        return max(receipts, key=lambda m: m.date, default=None)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 432eb30..1a18e0a 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -56,6 +56,32 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual([m.qty for m in inv.movements_for(" br-1042")], [10, -3, 5])
         self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
 
+    def test_last_receipt_is_none_without_a_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_is_the_latest_by_date(self):
+        inv = Inventory()
+        newer = inv.receive("BR-1042", 10, 12, DAY + datetime.timedelta(days=5))
+        inv.receive("BR-1042", 4, 12, DAY)
+        inv.issue("BR-1042", 2, DAY + datetime.timedelta(days=9))
+        self.assertIs(inv.last_receipt("BR-1042"), newer)
+
+    def test_last_receipt_ties_go_to_the_movement_logged_last(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        later = inv.receive("BR-1042", 5, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
+    def test_last_receipt_ignores_other_skus_and_spellings(self):
+        inv = Inventory()
+        inv.receive("BR-2210", 5, 30, DAY + datetime.timedelta(days=1))
+        mine = inv.receive(" br-1042 ", 3, 12, DAY)
+        self.assertIs(inv.last_receipt("Br-1042"), mine)
+        self.assertIsNone(inv.last_receipt("BR-9999"))
+
 
 if __name__ == "__main__":
     unittest.main()
