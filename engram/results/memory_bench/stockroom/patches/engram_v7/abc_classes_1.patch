+from typing import Dict, Mapping
+
+
+def abc_classes(values: Mapping[str, float]) -> Dict[str, str]:
+    """Classify SKUs as A, B or C by cumulative share of annual consumption value.
+
+    SKUs are taken highest value first. A SKU is 'A' while the running total,
+    including that SKU, is at most 80% of the grand total, 'B' while it is at
+    most 95%, and 'C' otherwise.
+    """
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+
+    total = sum(values.values())
+    ordered = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+
+    classes = {}
+    cumulative = 0
+    for sku, value in ordered:
+        cumulative += value
+        if cumulative <= 0.8 * total:
+            classes[sku] = "A"
+        elif cumulative <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
