+++ b/tests/test_analysis.py
@@ -0,0 +1,38 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input_gives_empty_dict(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_follow_cumulative_share_highest_first(self):
+        values = {"C-SKU": 5, "A-SKU": 50, "B-SKU": 15, "D-SKU": 30}
+        # Sorted: A-SKU 50 (50%), D-SKU 30 (80%), B-SKU 15 (95%), C-SKU 5 (100%)
+        self.assertEqual(
+            abc_classes(values),
+            {"A-SKU": "A", "D-SKU": "A", "B-SKU": "B", "C-SKU": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        # 80 is exactly 80% of 100, so it stays A; 15 brings the total to exactly 95%, so B.
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_last_sku_is_always_c(self):
+        # The running total reaches 100% on the last SKU, which is above 95%, so it is C.
+        self.assertEqual(abc_classes({"BR-1042": 900}), {"BR-1042": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        values = {"B": 10, "A": 10, "C": 10}
+        # Order A, B, C: cumulative 1/3 and 2/3 are A; 3/3 is C.
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "A", "C": "C"})
+
+    def test_negative_value_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1042": 10, "BR-2000": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
