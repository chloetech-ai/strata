diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index c78cfd3..045f71c 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -66,3 +66,16 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku) -> Optional[Movement]:
+        """The most recent RECEIPT for `sku` by date, or None.
+
+        On a tie in date the movement logged last wins.
+        """
+        sku = normalize_sku(sku)
+        latest = None
+        for m in self.movements:
+            if m.sku == sku and m.reason == "RECEIPT":
+                if latest is None or m.date >= latest.date:
+                    latest = m
+        return latest
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 432eb30..adc32ff 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -56,6 +56,33 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual([m.qty for m in inv.movements_for(" br-1042")], [10, -3, 5])
         self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
 
+    def test_last_receipt_is_none_without_a_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_is_the_latest_receipt_by_date(self):
+        inv = Inventory()
+        newest = datetime.date(2026, 9, 10)
+        inv.receive("BR-1042", 10, 12, newest)
+        inv.receive("BR-1042", 20, 13, DAY)  # logged later but dated earlier
+        inv.issue("BR-1042", 3, newest)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_last_receipt_breaks_date_ties_by_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 5, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
+    def test_last_receipt_accepts_any_sku_spelling(self):
+        inv = Inventory()
+        receipt = inv.receive("BR-1042", 10, 12, DAY)
+        self.assertIs(inv.last_receipt(" br-1042 "), receipt)
+        self.assertIsNone(inv.last_receipt("BR-9999"))
+
 
 if __name__ == "__main__":
     unittest.main()
