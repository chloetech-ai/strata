diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 8ee0db4..db470bf 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -56,3 +56,10 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """Latest RECEIPT for `sku` by date, or None. Ties go to the later log entry."""
+        receipts = [m for m in self.movements_for(sku) if m.reason == "RECEIPT"]
+        if not receipts:
+            return None
+        return max(reversed(receipts), key=lambda m: m.date)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37a99e3..cbe908b 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -55,6 +55,22 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual([m.sku for m in inv.movements], ["BR-1042"] * 3)
         self.assertEqual(len(inv.movements_for(" br-1042")), 3)
 
+    def test_last_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        first = inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), first)
+        later = inv.receive("br-1042 ", 5, 13, DAY + datetime.timedelta(days=1))
+        self.assertIs(inv.last_receipt(" BR-1042"), later)
+        self.assertIsNone(inv.last_receipt("BR-9999"))
+
+    def test_last_receipt_uses_date_not_log_order(self):
+        inv = Inventory()
+        newer = inv.receive("BR-1042", 5, 13, DAY + datetime.timedelta(days=1))
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), newer)
+
 
 if __name__ == "__main__":
     unittest.main()
