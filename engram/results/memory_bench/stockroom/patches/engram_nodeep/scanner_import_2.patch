index 0000000..6736a88
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,23 @@
+"""Reading the handheld scanners' plain-text export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is semicolon-separated with no header line and columns bin;sku;qty.
+    A SKU can appear on several lines (overflow bins), so its quantities are summed.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _bin, sku, qty = fields
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + int(qty)
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..8a33ef2
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,43 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def write(self, text):
+        fd, path = tempfile.mkstemp(suffix=".txt")
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write(text)
+        self.addCleanup(os.remove, path)
+        return path
+
+    def test_sums_quantities_for_a_sku_across_bins(self):
+        path = self.write("A-1-1;BR-1042;5\nOVERFLOW;BR-1042;3\nA-1-2;XY-9;7\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 8, "XY-9": 7})
+
+    def test_normalizes_sku_case_and_spaces(self):
+        path = self.write("A-1-1; br-1042 ;2\nOVERFLOW;BR-1042 ;4\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 6})
+
+    def test_skips_blank_lines_and_handles_crlf(self):
+        path = self.write("A-1-1;BR-1042;5\r\n\r\nA-1-2;XY-9;1\r\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 5, "XY-9": 1})
+
+    def test_empty_file_gives_empty_dict(self):
+        self.assertEqual(read_scanner_file(self.write("")), {})
+
+    def test_wrong_field_count_names_the_line(self):
+        path = self.write("A-1-1;BR-1042;5\nA-1-2;XY-9\n")
+        with self.assertRaisesRegex(ValueError, ":2: expected bin;sku;qty"):
+            read_scanner_file(path)
+
+    def test_non_integer_quantity_raises(self):
+        path = self.write("A-1-1;BR-1042;five\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
