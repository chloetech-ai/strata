+++ b/tests/test_analysis.py
@@ -0,0 +1,25 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_classes_by_cumulative_share(self):
+        # Sorted: 50 (50%), 30 (80%), 15 (95%), 5 (100%)
+        values = {"W": 5, "X": 50, "Y": 30, "Z": 15}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "A", "Z": "B", "W": "C"})
+
+    def test_boundaries_are_inclusive(self):
+        values = {"P": 80, "Q": 15, "R": 5}
+        self.assertEqual(abc_classes(values), {"P": "A", "Q": "B", "R": "C"})
+
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_rejects_negative_value(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
