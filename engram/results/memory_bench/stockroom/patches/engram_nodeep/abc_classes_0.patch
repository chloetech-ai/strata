+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken from
+    highest to lowest value (ties keep their input order). A SKU is 'A' if
+    the cumulative share of the grand total up to and including it is at
+    most 80%, 'B' if at most 95%, and 'C' otherwise.
+    """
+    for value in values.values():
+        if value < 0:
+            raise ValueError("consumption value cannot be negative")
+
+    total = sum(values.values())
+    running = 0
+    classes = {}
+    ranked = sorted(values.items(), key=lambda pair: pair[1], reverse=True)
+    for sku, value in ranked:
+        running += value
+        if running <= 0.8 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
