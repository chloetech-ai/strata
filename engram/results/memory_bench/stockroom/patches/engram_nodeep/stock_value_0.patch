@@ -0,0 +1,56 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_values_stock_on_hand_at_receipt_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_costs_goods_out_first_in_first_out(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 15, DAY)
+        # 5 left at 300 from the second receipt; the first 10 at 100 are gone.
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_partial_layer_consumed_by_several_issues(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 6, 200, DAY)
+        inv.receive("BR-1042", 6, 500, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        # The second issue takes the last 2 from the first layer and 2 from the
+        # second, leaving 4 at 500.
+        self.assertEqual(stock_value(inv, "BR-1042"), 4 * 500)
+
+    def test_other_skus_are_not_counted(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-9999", 10, 700, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 150, DAY)
+        self.assertEqual(stock_value(inv, " br-1042 "), 450)
+
+    def test_incoming_stock_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv.movements.append(Movement("BR-1042", 5, DAY, "COUNT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
