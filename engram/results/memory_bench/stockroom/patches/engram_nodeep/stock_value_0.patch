+"""Stock valuation at FIFO cost."""
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed first in, first out.
+
+    Receipts form cost layers in log order; each goods-out movement uses up the
+    oldest layers first. Raises ValueError if stock coming in has no unit cost.
+    """
+    sku = normalize_sku(sku)
+    layers = []  # [qty_left, unit_cost], oldest first
+    for movement in inventory.movements_for(sku):
+        if movement.qty > 0:
+            if movement.unit_cost is None:
+                raise ValueError(f"{sku}: incoming stock has no unit cost, cannot be valued")
+            layers.append([movement.qty, movement.unit_cost])
+            continue
+        remaining = -movement.qty
+        while remaining and layers:
+            taken = min(remaining, layers[0][0])
+            layers[0][0] -= taken
+            remaining -= taken
+            if layers[0][0] == 0:
+                layers.pop(0)
+    return sum(qty * unit_cost for qty, unit_cost in layers)
