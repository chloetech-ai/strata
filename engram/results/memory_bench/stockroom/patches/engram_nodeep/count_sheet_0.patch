+"""Printable blind count sheet for the stock-take."""
+
+
+def count_sheet(inventory):
+    """The count sheet as text, one line per catalog item in walking order.
+
+    Lines are sorted by bin location so staff can count along the shelves.
+    The system's quantity on hand is deliberately left off: this is a blind
+    count, and the last column is blank for the counted quantity.
+    """
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    lines = []
+    for item in items:
+        lines.append(
+            "{:<10} {:<12} {:<30} {:<5} {}".format(
+                item.location, item.sku, item.name, item.unit, "_" * 8
+            )
+        )
+    return "\n".join(lines)
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
