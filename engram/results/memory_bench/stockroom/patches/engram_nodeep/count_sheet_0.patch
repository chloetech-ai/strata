@@ -0,0 +1,39 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-2", "Nut", "B-12-3", unit="pcs"),
+        Item("BR-1", "Bolt", "A-01-1", unit="pcs"),
+        Item("BR-3", "Washer", "B-12-1", unit="pcs"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1", 5, 10)
+    inv.receive("BR-2", 99, 10)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_walking_order(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+        self.assertTrue(lines[0].startswith("A-01-1"))
+        self.assertTrue(lines[1].startswith("B-12-1"))
+        self.assertTrue(lines[2].startswith("B-12-3"))
+
+    def test_does_not_show_quantity_on_hand(self):
+        text = count_sheet(make_inventory())
+        self.assertNotIn("99", text)
+        self.assertNotIn(" 5 ", text)
+
+    def test_blank_count_column(self):
+        for line in count_sheet(make_inventory()).splitlines():
+            self.assertTrue(line.endswith("_" * 8))
+
+
+if __name__ == "__main__":
+    unittest.main()
