diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 8ee0db4..4d4ec79 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -56,3 +56,11 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """Latest RECEIPT for `sku` by date, or None. On the same date the later log entry wins."""
+        receipts = [m for m in self.movements_for(sku) if m.reason == "RECEIPT"]
+        if not receipts:
+            return None
+        # max() returns the first maximal item, so scan in reverse to prefer the later log entry.
+        return max(reversed(receipts), key=lambda m: m.date)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37a99e3..293a530 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -55,6 +55,32 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual([m.sku for m in inv.movements], ["BR-1042"] * 3)
         self.assertEqual(len(inv.movements_for(" br-1042")), 3)
 
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.issue("BR-1042", 1, DAY)  # no stock to issue, but the log entry still counts
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_returns_latest_by_date(self):
+        inv = Inventory()
+        later = inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 5))
+        inv.receive("BR-1042", 4, 11, datetime.date(2026, 9, 2))  # back-dated entry
+        inv.issue("BR-1042", 3, datetime.date(2026, 9, 9))
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
+    def test_last_receipt_prefers_later_log_entry_on_same_date(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 6, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
+    def test_last_receipt_is_per_sku_and_normalized(self):
+        inv = Inventory()
+        first = inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertIs(inv.last_receipt(" br-1042 "), first)
+        self.assertEqual(inv.last_receipt("BR-2210").sku, "BR-2210")
+
 
 if __name__ == "__main__":
     unittest.main()
