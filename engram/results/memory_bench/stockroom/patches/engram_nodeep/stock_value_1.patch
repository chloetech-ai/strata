@@ -0,0 +1,76 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_issues_take_the_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 1500, DAY)
+        inv.issue("BR-1042", 12, DAY)
+        # 8 left from the 1500 layer, and none from the 1000 layer.
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 1500)
+
+    def test_issue_spanning_layers_leaves_the_newest_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.receive("BR-1042", 5, 200, DAY)
+        inv.issue("BR-1042", 7, DAY)
+        # 3 left, all from the 200 layer.
+        self.assertEqual(stock_value(inv, "BR-1042"), 3 * 200)
+
+    def test_differs_from_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 2000, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        # FIFO: the 10 left are from the 2000 layer. Average cost would give 15000.
+        self.assertEqual(stock_value(inv, "BR-1042"), 20000)
+
+    def test_fully_issued_stock_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 300, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_issue_beyond_receipts_uses_no_layers(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 300, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 5, 900, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_spellings_refer_to_same_item(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 100, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042"), 1000)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 1000)
+
+    def test_positive_movement_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY, "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
