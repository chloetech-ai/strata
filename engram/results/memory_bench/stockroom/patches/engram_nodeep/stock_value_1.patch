+"""Stock valuation at FIFO cost."""
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed first in, first out.
+
+    Each receipt adds a layer of stock at its unit cost. Goods out use up the
+    oldest layers first. Goods out beyond what was received have no layer to
+    draw on, so they use up nothing.
+    """
+    layers = []  # [qty, unit_cost] pairs, oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost recorded for {m.reason} of {m.qty} {m.sku}")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    del layers[0]
+    return sum(qty * unit_cost for qty, unit_cost in layers)
