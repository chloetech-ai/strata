+"""Stock valuation at FIFO cost."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each receipt opens a cost layer; each outgoing movement uses up the oldest
+    layers first. A sale that finds no stock left (negative stock is allowed)
+    is kept as a deficit, which the next receipts cover before adding to stock.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    deficit = 0
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            qty = m.qty
+            covered = min(deficit, qty)
+            deficit -= covered
+            qty -= covered
+            if qty:
+                if m.unit_cost is None:
+                    raise ValueError(f"no unit cost for incoming {m.reason} of {sku}")
+                layers.append([qty, m.unit_cost])
+        else:
+            need = -m.qty
+            while need and layers:
+                take = min(need, layers[0][0])
+                layers[0][0] -= take
+                need -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            deficit += need
+    return sum(qty * cost for qty, cost in layers)
