@@ -0,0 +1,72 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_values_stock_at_receipt_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_sales_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 15, DAY)
+        # 5 left from the second receipt at 300 each; the first receipt is gone.
+        self.assertEqual(stock_value(inv, "BR-1042"), 1500)
+
+    def test_is_not_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        # FIFO leaves 10 at 300 = 3000; average cost would give 10 at 200 = 2000.
+        self.assertEqual(stock_value(inv, "BR-1042"), 3000)
+
+    def test_partial_sale_within_a_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 600)
+
+    def test_negative_stock_is_covered_by_next_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 8, DAY)  # 3 units sold before they were received
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+        inv.receive("BR-1042", 10, 200, DAY)
+        # The first 3 units of the new receipt cover the earlier sales.
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1400)
+
+    def test_only_this_sku_counts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 5, 3000, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_spellings_refer_to_same_item(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 100, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 1000)
+
+    def test_incoming_stock_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        inv.movements.append(Movement("BR-1042", 2, DAY, "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
