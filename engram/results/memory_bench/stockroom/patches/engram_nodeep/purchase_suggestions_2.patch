+
+    def test_suggestion_rounds_up_to_whole_cases(self):
+        inv = Inventory(Catalog([Item("BR-4", "Screw", "A-01-4", reorder_point=10, case_size=12)]))
+        inv.receive("BR-4", 7, 10)
+        self.assertEqual(suggest_orders(inv)["BR-4"], 24)  # shortfall 23 -> 2 cases of 12
+
+    def test_no_suggestion_for_stock_above_reorder_point(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_no_suggestion_when_nothing_to_order(self):
+        inv = Inventory(Catalog([Item("BR-5", "Pin", "A-01-5")]))
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
