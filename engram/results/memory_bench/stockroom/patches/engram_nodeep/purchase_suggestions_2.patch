@@ -28,6 +28,21 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggested_quantity_reaches_three_times_reorder_point(self):
