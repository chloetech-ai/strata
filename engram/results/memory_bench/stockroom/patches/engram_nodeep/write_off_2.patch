diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 8ee0db4..de13638 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -49,6 +49,13 @@ class Inventory:
         movement = Movement(normalize_sku(sku), -qty, date or datetime.date.today(), "SALE", None, note)
         return self._record(movement)
 
+    def write_off(self, sku, qty, date=None, note=""):
+        """Goods out that are broken or damaged and can't be sold."""
+        if qty <= 0:
+            raise ValueError("quantity must be positive")
+        movement = Movement(normalize_sku(sku), -qty, date or datetime.date.today(), "DAMAGE", None, note)
+        return self._record(movement)
+
     def on_hand(self, sku):
         sku = normalize_sku(sku)
         return sum(m.qty for m in self.movements if m.sku == sku)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37a99e3..4e2b60b 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -38,6 +38,35 @@ class InventoryTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             inv.issue("BR-1042", -5)
 
+    def test_write_off_records_damage(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        movement = inv.write_off("BR-1042", 3, DAY, "cracked in transit")
+        self.assertEqual(movement.reason, "DAMAGE")
+        self.assertEqual(movement.qty, -3)
+        self.assertEqual(movement.note, "cracked in transit")
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_quantity_must_be_positive(self):
+        inv = Inventory()
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", 0)
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", -2)
+        self.assertEqual(inv.movements, [])
+
+    def test_write_off_does_not_block_negative_stock(self):
+        inv = Inventory()
+        inv.write_off("BR-1042", 4, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -4)
+
+    def test_write_off_normalizes_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.write_off(" br-1042 ", 2, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 8)
+        self.assertEqual(inv.movements[-1].sku, "BR-1042")
+
     def test_movements_for(self):
         inv = Inventory()
         inv.receive("BR-1042", 10, 12, DAY)
