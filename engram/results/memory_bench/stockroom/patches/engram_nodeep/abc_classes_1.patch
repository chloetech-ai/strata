+++ b/tests/test_analysis.py
@@ -0,0 +1,45 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Total 100. Running shares: 50 (50%), 30 (80%), 15 (95%), 5 (100%).
+        values = {"BR-1": 50, "BR-2": 30, "BR-3": 15, "BR-4": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_sku_crossing_80_percent_is_b(self):
+        # Running shares: 60 (60%), 25 (85%) crosses 80%, so it is B.
+        values = {"BR-1": 60, "BR-2": 25, "BR-3": 15}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_order_of_input_does_not_matter(self):
+        values = {"BR-4": 5, "BR-3": 15, "BR-2": 30, "BR-1": 50}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_all_zero_values_are_c(self):
+        self.assertEqual(
+            abc_classes({"BR-1": 0, "BR-2": 0}),
+            {"BR-1": "C", "BR-2": "C"},
+        )
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
