+"""Stock analysis: ABC classification by annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs into A, B and C by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and a running total is kept. A SKU is 'A' if the cumulative
+    share up to and including it is at most 80% of the grand total, 'B' if at
+    most 95%, otherwise 'C'. Returns a dict mapping SKU to class.
+    """
+    if not values:
+        return {}
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if total == 0:
+            # Nothing is consumed, so no SKU carries any share of the value.
+            classes[sku] = "C"
+        elif running <= 0.80 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
