diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 8ee0db4..0d1515e 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -56,3 +56,10 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The latest RECEIPT for `sku` by date, the later log entry winning a tie; None if there is none."""
+        receipts = [m for m in self.movements_for(sku) if m.reason == "RECEIPT"]
+        if not receipts:
+            return None
+        return max(reversed(receipts), key=lambda m: m.date)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 37a99e3..11e6475 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -55,6 +55,33 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual([m.sku for m in inv.movements], ["BR-1042"] * 3)
         self.assertEqual(len(inv.movements_for(" br-1042")), 3)
 
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_ignores_other_reasons_and_skus(self):
+        inv = Inventory()
+        first = inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY + datetime.timedelta(days=1))
+        inv.receive("BR-2210", 5, 30, DAY + datetime.timedelta(days=2))
+        self.assertIs(inv.last_receipt("br-1042"), first)
+
+    def test_last_receipt_is_latest_by_date(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY + datetime.timedelta(days=5))
+        late_entry = inv.receive("BR-1042", 6, 12, DAY)
+        self.assertIsNot(inv.last_receipt("BR-1042"), late_entry)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_last_receipt_tie_goes_to_later_entry(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive(" br-1042 ", 6, 12, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
 
 if __name__ == "__main__":
     unittest.main()
