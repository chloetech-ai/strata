--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,34 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_walking_order(self):
+        catalog = Catalog([
+            Item("BR-1", "Bolt", "B-12-3"),
+            Item("BR-2", "Nut", "B-2-1"),
+            Item("BR-3", "Washer", "A-9-9"),
+        ])
+        lines = count_sheet(Inventory(catalog)).splitlines()
+        self.assertEqual(3, len(lines))
+        self.assertTrue(lines[0].startswith("A-9-9"))
+        self.assertTrue(lines[1].startswith("B-2-1"))
+        self.assertTrue(lines[2].startswith("B-12-3"))
+
+    def test_blind_count_does_not_show_on_hand(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-1-1", unit="pcs")])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 37, 10)
+        line = count_sheet(inv)
+        self.assertNotIn("37", line)
+        self.assertTrue(line.endswith("________"))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual("", count_sheet(Inventory(Catalog())))
+
+
+if __name__ == "__main__":
+    unittest.main()
