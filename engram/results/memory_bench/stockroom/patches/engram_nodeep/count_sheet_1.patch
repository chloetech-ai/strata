index 0000000..931507e
--- /dev/null
+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,24 @@
+"""Printable blind count sheet for the stock-take."""
+
+import re
+
+BLANK_COUNT = "_" * 8
+
+
+def _walking_order(item):
+    """Sort key for bin codes like "B-12-3": numeric parts compare as numbers, so B-2-1 comes before B-12-3."""
+    parts = re.split(r"(\d+)", item.location)
+    return tuple((0, int(p)) if p.isdigit() else (1, p) for p in parts), item.sku
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in walking order by bin location.
+
+    The sheet is blind: it does not show the quantity on hand, only an empty
+    column for the counted quantity.
+    """
+    items = sorted(inventory.catalog, key=_walking_order)
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<12} {item.sku:<12} {item.name:<30} {item.unit:<6} {BLANK_COUNT}")
+    return "\n".join(lines)
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
