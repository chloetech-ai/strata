diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..fffcd85 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,21 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU that needs reordering, keyed by SKU.
+
+    The order brings stock back up to three times the reorder point. The
+    shortfall is rounded up to whole cases, since the supplier ships only
+    full cases. SKUs that need no order are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        if shortfall <= 0:
+            continue
+        cases = -(-shortfall // item.case_size)  # round up to whole cases
+        orders[sku] = cases * item.case_size
+    return orders
