@@ -28,6 +28,22 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_fills_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 25, "BR-2": 20})
+
+    def test_suggest_orders_rounds_shortfall_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Pin", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        # target 30, shortfall 25, rounded up to 3 cases of 12
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_suggest_orders_skips_zero_target(self):
+        catalog = Catalog([Item("BR-5", "Clip", "A-03-1")])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
