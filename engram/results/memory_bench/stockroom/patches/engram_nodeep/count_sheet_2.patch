+"""Printable blind count sheet for the stock-take."""
+
+# Count sheets are printed in walking order, so lines are sorted by bin
+# location. The on-hand quantity is deliberately left off: staff must count
+# the shelf, not copy the system figure.
+COUNT_BOX = "[" + " " * 10 + "]"
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin-location order, with a blank count column."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to build a count sheet from")
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    return "\n".join(
+        f"{item.location:<8}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  {COUNT_BOX}"
+        for item in items
+    )
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
