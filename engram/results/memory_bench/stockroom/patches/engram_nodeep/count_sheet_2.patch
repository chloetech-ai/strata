+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def make_inventory(self):
+        catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8", "C-02-1", unit="pcs"),
+            Item("AX-0007", "Claw hammer", "A-01-3", unit="pcs"),
+            Item("BR-2000", "Washer", "A-01-1", unit="pcs"),
+        ])
+        return Inventory(catalog)
+
+    def test_one_line_per_catalog_item(self):
+        lines = count_sheet(self.make_inventory()).split("\n")
+        self.assertEqual(len(lines), 3)
+
+    def test_lines_are_in_bin_location_order(self):
+        lines = count_sheet(self.make_inventory()).split("\n")
+        self.assertIn("A-01-1", lines[0])
+        self.assertIn("A-01-3", lines[1])
+        self.assertIn("C-02-1", lines[2])
+
+    def test_ties_on_location_are_ordered_by_sku(self):
+        catalog = Catalog([
+            Item("ZZ-1", "Second", "A-01-1"),
+            Item("AA-1", "First", "A-01-1"),
+        ])
+        lines = count_sheet(Inventory(catalog)).split("\n")
+        self.assertIn("AA-1", lines[0])
+        self.assertIn("ZZ-1", lines[1])
+
+    def test_on_hand_quantity_is_not_printed(self):
+        inventory = self.make_inventory()
+        inventory.receive("BR-1042", 37, 1250)
+        sheet = count_sheet(inventory)
+        self.assertNotIn("37", sheet)
+
+    def test_counted_column_is_blank(self):
+        sheet = count_sheet(self.make_inventory())
+        for line in sheet.split("\n"):
+            self.assertTrue(line.endswith("[" + " " * 10 + "]"))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_inventory_without_catalog_is_rejected(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
