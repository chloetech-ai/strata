+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_accepts_lowercase_aisle_and_returns_uppercase(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_ignores_surrounding_whitespace(self):
+        self.assertEqual(parse_location("  B-12-3\n"), ("B", 12, 3))
+
+    def test_rejects_malformed_codes(self):
+        for code in ["", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "B-(-3", "B-1 2-3", "B-+12-3", "B-12-3.0"]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
