index 0000000..4bbeca7
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,44 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_reads_bin_sku_qty(self):
+        self.assertEqual(self.read("B-12-3;BR-1042;7\nA-01-1;HX-200;3\n"),
+                         {"BR-1042": 7, "HX-200": 3})
+
+    def test_sums_a_sku_across_bins(self):
+        self.assertEqual(self.read("B-12-3;BR-1042;7\nOVERFLOW-1;BR-1042;5\n"),
+                         {"BR-1042": 12})
+
+    def test_normalizes_sku(self):
+        self.assertEqual(self.read("B-12-3; br-1042 ;4\nB-12-3;BR-1042;1\n"),
+                         {"BR-1042": 5})
+
+    def test_skips_blank_lines(self):
+        self.assertEqual(self.read("B-12-3;BR-1042;2\n\n   \n"), {"BR-1042": 2})
+
+    def test_empty_file_gives_empty_dict(self):
+        self.assertEqual(self.read(""), {})
+
+    def test_wrong_field_count_is_rejected_with_line_number(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self.read("B-12-3;BR-1042;2\nBR-1042;2\n")
+
+    def test_non_integer_quantity_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("B-12-3;BR-1042;two\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
