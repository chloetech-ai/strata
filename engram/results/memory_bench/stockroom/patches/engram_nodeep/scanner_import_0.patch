index 0000000..86667c2
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,28 @@
+"""Reading the handheld scanners' export file."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is semicolon-separated with no header line and columns
+    bin;sku;qty. A SKU may appear on several lines (overflow bins), so its
+    quantities are added up. Blank lines are skipped.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity is not a whole number: {qty.strip()!r}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
