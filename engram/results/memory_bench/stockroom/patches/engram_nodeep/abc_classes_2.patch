@@ -0,0 +1,27 @@
+"""ABC analysis of annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to its ABC class, given annual consumption value per SKU.
+
+    SKUs are sorted by value, highest first. A SKU is 'A' if the cumulative
+    share of the grand total up to and including it is at most 80%, 'B' if it
+    is at most 95%, and 'C' otherwise. Ties are ordered by SKU.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        # Compare running/total against 0.80 and 0.95 without dividing,
+        # so boundary cases are not affected by float rounding of the ratio.
+        if running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
