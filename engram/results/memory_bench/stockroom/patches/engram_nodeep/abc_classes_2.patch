@@ -0,0 +1,42 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Total 100. Cumulative shares in value order: 50%, 80%, 95%, 100%.
+        values = {"D": 5, "A": 50, "C": 15, "B": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Shares in value order: 80% exactly is still A, 95% exactly is still B.
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_sku_past_80_percent_on_its_own_is_b(self):
+        # BIG alone is 90% of the total, past the A threshold but within B.
+        values = {"BIG": 900, "SMALL": 100}
+        self.assertEqual(abc_classes(values), {"BIG": "B", "SMALL": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is past both the A and B thresholds.
+        self.assertEqual(abc_classes({"ONLY": 7}), {"ONLY": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        values = {"B-2": 10, "A-1": 10, "C-3": 10}
+        # Shares in order A-1, B-2, C-3: 33%, 67%, 100%.
+        self.assertEqual(
+            abc_classes(values),
+            {"A-1": "A", "B-2": "A", "C-3": "C"},
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
