+"""Stock analysis helpers."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value (ABC analysis).
+
+    ``values`` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and a running total is kept. A SKU is 'A' if the cumulative
+    share up to and including it is at most 80% of the grand total, 'B' if at
+    most 95%, otherwise 'C'. Returns a dict mapping SKU to class.
+    """
+    if not values:
+        return {}
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    if total == 0:
+        raise ValueError("consumption values must not all be zero")
+
+    # Shares are compared as cumulative * 100 <= percent * total so that no
+    # division is needed and integer inputs compare exactly.
+    classes = {}
+    cumulative = 0
+    ordered = sorted(values.items(), key=lambda pair: pair[1], reverse=True)
+    for sku, value in ordered:
+        cumulative += value
+        if cumulative * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif cumulative * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
