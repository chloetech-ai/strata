--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,47 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_boundaries_are_inclusive(self):
+        # Sorted: 50 (cum 50%), 30 (cum 80%), 15 (cum 95%), 5 (cum 100%)
+        values = {"BR-1": 5, "BR-2": 30, "BR-3": 50, "BR-4": 15}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-3": "A", "BR-2": "A", "BR-4": "B", "BR-1": "C"},
+        )
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above 95%.
+        self.assertEqual(abc_classes({"BR-1": 12}), {"BR-1": "C"})
+
+    def test_does_not_depend_on_input_order(self):
+        forward = {"BR-1": 5, "BR-2": 30, "BR-3": 50, "BR-4": 15}
+        backward = dict(reversed(list(forward.items())))
+        self.assertEqual(abc_classes(forward), abc_classes(backward))
+
+    def test_float_values(self):
+        values = {"BR-1": 0.5, "BR-2": 0.3, "BR-3": 0.2}
+        # cum 0.5 (A), 0.8 (A), 1.0 (C)
+        self.assertEqual(
+            abc_classes(values), {"BR-1": "A", "BR-2": "A", "BR-3": "C"}
+        )
+
+    def test_zero_value_skus_are_c(self):
+        # BR-1 reaches 90% (B); BR-2 reaches 100% (C); BR-3 adds nothing (C).
+        self.assertEqual(
+            abc_classes({"BR-1": 90, "BR-2": 10, "BR-3": 0}),
+            {"BR-1": "B", "BR-2": "C", "BR-3": "C"},
+        )
+
+    def test_negative_values_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+    def test_all_zero_values_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 0, "BR-2": 0})
