index 0000000..3ed3da1
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,30 @@
+"""Reading the handheld scanners' plain-text count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is ``bin;sku;qty`` with no header. A SKU can appear on several
+    lines when stock sits in an overflow bin, so its quantities are summed.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.strip()
+            if not line:
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line!r}")
+            _bin, sku, qty = (field.strip() for field in fields)
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity must be a whole number, got {qty!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..809170c
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,48 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_counts_per_sku(self):
+        counts = self.read("A-1;BR-1042;12\nA-2;BR-2000;5\n")
+        self.assertEqual(counts, {"BR-1042": 12, "BR-2000": 5})
+
+    def test_sums_sku_across_bins(self):
+        counts = self.read("A-1;BR-1042;12\nOVERFLOW;BR-1042;3\n")
+        self.assertEqual(counts, {"BR-1042": 15})
+
+    def test_normalizes_sku(self):
+        counts = self.read("A-1;  br-1042 ;4\nOVERFLOW;BR-1042;1\n")
+        self.assertEqual(counts, {"BR-1042": 5})
+
+    def test_skips_blank_lines(self):
+        self.assertEqual(self.read("\nA-1;BR-1042;2\n\n"), {"BR-1042": 2})
+
+    def test_empty_file(self):
+        self.assertEqual(self.read(""), {})
+
+    def test_wrong_column_count_names_line(self):
+        with self.assertRaisesRegex(ValueError, ":2: expected bin;sku;qty"):
+            self.read("A-1;BR-1042;2\nBR-2000;5\n")
+
+    def test_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity must be a whole number"):
+            self.read("A-1;BR-1042;two\n")
+
+    def test_negative_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity must not be negative"):
+            self.read("A-1;BR-1042;-3\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
