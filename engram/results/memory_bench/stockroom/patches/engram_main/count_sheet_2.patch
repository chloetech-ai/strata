--- /dev/null
+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,24 @@
+"""Printable count sheet for the stock-take.
+
+The sheet is a blind count: it lists each item's bin location, SKU, name and
+unit, and leaves the counted column empty, so the system's on-hand quantity is
+never shown to the people counting. Lines are in walking order by bin location,
+not by SKU.
+"""
+
+
+def _walk_key(item):
+    # Bin codes look like "B-12-3"; compare the numeric parts as numbers so that
+    # B-9-1 comes before B-12-1. Ties fall back to the SKU.
+    parts = tuple((0, int(p), "") if p.isdigit() else (1, 0, p) for p in item.location.split("-"))
+    return (parts, item.sku)
+
+
+def count_sheet(inventory):
+    """The count sheet as text, one line per catalog item, in bin walking order."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog; cannot build a count sheet")
+    lines = []
+    for item in sorted(inventory.catalog, key=_walk_key):
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  {'':<10}")
+    return "\n".join(lines) + "\n" if lines else ""
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..6aac45e
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,50 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-1042", "Hex bolt M8x40", "C-03-2", unit="pcs"),
+        Item("BR-2000", "Wood screw 4x50", "B-12-3", unit="pcs"),
+        Item("BR-3000", "Door hinge", "B-9-1", unit="pair"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1042", 40, 10)
+    inv.receive("BR-2000", 7, 5)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_bin_walking_order(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+        self.assertEqual([line.split()[0] for line in lines], ["B-9-1", "B-12-3", "C-03-2"])
+
+    def test_does_not_show_on_hand_quantities(self):
+        tokens = count_sheet(make_inventory()).split()
+        self.assertNotIn("40", tokens)
+        self.assertNotIn("7", tokens)
+
+    def test_lists_sku_name_and_unit(self):
+        line = count_sheet(make_inventory()).splitlines()[0]
+        self.assertIn("BR-3000", line)
+        self.assertIn("Door hinge", line)
+        self.assertIn("pair", line)
+
+    def test_sku_is_shown_normalized(self):
+        catalog = Catalog([Item(" br-1042 ", "Hex bolt M8x40", "C-03-2")])
+        self.assertIn("BR-1042", count_sheet(Inventory(catalog)))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_requires_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
