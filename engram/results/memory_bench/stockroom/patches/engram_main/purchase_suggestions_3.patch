@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -31,3 +31,31 @@ class ReorderTest(unittest.TestCase):
 
 if __name__ == "__main__":
     unittest.main()
+
+
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders["BR-1"], 25)  # 30 target - 5 on hand
+
+    def test_at_reorder_point_is_ordered(self):
+        self.assertEqual(suggest_orders(make_inventory())["BR-2"], 20)  # 30 - 10
+
+    def test_enough_stock_not_ordered(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})  # 25 short -> 3 cases of 12
+
+    def test_exact_case_multiple_not_padded(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-02-2", reorder_point=10, case_size=5)])
+        inv = Inventory(catalog)
+        inv.receive("BR-5", 10, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-5": 20})  # 20 short -> 4 cases of 5
+
+    def test_zero_reorder_point_not_ordered(self):
+        catalog = Catalog([Item("BR-6", "Clip", "A-02-3")])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
