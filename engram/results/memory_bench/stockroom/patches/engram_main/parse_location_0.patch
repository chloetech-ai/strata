+
+    def test_leading_zeros_are_numbers(self):
+        self.assertEqual(parse_location("C-007-02"), ("C", 7, 2))
+
+    def test_rejects_malformed_codes(self):
+        for code in ["", "B-12", "B-12-3-4", "B12-3", "B--3", "-12-3", "B-12-", "BB-12-3", "1-12-3", "B-1 2-3", "B-x-3", "B-+1-3", "B-12.5-3", "B-−1-3"]:
+            with self.assertRaises(ValueError, msg=code):
+                parse_location(code)
