+    def test_last_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        first = inv.receive("br-1042", 10, 12, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), first)
+        inv.issue("BR-1042", 3, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertIs(inv.last_receipt(" br-1042 "), first)
+        later = inv.receive("BR-1042", 20, 13, DAY + datetime.timedelta(days=1))
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+        self.assertIsNone(Inventory().last_receipt("BR-9999"))
+
+    def test_last_receipt_ignores_non_receipts(self):
+        inv = Inventory()
+        receipt = inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 3, DAY + datetime.timedelta(days=1))
+        self.assertIs(inv.last_receipt("BR-1042"), receipt)
+
+    def test_last_receipt_tie_goes_to_later_logged(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 5, 12, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
