+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_picks_latest_date(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 5))
+        inv.receive("BR-1042", 20, 13, datetime.date(2026, 9, 1))
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_last_receipt_ignores_other_reasons_and_matches_sku_spellings(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 3, datetime.date(2026, 9, 9))
+        inv.receive("br-1042", 7, 12, datetime.date(2026, 9, 2))
+        last = inv.last_receipt(" BR-1042 ")
+        self.assertEqual((last.qty, last.unit_cost), (7, 12))
+
+    def test_last_receipt_tie_goes_to_latest_recorded(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 4, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
