diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 6ebac3e..fb10f25 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -55,3 +55,8 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The RECEIPT for `sku` with the latest date, or None. Ties go to the later-logged one."""
+        receipts = [m for m in reversed(self.movements_for(sku)) if m.reason == "RECEIPT"]
+        return max(receipts, key=lambda m: m.date, default=None)
