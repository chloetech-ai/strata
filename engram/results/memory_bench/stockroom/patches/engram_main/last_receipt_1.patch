+    def test_last_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("br-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        second = inv.receive(" BR-1042", 5, 13, DAY + datetime.timedelta(days=1))
+        inv.receive("BR-2210", 7, 30, DAY + datetime.timedelta(days=5))
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+        self.assertIsNone(inv.last_receipt("BR-9999"))
+
+    def test_last_receipt_uses_date_not_log_order(self):
+        inv = Inventory()
+        later = inv.receive("BR-1042", 10, 12, DAY + datetime.timedelta(days=3))
+        inv.receive("BR-1042", 5, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
+    def test_last_receipt_ignores_other_reasons(self):
+        inv = Inventory()
+        receipt = inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 1, DAY + datetime.timedelta(days=2))
+        self.assertIs(inv.last_receipt("BR-1042"), receipt)
+        inv.movements.append(Movement("BR-1042", 2, DAY + datetime.timedelta(days=9), "RETURN"))
+        self.assertIs(inv.last_receipt("BR-1042"), receipt)
+
