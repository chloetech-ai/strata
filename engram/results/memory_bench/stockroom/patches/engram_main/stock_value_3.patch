@@ -0,0 +1,31 @@
+"""What the stock on hand is worth, costed first-in, first-out."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Outflows consume the oldest receipts still in stock, and whatever is left
+    is valued at the unit cost it was received at. Raises ValueError if a
+    positive movement has no unit cost to value it by, or if outflows exceed
+    the stock received, since the value of either would be a guess.
+    """
+    layers = deque()  # [qty_left, unit_cost], oldest first
+    for movement in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if movement.qty > 0:
+            if movement.unit_cost is None:
+                raise ValueError(f"{movement.reason} of {movement.sku} on {movement.date} has no unit cost")
+            layers.append([movement.qty, movement.unit_cost])
+            continue
+        remaining = -movement.qty
+        while remaining:
+            if not layers:
+                raise ValueError(f"{movement.sku} is short by {remaining} on {movement.date}")
+            layer = layers[0]
+            used = min(remaining, layer[0])
+            layer[0] -= used
+            remaining -= used
+            if layer[0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..0a5dcda
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY1 = datetime.date(2026, 9, 1)
+DAY2 = datetime.date(2026, 9, 2)
+DAY3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_unknown_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-9999"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 125, DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1250)
+
+    def test_sale_consumes_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 150, DAY2)
+        inv.issue("BR-1042", 15, DAY3)
+        # 5 left, all from the second receipt at 150
+        self.assertEqual(stock_value(inv, "BR-1042"), 750)
+
+    def test_partial_layer_left_after_sale(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 150, DAY2)
+        inv.issue("BR-1042", 4, DAY3)
+        # 6 left from the first receipt at 100, plus all 10 at 150
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100 + 10 * 150)
+
+    def test_fifo_uses_dates_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 150, DAY2)
+        inv.receive("BR-1042", 10, 100, DAY1)  # logged later, received earlier
+        inv.issue("BR-1042", 10, DAY3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 150)
+
+    def test_sku_spellings_share_stock(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 100, DAY1)
+        inv.issue(" BR-1042", 4, DAY2)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 6 * 100)
+
+    def test_other_skus_do_not_count(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-2210", 5, 300, DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_positive_movement_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY1, "COUNT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+    def test_outflow_beyond_stock_is_rejected(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY1)
+        inv.issue("BR-1042", 8, DAY2)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
