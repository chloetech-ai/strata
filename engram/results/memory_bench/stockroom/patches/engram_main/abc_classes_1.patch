--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,34 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: X 60 (60%), Y 85 (85%), Z 95 (95%), W 100 (100%)
+        values = {"X": 60, "Y": 25, "Z": 10, "W": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "B", "W": "C"})
+
+    def test_boundaries_are_inclusive(self):
+        # A-band ends exactly at 80% (B 30 brings the total to 80);
+        # B-band ends exactly at 95% (C 15 brings the total to 95).
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "A", "C": "B", "D": "C"})
+
+    def test_order_of_input_does_not_matter(self):
+        values = {"W": 5, "Z": 10, "Y": 25, "X": 60}
+        self.assertEqual(abc_classes(values)["X"], "A")
+
+    def test_zero_total_gives_c(self):
+        self.assertEqual(abc_classes({"P": 0, "Q": 0}), {"P": "C", "Q": "C"})
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"P": 10, "Q": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
