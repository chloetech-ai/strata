+"""ABC analysis of annual consumption value."""
+
+
+def abc_classes(values):
+    """Class each SKU A, B or C by its cumulative share of the total value.
+
+    SKUs are sorted by value, highest first. A SKU is 'A' if the running total
+    up to and including it is at most 80% of the grand total, 'B' if at most
+    95%, and 'C' otherwise. A grand total of zero gives every SKU 'C'.
+    """
+    if not values:
+        return {}
+    for sku, value in values.items():
+        if value < 0:
+            raise ValueError(f"value for {sku} must not be negative, got {value}")
+    total = sum(values.values())
+    if total == 0:
+        return {sku: "C" for sku in values}
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda pair: (-pair[1], pair[0])):
+        running += value
+        share = running / total
+        if share <= 0.80:
+            classes[sku] = "A"
+        elif share <= 0.95:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
