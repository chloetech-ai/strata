+"""The printable count sheet for a stock-take."""
+
+COUNT_COLUMN = "_" * 8  # left blank: counters write what they count here
+
+
+def count_sheet(inventory):
+    """Blind count sheet as text: one line per catalog item, in bin-location walking order.
+
+    On-hand quantities are deliberately left off so that counters actually count.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to build a count sheet from")
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    return "\n".join(
+        f"{item.location:<8} {item.sku:<12} {item.name:<30.30} {item.unit:<5} {COUNT_COLUMN}"
+        for item in items
+    )
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..44d2963
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("BR-2210", "Copper pipe 15mm", "C-04-1", unit="m"),
+            Item("BR-1042", "Hex bolt 1/4in", "B-12-3"),
+            Item("BR-0007", "Claw hammer", "B-02-1"),
+        ])
+        self.inv = Inventory(self.catalog)
+        self.inv.receive("BR-1042", 4321, 12, DAY)
+
+    def test_one_line_per_item_in_bin_order(self):
+        lines = count_sheet(self.inv).split("\n")
+        self.assertEqual(len(lines), 3)
+        self.assertEqual([line.split()[1] for line in lines], ["BR-0007", "BR-1042", "BR-2210"])
+
+    def test_sheet_is_blind(self):
+        self.assertNotIn("4321", count_sheet(self.inv))
+
+    def test_each_line_has_blank_count_column(self):
+        for line in count_sheet(self.inv).split("\n"):
+            self.assertTrue(line.endswith("_" * 8))
+
+    def test_line_shows_bin_sku_name_and_unit(self):
+        line = count_sheet(self.inv).split("\n")[2]
+        self.assertTrue(line.startswith("C-04-1"))
+        self.assertIn("BR-2210", line)
+        self.assertIn("Copper pipe 15mm", line)
+        self.assertIn(" m ", line)
+
+    def test_long_names_are_truncated_to_keep_columns(self):
+        catalog = Catalog([Item("BR-5555", "x" * 60, "A-01-1")])
+        line = count_sheet(Inventory(catalog))
+        self.assertIn("x" * 30 + " ", line)
+        self.assertNotIn("x" * 31, line)
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_requires_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
