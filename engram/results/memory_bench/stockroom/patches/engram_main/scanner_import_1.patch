index 0000000..af198a2
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,32 @@
+"""Reading the handheld scanners' plain-text count export."""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The file is semicolon-separated with no header line and columns bin;sku;qty.
+    A SKU may appear on several lines (stock in an overflow bin), so its
+    quantities are added together.
+    """
+    counts = {}  # type: Dict[str, int]
+    with open(path, encoding="utf-8") as f:
+        for lineno, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{lineno}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _, sku, qty = fields
+            try:
+                quantity = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{lineno}: quantity {qty.strip()!r} is not a whole number") from None
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{lineno}: empty SKU")
+            counts[sku] = counts.get(sku, 0) + quantity
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..f037044
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,50 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8", newline="") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_counts_per_sku(self):
+        counts = self.read("A1;BR-1042;12\nA2;BR-2001;3\n")
+        self.assertEqual(counts, {"BR-1042": 12, "BR-2001": 3})
+
+    def test_same_sku_in_several_bins_is_summed(self):
+        counts = self.read("A1;BR-1042;12\nOVERFLOW;BR-1042;5\n")
+        self.assertEqual(counts, {"BR-1042": 17})
+
+    def test_sku_is_normalized(self):
+        counts = self.read("A1; br-1042 ;4\nOVERFLOW;BR-1042;1\n")
+        self.assertEqual(counts, {"BR-1042": 5})
+
+    def test_blank_lines_and_crlf_are_ignored(self):
+        counts = self.read("A1;BR-1042;2\r\n\r\nA1;BR-2001;7\r\n")
+        self.assertEqual(counts, {"BR-1042": 2, "BR-2001": 7})
+
+    def test_zero_and_negative_quantities_are_kept(self):
+        counts = self.read("A1;BR-1042;0\nA1;BR-2001;-2\n")
+        self.assertEqual(counts, {"BR-1042": 0, "BR-2001": -2})
+
+    def test_wrong_field_count_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, ":2: expected bin;sku;qty"):
+            self.read("A1;BR-1042;2\nA1;BR-2001\n")
+
+    def test_non_numeric_quantity_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity 'many'"):
+            self.read("A1;BR-1042;many\n")
+
+    def test_empty_sku_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, ":1: empty SKU"):
+            self.read("A1;   ;3\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
