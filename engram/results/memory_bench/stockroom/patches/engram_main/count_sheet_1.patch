--- /dev/null
+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,31 @@
+"""The printable count sheet for the stock-take.
+
+A blind count: the sheet never shows the quantity on hand, only an empty
+column for the counted quantity, so staff count rather than copy.
+Lines are in bin-location walking order, not SKU order.
+"""
+
+WRITE_IN_WIDTH = 8
+
+
+def _walk_key(item):
+    """Sort key for bin codes like "B-12-3": numeric parts compare as numbers."""
+    parts = []
+    for part in item.location.strip().upper().split("-"):
+        if part.isdigit():
+            parts.append((0, int(part), ""))
+        else:
+            parts.append((1, 0, part))
+    return parts, item.sku
+
+
+def count_sheet(inventory):
+    """The count sheet as text, one line per catalog item, in walking order."""
+    if inventory.catalog is None:
+        raise ValueError("count sheet needs an inventory with a catalog")
+    lines = []
+    for item in sorted(inventory.catalog, key=_walk_key):
+        lines.append(
+            f"{item.location:<8}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  {'_' * WRITE_IN_WIDTH}"
+        )
+    return "\n".join(lines)
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..a86f46f
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,50 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-1042", "Hex bolt M8x40", "B-10-1", unit="pcs"),
+        Item("BR-2001", "Wood screw 4x30", "B-2-1", unit="pcs"),
+        Item("BR-3003", "Door hinge", "A-01-4", unit="pr"),
+    ])
+    return Inventory(catalog)
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_catalog_item(self):
+        inv = make_inventory()
+        self.assertEqual(len(count_sheet(inv).splitlines()), len(inv.catalog))
+
+    def test_walking_order_by_bin_not_sku(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        skus = [line.split()[1] for line in lines]
+        # A-01-4 first, then B-2-1 before B-10-1 (numeric, not text, order)
+        self.assertEqual(skus, ["BR-3003", "BR-2001", "BR-1042"])
+
+    def test_blind_count_ignores_quantities_on_hand(self):
+        inv = make_inventory()
+        before = count_sheet(inv)
+        inv.receive("BR-1042", 37, 10)
+        inv.issue("BR-2001", 4)
+        self.assertEqual(count_sheet(inv), before)
+
+    def test_write_in_column_is_blank(self):
+        for line in count_sheet(make_inventory()).splitlines():
+            self.assertTrue(line.endswith("_" * 8))
+
+    def test_sheet_contains_no_on_hand_figure(self):
+        inv = make_inventory()
+        inv.receive("BR-3003", 123, 10)
+        self.assertNotIn("123", count_sheet(inv))
+
+    def test_requires_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
