+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,28 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggests_up_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders["BR-1"], 25)  # 30 wanted, 5 on hand
+        self.assertNotIn("BR-3", orders)
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})  # 25 short -> 3 cases of 12
+
+    def test_exact_case_multiple_not_rounded_up(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-02-2", reorder_point=10, case_size=5)])
+        inv = Inventory(catalog)
+        inv.receive("BR-5", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-5": 25})  # 25 short -> 5 cases of 5
+
+    def test_sku_is_normalized_in_result(self):
+        catalog = Catalog([Item(" br-6 ", "Clip", "A-02-3", reorder_point=4)])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {"BR-6": 12})
+
 
 if __name__ == "__main__":
