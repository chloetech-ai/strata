@@ -0,0 +1,29 @@
+"""What the stock on hand is worth."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed FIFO.
+
+    Each goods-in movement opens a cost layer at its unit cost. Each goods-out
+    movement uses up the oldest layers first, so what is left on hand is valued
+    at the most recent costs. Goods out beyond what was received have no cost
+    layer to draw from and are not valued.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    movements = sorted(inventory.movements_for(sku), key=lambda m: m.date)  # stable: log order within a day
+    for m in movements:
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"receipt of {m.sku} on {m.date} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            taken = min(remaining, layers[0][0])
+            layers[0][0] -= taken
+            remaining -= taken
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..f3518eb
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,81 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_fifo_uses_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 200, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 15, DAY + datetime.timedelta(days=2))
+        # 10 @ 100 are gone, 5 @ 200 remain
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_fifo_not_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 10, DAY + datetime.timedelta(days=2))
+        # average cost would give 10 * 200 = 2000; FIFO leaves 10 @ 300 = 3000
+        self.assertEqual(stock_value(inv, "BR-1042"), 3000)
+
+    def test_out_of_date_order_in_log_is_costed_by_date(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 300, DAY + datetime.timedelta(days=5))
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 5, DAY + datetime.timedelta(days=6))
+        # the older receipt (cost 100) is used first, even though it was logged second
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_damage_and_count_consume_layers_too(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 100, DAY)
+        inv.receive("BR-1042", 4, 200, DAY)
+        inv._record(Movement("BR-1042", -4, DAY, "DAMAGE"))
+        self.assertEqual(stock_value(inv, "BR-1042"), 4 * 200)
+
+    def test_sku_spellings_match(self):
+        inv = Inventory()
+        inv.receive("br-1042", 2, 500, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 1000)
+
+    def test_other_skus_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 500, DAY)
+        inv.receive("BR-2210", 9, 700, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_fully_sold_is_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 500, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_sale_beyond_stock_is_not_valued(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 500, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_receipt_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY, "RECEIPT", None))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
