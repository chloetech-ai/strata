+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,26 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggests_up_to_three_times_reorder_point(self):
+        # BR-1: 5 on hand, reorder point 10 -> target 30 -> order 25
+        self.assertEqual(suggest_orders(make_inventory())["BR-1"], 25)
+
+    def test_no_suggestion_when_stock_is_fine(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        # target 30, shortfall 25, 25 / 12 rounds up to 3 cases = 36
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_exact_case_multiple_is_not_rounded_up(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-02-2", reorder_point=10, case_size=10)])
+        inv = Inventory(catalog)
+        # nothing on hand: target 30, shortfall 30, exactly 3 cases
+        self.assertEqual(suggest_orders(inv), {"BR-5": 30})
+
 
 if __name__ == "__main__":
     unittest.main()
