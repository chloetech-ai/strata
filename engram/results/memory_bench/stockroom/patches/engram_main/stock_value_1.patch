@@ -0,0 +1,30 @@
+"""What the stock on hand is worth."""
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed FIFO.
+
+    Each receipt is a cost layer at its unit cost. Outflows use up the oldest
+    layers first (by date, then log order), and whatever is left is valued at
+    the unit cost of the layer it came from.
+    """
+    sku = normalize_sku(sku)
+    layers = []  # [qty, unit_cost] pairs, oldest first
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{sku}: {m.reason} of {m.qty} has no unit cost, so it cannot be valued")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining > 0:
+            if not layers:
+                raise ValueError(f"{sku}: more stock issued than received")
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.pop(0)
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..49440d2
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,76 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY1 = datetime.date(2026, 9, 1)
+DAY2 = datetime.date(2026, 9, 2)
+DAY3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 125, DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1250)
+
+    def test_sale_consumes_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 200, DAY2)
+        inv.issue("BR-1042", 15, DAY3)
+        # 5 left from the second receipt at 200, the first receipt is gone
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sale_partly_within_one_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 200, DAY2)
+        inv.issue("BR-1042", 4, DAY3)
+        # 6 left at 100 and 10 left at 200
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100 + 10 * 200)
+
+    def test_fully_sold_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.issue("BR-1042", 10, DAY2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_layers_are_taken_in_date_order_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 200, DAY2)
+        inv.receive("BR-1042", 10, 100, DAY1)  # logged later, but received earlier
+        inv.issue("BR-1042", 10, DAY3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 200)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        self.assertEqual(stock_value(inv, " br-1042 "), 1000)
+
+    def test_other_skus_are_not_counted(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-2210", 5, 300, DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_positive_movement_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv.movements.append(Movement("BR-1042", 5, DAY1, "COUNT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+    def test_issuing_more_than_received_is_an_error(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY1)
+        inv.issue("BR-1042", 8, DAY2)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
