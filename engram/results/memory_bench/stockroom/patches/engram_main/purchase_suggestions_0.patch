diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 2f0080f..235fb06 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -5,6 +5,23 @@ def needs_reorder(inventory):
     """SKUs whose quantity on hand is at or below their reorder point."""
     out = []
     for item in inventory.catalog:
-        if inventory.on_hand(item.sku) < item.reorder_point:
+        if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU that needs reordering.
+
+    Orders enough to bring stock up to three times the reorder point,
+    rounded up to whole cases. SKUs with nothing to order are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        if shortfall <= 0:
+            continue
+        cases = -(-shortfall // item.case_size)  # round up to whole cases
+        orders[sku] = cases * item.case_size
+    return orders
