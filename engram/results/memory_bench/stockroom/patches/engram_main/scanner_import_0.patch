diff --git a/src/stockroom/scanner.py b/src/stockroom/scanner.py
new file mode 100644
index 0000000..63aaa03
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,29 @@
+"""Reading the handheld scanners' plain-text count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is ``bin;sku;qty`` with no header. A SKU may appear on several
+    lines when stock sits in an overflow bin, so its quantities are summed.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path} line {number}: expected bin;sku;qty, got {line.strip()!r}")
+            _, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path} line {number}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path} line {number}: quantity {qty.strip()!r} is not a whole number") from None
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..86bee5e
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,45 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def _read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8", newline="") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_sums_quantities_per_sku_across_bins(self):
+        counts = self._read("A1;BR-1042;12\nOVERFLOW;BR-1042;5\nA2;BR-2001;3\n")
+        self.assertEqual(counts, {"BR-1042": 17, "BR-2001": 3})
+
+    def test_normalizes_sku_as_typed_at_the_counter(self):
+        counts = self._read("A1;  br-1042 ;4\nA1;BR-1042;1\n")
+        self.assertEqual(counts, {"BR-1042": 5})
+
+    def test_skips_blank_lines_and_handles_crlf(self):
+        counts = self._read("A1;BR-1042;4\r\n\r\nA1;BR-2001;2\r\n")
+        self.assertEqual(counts, {"BR-1042": 4, "BR-2001": 2})
+
+    def test_empty_file_gives_no_counts(self):
+        self.assertEqual(self._read(""), {})
+
+    def test_wrong_column_count_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self._read("A1;BR-1042;4\nA1;BR-2001\n")
+
+    def test_non_numeric_quantity_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, "line 1.*not a whole number"):
+            self._read("A1;BR-1042;four\n")
+
+    def test_empty_sku_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1: empty SKU"):
+            self._read("A1;   ;4\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
