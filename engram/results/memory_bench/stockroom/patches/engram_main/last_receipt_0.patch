+    def test_last_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 3, DAY + datetime.timedelta(days=1))
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+        second = inv.receive(" br-1042", 5, 13, DAY + datetime.timedelta(days=2))
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
+    def test_last_receipt_uses_date_not_recording_order(self):
+        inv = Inventory()
+        late = inv.receive("BR-1042", 5, 13, DAY + datetime.timedelta(days=5))
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), late)
+
+    def test_last_receipt_ignores_other_skus_and_reasons(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
