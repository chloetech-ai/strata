@@ -0,0 +1,22 @@
+"""The printable stock-take count sheet.
+
+A blind count: the sheet never shows the quantity on hand, only an empty
+column for the counted quantity, so counters have to count rather than copy.
+Lines are in bin-location walking order, not SKU order.
+"""
+
+COUNT_WIDTH = 10
+
+
+def count_sheet(inventory):
+    """One text line per catalog item, sorted by bin location then SKU."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count against")
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    lines = []
+    for item in items:
+        lines.append(
+            f"{item.location:<10} {item.sku:<14} {item.name:<32} {item.unit:<5} "
+            f"{'_' * COUNT_WIDTH}"
+        )
+    return "\n".join(lines) + ("\n" if lines else "")
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..bda4389
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,48 @@
+import unittest
+
+from stockroom import Catalog, Inventory, Item
+from stockroom.countsheet import count_sheet
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("br-2000", "Wood screw 8x1", "C-03-1", unit="box"),
+            Item("BR-1042", "Hex bolt 1/4in", "B-12-3"),
+            Item("BR-0007", "Claw hammer", "A-01-2"),
+        ])
+        self.inventory = Inventory(self.catalog)
+        self.inventory.receive("BR-1042", 37, 125)
+
+    def test_one_line_per_item_in_bin_order(self):
+        lines = count_sheet(self.inventory).splitlines()
+        self.assertEqual(len(lines), 3)
+        self.assertTrue(lines[0].startswith("A-01-2"))
+        self.assertTrue(lines[1].startswith("B-12-3"))
+        self.assertTrue(lines[2].startswith("C-03-1"))
+
+    def test_blind_count_does_not_show_on_hand(self):
+        sheet = count_sheet(self.inventory)
+        self.assertNotIn("37", sheet)
+        self.assertEqual(self.inventory.on_hand("BR-1042"), 37)
+
+    def test_each_line_ends_with_empty_count_column(self):
+        for line in count_sheet(self.inventory).splitlines():
+            self.assertTrue(line.endswith("_" * 10), line)
+
+    def test_sku_and_name_and_unit_appear(self):
+        sheet = count_sheet(self.inventory)
+        self.assertIn("BR-2000", sheet)
+        self.assertIn("Hex bolt 1/4in", sheet)
+        self.assertIn("box", sheet)
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_missing_catalog_is_an_error(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
