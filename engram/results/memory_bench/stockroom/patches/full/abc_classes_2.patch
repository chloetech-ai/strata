+"""Stock analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and classed by the running share of the grand total:
+    'A' up to and including 80%, 'B' up to and including 95%, otherwise 'C'.
+    """
+    if not values:
+        return {}
+    if any(v < 0 for v in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    if total == 0:
+        raise ValueError("total consumption value must be positive")
+
+    classes = {}
+    running = 0
+    # Ties go in SKU order so the result doesn't depend on dict order.
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        running += value
+        # Compare without dividing: running / total <= 0.80 is running * 100 <= 80 * total.
+        if running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
