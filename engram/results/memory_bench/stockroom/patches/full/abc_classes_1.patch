+"""ABC analysis of stock by annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to 'A', 'B' or 'C' by its share of total consumption value.
+
+    `values` maps SKU to annual consumption value. Walking down from the
+    highest value, a SKU is 'A' while the running total up to and including
+    it is at most 80% of the grand total, 'B' while it is at most 95%, and
+    'C' after that.
+    """
+    if not values:
+        return {}
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    if total <= 0:
+        raise ValueError("total consumption value must be positive")
+
+    classes = {}
+    running = 0
+    # Ties are ordered by SKU so the result is the same on every run.
+    for sku, value in sorted(values.items(), key=lambda pair: (-pair[1], pair[0])):
+        running += value
+        # Compare by cross-multiplying to avoid float rounding at the 80% and 95% edges.
+        if running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..7aade59
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,35 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Shares, highest first: 80%, 15%, 5%. Running totals: 80, 95, 100.
+        values = {"BR-1": 15, "BR-2": 80, "BR-3": 5}
+        self.assertEqual(abc_classes(values), {"BR-2": "A", "BR-1": "B", "BR-3": "C"})
+
+    def test_boundary_at_exactly_80_and_95_percent(self):
+        # Running totals: 50, 80 (exactly 80%), 90, 95 (exactly 95%), 100.
+        values = {"A1": 50, "A2": 30, "B1": 10, "B2": 5, "C1": 5}
+        classes = abc_classes(values)
+        self.assertEqual(classes["A1"], "A")
+        self.assertEqual(classes["A2"], "A")
+        self.assertEqual(classes["B1"], "B")
+        self.assertEqual(classes["B2"], "B")
+        self.assertEqual(classes["C1"], "C")
+
+    def test_rejects_negative_values(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": -1, "BR-2": 5})
+
+    def test_rejects_zero_total(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 0, "BR-2": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
