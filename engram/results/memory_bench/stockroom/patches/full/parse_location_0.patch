+from stockroom.items import Catalog, Item, normalize_sku, parse_location
+
+
+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_accepts_lowercase_and_whitespace(self):
+        self.assertEqual(parse_location(" b-12-3 "), ("B", 12, 3))
+
+    def test_sorts_bays_numerically(self):
+        self.assertEqual(parse_location("B-2-1")[1], 2)
+        self.assertLess(parse_location("B-2-1")[1], parse_location("B-12-3")[1])
+
+    def test_rejects_anything_else(self):
+        for code in ["", "B-12", "BB-12-3", "1-12-3", "B-x-3", "B-12-", "B--12-3", "B-12-3-1", "B-1.5-3", "B 12 3"]:
+            with self.assertRaises(ValueError, msg=code):
+                parse_location(code)
 
 
