@@ -0,0 +1,51 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-1042", "Hex bolt M8x40", "B-12-3", unit="pcs"),
+        Item("BR-2210", "Washer", "B-2-1", unit="pcs"),
+        Item("BR-0007", "Hinge", "A-01-1", unit="pair"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1042", 4321, 12, DAY)
+    inv.receive("BR-2210", 9876, 3, DAY)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_lists_items_in_walking_order(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        skus = [line.split()[1] for line in lines[1:]]
+        self.assertEqual(skus, ["BR-0007", "BR-2210", "BR-1042"])
+
+    def test_never_shows_quantities_on_hand(self):
+        text = count_sheet(make_inventory())
+        self.assertNotIn("4321", text)
+        self.assertNotIn("9876", text)
+
+    def test_counted_column_is_blank(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertTrue(lines[0].endswith("Counted"))
+        for line in lines[1:]:
+            self.assertEqual(line, line.rstrip())
+            self.assertIn(line.split()[-1], ["pcs", "pair"])
+
+    def test_one_line_per_item_plus_header(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 1 + 3)
+
+    def test_requires_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
