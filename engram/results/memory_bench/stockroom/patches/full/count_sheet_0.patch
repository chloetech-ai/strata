@@ -0,0 +1,31 @@
+"""Blind count sheet for the stock-take: lists items in walking order, never quantities on hand."""
+
+HEADER = ["Location", "SKU", "Name", "Unit", "Counted"]
+
+
+def _walk_key(location):
+    """Sort key for "aisle-bay-shelf" codes: numeric parts compare as numbers, so B-2-1 comes before B-12-3."""
+    return tuple(
+        (0, int(part), "") if part.isdigit() else (1, 0, part.upper())
+        for part in location.split("-")
+    )
+
+
+def count_sheet(inventory):
+    """The count sheet as text: a header, then one line per catalog item in bin walking order.
+
+    The "Counted" column is left blank for staff to write in.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count against")
+    items = sorted(inventory.catalog, key=lambda item: (_walk_key(item.location), item.sku))
+    rows = [(item.location, item.sku, item.name, item.unit) for item in items]
+
+    widths = [max([len(HEADER[i])] + [len(row[i]) for row in rows]) for i in range(4)]
+
+    def line(cells):
+        return "  ".join(cell.ljust(width) for cell, width in zip(cells, widths))
+
+    lines = [line(HEADER[:4]) + "  " + HEADER[4]]
+    lines += [line(row).rstrip() for row in rows]
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
