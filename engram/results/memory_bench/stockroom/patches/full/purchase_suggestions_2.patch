+def inventory_with(*rows):
+    """rows: (sku, reorder_point, case_size, on_hand)"""
+    catalog = Catalog([Item(sku, sku, "A-01-1", reorder_point=rp, case_size=cs) for sku, rp, cs, _ in rows])
+    inv = Inventory(catalog)
+    for sku, _, _, qty in rows:
+        if qty > 0:
+            inv.receive(sku, qty, 10, DAY)
+        elif qty < 0:
+            inv.issue(sku, -qty, DAY)
+    return inv
+
+
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        inv = inventory_with(("BR-1", 10, 1, 5))
+        self.assertEqual(suggest_orders(inv), {"BR-1": 25})
+
+    def test_rounds_up_to_whole_cases(self):
+        inv = inventory_with(("BR-1", 10, 12, 5))
+        self.assertEqual(suggest_orders(inv), {"BR-1": 36})
+
+    def test_at_reorder_point_is_ordered(self):
+        inv = inventory_with(("BR-1", 10, 1, 10))
+        self.assertEqual(suggest_orders(inv), {"BR-1": 20})
+
+    def test_negative_stock_is_ordered_back_up(self):
+        inv = inventory_with(("BR-1", 10, 1, -3))
+        self.assertEqual(suggest_orders(inv), {"BR-1": 33})
+
+    def test_no_order_when_stock_is_fine(self):
+        inv = inventory_with(("BR-1", 10, 1, 11), ("BR-2", 10, 1, 40))
+        self.assertEqual(suggest_orders(inv), {})
+
+    def test_zero_reorder_point_with_no_stock_is_not_ordered(self):
+        inv = inventory_with(("BR-1", 0, 1, 0))
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
