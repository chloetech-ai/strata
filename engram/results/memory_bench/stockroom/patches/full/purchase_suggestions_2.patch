         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU at or below its reorder point.
+
+    Orders up to three times the reorder point, rounded up to whole cases.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        short = 3 * item.reorder_point - inventory.on_hand(sku)
+        cases = -(-short // item.case_size)  # ceiling division
+        qty = cases * item.case_size
+        if qty > 0:
+            orders[sku] = qty
+    return orders
