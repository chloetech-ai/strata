+"""Stock analysis: ABC classification by consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs A, B or C by their share of total annual consumption value.
+
+    `values` maps SKU to annual consumption value (non-negative). SKUs are
+    taken highest value first, with a running total. A SKU is 'A' while the
+    cumulative share up to and including it is at most 80%, 'B' while it is
+    at most 95%, and 'C' otherwise. Ties on value are ordered by SKU.
+    """
+    for sku, value in values.items():
+        if value < 0:
+            raise ValueError("consumption value must not be negative: %s" % (sku,))
+    total = sum(values.values())
+    ordered = sorted(values.items(), key=lambda item: (-item[1], item[0]))
+
+    classes = {}
+    cumulative = 0
+    for sku, value in ordered:
+        cumulative += value
+        # Compare cross-multiplied so 80% and 95% are exact, with no division
+        # (which would also fail when every value is zero).
+        if cumulative * 5 <= total * 4:
+            classes[sku] = "A"
+        elif cumulative * 20 <= total * 19:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..a0c3ff8
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,37 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_classes_by_cumulative_share(self):
+        # Shares: 50%, 30%, 15%, 5%. Running totals: 50, 80, 95, 100.
+        values = {"BR-1": 50, "BR-2": 30, "BR-3": 15, "BR-4": 5}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"})
+
+    def test_boundaries_are_inclusive(self):
+        # Running total lands exactly on 80 and 95 of 100.
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_sku_crossing_80_percent_is_b(self):
+        # X alone is 85%, so its cumulative share is above 80%.
+        self.assertEqual(abc_classes({"X": 85, "Y": 15}), {"X": "B", "Y": "C"})
+
+    def test_ties_ordered_by_sku(self):
+        values = {"BR-2": 10, "BR-1": 10}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "C"})
+
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_all_zero_values(self):
+        self.assertEqual(abc_classes({"X": 0, "Y": 0}), {"X": "A", "Y": "A"})
+
+    def test_negative_value_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"X": 10, "Y": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
