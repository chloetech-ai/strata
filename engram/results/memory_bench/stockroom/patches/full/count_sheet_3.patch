@@ -0,0 +1,43 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-1042", "Hex bolt M8x40", "A-10-1"),
+        Item("BR-2210", "Washer", "A-2-1"),
+        Item("BR-3001", "Wood screw", "B-1-1"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1042", 7319, 12, DAY)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_lines_in_bin_walking_order(self):
+        lines = count_sheet(make_inventory()).splitlines()[2:]
+        self.assertEqual([line.split()[0] for line in lines], ["A-2-1", "A-10-1", "B-1-1"])
+
+    def test_one_line_per_item_with_blank_count_column(self):
+        lines = count_sheet(make_inventory()).splitlines()[2:]
+        self.assertEqual(len(lines), 3)
+        for line in lines:
+            self.assertTrue(line.endswith("_" * 10))
+
+    def test_does_not_show_quantity_on_hand(self):
+        text = count_sheet(make_inventory())
+        self.assertNotIn("7319", text)
+
+    def test_requires_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
