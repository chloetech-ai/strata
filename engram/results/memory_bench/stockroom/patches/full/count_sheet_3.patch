+"""Printable blind count sheet, in bin walking order.
+
+The sheet shows what to count and where, but never the quantity on hand,
+so people count the stock rather than copy the system's number.
+"""
+
+COUNT_WIDTH = 10
+
+
+def _walk_key(location):
+    # Compare bin parts as numbers, so "A-2-1" walks before "A-10-1".
+    return [(0, int(part), "") if part.isdigit() else (1, 0, part) for part in location.split("-")]
+
+
+def count_sheet(inventory):
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog")
+    items = sorted(inventory.catalog, key=lambda item: (_walk_key(item.location), item.sku))
+
+    loc_w = max([len("Location")] + [len(item.location) for item in items])
+    sku_w = max([len("SKU")] + [len(item.sku) for item in items])
+    name_w = max([len("Item")] + [len(item.name) for item in items])
+
+    lines = ["%-*s  %-*s  %-*s  %s" % (loc_w, "Location", sku_w, "SKU", name_w, "Item", "Counted")]
+    lines.append("-" * (loc_w + sku_w + name_w + COUNT_WIDTH + 6))
+    for item in items:
+        lines.append("%-*s  %-*s  %-*s  %s" % (
+            loc_w, item.location, sku_w, item.sku, name_w, item.name, "_" * COUNT_WIDTH))
+    return "\n".join(lines) + "\n"
