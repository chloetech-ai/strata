+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -29,5 +29,27 @@ class ReorderTest(unittest.TestCase):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
 
+class SuggestOrdersTest(unittest.TestCase):
+    def test_tops_up_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        # BR-1 has 5 of 10: 30 - 5 = 25. BR-2 has 10 of 10: 30 - 10 = 20.
+        self.assertEqual(orders, {"BR-1": 25, "BR-2": 20})
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=6)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # 30 - 5 = 25 needed, which is 5 cases of 6 = 30.
+        self.assertEqual(suggest_orders(inv), {"BR-1": 30})
+
+    def test_items_not_needing_reorder_are_left_out(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_nothing_to_order_is_left_out(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=0)])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
