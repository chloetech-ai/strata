@@ -0,0 +1,35 @@
+"""Stock valuation at FIFO cost."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed first in, first out.
+
+    Each receipt is a layer of (quantity, unit cost). Issues take from the oldest
+    layers. A negative balance is not valued; the next receipts settle it first.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [quantity, unit_cost], oldest first
+    owed = 0  # units issued without stock to take them from
+    # sorted() is stable, so movements on the same day keep their log order.
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            qty = m.qty
+            settled = min(owed, qty)
+            owed -= settled
+            qty -= settled
+            if qty:
+                layers.append([qty, m.unit_cost or 0])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            owed += remaining
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..953d946
