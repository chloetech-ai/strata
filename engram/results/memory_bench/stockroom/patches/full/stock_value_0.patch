+++ b/tests/test_valuation.py
@@ -0,0 +1,57 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+D1 = datetime.date(2026, 9, 1)
+D2 = datetime.date(2026, 9, 2)
+D3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_fifo_takes_oldest_receipts_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 10, D1)
+        inv.receive("BR-1042", 10, 20, D2)
+        inv.issue("BR-1042", 15, D3)
+        # 5 left, all from the second receipt at 20 each
+        self.assertEqual(stock_value(inv, "BR-1042"), 100)
+
+    def test_other_skus_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 10, D1)
+        inv.receive("BR-2210", 5, 30, D1)
+        self.assertEqual(stock_value(inv, "br-1042 "), 100)
+
+    def test_receipts_valued_in_date_order_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 20, D2)
+        inv.receive("BR-1042", 10, 10, D1)
+        inv.issue("BR-1042", 5, D3)
+        # The 10-cost receipt is older, so the sale takes from it: 5 left at 10 + 10 at 20
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 10 + 10 * 20)
+
+    def test_negative_stock_is_settled_by_next_receipt(self):
+        inv = Inventory()
+        inv.issue("BR-1042", 5, D1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+        inv.receive("BR-1042", 10, 12, D2)
+        # on hand is 5, and those 5 are valued at 12 each
+        self.assertEqual(inv.on_hand("BR-1042"), 5)
+        self.assertEqual(stock_value(inv, "BR-1042"), 60)
+
+    def test_damage_consumes_oldest_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 10, D1)
+        inv.receive("BR-1042", 10, 20, D2)
+        inv.adjust("BR-1042", -12, "DAMAGE", D3)
+        # 12 out: all 10 from the first layer, 2 from the second
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 20)
+
+
+if __name__ == "__main__":
+    unittest.main()
