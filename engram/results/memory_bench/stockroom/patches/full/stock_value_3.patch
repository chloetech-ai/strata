+++ b/tests/test_valuation.py
@@ -0,0 +1,65 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+D1 = datetime.date(2026, 9, 1)
+D2 = datetime.date(2026, 9, 2)
+D3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_fifo_sale_takes_oldest_layer_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, D1)
+        inv.receive("BR-1042", 10, 15, D2)
+        inv.issue("BR-1042", 15, D3)
+        # 10 at 12 are gone, 5 at 15 remain
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 15)
+
+    def test_no_sales_values_every_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, D1)
+        inv.receive("BR-1042", 4, 15, D2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 12 + 4 * 15)
+
+    def test_receipts_are_consumed_by_date_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 15, D2)
+        inv.receive("BR-1042", 10, 12, D1)  # back-dated, so it is older
+        inv.issue("BR-1042", 10, D3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 15)
+
+    def test_negative_stock_has_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, D1)
+        inv.issue("BR-1042", 8, D2)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_oversold_then_received_values_new_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, D1)
+        inv.issue("BR-1042", 8, D2)  # 3 short
+        inv.receive("BR-1042", 6, 20, D3)
+        # The later receipt is not used up by the earlier shortfall.
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 20)
+
+    def test_sku_spellings_match(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 10, D1)
+        self.assertEqual(stock_value(inv, " br-1042 "), 20)
+
+    def test_unit_cost_missing_on_return_values_at_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, D1)
+        inv.adjust("BR-1042", 2, "RETURN", D2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 12)
+
+
+if __name__ == "__main__":
+    unittest.main()
