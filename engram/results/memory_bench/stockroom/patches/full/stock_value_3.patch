+"""Stock valuation, FIFO: each sale takes the oldest unsold receipts first."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Receipts form cost layers. Outgoing movements consume layers oldest
+    first, in date order, keeping log order for movements on the same date.
+    Quantity sold beyond what was received has no layer to consume and adds
+    nothing. Positive adjustments without a unit cost are valued at zero.
+    """
+    movements = sorted(inventory.movements_for(normalize_sku(sku)), key=lambda m: m.date)
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in movements:
+        if m.qty > 0:
+            layers.append([m.qty, m.unit_cost or 0])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(layers[0][0], remaining)
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..30bc112
