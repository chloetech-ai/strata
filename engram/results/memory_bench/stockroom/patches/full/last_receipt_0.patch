+    def test_last_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        newer = inv.receive(" br-1042", 5, 13, DAY + datetime.timedelta(days=1))
+        self.assertIs(inv.last_receipt("BR-1042"), newer)
+
+    def test_last_receipt_uses_date_not_log_order(self):
+        inv = Inventory()
+        later = inv.receive("BR-1042", 10, 12, DAY + datetime.timedelta(days=5))
+        inv.receive("BR-1042", 3, 11, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
+    def test_last_receipt_ignores_other_reasons(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.adjust("BR-1042", 2, "RETURN", DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
