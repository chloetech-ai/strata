--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,29 @@
+"""Reading the handheld scanners' count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is `bin;sku;qty` with no header. A SKU may appear on several
+    lines (overflow bins), and its quantities are added together.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError("line %d: expected bin;sku;qty, got %r" % (number, line.rstrip("\r\n")))
+            _bin, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError("line %d: quantity %r is not a whole number" % (number, qty))
+            if qty < 0:
+                raise ValueError("line %d: counted quantity cannot be negative, got %d" % (number, qty))
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..5b3e8ed
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,43 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_reads_counts_per_sku(self):
+        counts = self.read("A-01-1;BR-1042;12\nA-01-2;BR-2210;5\n")
+        self.assertEqual(counts, {"BR-1042": 12, "BR-2210": 5})
+
+    def test_adds_up_overflow_bins(self):
+        counts = self.read("A-01-1;BR-1042;12\nZ-09-9;BR-1042;30\n")
+        self.assertEqual(counts, {"BR-1042": 42})
+
+    def test_normalizes_sku_and_skips_blank_lines(self):
+        counts = self.read("A-01-1; br-1042 ;3\r\n\nA-01-1;BR-1042;4\r\n")
+        self.assertEqual(counts, {"BR-1042": 7})
+
+    def test_bad_quantity_reports_line(self):
+        with self.assertRaises(ValueError) as ctx:
+            self.read("A-01-1;BR-1042;12\nA-01-2;BR-2210;many\n")
+        self.assertIn("line 2", str(ctx.exception))
+
+    def test_wrong_column_count_rejected(self):
+        with self.assertRaises(ValueError):
+            self.read("A-01-1;BR-1042\n")
+
+    def test_negative_count_rejected(self):
+        with self.assertRaises(ValueError):
+            self.read("A-01-1;BR-1042;-1\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
