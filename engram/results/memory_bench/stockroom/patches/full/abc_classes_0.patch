+"""Stock analysis: ABC classification by annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to 'A', 'B' or 'C' by its share of total annual consumption value.
+
+    SKUs are ranked highest value first. A SKU is 'A' while the cumulative share,
+    including itself, is at most 80%, 'B' while it is at most 95%, and 'C' otherwise.
+    If every value is zero, no share can be computed and every SKU is 'C'.
+    """
+    if any(value < 0 for value in values.values()):
+        raise ValueError("annual consumption values must not be negative")
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if total == 0:
+            classes[sku] = "C"
+        elif running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..e4365f9
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,37 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Total 100: BR-1 alone is 50%, BR-2 brings it to 75%, BR-3 to 90%,
+        # BR-4 to 97%, BR-5 to 100%.
+        values = {"BR-1": 50, "BR-2": 25, "BR-3": 15, "BR-4": 7, "BR-5": 3}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C", "BR-5": "C"},
+        )
+
+    def test_sku_crossing_80_percent_is_a(self):
+        # BR-2 takes the running total to exactly 80%, which counts as A.
+        # BR-3 reaches exactly 95%, which counts as B; BR-4 reaches 100%.
+        values = {"BR-1": 60, "BR-2": 20, "BR-3": 15, "BR-4": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_all_zero_values_are_c(self):
+        self.assertEqual(abc_classes({"BR-1": 0, "BR-2": 0}), {"BR-1": "C", "BR-2": "C"})
+
+    def test_negative_value_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": -5, "BR-2": 10})
+
+
+if __name__ == "__main__":
+    unittest.main()
