--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,26 @@
+"""Reading the handheld scanner export: one `bin;sku;qty` line per count."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU. A SKU on several lines, e.g. across overflow bins, is summed."""
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, 1):
+            line = line.rstrip("\r\n")
+            if not line.strip():
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError("line %d: expected bin;sku;qty, got %r" % (number, line))
+            _bin, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError("line %d: quantity %r is not a whole number" % (number, qty))
+            if qty < 0:
+                raise ValueError("line %d: quantity must not be negative, got %d" % (number, qty))
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..99664cd
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,45 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_reads_counts_per_sku(self):
+        counts = self.read("C-03-2;BR-1042;40\nA-01-1;BR-2210;7\n")
+        self.assertEqual(counts, {"BR-1042": 40, "BR-2210": 7})
+
+    def test_sums_sku_across_overflow_bins(self):
+        counts = self.read("C-03-2;BR-1042;40\nZ-09-9;BR-1042;12\n")
+        self.assertEqual(counts, {"BR-1042": 52})
+
+    def test_normalizes_sku_and_skips_blank_lines(self):
+        counts = self.read("C-03-2; br-1042 ;5\n\nC-03-2;BR-1042;1\r\n")
+        self.assertEqual(counts, {"BR-1042": 6})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self.read("C-03-2;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_wrong_field_count_rejected(self):
+        with self.assertRaises(ValueError):
+            self.read("C-03-2;BR-1042\n")
+
+    def test_bad_quantity_rejected(self):
+        with self.assertRaises(ValueError):
+            self.read("C-03-2;BR-1042;many\n")
+
+    def test_negative_quantity_rejected(self):
+        with self.assertRaises(ValueError):
+            self.read("C-03-2;BR-1042;-3\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
