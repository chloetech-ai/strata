+        inv.receive("BR-1042", 20, 13, datetime.date(2026, 9, 1))
+        inv.issue("BR-1042", 3, datetime.date(2026, 9, 9))
+        self.assertEqual(inv.last_receipt("br-1042").unit_cost, 12)
+
+    def test_last_receipt_tie_goes_to_later_entry(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 20, 13, DAY)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 20)
+
+    def test_last_receipt_none_without_receipts(self):
