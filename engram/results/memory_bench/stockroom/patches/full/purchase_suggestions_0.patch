+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 10, 5)  # at the reorder point
+        self.assertEqual(suggest_orders(inv), {"BR-1": 20})
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=6)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 5)  # shortfall 25, so 5 cases of 6
+        self.assertEqual(suggest_orders(inv), {"BR-1": 30})
+
+    def test_negative_stock_counts_toward_shortfall(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.issue("BR-1", 3)  # on hand -3
+        self.assertEqual(suggest_orders(inv), {"BR-1": 33})
+
+    def test_items_not_needing_reorder_are_left_out(self):
+        catalog = Catalog([
+            Item("BR-1", "Bolt", "A-01-1", reorder_point=10),
+            Item("BR-2", "Nut", "A-01-2", reorder_point=10),
+        ])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 4, 5)
+        inv.receive("BR-2", 50, 5)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 26})
+
+    def test_zero_reorder_point_with_no_stock_orders_nothing(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=0)])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
+
+
 if __name__ == "__main__":
     unittest.main()
