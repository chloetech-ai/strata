@@ -0,0 +1,50 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-1042", "Hex bolt M8x40", "B-12-3"),
+        Item("BR-2210", "Washer", "B-2-1"),
+        Item("BR-0500", "Nut", "A-01-1"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1042", 4321, 12, DAY)
+    return inv
+
+
+def data_lines(text):
+    return text.splitlines()[1:]
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_walking_order_by_location_with_numbers_compared_as_numbers(self):
+        lines = data_lines(count_sheet(make_inventory()))
+        skus = [line.split()[1] for line in lines]
+        self.assertEqual(skus, ["BR-0500", "BR-2210", "BR-1042"])
+
+    def test_one_line_per_item_after_header(self):
+        self.assertEqual(len(data_lines(count_sheet(make_inventory()))), 3)
+
+    def test_does_not_show_system_quantities(self):
+        text = count_sheet(make_inventory())
+        self.assertNotIn("4321", text)
+        self.assertNotIn("-4321", text)
+
+    def test_counted_column_is_blank_write_in(self):
+        for line in data_lines(count_sheet(make_inventory())):
+            self.assertTrue(line.endswith("________"))
+
+    def test_requires_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
