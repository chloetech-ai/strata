+"""The blind count sheet for the stock-take.
+
+Lines are in walking order by bin location. The sheet never shows what the
+system thinks is on hand, only a blank column for the count.
+"""
+
+LINE = "%-12s %-12s %-30s %s"
+WRITE_IN = "________"
+
+
+def _location_key(location):
+    # "B-2-1" sorts before "B-12-3": numeric parts compare as numbers.
+    return tuple(
+        (0, int(part), "") if part.isdigit() else (1, 0, part.upper())
+        for part in location.split("-")
+    )
+
+
+def count_sheet(inventory):
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count against")
+    items = sorted(inventory.catalog, key=lambda item: (_location_key(item.location), item.sku))
+    lines = [LINE % ("LOCATION", "SKU", "NAME", "COUNTED")]
+    for item in items:
+        lines.append(LINE % (item.location, item.sku, item.name, WRITE_IN))
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
