+class SuggestOrdersTest(unittest.TestCase):
+    def inventory(self, on_hand, reorder_point, case_size):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=reorder_point, case_size=case_size)])
+        inv = Inventory(catalog)
+        if on_hand > 0:
+            inv.receive("BR-1", on_hand, 10)
+        elif on_hand < 0:
+            inv.issue("BR-1", -on_hand)
+        return inv
+
+    def test_orders_up_to_three_times_reorder_point(self):
+        self.assertEqual(suggest_orders(self.inventory(5, 10, 1)), {"BR-1": 25})
+
+    def test_rounds_up_to_whole_cases(self):
+        # target 30, on hand 10: 20 short, 2 cases of 12
+        self.assertEqual(suggest_orders(self.inventory(10, 10, 12)), {"BR-1": 24})
+
+    def test_exact_case_multiple(self):
+        self.assertEqual(suggest_orders(self.inventory(0, 10, 10)), {"BR-1": 30})
+
+    def test_negative_stock_increases_order(self):
+        self.assertEqual(suggest_orders(self.inventory(-2, 10, 10)), {"BR-1": 40})
+
+    def test_no_order_when_stock_is_above_reorder_point(self):
+        self.assertEqual(suggest_orders(self.inventory(11, 10, 1)), {})
+
+    def test_zero_reorder_point_gives_no_order(self):
+        self.assertEqual(suggest_orders(self.inventory(0, 0, 6)), {})
+
+
 if __name__ == "__main__":
     unittest.main()
