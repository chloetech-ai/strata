@@ -60,6 +60,14 @@ class Inventory:
         sku = normalize_sku(sku)
         return sum(m.qty for m in self.movements if m.sku == sku)
 
+    def last_receipt(self, sku):
+        """Latest RECEIPT for a SKU by date; on a tie, the one logged last. None if there is none."""
+        sku = normalize_sku(sku)
+        receipts = [m for m in self.movements if m.sku == sku and m.reason == "RECEIPT"]
+        if not receipts:
+            return None
+        return max(reversed(receipts), key=lambda m: m.date)
+
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
