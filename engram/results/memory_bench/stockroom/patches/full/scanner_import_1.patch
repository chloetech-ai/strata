index 0000000..de2521f
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,29 @@
+"""Reading the counts exported by the handheld scanners."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a `bin;sku;qty` export, summed across bins.
+
+    The file has no header line. Blank lines are skipped. Raises ValueError,
+    naming the line, for a malformed line or a negative count.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError("line %d: expected bin;sku;qty, got %r" % (number, line.rstrip("\r\n")))
+            _bin, sku, qty_text = (field.strip() for field in fields)
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError("line %d: quantity %r is not a whole number" % (number, qty_text))
+            if qty < 0:
+                raise ValueError("line %d: count must not be negative, got %d" % (number, qty))
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..2338bae
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,46 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_counts_per_sku(self):
+        counts = self.read("A-01-1;BR-1042;12\nB-03-2;BR-2210;5\n")
+        self.assertEqual(counts, {"BR-1042": 12, "BR-2210": 5})
+
+    def test_same_sku_in_overflow_bins_is_summed(self):
+        counts = self.read("A-01-1;BR-1042;12\nZ-09-9;BR-1042;30\n")
+        self.assertEqual(counts, {"BR-1042": 42})
+
+    def test_sku_spellings_are_normalized(self):
+        counts = self.read(" A-01-1 ; br-1042 ;4\nA-01-1;BR-1042 ;6\n")
+        self.assertEqual(counts, {"BR-1042": 10})
+
+    def test_blank_lines_skipped_and_empty_file_is_empty(self):
+        self.assertEqual(self.read("\nA-01-1;BR-1042;3\n\n"), {"BR-1042": 3})
+        self.assertEqual(self.read(""), {})
+
+    def test_malformed_line_names_line_number(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self.read("A-01-1;BR-1042;3\nA-01-1;BR-1042\n")
+
+    def test_non_integer_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("A-01-1;BR-1042;three\n")
+
+    def test_negative_count_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("A-01-1;BR-1042;-2\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
