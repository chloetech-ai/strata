+    def test_write_off_takes_stock_out_as_damage(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        movement = inv.write_off("BR-1042", 3, DAY)
+        self.assertEqual(movement.qty, -3)
+        self.assertEqual(movement.reason, "DAMAGE")
+        self.assertIsNone(movement.unit_cost)
+        self.assertEqual(movement.date, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_defaults_to_today(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(inv.write_off("BR-1042", 1).date, datetime.date.today())
+
+    def test_write_off_quantity_must_be_positive(self):
+        inv = Inventory()
+        for bad in [0, -2]:
+            with self.subTest(qty=bad):
+                with self.assertRaises(ValueError):
+                    inv.write_off("BR-1042", bad)
+        self.assertEqual(inv.movements, [])
+
+    def test_write_off_normalizes_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.write_off(" br-1042", 4, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 6)
+        self.assertEqual(inv.movements_for("br-1042")[-1].sku, "BR-1042")
+
+    def test_write_off_can_take_stock_negative(self):
