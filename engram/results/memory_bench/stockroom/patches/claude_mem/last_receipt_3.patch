+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_picks_latest_date_not_latest_entry(self):
+        inv = Inventory()
+        newer = inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 10))
+        inv.receive("BR-1042", 4, 11, datetime.date(2026, 9, 2))  # backdated entry
+        self.assertIs(inv.last_receipt("BR-1042"), newer)
+
+    def test_last_receipt_ties_go_to_later_entry(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        later = inv.receive("BR-1042", 4, 11, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
+    def test_last_receipt_ignores_issues_and_other_skus(self):
+        inv = Inventory()
+        receipt = inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 3, datetime.date(2026, 9, 20))
+        inv.receive("BR-2210", 5, 30, datetime.date(2026, 9, 25))
+        self.assertIs(inv.last_receipt(" br-1042"), receipt)
+
