+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        movement = inv.write_off(" br-1042", 3, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+        self.assertEqual((movement.sku, movement.qty, movement.reason), ("BR-1042", -3, "DAMAGE"))
+        self.assertIsNone(movement.unit_cost)
