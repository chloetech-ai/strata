+"""Stock valuation at cost, FIFO: sales consume the oldest receipts first."""
+
+from collections import deque
+
+from .inventory import Inventory
+
+
+def stock_value(inventory: Inventory, sku) -> int:
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each receipt opens a lot of (quantity, unit cost). Each sale removes units
+    from the oldest lots first. Any sale beyond the lots on hand (negative stock)
+    has nothing left to cost, so it leaves the remaining lots untouched.
+    """
+    lots = deque()  # [remaining qty, unit cost in cents], oldest first
+    for movement in inventory.movements_for(sku):
+        if movement.qty > 0:
+            if movement.unit_cost is None:
+                raise ValueError(f"receipt of {movement.sku} has no unit cost")
+            lots.append([movement.qty, movement.unit_cost])
+            continue
+        to_issue = -movement.qty
+        while to_issue and lots:
+            taken = min(to_issue, lots[0][0])
+            lots[0][0] -= taken
+            to_issue -= taken
+            if lots[0][0] == 0:
+                lots.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in lots)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..623b98e
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,80 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_or_unknown_sku_is_zero(self):
+        inv = Inventory()
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_sales_consume_oldest_lot_first(self):
+        # FIFO: after selling 15, the 5 left are the 200-cent units.
+        # Average cost would give 5 * 150 = 750 instead.
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 200, DAY)
+        inv.issue("BR-1042", 15, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sale_within_oldest_lot_leaves_it_partly(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 200, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100 + 10 * 200)
+
+    def test_fully_sold_out_is_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_negative_stock_has_no_extra_value(self):
+        # Sales beyond stock on hand cost nothing and do not reduce value below zero.
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_receipt_after_negative_stock_is_costed_from_that_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        inv.receive("BR-1042", 4, 300, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 4 * 300)
+
+    def test_sku_variants_hit_same_stock(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 120)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+        self.assertEqual(stock_value(inv, "BR-2210"), 150)
+
+    def test_positive_movement_without_cost_is_rejected(self):
+        # Silently valuing it at zero would understate stock.
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, DAY, "COUNT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
