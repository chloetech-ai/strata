-from stockroom.items import Catalog, Item, normalize_sku
+from stockroom.items import Catalog, Item, normalize_sku, parse_location
+
+
+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_lowercase_aisle_is_uppercased(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  B-12-3\n"), ("B", 12, 3))
+
+    def test_bay_and_shelf_are_ints(self):
+        aisle, bay, shelf = parse_location("C-07-10")
+        self.assertEqual((type(bay), type(shelf)), (int, int))
+        self.assertEqual((bay, shelf), (7, 10))
+
+    def test_malformed_codes_rejected(self):
+        for code in [
+            "",
+            "B-12",
+            "B-12-3-4",
+            "12-3-B",
+            "BB-12-3",
+            "1-12-3",
+            "B-x-3",
+            "B-12-",
+            "B--3",
+            "B-+12-3",
+            "B-12 -3",
+            "B_12_3",
+            "B-12.5-3",
+        ]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
 
 
