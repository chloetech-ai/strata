+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by share of total annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest
+    value first; a SKU is 'A' while the cumulative share up to and including
+    it is at most 80%, 'B' while it is at most 95%, and 'C' otherwise.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ordered = sorted(values.items(), key=lambda kv: (-kv[1], kv[0]))
+    classes = {}
+    running = 0
+    for sku, value in ordered:
+        running += value
+        if running <= 0.80 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
