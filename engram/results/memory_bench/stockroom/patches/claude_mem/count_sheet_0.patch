+"""Printable count sheet for the stock-take.
+
+The sheet is blind: it never shows the system quantity on hand, only an
+empty column for the counted figure, so staff count rather than copy.
+"""
+
+import re
+
+
+def _walking_key(item):
+    """Sort by bin location in natural order (B-2-1 before B-12-3), then SKU."""
+    parts = re.split(r"(\d+)", item.location.upper())
+    # Digit runs sit at odd indexes, so each position always compares like with like.
+    key = tuple(int(part) if i % 2 else part for i, part in enumerate(parts))
+    return key, item.sku
+
+
+def count_sheet(inventory):
+    """One tab-separated line per catalog item, in walking order.
+
+    Columns: bin location, SKU, name, unit, and an empty counted column.
+    """
+    lines = []
+    for item in sorted(inventory.catalog, key=_walking_key):
+        lines.append("\t".join([item.location, item.sku, item.name, item.unit, ""]))
+    return "\n".join(lines) + "\n" if lines else ""
