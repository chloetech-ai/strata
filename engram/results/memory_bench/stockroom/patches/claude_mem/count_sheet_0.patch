+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_bin_order(self):
+        catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8x40", "B-12-3"),
+            Item("NU-7", "Hex nut M8", "B-2-1"),
+            Item("WA-3", "Washer M8", "A-10-1"),
+        ])
+        sheet = count_sheet(Inventory(catalog))
+        self.assertEqual(sheet.splitlines(), [
+            "A-10-1\tWA-3\tWasher M8\tpcs\t",
+            "B-2-1\tNU-7\tHex nut M8\tpcs\t",
+            "B-12-3\tBR-1042\tHex bolt M8x40\tpcs\t",
+        ])
+
+    def test_same_bin_ordered_by_sku(self):
+        catalog = Catalog([
+            Item("ZZ-1", "Zed", "A-1-1"),
+            Item("AA-1", "Ay", "A-1-1"),
+        ])
+        lines = count_sheet(Inventory(catalog)).splitlines()
+        self.assertEqual([line.split("\t")[1] for line in lines], ["AA-1", "ZZ-1"])
+
+    def test_on_hand_quantity_not_printed(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt M8x40", "C-03-2", reorder_point=50)])
+        inventory = Inventory(catalog)
+        inventory.receive("BR-1042", 987654, unit_cost=12)
+        sheet = count_sheet(inventory)
+        self.assertNotIn("987654", sheet)
+        self.assertEqual(sheet.splitlines()[0].split("\t")[-1], "")
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
