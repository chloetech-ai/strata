+"""What stock on hand is worth, valued first-in, first-out."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, FIFO.
+
+    Movements are taken in log order. Each receipt adds a layer of stock at
+    its unit cost, and each outflow uses up the oldest layers first. Units
+    issued before they were received (negative stock) are netted against the
+    next receipts, so the value always matches the quantity on hand.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost], oldest first
+    short = 0  # units issued beyond the stock received so far
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost recorded for {sku} on {m.date.isoformat()}")
+            qty = m.qty
+            netted = min(short, qty)
+            short -= netted
+            qty -= netted
+            if qty:
+                layers.append([qty, m.unit_cost])
+        else:
+            need = -m.qty
+            while need and layers:
+                take = min(need, layers[0][0])
+                layers[0][0] -= take
+                need -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            short += need
+    return sum(qty * unit_cost for qty, unit_cost in layers)
