+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_enough_to_clear_reorder_point(self):
+        # on hand 5, reorder point 10: need 6 to get above 10
+        self.assertEqual(suggest_orders(make_inventory())["BR-1"], 6)
+
+    def test_at_reorder_point_still_orders(self):
+        self.assertEqual(suggest_orders(make_inventory())["BR-2"], 1)
+
+    def test_skips_stocked_skus(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("CS-1", "Case", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("CS-1", 4, 10)
+        # shortfall is 7 units, which is one case of 12
+        self.assertEqual(suggest_orders(inv), {"CS-1": 12})
+
+    def test_multiple_cases(self):
+        catalog = Catalog([Item("CS-2", "Case", "A-02-2", reorder_point=30, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("CS-2", 5, 10)
+        # shortfall is 26 units, which needs three cases of 12
+        self.assertEqual(suggest_orders(inv), {"CS-2": 36})
+
+    def test_negative_stock(self):
+        catalog = Catalog([Item("NG-1", "Neg", "A-03-1", reorder_point=5, case_size=4)])
+        inv = Inventory(catalog)
+        inv.issue("NG-1", 3)
+        # on hand -3, shortfall 9 units, which is three cases of 4
+        self.assertEqual(suggest_orders(inv), {"NG-1": 12})
+
+    def test_empty_when_nothing_needs_reorder(self):
+        catalog = Catalog([Item("OK-1", "Ok", "A-04-1", reorder_point=1)])
+        inv = Inventory(catalog)
+        inv.receive("OK-1", 5, 10)
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
