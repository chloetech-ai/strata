+"""ABC analysis of SKUs by annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify each SKU as A, B or C by its share of total consumption value.
+
+    Walks the SKUs from highest to lowest value, keeping a running total. A SKU
+    is 'A' while the cumulative share up to and including it is at most 80%,
+    'B' while it is at most 95%, and 'C' otherwise.
+    """
+    total = sum(values.values())
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda pair: pair[1], reverse=True):
+        running += value
+        # Compare cross-multiplied so the 80% and 95% boundaries are not
+        # subject to floating-point error from dividing by the total.
+        if running * 100 <= total * 80:
+            classes[sku] = "A"
+        elif running * 100 <= total * 95:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
