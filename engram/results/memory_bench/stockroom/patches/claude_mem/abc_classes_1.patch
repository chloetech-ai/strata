@@ -0,0 +1,37 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: BR-1 (50), BR-2 (30), BR-3 (15), BR-4 (5). Total 100.
+        # Cumulative: 50%, 80%, 95%, 100%.
+        values = {"BR-3": 15, "BR-1": 50, "BR-4": 5, "BR-2": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative shares hit exactly 80% and 95%, which still count as A and B.
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_top_sku_over_80_percent_is_not_a(self):
+        # 90% is over the 80% line, so the top SKU is B. BR-2 reaches 96%, past 95%.
+        values = {"BR-1": 90, "BR-2": 6, "BR-3": 4}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "B", "BR-2": "C", "BR-3": "C"},
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
