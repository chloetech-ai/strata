+"""Printable stock-take count sheet.
+
+The sheet is a blind count: it never shows the quantity on hand, only a blank
+column for the counted figure, so staff count rather than copy the system.
+Lines run in walking order (bin location), not SKU order.
+"""
+
+import re
+
+COUNT_COLUMN_WIDTH = 10
+
+
+def _walk_key(location):
+    """Sort key that orders bin codes like "B-2-1" before "B-10-1"."""
+    parts = re.split(r"(\d+)", location.upper())
+    return [(0, int(p), "") if p.isdigit() else (1, 0, p) for p in parts if p != ""]
+
+
+def count_sheet(inventory):
+    """Blank count sheet as text, one line per catalog item, in walking order."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count against")
+    items = sorted(inventory.catalog, key=lambda item: (_walk_key(item.location), item.sku))
+    lines = []
+    for item in items:
+        lines.append(
+            f"{item.location:<10} {item.sku:<12} {item.name:<24} {item.unit:<6} "
+            + "_" * COUNT_COLUMN_WIDTH
+        )
+    return "\n".join(lines) + "\n" if lines else ""
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
