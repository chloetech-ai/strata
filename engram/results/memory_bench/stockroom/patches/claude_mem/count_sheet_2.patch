@@ -0,0 +1,46 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-3", "Washer", "B-10-1", unit="pcs"),
+        Item("BR-1", "Bolt", "B-2-1", unit="pcs"),
+        Item("NT-9", "Nut", "A-1-1", unit="box"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1", 7, 10)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_catalog_item(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+
+    def test_walking_order_by_bin_location(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual([line.split()[0] for line in lines], ["A-1-1", "B-2-1", "B-10-1"])
+
+    def test_blind_count_hides_on_hand(self):
+        sheet = count_sheet(make_inventory())
+        self.assertNotIn("7", sheet)
+
+    def test_blank_count_column(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        for line in lines:
+            self.assertTrue(line.endswith("_" * 10))
+
+    def test_empty_catalog(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_no_catalog_raises(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
