+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -29,5 +29,34 @@ class ReorderTest(unittest.TestCase):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
 
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_just_above_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 6, "BR-2": 1})
+
+    def test_only_skus_needing_reorder(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=4)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # need 11 - 5 = 6 more, which is two cases of 4
+        self.assertEqual(suggest_orders(inv), {"BR-1": 8})
+
+    def test_negative_stock_is_covered(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=5)])
+        inv = Inventory(catalog)
+        inv.issue("BR-1", 3)
+        # on hand is -3, so 14 are needed, which rounds up to 15
+        self.assertEqual(suggest_orders(inv), {"BR-1": 15})
+
+    def test_no_suggestions_when_stocked(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 11, 10)
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
