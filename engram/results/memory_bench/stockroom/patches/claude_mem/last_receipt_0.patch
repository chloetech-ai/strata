+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.issue("BR-1042", 1, DAY)  # a sale is not a receipt
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_returns_latest_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 1))
+        second = inv.receive("BR-1042", 5, 13, datetime.date(2026, 9, 8))
+        inv.issue("BR-1042", 3, datetime.date(2026, 9, 9))
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
+    def test_last_receipt_uses_date_not_append_order(self):
+        inv = Inventory()
+        later = inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 8))
+        inv.receive("BR-1042", 5, 13, datetime.date(2026, 9, 1))  # backdated entry
+        self.assertIs(inv.last_receipt("BR-1042"), later)
+
+    def test_last_receipt_ties_go_to_last_appended(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 5, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
+
+    def test_last_receipt_ignores_other_skus_and_non_receipt_reasons(self):
+        inv = Inventory()
+        receipt = inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, datetime.date(2026, 9, 20))
+        inv._record(Movement("BR-1042", 2, datetime.date(2026, 9, 25), "RETURN"))
+        self.assertIs(inv.last_receipt("BR-1042"), receipt)
+
+    def test_last_receipt_normalizes_sku(self):
+        inv = Inventory()
+        receipt = inv.receive("br-1042", 10, 12, DAY)
+        self.assertIs(inv.last_receipt(" Br-1042 "), receipt)
+
