index 0000000..491b6ee
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,41 @@
+"""Reading the handheld scanner's count files.
+
+The scanner writes plain text: one line per scan group, semicolon-separated,
+no header, columns bin;sku;qty. A SKU can appear on several lines when it
+overflows into a second bin, so quantities are summed per SKU.
+"""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Return {sku: counted quantity} for a scanner file.
+
+    Raises ValueError with the line number for any malformed line. A bad
+    line is never skipped, because skipping it would undercount stock.
+    """
+    counts = {}
+    # utf-8-sig drops a byte-order mark if the handheld writes one.
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(
+                    f"{path}:{number}: expected 3 fields (bin;sku;qty), got {len(fields)}"
+                )
+            bin_code, sku, qty = (field.strip() for field in fields)
+            if not bin_code:
+                raise ValueError(f"{path}:{number}: missing bin")
+            if not sku:
+                raise ValueError(f"{path}:{number}: missing SKU")
+            try:
+                quantity = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {qty!r}") from None
+            if quantity < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {quantity}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + quantity
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..473cf55
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,84 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self._dir.cleanup)
+
+    def write(self, data, encoding="utf-8"):
+        path = os.path.join(self._dir.name, "count.txt")
+        with open(path, "w", encoding=encoding, newline="") as f:
+            f.write(data)
+        return path
+
+    def test_reads_quantity_per_sku(self):
+        path = self.write("B-12-3;BR-1042;24\nC-01-1;WS-200;6\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 24, "WS-200": 6})
+
+    def test_sums_sku_counted_in_several_bins(self):
+        path = self.write("B-12-3;BR-1042;24\nB-12-4;BR-1042;10\nA-01-1;BR-1042;3\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 37})
+
+    def test_normalizes_sku_so_variants_sum_together(self):
+        path = self.write("B-12-3;br-1042;5\nB-12-4; BR-1042 ;2\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 7})
+
+    def test_zero_count_is_kept(self):
+        path = self.write("B-12-3;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 0})
+
+    def test_blank_lines_and_crlf_are_ignored(self):
+        path = self.write("B-12-3;BR-1042;4\r\n\r\n\nB-12-4;BR-1042;1\r\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 5})
+
+    def test_byte_order_mark_is_ignored(self):
+        path = self.write("﻿B-12-3;BR-1042;4\n", encoding="utf-8")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 4})
+
+    def test_empty_file_gives_no_counts(self):
+        self.assertEqual(read_scanner_file(self.write("")), {})
+
+    def test_wrong_field_count_reports_line(self):
+        path = self.write("B-12-3;BR-1042;4\nBR-1042,4\n")
+        with self.assertRaisesRegex(ValueError, r":2: expected 3 fields"):
+            read_scanner_file(path)
+
+    def test_non_integer_quantity_reports_line(self):
+        path = self.write("B-12-3;BR-1042;four\n")
+        with self.assertRaisesRegex(ValueError, r":1: quantity is not a whole number"):
+            read_scanner_file(path)
+
+    def test_fractional_quantity_rejected(self):
+        path = self.write("B-12-3;BR-1042;2.5\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+    def test_negative_quantity_rejected(self):
+        path = self.write("B-12-3;BR-1042;-1\n")
+        with self.assertRaisesRegex(ValueError, "must not be negative"):
+            read_scanner_file(path)
+
+    def test_missing_sku_rejected(self):
+        path = self.write("B-12-3; ;4\n")
+        with self.assertRaisesRegex(ValueError, "missing SKU"):
+            read_scanner_file(path)
+
+    def test_missing_bin_rejected(self):
+        path = self.write(";BR-1042;4\n")
+        with self.assertRaisesRegex(ValueError, "missing bin"):
+            read_scanner_file(path)
+
+    def test_bad_line_is_not_silently_skipped(self):
+        # A single bad line must fail the whole file, not undercount the SKU.
+        path = self.write("B-12-3;BR-1042;4\nB-12-4;BR-1042;x\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
