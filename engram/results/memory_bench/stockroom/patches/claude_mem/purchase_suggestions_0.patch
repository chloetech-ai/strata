+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,26 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_lifts_stock_above_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders["BR-1"], 6)  # 5 on hand, reorder point 10
+        self.assertEqual(orders["BR-2"], 1)  # 10 on hand, at the reorder point
+
+    def test_suggest_orders_skips_skus_with_enough_stock(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Screw", "A-01-4", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 12})
+
+    def test_suggest_orders_empty_when_nothing_low(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-01-5", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-5", 50, 10)
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
