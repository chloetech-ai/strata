+"""Import counts from handheld scanner files.
+
+A scanner file is plain text with no header, one line per scanned bin:
+
+    bin;sku;qty
+
+A SKU may appear on several lines (for example when it overflows into a
+second bin), so quantities are summed per SKU.
+"""
+
+from collections import defaultdict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Return {SKU: counted quantity}, summed across all lines for that SKU."""
+    counts = defaultdict(int)
+    with open(path, encoding="utf-8", newline="") as handle:
+        for number, line in enumerate(handle, start=1):
+            line = line.strip()
+            if not line:
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line!r}")
+            _bin, sku, qty = (field.strip() for field in fields)
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: missing SKU")
+            try:
+                quantity = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity must be a whole number, got {qty!r}") from None
+            if quantity < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {quantity}")
+            counts[sku] += quantity
+    return dict(counts)
