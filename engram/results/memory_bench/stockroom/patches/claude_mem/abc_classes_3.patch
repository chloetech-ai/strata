+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first (ties broken by SKU). A SKU is 'A' if the cumulative share of
+    the grand total, up to and including it, is at most 80%; 'B' if at most
+    95%; otherwise 'C'. Returns a dict mapping SKU to class.
+    """
+    if not values:
+        return {}
+    if any(v < 0 for v in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    if total == 0:
+        raise ValueError("consumption values must not all be zero")
+
+    out = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        running += value
+        share = running / total
+        if share <= 0.80:
+            out[sku] = "A"
+        elif share <= 0.95:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
