@@ -0,0 +1,47 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        values = {"BR-1": 50, "BR-2": 30, "BR-3": 15, "BR-4": 4, "BR-5": 1}
+        # Cumulative shares: 50%, 80%, 95%, 99%, 100%
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C", "BR-5": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative shares: exactly 80% (A), exactly 95% (B), 100% (C).
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_order_of_input_does_not_matter(self):
+        a = abc_classes({"BR-1": 10, "BR-2": 90})
+        b = abc_classes({"BR-2": 90, "BR-1": 10})
+        self.assertEqual(a, b)
+        # BR-2 alone is 90% (B); BR-1 brings the total to 100% (C).
+        self.assertEqual(a, {"BR-2": "B", "BR-1": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above the 95% cutoff for B.
+        self.assertEqual(abc_classes({"BR-1": 7}), {"BR-1": "C"})
+
+    def test_zero_total_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 0, "BR-2": 0})
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
