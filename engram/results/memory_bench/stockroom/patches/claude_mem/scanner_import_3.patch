+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def _read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8", newline="") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_counts_per_sku(self):
+        counts = self._read("B-12-3;BR-1042;24\nC-01-1;WS-0008;6\n")
+        self.assertEqual(counts, {"BR-1042": 24, "WS-0008": 6})
+
+    def test_same_sku_in_overflow_bins_is_summed(self):
+        counts = self._read("B-12-3;BR-1042;24\nB-12-4;BR-1042;10\nA-01-1;BR-1042;3\n")
+        self.assertEqual(counts, {"BR-1042": 37})
+
+    def test_sku_is_normalized(self):
+        counts = self._read("B-12-3; br-1042 ;5\nB-12-4;BR-1042;2\n")
+        self.assertEqual(counts, {"BR-1042": 7})
+
+    def test_zero_count_kept(self):
+        self.assertEqual(self._read("B-12-3;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_blank_lines_and_crlf_skipped(self):
+        counts = self._read("B-12-3;BR-1042;4\r\n\r\n   \r\nB-12-4;WS-0008;1\r\n")
+        self.assertEqual(counts, {"BR-1042": 4, "WS-0008": 1})
+
+    def test_utf8_bom_tolerated(self):
+        self.assertEqual(self._read("﻿B-12-3;BR-1042;4\n"), {"BR-1042": 4})
+
+    def test_empty_file(self):
+        self.assertEqual(self._read(""), {})
+
+    def test_wrong_field_count_reports_line(self):
+        with self.assertRaisesRegex(ValueError, ":2: expected bin;sku;qty"):
+            self._read("B-12-3;BR-1042;4\nB-12-3,BR-1042,4\n")
+
+    def test_missing_sku_rejected(self):
+        with self.assertRaisesRegex(ValueError, ":1: missing SKU"):
+            self._read("B-12-3; ;4\n")
+
+    def test_non_integer_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity must be a whole number"):
+            self._read("B-12-3;BR-1042;4.5\n")
+
+    def test_negative_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity must not be negative"):
+            self._read("B-12-3;BR-1042;-2\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
