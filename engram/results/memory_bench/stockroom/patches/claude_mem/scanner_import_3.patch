+"""Reading counts from handheld scanner files."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a handheld scanner file.
+
+    Each line is `bin;sku;qty` with no header. A SKU can appear on several
+    lines (overflow bins), so its quantities are summed. Returns a dict from
+    canonical SKU to counted quantity. Blank lines are skipped.
+    """
+    counts = {}
+    with open(path, encoding="utf-8-sig", newline="") as f:
+        for number, line in enumerate(f, start=1):
+            text = line.strip()
+            if not text:
+                continue
+            fields = text.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {text!r}")
+            _, sku, qty_text = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: missing SKU")
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity must be a whole number, got {qty_text.strip()!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
