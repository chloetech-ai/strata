+"""ABC analysis of SKUs by annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by cumulative share of total consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest
+    value first; a SKU is 'A' if the cumulative share up to and including it
+    is at most 80% of the grand total, 'B' if at most 95%, otherwise 'C'.
+    Returns a dict mapping SKU to class; empty input gives an empty dict.
+    """
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    if not values:
+        return {}
+    if total == 0:
+        return {sku: "C" for sku in values}
+
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        share = running / total
+        if share <= 0.80:
+            classes[sku] = "A"
+        elif share <= 0.95:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..37f1581
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,49 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative shares: 80% (A), 95% (B), 100% (C).
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_ranks_highest_value_first(self):
+        values = {"BR-1": 5, "BR-2": 80, "BR-3": 15}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "C", "BR-2": "A", "BR-3": "B"},
+        )
+
+    def test_first_sku_over_threshold_is_included(self):
+        # 70% alone does not reach 80%; adding 20% reaches 90%, which is B.
+        values = {"BR-1": 70, "BR-2": 20, "BR-3": 10}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "B", "BR-3": "C"},
+        )
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above both thresholds.
+        self.assertEqual(abc_classes({"BR-1": 42}), {"BR-1": "C"})
+
+    def test_zero_total_gives_c(self):
+        self.assertEqual(
+            abc_classes({"BR-1": 0, "BR-2": 0}),
+            {"BR-1": "C", "BR-2": "C"},
+        )
+
+    def test_negative_value_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
