@@ -0,0 +1,71 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY1 = datetime.date(2026, 9, 1)
+DAY2 = datetime.date(2026, 9, 2)
+DAY3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_unknown_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-9999"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 125, DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1250)
+
+    def test_costs_remaining_units_first_in_first_out(self):
+        # Average cost would give 15 * 150 = 2250; FIFO keeps 5 @ 100 and 10 @ 200.
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 200, DAY2)
+        inv.issue("BR-1042", 5, DAY3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 100 + 10 * 200)
+
+    def test_issue_spanning_layers_empties_oldest_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.receive("BR-1042", 10, 200, DAY2)
+        inv.issue("BR-1042", 15, DAY3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 200)
+
+    def test_fifo_follows_dates_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 200, DAY2)
+        inv.receive("BR-1042", 10, 100, DAY1)
+        inv.issue("BR-1042", 10, DAY3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 200)
+
+    def test_negative_stock_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY1)
+        inv.issue("BR-1042", 8, DAY2)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_later_receipt_covers_shortfall_before_adding_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY1)
+        inv.issue("BR-1042", 8, DAY2)
+        inv.receive("BR-1042", 5, 300, DAY3)
+        self.assertEqual(inv.on_hand("BR-1042"), 2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 300)
+
+    def test_sku_variants_hit_same_stock(self):
+        inv = Inventory()
+        inv.receive("br-1042", 4, 50, DAY1)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 200)
+
+    def test_receipt_without_unit_cost_is_an_error(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, None, DAY1)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
