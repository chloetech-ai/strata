+"""What the stock on hand is worth."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value of the stock of `sku` on hand, in cents, costed first in, first out.
+
+    Each receipt is a layer at its unit cost. Each outgoing movement takes units
+    from the oldest layer first. Movements are taken by date, ties in log order.
+
+    Stock below zero (issues that outran receipts) has no value, so it counts as 0.
+    A later receipt covers that shortfall before it adds stock. Raises ValueError
+    if an incoming movement has no unit cost.
+    """
+    layers = deque()  # [qty, unit_cost], oldest first
+    short = 0  # units issued before they were received
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for {m.reason} of {m.qty} {m.sku} on {m.date}")
+            qty = m.qty
+            covered = min(short, qty)
+            short -= covered
+            qty -= covered
+            if qty:
+                layers.append([qty, m.unit_cost])
+        else:
+            need = -m.qty
+            while need and layers:
+                take = min(need, layers[0][0])
+                layers[0][0] -= take
+                need -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            short += need
+    return sum(qty * unit_cost for qty, unit_cost in layers)
