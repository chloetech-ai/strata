index 0000000..1210a33
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,42 @@
+"""Reading counts from handheld scanner files.
+
+A scanner file is plain text, one count per line, with no header:
+
+    bin;sku;qty
+
+A SKU may appear on several lines (for example when it overflows into a
+second bin), so the quantities are summed per SKU.
+"""
+
+import re
+
+from .items import normalize_sku
+
+_QTY = re.compile(r"[0-9]+")
+
+
+def read_scanner_file(path):
+    """Return the counted quantity per SKU, as a dict of SKU to int.
+
+    Blank lines are skipped. The bin column is checked for presence but not
+    returned, since the count is per SKU. Raises ValueError with the file
+    and line number for a malformed line.
+    """
+    counts = {}
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        for lineno, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(
+                    f"{path}:{lineno}: expected 3 fields (bin;sku;qty), got {len(fields)}")
+            _bin, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{lineno}: missing SKU")
+            qty = qty.strip()
+            if not _QTY.fullmatch(qty):
+                raise ValueError(f"{path}:{lineno}: quantity must be a whole number, got {qty!r}")
+            counts[sku] = counts.get(sku, 0) + int(qty)
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
