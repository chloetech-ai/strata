+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=50, case_size=100)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 20, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 100})
+
+    def test_suggest_orders_covers_negative_stock(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=6)])
+        inv = Inventory(catalog)
+        inv.issue("BR-1", 3)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 18})
+
+    def test_suggest_orders_empty_when_nothing_low(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 50, 10)
