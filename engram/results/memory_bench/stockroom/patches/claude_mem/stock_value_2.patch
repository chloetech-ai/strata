@@ -0,0 +1,86 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_sales_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 12, DAY)
+        # 10 @ 100 are gone, 8 @ 300 remain.
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 300)
+
+    def test_partial_layer_keeps_its_own_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        inv.receive("BR-1042", 5, 200, DAY)
+        inv.issue("BR-1042", 8, DAY)
+        # 6 @ 100 left, then 5 @ 200 arrive; 8 out takes the 6 @ 100 and 2 @ 200.
+        self.assertEqual(inv.on_hand("BR-1042"), 3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 3 * 200)
+
+    def test_fully_sold_stock_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_negative_stock_is_paid_off_by_later_receipts(self):
+        inv = Inventory()
+        inv.issue("BR-1042", 3, DAY)  # sold before any stock was received
+        inv.receive("BR-1042", 5, 100, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 100)
+
+    def test_stock_still_negative_is_worth_nothing(self):
+        inv = Inventory()
+        inv.issue("BR-1042", 3, DAY)
+        inv.receive("BR-1042", 2, 100, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_value_matches_on_hand_after_mixed_movements(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 100, DAY)
+        inv.issue("BR-1042", 6, DAY)  # takes the 4 @ 100, owes 2
+        inv.receive("BR-1042", 3, 250, DAY)  # pays the 2 owed, 1 @ 250 left
+        inv.issue("BR-1042", 1, DAY)  # takes the 1 @ 250
+        inv.receive("BR-1042", 2, 400, DAY)  # 2 @ 400 left
+        self.assertEqual(inv.on_hand("BR-1042"), 2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 400)
+
+    def test_only_the_given_sku_is_valued(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 5, 300, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_variants_hit_same_stock(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 100, DAY)
+        self.assertEqual(stock_value(inv, " BR-1042 "), 1000)
+
+    def test_receipt_without_unit_cost_is_an_error(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 5, DAY, "RECEIPT", None))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
