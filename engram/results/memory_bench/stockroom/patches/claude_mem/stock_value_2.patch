+"""Stock valuation at cost, first in first out (FIFO)."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value, in cents, of the stock of `sku` currently on hand.
+
+    Each goods-in movement is a cost layer at its unit cost. Each goods-out
+    movement consumes the oldest layers first, in the order they were logged.
+    What remains is valued at the cost of the layers it came from.
+
+    Goods out beyond the layers on hand (negative stock) are carried forward
+    as a shortfall that the next goods-in movements pay off, so the layers
+    always add up to the quantity `on_hand` reports. Negative stock is worth 0.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty remaining, unit cost in cents], oldest first
+    shortfall = 0  # units sold beyond the layers on hand so far
+    for m in inventory.movements:
+        if m.sku != sku:
+            continue
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for {m.reason} of {sku} on {m.date.isoformat()}")
+            qty = m.qty
+            paid = min(shortfall, qty)
+            shortfall -= paid
+            qty -= paid
+            if qty:
+                layers.append([qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+        shortfall += remaining
+    return sum(qty * cost for qty, cost in layers)
