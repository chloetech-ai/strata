+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-2210", "Washer", "C-03-1"),
+        Item("BR-1042", "Bolt", "A-01-2"),
+        Item("BR-0007", "Nut", "A-01-1", unit="box"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1042", 70, 12, DAY)
+    inv.receive("BR-2210", 5, 30, DAY)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_bin_order(self):
+        lines = count_sheet(make_inventory()).split("\n")
+        self.assertEqual(len(lines), 3)
+        self.assertTrue(lines[0].startswith("A-01-1"))
+        self.assertTrue(lines[1].startswith("A-01-2"))
+        self.assertTrue(lines[2].startswith("C-03-1"))
+
+    def test_blind_count_hides_on_hand(self):
+        text = count_sheet(make_inventory())
+        self.assertNotIn("70", text)
+        self.assertNotIn("  5  ", text)
+
+    def test_counted_column_is_blank(self):
+        for line in count_sheet(make_inventory()).split("\n"):
+            self.assertTrue(line.endswith("________"))
+
+    def test_empty_catalog(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
