+"""Printable stock-take count sheet.
+
+The sheet is a blind count: it never shows the system quantity on hand, only
+an empty column for the counted figure, so staff count rather than copy.
+"""
+
+
+def _bin_key(location):
+    """Walking order for bin codes like "B-12-3": numeric parts compare as numbers."""
+    return tuple((0, int(part), "") if part.isdigit() else (1, 0, part)
+                 for part in location.split("-"))
+
+
+def count_sheet(inventory):
+    """The count sheet as text, one line per catalog item, in bin walking order."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to print a count sheet from")
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    lines = [
+        f"{item.location:<8} {item.sku:<12} {item.name:<30} {item.unit:<5} ________"
+        for item in items
+    ]
+    return "\n".join(lines) + "\n" if lines else ""
