+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("BR-1042", "Brass hinge", "B-12-3", unit="pcs"),
+            Item("SC-7", "Wood screw 4x40", "B-2-1", unit="box"),
+            Item("NL-100", "Nail 2in", "A-1-1", unit="kg"),
+        ])
+        self.inv = Inventory(self.catalog)
+        self.inv.receive("BR-1042", 37, 12, DAY)
+
+    def test_one_line_per_catalog_item(self):
+        self.assertEqual(len(count_sheet(self.inv).splitlines()), len(self.catalog))
+
+    def test_lines_in_bin_walking_order_not_sku_order(self):
+        lines = count_sheet(self.inv).splitlines()
+        self.assertEqual([line.split()[1] for line in lines], ["NL-100", "SC-7", "BR-1042"])
+
+    def test_bin_numbers_compare_as_numbers(self):
+        # B-2-1 must walk before B-12-3, which a plain string sort would get wrong
+        lines = count_sheet(self.inv).splitlines()
+        self.assertLess(
+            [i for i, line in enumerate(lines) if "SC-7" in line][0],
+            [i for i, line in enumerate(lines) if "BR-1042" in line][0],
+        )
+
+    def test_blind_count_never_shows_quantity_on_hand(self):
+        sheet = count_sheet(self.inv)
+        self.assertNotIn("37", sheet)
+        self.assertEqual(sheet.count("________"), len(self.catalog))
+
+    def test_line_carries_location_sku_name_unit(self):
+        line = count_sheet(self.inv).splitlines()[2]
+        self.assertTrue(line.startswith("B-12-3"))
+        self.assertIn("BR-1042", line)
+        self.assertIn("Brass hinge", line)
+        self.assertIn("pcs", line)
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_requires_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
