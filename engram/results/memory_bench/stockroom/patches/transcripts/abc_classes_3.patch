diff --git a/src/stockroom/analysis.py b/src/stockroom/analysis.py
new file mode 100644
index 0000000..6154838
--- /dev/null
+++ b/src/stockroom/analysis.py
@@ -0,0 +1,24 @@
+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted highest
+    value first and a running total is kept. A SKU is 'A' if the cumulative
+    share up to and including it is at most 80% of the grand total, 'B' if at
+    most 95%, otherwise 'C'. Returns a dict mapping SKU to class.
+    """
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.80 * total:
+            out[sku] = "A"
+        elif running <= 0.95 * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..f27a168
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,30 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Total 100. Running shares: 50%, 75%, 90%, 97%, 100%.
+        values = {"A1": 50, "A2": 25, "B1": 15, "C1": 7, "C2": 3}
+        self.assertEqual(
+            abc_classes(values),
+            {"A1": "A", "A2": "A", "B1": "B", "C1": "C", "C2": "C"},
+        )
+
+    def test_boundary_at_80_and_95_percent(self):
+        # Running shares: 80% (A, at the limit), 95% (B, at the limit), 100% (C).
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_input_order_does_not_matter(self):
+        values = {"C2": 3, "A1": 50, "B1": 15, "C1": 7, "A2": 25}
+        self.assertEqual(abc_classes(values)["A2"], "A")
+        self.assertEqual(abc_classes(values)["B1"], "B")
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is over both thresholds.
+        self.assertEqual(abc_classes({"ONLY": 10}), {"ONLY": "C"})
