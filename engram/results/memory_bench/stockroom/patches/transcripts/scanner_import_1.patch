+"""Reading the counts exported by the handheld scanners."""
+
+import csv
+
+from .items import normalize_sku
+
+# Columns are read by position: bin;sku;qty, no header line.
+SCANNER_DELIMITER = ";"
+
+
+def read_scanner_file(path):
+    """Total the counted quantity per SKU in a scanner export.
+
+    A SKU may appear on several lines (one per bin, overflow bins included),
+    so the quantities are summed. Returns {normalized SKU: counted qty}.
+    """
+    counts = {}
+    with open(path, newline="", encoding="utf-8-sig") as f:
+        for lineno, row in enumerate(csv.reader(f, delimiter=SCANNER_DELIMITER), 1):
+            if not row or not any(field.strip() for field in row):
+                continue
+            if len(row) != 3:
+                raise ValueError(f"{path}:{lineno}: expected bin;sku;qty, got {len(row)} fields")
+            _bin, sku, qty = row
+            try:
+                qty = int(qty.strip())
+            except ValueError:
+                raise ValueError(f"{path}:{lineno}: quantity is not a whole number: {qty!r}")
+            if qty < 0:
+                raise ValueError(f"{path}:{lineno}: negative count {qty}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
