index 0000000..8aa6dd2
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,60 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self._dir.cleanup)
+
+    def write(self, text):
+        path = os.path.join(self._dir.name, "scan.txt")
+        with open(path, "w", encoding="utf-8") as f:
+            f.write(text)
+        return path
+
+    def test_reads_bin_sku_qty_by_position(self):
+        path = self.write("C-03-2;BR-1042;12\nA-01-1;NU-0007;4\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 12, "NU-0007": 4})
+
+    def test_sums_sku_across_bins(self):
+        path = self.write("C-03-2;BR-1042;12\nOVF-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 17})
+
+    def test_normalizes_sku_before_summing(self):
+        path = self.write("C-03-2;br-1042 ;12\nOVF-1; BR-1042;5\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 17})
+
+    def test_skips_blank_lines_and_tolerates_spaces_around_qty(self):
+        path = self.write("\nC-03-2;BR-1042; 12 \n\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 12})
+
+    def test_accepts_utf8_bom(self):
+        path = self.write("﻿C-03-2;BR-1042;3\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 3})
+
+    def test_zero_count_is_kept(self):
+        path = self.write("C-03-2;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(path), {"BR-1042": 0})
+
+    def test_wrong_field_count_reports_line(self):
+        path = self.write("C-03-2;BR-1042;3\nC-03-2;BR-1042\n")
+        with self.assertRaisesRegex(ValueError, r":2: expected bin;sku;qty"):
+            read_scanner_file(path)
+
+    def test_non_numeric_quantity_reports_line(self):
+        path = self.write("C-03-2;BR-1042;three\n")
+        with self.assertRaisesRegex(ValueError, r":1: quantity is not a whole number"):
+            read_scanner_file(path)
+
+    def test_negative_count_rejected(self):
+        path = self.write("C-03-2;BR-1042;-2\n")
+        with self.assertRaisesRegex(ValueError, r":1: negative count"):
+            read_scanner_file(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
