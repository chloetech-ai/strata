@@ -0,0 +1,32 @@
+"""Stock valuation, FIFO: issues consume the oldest receipts first."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Movements are taken in the order they were logged. Each receipt opens a
+    cost layer; each outflow consumes layers oldest first. Outflow beyond the
+    stock held (negative stock) has no layer to consume, so it adds no cost.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in inventory.movements:
+        if m.sku != sku:
+            continue
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{sku}: incoming movement has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
