@@ -0,0 +1,36 @@
+"""What the stock on hand is worth."""
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed first in, first out.
+
+    Each receipt starts a layer at its unit cost, and each outgoing movement
+    uses up the oldest layers first. Movements are taken in log order. Stock
+    that is short on hand (more goods out than came in) has no layer to value,
+    so it counts as zero.
+    """
+    sku = normalize_sku(sku)
+    layers = []  # [qty, unit_cost] still on hand, oldest first
+    shortfall = 0  # goods out that had no layer to come from, owed by later receipts
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"receipt of {sku} on {m.date.isoformat()} has no unit cost")
+            qty = m.qty
+            paid = min(shortfall, qty)
+            shortfall -= paid
+            qty -= paid
+            if qty:
+                layers.append([qty, m.unit_cost])
+        else:
+            out = -m.qty
+            while out and layers:
+                take = min(out, layers[0][0])
+                layers[0][0] -= take
+                out -= take
+                if layers[0][0] == 0:
+                    layers.pop(0)
+            shortfall += out
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..664e8b2
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,60 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1200)
+
+    def test_fifo_costing_across_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 15, DAY)
+        inv.issue("BR-1042", 14, DAY)  # takes all 10 at 12, then 4 at 15
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 15)
+
+    def test_partial_layer_left_over(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 7 * 12)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-9999", 5, 100, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_sku_forms_are_the_same_item(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042 "), 120)
+
+    def test_short_stock_counts_as_zero_and_later_receipt_covers_shortfall(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 12, DAY)
+        inv.issue("BR-1042", 5, DAY)  # on hand -3, value 0
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+        inv.receive("BR-1042", 4, 20, DAY)  # 3 cover the shortfall, 1 left at 20
+        self.assertEqual(inv.on_hand("BR-1042"), 1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 20)
+
+    def test_receipt_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, None, DAY)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
