+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        # BR-1 has 5 on hand, reorder point 10: 30 - 5 = 25 to order.
+        self.assertEqual(suggest_orders(make_inventory())["BR-1"], 25)
+
+    def test_at_reorder_point_orders_too(self):
+        # BR-2 has 10 on hand: 30 - 10 = 20 to order.
+        self.assertEqual(suggest_orders(make_inventory())["BR-2"], 20)
+
+    def test_skips_skus_with_enough_stock(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # 30 - 5 = 25 needed, which is three cases of 12 = 36.
+        self.assertEqual(suggest_orders(inv), {"BR-1": 36})
+
+    def test_exact_case_multiple_not_rounded(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=5)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # 25 needed, exactly five cases of 5.
+        self.assertEqual(suggest_orders(inv), {"BR-1": 25})
+
+    def test_zero_reorder_point_with_no_stock_orders_nothing(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=0)])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
