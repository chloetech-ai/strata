+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-1042", 2, 12, DAY, reason="RETURN")
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_last_receipt_picks_latest_date(self):
+        inv = Inventory()
+        later = datetime.date(2026, 9, 5)
+        inv.receive("BR-1042", 10, 12, later)
+        inv.receive("BR-1042", 5, 11, DAY)
+        inv.issue("BR-1042", 4, later)
+        self.assertEqual(inv.last_receipt("br-1042 ").unit_cost, 12)
+
+    def test_last_receipt_same_day_takes_later_logged(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive(" br-1042", 3, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
