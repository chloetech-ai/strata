 """Reorder checks."""
 
+import math
+
 
 def needs_reorder(inventory):
     """SKUs whose quantity on hand is at or below their reorder point."""
@@ -8,3 +10,20 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU that needs reordering, as {sku: qty}.
+
+    Orders enough to get back up to three times the reorder point, rounded up
+    to whole cases because the supplier only ships full cases.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        if shortfall <= 0:
+            continue
+        cases = math.ceil(shortfall / item.case_size)
+        orders[sku] = cases * item.case_size
+    return orders
