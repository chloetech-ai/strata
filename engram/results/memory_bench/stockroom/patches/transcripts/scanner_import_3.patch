@@ -0,0 +1,51 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8", newline="") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_reads_bin_sku_qty(self):
+        self.assertEqual(self.read("A-1-1;BR-1042;5\nB-2-3;BR-2000;12\n"), {"BR-1042": 5, "BR-2000": 12})
+
+    def test_sums_sku_across_bins(self):
+        counts = self.read("A-1-1;BR-1042;5\nOVF-1;BR-1042;4\n")
+        self.assertEqual(counts, {"BR-1042": 9})
+
+    def test_normalizes_sku(self):
+        counts = self.read("A-1-1; br-1042 ;5\nA-2-2;BR-1042;3\r\n")
+        self.assertEqual(counts, {"BR-1042": 8})
+
+    def test_skips_blank_lines_and_handles_bom(self):
+        self.assertEqual(self.read("﻿A-1-1;BR-1042;5\n\n\n"), {"BR-1042": 5})
+
+    def test_zero_quantity_is_kept(self):
+        self.assertEqual(self.read("A-1-1;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_rejects_wrong_column_count(self):
+        with self.assertRaisesRegex(ValueError, ":1:"):
+            self.read("A-1-1,BR-1042,5\n")
+
+    def test_rejects_empty_sku(self):
+        with self.assertRaisesRegex(ValueError, ":2:"):
+            self.read("A-1-1;BR-1042;5\nA-2-2;  ;3\n")
+
+    def test_rejects_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, "whole number"):
+            self.read("A-1-1;BR-1042;five\n")
+
+    def test_rejects_negative_quantity(self):
+        with self.assertRaisesRegex(ValueError, "negative"):
+            self.read("A-1-1;BR-1042;-2\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
