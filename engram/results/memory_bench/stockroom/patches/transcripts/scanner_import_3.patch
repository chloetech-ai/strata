+"""Reading the handheld scanner count files."""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The file is plain text, one line per bin: ``bin;sku;qty``, with no header.
+    A SKU may appear on several lines (overflow bins), so quantities are summed
+    per normalized SKU. The bin is checked for presence but not returned.
+    """
+    counts = {}  # type: Dict[str, int]
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity must be a whole number, got {qty.strip()!r}")
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
