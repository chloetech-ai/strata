+"""The printable count sheet for the stock-take.
+
+The sheet is blind: it never shows the quantity on hand, only an empty
+column where the counter writes what they found.
+"""
+
+import re
+
+
+def _walking_key(location):
+    """Sort key for bin codes like "B-12-3": digit runs compare as numbers."""
+    # re.split with a capture group alternates text and digits, so the
+    # slots line up across codes and int never meets str in the same place.
+    return [int(p) if p.isdigit() else p for p in re.split(r"(\d+)", location)]
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in walking order by bin location."""
+    items = sorted(inventory.catalog, key=lambda item: (_walking_key(item.location), item.sku))
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  ____________")
+    return "".join(line + "\n" for line in lines)
