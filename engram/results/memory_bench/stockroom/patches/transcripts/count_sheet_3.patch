+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def make_inventory(self):
+        catalog = Catalog([
+            Item("BR-2", "Nut", "B-10-1"),
+            Item("BR-1", "Bolt", "B-2-3"),
+            Item("BR-3", "Washer", "A-01-1"),
+        ])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 7, 10)
+        return inv
+
+    def test_one_line_per_item(self):
+        lines = count_sheet(self.make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+
+    def test_sorted_by_bin_numerically(self):
+        lines = count_sheet(self.make_inventory()).splitlines()
+        self.assertEqual([line.split()[0] for line in lines], ["A-01-1", "B-2-3", "B-10-1"])
+
+    def test_shows_no_quantity_on_hand(self):
+        sheet = count_sheet(self.make_inventory())
+        self.assertNotIn("7", sheet)
+
+    def test_empty_inventory_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_needs_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
