+"""The printable count sheet for the stock-take.
+
+Blind count: the sheet shows no quantity on hand, only an empty column for
+the counted quantity. Lines are in walking order, sorted by bin location.
+"""
+
+
+def _bin_key(location):
+    """Sort key for a bin code "aisle-bay-shelf", e.g. "B-12-3".
+
+    The aisle sorts as text; bay and shelf sort as numbers, so bay 10 comes
+    after bay 2. Codes that do not fit the pattern sort after the rest, by text.
+    """
+    parts = location.split("-")
+    if len(parts) == 3 and parts[1].isdigit() and parts[2].isdigit():
+        return (0, parts[0], int(parts[1]), int(parts[2]), location)
+    return (1, "", 0, 0, location)
+
+
+def count_sheet(inventory):
+    """The count sheet as text, one line per catalog item."""
+    if inventory.catalog is None:
+        raise ValueError("count sheet needs an inventory with a catalog")
+    items = sorted(inventory.catalog, key=lambda item: _bin_key(item.location))
+    lines = [f"{item.location:<8}  {item.sku:<12}  {item.name:<30}  {'':<10}" for item in items]
+    return "\n".join(lines) + "\n" if lines else ""
