 """Reorder checks."""
 
+import math
+
+ORDER_UP_TO_MULTIPLE = 3  # order back up to this many times the reorder point
+
 
 def needs_reorder(inventory):
     """SKUs whose quantity on hand is at or below their reorder point."""
@@ -8,3 +12,20 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Map each SKU to order to the quantity to order.
+
+    Orders enough to get back up to ORDER_UP_TO_MULTIPLE times the reorder
+    point, rounded up to whole cases since the supplier ships full cases.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = ORDER_UP_TO_MULTIPLE * item.reorder_point - inventory.on_hand(sku)
+        if shortfall <= 0:
+            continue
+        cases = math.ceil(shortfall / item.case_size)
+        orders[sku] = cases * item.case_size
+    return orders
