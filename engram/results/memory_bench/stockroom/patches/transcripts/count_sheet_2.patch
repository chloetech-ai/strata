+"""The printed count sheet for a stock-take.
+
+The sheet is blind: it never shows the quantity on hand, only an empty
+column where the counter writes what they found.
+"""
+
+
+def _bin_key(location):
+    """Sort key for a bin code like "B-12-3": numeric parts compare as numbers,
+    so "B-2" comes before "B-10"."""
+    return tuple(
+        (0, int(part), "") if part.isdigit() else (1, 0, part)
+        for part in location.split("-")
+    )
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in walking order (by bin location)."""
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    return "".join(
+        f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<6}  {'_' * 8}\n"
+        for item in items
+    )
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..e93ca62
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,31 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_bin_order(self):
+        catalog = Catalog([
+            Item("BR-1", "Bolt", "B-10-1"),
+            Item("BR-2", "Nut", "B-2-1"),
+            Item("BR-3", "Washer", "A-01-3"),
+        ])
+        lines = count_sheet(Inventory(catalog)).splitlines()
+        self.assertEqual(3, len(lines))
+        self.assertTrue(lines[0].startswith("A-01-3"))
+        self.assertTrue(lines[1].startswith("B-2-1"))
+        self.assertTrue(lines[2].startswith("B-10-1"))
+
+    def test_blind_count_shows_no_on_hand(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1")])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 42, 10)
+        sheet = count_sheet(inv)
+        self.assertNotIn("42", sheet)
+        self.assertTrue(sheet.rstrip().endswith("_" * 8))
+
+
+if __name__ == "__main__":
+    unittest.main()
