index 0000000..79901f2
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,33 @@
+"""Reading the handheld scanners' count files."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Total counted quantity per SKU from a scanner export.
+
+    The file is plain text, one line per bin count, with no header:
+    ``bin;sku;qty``. A SKU may appear on several lines (overflow bins), so
+    quantities are summed per normalized SKU. Returns ``{sku: qty}``.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            line = line.strip()
+            if not line:
+                continue
+            fields = line.split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected 3 fields bin;sku;qty, got {len(fields)}")
+            _bin, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity {qty.strip()!r} is not a whole number") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..a1ce9eb
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,45 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def _read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_sums_overflow_bins_and_normalizes_sku(self):
+        counts = self._read("B-12-3;br-1042 ;30\nOVF-1; BR-1042;12\nB-12-4;BR-2001;5\n")
+        self.assertEqual(counts, {"BR-1042": 42, "BR-2001": 5})
+
+    def test_skips_blank_lines_and_handles_crlf(self):
+        counts = self._read("B-12-3;BR-1042;3\r\n\r\nB-12-4;BR-2001;1\r\n")
+        self.assertEqual(counts, {"BR-1042": 3, "BR-2001": 1})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self._read("B-1;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_wrong_field_count_names_line(self):
+        with self.assertRaisesRegex(ValueError, ":2: expected 3 fields"):
+            self._read("B-1;BR-1042;3\nB-1;BR-2001\n")
+
+    def test_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, ":1: quantity 'three'"):
+            self._read("B-1;BR-1042;three\n")
+
+    def test_negative_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, "must not be negative"):
+            self._read("B-1;BR-1042;-2\n")
+
+    def test_empty_sku_rejected(self):
+        with self.assertRaisesRegex(ValueError, "empty SKU"):
+            self._read("B-1; ;4\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
