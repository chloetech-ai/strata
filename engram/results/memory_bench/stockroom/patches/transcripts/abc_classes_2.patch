@@ -0,0 +1,26 @@
+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by cumulative share of annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first (ties broken by SKU). A SKU is 'A' if the cumulative value up
+    to and including it is at most 80% of the grand total, 'B' if at most 95%,
+    otherwise 'C'.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.80 * total:
+            out[sku] = "A"
+        elif running <= 0.95 * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
