@@ -0,0 +1,37 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: S1=50 (50%), S2=30 (80%), S3=15 (95%), S4=5 (100%)
+        values = {"S1": 50, "S2": 30, "S3": 15, "S4": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"S1": "A", "S2": "A", "S3": "B", "S4": "C"},
+        )
+
+    def test_boundary_at_80_percent_is_a(self):
+        values = {"X": 80, "Y": 20}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "C"})
+
+    def test_boundary_at_95_percent_is_b(self):
+        values = {"X": 95, "Y": 5}
+        self.assertEqual(abc_classes(values), {"X": "B", "Y": "C"})
+
+    def test_input_order_does_not_matter(self):
+        values = {"S4": 5, "S3": 15, "S2": 30, "S1": 50}
+        self.assertEqual(abc_classes(values)["S1"], "A")
+        self.assertEqual(abc_classes(values)["S4"], "C")
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above the 95% cutoff for B.
+        self.assertEqual(abc_classes({"ONLY": 12}), {"ONLY": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
