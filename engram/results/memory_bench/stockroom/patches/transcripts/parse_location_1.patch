+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_aisle_is_uppercased(self):
+        self.assertEqual(parse_location("c-03-2"), ("C", 3, 2))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  B-12-3\n"), ("B", 12, 3))
+
+    def test_rejects_malformed_codes(self):
+        for code in ("", "B-12", "B-12-3-4", "AB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "B 12 3", "B-12.5-3", "B-−12-3", "B-12-3 extra"):
+            with self.assertRaises(ValueError, msg=code):
+                parse_location(code)
+
