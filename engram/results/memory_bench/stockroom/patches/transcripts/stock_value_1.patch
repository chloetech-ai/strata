@@ -0,0 +1,63 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1200)
+
+    def test_issues_consume_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 15, DAY)
+        inv.issue("BR-1042", 12, DAY)
+        # The 10 at 12 go first, then 2 of the 15s; 8 units at 15 remain
+        self.assertEqual(inv.on_hand("BR-1042"), 8)
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 15)
+
+    def test_partial_layer_left_over(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 15, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 12 + 10 * 15)
+
+    def test_oversold_stock_is_covered_by_later_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 15, DAY)  # 5 units short
+        inv.receive("BR-1042", 10, 20, DAY)  # 5 of these cover the shortfall
+        self.assertEqual(inv.on_hand("BR-1042"), 5)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 20)
+
+    def test_negative_on_hand_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, DAY)
+        inv.issue("BR-1042", 9, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_skus_ignored_and_sku_form_normalized(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 4, 12, DAY)
+        inv.receive("BR-9999", 100, 99, DAY)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 48)
+
+    def test_receipt_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, None, DAY)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
