+"""What the stock on hand is worth."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value of the SKU's quantity on hand, in cents, costed FIFO.
+
+    Receipts are layers in the order they were logged. Each issue consumes the
+    oldest layers first, and the value is what the remaining layers cost.
+    Issues beyond the stock on hand leave a deficit that later receipts cover
+    before they add to the layers, so the layers always total on_hand.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    deficit = 0
+    for m in inventory.movements_for(normalize_sku(sku)):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"receipt of {m.sku} on {m.date} has no unit cost")
+            qty = m.qty
+            cover = min(qty, deficit)
+            deficit -= cover
+            qty -= cover
+            if qty:
+                layers.append([qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            deficit += remaining
+    return sum(qty * unit_cost for qty, unit_cost in layers)
