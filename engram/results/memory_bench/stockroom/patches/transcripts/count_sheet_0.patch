+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def make_inventory(self):
+        catalog = Catalog([
+            Item("BR-2", "Nut", "B-2-1"),
+            Item("BR-1", "Bolt", "B-10-1"),
+            Item("BR-3", "Washer", "A-1-1"),
+        ])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        return inv
+
+    def test_one_line_per_item_in_bin_order(self):
+        lines = count_sheet(self.make_inventory()).splitlines()
+        self.assertEqual(len(lines), 3)
+        self.assertTrue(lines[0].startswith("A-1-1"))
+        self.assertTrue(lines[1].startswith("B-2-1"))
+        self.assertTrue(lines[2].startswith("B-10-1"))
+
+    def test_blind_count_shows_no_on_hand(self):
+        text = count_sheet(self.make_inventory())
+        self.assertNotIn("5", text)
+
+    def test_count_column_is_blank(self):
+        lines = count_sheet(self.make_inventory()).splitlines()
+        self.assertTrue(lines[0].rstrip().endswith("Washer"))
+        for line in lines:
+            self.assertEqual(line[-2:], "  ")
+            self.assertTrue(line.rstrip().split()[-1] in ("Washer", "Nut", "Bolt"))
+
+    def test_needs_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
