+"""The printable count sheet for a stock-take.
+
+The sheet is blind: it never shows the quantity on hand, only an empty
+column where the counter writes what they counted.
+"""
+
+
+def _bin_key(location):
+    """Walking order for bin codes like "B-12-3": aisle, bay and shelf as numbers."""
+    key = []
+    for part in location.split("-"):
+        if part.isdigit():
+            key.append((0, int(part), ""))
+        else:
+            key.append((1, 0, part.upper()))
+    return tuple(key)
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in walking order by bin location."""
+    if inventory.catalog is None:
+        raise ValueError("count sheet needs an inventory with a catalog")
+    items = sorted(inventory.catalog, key=lambda item: _bin_key(item.location))
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  ")
+    return "\n".join(lines) + "\n"
