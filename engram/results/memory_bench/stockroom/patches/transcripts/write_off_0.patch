+    def test_write_off_records_damage_and_reduces_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off(" br-1042", 3, DAY)
+        self.assertEqual(m.reason, "DAMAGE")
+        self.assertEqual(m.qty, -3)
+        self.assertEqual(m.sku, "BR-1042")
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_rejects_non_positive_qty(self):
