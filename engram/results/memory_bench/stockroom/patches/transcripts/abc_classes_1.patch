@@ -0,0 +1,27 @@
+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs into ABC classes by annual consumption value.
+
+    SKUs are sorted by value, highest first. A running total is kept and a
+    SKU is 'A' if the cumulative share up to and including it is at most 80%
+    of the grand total, 'B' if at most 95%, otherwise 'C'.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    if total <= 0:
+        raise ValueError("total consumption value must be positive")
+    out = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        running += value
+        share = running / total
+        if share <= 0.80:
+            out[sku] = "A"
+        elif share <= 0.95:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
