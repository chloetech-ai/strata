+++ b/tests/test_analysis.py
@@ -0,0 +1,33 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: X=50 (50%), Y=30 (80%), Z=15 (95%), W=5 (100%)
+        values = {"W": 5, "X": 50, "Y": 30, "Z": 15}
+        self.assertEqual(
+            abc_classes(values),
+            {"X": "A", "Y": "A", "Z": "B", "W": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        # Cumulative share hits exactly 80% at P and exactly 95% at Q.
+        values = {"P": 80, "Q": 15, "R": 5}
+        self.assertEqual(abc_classes(values), {"P": "A", "Q": "B", "R": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above 95%.
+        self.assertEqual(abc_classes({"ONLY": 7}), {"ONLY": "C"})
+
+    def test_zero_total_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"A1": 0, "A2": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
