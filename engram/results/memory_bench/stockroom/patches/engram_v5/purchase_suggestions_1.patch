+++ b/src/stockroom/reorder.py
@@ -1,5 +1,7 @@
 """Reorder checks."""
 
+from typing import Dict
+
 
 def needs_reorder(inventory):
     """SKUs whose quantity on hand is at or below their reorder point."""
@@ -8,3 +10,21 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory) -> Dict[str, int]:
+    """Map each SKU to order to the quantity to order.
+
+    An order brings stock back up to three times the reorder point, rounded
+    up to whole cases because the supplier only ships full cases. SKUs that
+    need nothing are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        cases = -(-shortfall // item.case_size)  # ceiling division
+        qty = cases * item.case_size
+        if qty > 0:
+            orders[sku] = qty
+    return orders
