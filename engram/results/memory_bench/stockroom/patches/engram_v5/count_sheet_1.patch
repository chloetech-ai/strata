@@ -0,0 +1,28 @@
+"""Printable blind count sheet for the stock-take."""
+
+
+def _walk_key(location):
+    """Sort key for bin codes like "B-12-3": numeric parts compare as numbers."""
+    key = []
+    for part in location.split("-"):
+        if part.isdigit():
+            key.append((0, int(part), ""))
+        else:
+            key.append((1, 0, part.upper()))
+    return key
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in walking order by bin location.
+
+    The sheet is blind: it never shows the on-hand quantity, only an empty
+    column for the counted quantity.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog")
+    items = sorted(inventory.catalog, key=lambda item: (_walk_key(item.location), item.sku))
+    lines = [
+        f"{item.location:<10} {item.sku:<12} {item.name:<30} {item.unit:<6} __________"
+        for item in items
+    ]
+    return "".join(line + "\n" for line in lines)
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..b3e22c0
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,52 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8x40", "B-12-3", unit="pcs"),
+            Item("BR-2000", "Washer", "B-2-1", unit="pcs"),
+            Item("BR-3000", "Gasket", "A-09-4", unit="pcs"),
+        ])
+        self.inv = Inventory(self.catalog)
+        self.inv.receive("BR-1042", 100, 12, DAY)
+
+    def test_one_line_per_catalog_item(self):
+        lines = count_sheet(self.inv).splitlines()
+        self.assertEqual(len(lines), len(self.catalog))
+
+    def test_walking_order_by_location_not_sku(self):
+        lines = count_sheet(self.inv).splitlines()
+        skus = [line.split()[1] for line in lines]
+        # A-09-4 before B-2-1 before B-12-3: numeric parts compare as numbers
+        self.assertEqual(skus, ["BR-3000", "BR-2000", "BR-1042"])
+
+    def test_does_not_show_on_hand(self):
+        sheet = count_sheet(self.inv)
+        self.assertNotIn("100", sheet)
+        self.assertNotIn("on hand", sheet.lower())
+
+    def test_line_has_location_sku_name_and_blank_count(self):
+        line = count_sheet(self.inv).splitlines()[2]
+        self.assertTrue(line.startswith("B-12-3"))
+        self.assertIn("BR-1042", line)
+        self.assertIn("Hex bolt M8x40", line)
+        self.assertTrue(line.rstrip().endswith("__________"))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_inventory_without_catalog_rejected(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
