index 0000000..a2e9745
--- /dev/null
+++ b/src/stockroom/valuation.py
@@ -0,0 +1,30 @@
+"""Value of stock on hand, costed first-in, first-out."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Each receipt opens a cost layer at its unit cost. Each outgoing movement
+    consumes the oldest layers first, so what is left is valued at the cost of
+    the most recently received stock. Movements are taken in log order.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost], oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for {m.qty} units of {sku} on {m.date}")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..c5ecf64
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,73 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_nothing_received(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 125, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1250)
+
+    def test_fifo_uses_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 200, DAY)
+        inv.issue("BR-1042", 15, DAY)
+        # 5 left from the 200-cost layer; the 100-cost layer is used up first.
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 200)
+
+    def test_issue_partly_through_a_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100)
+
+    def test_receipts_after_issues_are_valued_at_their_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        inv.receive("BR-1042", 4, 300, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 4 * 300)
+
+    def test_negative_on_hand_values_only_what_is_held(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive(" br-1042 ", 2, 50, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 100)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 100)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 50, DAY)
+        inv.receive("BR-9999", 3, 700, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 100)
+
+    def test_returns_with_cost_add_a_layer(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        inv._record(Movement("BR-1042", 2, DAY, "RETURN", 80))
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 80)
+
+    def test_stock_received_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 2, DAY, "COUNT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
