diff --git a/src/stockroom/scanner.py b/src/stockroom/scanner.py
new file mode 100644
index 0000000..8ea7550
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,29 @@
+"""Importer for the handheld scanners' plain-text count export.
+
+Each line is ``bin;sku;qty`` with no header. A SKU may appear on several
+lines when part of it sits in an overflow bin, so quantities are summed.
+"""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Return the counted quantity per normalized SKU as a dict."""
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _bin, sku, qty = fields
+            try:
+                quantity = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {qty!r}") from None
+            if quantity < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {quantity}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + quantity
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..0054b2b
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,47 @@
+import pytest
+
+from stockroom.scanner import read_scanner_file
+
+
+def write(tmp_path, text):
+    path = tmp_path / "scan.txt"
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def test_reads_counts_per_sku(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;5\nB-12-4;CX-7;2\n")
+    assert read_scanner_file(path) == {"BR-1042": 5, "CX-7": 2}
+
+
+def test_sums_sku_across_overflow_bins(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;5\nOVERFLOW-1;BR-1042;3\n")
+    assert read_scanner_file(path) == {"BR-1042": 8}
+
+
+def test_normalizes_sku_variants_into_one_key(tmp_path):
+    path = write(tmp_path, "B-12-3; br-1042 ;4\nOVERFLOW-1;BR-1042;1\nB-1;Br-1042 ;2\n")
+    assert read_scanner_file(path) == {"BR-1042": 7}
+
+
+def test_skips_blank_lines_and_handles_crlf(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;5\r\n\r\nB-12-4;CX-7;2\r\n")
+    assert read_scanner_file(path) == {"BR-1042": 5, "CX-7": 2}
+
+
+def test_rejects_wrong_field_count_with_line_number(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;5\nB-12-4;CX-7\n")
+    with pytest.raises(ValueError, match=":2:"):
+        read_scanner_file(path)
+
+
+def test_rejects_non_integer_quantity(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;five\n")
+    with pytest.raises(ValueError, match=":1:"):
+        read_scanner_file(path)
+
+
+def test_rejects_negative_quantity(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;-1\n")
+    with pytest.raises(ValueError, match="negative"):
+        read_scanner_file(path)
