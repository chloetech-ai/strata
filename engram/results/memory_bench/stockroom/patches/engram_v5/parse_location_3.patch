--- a/src/stockroom/items.py
+++ b/src/stockroom/items.py
@@ -1,13 +1,29 @@
 """The item catalog."""
 
+import re
 from dataclasses import dataclass
 
+_LOCATION_RE = re.compile(r"([A-Za-z])-([0-9]+)-([0-9]+)")
+
 
 def normalize_sku(sku):
     """Canonical form of a SKU: surrounding whitespace trimmed, uppercased."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like 'B-12-3' into ('B', 12, 3).
+
+    Surrounding whitespace is ignored and the aisle letter may be lowercase
+    (it is returned uppercase). Anything else raises ValueError.
+    """
+    match = _LOCATION_RE.fullmatch(code.strip())
+    if match is None:
+        raise ValueError(f"bin code must look like 'B-12-3', got {code!r}")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
