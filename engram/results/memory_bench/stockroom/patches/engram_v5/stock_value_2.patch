+"""What the stock on hand is worth."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each positive movement adds a layer of stock at its unit cost. Each
+    negative movement uses up the oldest layers first. What is left is
+    the stock on hand. An issue that exceeds the layers (negative stock)
+    adds nothing to the value.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost recorded for {m.sku} on {m.date}")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            remaining = -m.qty
+            while remaining and layers:
+                take = min(remaining, layers[0][0])
+                layers[0][0] -= take
+                remaining -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..5c734e2
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,66 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_no_movements_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_fifo_takes_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 5, 15, DAY)
+        inv.issue("BR-1042", 12, DAY)  # leaves 3 units at 15
+        self.assertEqual(stock_value(inv, "BR-1042"), 45)
+
+    def test_issue_spanning_layers_partially(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 10, 20, DAY)
+        inv.issue("BR-1042", 4, DAY)  # 6 @ 12 left, then 10 @ 20
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 12 + 10 * 20)
+
+    def test_receipt_after_issue_is_costed_on_its_own(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        inv.receive("BR-1042", 4, 30, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 4 * 30)
+
+    def test_negative_stock_adds_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 12, DAY)
+        inv.issue("BR-1042", 8, DAY)  # 3 units sold with no stock behind them
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_skus_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 120)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 12, DAY)
+        inv.issue(" BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "Br-1042 "), 6 * 12)
+
+    def test_receipt_without_cost_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 10, DAY, "RECEIPT", None))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
