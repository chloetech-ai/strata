diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..c88aace 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,21 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU that needs_reorder flags.
+
+    Orders enough to bring stock back up to three times the reorder point,
+    rounded up to whole cases because the supplier only ships full cases.
+    SKUs that would order nothing are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        if shortfall <= 0:
+            continue
+        cases = -(-shortfall // item.case_size)  # ceiling division
+        orders[sku] = cases * item.case_size
+    return orders
diff --git a/tests/test_reorder.py b/tests/test_reorder.py
index 62219cf..23823e9 100644
--- a/tests/test_reorder.py
+++ b/tests/test_reorder.py
@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -29,5 +29,32 @@ class ReorderTest(unittest.TestCase):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
 
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        # BR-1 has 5 on hand, reorder point 10, so it is brought up to 30.
+        self.assertEqual(suggest_orders(make_inventory())["BR-1"], 25)
+
+    def test_at_reorder_point_is_suggested(self):
+        # BR-2 has 10 on hand, reorder point 10, so it is brought up to 30.
+        self.assertEqual(suggest_orders(make_inventory())["BR-2"], 20)
+
+    def test_items_with_enough_stock_are_not_suggested(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Spring", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 4, 10)
+        # Shortfall is 26; 26 needs three cases of 12, so order 36.
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_nothing_to_order_is_left_out(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-02-2", reorder_point=0)])
+        inv = Inventory(catalog)
+        # On hand 0 is at the reorder point of 0, so it is flagged,
+        # but there is nothing to order.
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
