diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..f4558ae 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,20 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU that needs_reorder flags.
+
+    Orders enough to get back up to three times the reorder point, rounded
+    up to whole cases because the supplier only ships full cases. SKUs that
+    would get a zero quantity are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        cases = -(-shortfall // item.case_size)  # ceiling division
+        if cases > 0:
+            orders[sku] = cases * item.case_size
+    return orders
diff --git a/tests/test_reorder.py b/tests/test_reorder.py
index 62219cf..3e2050a 100644
--- a/tests/test_reorder.py
+++ b/tests/test_reorder.py
@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -28,6 +28,28 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_fills_to_three_times_reorder_point(self):
+        # BR-1 has 5 of a 10 reorder point: 30 - 5 = 25 needed, case size 1.
+        self.assertEqual(suggest_orders(make_inventory())["BR-1"], 25)
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Spring", "A-01-4", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 5, 10)
+        # 30 - 5 = 25 needed, rounded up to 3 cases of 12 = 36.
+        self.assertEqual(suggest_orders(inv), {"BR-4": 36})
+
+    def test_suggest_orders_only_lists_flagged_skus(self):
+        orders = suggest_orders(make_inventory())
+        self.assertIn("BR-2", orders)
+        self.assertNotIn("BR-3", orders)
+
+    def test_suggest_orders_skips_zero_quantity(self):
+        catalog = Catalog([Item("BR-5", "Pin", "A-01-5", reorder_point=0)])
+        inv = Inventory(catalog)
+        # On hand 0 at reorder point 0 is flagged, but nothing needs ordering.
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
