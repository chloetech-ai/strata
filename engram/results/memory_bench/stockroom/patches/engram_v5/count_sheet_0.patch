+"""Printable count sheet for the stock-take.
+
+The sheet is a blind count: it lists items in walking order (by bin
+location) and never shows the quantity on hand, only an empty column
+for the counted quantity.
+"""
+
+HEADER = "LOCATION  SKU           NAME                            COUNTED"
+COUNT_BOX = "________"
+
+
+def count_sheet(inventory):
+    """Return the count sheet as text, one line per catalog item."""
+    items = sorted(inventory.catalog, key=lambda item: (item.location, item.sku))
+    lines = [HEADER]
+    for item in items:
+        lines.append(f"{item.location:<8}  {item.sku:<12}  {item.name:<30}  {COUNT_BOX}")
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..96dedbc
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,46 @@
+import unittest
+
+from stockroom import Catalog, Inventory, Item
+from stockroom.countsheet import count_sheet
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8x40", "C-03-2"),
+            Item("WS-0007", "Wood screw 4x30", "A-01-1"),
+            Item("PL-0300", "Pipe clamp 22mm", "B-12-3"),
+        ])
+        self.inventory = Inventory(self.catalog)
+        self.inventory.receive("BR-1042", 250, 12)
+
+    def data_lines(self, text):
+        return text.splitlines()[1:]
+
+    def test_one_line_per_item_after_header(self):
+        lines = count_sheet(self.inventory).splitlines()
+        self.assertEqual(len(lines), 1 + len(self.catalog))
+
+    def test_lines_in_walking_order_by_location(self):
+        lines = self.data_lines(count_sheet(self.inventory))
+        skus = [line.split()[1] for line in lines]
+        self.assertEqual(skus, ["WS-0007", "PL-0300", "BR-1042"])
+
+    def test_never_prints_quantity_on_hand(self):
+        text = count_sheet(self.inventory)
+        self.assertNotIn("250", text)
+        self.assertNotIn("-250", text)
+
+    def test_counted_column_is_blank(self):
+        for line in self.data_lines(count_sheet(self.inventory)):
+            self.assertTrue(line.endswith("________"))
+
+    def test_prints_sku_name_and_location(self):
+        line = self.data_lines(count_sheet(self.inventory))[2]
+        self.assertIn("C-03-2", line)
+        self.assertIn("BR-1042", line)
+        self.assertIn("Hex bolt M8x40", line)
+
+
+if __name__ == "__main__":
+    unittest.main()
