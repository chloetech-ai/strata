+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value (ABC analysis).
+
+    ``values`` maps SKU to annual consumption value. SKUs are taken highest
+    value first; a SKU is 'A' while the cumulative share of the grand total,
+    up to and including it, is at most 80%, 'B' while it is at most 95%, and
+    'C' otherwise. Returns a dict mapping SKU to class.
+    """
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: pair[1], reverse=True)
+    out = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.80 * total:
+            out[sku] = "A"
+        elif running <= 0.95 * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
