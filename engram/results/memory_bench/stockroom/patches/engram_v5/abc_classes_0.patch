@@ -0,0 +1,30 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share_highest_first(self):
+        # Shares in order: 50%, 80%, 95%, 100% of the grand total of 100.
+        values = {"BR-1": 15, "BR-2": 50, "BR-3": 5, "BR-4": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-2": "A", "BR-4": "A", "BR-1": "B", "BR-3": "C"},
+        )
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative 80 is exactly 80% -> A; cumulative 95 is exactly 95% -> B;
+        # cumulative 100% is past 95% -> C.
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is past both thresholds.
+        self.assertEqual(abc_classes({"BR-1": 10}), {"BR-1": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
