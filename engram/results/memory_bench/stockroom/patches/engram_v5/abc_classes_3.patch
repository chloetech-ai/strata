+++ b/tests/test_analysis.py
@@ -0,0 +1,31 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_boundaries_are_inclusive(self):
+        # Sorted: 50 (50%), 30 (cumulative 80%), 15 (cumulative 95%), 5 (100%).
+        values = {"D": 5, "C": 15, "B": 30, "A": 50}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_input_order_does_not_matter(self):
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above 95%.
+        self.assertEqual(abc_classes({"BR-1": 42}), {"BR-1": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
