+"""Stock analysis: ABC classification of SKUs by annual consumption value."""
+
+from typing import Dict
+
+
+def abc_classes(values: Dict[str, float]) -> Dict[str, str]:
+    """Classify SKUs as A, B or C by cumulative share of annual value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest
+    value first with a running total; a SKU is 'A' if the cumulative share
+    up to and including it is at most 80% of the grand total, 'B' if at most
+    95%, otherwise 'C'.
+    """
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda kv: kv[1], reverse=True)
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        # Compare cross-multiplied to avoid float rounding at the 80% and 95% edges.
+        if running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
