index 0000000..e65f566
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,33 @@
+"""Import the handheld scanners' plain-text count export."""
+
+from typing import Dict
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path) -> Dict[str, int]:
+    """Counted quantity per SKU from a scanner export.
+
+    Each line is `bin;sku;qty` with no header. A SKU may appear on several
+    lines (part of it in an overflow bin); its quantities are summed.
+    """
+    counts = {}  # type: Dict[str, int]
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: missing SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity must be a whole number, got {qty.strip()!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..e5ee271
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,52 @@
+import pytest
+
+from stockroom.scanner import read_scanner_file
+
+
+def write(tmp_path, text):
+    path = tmp_path / "scan.txt"
+    path.write_text(text, encoding="utf-8")
+    return str(path)
+
+
+def test_sums_quantities_per_sku_across_bins(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;10\nOVF-1;BR-1042;4\nB-12-4;XY-7;2\n")
+    assert read_scanner_file(path) == {"BR-1042": 14, "XY-7": 2}
+
+
+def test_normalizes_sku(tmp_path):
+    path = write(tmp_path, "B-12-3; br-1042 ;3\nB-12-3;BR-1042;1\nB-12-3;Br-1042 ;2\n")
+    assert read_scanner_file(path) == {"BR-1042": 6}
+
+
+def test_skips_blank_lines_and_handles_crlf(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;5\r\n\r\nB-12-4;XY-7;1\r\n")
+    assert read_scanner_file(path) == {"BR-1042": 5, "XY-7": 1}
+
+
+def test_empty_file_gives_no_counts(tmp_path):
+    assert read_scanner_file(write(tmp_path, "")) == {}
+
+
+def test_wrong_field_count_reports_line(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;5\nB-12-3;BR-1042\n")
+    with pytest.raises(ValueError, match=":2:"):
+        read_scanner_file(path)
+
+
+def test_non_integer_quantity_is_rejected(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;1.5\n")
+    with pytest.raises(ValueError, match="whole number"):
+        read_scanner_file(path)
+
+
+def test_negative_quantity_is_rejected(tmp_path):
+    path = write(tmp_path, "B-12-3;BR-1042;-2\n")
+    with pytest.raises(ValueError, match="negative"):
+        read_scanner_file(path)
+
+
+def test_missing_sku_is_rejected(tmp_path):
+    path = write(tmp_path, "B-12-3;  ;2\n")
+    with pytest.raises(ValueError, match="missing SKU"):
+        read_scanner_file(path)
