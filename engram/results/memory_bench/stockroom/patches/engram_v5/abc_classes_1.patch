@@ -0,0 +1,34 @@
+"""Stock analysis."""
+
+from stockroom.items import normalize_sku
+
+
+def abc_classes(values):
+    """Classify SKUs A, B or C by annual consumption value.
+
+    ``values`` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and a SKU is 'A' if the cumulative share of the grand total
+    up to and including it is at most 80%, 'B' if at most 95%, otherwise 'C'.
+    The comparisons are done by cross-multiplying, so no float division is needed.
+    """
+    normalized = {}
+    for sku, value in values.items():
+        key = normalize_sku(sku)
+        if key in normalized:
+            raise ValueError(f"duplicate SKU {key}")
+        if value < 0:
+            raise ValueError(f"consumption value must not be negative, got {value} for {key}")
+        normalized[key] = value
+
+    total = sum(normalized.values())
+    classes = {}
+    cumulative = 0
+    for sku, value in sorted(normalized.items(), key=lambda pair: (-pair[1], pair[0])):
+        cumulative += value
+        if cumulative * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif cumulative * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
new file mode 100644
index 0000000..795eac9
--- /dev/null
+++ b/tests/test_analysis.py
@@ -0,0 +1,49 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_boundaries_are_inclusive(self):
+        # Cumulative shares are 80%, 95% and 100%, so each lands in its class.
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "B", "BR-3": "C"})
+
+    def test_item_crossing_80_percent_is_b(self):
+        # The first SKU alone reaches 81%, past the A threshold.
+        values = {"BR-1": 81, "BR-2": 19}
+        self.assertEqual(abc_classes(values), {"BR-1": "B", "BR-2": "C"})
+
+    def test_sorted_by_value_not_input_order(self):
+        values = {"BR-3": 5, "BR-1": 80, "BR-2": 15}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "B", "BR-3": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, past both thresholds.
+        self.assertEqual(abc_classes({"BR-1": 42.5}), {"BR-1": "C"})
+
+    def test_float_values(self):
+        values = {"BR-1": 0.5, "BR-2": 0.25, "BR-3": 0.25}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "A", "BR-3": "C"})
+
+    def test_skus_are_normalized(self):
+        values = {" br-1042": 70, "BR-2000": 30}
+        self.assertEqual(abc_classes(values), {"BR-1042": "A", "BR-2000": "C"})
+
+    def test_duplicate_after_normalization_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"br-1042": 1, " BR-1042": 2})
+
+    def test_negative_value_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+    def test_zero_total_does_not_divide_by_zero(self):
+        self.assertEqual(abc_classes({"BR-1": 0, "BR-2": 0}), {"BR-1": "A", "BR-2": "A"})
+
+
+if __name__ == "__main__":
+    unittest.main()
