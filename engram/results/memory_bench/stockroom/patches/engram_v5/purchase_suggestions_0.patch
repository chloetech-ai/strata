diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..820e460 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,19 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU in needs_reorder.
+
+    Orders enough to get back up to three times the reorder point, rounded
+    up to whole cases. SKUs that would order nothing are left out.
+    """
+    orders = {}
+    for sku in needs_reorder(inventory):
+        item = inventory.catalog.get(sku)
+        shortfall = 3 * item.reorder_point - inventory.on_hand(sku)
+        cases = -(-shortfall // item.case_size)  # ceiling division on ints
+        if cases > 0:
+            orders[sku] = cases * item.case_size
+    return orders
