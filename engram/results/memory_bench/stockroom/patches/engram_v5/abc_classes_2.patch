@@ -0,0 +1,30 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: X 50 (50%), Y 30 (80%), Z 15 (95%), W 5 (100%)
+        values = {"W": 5, "X": 50, "Y": 30, "Z": 15}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "A", "Z": "B", "W": "C"})
+
+    def test_boundaries_are_inclusive(self):
+        # X reaches exactly 80% and Y exactly 95%: both stay in the higher class.
+        self.assertEqual(abc_classes({"X": 80, "Y": 15, "Z": 5}),
+                         {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_single_sku_reaches_100_percent_so_is_c(self):
+        self.assertEqual(abc_classes({"BR-1042": 900}), {"BR-1042": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        # Equal values: A (33%), B (67%), C (100%) in SKU order.
+        values = {"B": 10, "A": 10, "C": 10}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "A", "C": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
