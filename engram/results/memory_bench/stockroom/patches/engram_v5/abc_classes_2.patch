+"""Stock analysis helpers."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value (ABC analysis).
+
+    SKUs are sorted by value, highest first. A SKU is 'A' if the cumulative
+    share of the grand total up to and including it is at most 80%, 'B' if
+    at most 95%, and 'C' otherwise. Returns a dict mapping SKU to class.
+    """
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda kv: (-kv[1], kv[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        # Compare cross-multiplied to avoid float error at the 80% and 95% edges.
+        if 100 * running <= 80 * total:
+            classes[sku] = "A"
+        elif 100 * running <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
