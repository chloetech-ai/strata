+"""The printable stock-take count sheet."""
+
+import re
+
+
+def _walking_key(location):
+    """Sort key for bin codes like "B-9-1" so that bay 9 comes before bay 12."""
+    return tuple(
+        (0, int(part), "") if part.isdigit() else (1, 0, part)
+        for part in re.split(r"(\d+)", location)
+        if part
+    )
+
+
+def count_sheet(inventory):
+    """Blind count sheet: one line per catalog item in walking order.
+
+    Shows the bin, SKU, name and unit, then an empty box for the counted
+    quantity. The system's on-hand quantity is deliberately left out so
+    that staff count the stock rather than copy the number.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count")
+    items = sorted(inventory.catalog, key=lambda item: (_walking_key(item.location), item.sku))
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  [{'':<8}]")
+    return "\n".join(lines)
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..958dca3
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,55 @@
+import unittest
+
+from stockroom import Catalog, Inventory, Item
+from stockroom.countsheet import count_sheet
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_one_line_per_item_in_walking_order(self):
+        catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8x40", "C-03-2"),
+            Item("WS-0007", "Wood screw 4x50", "B-12-3"),
+            Item("NT-0099", "Hex nut M8", "B-9-1"),
+        ])
+        lines = count_sheet(Inventory(catalog)).split("\n")
+        self.assertEqual(len(lines), 3)
+        self.assertIn("B-9-1", lines[0])
+        self.assertIn("NT-0099", lines[0])
+        self.assertIn("B-12-3", lines[1])
+        self.assertIn("C-03-2", lines[2])
+
+    def test_ties_on_location_fall_back_to_sku(self):
+        catalog = Catalog([
+            Item("ZZ-1", "Part Z", "A-1-1"),
+            Item("AA-1", "Part A", "A-1-1"),
+        ])
+        lines = count_sheet(Inventory(catalog)).split("\n")
+        self.assertIn("AA-1", lines[0])
+        self.assertIn("ZZ-1", lines[1])
+
+    def test_never_shows_on_hand_quantity(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt M8x40", "C-03-2")])
+        inventory = Inventory(catalog)
+        inventory.receive("BR-1042", 37, 120)
+        sheet = count_sheet(inventory)
+        self.assertNotIn("37", sheet)
+        self.assertNotIn("-37", sheet)
+
+    def test_line_shows_sku_name_location_and_empty_count_box(self):
+        catalog = Catalog([Item("br-1042", "Hex bolt M8x40", "C-03-2", unit="pcs")])
+        line = count_sheet(Inventory(catalog))
+        self.assertIn("C-03-2", line)
+        self.assertIn("BR-1042", line)
+        self.assertIn("Hex bolt M8x40", line)
+        self.assertIn("[        ]", line)
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_inventory_without_catalog_is_rejected(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
