diff --git a/src/stockroom/scanner.py b/src/stockroom/scanner.py
new file mode 100644
index 0000000..44dffd3
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,31 @@
+"""Reading the handheld scanners' plain-text count export."""
+
+import csv
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is semicolon-separated with no header line and the columns
+    bin;sku;qty. A SKU may appear on several lines (e.g. stock in an overflow
+    bin), so its quantities are added up. Returns {normalized SKU: total qty}.
+    """
+    counts = {}
+    with open(path, newline="", encoding="utf-8") as f:
+        for lineno, row in enumerate(csv.reader(f, delimiter=";"), start=1):
+            if not row:
+                continue  # blank line
+            if len(row) != 3:
+                raise ValueError(f"{path}:{lineno}: expected 3 fields (bin;sku;qty), got {len(row)}")
+            _bin, sku, qty = row
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{lineno}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{lineno}: quantity is not a whole number: {qty!r}") from None
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..7c55dd1
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,47 @@
+import pytest
+
+from stockroom.scanner import read_scanner_file
+
+
+def write(tmp_path, text):
+    path = tmp_path / "scan.txt"
+    path.write_text(text, encoding="utf-8")
+    return str(path)
+
+
+def test_reads_counts_per_sku(tmp_path):
+    path = write(tmp_path, "B-12-3;ab-100;5\nB-12-4;AB-200;7\n")
+    assert read_scanner_file(path) == {"AB-100": 5, "AB-200": 7}
+
+
+def test_adds_up_sku_on_several_lines(tmp_path):
+    path = write(tmp_path, "B-12-3;AB-100;5\nOVERFLOW;AB-100;3\n")
+    assert read_scanner_file(path) == {"AB-100": 8}
+
+
+def test_normalizes_sku_spelling(tmp_path):
+    path = write(tmp_path, "B-1-1; ab-100 ;2\nB-1-2;AB-100;1\n")
+    assert read_scanner_file(path) == {"AB-100": 3}
+
+
+def test_skips_blank_lines(tmp_path):
+    path = write(tmp_path, "B-1-1;AB-100;2\n\n\nB-1-2;AB-200;4\n")
+    assert read_scanner_file(path) == {"AB-100": 2, "AB-200": 4}
+
+
+def test_wrong_field_count_names_line(tmp_path):
+    path = write(tmp_path, "B-1-1;AB-100;2\nB-1-2;AB-200\n")
+    with pytest.raises(ValueError, match=r":2: expected 3 fields"):
+        read_scanner_file(path)
+
+
+def test_non_numeric_quantity_names_line(tmp_path):
+    path = write(tmp_path, "B-1-1;AB-100;two\n")
+    with pytest.raises(ValueError, match=r":1: quantity is not a whole number"):
+        read_scanner_file(path)
+
+
+def test_empty_sku_is_rejected(tmp_path):
+    path = write(tmp_path, "B-1-1;  ;2\n")
+    with pytest.raises(ValueError, match=r":1: empty SKU"):
+        read_scanner_file(path)
