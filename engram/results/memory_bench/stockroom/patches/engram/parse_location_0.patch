+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_aisle_is_uppercased_and_whitespace_ignored(self):
+        self.assertEqual(parse_location(" b-2-10 "), ("B", 2, 10))
+
+    def test_numbers_compare_as_integers(self):
+        self.assertEqual(parse_location("B-12-1")[1], 12)
+        self.assertEqual(parse_location("B-0012-01"), ("B", 12, 1))
+
+    def test_malformed_codes_rejected(self):
+        for code in ["", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "-12-3", "B-+12-3", "B-12-3.5", "B 12 3"]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
+
