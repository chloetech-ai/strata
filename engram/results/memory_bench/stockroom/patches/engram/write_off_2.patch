diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 20ff5c8..8890464 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -48,6 +48,13 @@ class Inventory:
         return self._record(Movement(
             normalize_sku(sku), -qty, date or datetime.date.today(), "SALE", None, note))
 
+    def write_off(self, sku, qty, date=None):
+        """Stock lost to breakage or damage: goods out, no sale."""
+        if qty <= 0:
+            raise ValueError("quantity must be positive")
+        return self._record(Movement(
+            normalize_sku(sku), -qty, date or datetime.date.today(), "DAMAGE", None))
+
     def on_hand(self, sku):
         sku = normalize_sku(sku)
         return sum(m.qty for m in self.movements if m.sku == sku)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 50e6678..6621e4b 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -40,6 +40,23 @@ class InventoryTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             inv.issue("BR-1042", -5)
 
+    def test_write_off_is_damage_out(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off("BR-1042", 3, DAY)
+        self.assertEqual((m.reason, m.qty, m.date), ("DAMAGE", -3, DAY))
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_normalizes_sku_and_rejects_non_positive(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.write_off(" br-1042 ", 2, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 8)
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", 0)
+        with self.assertRaises(ValueError):
+            inv.write_off("BR-1042", -1)
+
     def test_movements_for(self):
         inv = Inventory()
         inv.receive("BR-1042", 10, 12, DAY)
