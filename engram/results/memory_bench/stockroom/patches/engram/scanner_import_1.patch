+++ b/src/stockroom/scanner.py
@@ -0,0 +1,34 @@
+"""Reading the handheld scanners' count export.
+
+The export is plain text, one line per count: bin;sku;qty, with no header.
+A SKU can appear on several lines (stock split across bins), so the
+quantities are added up per SKU.
+"""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per canonical SKU, summed over all lines for that SKU."""
+    counts = {}
+    # utf-8-sig drops a byte-order mark if the scanner vendor's tool wrote one.
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(
+                    "%s line %d: expected bin;sku;qty, got %r" % (path, number, line.rstrip("\r\n")))
+            _bin, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(
+                    "%s line %d: quantity %r is not a whole number" % (path, number, qty))
+            if qty < 0:
+                raise ValueError(
+                    "%s line %d: quantity %d is negative" % (path, number, qty))
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..d5f01b9
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,45 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_sums_same_sku_across_bins(self):
+        counts = self.read("B-12-3;BR-1042;7\nOVR-1;BR-1042;5\nA-1-1;XY-9;2\n")
+        self.assertEqual(counts, {"BR-1042": 12, "XY-9": 2})
+
+    def test_normalizes_sku_spelling(self):
+        counts = self.read("B-12-3; br-1042 ;4\nOVR-1;BR-1042;1\n")
+        self.assertEqual(counts, {"BR-1042": 5})
+
+    def test_skips_blank_lines_and_accepts_crlf(self):
+        counts = self.read("B-12-3;BR-1042;7\r\n\r\n")
+        self.assertEqual(counts, {"BR-1042": 7})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self.read("B-12-3;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_rejects_wrong_field_count(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self.read("B-12-3;BR-1042;7\nB-12-3,BR-1042,7\n")
+
+    def test_rejects_non_integer_quantity(self):
+        with self.assertRaisesRegex(ValueError, "whole number"):
+            self.read("B-12-3;BR-1042;1.5\n")
+
+    def test_rejects_negative_quantity(self):
+        with self.assertRaisesRegex(ValueError, "negative"):
+            self.read("B-12-3;BR-1042;-2\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
