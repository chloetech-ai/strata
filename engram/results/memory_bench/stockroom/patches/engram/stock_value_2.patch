@@ -0,0 +1,40 @@
+"""Value of stock on hand, costed first in, first out."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Receipts are kept as lots in the order they were logged. Each outgoing
+    movement uses up the oldest lots first, so what remains is costed at the
+    most recent receipts. Units sold beyond the stock received have no lot to
+    take cost from; they are carried forward and settled by the next receipts,
+    so on-hand can be negative and its value is simply the cost of the lots left.
+    """
+    sku = normalize_sku(sku)
+    lots = deque()  # [qty, unit_cost] pairs, oldest first
+    short = 0  # units sold beyond the stock received so far
+    for m in inventory.movements:
+        if m.sku != sku:
+            continue
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"movement of {sku} without a unit cost cannot be valued")
+            settled = min(short, m.qty)
+            short -= settled
+            if m.qty > settled:
+                lots.append([m.qty - settled, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and lots:
+            lot = lots[0]
+            used = min(lot[0], remaining)
+            lot[0] -= used
+            remaining -= used
+            if lot[0] == 0:
+                lots.popleft()
+        short += remaining
+    return sum(qty * unit_cost for qty, unit_cost in lots)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
