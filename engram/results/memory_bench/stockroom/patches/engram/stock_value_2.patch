index 0000000..6a6e9e5
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,84 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_sales_consume_oldest_lots_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 15, DAY)  # all 10 at 100, then 5 at 300
+        # 5 left, all from the 300-cent lot
+        self.assertEqual(inv.on_hand("BR-1042"), 5)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1500)
+
+    def test_partial_lot_left_after_sale(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 100, DAY)
+        inv.receive("BR-1042", 4, 250, DAY)
+        inv.issue("BR-1042", 2, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 100 + 4 * 250)
+
+    def test_other_reasons_consume_lots_too(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.receive("BR-1042", 5, 200, DAY)
+        inv._record(Movement("BR-1042", -5, DAY, "DAMAGE"))
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 200)
+
+    def test_return_adds_stock_at_its_unit_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv._record(Movement("BR-1042", 2, DAY, "RETURN", 400))
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 100 + 2 * 400)
+
+    def test_return_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 2, DAY, "RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+    def test_negative_on_hand_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_shortfall_is_settled_by_later_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)  # 2 units short
+        inv.receive("BR-1042", 10, 300, DAY)  # first 2 settle the shortfall
+        self.assertEqual(inv.on_hand("BR-1042"), 8)
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 300)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 7, 999, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_variants_hit_the_same_stock(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 10, 100, DAY)
+        inv.issue("Br-1042 ", 4, DAY)
+        self.assertEqual(stock_value(inv, "  BR-1042"), 600)
+        self.assertEqual(stock_value(inv, "br-1042 "), 600)
+
+
+if __name__ == "__main__":
+    unittest.main()
