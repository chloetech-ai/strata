@@ -0,0 +1,23 @@
+"""The blind count sheet for a stock-take."""
+
+
+def _walk_key(location):
+    """Sort key for bin codes like "B-12-3": numeric parts compare as numbers,
+    so B-2-1 comes before B-12-3 (a plain text sort would reverse them)."""
+    return [(0, int(part), "") if part.isdecimal() else (1, 0, part)
+            for part in location.split("-")]
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in walking order by bin location.
+
+    The sheet is a blind count: it shows no quantity on hand, only an empty
+    column for the counted figure.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog")
+    items = sorted(inventory.catalog, key=lambda item: (_walk_key(item.location), item.sku))
+    return "\n".join(
+        f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  ________"
+        for item in items
+    )
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
new file mode 100644
index 0000000..3f7e6f4
--- /dev/null
+++ b/tests/test_countsheet.py
@@ -0,0 +1,50 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 12, 1)
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("BR-1042", "Hex bolt 10mm", "B-12-3"),
+            Item("BR-0007", "Wood screw 4x40", "B-2-1"),
+            Item("BR-0300", "Door hinge", "A-10-1"),
+            Item("BR-0301", "Cabinet knob", "B-2-10"),
+        ])
+        self.inv = Inventory(self.catalog)
+
+    def test_one_line_per_item_in_bin_walking_order(self):
+        lines = count_sheet(self.inv).split("\n")
+        self.assertEqual(len(lines), len(self.catalog))
+        self.assertEqual([line.split()[0] for line in lines],
+                         ["A-10-1", "B-2-1", "B-2-10", "B-12-3"])
+
+    def test_blind_count_shows_no_on_hand_quantity(self):
+        self.inv.receive("BR-1042", 137, 12, DAY)
+        self.inv.issue("BR-0007", 5, DAY)
+        sheet = count_sheet(self.inv)
+        self.assertNotIn("137", sheet)
+        self.assertNotIn("132", sheet)
+        self.assertNotIn("-5", sheet)
+        for line in sheet.split("\n"):
+            self.assertTrue(line.endswith("________"))
+
+    def test_sku_spelling_in_catalog_is_canonical(self):
+        catalog = Catalog([Item(" br-1042 ", "Hex bolt", "B-1-1")])
+        self.assertIn("BR-1042", count_sheet(Inventory(catalog)))
+
+    def test_empty_catalog_gives_empty_sheet(self):
+        self.assertEqual(count_sheet(Inventory(Catalog())), "")
+
+    def test_inventory_without_catalog_is_an_error(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
