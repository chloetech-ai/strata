@@ -0,0 +1,27 @@
+"""Stock analysis."""
+
+
+def abc_classes(values):
+    """ABC-classify SKUs by annual consumption value.
+
+    SKUs are taken highest value first. A SKU is 'A' while the cumulative
+    share of the grand total, including itself, is at most 80%, 'B' while
+    it is at most 95%, and 'C' otherwise. Returns {sku: class}.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        # Compare as integers-by-multiplication to avoid float error at the
+        # 80% and 95% boundaries: running / total <= 4/5 and <= 19/20.
+        if running * 5 <= total * 4:
+            classes[sku] = "A"
+        elif running * 20 <= total * 19:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
