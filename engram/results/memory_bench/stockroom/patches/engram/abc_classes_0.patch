@@ -0,0 +1,33 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_at_80_and_95_percent_boundaries(self):
+        # Sorted: A 50 (50%), B 30 (80%, still A), C 15 (95%, still B), D 5 (100%, C)
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_input_order_does_not_matter(self):
+        values = {"D": 5, "C": 15, "B": 30, "A": 50}
+        self.assertEqual(abc_classes(values)["A"], "A")
+        self.assertEqual(abc_classes(values)["D"], "C")
+
+    def test_single_sku_reaches_100_percent_so_is_c(self):
+        self.assertEqual(abc_classes({"BR-1": 12.5}), {"BR-1": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        # Equal values: BR-1 ranks first (cum 50%, A), BR-2 then reaches 100% (C)
+        values = {"BR-2": 50, "BR-1": 50}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
