+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_aisle_is_uppercased(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  B-12-3\t"), ("B", 12, 3))
+
+    def test_bay_and_shelf_compared_as_numbers(self):
+        self.assertEqual(parse_location("B-2-1"), ("B", 2, 1))
+        self.assertEqual(parse_location("B-012-03"), ("B", 12, 3))
+
+    def test_malformed_codes_rejected(self):
+        for code in ["", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "B-+12-3", "B-12-3.5", "B 12 3", "B-12 - 3",
+                     "B-١٢-3"]:
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
+
