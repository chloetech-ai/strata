+++ b/src/stockroom/analysis.py
@@ -0,0 +1,25 @@
+"""Inventory analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value using ABC analysis.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and each is classed by the cumulative share of the grand
+    total up to and including it: 'A' if at most 80%, 'B' if at most 95%,
+    otherwise 'C'. Returns a dict mapping SKU to class.
+    """
+    total = sum(values.values())
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        running += value
+        # Compare against the total scaled by the percentage rather than
+        # dividing, so a zero total cannot cause a division by zero.
+        if running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
