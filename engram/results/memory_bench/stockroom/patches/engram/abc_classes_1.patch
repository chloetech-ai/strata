@@ -0,0 +1,39 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 50 (50%), B 30 (80%), C 15 (95%), D 5 (100%)
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "B", "D": "C"},
+        )
+
+    def test_share_exactly_80_percent_is_a(self):
+        values = {"X": 80, "Y": 20}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "C"})
+
+    def test_share_exactly_95_percent_is_b(self):
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_single_sku_is_c(self):
+        # Its cumulative share is 100%, which is above both thresholds.
+        self.assertEqual(abc_classes({"ONLY": 12.5}), {"ONLY": "C"})
+
+    def test_ties_are_ordered_by_sku(self):
+        values = {"B": 10, "A": 10, "C": 10}
+        self.assertEqual(
+            abc_classes(values),
+            {"A": "A", "B": "A", "C": "C"},
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
