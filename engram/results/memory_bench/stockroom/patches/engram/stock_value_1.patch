+"""Value of stock on hand, at FIFO cost."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed FIFO.
+
+    Receipts are layers of (quantity, unit cost); each outgoing movement uses
+    up the oldest layers first, in logged order. Whatever is left is valued at
+    the cost of the layers it came from.
+
+    Issues are never refused, so outgoing stock can exceed what was received.
+    That shortfall is carried forward and taken from the next receipts, so the
+    value matches the on-hand quantity; a shortfall with nothing after it is
+    worth nothing.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [remaining qty, unit cost in cents], oldest first
+    shortfall = 0  # units already gone that no receipt has covered yet
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            covered = min(shortfall, m.qty)
+            shortfall -= covered
+            if m.qty > covered:
+                if m.unit_cost is None:
+                    raise ValueError(f"{sku}: incoming movement has no unit cost, cannot value it")
+                layers.append([m.qty - covered, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            layer = layers[0]
+            taken = min(remaining, layer[0])
+            layer[0] -= taken
+            remaining -= taken
+            if layer[0] == 0:
+                layers.popleft()
+        shortfall += remaining
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..94de0d4
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,93 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_fifo_uses_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 1500, DAY)
+        inv.issue("BR-1042", 12, DAY)  # 10 at 1000 and 2 at 1500 go out
+        # 8 left, all from the 1500 receipt
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 1500)
+
+    def test_partial_layer_is_split(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-1042", 10, 1500, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        # 5 at 1000 and all 10 at 1500 remain
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 1000 + 10 * 1500)
+
+    def test_sold_out_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 4, 999, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_fifo_follows_logged_order_across_later_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 800, DAY)
+        inv.issue("BR-1042", 3, DAY)
+        inv.receive("BR-1042", 5, 900, DAY)
+        # 2 at 800 remain, plus 5 at 900
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 800 + 5 * 900)
+
+    def test_sku_variants_value_the_same_stock(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 10, 1000, DAY)
+        inv.issue("Br-1042 ", 4, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6000)
+        self.assertEqual(stock_value(inv, "  br-1042"), 6000)
+
+    def test_other_skus_are_not_counted(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1000, DAY)
+        inv.receive("BR-2210", 5, 3000, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10000)
+
+    def test_receipt_without_cost_is_rejected(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, None, DAY)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+    def test_negative_stock_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 1000, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_later_receipt_covers_shortfall_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 1000, DAY)
+        inv.issue("BR-1042", 5, DAY)  # 2 units short
+        inv.receive("BR-1042", 4, 900, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 2)
+        # the shortfall took 2 of the 900 units, so 2 remain at 900
+        self.assertEqual(stock_value(inv, "BR-1042"), 2 * 900)
+
+    def test_receipt_smaller_than_shortfall(self):
+        inv = Inventory()
+        inv.issue("BR-1042", 5, DAY)
+        inv.receive("BR-1042", 3, 1000, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
