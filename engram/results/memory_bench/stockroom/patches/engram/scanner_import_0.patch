+"""Reading the handheld scanners' plain-text count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is semicolon-separated with no header line and the columns
+    bin;sku;qty. A SKU may appear on several lines (stock in an overflow bin),
+    so its quantities are added up. Returns a dict of normalized SKU to total.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected 3 fields, got {len(fields)}")
+            _bin, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {qty!r}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
