@@ -0,0 +1,28 @@
+"""What stock on hand is worth."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed first in, first out.
+
+    Each receipt opens a layer at its unit cost, and each outflow uses up the
+    oldest layers first. Outflow beyond the stock held has nothing left to
+    cost, so it values nothing. Raises ValueError if stock came in without a
+    unit cost, because its value would be unknown.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest first
+    for m in inventory.movements_for(sku):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for {m.qty} received on {m.date}")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
new file mode 100644
index 0000000..d6c891a
--- /dev/null
+++ b/tests/test_valuation.py
@@ -0,0 +1,84 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+DAY = datetime.date(2026, 9, 1)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_stock_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_fifo_costs_the_oldest_stock_out_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 15, DAY)  # 10 at 100, then 5 at 300
+        # 5 left, all from the second receipt
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_partly_used_layer_keeps_its_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        # 6 left at 100 and 10 at 300
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100 + 10 * 300)
+
+    def test_not_average_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-1042", 10, 300, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        # FIFO leaves 10 at 300; average cost would give 10 * 200
+        self.assertEqual(stock_value(inv, "BR-1042"), 3000)
+
+    def test_only_the_given_sku_is_counted(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.receive("BR-2210", 5, 700, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_variants_value_the_same_stock(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 10, 100, DAY)
+        inv.issue("Br-1042 ", 4, DAY)
+        self.assertEqual(stock_value(inv, "  BR-1042"), 600)
+        self.assertEqual(stock_value(inv, "br-1042 "), 600)
+
+    def test_fully_sold_stock_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 10, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_outflow_beyond_stock_values_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, DAY)
+        inv.issue("BR-1042", 12, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_stock_received_after_a_sale_is_costed_on_its_own(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, DAY)
+        inv.issue("BR-1042", 5, DAY)
+        inv.receive("BR-1042", 3, 250, DAY)
+        self.assertEqual(stock_value(inv, "BR-1042"), 750)
+
+    def test_receipt_without_unit_cost_is_refused(self):
+        inv = Inventory()
+        inv.movements.append(Movement("BR-1042", 10, DAY, "RECEIPT", None))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
