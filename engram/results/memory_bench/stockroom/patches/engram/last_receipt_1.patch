diff --git a/src/stockroom/inventory.py b/src/stockroom/inventory.py
index 20ff5c8..35b3464 100644
--- a/src/stockroom/inventory.py
+++ b/src/stockroom/inventory.py
@@ -55,3 +55,11 @@ class Inventory:
     def movements_for(self, sku):
         sku = normalize_sku(sku)
         return [m for m in self.movements if m.sku == sku]
+
+    def last_receipt(self, sku):
+        """The most recently logged receipt for a SKU, or None if there is none."""
+        sku = normalize_sku(sku)
+        for m in reversed(self.movements):
+            if m.sku == sku and m.reason == "RECEIPT":
+                return m
+        return None
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 50e6678..f882d7b 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -62,5 +62,30 @@ class InventoryTest(unittest.TestCase):
         self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
 
 
+class LastReceiptTest(unittest.TestCase):
+    def test_none_when_no_movements(self):
+        self.assertIsNone(Inventory().last_receipt("BR-1042"))
+
+    def test_none_when_sku_has_only_non_receipts(self):
+        inv = Inventory()
+        inv.receive("BR-2210", 5, 30, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_returns_most_recent_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 4, DAY)
+        latest = inv.receive("BR-1042", 20, 13, DAY)
+        inv.receive("BR-2210", 5, 30, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), latest)
+
+    def test_sku_variants_match(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        latest = inv.receive(" br-1042", 20, 13, DAY)
+        self.assertIs(inv.last_receipt("bR-1042 "), latest)
+
+
 if __name__ == "__main__":
     unittest.main()
