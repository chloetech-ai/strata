+++ b/src/stockroom/countsheet.py
@@ -0,0 +1,30 @@
+"""Printable blind count sheet for the stock-take."""
+
+
+def _bin_key(location):
+    """Sort key for "aisle-bay-shelf" bin codes: numeric parts compare as numbers.
+
+    Plain text sorting would put "B-12-3" before "B-2-1"; here each part is
+    tagged so digit runs compare as integers and other parts as text.
+    """
+    key = []
+    for part in location.split("-"):
+        if part.isdigit():
+            key.append((0, int(part), ""))
+        else:
+            key.append((1, 0, part.upper()))
+    return key
+
+
+def count_sheet(inventory):
+    """The count sheet as text, one line per catalog item, in walking order.
+
+    It is a blind count: quantities on hand are left off so staff count the
+    stock instead of copying the system figure. Each line ends with an empty
+    column for the counted quantity.
+    """
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    lines = ["%-10s %-12s %-30s %s" % ("BIN", "SKU", "ITEM", "COUNTED")]
+    for item in items:
+        lines.append("%-10s %-12s %-30s %s" % (item.location, item.sku, item.name, ""))
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
