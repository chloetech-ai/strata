@@ -0,0 +1,45 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8x40", "B-12-3"),
+            Item("BR-2001", "Wood screw 4x30", "B-2-1"),
+            Item("NL-0007", "Nail 50mm", "A-10-2"),
+            Item("NL-0008", "Nail 60mm", "A-9-2"),
+        ])
+        self.inventory = Inventory(self.catalog)
+        self.inventory.receive("BR-1042", 40, 25)
+
+    def data_lines(self):
+        return count_sheet(self.inventory).splitlines()[1:]
+
+    def test_one_line_per_catalog_item_plus_header(self):
+        lines = count_sheet(self.inventory).splitlines()
+        self.assertEqual(len(lines), len(self.catalog) + 1)
+
+    def test_sorted_by_bin_location_numerically(self):
+        bins = [line.split()[0] for line in self.data_lines()]
+        self.assertEqual(bins, ["A-9-2", "A-10-2", "B-2-1", "B-12-3"])
+
+    def test_no_on_hand_quantity_shown(self):
+        sheet = count_sheet(self.inventory)
+        self.assertNotIn("on hand", sheet.lower())
+        self.assertNotIn(" 40", sheet)
+
+    def test_counted_column_left_empty(self):
+        header = count_sheet(self.inventory).splitlines()[0]
+        self.assertTrue(header.endswith("COUNTED"))
+        self.assertEqual(
+            self.data_lines()[-1],
+            "%-10s %-12s %-30s " % ("B-12-3", "BR-1042", "Hex bolt M8x40"),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
