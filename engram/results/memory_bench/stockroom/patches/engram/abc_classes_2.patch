+"""Stock analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first, and each gets 'A' if the running total up to and including
+    it is at most 80% of the grand total, 'B' if at most 95%, otherwise 'C'.
+    """
+    if not values:
+        return {}
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    out = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda pair: pair[1], reverse=True):
+        running += value
+        # Compare without dividing so a zero grand total does not divide by zero.
+        if running * 100 <= 80 * total:
+            out[sku] = "A"
+        elif running * 100 <= 95 * total:
+            out[sku] = "B"
+        else:
+            out[sku] = "C"
+    return out
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
