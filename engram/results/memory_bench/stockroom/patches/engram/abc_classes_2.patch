@@ -0,0 +1,35 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: BR-1 (50), BR-2 (30), BR-3 (15), BR-4 (5). Total 100.
+        # Running shares: 50%, 80%, 95%, 100%.
+        values = {"BR-3": 15, "BR-1": 50, "BR-4": 5, "BR-2": 30}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_boundary_at_exactly_80_and_95_percent(self):
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_single_sku_is_c_because_its_share_is_100_percent(self):
+        self.assertEqual(abc_classes({"BR-1": 12}), {"BR-1": "C"})
+
+    def test_zero_values_do_not_fail(self):
+        self.assertEqual(abc_classes({"BR-1": 0, "BR-2": 0}), {"BR-1": "A", "BR-2": "A"})
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
