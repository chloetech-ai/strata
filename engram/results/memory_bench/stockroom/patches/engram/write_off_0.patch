+    def test_write_off_reduces_stock_as_damage(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        m = inv.write_off("BR-1042", 3, DAY)
+        self.assertEqual(m.reason, "DAMAGE")
+        self.assertEqual(m.qty, -3)
+        self.assertEqual(m.date, DAY)
+        self.assertIsNone(m.unit_cost)
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+
+    def test_write_off_normalizes_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.write_off(" br-1042 ", 2, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), 8)
+        self.assertEqual({m.sku for m in inv.movements}, {"BR-1042"})
+
+    def test_write_off_defaults_to_today(self):
+        inv = Inventory()
+        m = inv.write_off("BR-1042", 1)
+        self.assertEqual(m.date, datetime.date.today())
+
+    def test_write_off_does_not_refuse_when_short(self):
+        inv = Inventory()
+        inv.write_off("BR-1042", 5, DAY)
+        self.assertEqual(inv.on_hand("BR-1042"), -5)
+
