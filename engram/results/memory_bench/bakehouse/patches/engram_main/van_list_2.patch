+"""The van's run: the drops for a delivery day, in driving order."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the customers with orders for `day` to `path` as CSV, in driving order (by route_seq).
+    `customers` is the dict from load_customers."""
+    codes = orderbook.customers_for(day)
+    missing = [code for code in codes if code not in customers]
+    if missing:
+        raise ValueError(f"no customer record for: {', '.join(missing)}")
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["code", "name", "address", "postcode"])
+        for c in drops:
+            writer.writerow([c.code, c.name, c.address, c.postcode])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
