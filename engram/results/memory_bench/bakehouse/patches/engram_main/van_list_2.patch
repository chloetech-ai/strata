@@ -0,0 +1,69 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+OTHER_DAY = datetime.date(2026, 10, 21)
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "1 High St", "AB1 2CD", 3),
+        "GREENWAY": Customer("GREENWAY", "Greenway", "Lower Farm, Ashby Road", "AB3 4EF", 1),
+        "AIDAN": Customer("AIDAN", "St Aidan's", "9 School Lane", "AB2 3GH", 2),
+    }
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_only_customers_ordering_that_day_in_driving_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+            OrderLine(DAY, "GREENWAY", "BAG", 7),
+            OrderLine(OTHER_DAY, "AIDAN", "BAG", 4),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["code", "name", "address", "postcode"],
+            ["GREENWAY", "Greenway", "Lower Farm, Ashby Road", "AB3 4EF"],
+            ["LUMEN", "Café Lumen", "1 High St", "AB1 2CD"],
+        ])
+
+    def test_customer_with_several_lines_appears_once(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "AIDAN", "BAG", 3),
+            OrderLine(DAY, "AIDAN", "BAG", 2),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(len(self.read_rows()), 2)
+
+    def test_no_orders_writes_only_the_header(self):
+        drops_file(OrderBook(self.catalog), customers(), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["code", "name", "address", "postcode"]])
+
+    def test_order_for_unknown_customer_is_an_error(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 1)])
+        with self.assertRaisesRegex(ValueError, "NOBODY"):
+            drops_file(book, customers(), DAY, self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
