@@ -0,0 +1,62 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SOU", "White sourdough", 320, allergens=("wheat",)),
+            Product("FLO", "Florentine", 90, allergens=("nuts", "milk")),
+            Product("BAG", "Baguette", 95),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "1 High St", "AB1 2CD", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 Mill Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_van_run_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "FLO", 12),
+            OrderLine(DAY, "GREENWAY", "BAG", 40),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Grocers\n40 x Baguette",
+            "Cafe Lumen\n12 x Florentine\nMILK, NUTS",
+            "Cafe Lumen\n6 x White sourdough\nWHEAT",
+        ])
+
+    def test_quantities_for_the_same_customer_and_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 4),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n10 x White sourdough\nWHEAT"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 6),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_lines_are_ascii_and_fit_the_printer(self):
+        catalog = Catalog([Product("PAT", "Pâté-style pastry rolls with a very long name for the printer", 100)])
+        customers = {"LUMEN": Customer("LUMEN", "Café Lumen Überfull Kitchen Name Ltd", "1 High St", "AB1 2CD", 1)}
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "PAT", 2)])
+        name_line, product_line = crate_labels(book, customers, DAY)[0].split("\n")
+        self.assertEqual(name_line, "Cafe Lumen Uberfull Kitchen Name Ltd")
+        self.assertEqual(product_line, "2 x Pate-style pastry rolls with a very long nam")
+        for line in crate_labels(book, customers, DAY)[0].split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+            line.encode("ascii")
+
+
+if __name__ == "__main__":
+    unittest.main()
