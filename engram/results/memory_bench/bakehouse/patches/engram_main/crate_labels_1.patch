+"""Crate labels for packing. The label printer takes plain ASCII, 48 characters per line."""
+
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def _line(text):
+    """Plain ASCII, at most LINE_WIDTH characters: accents become their base letter, other characters are dropped."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in van run order, then product code.
+
+    Each label is the customer's name, then the quantity and product name, then the allergens in capitals
+    (only if the product has any)."""
+    qty_by_pair = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        qty_by_pair[key] = qty_by_pair.get(key, 0) + line.qty
+
+    labels = []
+    for customer_code, product_code in sorted(qty_by_pair, key=lambda k: (customers[k[0]].route_seq, k[1])):
+        customer = customers[customer_code]
+        product = orderbook.catalog.get(product_code)
+        lines = [
+            _line(customer.name),
+            _line(f"{qty_by_pair[(customer_code, product_code)]} x {product.name}"),
+        ]
+        if product.allergens:
+            lines.append(_line(product.allergen_text().upper()))
+        labels.append("\n".join(lines))
+    return labels
