+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SWL", "Sandwich loaf", 180, batch_size=16),
+            Product("BAG", "Baguette", 95, batch_size=12),
+        ])
+
+    def test_half_wholesale_per_returned_sandwich_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 200, 5), 5 * 180 // 2)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 200, 0), 0)
+
+    def test_returns_above_ten_percent_of_delivered_are_not_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 200, 30), 20 * 180 // 2)
+
+    def test_cap_is_rounded_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 5), 2 * 180 // 2)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 200, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 200, 5), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
