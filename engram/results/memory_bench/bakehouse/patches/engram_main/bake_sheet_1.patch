+def bake_sheet(orderbook, day):
+    """Text sheet for `day`: one line per product to bake, hottest oven first.
+
+    Each line gives the product name, pieces, batches and grams of dough to weigh out.
+    """
+    baking = plan(orderbook, day)
+    products = sorted(
+        (orderbook.catalog.get(code) for code in baking),
+        key=lambda p: (-p.bake_temp, p.code),
+    )
+    lines = []
+    for product in products:
+        units, batches = baking[product.code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name}: {units} pieces, {batches} batches, {grams} g dough")
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays going in the oven: one tray per batch, summed over every product in `plan_result`."""
     return sum(batches for _units, batches in plan_result.values())
