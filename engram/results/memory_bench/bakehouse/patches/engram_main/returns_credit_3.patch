+
+
+# Products that count as sandwich loaves for the Greenway returns credit.
+# The catalog has no category field, so this list is the rule.
+SANDWICH_LOAF_CODES = ("SWL",)
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for one delivery's unsold loaves sent back by Greenway.
+
+    Only GREENWAY sandwich loaves are credited, at half the wholesale price per loaf.
+    The credited count is capped at 10% of the loaves `delivered`, rounded down;
+    returns above the cap get no credit. Returns a positive amount; the caller
+    decides how it appears on the invoice.
+    """
+    price = catalog.get(product_code).price
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, not {delivered} and {returned}")
+    if customer_code != "GREENWAY" or product_code not in SANDWICH_LOAF_CODES:
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * price // 2
