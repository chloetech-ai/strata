+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SWL", "Sandwich loaf", 180, batch_size=16),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+
+    def test_half_wholesale_per_returned_sandwich_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 3), 3 * 90)
+
+    def test_cap_is_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 10), 10 * 90)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 25), 10 * 90)
+
+    def test_cap_rounds_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 10), 2 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_small_delivery_gets_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 5), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 10), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 100, 10), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 100, -1)
+
+    def test_unknown_product_is_rejected(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "XXX", 100, 1)
+
