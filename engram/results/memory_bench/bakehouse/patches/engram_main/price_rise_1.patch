index 0000000..7fed609
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,20 @@
+"""Wholesale price changes. All amounts are integer pence, before VAT."""
+
+# January rise: 5%, and each new price is rounded up to the next 5p, never down,
+# because the cafés print price boards and odd pennies look silly on them.
+RISE_PERCENT = 5
+ROUND_UP_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for the January rise.
+
+    Uses integer arithmetic only: ceiling division by 100 * ROUND_UP_TO_PENCE,
+    then multiplied back up, so a price is never rounded down.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + RISE_PERCENT)
+        step = 100 * ROUND_UP_TO_PENCE
+        prices[product.code] = -(-raised // step) * ROUND_UP_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..4c87903
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,36 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 5% of 320 is 336, which rounds up to 340.
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_is_unchanged_by_rounding(self):
+        catalog = Catalog([Product("BUN", "Bun", 100)])
+        # 5% of 100 is 105 exactly.
+        self.assertEqual(new_prices(catalog), {"BUN": 105})
+
+    def test_never_rounds_down(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        # 5% of 95 is 99.75, which rounds up to 100, not down to 95.
+        self.assertEqual(new_prices(catalog), {"BAG": 100})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FRE", "Free sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FRE": 0})
+
+    def test_every_product_is_included(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),
+            Product("BAG", "Baguette", 95),
+        ])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 100})
+
+
+if __name__ == "__main__":
+    unittest.main()
