+class DeliveryChargeTest(unittest.TestCase):
+    def test_under_forty_pounds_pays_four_fifty(self):
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)
+        self.assertEqual(delivery_charge("LUMEN", 1), 450)
+
+    def test_forty_pounds_exactly_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+
+    def test_over_forty_pounds_pays_nothing(self):
+        self.assertEqual(delivery_charge("GREENWAY", 12345), 0)
+
+    def test_st_aidan_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 1000), 0)
+
+    def test_no_order_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 0), 0)
+
+    def test_credit_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", -300), 0)
