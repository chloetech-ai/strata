@@ -40,6 +40,21 @@ def invoice_number(year, seq):
     return f"LK-{year:04d}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence
+DELIVERY_CHARGE_UNDER = 4000  # pence, order value before VAT
+NO_DELIVERY_CHARGE = ("AIDAN",)  # contract prices already include delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day, given its value in pence before VAT.
+
+    £4.50 on any order under £40.00. Nothing for a day with no order, a credit, or a customer whose contract includes delivery.
+    """
+    if customer_code in NO_DELIVERY_CHARGE or not 0 < subtotal < DELIVERY_CHARGE_UNDER:
+        return 0
+    return DELIVERY_CHARGE
+
+
