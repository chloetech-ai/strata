 def total_batches(plan_result):
     """Trays going in the oven: one tray per batch, summed over every product in `plan_result`."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first.
+
+    Each line gives the product name, units, batches and grams of dough to weigh out.
+    """
+    catalog = orderbook.catalog
+    lines = []
+    for code, (units, batches) in plan(orderbook, day).items():
+        product = catalog.get(code)
+        lines.append((-product.bake_temp, code, product, units, batches))
+    lines.sort(key=lambda entry: entry[:2])
+    return "\n".join(
+        f"{product.name}: {units} pcs, {batches} {'batch' if batches == 1 else 'batches'}, "
+        f"{dough_weight_g(product, units)} g dough"
+        for _temp, _code, product, units, batches in lines
+    )
