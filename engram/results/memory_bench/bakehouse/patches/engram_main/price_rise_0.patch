@@ -0,0 +1,19 @@
+"""Wholesale price changes. All amounts are integer pence, before VAT."""
+
+# The January rise: 5 per cent, then rounded up to the next 5p so the cafés'
+# price boards never show odd pennies. Rounding is up only, so no price falls.
+RISE_PERCENT = 5
+ROUND_UP_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in `catalog`."""
+    prices = {}
+    for product in catalog:
+        # price * (100 + RISE_PERCENT) is the new price in pence times 100, so
+        # dividing by 100 * ROUND_UP_TO_PENCE and rounding up in whole units
+        # gives the next multiple of 5p without any floats.
+        raised = product.price * (100 + RISE_PERCENT)
+        step = 100 * ROUND_UP_TO_PENCE
+        prices[product.code] = -(-raised // step) * ROUND_UP_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..8cb485c
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,38 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_per_cent_and_rounds_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),  # 336 -> 340
+            Product("BAG", "Baguette", 100),         # 105 exactly
+            Product("FLO", "Florentine", 90),        # 94.5 -> 95
+        ])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 105, "FLO": 95})
+
+    def test_price_just_over_a_multiple_of_5p_rounds_up_again(self):
+        catalog = Catalog([Product("ROL", "Bread roll", 101)])  # 106.05 -> 110
+        self.assertEqual(new_prices(catalog), {"ROL": 110})
+
+    def test_no_price_goes_down(self):
+        catalog = Catalog([Product("X%d" % p, "Item", p) for p in range(0, 400)])
+        for product in catalog:
+            self.assertGreaterEqual(new_prices(catalog)[product.code], product.price)
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+    def test_results_are_whole_pence(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 333)])
+        self.assertIsInstance(new_prices(catalog)["SOU"], int)
+
+
+if __name__ == "__main__":
+    unittest.main()
