+class NextDeliveryDayTest(unittest.TestCase):
+    def test_next_day_when_it_is_a_delivery_day(self):
+        self.assertEqual(next_delivery_day(DAY), DAY + datetime.timedelta(days=1))
+
+    def test_skips_closed_days(self):
+        for closed in config.CLOSED_WEEKDAYS:
+            day = DAY
+            while (day + datetime.timedelta(days=1)).weekday() != closed:
+                day += datetime.timedelta(days=1)
+            self.assertEqual(next_delivery_day(day), day + datetime.timedelta(days=2))
+
+    def test_is_strictly_after_the_given_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            following = next_delivery_day(day)
+            self.assertGreater(following, day)
+            self.assertTrue(is_delivery_day(following))
+            self.assertTrue(all(not is_delivery_day(day + datetime.timedelta(days=k))
+                                for k in range(1, (following - day).days)))
+
+
