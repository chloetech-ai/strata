+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        self.week_start = datetime.date(2026, 10, 19)  # a Monday
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8-sig") as f:
+            return f.read().splitlines()
+
+    def test_one_row_per_customer_summed_over_seven_days(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.week_start, "LUMEN", "BAG", 5),
+            OrderLine(self.week_start + datetime.timedelta(days=6), "LUMEN", "SOU", 10),
+            OrderLine(self.week_start, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), [
+            "Customer;Total (£)",
+            "GREENWAY;19,00",
+            "LUMEN;36,75",
+        ])
+
+    def test_days_outside_the_week_are_excluded(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.week_start - datetime.timedelta(days=1), "LUMEN", "SOU", 99),
+            OrderLine(self.week_start, "LUMEN", "BAG", 1),
+            OrderLine(self.week_start + datetime.timedelta(days=7), "LUMEN", "SOU", 99),
+        ])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)", "LUMEN;0,95"])
+
+    def test_pence_are_written_with_two_digits_after_comma(self):
+        book = OrderBook(self.catalog, [OrderLine(self.week_start, "LUMEN", "BAG", 1)])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read()[1], "LUMEN;0,95")
+
+    def test_no_orders_writes_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), self.week_start, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)"])
+
+
 if __name__ == "__main__":
     unittest.main()
