+"""The van's run: which customers get a drop on a day, in driving order."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Write the van's drops for `day` to `path` as CSV, one row per customer
+    with orders that day, in route order (route_seq). `customers` is the dict
+    from load_customers."""
+    codes = sorted(orderbook.customers_for(day), key=lambda code: _customer(customers, code).route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["stop", "code", "name", "address", "postcode"])
+        for code in codes:
+            c = customers[code]
+            writer.writerow([c.route_seq, c.code, c.name, c.address, c.postcode])
+
+
+def _customer(customers, code):
+    if code not in customers:
+        raise ValueError(f"customer {code} has orders but is not in customers.csv")
+    return customers[code]
