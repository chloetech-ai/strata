@@ -0,0 +1,74 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+OTHER_DAY = datetime.date(2026, 10, 21)
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "1 High St, Ashby", "AB1 2CD", 2),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "Lower Farm, Ashby Road", "AB3 4EF", 1),
+        "AIDAN": Customer("AIDAN", "St Aidan's", "9 Church Lane", "AB5 6GH", 3),
+    }
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_only_customers_with_orders_that_day_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "AIDAN", "BAG", 4),
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+            OrderLine(OTHER_DAY, "GREENWAY", "BAG", 9),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["stop", "code", "name", "address", "postcode"],
+            ["2", "LUMEN", "Café Lumen", "1 High St, Ashby", "AB1 2CD"],
+            ["3", "AIDAN", "St Aidan's", "9 Church Lane", "AB5 6GH"],
+        ])
+
+    def test_one_row_per_customer_even_with_several_lines(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 2),
+            OrderLine(DAY, "GREENWAY", "BAG", 5),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(len(self.read_rows()), 2)
+
+    def test_address_with_comma_is_quoted_and_stays_one_field(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "GREENWAY", "BAG", 2)])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(self.read_rows()[1][3], "Lower Farm, Ashby Road")
+
+    def test_no_orders_gives_header_only(self):
+        drops_file(OrderBook(self.catalog), customers(), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["stop", "code", "name", "address", "postcode"]])
+
+    def test_customer_with_orders_but_not_in_customers_is_an_error(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 2)])
+        with self.assertRaisesRegex(ValueError, "NOBODY"):
+            drops_file(book, customers(), DAY, self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
