+"""The van's run: which customers we drop at on a delivery day, in driving order."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the drops for `day` to `path` as CSV, one row per customer with orders that day,
+    in driving order (route_seq). `customers` is the dict load_customers returns."""
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for code in codes:
+            customer = customers[code]
+            writer.writerow([customer.name, customer.address, customer.postcode, ""])
