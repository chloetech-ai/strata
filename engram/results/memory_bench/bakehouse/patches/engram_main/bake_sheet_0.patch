+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first.
+    Each line gives the name, units, batches and grams of dough to weigh out."""
+    catalog = orderbook.catalog
+    day_plan = plan(orderbook, day)
+    codes = sorted(day_plan, key=lambda code: (-catalog.get(code).bake_temp, code))
+    name_width = max((len(catalog.get(code).name) for code in codes), default=0)
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = day_plan[code]
+        grams = dough_weight_g(product, units)
+        lines.append(
+            f"{product.name.ljust(name_width)}  {units:>5} units  {batches:>3} batches  {grams:>7} g dough"
+        )
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays going in the oven: one tray per batch, summed over every product in `plan_result`."""
     return sum(batches for _units, batches in plan_result.values())
