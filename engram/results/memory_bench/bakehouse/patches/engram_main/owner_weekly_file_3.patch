+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.tmpdir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmpdir.name, "week.csv")
+
+    def tearDown(self):
+        self.tmpdir.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8-sig", newline="") as f:
+            return f.read().splitlines()
+
+    def test_one_row_per_customer_with_comma_decimal_and_semicolons(self):
+        week_start = datetime.date(2026, 10, 19)  # a Monday
+        book = OrderBook(self.catalog, [
+            OrderLine(week_start, "LUMEN", "BAG", 5),
+            OrderLine(week_start + datetime.timedelta(days=3), "LUMEN", "SOU", 10),
+            OrderLine(week_start + datetime.timedelta(days=6), "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, week_start, self.path)
+        self.assertEqual(self.read(), [
+            "Customer;Total (£)",
+            "GREENWAY;19,00",
+            "LUMEN;36,75",
+        ])
+
+    def test_only_the_seven_days_from_week_start_count(self):
+        week_start = datetime.date(2026, 10, 19)
+        book = OrderBook(self.catalog, [
+            OrderLine(week_start - datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+            OrderLine(week_start, "LUMEN", "BAG", 1),
+            OrderLine(week_start + datetime.timedelta(days=6), "LUMEN", "BAG", 1),
+            OrderLine(week_start + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, week_start, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)", "LUMEN;1,90"])
+
+    def test_pence_below_ten_keep_their_leading_zero(self):
+        catalog = Catalog([Product("CHE", "Cheap roll", 5, batch_size=12)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "CHE", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read()[1], "LUMEN;0,05")
+
+    def test_no_orders_in_the_week_writes_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)"])
+
+
 if __name__ == "__main__":
     unittest.main()
