         if start <= line.day <= end:
             units[line.product] = units.get(line.product, 0) + line.qty
     return sorted(units, key=lambda code: (-units[code], code))[:n]
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Write each customer's order value for the seven days from `week_start` to `path`, sorted by customer code.
+
+    The file is for Greta's German-locale Excel: semicolon between fields, a comma before the pence,
+    and a UTF-8 byte order mark so Excel reads the £ sign correctly."""
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (£)"])
+        for customer in sorted(totals):
+            writer.writerow([customer, _pence_with_comma(totals[customer])])
+
+
+def _pence_with_comma(pence):
+    """Pounds with a comma decimal and no currency sign: 1234 -> '12,34'. Done in integers, never floats."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds},{rest:02d}"
