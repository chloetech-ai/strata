+class DeliveryChargeTest(unittest.TestCase):
+    def test_order_under_forty_pounds_pays_four_fifty(self):
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)
+        self.assertEqual(delivery_charge("GREENWAY", 1000), 450)
+
+    def test_order_of_exactly_forty_pounds_is_not_charged(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+
+    def test_order_over_forty_pounds_is_not_charged(self):
+        self.assertEqual(delivery_charge("OLDMILL", 4001), 0)
+
+    def test_st_aidans_is_never_charged(self):
+        self.assertEqual(delivery_charge("AIDAN", 1000), 0)
+        self.assertEqual(delivery_charge("AIDAN", 9000), 0)
