         for code, qty in sorted(qty_by_product.items())
     ]
     return Invoice(customer, day, lines)
+
+
+DELIVERY_CHARGE = 450  # pence, from November
+DELIVERY_CHARGE_UNDER = 4000  # pence; orders worth less than this (before VAT) pay the charge
+NO_DELIVERY_CHARGE = ("AIDAN",)  # contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day; `subtotal` is that order's value in pence before VAT."""
+    if customer_code in NO_DELIVERY_CHARGE:
+        return 0
+    if subtotal < DELIVERY_CHARGE_UNDER:
+        return DELIVERY_CHARGE
+    return 0
