+def pounds_plain(pence):
+    """Pounds for a file import, no currency sign: 1234 -> '12.34', -300 -> '-3.00'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write one CSV row per invoice (date, customer code, total) for the VAT return.
+
+    Dates are DD/MM/YYYY and totals are pounds with two decimals, as Ledgerly requires.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            writer.writerow([
+                invoice.day.strftime("%d/%m/%Y"),
+                invoice.customer,
+                pounds_plain(invoice.total()),
+            ])
+
+
