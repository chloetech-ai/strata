+class ExportInvoicesTest(unittest.TestCase):
+    def export(self, invoices):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        text = self.export([
+            Invoice("LUMEN", datetime.date(2026, 10, 3), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 4), [InvoiceLine("BAG", 40, 95)]),
+        ])
+        self.assertEqual(text, "Date,Customer,Total\r\n03/10/2026,LUMEN,45.60\r\n04/10/2026,GREENWAY,38.00\r\n")
+
+    def test_pence_are_written_as_pounds_with_two_decimals(self):
+        text = self.export([Invoice("LUMEN", datetime.date(2026, 10, 3), [InvoiceLine("BAG", 1, 5)])])
+        self.assertIn("03/10/2026,LUMEN,0.05", text)
+
+    def test_credit_note_total_is_negative_without_pound_sign(self):
+        text = self.export([Invoice("LUMEN", datetime.date(2026, 10, 3), [InvoiceLine("CRO", -1, 300)])])
+        self.assertIn("03/10/2026,LUMEN,-3.00", text)
+
+    def test_no_invoices_gives_header_only(self):
+        self.assertEqual(self.export([]), "Date,Customer,Total\r\n")
