+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong white flour": 1000, "Wholemeal flour": 200, "Water": 750, "Salt": 20}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 83.3, "Wholemeal flour": 16.7,
+             "Water": 62.5, "Salt": 1.7},
+        )
+
+    def test_rounds_to_one_decimal(self):
+        result = baker_percentages({"Flour": 300, "Water": 200, "Salt": 6})
+        self.assertEqual(result, {"Flour": 100.0, "Water": 66.7, "Salt": 2.0})
+
+    def test_flour_match_ignores_case(self):
+        result = baker_percentages({"RYE FLOUR": 100, "bread FLOUR": 100, "water": 80})
+        self.assertEqual(result, {"RYE FLOUR": 50.0, "bread FLOUR": 50.0, "water": 40.0})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 500, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 500})
