+"""Recipe maths: how each ingredient compares with the flour in a recipe."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: weight as a percent of total flour, to one decimal place}.
+
+    `recipe` maps ingredient names to grams. Any ingredient whose name contains
+    'flour' (any case) counts as flour. Raises ValueError if there is no flour.
+    """
+    flour_names = [name for name in recipe if "flour" in name.lower()]
+    if not flour_names:
+        raise ValueError("recipe has no flour, so baker's percentages are undefined")
+    total_flour = sum(recipe[name] for name in flour_names)
+    if total_flour <= 0:
+        raise ValueError(f"total flour must be positive, got {total_flour}")
+    return {name: round(grams * 100 / total_flour, 1) for name, grams in recipe.items()}
