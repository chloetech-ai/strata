+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order value for the seven days from `week_start`, before VAT.
+    Customers are in code order. The file is semicolon-separated with a comma decimal, for Excel on German Windows."""
+    week_end = week_start + datetime.timedelta(days=7)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day < week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total"])
+        for customer in sorted(totals):
+            writer.writerow([customer, _pounds_with_comma(totals[customer])])
+
+
+def _pounds_with_comma(pence):
+    """Pounds with two decimals and a comma: 1234 -> '12,34'. Negative amounts get a leading minus."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds},{rest:02d}"
