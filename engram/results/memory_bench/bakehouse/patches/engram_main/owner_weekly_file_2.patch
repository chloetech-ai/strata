+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.week_start = DAY  # 2026-10-20
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read().splitlines()
+
+    def test_sums_each_customer_over_the_seven_days_and_writes_comma_decimals(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=2), "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), ["Customer;Total", "GREENWAY;19,00", "LUMEN;7,95"])
+
+    def test_days_outside_the_week_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+            OrderLine(DAY + datetime.timedelta(days=7), "GREENWAY", "SOU", 1),
+            OrderLine(DAY, "AIDAN", "BAG", 1),
+        ])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), ["Customer;Total", "AIDAN;0,95"])
+
+    def test_pence_are_shown_with_two_digits(self):
+        catalog = Catalog([Product("CRU", "Crumb", 5, batch_size=1)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "CRU", 1)])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), ["Customer;Total", "LUMEN;0,05"])
+
+    def test_no_orders_in_the_week_gives_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), self.week_start, self.path)
+        self.assertEqual(self.read(), ["Customer;Total"])
+
+
 if __name__ == "__main__":
     unittest.main()
