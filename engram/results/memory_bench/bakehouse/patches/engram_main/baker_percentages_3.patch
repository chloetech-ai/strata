@@ -0,0 +1,29 @@
+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong White Flour": 1000, "Wholemeal Flour": 200, "Water": 750, "Salt": 20}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong White Flour": 83.3, "Wholemeal Flour": 16.7, "Water": 62.5, "Salt": 1.7},
+        )
+
+    def test_flour_is_matched_case_insensitively(self):
+        recipe = {"FLOUR": 500, "flour (rye)": 500, "Water": 350}
+        self.assertEqual(baker_percentages(recipe)["Water"], 35.0)
+        self.assertEqual(baker_percentages(recipe)["FLOUR"], 50.0)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
