+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product, hottest oven first.
+    Each line gives the name, pieces, batches and grams of dough to weigh out."""
+    catalog = orderbook.catalog
+    result = plan(orderbook, day)
+    codes = sorted(result, key=lambda code: (-catalog.get(code).bake_temp, code))
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = result[code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name}: pieces {units}, batches {batches}, dough {grams} g")
+    return "\n".join(lines)
