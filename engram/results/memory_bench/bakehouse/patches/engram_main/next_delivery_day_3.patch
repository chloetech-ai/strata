             self.assertEqual(is_delivery_day(day), day.weekday() not in config.CLOSED_WEEKDAYS)
 
 
+class NextDeliveryDayTest(unittest.TestCase):
+    def test_next_day_when_it_is_a_delivery_day(self):
+        self.assertEqual(next_delivery_day(datetime.date(2026, 10, 13)), datetime.date(2026, 10, 14))
+
+    def test_skips_closed_days(self):
+        # 2026-10-18 is a Sunday and 2026-10-19 a Monday; we are closed Mondays.
+        self.assertEqual(next_delivery_day(datetime.date(2026, 10, 17)), datetime.date(2026, 10, 18))
+        self.assertEqual(next_delivery_day(datetime.date(2026, 10, 18)), datetime.date(2026, 10, 20))
+
+    def test_is_strictly_after_the_given_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            following = next_delivery_day(day)
+            self.assertGreater(following, day)
+            self.assertTrue(is_delivery_day(following))
+            self.assertFalse(any(is_delivery_day(day + datetime.timedelta(days=d)) for d in range(1, (following - day).days)))
+
+
 if __name__ == "__main__":
     unittest.main()
