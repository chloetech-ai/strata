@@ -0,0 +1,95 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+OTHER_DAY = datetime.date(2026, 10, 21)
+
+
+def customer(code, name, route_seq):
+    return Customer(code, name, "1 Test Road", "LK1 1AA", route_seq)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, allergens=("wheat",)),
+            Product("SOU", "White sourdough", 320, batch_size=10, allergens=("wheat",)),
+            Product("RYE", "Seeded rye sourdough", 360, batch_size=8, allergens=("sesame", "wheat", "rye")),
+            Product("FLO", "Florentine", 90, batch_size=40),
+        ])
+        self.customers = {
+            "LUMEN": customer("LUMEN", "Café Lumen", 1),
+            "GREENWAY": customer("GREENWAY", "Greenway Grocers", 2),
+        }
+
+    def test_one_label_per_customer_and_product_with_name_quantity_allergens(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n10 x White sourdough\nWHEAT",
+            "Greenway Grocers\n20 x Baguette\nWHEAT",
+        ])
+
+    def test_labels_follow_route_order_then_product_code(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "SOU", 1),
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n3 x Baguette\nWHEAT",
+            "Cafe Lumen\n2 x White sourdough\nWHEAT",
+            "Greenway Grocers\n1 x White sourdough\nWHEAT",
+        ])
+
+    def test_quantities_for_the_same_customer_and_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+            OrderLine(DAY, "LUMEN", "BAG", 6),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n10 x Baguette\nWHEAT"])
+
+    def test_allergens_are_sorted_and_capitalised(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "RYE", 2)])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n2 x Seeded rye sourdough\nRYE, SESAME, WHEAT",
+        ])
+
+    def test_no_allergen_line_when_product_has_none(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "FLO", 5)])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n5 x Florentine"])
+
+    def test_only_the_given_day_is_labelled(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(OTHER_DAY, "LUMEN", "SOU", 1),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n1 x Baguette\nWHEAT"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog), self.customers, DAY), [])
+
+    def test_lines_are_ascii_and_fit_the_printer(self):
+        long_name = "The Very Long Tearoom Name of Somewhere Rather Far Away Ltd"
+        catalog = Catalog([Product("BRO", "Brötchen mit Körnern und Sesam extra", 40, batch_size=30, allergens=("wheat",))])
+        customers = {"X": customer("X", long_name, 1)}
+        book = OrderBook(catalog, [OrderLine(DAY, "X", "BRO", 30)])
+        (label,) = crate_labels(book, customers, DAY)
+        lines = label.split("\n")
+        self.assertEqual(len(lines), 3)
+        for line in lines:
+            self.assertLessEqual(len(line), LINE_WIDTH)
+            line.encode("ascii")
+        self.assertEqual(lines[0], long_name[:LINE_WIDTH])
+        self.assertTrue(lines[1].startswith("30 x Brotchen"))
+
+
+if __name__ == "__main__":
+    unittest.main()
