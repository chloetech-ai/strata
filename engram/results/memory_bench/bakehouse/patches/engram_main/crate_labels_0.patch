+"""Crate labels for packing: one label per customer and product for a delivery day."""
+
+import unicodedata
+
+LINE_WIDTH = 48  # characters per line on the packing-room label printer
+
+
+def _printable(text):
+    """Plain ASCII cut to the printer's line width. Accents are folded to their
+    base letter first, since the printer shows any other character as garbage."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return ascii_text[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """The text of each crate label for `day`, in route order and then by product code.
+
+    Each label is up to three lines: the customer's name, the quantity and product
+    name, then the allergens in capitals (omitted if the product has none)."""
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+
+    labels = []
+    for key in sorted(totals, key=lambda k: (customers[k[0]].route_seq, k[1])):
+        customer_code, product_code = key
+        product = orderbook.catalog.get(product_code)
+        lines = [customers[customer_code].name, f"{totals[key]} x {product.name}"]
+        if product.allergens:
+            lines.append(product.allergen_text().upper())
+        labels.append("\n".join(_printable(text) for text in lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
