+"""Crate labels for packing. The packing room printer prints plain ASCII only,
+48 characters per line, and cuts off anything longer."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def ascii_text(text):
+    """`text` as plain ASCII: accents are dropped (Brötchen -> Brotchen), anything else becomes '?'."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(c for c in decomposed if not unicodedata.combining(c))
+    return stripped.encode("ascii", "replace").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as a list of strings.
+
+    Labels are in van run order, then by product code. Each label has the customer's name,
+    the quantity and product name, then the allergens in capitals (left out if there are none).
+    Names are cut to fit the line; allergens are wrapped onto more lines so none are lost.
+    `customers` is the dict from load_customers.
+    """
+    quantities = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        quantities[key] = quantities.get(key, 0) + line.qty
+    keys = sorted(quantities, key=lambda k: (customers[k[0]].route_seq, k[1]))
+
+    labels = []
+    for customer_code, product_code in keys:
+        customer = customers[customer_code]
+        product = orderbook.catalog.get(product_code)
+        quantity = quantities[(customer_code, product_code)]
+        lines = [
+            ascii_text(customer.name)[:LINE_WIDTH],
+            ascii_text(f"{quantity} x {product.name}")[:LINE_WIDTH],
+        ]
+        if product.allergens:
+            lines.extend(textwrap.wrap(ascii_text(product.allergen_text().upper()), width=LINE_WIDTH))
+        labels.append("\n".join(lines))
+    return labels
