new file mode 100644
index 0000000..deb04ca
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,17 @@
+"""Wholesale price changes. All amounts are integer pence."""
+
+RISE_PERCENT = 5  # January wholesale price rise
+ROUND_UP_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} after the January rise.
+
+    Each price rises by RISE_PERCENT and is rounded up to the next 5p, so it never goes down.
+    Integer arithmetic only: ceil(price * 1.05 / 5) * 5 is written as a ceiling division.
+    """
+    prices = {}
+    for product in catalog:
+        raised = -(-product.price * (100 + RISE_PERCENT) // (100 * ROUND_UP_TO))
+        prices[product.code] = raised * ROUND_UP_TO
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..3c8306d
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,39 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320 * 1.05 = 336 -> 340
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_stays_put_when_rise_lands_on_it(self):
+        catalog = Catalog([Product("BAG", "Bagel", 100)])
+        # 100 * 1.05 = 105 exactly
+        self.assertEqual(new_prices(catalog), {"BAG": 105})
+
+    def test_fractional_rise_rounds_up(self):
+        catalog = Catalog([Product("FOC", "Focaccia", 350)])
+        # 350 * 1.05 = 367.5 -> 370
+        self.assertEqual(new_prices(catalog), {"FOC": 370})
+
+    def test_never_goes_down(self):
+        catalog = Catalog([Product(f"P{p}", "x", p) for p in range(0, 400)])
+        for product in catalog:
+            new = new_prices(catalog)[product.code]
+            self.assertGreaterEqual(new, product.price)
+            self.assertEqual(new % 5, 0)
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_empty_catalog(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
