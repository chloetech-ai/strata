     return f"LK-{year:04d}-{seq:04d}"
 
 
+SANDWICH_LOAF_CODES = ("SWL",)  # products that count as sandwich loaves for returns credit
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence (positive) for unsold sandwich loaves Greenway returned for one delivery day.
+
+    Only GREENWAY sandwich loaves are credited, at half the wholesale price per loaf. The credited
+    count is capped at 10% of the loaves delivered that day (rounded down); returns above the cap get nothing.
+    """
+    if customer_code != "GREENWAY" or product_code not in SANDWICH_LOAF_CODES:
+        return 0
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, not {delivered} and {returned}")
+    credited = min(returned, delivered * 10 // 100)
+    return credited * catalog.get(product_code).price // 2
+
+
