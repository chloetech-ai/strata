+def _pounds(pence):
+    """Plain pounds for an import file: 1234 -> '12.34', -300 -> '-3.00'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write one row per invoice (date, customer code, total) to `path` as CSV for the VAT return.
+
+    Dates are DD/MM/YYYY and totals are pounds with two decimals, the format Ledgerly imports.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([f"{invoice.day:%d/%m/%Y}", invoice.customer, _pounds(invoice.total())])
