+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "invoices.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_header_then_one_row_per_invoice(self):
+        export_invoices([
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("BAG", 40, 95)]),
+        ], self.path)
+        self.assertEqual(self.read_rows(), [
+            ["date", "customer", "total"],
+            ["20/10/2026", "LUMEN", "45.60"],
+            ["21/10/2026", "GREENWAY", "38.00"],
+        ])
+
+    def test_empty_invoice_is_a_zero_row(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 20))], self.path)
+        self.assertEqual(self.read_rows()[1], ["20/10/2026", "LUMEN", "0.00"])
+
+    def test_pence_under_a_pound_keep_two_decimals(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("X", 1, 5)])], self.path)
+        self.assertEqual(self.read_rows()[1][2], "0.05")
+
+    def test_credit_note_total_is_negative_with_point_decimal(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("X", -3, 100)])], self.path)
+        self.assertEqual(self.read_rows()[1][2], "-3.00")
+
+    def test_no_invoices_gives_header_only(self):
+        export_invoices([], self.path)
+        self.assertEqual(self.read_rows(), [["date", "customer", "total"]])
+
+
 if __name__ == "__main__":
     unittest.main()
