+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="cp1252", newline="") as f:
+            return f.read()
+
+    def test_seven_days_from_week_start_inclusive(self):
+        week_start = DAY
+        book = OrderBook(self.catalog, [
+            OrderLine(week_start - datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+            OrderLine(week_start, "LUMEN", "BAG", 1),
+            OrderLine(week_start + datetime.timedelta(days=6), "LUMEN", "BAG", 2),
+            OrderLine(week_start + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, week_start, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\nLUMEN;2,85\r\n")
+
+    def test_one_row_per_customer_sorted_with_pounds_and_comma_decimal(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+            OrderLine(OTHER_DAY, "GREENWAY", "BAG", 20),
+            OrderLine(OTHER_DAY, "GREENWAY", "SOU", 1),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\nGREENWAY;22,20\r\nLUMEN;32,00\r\n")
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\nLUMEN;0,95\r\n")
+
+    def test_no_orders_writes_header_only(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\n")
+
+
