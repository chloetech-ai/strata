+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order value for the seven days from `week_start` inclusive.
+    The file is semicolon-separated with a comma decimal, for Excel on German Windows; amounts are in pounds.
+    Rows are sorted by customer code; customers with no orders that week are left out."""
+    week_end = week_start + datetime.timedelta(days=7)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day < week_end:
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * orderbook.catalog.get(line.product).price
+    with open(path, "w", newline="", encoding="cp1252") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds},{pence:02d}"])
+
