@@ -0,0 +1,19 @@
+"""January wholesale price rise: +5% per product, rounded up to the next 5p, never down."""
+
+RISE_PERCENT = 5  # Greta changed this from 4% after talking to the cafés
+ROUND_TO_PENCE = 5  # new prices end in 0 or 5 so they look right on café price boards
+
+
+def new_price(price):
+    """The price after the rise, in pence: `price` plus 5%, rounded up to the next 5p.
+
+    Uses integer arithmetic so no amount is ever held as a float.
+    """
+    raised = price * (100 + RISE_PERCENT)  # 1.05 * price, times 100 to stay whole
+    step = 100 * ROUND_TO_PENCE  # one 5p step, on the same scale
+    return -(-raised // step) * ROUND_TO_PENCE  # ceiling division
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in `catalog`."""
+    return {product.code: new_price(product.price) for product in catalog}
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..82be610
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,32 @@
+import unittest
+
+from bakehouse.pricing import new_price, new_prices
+from bakehouse.products import Catalog, Product
+
+
+class PricingTest(unittest.TestCase):
+    def test_rise_is_rounded_up_to_next_5p(self):
+        # 320 * 1.05 = 336 -> 340
+        self.assertEqual(new_price(320), 340)
+
+    def test_exact_multiple_of_5p_is_not_rounded_further(self):
+        # 400 * 1.05 = 420 exactly
+        self.assertEqual(new_price(400), 420)
+
+    def test_never_goes_down(self):
+        for price in range(0, 2000):
+            self.assertGreaterEqual(new_price(price) * 100, price * 105)
+
+    def test_zero_price_stays_zero(self):
+        self.assertEqual(new_price(0), 0)
+
+    def test_new_prices_maps_each_code(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),
+            Product("BUN", "Bun", 95),
+        ])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BUN": 100})
+
+
+if __name__ == "__main__":
+    unittest.main()
