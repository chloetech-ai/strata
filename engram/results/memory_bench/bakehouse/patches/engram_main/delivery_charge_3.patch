@@ -40,6 +40,18 @@ def invoice_number(year, seq):
     return f"LK-{year:04d}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, from November
+DELIVERY_CHARGE_BELOW = 4000  # pence: orders under £40.00 pay the charge
+NO_DELIVERY_CHARGE = {"AIDAN"}  # contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one delivery day's order value `subtotal` (pence, before VAT)."""
+    if customer_code in NO_DELIVERY_CHARGE or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
