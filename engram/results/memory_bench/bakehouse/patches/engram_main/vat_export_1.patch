+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "invoices.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_header_then_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 4), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 5), [InvoiceLine("BAG", 40, 95)]),
+        ]
+        export_invoices(invoices, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["date", "customer", "total"],
+            ["04/10/2026", "LUMEN", "45.60"],
+            ["05/10/2026", "GREENWAY", "38.00"],
+        ])
+
+    def test_empty_invoice_exports_zero(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 4))], self.path)
+        self.assertEqual(self.read_rows()[1], ["04/10/2026", "LUMEN", "0.00"])
+
+    def test_credit_note_total_is_negative_pounds(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 4), [InvoiceLine("CRO", -3, 100)])], self.path)
+        self.assertEqual(self.read_rows()[1], ["04/10/2026", "LUMEN", "-3.00"])
+
+    def test_no_invoices_gives_header_only(self):
+        export_invoices([], self.path)
+        self.assertEqual(self.read_rows(), [["date", "customer", "total"]])
+
+    def test_customer_code_with_comma_is_quoted(self):
+        export_invoices([Invoice("LUMEN, ASHBY", datetime.date(2026, 10, 4), [InvoiceLine("CRO", 1, 5)])], self.path)
+        self.assertEqual(self.read_rows()[1], ["04/10/2026", "LUMEN, ASHBY", "0.05"])
+
