+def export_invoices(invoices, path):
+    """Write one row per invoice (date, customer code, total) to a CSV file for the VAT return.
+
+    Dates are DD/MM/YYYY and the total is in pounds with two decimals, e.g. 12.50, as Ledgerly imports them.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            pence = invoice.total()
+            sign = "-" if pence < 0 else ""
+            pounds, rest = divmod(abs(pence), 100)
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, f"{sign}{pounds}.{rest:02d}"])
+
