+class ExportInvoicesTest(unittest.TestCase):
+    def export(self, invoices):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="") as f:
+                return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        text = self.export([
+            Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 3), [InvoiceLine("BAG", 40, 95)]),
+        ])
+        self.assertEqual(text, "Date,Customer,Total\r\n02/10/2026,LUMEN,45.60\r\n03/10/2026,GREENWAY,38.00\r\n")
+
+    def test_empty_invoice_is_a_zero_row(self):
+        text = self.export([Invoice("LUMEN", datetime.date(2026, 10, 2))])
+        self.assertEqual(text, "Date,Customer,Total\r\n02/10/2026,LUMEN,0.00\r\n")
+
+    def test_negative_total_gets_leading_minus_without_pound_sign(self):
+        text = self.export([Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", -3, 100)])])
+        self.assertEqual(text, "Date,Customer,Total\r\n02/10/2026,LUMEN,-3.00\r\n")
+
+    def test_no_invoices_gives_header_only(self):
+        self.assertEqual(self.export([]), "Date,Customer,Total\r\n")
+
