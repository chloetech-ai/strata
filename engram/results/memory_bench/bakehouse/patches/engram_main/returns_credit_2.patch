     return Invoice(customer, day, lines)
+
+
+# Products that count as sandwich loaves for the Greenway returns credit.
+SANDWICH_LOAF_CODES = ("SWL",)
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for the unsold loaves `customer_code` returned from one delivery.
+
+    Only GREENWAY's sandwich loaves earn credit: half the wholesale price per returned loaf, for at
+    most 10% of the loaves delivered that day (rounded down). Returns above that cap get no credit.
+    Everything else gets 0.
+    """
+    if customer_code != "GREENWAY" or product_code not in SANDWICH_LOAF_CODES:
+        return 0
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, not {delivered} and {returned}")
+    price = catalog.get(product_code).price
+    credited = min(returned, delivered * 10 // 100)
+    return credited * price // 2
