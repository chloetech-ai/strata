+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SWL", "Sandwich loaf", 180, batch_size=16),
+            Product("BAG", "Baguette", 95, batch_size=12),
+        ])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 4), 4 * 90)
+
+    def test_credit_capped_at_ten_percent_of_delivered(self):
+        # 10% of 32 is 3.2, so 3 loaves are credited and the other 7 are not
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 10), 3 * 90)
+
+    def test_cap_rounds_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 5), 0)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 0), 0)
+
+    def test_odd_price_rounds_credit_down(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 181)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 20, 2), 181)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 32, 3), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 32, 3), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 32, -1)
+
