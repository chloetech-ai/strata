+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SWL", "Sandwich loaf", 180, batch_size=16),
+        ])
+
+    def test_half_the_wholesale_price_per_returned_sandwich_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 20, 2), 2 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 20, 0), 0)
+
+    def test_returns_capped_at_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 20, 3), 2 * 90)
+
+    def test_cap_rounds_down_to_whole_loaves(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 5), 2 * 90)
+
+    def test_no_credit_below_one_loaf_of_cap(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 1), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 20, 2), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 20, 2), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 20, -1)
+
+
