     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """The credit in pence for `returned` unsold units from one delivery of `product_code`
+    to `customer_code`, where `delivered` units were delivered.
+
+    Only Greenway Grocers (GREENWAY) gets credit, and only on sandwich loaves (SWL): half
+    the wholesale price per returned loaf, for returns up to 10% of the loaves delivered.
+    Returns above that are not credited. Everything else is credited nothing.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if customer_code != "GREENWAY" or product_code != "SWL":
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * catalog.get(product_code).price // 2
+
+
 def format_pence(pence):
