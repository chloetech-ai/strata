new file mode 100644
index 0000000..9be545e
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,23 @@
+"""Wholesale price changes. All amounts are integer pence."""
+
+# January 2027 rise: 5% on every wholesale price.
+JANUARY_RISE_PERCENT = 5
+
+# New prices are rounded up to the next multiple of this, never down, because
+# cafés print price boards and odd pennies look silly.
+ROUND_UP_TO = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for the January price rise.
+
+    Each price is raised by JANUARY_RISE_PERCENT, then rounded up to the next
+    ROUND_UP_TO pence. Integer arithmetic avoids float rounding errors, e.g.
+    95p -> 99.75p -> 100p and 320p -> 336p -> 340p.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + JANUARY_RISE_PERCENT)  # in hundredths of a penny
+        step = 100 * ROUND_UP_TO
+        prices[product.code] = -(-raised // step) * ROUND_UP_TO  # ceiling division
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..2139d11
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,30 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_raises_by_five_percent_and_rounds_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95),  # 99.75p
+            Product("SOU", "White sourdough", 320),  # 336p
+            Product("BRO", "Brötchen", 40),  # 42p
+        ])
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "SOU": 340, "BRO": 45})
+
+    def test_price_already_on_a_5p_step_after_rise_is_kept(self):
+        catalog = Catalog([Product("X", "Test", 100)])  # 105p exactly
+        self.assertEqual(new_prices(catalog), {"X": 105})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Taster", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_covers_every_product_in_catalog(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("CRO", "Croissant", 110)])
+        self.assertEqual(set(new_prices(catalog)), {"BAG", "CRO"})
+
+
+if __name__ == "__main__":
+    unittest.main()
