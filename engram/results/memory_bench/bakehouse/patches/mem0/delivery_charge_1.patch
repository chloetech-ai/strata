+DELIVERY_CHARGE = 300  # pence
+DELIVERY_CHARGE_UNDER = 2500  # pence; orders of this value or more pay no delivery charge
+DELIVERY_INCLUDED = ("AIDAN",)  # customers whose contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """The delivery charge in pence for `customer_code`'s order worth `subtotal` pence
+    before VAT for one delivery day: £3.00 under £25.00, otherwise nothing. Customers in
+    DELIVERY_INCLUDED never pay it, and neither does an empty order."""
+    if subtotal < 0:
+        raise ValueError(f"subtotal cannot be negative, got {subtotal}")
+    if customer_code in DELIVERY_INCLUDED or subtotal == 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_CHARGE_UNDER else 0
+
+
 def invoice_number(year, seq):
