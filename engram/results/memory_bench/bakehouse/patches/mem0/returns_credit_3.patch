+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SWL", "Sandwich loaf", 180, batch_size=16),
+            Product("BAG", "Baguette", 95, batch_size=12),
+        ])
+
+    def test_half_price_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 3), 3 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 0), 0)
+
+    def test_capped_at_ten_percent_of_delivery(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 9), 5 * 90)
+
+    def test_cap_rounds_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 19, 5), 1 * 90)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 50, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 50, 5), 0)
+
+    def test_returns_must_not_exceed_delivery(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, 11)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+
