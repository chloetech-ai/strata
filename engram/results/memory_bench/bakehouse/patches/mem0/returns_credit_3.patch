+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold loaves from one delivery of `product_code`.
+
+    Greenway's sale-or-return terms apply only to sandwich loaves: each returned loaf
+    is credited at half its wholesale price, and credit is capped at 10% of the loaves
+    delivered (rounded down). Other customers and products get no credit. Raises
+    ValueError if the counts are negative or more loaves came back than were delivered.
+    """
+    if delivered < 0 or returned < 0 or returned > delivered:
+        raise ValueError(f"need 0 <= returned <= delivered, got returned={returned}, delivered={delivered}")
+    if customer_code != "GREENWAY" or product_code != "SWL":
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * (catalog.get(product_code).price // 2)
+
+
