+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_with_date_customer_and_total_in_pence(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("BAG", 20, 95)]),
+        ]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["date", "customer", "total_pence"],
+            ["2026-10-20", "LUMEN", str(24 * 110 + 6 * 320)],
+            ["2026-10-21", "GREENWAY", str(20 * 95)],
+        ])
+
+    def test_no_invoices_writes_only_the_header(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices([], path)
+            with open(path, newline="", encoding="utf-8") as f:
+                self.assertEqual(list(csv.reader(f)), [["date", "customer", "total_pence"]])
