+"""Crate labels for packing a delivery day.
+
+The label printer takes plain ASCII and cuts off anything longer than a line, so
+every line is folded to fit LINE_WIDTH.
+"""
+
+import textwrap
+import unicodedata
+
+from .invoice import invoice_for
+
+LINE_WIDTH = 32  # the old printer's width; the new one prints 48, so this fits both
+
+
+def _printable(text):
+    """Fold accents to plain ASCII, e.g. 'Bäckerei' -> 'Backerei', and wrap to LINE_WIDTH."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return textwrap.wrap(ascii_text, LINE_WIDTH) or [""]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, with customers
+    in route order. Each label is the customer's name, then the quantity and product
+    name, then the allergens in capitals if the product has any."""
+    labels = []
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    for code in codes:
+        customer = customers[code]
+        for line in invoice_for(orderbook, code, day).lines:
+            product = orderbook.catalog.get(line.product)
+            lines = _printable(customer.name) + _printable(f"{line.qty} x {product.name}")
+            if product.allergens:
+                lines += _printable("ALLERGENS: " + product.allergen_text().upper())
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
