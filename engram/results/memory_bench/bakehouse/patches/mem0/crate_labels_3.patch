index 0000000..a1e450c
--- /dev/null
+++ b/tests/test_labels.py
@@ -0,0 +1,58 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, allergens=("wheat",)),
+            Product("SOU", "White sourdough", 320, batch_size=10, allergens=("wheat", "sesame")),
+            Product("OAT", "Oat roll", 60, batch_size=12),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "1 High St", "AB1 2CD", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Stores", "9 Mill Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+            OrderLine(DAY, "GREENWAY", "OAT", 20),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Stores\n20 x Oat roll",
+            "Lumen Cafe\n8 x Baguette\nALLERGENS: WHEAT",
+            "Lumen Cafe\n6 x White sourdough\nALLERGENS: SESAME, WHEAT",
+        ])
+
+    def test_ignores_other_days(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 9),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_accents_are_folded_to_ascii(self):
+        customers = {"BAK": Customer("BAK", "Bäckerei Müller", "2 Oak Ln", "AB5 6GH", 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "BAK", "OAT", 4)])
+        self.assertEqual(crate_labels(book, customers, DAY), ["Backerei Muller\n4 x Oat roll"])
+
+    def test_long_lines_wrap_to_the_printer_width(self):
+        customers = {"LNG": Customer("LNG", "The Very Long Named Village Shop And Post Office", "", "", 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LNG", "OAT", 1)])
+        label = crate_labels(book, customers, DAY)[0]
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertEqual(label.split("\n")[-1], "1 x Oat roll")
+
+
+if __name__ == "__main__":
+    unittest.main()
