+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10, allergens=("wheat", "sesame")),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "1 High St", "AB1 2CD", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 Mill Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 4),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Grocers\n20 x Baguette",
+            "Lumen Cafe\n5 x Baguette",
+            "Lumen Cafe\n4 x White sourdough\nSESAME, WHEAT",
+        ])
+
+    def test_quantities_for_the_same_product_are_added_together(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Lumen Cafe\n5 x Baguette"])
+
+    def test_product_without_allergens_has_no_allergen_line(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "GREENWAY", "BAG", 1)])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Greenway Grocers\n1 x Baguette"])
+
+    def test_orders_for_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 5),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
