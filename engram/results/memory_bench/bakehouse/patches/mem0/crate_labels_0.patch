+"""Crate labels: one label per customer and product for a delivery day, printed for the packing room."""
+
+
+def crate_labels(orderbook, customers, day):
+    """The text of each crate label for delivery on `day`, one per customer and product.
+
+    Labels run in van route order (by route_seq), then by product code. Each label is
+    three lines: the customer's name, the quantity and product name, and the allergens
+    in capitals (allergens must be emphasised, and the printer cannot do bold). The
+    allergen line is left out for a product with no allergens.
+    """
+    labels = []
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    for code in codes:
+        customer = customers[code]
+        qty_by_product = {}
+        for line in orderbook.lines_for(code, day):
+            qty_by_product[line.product] = qty_by_product.get(line.product, 0) + line.qty
+        for product_code in sorted(qty_by_product):
+            product = orderbook.catalog.get(product_code)
+            text = [customer.name, f"{qty_by_product[product_code]} x {product.name}"]
+            if product.allergens:
+                text.append(product.allergen_text().upper())
+            labels.append("\n".join(text))
+    return labels
