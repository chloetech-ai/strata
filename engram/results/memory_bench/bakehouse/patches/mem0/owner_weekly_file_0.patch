+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_one_row_per_customer_totalled_over_the_week_in_pounds(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "SOU", 10),
+            OrderLine(DAY + datetime.timedelta(days=6), "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "19.00"],
+            ["LUMEN", "36.75"],
+        ])
+
+    def test_days_outside_the_seven_are_ignored(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=2), "LUMEN", "BAG", 1),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"], ["LUMEN", "0.95"]])
+
+    def test_no_orders_gives_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"]])
+
+
 if __name__ == "__main__":
     unittest.main()
