+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text, one line per product, hottest oven first.
+
+    Each line gives the product name, units, batches and the dough to weigh out in whole grams.
+    Products with the same oven temperature keep product code order.
+    """
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    codes = sorted(rows, key=lambda code: (-catalog.get(code).bake_temp, code))
+    width = max(len(catalog.get(code).name) for code in codes)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}",
+    ]
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        dough = f"{dough_weight_g(product, units)} g"
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough:>8}")
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays in the oven for a plan: one tray holds one batch, so this is the sum of all batches."""
     return sum(batches for _units, batches in plan_result.values())
