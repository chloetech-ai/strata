+++ b/tests/test_pricing.py
@@ -0,0 +1,32 @@
+import os
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product, load_catalog
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),  # 336 -> 340
+            Product("BAG", "Baguette", 95),  # 99.75 -> 100
+            Product("BKW", "Bakewell slice", 150),  # 157.5 -> 160
+        ])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 100, "BKW": 160})
+
+    def test_exact_multiple_of_5p_is_not_bumped_again(self):
+        # 200 * 1.05 = 210 exactly, which is already a multiple of 5p
+        self.assertEqual(new_prices(Catalog([Product("X", "Test", 200)])), {"X": 210})
+
+    def test_free_product_stays_free(self):
+        self.assertEqual(new_prices(Catalog([Product("FREE", "Taster", 0)])), {"FREE": 0})
+
+    def test_covers_every_product_in_catalog(self):
+        catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        prices = new_prices(catalog)
+        self.assertEqual(set(prices), {p.code for p in catalog})
+        for product in catalog:
+            self.assertGreaterEqual(prices[product.code], product.price * 1.05)
+            self.assertEqual(prices[product.code] % 5, 0)
