new file mode 100644
index 0000000..a35a8ed
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,17 @@
+"""Price rises. All amounts are integer pence."""
+
+RISE_PERCENT = 5  # January 2027 wholesale price rise
+ROUND_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for the January 2027 price rise.
+
+    Each price goes up by RISE_PERCENT and is rounded up, never down, to the next
+    multiple of ROUND_TO pence. Integer arithmetic avoids float error, e.g. 320 -> 340
+    (336 rounded up), 95 -> 100 (99.75 rounded up).
+    """
+    return {
+        product.code: -(-product.price * (100 + RISE_PERCENT) // (100 * ROUND_TO)) * ROUND_TO
+        for product in catalog
+    }
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
