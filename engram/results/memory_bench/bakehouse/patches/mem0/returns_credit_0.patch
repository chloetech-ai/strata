+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SWL", "Sandwich loaf", 180, batch_size=16),
+        ])
+
+    def test_half_wholesale_price_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 160, 3), 3 * 90)
+
+    def test_returns_up_to_ten_percent_of_delivery_are_all_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 160, 16), 16 * 90)
+
+    def test_returns_above_ten_percent_are_not_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 160, 17), 16 * 90)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 160, 160), 16 * 90)
+
+    def test_cap_is_rounded_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 5), 2 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 160, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 160, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 160, 5), 0)
+
+    def test_returned_more_than_delivered_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, 11)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+
