+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` loaves of one delivery of `product_code`.
+
+    Only Greenway's sandwich loaves earn credit: half the wholesale price per returned
+    loaf, for at most a tenth of the loaves delivered (rounded down). Returns above that
+    are not credited. Raises ValueError if the counts are negative or `returned` is more
+    than `delivered`.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} of {delivered} delivered")
+    if customer_code != "GREENWAY" or product_code != "SWL":
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * catalog.get(product_code).price // 2
+
+
