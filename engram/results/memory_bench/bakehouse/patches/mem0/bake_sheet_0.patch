diff --git a/src/bakehouse/production.py b/src/bakehouse/production.py
index e8aca65..9597c72 100644
--- a/src/bakehouse/production.py
+++ b/src/bakehouse/production.py
@@ -33,3 +33,16 @@ def plan(orderbook, day):
 def total_batches(plan_result):
     """Trays in the oven for a plan: one tray holds one batch, so this is the sum of all batches."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product, hottest oven temperature first."""
+    rows = []
+    for code, (units, batches) in plan(orderbook, day).items():
+        product = orderbook.catalog.get(code)
+        rows.append((product, units, batches))
+    rows.sort(key=lambda row: (-row[0].bake_temp, row[0].code))
+    return "\n".join(
+        f"{product.name:<24} {units:>4} units  {batches:>2} batches  {dough_weight_g(product, units):>7} g dough"
+        for product, units, batches in rows
+    )
