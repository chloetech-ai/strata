+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text, one line per product, hottest oven first.
+
+    Each line gives the units, the batches, and the dough to weigh out in grams. Only
+    whole batches are baked, so the dough is weighed for every piece in those batches.
+    """
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    products = sorted((catalog.get(code) for code in rows), key=lambda p: (-p.bake_temp, p.code))
+    width = max(len(p.name) for p in products)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}",
+    ]
+    for product in products:
+        units, batches = rows[product.code]
+        dough = dough_weight_g(product, batches * product.batch_size)
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {str(dough) + ' g':>8}")
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays in the oven for a plan: one tray holds one batch, so this is the sum of all batches."""
     return sum(batches for _units, batches in plan_result.values())
