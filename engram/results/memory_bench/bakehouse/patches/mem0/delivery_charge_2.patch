--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -48,6 +48,20 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, on an order under DELIVERY_CHARGE_BELOW
+DELIVERY_CHARGE_BELOW = 4000  # pence
+NO_DELIVERY_CHARGE = {"AIDAN"}  # customers whose contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day, where
+    `subtotal` is the value of that order in pence before VAT. £4.50 on any order under
+    £40.00; no charge for an empty order or for a customer in NO_DELIVERY_CHARGE."""
+    if customer_code in NO_DELIVERY_CHARGE or not 0 < subtotal < DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def format_pence(pence):
     """Display an amount in pence as pounds, e.g. 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
