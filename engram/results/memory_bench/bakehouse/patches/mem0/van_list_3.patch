+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers_by_code():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 High Street", "LK3 4RT", 4),
+        "POTTER": Customer("POTTER", "Potter's Farm Shop", "Lower Farm, Ashby Road", "LK5 3PF", 6),
+    }
+
+
+class DropsFileTest(unittest.TestCase):
+    def read_drops(self, orderbook, customers, day):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(orderbook, customers, day, path)
+            with open(path, encoding="utf-8") as f:
+                return f.read()
+
+    def test_lists_only_customers_with_orders_that_day_in_route_order(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "BAG", 2),
+        ])
+        self.assertEqual(
+            self.read_drops(book, customers_by_code(), DAY),
+            "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+            "2. Greenway Grocers, 9 High Street, LK3 4RT\n",
+        )
+
+    def test_customer_with_several_lines_appears_once(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "POTTER", "BAG", 4),
+            OrderLine(DAY, "POTTER", "SOU", 2),
+        ])
+        self.assertEqual(
+            self.read_drops(book, customers_by_code(), DAY),
+            "1. Potter's Farm Shop, Lower Farm, Ashby Road, LK5 3PF\n",
+        )
+
+    def test_day_with_no_orders_writes_empty_file(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BAG", 4)])
+        self.assertEqual(self.read_drops(book, customers_by_code(), DAY + datetime.timedelta(days=3)), "")
+
+    def test_order_for_unknown_customer_is_rejected(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [OrderLine(DAY, "NOBODY", "BAG", 4)])
+        with tempfile.TemporaryDirectory() as tmp:
+            with self.assertRaisesRegex(ValueError, "NOBODY"):
+                drops_file(book, customers_by_code(), DAY, os.path.join(tmp, "drops.txt"))
+
+
+if __name__ == "__main__":
+    unittest.main()
