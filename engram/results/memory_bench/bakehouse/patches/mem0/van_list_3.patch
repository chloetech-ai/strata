+"""The van's run: the drops for a delivery day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one numbered line per customer with
+    orders that day, in route order. `customers` is the dict from load_customers.
+
+    Raises ValueError if an order names a customer code that is not in `customers`.
+    """
+    codes = orderbook.customers_for(day)
+    for code in codes:
+        if code not in customers:
+            raise ValueError(f"no customer {code} in customers.csv for {day.isoformat()}")
+    stops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for number, stop in enumerate(stops, start=1):
+            f.write(f"{number}. {stop.name}, {stop.address}, {stop.postcode}\n")
