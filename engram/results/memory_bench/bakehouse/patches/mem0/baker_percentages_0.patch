+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 500, "Water": 350, "Salt": 10, "Levain": 100}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 100.0, "Water": 70.0, "Salt": 2.0, "Levain": 20.0},
+        )
+
+    def test_every_flour_counts_towards_total_flour(self):
+        recipe = {"White Flour": 300, "wholemeal FLOUR": 200, "Water": 350}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"White Flour": 60.0, "wholemeal FLOUR": 40.0, "Water": 70.0},
+        )
+
+    def test_percentages_are_rounded_to_one_decimal(self):
+        recipe = {"Flour": 300, "Water": 200}
+        self.assertEqual(baker_percentages(recipe), {"Flour": 100.0, "Water": 66.7})
+
+    def test_recipe_without_flour_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_empty_recipe_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
+
+
+if __name__ == "__main__":
+    unittest.main()
