+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 100, "Water": 350, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 83.3, "Wholemeal flour": 16.7, "Water": 58.3, "Salt": 1.7},
+        )
+
+    def test_flour_matching_is_case_insensitive(self):
+        recipe = {"RYE FLOUR": 200, "water": 150}
+        self.assertEqual(baker_percentages(recipe), {"RYE FLOUR": 100.0, "water": 75.0})
+
+    def test_raises_when_there_is_no_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Strong white flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
