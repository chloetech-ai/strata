+"""Recipe maths: ingredient weights expressed as baker's percentages."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: percent of total flour weight}, rounded to one decimal place.
+
+    Any ingredient whose name contains "flour" (any case) counts as flour.
+    Raises ValueError if the recipe has no flour to take a percentage of.
+    """
+    flour_g = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_g <= 0:
+        raise ValueError("recipe has no flour to base percentages on")
+    return {name: round(grams / flour_g * 100, 1) for name, grams in recipe.items()}
