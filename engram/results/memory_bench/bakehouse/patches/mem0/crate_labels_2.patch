+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LABEL_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, allergens=("wheat",)),
+            Product("SOU", "White sourdough", 320, batch_size=10, allergens=("wheat", "sesame", "rye")),
+            Product("CRK", "Plain cracker", 80, batch_size=10),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "1 High St", "AB1 2CD", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Stores", "9 Mill Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+            OrderLine(DAY, "GREENWAY", "CRK", 4),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "CRK", 9),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Stores\n4 x Plain cracker",
+            "Lumen Cafe\n8 x Baguette\nCONTAINS: WHEAT",
+            "Lumen Cafe\n6 x White sourdough\nCONTAINS: RYE, SESAME, WHEAT",
+        ])
+
+    def test_no_labels_for_a_day_with_no_orders(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 5)])
+        self.assertEqual(crate_labels(book, self.customers, DAY + datetime.timedelta(days=1)), [])
+
+    def test_accents_are_folded_to_ascii(self):
+        customers = {"MUL": Customer("MUL", "Müller & Søn", "2 Oak Ln", "AB5 6GH", 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "MUL", "CRK", 2)])
+        self.assertEqual(crate_labels(book, customers, DAY), ["Muller & Sn\n2 x Plain cracker"])
+
+    def test_long_names_wrap_within_the_printer_width(self):
+        long_name = "The Very Long Named Harbourside Community Kitchen and Bakery Cooperative Ltd"
+        customers = {"LNG": Customer("LNG", long_name, "3 Quay", "AB7 8IJ", 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LNG", "CRK", 1)])
+        labels = crate_labels(book, customers, DAY)
+        self.assertEqual(len(labels), 1)
+        lines = labels[0].split("\n")
+        for line in lines:
+            self.assertLessEqual(len(line), LABEL_WIDTH)
+        self.assertEqual(" ".join(lines[:-1]), long_name)
+        self.assertEqual(lines[-1], "1 x Plain cracker")
+
+
+if __name__ == "__main__":
+    unittest.main()
