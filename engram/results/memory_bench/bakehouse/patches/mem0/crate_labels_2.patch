+"""Crate labels for packing."""
+
+import textwrap
+import unicodedata
+
+from .invoice import invoice_for
+
+# The packing room's label printer fits this many characters per line and cuts off the rest.
+LABEL_WIDTH = 48
+
+
+def _wrap(text):
+    """Folds `text` to plain ASCII for the printer and wraps it to LABEL_WIDTH.
+
+    Accents are folded to their base letter, e.g. 'Müller' -> 'Muller'; other non-ASCII is dropped.
+    """
+    folded = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return textwrap.wrap(folded, LABEL_WIDTH, break_long_words=True) or [""]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in route order.
+
+    Each label is the customer's name, then the quantity and product name, then
+    'CONTAINS: ' and the allergens in capitals if the product has any.
+    `customers` is the dict that load_customers returns.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        for line in invoice_for(orderbook, code, day).lines:
+            product = orderbook.catalog.get(line.product)
+            lines = _wrap(customer.name) + _wrap(f"{line.qty} x {product.name}")
+            if product.allergens:
+                lines += _wrap("CONTAINS: " + product.allergen_text().upper())
+            labels.append("\n".join(lines))
+    return labels
