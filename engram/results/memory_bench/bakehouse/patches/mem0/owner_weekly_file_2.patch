+def week_totals(orderbook, week_start):
+    """{customer code: order value in pence} for everything ordered for delivery on
+    the seven days starting at `week_start`."""
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    return dict(sorted(totals.items()))
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Write one CSV row per customer with their order total in pounds for the seven
+    days starting at `week_start`. Customers with no orders that week are left out."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_gbp"])
+        for customer, pence in week_totals(orderbook, week_start).items():
+            pounds, rest = divmod(pence, 100)
+            writer.writerow([customer, f"{pounds}.{rest:02d}"])
+
