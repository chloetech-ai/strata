+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.week = DAY
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_sums_each_customer_over_the_week_in_pounds(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY + datetime.timedelta(days=4), "GREENWAY", "BAG", 3),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 10),
+        ])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "21.85"],
+            ["LUMEN", "32.00"],
+        ])
+
+    def test_week_covers_seven_days_inclusive(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 1),
+        ])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"], ["LUMEN", "1.90"]])
+
+    def test_pence_are_zero_padded(self):
+        catalog = Catalog([Product("CHE", "Cheap", 5, batch_size=1)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "CHE", 3)])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self.read_rows()[1], ["LUMEN", "0.15"])
+
+    def test_no_orders_writes_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), self.week, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"]])
+
