+"""Crate labels for packing."""
+
+from .invoice import invoice_for
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in van run order.
+
+    Each label is three lines: the customer's name, the quantity and product name, and
+    the allergens in capitals (the law wants them to stand out). Products with no
+    allergens get no allergen line. `customers` is the dict from load_customers.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        for line in invoice_for(orderbook, code, day).lines:
+            product = orderbook.catalog.get(line.product)
+            text = [customer.name, f"{line.qty} x {product.name}"]
+            if product.allergens:
+                text.append(f"CONTAINS: {product.allergen_text().upper()}")
+            labels.append("\n".join(text))
+    return labels
