+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,18 @@
+"""Wholesale price rises."""
+
+RISE_PERCENT = 5  # the January 2027 rise
+ROUND_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} after the January 2027 rise.
+
+    Each price goes up by RISE_PERCENT and is rounded up (never down) to the next
+    5p. Integer arithmetic only, so no float rounding.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + RISE_PERCENT)  # hundredths of a penny
+        steps = -(-raised // (100 * ROUND_TO))  # ceiling division
+        prices[product.code] = steps * ROUND_TO
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
