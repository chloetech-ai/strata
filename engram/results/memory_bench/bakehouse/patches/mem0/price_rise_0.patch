+++ b/tests/test_pricing.py
@@ -0,0 +1,38 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_raises_by_five_percent_and_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320 * 1.05 = 336 -> next 5p is 340
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_is_not_bumped(self):
+        catalog = Catalog([Product("BUN", "Bun", 200)])
+        # 200 * 1.05 = 210 exactly
+        self.assertEqual(new_prices(catalog), {"BUN": 210})
+
+    def test_rounds_up_not_to_nearest(self):
+        catalog = Catalog([Product("CRO", "Croissant", 250)])
+        # 250 * 1.05 = 262.5 -> up to 265, not down to 260
+        self.assertEqual(new_prices(catalog), {"CRO": 265})
+
+    def test_one_penny_over_a_step_goes_to_the_next_step(self):
+        catalog = Catalog([Product("X", "X", 381)])
+        # 381 * 1.05 = 400.05 -> 405
+        self.assertEqual(new_prices(catalog), {"X": 405})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_covers_every_product_keyed_by_code(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("BUN", "Bun", 200)])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BUN": 210})
+
+
+if __name__ == "__main__":
+    unittest.main()
