+import csv
 import datetime
 from dataclasses import dataclass, field
 from typing import List
@@ -48,6 +49,16 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def export_invoices(invoices, path):
+    """Write one row per invoice (date, customer code, total in pence) to a CSV file
+    for the VAT return. The caller chooses which invoices make up the quarter."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total_pence"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.isoformat(), invoice.customer, invoice.total()])
+
+
 def format_pence(pence):
