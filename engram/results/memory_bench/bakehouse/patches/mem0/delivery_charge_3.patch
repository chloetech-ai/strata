+# Delivery charge, in pence, on a customer's order for one delivery day (before VAT)
+# when that order is worth less than DELIVERY_CHARGE_UNDER_PENCE. Customers in
+# DELIVERY_CHARGE_EXEMPT never pay it: their contract price already includes delivery.
+DELIVERY_CHARGE_PENCE = 450
+DELIVERY_CHARGE_UNDER_PENCE = 4000
+DELIVERY_CHARGE_EXEMPT = ("AIDAN",)
