@@ -40,6 +42,16 @@ def invoice_for(orderbook, customer, day):
     return Invoice(customer, day, lines)
 
 
+def delivery_charge(customer_code, subtotal):
+    """The delivery charge in pence for `customer_code`'s order worth `subtotal` pence
+    (before VAT) for one delivery day. An empty order has no charge."""
+    if subtotal == 0 or customer_code in config.DELIVERY_CHARGE_EXEMPT:
+        return 0
+    if subtotal < config.DELIVERY_CHARGE_UNDER_PENCE:
+        return config.DELIVERY_CHARGE_PENCE
+    return 0
+
