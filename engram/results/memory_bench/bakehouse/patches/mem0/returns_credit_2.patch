+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SWL", "Sandwich loaf", 180, batch_size=16),
+            Product("BAG", "Baguette", 95, batch_size=12),
+        ])
+
+    def test_half_price_per_returned_sandwich_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 5), 5 * 90)
+
+    def test_returns_up_to_ten_percent_of_delivered_are_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 10), 10 * 90)
+
+    def test_returns_above_ten_percent_are_not_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 14), 10 * 90)
+
+    def test_cap_rounds_down(self):
+        # 10% of 16 is 1.6, so only one loaf is credited
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 16, 3), 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 100, 5), 0)
+
+    def test_negative_quantities_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+    def test_cannot_return_more_than_delivered(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, 11)
+
+
