     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for the unsold `returned` pieces of `product_code` from one
+    delivery of `delivered` pieces to `customer_code`.
+
+    Only Greenway's sandwich loaves earn credit: half the wholesale price per returned
+    loaf, for at most 10% of the loaves delivered (rounded down). Returns above that
+    cap are not credited. Any other customer or product gets no credit.
+    Raises ValueError if the quantities are negative or more is returned than delivered.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError("delivered and returned must not be negative")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} of {delivered} delivered")
+    if customer_code != "GREENWAY" or product_code != "SWL":
+        return 0
+    creditable = min(returned, delivered // 10)
+    return creditable * (catalog.get(product_code).price // 2)
+
+
