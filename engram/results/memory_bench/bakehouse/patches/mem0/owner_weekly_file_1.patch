+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_one_row_per_customer_summed_over_the_week(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),                                  # 475p
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 10),    # 3200p, last day of the week
+            OrderLine(DAY + datetime.timedelta(days=2), "GREENWAY", "BAG", 20), # 1900p
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_pounds"],
+            ["GREENWAY", "19.00"],
+            ["LUMEN", "36.75"],
+        ])
+
+    def test_days_outside_the_week_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 10),
+            OrderLine(DAY + datetime.timedelta(days=3), "GREENWAY", "BAG", 4),  # 380p
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_pounds"], ["GREENWAY", "3.80"]])
+
+    def test_pence_are_padded_to_two_digits(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])  # 95p
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_pounds"], ["LUMEN", "0.95"]])
+
+    def test_no_orders_gives_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_pounds"]])
+
+
 if __name__ == "__main__":
     unittest.main()
