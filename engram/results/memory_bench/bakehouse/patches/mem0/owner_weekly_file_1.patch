+def week_totals_file(orderbook, week_start, path):
+    """Write a CSV with one row per customer: their order total in pounds for the seven
+    days starting at `week_start`, sorted by customer code. Customers with no orders in
+    that week get no row. Opens in Excel with the columns in place."""
+    totals = {}
+    for offset in range(7):
+        day = week_start + datetime.timedelta(days=offset)
+        for customer, pence in day_summary(orderbook, day).items():
+            totals[customer] = totals.get(customer, 0) + pence
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_pounds"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds}.{pence:02d}"])
