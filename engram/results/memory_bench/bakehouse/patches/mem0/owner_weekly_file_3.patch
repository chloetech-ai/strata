+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.week = DAY
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8-sig") as f:
+            return f.read().splitlines()
+
+    def test_one_row_per_customer_with_pounds_total(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 10),
+            OrderLine(DAY + datetime.timedelta(days=2), "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self.read(), [
+            "Customer;Total (£)",
+            "GREENWAY;19,00",
+            "LUMEN;36,75",
+        ])
+
+    def test_days_outside_the_seven_are_ignored(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+        ])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)", "LUMEN;0,95"])
+
+    def test_no_orders_gives_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), self.week, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)"])
+
+
 if __name__ == "__main__":
     unittest.main()
