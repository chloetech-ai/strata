@@ -0,0 +1,44 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import load_customers
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+DAY = datetime.date(2026, 11, 3)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.customers = load_customers(os.path.join(DATA, "customers.csv"))
+        self.catalog = Catalog([Product("LOAF", "Loaf", 320)])
+
+    def read_drops(self, book):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(book, self.customers, DAY, path)
+            with open(path, encoding="utf-8") as f:
+                return f.read()
+
+    def test_lists_only_customers_with_orders_that_day_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "POTTER", "LOAF", 1),
+            OrderLine(DAY, "LUMEN", "LOAF", 2),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "LOAF", 3),
+        ])
+        self.assertEqual(
+            self.read_drops(book),
+            "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+            "6. Potter's Farm Shop, Lower Farm, Ashby Road, LK5 3PF\n",
+        )
+
+    def test_no_orders_writes_an_empty_file(self):
+        self.assertEqual(self.read_drops(OrderBook(self.catalog)), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
