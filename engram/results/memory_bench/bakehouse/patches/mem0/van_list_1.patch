+"""The van's run: which customers to drop at on a delivery day, in route order."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`: one line per customer with an order
+    for that day, in route order, as route number, name, address and postcode.
+
+    `customers` is the dict that load_customers returns, keyed by customer code.
+    """
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for code in codes:
+            c = customers[code]
+            f.write(f"{c.route_seq}. {c.name}, {c.address}, {c.postcode}\n")
