diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index 9d67bb0..62ed29e 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -48,6 +48,20 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 300  # pence
+DELIVERY_CHARGE_BELOW = 2500  # pence; orders from this value up pay no charge
+NO_DELIVERY_CHARGE = ("AIDAN",)  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day.
+    `subtotal` is the order's value in pence before VAT. An order under £25.00 pays £3.00;
+    St Aidan's never pays, and a day with no order has no charge."""
+    if customer_code in NO_DELIVERY_CHARGE or subtotal <= 0 or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def format_pence(pence):
     """Display an amount in pence as pounds, e.g. 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
