+"""The van's run: the drops for a delivery day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one numbered line per customer in
+    route order. Only customers with orders for `day` are listed.
+
+    `customers` is the dict from load_customers. Raises ValueError if an order is
+    for a customer code that is not in `customers`.
+    """
+    codes = orderbook.customers_for(day)
+    missing = [code for code in codes if code not in customers]
+    if missing:
+        raise ValueError(f"no customer for order code {', '.join(missing)}")
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        for n, c in enumerate(drops, start=1):
+            f.write(f"{n}. {c.name}, {c.address}, {c.postcode}\n")
