@@ -0,0 +1,57 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import load_customers
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+DAY = datetime.date(2026, 11, 3)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.customers = load_customers(os.path.join(DATA, "customers.csv"))
+        self.catalog = Catalog([Product("BAP", "Bap", 50)])
+
+    def read(self, book):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(book, self.customers, DAY, path)
+            with open(path, encoding="utf-8") as f:
+                return f.read()
+
+    def test_lists_only_customers_with_orders_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "POTTER", "BAP", 2),
+            OrderLine(DAY, "LUMEN", "BAP", 1),
+            OrderLine(DAY, "GREENWAY", "BAP", 3),
+        ])
+        self.assertEqual(self.read(book), (
+            "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+            "2. Greenway Grocers, 88 High Street, LK1 4HS\n"
+            "3. Potter's Farm Shop, Lower Farm, Ashby Road, LK5 3PF\n"
+        ))
+
+    def test_other_days_are_ignored(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAP", 1),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "BAP", 1),
+        ])
+        self.assertEqual(self.read(book), "1. Café Lumen, 14 Mill Lane, LK1 2AB\n")
+
+    def test_no_orders_writes_an_empty_file(self):
+        self.assertEqual(self.read(OrderBook(self.catalog)), "")
+
+    def test_unknown_customer_is_rejected(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAP", 1)])
+        with tempfile.TemporaryDirectory() as tmp:
+            with self.assertRaisesRegex(ValueError, "NOBODY"):
+                drops_file(book, self.customers, DAY, os.path.join(tmp, "drops.txt"))
+
+
+if __name__ == "__main__":
+    unittest.main()
