+"""Wholesale price changes."""
+
+# The January 2027 rise: 5% on every wholesale price, rounded up to the next 5p.
+RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Maps each product code to its wholesale price in pence after the January rise.
+
+    Works in whole pence so that no float rounding can push a price below the
+    rounded-up target. Prices already on a 5p step after the rise stay as they are.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + RISE_PERCENT)  # in hundredths of a penny
+        step = 100 * ROUND_TO_PENCE
+        # Ceiling division on integers: round the raised price up to the next step.
+        prices[product.code] = -(-raised // step) * ROUND_TO_PENCE
+    return prices
