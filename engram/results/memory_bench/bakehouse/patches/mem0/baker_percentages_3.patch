+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_each_ingredient_is_a_percentage_of_total_flour(self):
+        recipe = {"Bread flour": 500, "Water": 350, "Salt": 10, "Starter": 100}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Bread flour": 100.0, "Water": 70.0, "Salt": 2.0, "Starter": 20.0},
+        )
+
+    def test_flour_names_are_matched_in_any_case_and_summed(self):
+        recipe = {"WHITE FLOUR": 300, "rye flour": 200, "Water": 400}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"WHITE FLOUR": 60.0, "rye flour": 40.0, "Water": 80.0},
+        )
+
+    def test_results_are_rounded_to_one_decimal_place(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 6}
+        self.assertEqual(baker_percentages(recipe), {"Flour": 100.0, "Water": 66.7, "Salt": 2.0})
+
+    def test_recipe_without_flour_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_empty_recipe_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
+
+
+if __name__ == "__main__":
+    unittest.main()
