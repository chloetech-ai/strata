+"""The van's delivery run for a day."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path` as CSV, in route order.
+
+    Only customers with orders for `day` are included. Raises KeyError if an order
+    is for a customer code missing from `customers` (the dict from load_customers).
+    """
+    codes = orderbook.customers_for(day)
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["route_seq", "code", "name", "address", "postcode"])
+        for c in drops:
+            writer.writerow([c.route_seq, c.code, c.name, c.address, c.postcode])
