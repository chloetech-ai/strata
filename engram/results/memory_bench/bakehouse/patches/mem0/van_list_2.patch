+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.csv")
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+        }
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_lists_only_customers_with_orders_that_day_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "BAG", 3),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["route_seq", "code", "name", "address", "postcode"],
+            ["1", "LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB"],
+            ["4", "GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS"],
+        ])
+
+    def test_customer_with_several_lines_appears_once(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(len(self.read_rows()), 2)
+
+    def test_no_orders_writes_header_only(self):
+        book = OrderBook(self.catalog, [])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["route_seq", "code", "name", "address", "postcode"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
