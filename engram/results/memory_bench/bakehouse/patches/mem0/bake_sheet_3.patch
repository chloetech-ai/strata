 def total_batches(plan_result):
     """Trays in the oven for a plan: one tray holds one batch, so this is the sum of all batches."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: a heading, then one line per product.
+
+    Products are listed hottest oven first, so the deck oven only cools down once.
+    Dough is given in whole grams.
+    """
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    ordered = sorted(rows.items(), key=lambda item: -catalog.get(item[0]).bake_temp)
+    width = max(len(catalog.get(code).name) for code in rows)
+    lines = [f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}"]
+    for code, (units, batches) in ordered:
+        product = catalog.get(code)
+        dough = f"{dough_weight_g(product, units)} g"
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough:>8}")
+    return "\n".join(lines)
