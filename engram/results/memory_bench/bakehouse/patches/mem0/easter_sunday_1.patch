diff --git a/src/bakehouse/seasons.py b/src/bakehouse/seasons.py
new file mode 100644
index 0000000..7de70a4
--- /dev/null
+++ b/src/bakehouse/seasons.py
@@ -0,0 +1,27 @@
+"""Calendar dates for planning the bakehouse's seasonal lines, such as hot cross buns."""
+
+import datetime
+
+FIRST_YEAR = 1900
+LAST_YEAR = 2199
+
+
+def easter_sunday(year):
+    """Easter Sunday for `year` in the Western church, on the Gregorian calendar.
+
+    Uses the anonymous Gregorian algorithm (Meeus/Jones/Butcher). Only years from
+    1900 to 2199 are accepted.
+    """
+    if not FIRST_YEAR <= year <= LAST_YEAR:
+        raise ValueError(f"year must be from {FIRST_YEAR} to {LAST_YEAR}, got {year}")
+    a = year % 19
+    b, c = divmod(year, 100)
+    d, e = divmod(b, 4)
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i, k = divmod(c, 4)
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month, day = divmod(h + l - 7 * m + 114, 31)
+    return datetime.date(year, month, day + 1)
diff --git a/tests/test_seasons.py b/tests/test_seasons.py
new file mode 100644
index 0000000..06c2a9c
--- /dev/null
+++ b/tests/test_seasons.py
@@ -0,0 +1,32 @@
+import datetime
+import unittest
+
+from bakehouse.seasons import easter_sunday
+
+
+class EasterSundayTest(unittest.TestCase):
+    def test_known_easter_dates(self):
+        self.assertEqual(easter_sunday(1900), datetime.date(1900, 4, 15))
+        self.assertEqual(easter_sunday(1961), datetime.date(1961, 4, 2))
+        self.assertEqual(easter_sunday(2000), datetime.date(2000, 4, 23))
+        self.assertEqual(easter_sunday(2024), datetime.date(2024, 3, 31))
+        self.assertEqual(easter_sunday(2025), datetime.date(2025, 4, 20))
+        self.assertEqual(easter_sunday(2026), datetime.date(2026, 4, 5))
+        self.assertEqual(easter_sunday(2199), datetime.date(2199, 4, 14))
+
+    def test_always_a_sunday_between_march_22_and_april_25(self):
+        for year in range(1900, 2200):
+            easter = easter_sunday(year)
+            self.assertEqual(easter.weekday(), 6, year)
+            self.assertGreaterEqual(easter, datetime.date(year, 3, 22))
+            self.assertLessEqual(easter, datetime.date(year, 4, 25))
+
+    def test_rejects_years_outside_1900_to_2199(self):
+        with self.assertRaises(ValueError):
+            easter_sunday(1899)
+        with self.assertRaises(ValueError):
+            easter_sunday(2200)
+
+
+if __name__ == "__main__":
+    unittest.main()
