     }
 
 
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first (ties by code)."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    codes = sorted(rows, key=lambda code: (-catalog.get(code).bake_temp, code))
+    width = max(len(catalog.get(code).name) for code in codes)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>9}",
+    ]
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough_weight_g(product, units):>9}")
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays for the oven: one tray holds one batch, so this is the batches summed over all products."""
     return sum(batches for _units, batches in plan_result.values())
