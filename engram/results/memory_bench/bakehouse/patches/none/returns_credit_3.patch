     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold pieces of one product from one delivery, at the catalog price.
+
+    `customer_code` is accepted so each delivery's credit is labelled with its customer; prices are the same for all customers.
+    Raises ValueError if a count is negative or `returned` is more than `delivered`.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError("delivered and returned must not be negative")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} of {delivered} delivered {product_code} for {customer_code}")
+    return returned * catalog.get(product_code).price
+
+
