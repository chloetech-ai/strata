+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_one_row_per_customer_in_pounds(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "SOU", 2),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "19.00"],
+            ["LUMEN", "11.15"],
+        ])
+
+    def test_seven_days_from_week_start_inclusive(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"], ["LUMEN", "1.90"]])
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows()[1], ["LUMEN", "0.95"])
+
+    def test_no_orders_gives_header_only(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"]])
+
+
 if __name__ == "__main__":
     unittest.main()
