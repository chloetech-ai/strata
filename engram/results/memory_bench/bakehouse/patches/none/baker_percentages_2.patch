+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 500, "Rye flour": 100, "Water": 375, "Salt": 10}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["Strong white flour"], 83.3)
+        self.assertEqual(result["Rye flour"], 16.7)
+        self.assertEqual(result["Water"], 62.5)
+        self.assertEqual(result["Salt"], 1.7)
+
+    def test_flour_match_is_case_insensitive(self):
+        result = baker_percentages({"FLOUR": 200, "flour blend": 200, "Water": 150})
+        self.assertEqual(result["Water"], 37.5)
+
+    def test_flour_itself_is_100_percent_when_only_flour(self):
+        self.assertEqual(baker_percentages({"Bread Flour": 1000}), {"Bread Flour": 100.0})
+
+    def test_raises_when_no_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
