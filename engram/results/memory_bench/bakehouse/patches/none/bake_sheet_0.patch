@@ -35,3 +35,20 @@ def plan(orderbook, day):
 def total_batches(plan_result):
     """Trays for the oven: one tray holds one batch, so this is the batches summed over all products."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product, hottest oven first.
+
+    Each line gives the product name, units, batches and the grams of dough to weigh out.
+    """
+    rows = plan(orderbook, day)
+    catalog = orderbook.catalog
+    products = sorted((catalog.get(code) for code in rows), key=lambda p: -p.bake_temp)
+    width = max((len(p.name) for p in products), default=0)
+    lines = []
+    for product in products:
+        units, batches = rows[product.code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<{width}}  {units:>5} units  {batches:>3} batches  {grams:>7} g dough")
+    return "\n".join(lines)
