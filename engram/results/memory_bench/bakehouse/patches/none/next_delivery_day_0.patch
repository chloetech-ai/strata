             day = DAY + datetime.timedelta(days=offset)
             self.assertEqual(is_delivery_day(day), day.weekday() not in config.CLOSED_WEEKDAYS)
 
+    def test_next_delivery_day_skips_closed_days(self):
+        sunday = datetime.date(2026, 10, 18)
+        self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))  # Monday is closed
+        self.assertEqual(next_delivery_day(datetime.date(2026, 10, 13)), datetime.date(2026, 10, 14))
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            nxt = next_delivery_day(day)
+            self.assertGreater(nxt, day)
+            self.assertTrue(is_delivery_day(nxt))
+            self.assertFalse(any(is_delivery_day(day + datetime.timedelta(days=k)) for k in range(1, (nxt - day).days)))
+
 
 if __name__ == "__main__":
     unittest.main()
