index 920dd05..28c8e0d 100644
--- a/src/bakehouse/orders.py
+++ b/src/bakehouse/orders.py
@@ -70,6 +70,14 @@ def is_delivery_day(day):
     return day.weekday() not in config.CLOSED_WEEKDAYS
 
 
+def next_delivery_day(day):
+    """The first date after `day` on which we deliver."""
+    candidate = day + datetime.timedelta(days=1)
+    while not is_delivery_day(candidate):
+        candidate += datetime.timedelta(days=1)
+    return candidate
+
+
 def is_on_time(placed_at, delivery_day):
     """Whether an order placed at `placed_at` (a datetime) is in time for
     `delivery_day`: orders must be in by config.ORDER_CUTOFF on the day before."""
