--- /dev/null
+++ b/tests/test_delivery.py
@@ -0,0 +1,66 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "1 High St", "AB1 2CD", 3),
+            "GREENWAY": Customer("GREENWAY", "Greenway Deli", "9 Mill Rd", "AB3 4EF", 1),
+            "POTTER": Customer("POTTER", "Potter's Farm Shop", "Farm Lane", "AB5 6GH", 6),
+        }
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "drops.txt")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_one_line_per_customer_with_orders_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "POTTER", "BAG", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY, "GREENWAY", "BAG", 3),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), (
+            "1. Greenway Deli, 9 Mill Rd, AB3 4EF\n"
+            "3. Lumen Cafe, 1 High St, AB1 2CD\n"
+            "6. Potter's Farm Shop, Farm Lane, AB5 6GH\n"
+        ))
+
+    def test_customers_without_orders_that_day_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=1), "POTTER", "BAG", 2),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "3. Lumen Cafe, 1 High St, AB1 2CD\n")
+
+    def test_no_orders_writes_an_empty_file(self):
+        book = OrderBook(self.catalog, [])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "")
+
+    def test_order_for_unknown_customer_is_an_error(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 1)])
+        with self.assertRaises(ValueError):
+            drops_file(book, self.customers, DAY, self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
