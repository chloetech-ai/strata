+"""Delivery run sheets: the van's drops for a day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`: one line per customer with orders that day,
+    in route order. `customers` is the dict from customers.load_customers.
+    Raises ValueError if an order is for a customer code not in `customers`."""
+    codes = orderbook.customers_for(day)
+    unknown = [code for code in codes if code not in customers]
+    if unknown:
+        raise ValueError(f"no customer record for {', '.join(unknown)}")
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for drop in drops:
+            f.write(f"{drop.route_seq}. {drop.name}, {drop.address}, {drop.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
