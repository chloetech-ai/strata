 """Reports on the order book."""
 
+import csv
+import datetime
+
 
 def day_summary(orderbook, day):
     """{customer code: order value in pence} for everything delivered on `day`."""
@@ -18,3 +21,20 @@ def top_products(orderbook, start, end, n=5):
         if start <= line.day <= end:
             units[line.product] = units.get(line.product, 0) + line.qty
     return sorted(units, key=lambda code: (-units[code], code))[:n]
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Write a CSV with one row per customer who ordered in the seven days from `week_start`:
+    the customer code and their total in pounds, e.g. 'LUMEN,12.34'. Sorted by customer code."""
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds}.{pence:02d}"])
