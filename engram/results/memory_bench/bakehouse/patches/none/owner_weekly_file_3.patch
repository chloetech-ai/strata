+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+            Product("CRO", "Croissant", 5, batch_size=24),
+        ])
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_one_row_per_customer_in_pounds_for_seven_days(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 2),
+            OrderLine(DAY + datetime.timedelta(days=3), "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "19.00"],
+            ["LUMEN", "11.15"],
+        ])
+
+    def test_days_outside_the_week_are_ignored(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"], ["LUMEN", "0.95"]])
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "CRO", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"], ["LUMEN", "0.05"]])
+
+    def test_empty_week_writes_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"]])
+
+
 if __name__ == "__main__":
     unittest.main()
