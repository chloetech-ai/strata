+    def test_returns_credit_at_catalog_price(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("BAG", "Baguette", 95)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SOU", 32, 3), 3 * 320)
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "BAG", 25, 25), 25 * 95)
+
+    def test_returns_credit_zero_returned_is_zero(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SOU", 32, 0), 0)
+
+    def test_returns_credit_rejects_bad_counts(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        with self.assertRaises(ValueError):
