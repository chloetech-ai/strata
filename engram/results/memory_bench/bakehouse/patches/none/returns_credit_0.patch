+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold units of `product_code` from one delivery to `customer_code`.
+
+    Units are credited at the catalog price, the same as on the invoice. Raises ValueError
+    if `returned` is negative or more than `delivered`.
+    """
+    if not 0 <= returned <= delivered:
+        raise ValueError(f"returned must be between 0 and delivered ({delivered}) for {product_code}")
+    return returned * catalog.get(product_code).price
