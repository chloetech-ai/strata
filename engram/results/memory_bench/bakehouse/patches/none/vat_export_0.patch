+def export_invoices(invoices, path):
+    """Write one CSV row per invoice for the VAT return: date (YYYY-MM-DD), customer code, total in pounds (e.g. 12.34)."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            total = Decimal(invoice.total()) / 100
+            writer.writerow([invoice.day.isoformat(), invoice.customer, f"{total:.2f}"])
