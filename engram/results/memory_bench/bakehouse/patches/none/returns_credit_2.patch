@@ -40,6 +40,17 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold units out of `delivered`, at the catalog price.
+
+    `customer_code` is the customer the delivery went to; prices are the same for every customer, so it does not change the amount."""
+    if not 0 <= returned <= delivered:
+        raise ValueError(
+            f"{customer_code}: returned {returned} of {product_code} must be between 0 and the {delivered} delivered"
+        )
+    return returned * catalog.get(product_code).price
+
+
