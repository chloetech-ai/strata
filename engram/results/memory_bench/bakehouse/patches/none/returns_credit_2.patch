+    def test_returns_credit_is_returned_units_at_catalog_price(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SOU", 32, 5), 5 * 320)
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SOU", 32, 0), 0)
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SOU", 32, 32), 32 * 320)
+
+    def test_returns_credit_rejects_more_returned_than_delivered(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        with self.assertRaises(ValueError):
+            returns_credit(catalog, "GREENWAY", "SOU", 32, 33)
+        with self.assertRaises(ValueError):
+            returns_credit(catalog, "GREENWAY", "SOU", 32, -1)
