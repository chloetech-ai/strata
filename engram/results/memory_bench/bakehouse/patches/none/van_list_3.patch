@@ -0,0 +1,38 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+
+class DropsFileTest(unittest.TestCase):
+    def test_lists_only_that_days_customers_in_run_order(self):
+        day = datetime.date(2026, 10, 20)
+        catalog = Catalog([Product("CRO", "Croissant", 110)])
+        customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 3),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 1),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 2),
+        }
+        book = OrderBook(catalog, [
+            OrderLine(day, "LUMEN", "CRO", 10),
+            OrderLine(day, "HARBOUR", "CRO", 4),
+            OrderLine(day.replace(day=21), "GREENWAY", "CRO", 9),
+        ])
+        fd, path = tempfile.mkstemp(suffix=".txt")
+        os.close(fd)
+        self.addCleanup(os.remove, path)
+        drops_file(book, customers, day, path)
+        with open(path, encoding="utf-8") as f:
+            self.assertEqual(f.read(), (
+                "1. Harbour Deli, 3 Quay Street, LK2 7QS\n"
+                "3. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+            ))
+
+
+if __name__ == "__main__":
+    unittest.main()
