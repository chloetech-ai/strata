+"""The van's delivery run."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Write the van's drops for `day` to `path`, one line per customer with orders that day,
+    in run order (route_seq). `customers` is the dict from customers.load_customers."""
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for code in codes:
+            c = customers[code]
+            f.write(f"{c.route_seq}. {c.name}, {c.address}, {c.postcode}\n")
