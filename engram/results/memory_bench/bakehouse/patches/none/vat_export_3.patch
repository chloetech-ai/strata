+def export_invoices(invoices, path):
+    """Write one CSV row per invoice for the VAT return: date, customer code, total in pence.
+    Rows are written in the order given; the caller picks the quarter's invoices."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total_pence"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.isoformat(), invoice.customer, invoice.total()])
