+"""Crate labels for packing a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """One label of text per customer and product ordered for delivery on `day`.
+
+    Labels follow the van's run (route_seq), then product code. A customer's lines for the
+    same product are added together into one label.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code, qty in sorted(totals.items()):
+            product = orderbook.catalog.get(product_code)
+            labels.append(f"{customer.name}\n{product.name} x {qty}\n{day.isoformat()}")
+    return labels
