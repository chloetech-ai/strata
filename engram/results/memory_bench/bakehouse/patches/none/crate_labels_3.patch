+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "SOU", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "BAG", 6),
+        ])
+        labels = crate_labels(book, self.customers, DAY)
+        self.assertEqual(labels, [
+            "Café Lumen\nBaguette x 6\n2026-10-20",
+            "Greenway Grocers\nBaguette x 20\n2026-10-20",
+            "Greenway Grocers\nWhite sourdough x 5\n2026-10-20",
+        ])
+
+    def test_lines_for_the_same_product_are_added_together(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 6),
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Café Lumen\nBaguette x 10\n2026-10-20",
+        ])
+
+    def test_only_orders_for_the_given_day(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 2),
+        ])
+        self.assertEqual(len(crate_labels(book, self.customers, DAY)), 1)
+
+    def test_no_orders_gives_no_labels(self):
+        book = OrderBook(self.catalog)
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
