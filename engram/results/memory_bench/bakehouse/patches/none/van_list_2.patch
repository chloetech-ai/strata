+"""The van's run: the drops for a delivery day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Write the van's drops for `day` to `path`, one line per customer with orders that day,
+    in route order: route number, name, address and postcode.
+
+    `customers` is the dict from load_customers. Raises KeyError for an ordering customer not in it.
+    """
+    drops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for customer in drops:
+            f.write(f"{customer.route_seq}. {customer.name}, {customer.address}, {customer.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
