--- /dev/null
+++ b/tests/test_delivery.py
@@ -0,0 +1,49 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.txt")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_lists_only_that_days_customers_in_route_order(self):
+        day = datetime.date(2026, 10, 20)
+        catalog = Catalog([Product("CRO", "Croissant", 110)])
+        customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        }
+        book = OrderBook(catalog, [
+            OrderLine(day, "GREENWAY", "CRO", 5),
+            OrderLine(day, "LUMEN", "CRO", 3),
+            OrderLine(day.replace(day=21), "HARBOUR", "CRO", 2),
+        ])
+        drops_file(book, customers, day, self.path)
+        with open(self.path, encoding="utf-8") as f:
+            self.assertEqual(f.read(), (
+                "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+                "4. Greenway Grocers, 88 High Street, LK1 4HS\n"
+            ))
+
+    def test_no_orders_writes_an_empty_file(self):
+        day = datetime.date(2026, 10, 20)
+        book = OrderBook(Catalog([Product("CRO", "Croissant", 110)]))
+        drops_file(book, {}, day, self.path)
+        with open(self.path, encoding="utf-8") as f:
+            self.assertEqual(f.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
