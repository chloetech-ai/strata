+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_flour_is_one_hundred_percent_and_others_are_shares_of_it(self):
+        recipe = {"Bread flour": 500, "Water": 350, "Salt": 10, "Starter": 100}
+        self.assertEqual(baker_percentages(recipe), {
+            "Bread flour": 100.0,
+            "Water": 70.0,
+            "Salt": 2.0,
+            "Starter": 20.0,
+        })
+
+    def test_every_flour_counts_toward_the_total_in_any_case(self):
+        recipe = {"Strong WHITE Flour": 300, "whole wheat FLOUR": 200, "Water": 350}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["Strong WHITE Flour"], 60.0)
+        self.assertEqual(result["whole wheat FLOUR"], 40.0)
+        self.assertEqual(result["Water"], 70.0)
+
+    def test_rounds_to_one_decimal_place(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 6}
+        self.assertEqual(baker_percentages(recipe)["Salt"], 2.0)
+        self.assertEqual(baker_percentages({"Flour": 3, "Water": 1})["Water"], 33.3)
+
+    def test_recipe_without_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
