+"""Recipes: baker's percentages, where every ingredient is a share of the total flour weight."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: percent of total flour weight}, rounded to one decimal place.
+
+    Any ingredient whose name contains "flour" (any case) counts as flour.
+    Raises ValueError if the recipe has no flour, or if its flour weighs nothing.
+    """
+    flour_g = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if not any("flour" in name.lower() for name in recipe):
+        raise ValueError("recipe has no flour, so baker's percentages are undefined")
+    if flour_g <= 0:
+        raise ValueError(f"total flour weight must be positive, got {flour_g}")
+    return {name: round(grams * 100 / flour_g, 1) for name, grams in recipe.items()}
