+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product with its name, units, batches and the
+    dough to weigh out. Dough is weighed for whole batches, since that is what goes in the oven."""
+    catalog = orderbook.catalog
+    rows = []
+    for code, (units, batches) in plan(orderbook, day).items():
+        product = catalog.get(code)
+        dough = dough_weight_g(product, batches * product.batch_size)
+        rows.append((product.name, units, batches, dough))
+    if not rows:
+        return ""
+    width = max(len(name) for name, *_ in rows)
+    return "\n".join(
+        f"{name:<{width}}  {units:>5} units  {batches:>4} batches  {dough:>8} g dough"
+        for name, units, batches, dough in rows
+    )
+
+
 def total_batches(plan_result):
     """Trays for the oven: one tray holds one batch, so this is the batches summed over all products."""
     return sum(batches for _units, batches in plan_result.values())
