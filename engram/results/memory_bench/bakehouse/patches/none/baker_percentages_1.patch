@@ -0,0 +1,30 @@
+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_rounded_to_one_decimal(self):
+        recipe = {"strong white flour": 500, "wholemeal flour": 100, "water": 375, "salt": 10}
+        self.assertEqual(baker_percentages(recipe), {
+            "strong white flour": 83.3,
+            "wholemeal flour": 16.7,
+            "water": 62.5,
+            "salt": 1.7,
+        })
+
+    def test_flour_match_is_case_insensitive(self):
+        recipe = {"Rye FLOUR": 200, "water": 100}
+        self.assertEqual(baker_percentages(recipe), {"Rye FLOUR": 100.0, "water": 50.0})
+
+    def test_raises_when_there_is_no_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"water": 300, "salt": 10})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"flour": 0, "water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
