+"""Recipes: ingredient weights as baker's percentages of the flour."""
+
+
+def baker_percentages(recipe):
+    """Each ingredient's weight as a percentage of the total flour weight, rounded to one decimal.
+
+    Any ingredient whose name contains 'flour' (any case) counts as flour.
+    Raises ValueError if there is no flour, or if the flour weighs nothing.
+    """
+    flour = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour <= 0:
+        raise ValueError("recipe has no flour to base percentages on")
+    return {name: round(grams / flour * 100, 1) for name, grams in recipe.items()}
