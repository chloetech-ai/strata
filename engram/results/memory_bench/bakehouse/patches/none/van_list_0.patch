+"""Delivery runs: the van's drops for a day, in route order."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one numbered line per customer in route order.
+
+    Only customers with orders for `day` are listed. `customers` is the dict from load_customers.
+    Raises ValueError if an order is for a customer code not in `customers`.
+    """
+    codes = orderbook.customers_for(day)
+    unknown = [code for code in codes if code not in customers]
+    if unknown:
+        raise ValueError(f"no customer record for {', '.join(unknown)}")
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for number, customer in enumerate(drops, start=1):
+            f.write(f"{number}. {customer.name}, {customer.address}, {customer.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
