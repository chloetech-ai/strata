@@ -0,0 +1,56 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.day = datetime.date(2026, 10, 20)
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+        }
+        self.catalog = Catalog([Product("CRO", "Croissant", 110)])
+
+    def write_drops(self, book, day=None):
+        fd, path = tempfile.mkstemp(suffix=".txt")
+        os.close(fd)
+        self.addCleanup(os.remove, path)
+        drops_file(book, self.customers, day or self.day, path)
+        with open(path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_lists_customers_with_orders_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day, "GREENWAY", "CRO", 10),
+            OrderLine(self.day, "LUMEN", "CRO", 6),
+        ])
+        self.assertEqual(self.write_drops(book),
+                         "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+                         "2. Greenway Grocers, 88 High Street, LK1 4HS\n")
+
+    def test_leaves_out_customers_with_no_orders_that_day(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day, "HARBOUR", "CRO", 12),
+            OrderLine(self.day.replace(day=21), "LUMEN", "CRO", 6),
+        ])
+        self.assertEqual(self.write_drops(book), "1. Harbour Deli, 3 Quay Street, LK2 7QS\n")
+
+    def test_no_orders_writes_empty_file(self):
+        self.assertEqual(self.write_drops(OrderBook(self.catalog)), "")
+
+    def test_unknown_customer_code_raises(self):
+        book = OrderBook(self.catalog, [OrderLine(self.day, "NOBODY", "CRO", 1)])
+        with self.assertRaises(ValueError):
+            self.write_drops(book)
+
+
+if __name__ == "__main__":
+    unittest.main()
