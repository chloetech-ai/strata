+"""Crate labels for packing a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """One label's text per customer and product ordered for delivery on `day`.
+
+    Customers come in sorted code order, then products in sorted code order.
+    Quantities for the same customer and product are added together.
+    `customers` is the dict that load_customers returns.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        customer = customers[code]
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code in sorted(totals):
+            product = orderbook.catalog.get(product_code)
+            labels.append(
+                f"{customer.name}\n"
+                f"{customer.address}, {customer.postcode}\n"
+                f"{product.name} x {totals[product_code]}"
+            )
+    return labels
