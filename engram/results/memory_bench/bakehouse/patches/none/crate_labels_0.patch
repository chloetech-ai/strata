@@ -0,0 +1,37 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_for_the_day(self):
+        day = datetime.date(2026, 10, 20)
+        catalog = Catalog([Product("CRO", "Croissant", 110), Product("SOU", "White sourdough", 320)])
+        customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        }
+        book = OrderBook(catalog, [
+            OrderLine(day, "LUMEN", "SOU", 6),
+            OrderLine(day, "LUMEN", "CRO", 10),
+            OrderLine(day, "LUMEN", "CRO", 14),
+            OrderLine(day, "HARBOUR", "CRO", 12),
+            OrderLine(day.replace(day=21), "HARBOUR", "SOU", 99),
+        ])
+        self.assertEqual(crate_labels(book, customers, day), [
+            "Harbour Deli\n3 Quay Street, LK2 7QS\nCroissant x 12",
+            "Café Lumen\n14 Mill Lane, LK1 2AB\nCroissant x 24",
+            "Café Lumen\n14 Mill Lane, LK1 2AB\nWhite sourdough x 6",
+        ])
+
+    def test_no_orders_gives_no_labels(self):
+        catalog = Catalog([Product("CRO", "Croissant", 110)])
+        self.assertEqual(crate_labels(OrderBook(catalog), {}, datetime.date(2026, 10, 20)), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
