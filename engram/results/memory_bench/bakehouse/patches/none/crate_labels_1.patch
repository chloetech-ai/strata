--- /dev/null
+++ b/src/bakehouse/labels.py
@@ -0,0 +1,17 @@
+"""Crate labels for packing a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in van run order
+    (by route_seq), then product code. Each label is the customer's name, the product
+    name and the units ordered, on separate lines."""
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code in sorted(totals):
+            product = orderbook.catalog.get(product_code)
+            labels.append(f"{customer.name}\n{product.name}\n{totals[product_code]} units")
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
new file mode 100644
index 0000000..00b41e4
--- /dev/null
+++ b/tests/test_labels.py
@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "1 High St", "AB1 2CD", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 Mill Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_run_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Grocers\nBaguette\n20 units",
+            "Lumen Cafe\nBaguette\n5 units",
+            "Lumen Cafe\nWhite sourdough\n2 units",
+        ])
+
+    def test_repeated_lines_for_same_customer_and_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Lumen Cafe\nBaguette\n8 units"])
+
+    def test_only_orders_for_the_given_day(self):
+        other = datetime.date(2026, 10, 21)
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(other, "GREENWAY", "BAG", 20),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Lumen Cafe\nBaguette\n5 units"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog), self.customers, DAY), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
