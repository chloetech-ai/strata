+"""Crate labels for packing: one per customer and product for a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """Text of each crate label for `day`, one per customer and product ordered.
+
+    Labels run in van-route order (customers by route_seq, then product code).
+    Each label is the customer's name, then the product name and total quantity,
+    e.g. 'Lumen Bakery\\nCroissant x 24'. `customers` is the dict from load_customers.
+    Raises KeyError for a customer in the order book who is not in `customers`.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    ordered = sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1]))
+    labels = []
+    for customer_code, product_code in ordered:
+        name = customers[customer_code].name
+        product = orderbook.catalog.get(product_code).name
+        labels.append(f"{name}\n{product} x {totals[(customer_code, product_code)]}")
+    return labels
