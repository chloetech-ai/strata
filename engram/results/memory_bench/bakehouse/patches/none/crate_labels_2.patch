@@ -0,0 +1,51 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.day = datetime.date(2026, 10, 20)
+        self.catalog = Catalog([Product("CRO", "Croissant", 110), Product("SOU", "White sourdough", 320)])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Bakery", "1 High St", "AB1 2CD", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 Mill Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day, "LUMEN", "SOU", 6),
+            OrderLine(self.day, "LUMEN", "CRO", 10),
+            OrderLine(self.day, "GREENWAY", "CRO", 4),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, self.day), [
+            "Greenway Grocers\nCroissant x 4",
+            "Lumen Bakery\nCroissant x 10",
+            "Lumen Bakery\nWhite sourdough x 6",
+        ])
+
+    def test_repeated_lines_for_same_customer_and_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day, "LUMEN", "CRO", 10),
+            OrderLine(self.day, "LUMEN", "CRO", 14),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, self.day), ["Lumen Bakery\nCroissant x 24"])
+
+    def test_other_days_are_ignored(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day.replace(day=21), "LUMEN", "CRO", 99),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, self.day), [])
+
+    def test_unknown_customer_raises_key_error(self):
+        book = OrderBook(self.catalog, [OrderLine(self.day, "NOBODY", "CRO", 1)])
+        with self.assertRaises(KeyError):
+            crate_labels(book, self.customers, self.day)
+
+
+if __name__ == "__main__":
+    unittest.main()
