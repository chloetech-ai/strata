@@ -18,3 +21,28 @@ def top_products(orderbook, start, end, n=5):
         if start <= line.day <= end:
             units[line.product] = units.get(line.product, 0) + line.qty
     return sorted(units, key=lambda code: (-units[code], code))[:n]
+
+
+def week_totals(orderbook, week_start):
+    """{customer code: order value in pence} for everything delivered in the seven days
+    starting at `week_start`."""
+    end = week_start + datetime.timedelta(days=7)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day < end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    return dict(sorted(totals.items()))
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer to a CSV at `path`: the customer code and their total
+    for the seven days from `week_start`, in pounds (e.g. 12.34, no £ sign, so
+    spreadsheets read it as a number). Written as UTF-8 with a byte-order mark so Excel
+    opens it cleanly."""
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_gbp"])
+        for customer, pence in week_totals(orderbook, week_start).items():
+            pounds, rest = divmod(pence, 100)
+            writer.writerow([customer, f"{pounds}.{rest:02d}"])
