+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Bread flour": 500, "Rye flour": 100, "Water": 350, "Salt": 10, "Starter": 100}
+        self.assertEqual(baker_percentages(recipe), {
+            "Bread flour": 83.3,
+            "Rye flour": 16.7,
+            "Water": 58.3,
+            "Salt": 1.7,
+            "Starter": 16.7,
+        })
+
+    def test_flour_match_is_case_insensitive(self):
+        self.assertEqual(baker_percentages({"FLOUR": 200, "water": 100}), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_rounds_to_one_decimal(self):
+        self.assertEqual(baker_percentages({"Flour": 3, "Water": 2}), {"Flour": 100.0, "Water": 66.7})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_empty_recipe_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
+
+
+if __name__ == "__main__":
+    unittest.main()
