+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 1000, "Water": 700, "Salt": 20, "Yeast": 5}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 100.0, "Water": 70.0, "Salt": 2.0, "Yeast": 0.5},
+        )
+
+    def test_every_flour_counts_toward_the_total_whatever_the_case(self):
+        recipe = {"Strong white FLOUR": 600, "wholemeal Flour": 400, "Water": 700}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["Strong white FLOUR"], 60.0)
+        self.assertEqual(result["wholemeal Flour"], 40.0)
+        self.assertEqual(result["Water"], 70.0)
+
+    def test_rounds_to_one_decimal_place(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 7}
+        self.assertEqual(baker_percentages(recipe)["Salt"], 2.3)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 700, "Salt": 20})
+
+    def test_flour_weighing_nothing_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 700})
+
+
+if __name__ == "__main__":
+    unittest.main()
