+"""Crate labels for the products packed for a delivery day.
+
+The packing room's thermal printer prints plain ASCII only, 32 characters
+per line, and cuts off anything longer, so every line is fitted to that.
+"""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 32
+
+# Typographic quotes, mapped to plain ones before the ASCII fold would drop them.
+QUOTES = str.maketrans({"‘": "'", "’": "'", "“": '"', "”": '"'})
+
+
+def to_ascii(text):
+    """Plain-ASCII form of `text`: accents are stripped (Café -> Cafe) and other characters dropped."""
+    text = text.translate(QUOTES)
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def fit(text):
+    """One printer line: plain ASCII, cut to the line width."""
+    return to_ascii(text)[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, as a list of strings
+    with each label's lines joined by newlines.
+
+    Line 1 is the customer's name and line 2 the quantity and product name.
+    The allergens follow, wrapped onto more lines rather than cut off, so none
+    is lost. Customers come in code order, and products in code order within
+    each customer. `customers` is the dict from load_customers.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        if code not in customers:
+            raise ValueError(f"customer {code} has orders for {day} but is not in customers.csv")
+        quantities = {}
+        for line in orderbook.lines_for(code, day):
+            quantities[line.product] = quantities.get(line.product, 0) + line.qty
+        for product_code in sorted(quantities):
+            product = orderbook.catalog.get(product_code)
+            lines = [fit(customers[code].name), fit(f"{quantities[product_code]} {product.name}")]
+            lines += textwrap.wrap(to_ascii(product.allergen_text()), LINE_WIDTH)
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
new file mode 100644
index 0000000..6a972d7
--- /dev/null
+++ b/tests/test_labels.py
@@ -0,0 +1,78 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels, to_ascii
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def catalog():
+    return Catalog([
+        Product("BKW", "Bakewell slice", 150, allergens=("wheat", "milk", "eggs", "nuts")),
+        Product("SOU", "White sourdough", 320),
+    ])
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 2),
+    }
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def book(self, *lines):
+        return OrderBook(catalog(), [OrderLine(*line) for line in lines])
+
+    def test_one_label_per_customer_and_product_in_code_order(self):
+        book = self.book(
+            (DAY, "GREENWAY", "SOU", 4),
+            (DAY, "LUMEN", "SOU", 2),
+            (DAY, "LUMEN", "BKW", 6),
+        )
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Greenway Grocers\n4 White sourdough",
+            "Cafe Lumen\n6 Bakewell slice\nEGGS, MILK, NUTS, WHEAT",
+            "Cafe Lumen\n2 White sourdough",
+        ])
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = self.book((DAY, "LUMEN", "SOU", 2), (DAY, "LUMEN", "SOU", 3))
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n5 White sourdough"])
+
+    def test_only_the_given_day_is_labelled(self):
+        book = self.book((DAY, "LUMEN", "SOU", 2), (DAY.replace(day=21), "LUMEN", "SOU", 9))
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n2 White sourdough"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(self.book(), customers(), DAY), [])
+
+    def test_unknown_customer_is_an_error(self):
+        book = self.book((DAY, "NOBODY", "SOU", 1))
+        with self.assertRaisesRegex(ValueError, "NOBODY"):
+            crate_labels(book, customers(), DAY)
+
+    def test_every_line_fits_the_printer_and_is_ascii(self):
+        long_catalog = Catalog([Product("XXL", "Extra-large seeded multigrain country loaf", 300)])
+        book = OrderBook(long_catalog, [OrderLine(DAY, "GREENWAY", "XXL", 120)])
+        label = crate_labels(book, customers(), DAY)[0]
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+            line.encode("ascii")
+        self.assertEqual(label.split("\n")[1], "120 Extra-large seeded multigrai")
+
+    def test_allergens_are_wrapped_not_cut_off(self):
+        many = Product("ALL", "Everything bun", 100, allergens=("celery", "crustaceans", "eggs", "fish", "milk", "mustard", "nuts"))
+        book = OrderBook(Catalog([many]), [OrderLine(DAY, "LUMEN", "ALL", 1)])
+        lines = crate_labels(book, customers(), DAY)[0].split("\n")
+        self.assertEqual(lines[2:], ["CELERY, CRUSTACEANS, EGGS, FISH,", "MILK, MUSTARD, NUTS"])
+
+    def test_to_ascii_strips_accents_and_drops_other_characters(self):
+        self.assertEqual(to_ascii("Müller’s Bäckerei £"), "Muller's Backerei ")
+
+
+if __name__ == "__main__":
+    unittest.main()
