+class ExportInvoicesTest(unittest.TestCase):
+    def export(self, invoices):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 30, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("CRO", 99, 110)]),
+        ]
+        self.assertEqual(self.export(invoices), "Date,Customer,Total\r\n"
+                                                "20/10/2026,LUMEN,52.20\r\n"
+                                                "21/10/2026,GREENWAY,108.90\r\n")
+
+    def test_amounts_are_pounds_with_two_decimals(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 1, 1250)])]
+        self.assertIn("20/10/2026,LUMEN,12.50", self.export(invoices))
+
+    def test_pence_under_a_pound_keep_leading_zero(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 1, 5)])]
+        self.assertIn("20/10/2026,LUMEN,0.05", self.export(invoices))
+
+    def test_empty_invoice_totals_zero(self):
+        self.assertIn("20/10/2026,LUMEN,0.00", self.export([Invoice("LUMEN", datetime.date(2026, 10, 20))]))
+
+    def test_no_invoices_writes_only_header(self):
+        self.assertEqual(self.export([]), "Date,Customer,Total\r\n")
+
