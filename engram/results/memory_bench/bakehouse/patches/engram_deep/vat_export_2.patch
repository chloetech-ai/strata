 """Invoices. All amounts are integer pence."""
 
+import csv
 import datetime
 from dataclasses import dataclass, field
 from typing import List
@@ -50,3 +51,20 @@ def invoice_for(orderbook, customer, day):
     for code in sorted(qty_by_product):
         invoice.lines.append(InvoiceLine(code, qty_by_product[code], orderbook.catalog.get(code).price))
     return invoice
+
+
+def _pounds(pence):
+    """Plain pounds with a decimal point and two decimals, no symbol: 1250 -> '12.50', -5 -> '-0.05'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write invoices to `path` as a Ledgerly CSV for the VAT return: header row, then one row per invoice
+    with its delivery date (DD/MM/YYYY), customer code and total in pounds. No VAT is added here."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds(invoice.total())])
