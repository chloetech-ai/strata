index 0000000..66e91e0
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,19 @@
+"""January wholesale price rise. All amounts are integer pence."""
+
+RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_price(price):
+    """The price after the rise: up by RISE_PERCENT, rounded up (never down) to the next 5p.
+
+    Done in integers: price * (100 + RISE_PERCENT) is in hundredths of a penny,
+    so rounding up to a multiple of 100 * ROUND_TO_PENCE and scaling back gives pence.
+    """
+    unit = 100 * ROUND_TO_PENCE
+    return -(-price * (100 + RISE_PERCENT) // unit) * ROUND_TO_PENCE
+
+
+def new_prices(catalog):
+    """Product code -> new wholesale price in pence. The catalog itself is not changed."""
+    return {product.code: new_price(product.price) for product in catalog}
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..6c7a04c
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,38 @@
+import unittest
+
+from bakehouse.pricing import new_price, new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPriceTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        self.assertEqual(new_price(320), 340)  # 336p -> 340p
+        self.assertEqual(new_price(95), 100)  # 99.75p -> 100p
+        self.assertEqual(new_price(360), 380)  # 378p -> 380p
+
+    def test_exact_multiple_of_5p_is_not_rounded_further(self):
+        self.assertEqual(new_price(100), 105)  # 105p exactly
+        self.assertEqual(new_price(200), 210)
+
+    def test_never_rounds_down(self):
+        for price in range(0, 1000):
+            self.assertGreaterEqual(new_price(price) * 100, price * 105)
+            self.assertEqual(new_price(price) % 5, 0)
+
+    def test_zero_stays_zero(self):
+        self.assertEqual(new_price(0), 0)
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_maps_each_product_code_to_new_price(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("BAG", "Baguette", 95)])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 100})
+
+    def test_does_not_change_catalog(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        new_prices(catalog)
+        self.assertEqual(catalog.get("SOU").price, 320)
+
+
+if __name__ == "__main__":
+    unittest.main()
