+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong White Flour": 500, "Water": 350, "Salt": 10, "Yeast": 5}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong White Flour": 100.0, "Water": 70.0, "Salt": 2.0, "Yeast": 1.0},
+        )
+
+    def test_every_ingredient_with_flour_in_its_name_counts_as_flour(self):
+        recipe = {"White flour": 300, "WHOLEMEAL FLOUR": 200, "Water": 250}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["White flour"], 60.0)
+        self.assertEqual(result["WHOLEMEAL FLOUR"], 40.0)
+        self.assertEqual(result["Water"], 50.0)
+
+    def test_percentages_are_rounded_to_one_decimal(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 7}
+        self.assertEqual(baker_percentages(recipe)["Salt"], 2.3)
+
+    def test_recipe_without_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 6})
+
+    def test_empty_recipe_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
+
+
+if __name__ == "__main__":
+    unittest.main()
