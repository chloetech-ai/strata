+class NextDeliveryDayTest(unittest.TestCase):
+    def test_the_day_after_a_delivery_day(self):
+        tuesday = datetime.date(2026, 10, 20)
+        self.assertEqual(next_delivery_day(tuesday), datetime.date(2026, 10, 21))
+
+    def test_skips_the_closed_monday(self):
+        sunday = datetime.date(2026, 10, 18)
+        self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))
+
+    def test_from_a_closed_day_gives_the_next_open_day(self):
+        monday = datetime.date(2026, 10, 19)
+        self.assertEqual(next_delivery_day(monday), datetime.date(2026, 10, 20))
+
+    def test_result_is_always_a_delivery_day_after_the_given_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            result = next_delivery_day(day)
+            self.assertGreater(result, day)
+            self.assertTrue(is_delivery_day(result))
+
+
 if __name__ == "__main__":
     unittest.main()
