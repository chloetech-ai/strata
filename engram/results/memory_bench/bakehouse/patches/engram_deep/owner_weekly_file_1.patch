+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return list(csv.reader(f, delimiter=";"))
+
+    def test_sums_each_customer_over_the_seven_days_in_pounds(self):
+        week_start = DAY  # Tuesday 20 October 2026
+        book = OrderBook(self.catalog, [
+            OrderLine(week_start, "LUMEN", "BAG", 5),
+            OrderLine(week_start + datetime.timedelta(days=6), "LUMEN", "SOU", 10),
+            OrderLine(week_start + datetime.timedelta(days=2), "GREENWAY", "SOU", 2),
+        ])
+        week_totals_file(book, week_start, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["Customer", "Total (£)"],
+            ["GREENWAY", "6,40"],
+            ["LUMEN", "36,75"],
+        ])
+
+    def test_days_outside_the_week_are_left_out(self):
+        week_start = DAY
+        book = OrderBook(self.catalog, [
+            OrderLine(week_start - datetime.timedelta(days=1), "LUMEN", "BAG", 5),
+            OrderLine(week_start + datetime.timedelta(days=7), "LUMEN", "BAG", 5),
+            OrderLine(week_start + datetime.timedelta(days=1), "GREENWAY", "BAG", 1),
+        ])
+        week_totals_file(book, week_start, self.path)
+        self.assertEqual(self.read_rows(), [["Customer", "Total (£)"], ["GREENWAY", "0,95"]])
+
+    def test_pence_are_kept_as_two_digits(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows()[1], ["LUMEN", "0,95"])
+
+    def test_week_with_no_orders_gives_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["Customer", "Total (£)"]])
+
+
 if __name__ == "__main__":
     unittest.main()
