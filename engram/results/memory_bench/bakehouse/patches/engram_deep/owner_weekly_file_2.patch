+def week_totals_file(orderbook, week_start, path):
+    """Writes one row per customer ordering in the seven days from `week_start`, with their
+    order value for the week. Written for Greta's German-locale Excel: semicolon separators
+    and a decimal comma, so 1250 pence is written as 12,50."""
+    totals = {}
+    for offset in range(7):
+        day = week_start + datetime.timedelta(days=offset)
+        for customer, pence in day_summary(orderbook, day).items():
+            totals[customer] = totals.get(customer, 0) + pence
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total"])
+        for customer in sorted(totals):
+            pence = totals[customer]
+            writer.writerow([customer, f"{pence // 100},{pence % 100:02d}"])
+
