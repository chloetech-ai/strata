+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return f.read()
+
+    def test_sums_each_customer_over_the_week_in_semicolon_csv_with_decimal_comma(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "SOU", 10),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "BAG", 2),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total\r\nGREENWAY;1,90\r\nLUMEN;36,75\r\n")
+
+    def test_days_outside_the_seven_from_week_start_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "SOU", 100),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 100),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total\r\nLUMEN;1,90\r\n")
+
+    def test_empty_week_writes_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total\r\n")
+
