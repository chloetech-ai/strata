+class DeliveryChargeTest(unittest.TestCase):
+    def test_order_under_40_pounds_pays_450_pence(self):
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)
+        self.assertEqual(delivery_charge("LUMEN", 1), 450)
+
+    def test_order_of_40_pounds_or_more_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+        self.assertEqual(delivery_charge("LUMEN", 12345), 0)
+
+    def test_st_aidans_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 1), 0)
+        self.assertEqual(delivery_charge("AIDAN", 3999), 0)
