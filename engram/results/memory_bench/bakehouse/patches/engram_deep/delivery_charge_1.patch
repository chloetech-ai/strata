@@ -40,6 +40,18 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence
+DELIVERY_CHARGE_UNDER = 4000  # pence: orders below this value pay the charge, before VAT
+DELIVERY_FREE_CUSTOMERS = {"AIDAN"}  # St Aidan's: the contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order of `subtotal` pence (before VAT) for one delivery day."""
+    if customer_code in DELIVERY_FREE_CUSTOMERS or not 0 < subtotal < DELIVERY_CHARGE_UNDER:
+        return 0
+    return DELIVERY_CHARGE
+
+
