+"""The van's run: which customers we drop at on a given day, and in what order."""
+
+# Greenway opens at 7:00 and needs bread on the shelves before then, so it is
+# always the first drop, whatever its route_seq says.
+FIRST_DROP = "GREENWAY"
+
+
+def drops_for(orderbook, customers, day):
+    """Customers with orders for `day`, in driving order: FIRST_DROP first, then by route_seq."""
+    codes = orderbook.customers_for(day)
+    for code in codes:
+        if code not in customers:
+            raise ValueError(f"order for unknown customer {code}")
+    return sorted((customers[c] for c in codes), key=lambda c: (c.code != FIRST_DROP, c.route_seq))
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one numbered line per drop."""
+    with open(path, "w", encoding="utf-8") as f:
+        for n, customer in enumerate(drops_for(orderbook, customers, day), start=1):
+            f.write(f"{n}. {customer.name}, {customer.address}, {customer.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
