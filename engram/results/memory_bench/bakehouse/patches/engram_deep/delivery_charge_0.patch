     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence
+DELIVERY_CHARGE_BELOW = 4000  # pence: the charge applies to a day's order under this, before VAT
+NO_DELIVERY_CHARGE = {"AIDAN"}  # customer codes whose contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order value `subtotal` (pence, before VAT) for one day."""
+    if customer_code in NO_DELIVERY_CHARGE or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
