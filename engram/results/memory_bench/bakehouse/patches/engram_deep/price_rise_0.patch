@@ -0,0 +1,19 @@
+"""Wholesale price changes."""
+
+# January rise: 5%, each new price rounded up to the next 5p (never down).
+JANUARY_RISE_PERCENT = 5
+ROUND_UP_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Map each product code to its new wholesale price in pence.
+
+    Works in integer pence: the rise is price * 105 / 100, and rounding up to
+    the next multiple of 5 is done with ceiling division, so no floats are used.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + JANUARY_RISE_PERCENT)  # in hundredths of a penny
+        step = 100 * ROUND_UP_TO_PENCE
+        prices[product.code] = -(-raised // step) * ROUND_UP_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..f9cea10
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,42 @@
+import os
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product, load_catalog
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_and_rounds_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95),  # 99.75p -> 100p
+            Product("SOU", "White sourdough", 320),  # 336p -> 340p
+            Product("BRO", "Brötchen", 40),  # 42p -> 45p
+        ])
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "SOU": 340, "BRO": 45})
+
+    def test_exact_multiple_of_5p_is_not_bumped(self):
+        catalog = Catalog([Product("X", "Exact", 100)])  # 105p exactly
+        self.assertEqual(new_prices(catalog), {"X": 105})
+
+    def test_small_rise_still_rounds_up_to_5p(self):
+        catalog = Catalog([Product("X", "Cheap", 1)])  # 1.05p -> 5p
+        self.assertEqual(new_prices(catalog), {"X": 5})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("X", "Free", 0)])
+        self.assertEqual(new_prices(catalog), {"X": 0})
+
+    def test_returns_int_pence_for_every_product(self):
+        catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        prices = new_prices(catalog)
+        self.assertEqual(set(prices), {p.code for p in catalog})
+        for code, price in prices.items():
+            self.assertIsInstance(price, int, code)
+            self.assertEqual(price % 5, 0, code)
+            self.assertGreaterEqual(price, catalog.get(code).price, code)
+
+
+if __name__ == "__main__":
+    unittest.main()
