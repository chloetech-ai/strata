diff --git a/src/bakehouse/orders.py b/src/bakehouse/orders.py
index 71021b0..8326e99 100644
--- a/src/bakehouse/orders.py
+++ b/src/bakehouse/orders.py
@@ -68,6 +68,15 @@ def is_delivery_day(day):
     return day.weekday() not in config.CLOSED_WEEKDAYS
 
 
+def next_delivery_day(day):
+    """The first delivery day after `day` (not `day` itself)."""
+    for offset in range(1, 8):
+        candidate = day + datetime.timedelta(days=offset)
+        if is_delivery_day(candidate):
+            return candidate
+    raise ValueError("no delivery days are configured")
+
+
 def is_on_time(placed_at, delivery_day):
