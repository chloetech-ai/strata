-from bakehouse.invoice import Invoice, InvoiceLine, format_pence, invoice_for, invoice_number
+from bakehouse.invoice import Invoice, InvoiceLine, format_pence, invoice_for, invoice_number, returns_credit
 from bakehouse.orders import OrderBook, OrderLine
 from bakehouse.products import Catalog, Product
 
 
+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("BAG", "Baguette", 95)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 5), 5 * 90)
+
+    def test_returns_above_ten_percent_of_delivery_are_not_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 12), 10 * 90)
+
+    def test_cap_rounds_down_to_whole_loaves(self):
+        # 10% of 32 is 3.2 loaves, so only 3 can be credited
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 9), 3 * 90)
+
+    def test_small_delivery_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 1), 0)
+
+    def test_no_returns_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 100, 5), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+
