@@ -40,6 +40,25 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+RETURNS_CUSTOMER = "GREENWAY"  # takes sandwich loaves on sale-or-return
+RETURNS_PRODUCT = "SWL"  # sandwich loaf
+RETURNS_CAP_PERCENT = 10  # credited returns are capped at this share of the loaves delivered that day
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold loaves sent back from one delivery of `delivered` loaves.
+
+    Only Greenway's sandwich loaves earn credit: half the wholesale price per loaf, for at most
+    10% of the loaves delivered that day (rounded down). Returns above that are not credited.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError("delivered and returned loaves cannot be negative")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    credited = min(returned, delivered * RETURNS_CAP_PERCENT // 100)
+    return credited * catalog.get(product_code).price // 2
+
+
