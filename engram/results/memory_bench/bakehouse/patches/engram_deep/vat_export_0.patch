+class ExportInvoicesTest(unittest.TestCase):
+    def test_writes_header_and_one_row_per_invoice_in_pounds(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 30, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 4), [InvoiceLine("SWL", 5, 180)]),
+        ]
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                text = f.read()
+        self.assertEqual(text, "date,customer,total\r\n20/10/2026,LUMEN,52.20\r\n04/10/2026,GREENWAY,9.00\r\n")
+
+    def test_empty_quarter_writes_only_header(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices([], path)
+            with open(path, newline="", encoding="utf-8") as f:
+                self.assertEqual(f.read(), "date,customer,total\r\n")
+
+    def test_pounds_text_keeps_two_decimals(self):
+        self.assertEqual(pounds_text(1250), "12.50")
+        self.assertEqual(pounds_text(5), "0.05")
+        self.assertEqual(pounds_text(300), "3.00")
+        self.assertEqual(pounds_text(-5), "-0.05")
+
