 """Invoices. All amounts are integer pence."""
 
+import csv
 import datetime
 from dataclasses import dataclass, field
 from typing import List
@@ -50,3 +51,23 @@ def invoice_for(orderbook, customer, day):
     for code in sorted(qty_by_product):
         invoice.lines.append(InvoiceLine(code, qty_by_product[code], orderbook.catalog.get(code).price))
     return invoice
+
+
+def pounds_text(pence):
+    """Plain pounds for integer pence, two decimals, no symbol: 1250 -> '12.50', -5 -> '-0.05'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write invoices to a CSV file for Ledgerly, one row per invoice: date, customer code, total before VAT.
+
+    Ledgerly wants a plain comma-separated file with a header row, DD/MM/YYYY dates
+    and amounts in pounds with a decimal point, never pence. Ledgerly applies VAT itself.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, pounds_text(invoice.total())])
