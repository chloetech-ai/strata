+def week_totals_file(orderbook, week_start, path):
+    """Writes one row per customer with orders in the seven days from `week_start`:
+    their order total for the week in pounds. Sorted by customer code.
+
+    The file is for Greta's German-locale Excel, so it uses semicolon separators and a
+    comma decimal separator. Totals are summed in pence and only converted when written."""
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + price * line.qty
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (GBP)"])
+        for customer in sorted(totals):
+            pence = totals[customer]
+            writer.writerow([customer, f"{pence // 100},{pence % 100:02d}"])
