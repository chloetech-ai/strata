@@ -18,6 +18,24 @@ def dough_weight_g(product, units):
     return units * product.dough_g
 
 
+def bake_sheet(orderbook, day):
+    """Plain-text bake sheet for `day`, one line per product, hottest oven first.
+
+    Each line gives the product name, pieces, batches and grams of dough to weigh out.
+    """
+    catalog = orderbook.catalog
+    bake = plan(orderbook, day)
+    codes = sorted(bake, key=lambda code: (-catalog.get(code).bake_temp, code))
+    lines = []
+    for code in codes:
+        units, batches = bake[code]
+        product = catalog.get(code)
+        lines.append(
+            f"{product.name:<20} {units:>4} pcs  {batches:>3} batches  {dough_weight_g(product, units):>6} g dough"
+        )
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Batches (trays in the oven) across all products in a `plan` result."""
     return sum(batches for _units, batches in plan_result.values())
