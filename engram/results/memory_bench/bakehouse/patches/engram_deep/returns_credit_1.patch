index 651e22e..541c406 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -40,6 +40,25 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+RETURNS_CUSTOMER = "GREENWAY"  # the only customer on sale-or-return
+RETURNS_PRODUCT = "SWL"  # sandwich loaf, the only product on sale-or-return
+RETURNS_CAP_PERCENT = 10  # returns are credited up to this share of loaves delivered that day
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for one delivery's unsold loaves sent back the next morning.
+
+    Greenway's sandwich loaves only: half the wholesale price per returned loaf, for at most
+    10% of the loaves delivered that day (rounded down). Returns above that are not credited.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, not {delivered} and {returned}")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    credited = min(returned, delivered * RETURNS_CAP_PERCENT // 100)
+    return credited * catalog.get(product_code).price // 2
+
+
