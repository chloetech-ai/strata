         self.assertEqual(format_pence(123456789), "£1234567.89")
 
 
+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("WRL", "White roll", 35)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 40, 3), 3 * 90)
+
+    def test_returns_above_ten_percent_of_delivered_are_not_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 40, 10), 4 * 90)
+
+    def test_cap_rounds_down_to_whole_loaves(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 5), 2 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 40, 0), 0)
+
+    def test_nothing_delivered_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 0, 5), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 40, 4), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "WRL", 40, 4), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 40, -1)
+
+
 if __name__ == "__main__":
     unittest.main()
