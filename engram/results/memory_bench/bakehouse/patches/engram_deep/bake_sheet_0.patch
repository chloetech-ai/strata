+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first.
+
+    The deck oven only cools overnight, so the hottest products go in first.
+    Products with no units to bake are left out.
+    """
+    catalog = orderbook.catalog
+    result = plan(orderbook, day)
+    codes = sorted(
+        (code for code, (units, _batches) in result.items() if units > 0),
+        key=lambda code: (-catalog.get(code).bake_temp, code),
+    )
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = result[code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name}: {units} pcs, {batches} batches, {grams} g dough")
+    return "".join(f"{line}\n" for line in lines)
+
+
