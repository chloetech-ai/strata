+"""Crate labels for packing a delivery day."""
+
+import unicodedata
+
+# The thermal label printer fits 48 characters per line and prints plain ASCII only.
+LINE_WIDTH = 48
+
+
+def to_ascii(text):
+    """Drops accents from `text` (u-umlaut becomes u) and any other non-ASCII characters."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, as a list of strings.
+
+    Each label has the customer's name, then the quantity and product name, then
+    the allergen text if the product has allergens. Customers come in the order of
+    their codes; products within a customer come in product code order.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        name = customers[code].name
+        quantities = {}
+        for line in orderbook.lines_for(code, day):
+            quantities[line.product] = quantities.get(line.product, 0) + line.qty
+        for product_code in sorted(quantities):
+            product = orderbook.catalog.get(product_code)
+            lines = [name, f"{quantities[product_code]} {product.name}"]
+            if product.allergens:
+                lines.append(product.allergen_text())
+            labels.append("\n".join(to_ascii(line)[:LINE_WIDTH] for line in lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
new file mode 100644
index 0000000..cd88c26
--- /dev/null
+++ b/tests/test_labels.py
@@ -0,0 +1,75 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels, to_ascii
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers():
+    return {
+        "LUM": Customer("LUM", "Café Lumen", "1 High St", "AB1 2CD", 1),
+        "GRE": Customer("GRE", "Greenway Grocers", "9 Mill Rd", "AB3 4EF", 2),
+    }
+
+
+def catalog():
+    return Catalog([
+        Product("BKW", "Bakewell slice", 150, allergens=("wheat", "milk", "eggs", "nuts")),
+        Product("CRO", "Croissant", 110),
+        Product("SOU", "White sourdough", 320),
+    ])
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "GRE", "SOU", 4),
+            OrderLine(DAY, "LUM", "CRO", 12),
+            OrderLine(DAY, "LUM", "BKW", 6),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Greenway Grocers\n4 White sourdough",
+            "Cafe Lumen\n6 Bakewell slice\nEGGS, MILK, NUTS, WHEAT",
+            "Cafe Lumen\n12 Croissant",
+        ])
+
+    def test_quantities_for_same_product_are_summed(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUM", "CRO", 2),
+            OrderLine(DAY, "LUM", "CRO", 3),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n5 Croissant"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUM", "CRO", 2),
+            OrderLine(DAY + datetime.timedelta(days=1), "GRE", "SOU", 4),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n2 Croissant"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(catalog()), customers(), DAY), [])
+
+    def test_accents_are_converted_to_ascii(self):
+        self.assertEqual(to_ascii("Café Lumen"), "Cafe Lumen")
+        self.assertEqual(to_ascii("Müller Bäckerei"), "Muller Backerei")
+
+    def test_label_text_is_ascii(self):
+        cafe = {"LUM": Customer("LUM", "Café Lumen", "1 High St", "AB1 2CD", 1)}
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUM", "CRO", 1)])
+        for label in crate_labels(book, cafe, DAY):
+            label.encode("ascii")
+
+    def test_lines_are_cut_to_printer_width(self):
+        long_name = {"LUM": Customer("LUM", "A" * 60, "1 High St", "AB1 2CD", 1)}
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUM", "CRO", 1)])
+        label = crate_labels(book, long_name, DAY)[0]
+        self.assertEqual(label.split("\n")[0], "A" * LINE_WIDTH)
+
+
+if __name__ == "__main__":
+    unittest.main()
