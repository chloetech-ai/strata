     for code in sorted(qty_by_product):
         invoice.lines.append(InvoiceLine(code, qty_by_product[code], orderbook.catalog.get(code).price))
     return invoice
+
+
+RETURNS_CUSTOMER = "GREENWAY"  # takes sandwich loaves on sale-or-return
+RETURNS_PRODUCT = "SWL"  # sandwich loaf
+RETURNS_CAP_PERCENT = 10  # credited loaves may not exceed this share of the day's delivered loaves
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for one delivery's unsold loaves sent back the next morning.
+
+    Only Greenway's sandwich loaves earn credit: half the wholesale price per returned loaf, for at
+    most 10% of the loaves delivered that day, rounded down. Returns above that are not credited.
+    Any other customer or product gets no credit.
+    """
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"loaf counts cannot be negative: delivered {delivered}, returned {returned}")
+    cap = delivered * RETURNS_CAP_PERCENT // 100
+    credited_loaves = min(returned, cap)
+    return credited_loaves * (catalog.get(product_code).price // 2)
