+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("SOU", "White sourdough", 320)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 3), 3 * 90)
+
+    def test_returns_up_to_ten_percent_of_delivered_are_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 5), 5 * 90)
+
+    def test_returns_above_ten_percent_are_not_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 8), 5 * 90)
+
+    def test_cap_is_rounded_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 45, 10), 4 * 90)
+
+    def test_no_credit_when_cap_rounds_to_zero(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 5), 0)
+
+    def test_no_credit_without_returns(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 0), 0)
+
+    def test_only_greenway_gets_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 50, 5), 0)
+
+    def test_only_sandwich_loaves_get_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 50, 5), 0)
+
+    def test_odd_wholesale_price_rounds_half_down(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 181)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 50, 2), 2 * 90)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 50, -1)
+
