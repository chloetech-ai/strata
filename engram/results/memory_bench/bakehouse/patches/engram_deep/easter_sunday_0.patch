+++ b/tests/test_seasons.py
@@ -0,0 +1,47 @@
+import datetime
+import unittest
+
+from bakehouse.seasons import easter_sunday
+
+
+class EasterSundayTest(unittest.TestCase):
+    def test_known_dates(self):
+        known = {
+            1900: (4, 15),
+            1943: (4, 25),
+            1961: (4, 2),
+            1981: (4, 19),
+            2000: (4, 23),
+            2008: (3, 23),
+            2011: (4, 24),
+            2019: (4, 21),
+            2024: (3, 31),
+            2025: (4, 20),
+            2026: (4, 5),
+        }
+        for year, (month, day) in known.items():
+            with self.subTest(year=year):
+                self.assertEqual(easter_sunday(year), datetime.date(year, month, day))
+
+    def test_always_a_sunday(self):
+        for year in range(1900, 2200):
+            with self.subTest(year=year):
+                self.assertEqual(easter_sunday(year).weekday(), 6)
+
+    def test_returns_date_between_march_22_and_april_25(self):
+        for year in range(1900, 2200):
+            with self.subTest(year=year):
+                easter = easter_sunday(year)
+                self.assertIsInstance(easter, datetime.date)
+                self.assertGreaterEqual(easter, datetime.date(year, 3, 22))
+                self.assertLessEqual(easter, datetime.date(year, 4, 25))
+
+    def test_year_outside_range_raises(self):
+        with self.assertRaisesRegex(ValueError, "1899"):
+            easter_sunday(1899)
+        with self.assertRaisesRegex(ValueError, "2200"):
+            easter_sunday(2200)
+
+
+if __name__ == "__main__":
+    unittest.main()
