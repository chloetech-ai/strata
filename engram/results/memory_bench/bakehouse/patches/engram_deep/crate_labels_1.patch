+"""Crate labels for packing: one label per customer and product for a delivery day."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 32  # the thermal label printer cuts off anything longer than this
+
+
+def ascii_text(text):
+    """Plain ASCII for the printer: accents are dropped ('Café' -> 'Cafe');
+    anything with no ASCII form becomes '?'."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    unaccented = "".join(c for c in decomposed if not unicodedata.combining(c))
+    return unaccented.encode("ascii", "replace").decode("ascii")
+
+
+def _wrapped(text):
+    return textwrap.wrap(ascii_text(text), LINE_WIDTH)
+
+
+def crate_labels(orderbook, customers, day):
+    """The text of each crate label for `day`, one per customer and product.
+
+    Labels come in route order, then product code order. Each label has the
+    customer's name, then the quantity and product name, then the allergens if
+    the product has any. Text longer than the printer's line width is wrapped
+    onto more lines, not cut off, so allergen information is never lost.
+    `customers` is the dict that load_customers returns.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        quantities = {}  # product code -> units; several lines for one product are summed
+        for line in orderbook.lines_for(code, day):
+            quantities[line.product] = quantities.get(line.product, 0) + line.qty
+        for product_code in sorted(quantities):
+            product = orderbook.catalog.get(product_code)
+            lines = _wrapped(customers[code].name) + _wrapped(f"{quantities[product_code]} {product.name}")
+            if product.allergens:
+                lines += _wrapped(product.allergen_text())
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
new file mode 100644
index 0000000..8bb41a1
--- /dev/null
+++ b/tests/test_labels.py
@@ -0,0 +1,84 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, ascii_text, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 2),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 1),
+    }
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, allergens=("wheat",)),
+            Product("CRO", "Croissant", 110, batch_size=24, allergens=("wheat", "milk", "eggs")),
+            Product("FLO", "Florentine", 90, batch_size=40, allergens=("milk", "nuts")),
+        ])
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "FLO", 40),
+            OrderLine(DAY, "GREENWAY", "BAG", 12),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Greenway Grocers\n12 Baguette\nWHEAT",
+            "Greenway Grocers\n40 Florentine\nMILK, NUTS",
+            "Cafe Lumen\n5 Baguette\nWHEAT",
+        ])
+
+    def test_customer_name_is_ascii_only(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n1 Baguette\nWHEAT"])
+
+    def test_lines_for_the_same_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 18),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n24 Croissant\nEGGS, MILK, WHEAT"])
+
+    def test_product_without_allergens_has_no_allergen_line(self):
+        plain = Catalog([Product("BRO", "Brötchen", 40, batch_size=30)])
+        book = OrderBook(plain, [OrderLine(DAY, "LUMEN", "BRO", 30)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n30 Brotchen"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "BAG", 3),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n5 Baguette\nWHEAT"])
+
+    def test_empty_day_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog), customers(), DAY), [])
+
+    def test_long_allergen_text_is_wrapped_not_cut_off(self):
+        catalog = Catalog([Product("PCH", "Pain au chocolat", 125, batch_size=24,
+                                   allergens=("wheat", "milk", "eggs", "soya", "nuts", "sesame", "celery"))])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "PCH", 24)])
+        label = crate_labels(book, customers(), DAY)[0]
+        allergen_lines = label.split("\n")[2:]
+        self.assertEqual(" ".join(allergen_lines), "CELERY, EGGS, MILK, NUTS, SESAME, SOYA, WHEAT")
+        self.assertTrue(all(len(line) <= LINE_WIDTH for line in label.split("\n")))
+
+
+class AsciiTextTest(unittest.TestCase):
+    def test_accents_are_dropped(self):
+        self.assertEqual(ascii_text("Café Brötchen"), "Cafe Brotchen")
+
+    def test_characters_with_no_ascii_form_become_question_marks(self):
+        self.assertEqual(ascii_text("Straße ✓"), "Stra?e ?")
+
+
+if __name__ == "__main__":
+    unittest.main()
