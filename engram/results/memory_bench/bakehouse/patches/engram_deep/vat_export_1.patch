+class PoundsTextTest(unittest.TestCase):
+    def test_two_decimals_and_no_currency_sign(self):
+        self.assertEqual(pounds_text(1250), "12.50")
+        self.assertEqual(pounds_text(5), "0.05")
+        self.assertEqual(pounds_text(300), "3.00")
