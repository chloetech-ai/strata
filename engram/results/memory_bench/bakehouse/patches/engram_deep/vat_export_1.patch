+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_with_date_customer_and_total(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 30, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 1), [InvoiceLine("SWL", 5, 180)]),
