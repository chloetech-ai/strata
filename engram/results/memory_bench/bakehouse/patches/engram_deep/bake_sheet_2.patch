+
+
+def bake_sheet(orderbook, day):
+    """Plain-text bake sheet for `day`, one line per product, hottest oven first.
+
+    The deck oven only cools down overnight, so the hottest product is baked
+    first to avoid reheating it.
+    """
+    rows = plan(orderbook, day)
+    catalog = orderbook.catalog
+    codes = sorted(rows, key=lambda code: (-catalog.get(code).bake_temp, code))
+    if not codes:
+        return "Nothing to bake.\n"
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<20} {units:>5} units  {batches:>3} batches  {grams:>7} g dough")
+    return "\n".join(lines) + "\n"
