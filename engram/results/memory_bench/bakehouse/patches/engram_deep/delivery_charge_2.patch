@@ -40,6 +40,18 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, before VAT
+DELIVERY_CHARGE_BELOW = 4000  # pence: orders worth less than this pay the charge
+DELIVERY_EXEMPT = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order on one day; `subtotal` is the order value in pence, before VAT."""
+    if customer_code in DELIVERY_EXEMPT or subtotal <= 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_CHARGE_BELOW else 0
+
+
