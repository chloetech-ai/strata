index 0000000..5a613e7
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,20 @@
+"""Wholesale price rises. All amounts are integer pence."""
+
+RISE_PERCENT = 5  # January wholesale price rise
+ROUND_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_price(price):
+    """The price after the rise, rounded up (never down) to the next 5p.
+
+    Done in integers: price * (100 + RISE_PERCENT) / 100 rounded up to a multiple
+    of ROUND_TO is the same as ceil(price * (100 + RISE_PERCENT) / (100 * ROUND_TO)) * ROUND_TO.
+    """
+    numerator = price * (100 + RISE_PERCENT)
+    denominator = 100 * ROUND_TO
+    return -(-numerator // denominator) * ROUND_TO
+
+
+def new_prices(catalog):
+    """Maps each product code in `catalog` to its new wholesale price in pence."""
+    return {product.code: new_price(product.price) for product in catalog}
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..06e3fde
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,46 @@
+import unittest
+
+from bakehouse.pricing import new_price, new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPriceTest(unittest.TestCase):
+    def test_rounds_up_to_next_5p(self):
+        # 95p * 1.05 = 99.75p -> 100p
+        self.assertEqual(new_price(95), 100)
+        # 320p * 1.05 = 336p -> 340p
+        self.assertEqual(new_price(320), 340)
+        # 360p * 1.05 = 378p -> 380p
+        self.assertEqual(new_price(360), 380)
+
+    def test_exact_multiple_of_5_is_not_bumped(self):
+        # 100p * 1.05 = 105p exactly
+        self.assertEqual(new_price(100), 105)
+
+    def test_never_rounds_down(self):
+        # 40p * 1.05 = 42p -> 45p
+        self.assertEqual(new_price(40), 45)
+
+    def test_zero_stays_zero(self):
+        self.assertEqual(new_price(0), 0)
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_maps_each_product_code_to_new_price(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95),
+            Product("SOU", "White sourdough", 320),
+        ])
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "SOU": 340})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+    def test_does_not_change_catalog_prices(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        new_prices(catalog)
+        self.assertEqual(catalog.get("BAG").price, 95)
+
+
+if __name__ == "__main__":
+    unittest.main()
