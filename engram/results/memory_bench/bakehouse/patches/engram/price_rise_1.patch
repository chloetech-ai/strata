+"""Wholesale price changes."""
+
+# Greta's January rise: 5%, with each new price rounded up (never down) to the next 5p.
+RISE_NUMERATOR = 105  # 100% + 5%, over
+RISE_DENOMINATOR = 100
+ROUND_TO = 5  # pence
+
+
+def new_price(pence):
+    """The price after the January rise, in whole pence, rounded up to the next 5p."""
+    # Integer arithmetic only: ceil(pence * 1.05 / 5) * 5, written without floats.
+    scaled = pence * RISE_NUMERATOR
+    step = RISE_DENOMINATOR * ROUND_TO
+    return -(-scaled // step) * ROUND_TO
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in `catalog`."""
+    return {product.code: new_price(product.price) for product in catalog}
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
