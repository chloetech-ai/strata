     return f"LK-{year}-{seq:04d}"
 
 
+# Greta's delivery charge, from November: £4.50 on any order under £40.00.
+# Order value is the customer's total for one delivery day, before VAT.
+DELIVERY_CHARGE = 450  # pence
+DELIVERY_CHARGE_BELOW = 4000  # pence
+# St Aidan's contract price already includes delivery.
+NO_DELIVERY_CHARGE = {"AIDAN"}
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order of `subtotal` pence (before VAT) for one day."""
+    if customer_code in NO_DELIVERY_CHARGE or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def invoice_for(orderbook, customer, day):
     """The invoice for what `customer` ordered for delivery on `day`, at catalog prices.
     One line per product, sorted by product code."""
