+class ReturnsCreditTest(unittest.TestCase):
+    def catalog(self):
+        return Catalog([Product("SWL", "Sandwich loaf", 180, 16), Product("SOU", "White sourdough", 320, 10)])
+
+    def credit(self, customer, product, delivered, returned):
+        return returns_credit(self.catalog(), customer, product, delivered, returned)
+
+    def test_half_the_wholesale_price_per_returned_loaf(self):
+        self.assertEqual(self.credit("GREENWAY", "SWL", 100, 3), 3 * 90)
+
+    def test_returns_up_to_ten_percent_of_delivery_are_credited(self):
+        self.assertEqual(self.credit("GREENWAY", "SWL", 20, 2), 2 * 90)
+
+    def test_returns_above_ten_percent_are_not_credited(self):
+        self.assertEqual(self.credit("GREENWAY", "SWL", 20, 5), 2 * 90)
+
+    def test_cap_rounds_down_to_whole_loaves(self):
+        # 10% of 25 is 2.5, so only 2 loaves count.
+        self.assertEqual(self.credit("GREENWAY", "SWL", 25, 5), 2 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(self.credit("GREENWAY", "SWL", 20, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(self.credit("LUMEN", "SWL", 20, 2), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(self.credit("GREENWAY", "SOU", 20, 2), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            self.credit("GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            self.credit("GREENWAY", "SWL", 20, -1)
+
