+
+
+# Greenway Grocers take sandwich loaves on sale-or-return. Only these count.
+RETURNS_CUSTOMER = "GREENWAY"
+RETURNS_PRODUCT = "SWL"
+RETURNS_CAP_PERCENT = 10  # returns are credited up to this share of the day's delivery
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold loaves from one delivery.
+    Each returned loaf is credited at half the wholesale price, but only up to 10% of the
+    loaves delivered that day (rounded down); returns above that get nothing.
+    Any customer or product other than Greenway's sandwich loaves gets no credit."""
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    creditable = min(returned, delivered * RETURNS_CAP_PERCENT // 100)
+    return creditable * catalog.get(product_code).price // 2
