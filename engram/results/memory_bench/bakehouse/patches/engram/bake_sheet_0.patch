+def bake_sheet(orderbook, day):
+    """The printed bake sheet for `day`: one line per product, hottest oven first.
+
+    Each line gives the product name, units, batches and the dough to weigh out in grams.
+    """
+    catalog = orderbook.catalog
+    result = plan(orderbook, day)
+    products = sorted(
+        (catalog.get(code) for code in result),
+        key=lambda product: (-product.bake_temp, product.code),
+    )
+    name_width = max((len(product.name) for product in products), default=0)
+    lines = []
+    for product in products:
+        units, batches = result[product.code]
+        lines.append(
+            f"{product.name:<{name_width}}  {units:>5} pcs  {batches:>3} batches  "
+            f"{dough_weight_g(product, units):>7} g dough"
+        )
+    return "\n".join(lines)
