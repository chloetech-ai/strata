+class ExportInvoicesTest(unittest.TestCase):
+    def test_writes_header_and_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 21), [InvoiceLine("CRO", 5, 110)]),
+        ]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, encoding="utf-8", newline="") as f:
+                text = f.read()
+        self.assertEqual(text, "Date,Customer,Total\r\n20/10/2026,LUMEN,45.60\r\n21/10/2026,AIDAN,5.50\r\n")
