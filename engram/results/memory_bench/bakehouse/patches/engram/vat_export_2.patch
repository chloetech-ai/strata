+def export_invoices(invoices, path):
+    """Write one CSV row per invoice for the VAT return, in the layout Ledgerly imports:
+    a header row, dates as DD/MM/YYYY, and totals in pounds with two decimals (e.g. 12.50)."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds(invoice.total())])
