+++ b/tests/test_delivery.py
@@ -0,0 +1,49 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import load_customers
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import load_catalog
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def test_lists_only_customers_with_orders_in_route_order(self):
+        catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        customers = load_customers(os.path.join(DATA, "customers.csv"))
+        product = next(iter(catalog)).code
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "GREENWAY", product, 2),
+            OrderLine(DAY, "LUMEN", product, 1),
+            OrderLine(DAY + datetime.timedelta(days=1), "POTTERS", product, 1),
+        ])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(book, customers, DAY, path)
+            with open(path, encoding="utf-8") as f:
+                lines = f.read().splitlines()
+        expected = sorted(
+            [customers["GREENWAY"], customers["LUMEN"]], key=lambda c: c.route_seq
+        )
+        self.assertEqual(
+            lines,
+            [f"{c.route_seq}. {c.name}, {c.address}, {c.postcode}" for c in expected],
+        )
+
+    def test_empty_day_writes_empty_file(self):
+        catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        customers = load_customers(os.path.join(DATA, "customers.csv"))
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(OrderBook(catalog), customers, DAY, path)
+            with open(path, encoding="utf-8") as f:
+                self.assertEqual(f.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
