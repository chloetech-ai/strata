index 895ea4f..cad6382 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -40,6 +40,19 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, £4.50 from November
+DELIVERY_CHARGE_BELOW = 4000  # pence: the charge applies to orders under £40.00
+NO_DELIVERY_CHARGE = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order worth `subtotal` pence for one delivery day, before VAT.
+    No order means no delivery, so no charge."""
+    if customer_code in NO_DELIVERY_CHARGE or subtotal == 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_CHARGE_BELOW else 0
+
+
 def invoice_for(orderbook, customer, day):
     """The invoice for what `customer` ordered for delivery on `day`, at catalog prices.
     One line per product, sorted by product code."""
