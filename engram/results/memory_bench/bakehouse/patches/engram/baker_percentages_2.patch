+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"White flour": 500, "Wholemeal flour": 500, "Water": 700, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"White flour": 50.0, "Wholemeal flour": 50.0, "Water": 70.0, "Salt": 1.0},
+        )
+
+    def test_flour_match_ignores_case(self):
+        self.assertEqual(baker_percentages({"FLOUR": 200, "Water": 150}), {"FLOUR": 100.0, "Water": 75.0})
+
+    def test_rounds_to_one_decimal(self):
+        self.assertEqual(baker_percentages({"Flour": 300, "Salt": 7}), {"Flour": 100.0, "Salt": 2.3})
+
+    def test_raises_without_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 700, "Salt": 10})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 700})
+
+
+if __name__ == "__main__":
+    unittest.main()
