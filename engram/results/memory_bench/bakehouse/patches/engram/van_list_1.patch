@@ -0,0 +1,67 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def catalog():
+    return Catalog([Product("SOU", "White sourdough", 320, 10)])
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        "AIDAN": Customer("AIDAN", "St Aidan's Primary", "Church Road", "LK3 9CD", 2),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "2 High Street", "LK2 4EF", 4),
+    }
+
+
+class DropsFileTest(unittest.TestCase):
+    def write(self, book):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.csv")
+            drops_file(book, customers(), DAY, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return list(csv.reader(f))
+
+    def test_one_row_per_customer_with_orders_that_day(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY, "AIDAN", "SOU", 4),
+        ])
+        self.assertEqual(self.write(book), [
+            ["route_seq", "code", "name", "address", "postcode"],
+            ["1", "LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB"],
+            ["2", "AIDAN", "St Aidan's Primary", "Church Road", "LK3 9CD"],
+        ])
+
+    def test_rows_follow_route_order_not_order_book_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "GREENWAY", "SOU", 10),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+        ])
+        rows = self.write(book)[1:]
+        self.assertEqual([row[1] for row in rows], ["LUMEN", "GREENWAY"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "AIDAN", "SOU", 4),
+        ])
+        self.assertEqual([row[1] for row in self.write(book)[1:]], ["LUMEN"])
+
+    def test_no_orders_gives_just_the_header(self):
+        self.assertEqual(self.write(OrderBook(catalog())), [["route_seq", "code", "name", "address", "postcode"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
