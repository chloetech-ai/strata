+"""The van's run: which drops to make on a delivery day, in driving order."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the drops for `day` to `path` as CSV, one row per customer with orders that day,
+    in route_seq order. `customers` is the dict from customers.load_customers."""
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["route_seq", "code", "name", "address", "postcode"])
+        for code in codes:
+            c = customers[code]
+            writer.writerow([c.route_seq, c.code, c.name, c.address, c.postcode])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
