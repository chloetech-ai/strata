+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 1000, "Wholemeal flour": 200, "Water": 750, "Salt": 20}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong white flour": 83.3,
+            "Wholemeal flour": 16.7,
+            "Water": 62.5,
+            "Salt": 1.7,
+        })
+
+    def test_flour_match_ignores_case(self):
+        recipe = {"RYE FLOUR": 500, "Water": 400}
+        self.assertEqual(baker_percentages(recipe)["Water"], 80.0)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 400, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Strong white flour": 0, "Water": 400})
+
+
+if __name__ == "__main__":
+    unittest.main()
