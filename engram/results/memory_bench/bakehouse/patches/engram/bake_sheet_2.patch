+def bake_sheet(orderbook, day):
+    """Printable text sheet for `day`: one line per product, hottest oven first.
+
+    Each line gives the product name, pieces, batches and the dough to weigh out in grams.
+    """
+    catalog = orderbook.catalog
+    rows = sorted(plan(orderbook, day).items(), key=lambda item: -catalog.get(item[0]).bake_temp)
+    if not rows:
+        return f"Nothing to bake on {day:%d/%m/%Y}\n"
+    name_width = max(len(catalog.get(code).name) for code, _ in rows)
+    lines = [f"{'Product':<{name_width}}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}"]
+    for code, (units, batches) in rows:
+        product = catalog.get(code)
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<{name_width}}  {units:>5}  {batches:>7}  {grams:>7} g")
+    return "\n".join(lines) + "\n"
+
+
