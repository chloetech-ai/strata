+def bake_sheet(orderbook, day):
+    """The printable bake sheet for `day`: one line per product, hottest oven first."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    products = sorted((catalog.get(code) for code in rows), key=lambda p: (-p.bake_temp, p.code))
+    width = max(len(p.name) for p in products)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}",
+    ]
+    for product in products:
+        units, batches = rows[product.code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {grams:>6} g")
+    return "\n".join(lines)
