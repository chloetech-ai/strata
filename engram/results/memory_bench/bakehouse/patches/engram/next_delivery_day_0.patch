+    def test_next_delivery_day_skips_closed_days(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            following = next_delivery_day(day)
+            self.assertGreater(following, day)
+            self.assertTrue(is_delivery_day(following))
+            # Nothing in between is a delivery day.
+            between = (day + datetime.timedelta(days=i) for i in range(1, (following - day).days))
+            self.assertFalse(any(is_delivery_day(d) for d in between))
+
+    def test_next_delivery_day_from_sunday_is_tuesday_when_monday_closed(self):
+        sunday = datetime.date(2026, 10, 18)
+        self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))
+
 
