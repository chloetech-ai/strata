+"""Crate labels for the packing room."""
+
+import textwrap
+import unicodedata
+
+# The label printer holds 48 characters per line and cuts off anything longer.
+LABEL_WIDTH = 48
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, in route order.
+
+    Each label is the customer's name, the quantity and product name, and then
+    the allergens in capitals. Text is plain ASCII and wrapped to LABEL_WIDTH,
+    so the printer never cuts anything off.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    keys = sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1]))
+
+    labels = []
+    for customer_code, product_code in keys:
+        product = orderbook.catalog.get(product_code)
+        lines = [_ascii(customers[customer_code].name), f"{totals[(customer_code, product_code)]} x {_ascii(product.name)}"]
+        if product.allergens:
+            lines.append(f"ALLERGENS: {_ascii(product.allergen_text().upper())}")
+        labels.append("\n".join(wrapped for line in lines for wrapped in textwrap.wrap(line, LABEL_WIDTH)))
+    return labels
+
+
+def _ascii(text):
+    """Drops accents and any other non-ASCII, so 'Café' prints as 'Cafe'."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
