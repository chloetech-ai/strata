@@ -0,0 +1,74 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LABEL_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def catalog():
+    return Catalog([
+        Product("RYE", "Seeded rye sourdough", 360, allergens=("wheat", "sesame", "rye")),
+        Product("CRO", "Croissant", 110),
+    ])
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 2),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "1 High Street", "LK3 4CD", 1),
+    }
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "CRO", 6),
+            OrderLine(DAY, "GREENWAY", "RYE", 2),
+            OrderLine(DAY, "GREENWAY", "CRO", 4),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Greenway Grocers\n4 x Croissant",
+            "Greenway Grocers\n2 x Seeded rye sourdough\nALLERGENS: RYE, SESAME, WHEAT",
+            "Cafe Lumen\n6 x Croissant",
+        ])
+
+    def test_quantities_for_the_same_customer_and_product_are_summed(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "CRO", 2),
+            OrderLine(DAY, "LUMEN", "CRO", 3),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n5 x Croissant"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "CRO", 1),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "CRO", 9),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n1 x Croissant"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(catalog()), customers(), DAY), [])
+
+    def test_every_line_fits_the_printer_and_no_allergen_is_lost(self):
+        many = tuple(f"allergen{i:02d}" for i in range(12))
+        book = OrderBook(
+            Catalog([Product("BIG", "Extremely long multigrain seeded loaf with everything", 400, allergens=many)]),
+            [OrderLine(DAY, "LUMEN", "BIG", 1)],
+        )
+        (label,) = crate_labels(book, customers(), DAY)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LABEL_WIDTH)
+        for allergen in many:
+            self.assertIn(allergen.upper(), label.replace("\n", " "))
+
+    def test_label_text_is_plain_ascii(self):
+        (label,) = crate_labels(OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "CRO", 1)]), customers(), DAY)
+        label.encode("ascii")
+
+
+if __name__ == "__main__":
+    unittest.main()
