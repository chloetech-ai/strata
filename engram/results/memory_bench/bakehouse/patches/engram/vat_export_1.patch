+def pounds_text(pence):
+    """Integer pence as a plain pounds string with a decimal point, e.g. 1234 -> '12.34'. No currency sign."""
+    sign = "-" if pence < 0 else ""
+    pounds, remainder = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{remainder:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write one row per invoice for the VAT return: date (DD/MM/YYYY), customer code, total in pounds.
+    Plain comma-separated with a header row, the format Ledgerly imports."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            writer.writerow([
+                invoice.day.strftime("%d/%m/%Y"),
+                invoice.customer,
+                pounds_text(invoice.total()),
+            ])
