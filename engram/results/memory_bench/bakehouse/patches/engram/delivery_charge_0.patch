index 895ea4f..df0cc8e 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -40,6 +40,19 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # £4.50, charged from November
+DELIVERY_CHARGE_BELOW = 4000  # orders under £40.00 pay the charge
+DELIVERY_EXEMPT = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for a customer's order for one delivery day, before VAT.
+    `subtotal` is the value of that order in pence."""
+    if customer_code in DELIVERY_EXEMPT or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def invoice_for(orderbook, customer, day):
     """The invoice for what `customer` ordered for delivery on `day`, at catalog prices.
     One line per product, sorted by product code."""
