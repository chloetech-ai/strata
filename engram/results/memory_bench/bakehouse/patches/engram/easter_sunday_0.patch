@@ -0,0 +1,38 @@
+import datetime
+import unittest
+
+from bakehouse.seasons import easter_sunday
+
+
+class EasterSundayTest(unittest.TestCase):
+    def test_known_dates(self):
+        cases = {
+            1900: datetime.date(1900, 4, 15),
+            1961: datetime.date(1961, 4, 2),
+            1981: datetime.date(1981, 4, 19),
+            2000: datetime.date(2000, 4, 23),
+            2008: datetime.date(2008, 3, 23),
+            2024: datetime.date(2024, 3, 31),
+            2025: datetime.date(2025, 4, 20),
+            2026: datetime.date(2026, 4, 5),
+            2027: datetime.date(2027, 3, 28),
+            2038: datetime.date(2038, 4, 25),
+        }
+        for year, expected in cases.items():
+            with self.subTest(year=year):
+                self.assertEqual(easter_sunday(year), expected)
+
+    def test_always_a_sunday_between_march_22_and_april_25(self):
+        for year in range(1900, 2200):
+            with self.subTest(year=year):
+                easter = easter_sunday(year)
+                self.assertIsInstance(easter, datetime.date)
+                self.assertEqual(easter.weekday(), 6)
+                self.assertGreaterEqual(easter, datetime.date(year, 3, 22))
+                self.assertLessEqual(easter, datetime.date(year, 4, 25))
+
+    def test_years_outside_range_are_rejected(self):
+        with self.assertRaises(ValueError):
+            easter_sunday(1899)
+        with self.assertRaises(ValueError):
+            easter_sunday(2200)
