+"""Seasons for planning. Dates are Gregorian calendar dates."""
+
+import datetime
+
+
+def easter_sunday(year):
+    """Date of Easter Sunday in the Western church for `year` (1900-2199).
+    Uses the anonymous Gregorian algorithm (Meeus/Jones/Butcher)."""
+    if not 1900 <= year <= 2199:
+        raise ValueError(f"year must be 1900-2199, got {year}")
+    a = year % 19
+    b = year // 100
+    c = year % 100
+    d = b // 4
+    e = b % 4
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i = c // 4
+    k = c % 4
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month = (h + l - 7 * m + 114) // 31
+    day = (h + l - 7 * m + 114) % 31 + 1
+    return datetime.date(year, month, day)
