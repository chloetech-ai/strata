+class WeekTotalsFileTest(unittest.TestCase):
+    def write(self, book, week_start):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                text = f.read()
+        return text
+
+    def test_sums_each_customer_over_the_week_in_semicolon_csv_with_comma_decimals(self):
+        day3 = DAY + datetime.timedelta(days=2)
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),            # 1920
+            OrderLine(day3, "LUMEN", "CRO", 24),          # 2640
+            OrderLine(day3, "AIDAN", "CRO", 5),           # 550
+        ])
+        self.assertEqual(
+            self.write(book, DAY),
+            "Customer;Total\r\nAIDAN;5,50\r\nLUMEN;45,60\r\n",
+        )
+
+    def test_window_is_seven_days_from_week_start_inclusive(self):
+        last_day = DAY + datetime.timedelta(days=6)
+        book = OrderBook(catalog(), [
+            OrderLine(DAY - datetime.timedelta(days=1), "AIDAN", "SOU", 1),
+            OrderLine(DAY, "LUMEN", "SOU", 1),
+            OrderLine(last_day, "LUMEN", "SOU", 1),
+            OrderLine(last_day + datetime.timedelta(days=1), "AIDAN", "SOU", 1),
+        ])
+        self.assertEqual(self.write(book, DAY), "Customer;Total\r\nLUMEN;6,40\r\n")
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "CRO", 1)])
+        self.assertEqual(self.write(book, DAY), "Customer;Total\r\nLUMEN;1,10\r\n")
+
+    def test_no_orders_gives_header_only(self):
+        self.assertEqual(self.write(OrderBook(catalog()), DAY), "Customer;Total\r\n")
+
+    def test_reads_back_as_two_columns_split_on_semicolons(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "SOU", 6)])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, DAY, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                rows = list(csv.reader(f, delimiter=";"))
+        self.assertEqual(rows, [["Customer", "Total"], ["LUMEN", "19,20"]])
+
+
