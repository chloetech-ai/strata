+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8-sig") as f:
+            return f.read().splitlines()
+
+    def test_one_row_per_customer_with_semicolons_and_comma_decimals(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "AIDAN", "CRO", 48),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), ["customer;total_gbp", "AIDAN;52,80", "LUMEN;45,60"])
+
+    def test_adds_up_all_seven_days_from_week_start(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 2),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), ["customer;total_gbp", "LUMEN;9,60"])
+
+    def test_days_outside_the_week_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=3), "AIDAN", "CRO", 1),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), ["customer;total_gbp", "AIDAN;1,10"])
+
+    def test_pence_are_always_two_digits(self):
+        cheap = Catalog([Product("PEN", "Penny bun", 1, 10)])
+        book = OrderBook(cheap, [OrderLine(DAY, "LUMEN", "PEN", 5), OrderLine(DAY, "AIDAN", "PEN", 1000)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), ["customer;total_gbp", "AIDAN;10,00", "LUMEN;0,05"])
+
+    def test_no_orders_gives_just_the_header(self):
+        week_totals_file(OrderBook(catalog()), DAY, self.path)
+        self.assertEqual(self.read(), ["customer;total_gbp"])
+
+
