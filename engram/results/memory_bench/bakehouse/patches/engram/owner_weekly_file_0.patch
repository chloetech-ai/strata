+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order total in pounds for the seven days starting at
+    `week_start`, before VAT. Greta's office PC is set to German, so the file uses semicolons between
+    fields and a comma as the decimal separator, e.g. `LUMEN;52,80`. A byte order mark lets Excel
+    read the file as UTF-8."""
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * orderbook.catalog.get(line.product).price
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            pence = totals[customer]
+            writer.writerow([customer, f"{pence // 100},{pence % 100:02d}"])
+
+
