+class ReturnsCreditTest(unittest.TestCase):
+    def test_half_wholesale_price_per_returned_loaf(self):
+        self.assertEqual(returns_credit(catalog(), "GREENWAY", "SWL", 100, 5), 5 * 180 // 2)
+
+    def test_credit_is_capped_at_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(catalog(), "GREENWAY", "SWL", 100, 20), 10 * 180 // 2)
+
+    def test_returns_at_the_cap_are_credited_in_full(self):
+        self.assertEqual(returns_credit(catalog(), "GREENWAY", "SWL", 100, 10), 10 * 180 // 2)
+
+    def test_cap_rounds_down_to_whole_loaves(self):
+        # 10% of 19 loaves is 1.9, so only 1 loaf can be credited
+        self.assertEqual(returns_credit(catalog(), "GREENWAY", "SWL", 19, 5), 1 * 180 // 2)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(catalog(), "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(catalog(), "LUMEN", "SWL", 100, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(catalog(), "GREENWAY", "SOU", 100, 5), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(catalog(), "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(catalog(), "GREENWAY", "SWL", 100, -1)
+
+
