diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index 895ea4f..3f71ad3 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -40,6 +40,22 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+SALE_OR_RETURN_CUSTOMER = "GREENWAY"  # takes sandwich loaves on sale-or-return
+SALE_OR_RETURN_PRODUCT = "SWL"  # the sandwich loaf
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold loaves of `product_code` that `customer_code` sent back
+    the morning after a delivery of `delivered` loaves. Only Greenway's sandwich loaves qualify, at
+    half the wholesale price, and at most 10% of the day's delivered loaves is credited; the rest get nothing."""
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if customer_code != SALE_OR_RETURN_CUSTOMER or product_code != SALE_OR_RETURN_PRODUCT:
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * catalog.get(product_code).price // 2
+
+
 def invoice_for(orderbook, customer, day):
     """The invoice for what `customer` ordered for delivery on `day`, at catalog prices.
     One line per product, sorted by product code."""
