+"""The van's run for a delivery day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the drops for `day` to `path`, one per line in driving order (route_seq).
+    Only customers with orders on `day` are included."""
+    drops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for drop in drops:
+            f.write(f"{drop.route_seq}. {drop.name}, {drop.address}, {drop.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
