+class ReturnsCreditTest(unittest.TestCase):
+    def catalog(self):
+        return Catalog([Product("SWL", "Sandwich loaf", 180, 16)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog(), "GREENWAY", "SWL", 100, 5), 5 * 90)
+
+    def test_capped_at_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog(), "GREENWAY", "SWL", 100, 15), 10 * 90)
+
+    def test_cap_rounds_down_to_whole_loaves(self):
+        self.assertEqual(returns_credit(self.catalog(), "GREENWAY", "SWL", 25, 25), 2 * 90)
+
+    def test_returns_under_the_cap_are_all_credited(self):
+        self.assertEqual(returns_credit(self.catalog(), "GREENWAY", "SWL", 100, 0), 0)
+        self.assertEqual(returns_credit(self.catalog(), "GREENWAY", "SWL", 100, 3), 3 * 90)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog(), "LUMEN", "SWL", 100, 10), 0)
+
+    def test_other_products_get_no_credit(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 180, 16), Product("SOU", "White sourdough", 320, 10)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SOU", 100, 10), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog(), "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog(), "GREENWAY", "SWL", 10, -1)
+
+
