     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for one delivery's unsold loaves sent back the next morning.
+
+    Only Greenway's sandwich loaves are on sale-or-return: each returned loaf is credited
+    at half its wholesale price, and at most 10% of the loaves delivered that day
+    (rounded down) are credited. Returns above that are not credited. Anything else gets 0."""
+    if customer_code != "GREENWAY" or product_code != "SWL":
+        return 0
+    if delivered < 0 or returned < 0:
+        raise ValueError("delivered and returned must not be negative")
+    credited = min(returned, delivered * 10 // 100)
+    return credited * catalog.get(product_code).price // 2
+
+
