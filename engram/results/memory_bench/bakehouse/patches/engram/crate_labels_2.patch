@@ -0,0 +1,80 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def catalog():
+    return Catalog([
+        Product("BRO", "Brötchen", 40, allergens=("wheat",)),
+        Product("RYE", "Seeded rye sourdough", 360, allergens=("rye", "wheat", "sesame")),
+        Product("CRO", "Croissant", 110, allergens=("milk", "wheat", "eggs")),
+        Product("PLN", "Plain loaf", 300),
+    ])
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "1 High St", "AB1 2CD", 2),
+        "AIDAN": Customer("AIDAN", "St Aidan's Primary", "9 School Rd", "AB3 4EF", 1),
+    }
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "BRO", 6),
+            OrderLine(DAY, "AIDAN", "RYE", 2),
+            OrderLine(DAY, "AIDAN", "BRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "St Aidan's Primary\n12 x Brotchen\nCONTAINS: WHEAT",
+            "St Aidan's Primary\n2 x Seeded rye sourdough\nCONTAINS: RYE, SESAME, WHEAT",
+            "Cafe Lumen\n6 x Brotchen\nCONTAINS: WHEAT",
+        ])
+
+    def test_quantities_for_the_same_customer_and_product_are_summed(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "CRO", 4),
+            OrderLine(DAY, "LUMEN", "CRO", 2),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Cafe Lumen\n6 x Croissant\nCONTAINS: EGGS, MILK, WHEAT",
+        ])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(catalog(), [OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BRO", 6)])
+        self.assertEqual(crate_labels(book, customers(), DAY), [])
+
+    def test_product_without_allergens_has_no_allergen_line(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "PLN", 1)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n1 x Plain loaf"])
+
+    def test_every_line_fits_the_printer(self):
+        people = {"LONG": Customer("LONG", "Mrs Penelope Hortensia Featherstonehaugh-Smythe of the Old Vicarage", "1 Lane", "AB1 2CD", 1)}
+        book = OrderBook(catalog(), [OrderLine(DAY, "LONG", "RYE", 3)])
+        (label,) = crate_labels(book, people, DAY)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+
+    def test_long_allergen_lists_are_wrapped_not_cut(self):
+        allergens = tuple("allergen%d" % i for i in range(10))
+        book = OrderBook(Catalog([Product("X", "Big mix", 300, allergens=allergens)]), [OrderLine(DAY, "LUMEN", "X", 1)])
+        (label,) = crate_labels(book, customers(), DAY)
+        words = label.replace("\n", " ").replace(",", " ").split()
+        for name in allergens:
+            self.assertIn(name.upper(), words)
+
+    def test_label_text_is_plain_ascii(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "BRO", 6)])
+        (label,) = crate_labels(book, customers(), DAY)
+        label.encode("ascii")
+
+
+if __name__ == "__main__":
+    unittest.main()
