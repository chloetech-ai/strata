+"""Crate labels for the packing room's label printer."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48  # the label printer holds 48 characters per line and cuts off the rest
+
+
+def _ascii(text):
+    """Folds accents to plain ASCII (ü -> u). The printer prints anything else as garbage."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _wrap(text):
+    """Wraps `text` to the printer's line width. Wrapping, rather than cutting, keeps every allergen."""
+    return textwrap.wrap(_ascii(text), LINE_WIDTH) or [""]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, in route order.
+
+    Each label is the customer's name, then the quantity and product name, then the
+    allergens in capitals. `customers` is the dict load_customers returns. Returns a
+    list with the text of each label, lines joined by newlines.
+    """
+    quantities = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        quantities[key] = quantities.get(key, 0) + line.qty
+
+    labels = []
+    for code, product_code in sorted(quantities, key=lambda k: (customers[k[0]].route_seq, k[1])):
+        product = orderbook.catalog.get(product_code)
+        lines = _wrap(customers[code].name)
+        lines += _wrap(f"{quantities[(code, product_code)]} x {product.name}")
+        if product.allergens:
+            lines += _wrap("CONTAINS: " + product.allergen_text().upper())
+        labels.append("\n".join(lines))
+    return labels
