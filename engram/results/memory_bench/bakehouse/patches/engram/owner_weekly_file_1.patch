+class WeekTotalsFileTest(unittest.TestCase):
+    def write(self, book, week_start):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_semicolons_and_comma_decimals_for_german_excel(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "AIDAN", "CRO", 10),
+        ])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (GBP)\r\nAIDAN;11,00\r\nLUMEN;19,20\r\n")
+
+    def test_totals_add_up_across_the_seven_days(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "SOU", 4),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "CRO", 10),
+        ])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (GBP)\r\nLUMEN;43,00\r\n")
+
+    def test_week_is_the_seven_days_from_week_start(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY - datetime.timedelta(days=1), "AIDAN", "SOU", 1),
+            OrderLine(DAY, "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "AIDAN", "SOU", 1),
+        ])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (GBP)\r\nLUMEN;6,40\r\n")
+
+    def test_pence_are_two_digits(self):
+        book = OrderBook(Catalog([Product("PEN", "Penny bun", 5, 1)]), [OrderLine(DAY, "LUMEN", "PEN", 3)])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (GBP)\r\nLUMEN;0,15\r\n")
+
+    def test_customers_without_orders_that_week_are_absent(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "SOU", 6)])
+        self.assertEqual(self.write(book, DAY + datetime.timedelta(days=7)), "Customer;Total (GBP)\r\n")
+
+    def test_no_delivery_charge_or_vat_added(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "AIDAN", "SOU", 1)])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (GBP)\r\nAIDAN;3,20\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
