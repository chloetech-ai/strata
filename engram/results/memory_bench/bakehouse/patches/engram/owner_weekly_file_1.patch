+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order value in pounds, before VAT, for the seven days
+    starting at `week_start`. Customers with no orders that week get no row.
+
+    The file is for Greta's office PC, whose Excel is set to German: semicolon separators and a
+    comma as the decimal separator, e.g. `CODE;12,50`."""
+    week_end = week_start + datetime.timedelta(days=7)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day < week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (GBP)"])
+        for code in sorted(totals):
+            pounds, pence = divmod(totals[code], 100)
+            writer.writerow([code, f"{pounds},{pence:02d}"])
