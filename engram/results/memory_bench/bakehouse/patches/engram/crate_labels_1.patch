+"""Crate labels for packing."""
+
+import unicodedata
+
+# The label printer holds 48 characters per line and cuts off anything longer.
+LINE_WIDTH = 48
+
+
+def _printable(text):
+    """Folds accents to plain ASCII ('Café' -> 'Cafe'); the printer prints anything else as garbage."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _fit(text):
+    """One printer line: plain ASCII, cut to LINE_WIDTH characters."""
+    return _printable(text)[:LINE_WIDTH].rstrip()
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, as a list of label texts.
+
+    Each label is three lines: the customer's name, the quantity and product name,
+    and then the allergens in capitals if the product has any. `customers` is the
+    dict that load_customers returns.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        quantities = {}
+        for line in orderbook.lines_for(code, day):
+            quantities[line.product] = quantities.get(line.product, 0) + line.qty
+        for product_code in sorted(quantities):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                _fit(customers[code].name),
+                _fit(f"{quantities[product_code]} x {product.name}"),
+            ]
+            if product.allergens:
+                lines.append(_fit(f"ALLERGENS: {product.allergen_text().upper()}"))
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
