+def week_totals_file(orderbook, week_start, path):
+    """Write a semicolon-separated file with one row per customer: their order value for the seven
+    days starting at `week_start`, before VAT. Amounts use a comma as the decimal separator (e.g. 12,50)
+    for Greta's German-locale Excel. Customers with no orders that week are left out."""
+    end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (GBP)"])
+        for code in sorted(totals):
+            writer.writerow([code, _pounds_with_comma(totals[code])])
+
+
+def _pounds_with_comma(pence):
+    """Integer pence as pounds with a comma and two decimals: 1250 -> '12,50'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds},{rest:02d}"
