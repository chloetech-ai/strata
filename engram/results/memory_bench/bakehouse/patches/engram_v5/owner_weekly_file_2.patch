+class WeekTotalsFileTest(unittest.TestCase):
+    def write(self, book, week_start):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_one_row_per_customer_with_pounds_and_comma_decimals(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "AIDAN", "SOU", 4),
+            OrderLine(DAY, "AIDAN", "CRO", 48),
+        ])
+        self.assertEqual(
+            self.write(book, DAY),
+            "Customer;Total (GBP)\r\nAIDAN;" + format_text(4 * 320 + 48 * 110) + "\r\nLUMEN;" + format_text(6 * 320) + "\r\n",
+        )
+
+    def test_seven_days_from_week_start_inclusive(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 2),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 100),
+        ])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (GBP)\r\nLUMEN;9,60\r\n")
+
+    def test_fields_are_separated_by_semicolons(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "CRO", 24)])
+        rows = list(csv.reader(self.write(book, DAY).splitlines(), delimiter=";"))
+        self.assertEqual(rows, [["Customer", "Total (GBP)"], ["LUMEN", "26,40"]])
+
+    def test_no_orders_gives_only_the_header(self):
+        self.assertEqual(self.write(OrderBook(catalog()), DAY), "Customer;Total (GBP)\r\n")
+
+
+def format_text(pence):
+    return f"{pence // 100},{pence % 100:02d}"
+
+
 if __name__ == "__main__":
     unittest.main()
