+def bake_sheet(orderbook, day):
+    """One plain-text line per product baked on `day`, hottest oven first.
+
+    Each line gives the product name, units, batches and the dough to weigh out in whole grams.
+    Products with the same oven temperature keep their code order.
+    """
+    catalog = orderbook.catalog
+    bake = plan(orderbook, day)
+    codes = sorted(bake, key=lambda code: (-catalog.get(code).bake_temp, code))
+    width = max((len(catalog.get(code).name) for code in codes), default=0)
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = bake[code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<{width}}  {units:>4} units  {batches:>3} batches  {grams:>6} g")
+    return "\n".join(lines)
