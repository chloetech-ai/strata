+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180, 16), Product("BAG", "Baguette", 95, 12)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 5), 5 * 90)
+
+    def test_returns_at_the_cap_are_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 10), 10 * 90)
+
+    def test_returns_above_the_cap_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 25), 10 * 90)
+
+    def test_cap_rounds_down(self):
+        # 10% of 15 is 1.5, so only one loaf is credited
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 15, 3), 1 * 90)
+
+    def test_odd_price_halves_round_down(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 181, 16)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 100, 2), 2 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "AIDAN", "SWL", 100, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 100, 5), 0)
+
+    def test_returns_more_than_delivered_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 5, 6)
+
+    def test_negative_counts_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+
