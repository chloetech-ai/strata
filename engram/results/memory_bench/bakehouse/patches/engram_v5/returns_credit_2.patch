     return f"LK-{year}-{seq:04d}"
 
 
+RETURNS_CUSTOMER = "GREENWAY"  # the only customer on sale-or-return
+RETURNS_PRODUCT = "SWL"  # sandwich loaf, the only product on sale-or-return
+RETURNS_CAP_PERCENT = 10  # credited returns are capped at this share of loaves delivered
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` loaves from one delivery.
+
+    Only Greenway's sandwich loaves earn credit: half the wholesale price per loaf, for at most
+    10% of the loaves delivered that day (rounded down). Returns above the cap get no credit.
+    Half prices round down to whole pence.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} loaves of {delivered} delivered")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    half_price = catalog.get(product_code).price // 2
+    credited = min(returned, delivered * RETURNS_CAP_PERCENT // 100)
+    return credited * half_price
+
+
