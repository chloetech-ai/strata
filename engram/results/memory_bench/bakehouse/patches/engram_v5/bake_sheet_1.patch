         for code, units in sorted(totals.items())
     }
+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product to bake, hottest oven first."""
+    catalog = orderbook.catalog
+    items = [
+        (catalog.get(code), units, batches)
+        for code, (units, batches) in plan(orderbook, day).items()
+    ]
+    items.sort(key=lambda item: (-item[0].bake_temp, item[0].name))
+    lines = [f"Bake sheet for {day.isoformat()}"]
+    for product, units, batches in items:
+        lines.append(
+            f"{product.name}: {units} units, {batches} batches, "
+            f"{dough_weight_g(product, units)} g dough"
+        )
+    return "\n".join(lines)
