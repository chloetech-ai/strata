+class ExportInvoicesTest(unittest.TestCase):
+    def test_writes_header_then_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 3), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 4), [InvoiceLine("CRO", 48, 110)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 5)),
+        ]
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["Date", "Customer", "Total"],
+            ["03/10/2026", "LUMEN", "45.60"],
+            ["04/10/2026", "AIDAN", "52.80"],
+            ["05/10/2026", "GREENWAY", "0.00"],
+        ])
+
+    def test_negative_total_keeps_leading_minus_and_two_decimals(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 10, 3), [InvoiceLine("CRO", -1, 105)]), Invoice("LUMEN", datetime.date(2026, 10, 3), [InvoiceLine("CRO", -1, 5)])]
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows[1:], [["03/10/2026", "LUMEN", "-1.05"], ["03/10/2026", "LUMEN", "-0.05"]])
+
