+"""Crate labels for the packing room's thermal label printer."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48  # characters per line; the printer cuts off anything longer
+
+
+def _ascii(text):
+    """Plain ASCII, because the printer garbles accents: 'Café' becomes 'Cafe'."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """The text of each crate label for deliveries on `day`: one label per customer and product.
+
+    Each label is three or more lines: the customer's name, the quantity and the product name,
+    then the allergens in capitals (the law wants them emphasised and the printer cannot do bold).
+    `customers` is the dict that customers.load_customers returns.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        name = _ascii(customers[code].name)
+        quantities = {}
+        for line in orderbook.lines_for(code, day):
+            quantities[line.product] = quantities.get(line.product, 0) + line.qty
+        for product_code in sorted(quantities):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                name[:LINE_WIDTH],
+                _ascii(f"{quantities[product_code]} x {product.name}")[:LINE_WIDTH],
+            ]
+            if product.allergens:
+                # Wrapped rather than cut, so no allergen is lost off the end of the label.
+                lines += textwrap.wrap(_ascii(f"CONTAINS: {product.allergen_text().upper()}"), LINE_WIDTH)
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
new file mode 100644
index 0000000..ad659b3
