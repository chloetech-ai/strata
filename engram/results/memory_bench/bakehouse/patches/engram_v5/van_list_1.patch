+"""The van's delivery run."""
+
+import csv
+
+# Greenway Grocers opens at 7:00 and needs bread on its shelves before then, so it is always the first drop.
+GREENWAY_CODE = "GREENWAY"
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one row per customer with an order that day.
+
+    Uses the Stopwise import format: Stopwise refuses any other header, and it re-optimises the
+    route itself if the rows are not in driving order. Greenway comes first; the rest follow
+    in route_seq order.
+    """
+    drops = [customers[code] for code in orderbook.customers_for(day)]
+    drops.sort(key=lambda c: (c.code != GREENWAY_CODE, c.route_seq))
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for customer in drops:
+            writer.writerow([customer.name, customer.address, customer.postcode, ""])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
index 0000000..8dcf76b
--- /dev/null
+++ b/tests/test_delivery.py
@@ -0,0 +1,88 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def catalog():
+    return Catalog([Product("SOU", "White sourdough", 320, 10)])
+
+
+def customers():
+    people = [
+        Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        Customer("OLDMILL", "The Old Mill Tearoom", "Old Mill Yard", "LK3 1MY", 3),
+        Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+        Customer("AIDAN", "St Aidan's Primary School", "School Road", "LK4 9SA", 5),
+    ]
+    return {c.code: c for c in people}
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_header_is_the_stopwise_header(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "SOU", 6)])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(self.read()[0], ["Name", "Address", "Postcode", "Notes"])
+
+    def test_only_customers_with_orders_that_day_get_a_row(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "AIDAN", "SOU", 4),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(self.read()[1:], [["Café Lumen", "14 Mill Lane", "LK1 2AB", ""]])
+
+    def test_rows_follow_route_seq(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "AIDAN", "SOU", 4),
+            OrderLine(DAY, "HARBOUR", "SOU", 2),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual([row[0] for row in self.read()[1:]],
+                         ["Café Lumen", "Harbour Deli", "St Aidan's Primary School"])
+
+    def test_greenway_is_first_even_though_its_route_seq_is_later(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "GREENWAY", "SOU", 12),
+            OrderLine(DAY, "AIDAN", "SOU", 4),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual([row[0] for row in self.read()[1:]],
+                         ["Greenway Grocers", "Café Lumen", "St Aidan's Primary School"])
+
+    def test_fields_with_commas_are_quoted(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "POTTER", "SOU", 2)])
+        people = customers()
+        people["POTTER"] = Customer("POTTER", "Potter's Farm Shop", "Lower Farm, Ashby Road", "LK5 3PF", 6)
+        drops_file(book, people, DAY, self.path)
+        self.assertEqual(self.read()[1], ["Potter's Farm Shop", "Lower Farm, Ashby Road", "LK5 3PF", ""])
+
+    def test_empty_day_writes_only_the_header(self):
+        drops_file(OrderBook(catalog()), customers(), DAY, self.path)
+        self.assertEqual(self.read(), [["Name", "Address", "Postcode", "Notes"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
