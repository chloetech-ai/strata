diff --git a/src/bakehouse/pricing.py b/src/bakehouse/pricing.py
new file mode 100644
index 0000000..3e2f4f6
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,20 @@
+"""Wholesale price changes."""
+
+RISE_PERCENT = 5  # January wholesale price rise
+ROUND_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """Maps each product code to its new wholesale price in pence.
+
+    Each price rises by RISE_PERCENT and is rounded up to the next 5p, so
+    1250p * 1.05 = 1312.5p becomes 1315p, and 320p * 1.05 = 336p becomes 340p.
+    Integer arithmetic only, so no float rounding error.
+    """
+    prices = {}
+    for product in catalog:
+        # ceil(price * (100 + RISE_PERCENT) / 100 / ROUND_TO) * ROUND_TO, in integers
+        raw = product.price * (100 + RISE_PERCENT)
+        step = 100 * ROUND_TO
+        prices[product.code] = -(-raw // step) * ROUND_TO
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..ad0bbb2
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,30 @@
+import unittest
+
+from bakehouse.products import Catalog, Product
+from bakehouse.pricing import new_prices
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        self.assertEqual(new_prices(catalog), {"SOU": 340})  # 336 -> 340
+
+    def test_exact_multiple_of_5p_is_not_rounded_further(self):
+        catalog = Catalog([Product("BAG", "Baguette", 100)])
+        self.assertEqual(new_prices(catalog), {"BAG": 105})  # 105 exactly
+
+    def test_rounds_up_not_to_nearest(self):
+        catalog = Catalog([Product("BKW", "Bakewell slice", 1250)])
+        self.assertEqual(new_prices(catalog), {"BKW": 1315})  # 1312.5 -> 1315
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FRE", "Free sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FRE": 0})
+
+    def test_every_product_is_included(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("BAG", "Baguette", 85)])
+        self.assertEqual(set(new_prices(catalog)), {"SOU", "BAG"})
+
+
+if __name__ == "__main__":
+    unittest.main()
