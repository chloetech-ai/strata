+
+    def test_order_of_exactly_40_pounds_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+
+    def test_order_over_40_pounds_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4001), 0)
+
+    def test_no_order_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 0), 0)
+
+    def test_st_aidans_is_exempt(self):
+        self.assertEqual(delivery_charge("AIDAN", 3999), 0)
