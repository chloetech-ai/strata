@@ -42,6 +42,18 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, from November
+DELIVERY_CHARGE_BELOW = 4000  # pence: orders worth less than this (before VAT) pay the charge
+DELIVERY_CHARGE_EXEMPT = ("AIDAN",)  # contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day, `subtotal` being its value in pence before VAT."""
+    if customer_code in DELIVERY_CHARGE_EXEMPT or not 0 < subtotal < DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
