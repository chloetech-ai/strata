@@ -42,6 +42,28 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+RETURNS_CUSTOMER = "GREENWAY"  # the only customer on sale-or-return
+RETURNS_PRODUCT = "SWL"  # sandwich loaf, the only product that is returnable
+RETURNS_CAP_PERCENT = 10  # credited returns may not exceed this share of the day's delivered loaves
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold loaves from one delivery of `delivered` loaves.
+
+    Only Greenway's sandwich loaves earn credit: half the wholesale price per loaf (rounded down
+    to whole pence), for at most 10% of the loaves delivered. Returns above that get no credit.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} loaves from a delivery of {delivered}")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    cap = delivered * RETURNS_CAP_PERCENT // 100
+    credited = min(returned, cap)
+    return credited * (catalog.get(product_code).price // 2)
+
+
