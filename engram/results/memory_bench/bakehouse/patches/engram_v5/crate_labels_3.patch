@@ -0,0 +1,96 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Lumen Café", "1 High St", "AB1 2CD", 1),
+        "AIDAN": Customer("AIDAN", "St Aidan's", "2 Mill Lane", "AB3 4EF", 2),
+    }
+
+
+def catalog():
+    return Catalog([
+        Product("SOU", "White sourdough", 320, 10, allergens=("wheat",)),
+        Product("CRO", "Croissant", 110, 24, allergens=("milk", "wheat", "eggs")),
+        Product("BAG", "Plain bagel", 90, 6),
+    ])
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "AIDAN", "BAG", 12),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "St Aidan's\n12 x Plain bagel",
+            "Lumen Cafe\n24 x Croissant\nEGGS, MILK, WHEAT",
+            "Lumen Cafe\n6 x White sourdough\nWHEAT",
+        ])
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 4),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Lumen Cafe\n10 x White sourdough\nWHEAT"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "AIDAN", "BAG", 12),
+        ])
+        self.assertEqual(len(crate_labels(book, customers(), DAY)), 1)
+
+    def test_no_labels_for_a_day_without_orders(self):
+        self.assertEqual(crate_labels(OrderBook(catalog()), customers(), DAY), [])
+
+    def test_no_allergen_line_when_product_has_none(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "AIDAN", "BAG", 12)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["St Aidan's\n12 x Plain bagel"])
+
+    def test_text_is_plain_ascii(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "CRO", 2)])
+        (label,) = crate_labels(book, customers(), DAY)
+        self.assertEqual(label, "Lumen Cafe\n2 x Croissant\nEGGS, MILK, WHEAT")
+        label.encode("ascii")
+
+    def test_umlauts_are_made_plain(self):
+        cust = {"GRN": Customer("GRN", "Grünwald Bäckerei", "3 Weg", "AB5 6GH", 1)}
+        book = OrderBook(catalog(), [OrderLine(DAY, "GRN", "BAG", 6)])
+        self.assertEqual(crate_labels(book, cust, DAY), ["Grunwald Backerei\n6 x Plain bagel"])
+
+    def test_lines_fit_the_printer_width(self):
+        long_name = "Potter's Farm Shop and Very Long Name Indeed Ltd Trading As Something"
+        cust = {"POT": Customer("POT", long_name, "4 Lane", "AB7 8IJ", 1)}
+        book = OrderBook(catalog(), [OrderLine(DAY, "POT", "CRO", 24)])
+        (label,) = crate_labels(book, cust, DAY)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertEqual(label.split("\n")[0], long_name[:LINE_WIDTH])
+
+    def test_long_allergen_list_wraps_instead_of_being_cut(self):
+        many = tuple(f"allergen{i:02d}" for i in range(12))
+        cat = Catalog([Product("BIG", "Big loaf", 300, 1, allergens=many)])
+        book = OrderBook(cat, [OrderLine(DAY, "LUMEN", "BIG", 1)])
+        label = crate_labels(book, customers(), DAY)[0]
+        lines = label.split("\n")
+        self.assertGreater(len(lines), 3)
+        for line in lines:
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        allergen_text = " ".join(lines[2:])
+        for name in many:
+            self.assertIn(name.upper(), allergen_text)
+
+
+if __name__ == "__main__":
+    unittest.main()
