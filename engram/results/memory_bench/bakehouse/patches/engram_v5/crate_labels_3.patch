+"""Labels for the crates we pack for delivery."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48  # the packing room's label printer prints this many characters a line
+
+
+def _ascii(text):
+    """Plain ASCII: accents are dropped (u-umlaut becomes u), since the printer garbles anything else."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as a list of strings.
+
+    Each label is three lines: the customer's name, the quantity and product name, then the
+    allergens in capitals (omitted if the product has none). Lines are at most LINE_WIDTH characters;
+    a long allergen list wraps onto more lines rather than being cut off.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code in sorted(totals):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                _ascii(customers[code].name)[:LINE_WIDTH],
+                _ascii(f"{totals[product_code]} x {product.name}")[:LINE_WIDTH],
+            ]
+            if product.allergens:
+                lines.extend(textwrap.wrap(_ascii(product.allergen_text().upper()), LINE_WIDTH))
+            labels.append("\n".join(lines))
+    return labels
