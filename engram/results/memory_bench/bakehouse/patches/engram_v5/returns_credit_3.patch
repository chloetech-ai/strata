index deca720..d58e5eb 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -42,6 +42,24 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+RETURNS_CUSTOMER = "GREENWAY"  # sale-or-return terms apply to this customer only
+RETURNS_PRODUCT = "SWL"  # sandwich loaf, the only product on sale-or-return
+RETURNS_CAP_PERCENT = 10  # credited returns may not exceed this share of loaves delivered that day
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for one delivery's unsold loaves: half the wholesale price per loaf, up to 10% of loaves delivered.
+
+    Returns above the cap get no credit. Only Greenway's sandwich loaves earn any credit.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    credited = min(returned, delivered * RETURNS_CAP_PERCENT // 100)
+    return credited * catalog.get(product_code).price // 2
+
+
