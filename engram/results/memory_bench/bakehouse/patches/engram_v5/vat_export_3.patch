+def _pounds_text(pence):
+    """Plain pounds for a CSV: 1250 -> '12.50', -300 -> '-3.00'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write invoices to a CSV file for the VAT return: one row per invoice with its date, customer code and total.
+
+    Plain comma-separated with a header row, dates as DD/MM/YYYY and totals in pounds to two decimals,
+    as Ledgerly imports them. Pass only the invoices for the quarter being exported.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds_text(invoice.total())])
+
+
