+class ExportInvoicesTest(unittest.TestCase):
+    def read_csv(self, invoices):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return list(csv.reader(f))
+
+    def test_header_then_one_row_per_invoice(self):
+        rows = self.read_csv([
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 21), [InvoiceLine("CRO", 48, 110)]),
+        ])
+        self.assertEqual(rows, [
+            ["Date", "Customer", "Total"],
+            ["20/10/2026", "LUMEN", "45.60"],
+            ["21/10/2026", "AIDAN", "52.80"],
+        ])
+
+    def test_total_is_pounds_with_two_decimals(self):
+        rows = self.read_csv([Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 1, 1250)])])
+        self.assertEqual(rows[1][2], "12.50")
+
+    def test_small_and_negative_totals(self):
+        rows = self.read_csv([
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 1, 5)]),
+            Invoice("LUMEN", datetime.date(2026, 10, 21), [InvoiceLine("CRO", -1, 300)]),
+        ])
+        self.assertEqual(rows[1][2], "0.05")
+        self.assertEqual(rows[2][2], "-3.00")
+
+    def test_no_invoices_writes_only_the_header(self):
+        self.assertEqual(self.read_csv([]), [["Date", "Customer", "Total"]])
+
+
 if __name__ == "__main__":
     unittest.main()
