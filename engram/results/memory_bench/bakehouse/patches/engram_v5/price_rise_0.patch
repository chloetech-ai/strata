@@ -0,0 +1,33 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        self.assertEqual(new_prices(catalog), {"SOU": 340})  # 336 -> 340, never 335
+
+    def test_exact_multiple_of_5p_is_unchanged_by_rounding(self):
+        catalog = Catalog([Product("BAG", "Bagel", 300)])
+        self.assertEqual(new_prices(catalog), {"BAG": 315})  # 315 exactly
+
+    def test_fractional_pence_round_up_before_5p_rounding(self):
+        catalog = Catalog([Product("ROL", "Roll", 150)])
+        self.assertEqual(new_prices(catalog), {"ROL": 160})  # 157.5 -> 158 -> 160
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_returns_every_product_keyed_by_code(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("ROL", "Roll", 150)])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "ROL": 160})
+
+    def test_empty_catalog(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
