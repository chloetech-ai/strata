+"""Price changes for the wholesale catalog."""
+
+RISE_PERCENT = 5  # January wholesale price rise
+ROUND_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """Each product's January wholesale price in pence: up 5%, rounded UP to the next 5p.
+
+    Returns a dict mapping product code to new price. Rounding is always upwards,
+    so e.g. 320 -> 336 -> 340 and 300 -> 315 -> 315.
+    """
+    prices = {}
+    for product in catalog:
+        raised = -(-product.price * (100 + RISE_PERCENT) // 100)  # ceiling division, stays integer pence
+        prices[product.code] = -(-raised // ROUND_TO) * ROUND_TO
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
