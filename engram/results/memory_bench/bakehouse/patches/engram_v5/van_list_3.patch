+"""The van's delivery run."""
+
+import csv
+
+# Greenway opens at 7:00 and needs bread on the shelves before then, so it is always the first drop.
+FIRST_DROP = "GREENWAY"
+
+
+def drops_file(orderbook, customers, day, path):
+    """Write the van's drops for `day` to `path`, in the Stopwise import format.
+
+    Only customers with orders for `day` appear. Greenway comes first; the rest follow route_seq.
+    """
+    codes = orderbook.customers_for(day)
+    drops = sorted((customers[code] for code in codes), key=lambda c: (c.code != FIRST_DROP, c.route_seq))
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for customer in drops:
+            writer.writerow([customer.name, customer.address, customer.postcode, ""])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
