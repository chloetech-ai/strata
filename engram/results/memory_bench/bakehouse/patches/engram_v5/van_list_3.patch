@@ -0,0 +1,78 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def catalog():
+    return Catalog([Product("SOU", "White sourdough", 320, 10)])
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+        "POTTER": Customer("POTTER", "Potter's Farm Shop", "Lower Farm, Ashby Road", "LK5 3PF", 6),
+    }
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_header_and_one_row_per_drop(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "SOU", 6)])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(self.read(), [
+            ["Name", "Address", "Postcode", "Notes"],
+            ["Café Lumen", "14 Mill Lane", "LK1 2AB", ""],
+        ])
+
+    def test_only_customers_with_orders_that_day(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "POTTER", "SOU", 6),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual([row[0] for row in self.read()[1:]], ["Café Lumen"])
+
+    def test_greenway_is_first_even_though_its_route_seq_is_later(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "HARBOUR", "SOU", 6),
+            OrderLine(DAY, "GREENWAY", "SOU", 6),
+            OrderLine(DAY, "POTTER", "SOU", 6),
+        ])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual([row[0] for row in self.read()[1:]],
+                         ["Greenway Grocers", "Café Lumen", "Harbour Deli", "Potter's Farm Shop"])
+
+    def test_fields_with_commas_are_quoted(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "POTTER", "SOU", 6)])
+        drops_file(book, customers(), DAY, self.path)
+        self.assertEqual(self.read()[1], ["Potter's Farm Shop", "Lower Farm, Ashby Road", "LK5 3PF", ""])
+
+    def test_day_with_no_orders_writes_only_the_header(self):
+        drops_file(OrderBook(catalog()), customers(), DAY, self.path)
+        self.assertEqual(self.read(), [["Name", "Address", "Postcode", "Notes"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
