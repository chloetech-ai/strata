+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`, one line per product, hottest oven first.
+
+    The deck oven only cools down overnight, so the hottest bakes go first.
+    """
+    catalog = orderbook.catalog
+    bakes = plan(orderbook, day)
+    products = sorted(
+        (catalog.get(code) for code in bakes),
+        key=lambda p: (-p.bake_temp, p.code),
+    )
+    lines = []
+    for product in products:
+        units, batches = bakes[product.code]
+        lines.append(
+            f"{product.name}: {units} units, {batches} batches, "
+            f"{dough_weight_g(product, units)} g dough"
+        )
+    return "\n".join(lines)
