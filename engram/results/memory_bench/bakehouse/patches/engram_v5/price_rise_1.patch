index 0000000..2bf71b3
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,20 @@
+"""Wholesale price changes."""
+
+# January rise: 5%, and each new price is rounded UP to the next 5p so the
+# cafés' price boards never show odd pennies.
+RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Map each product code to its new wholesale price in integer pence.
+
+    The price goes up by RISE_PERCENT and is rounded up to a multiple of
+    ROUND_TO_PENCE. Integer arithmetic only, so no float rounding errors.
+    """
+    prices = {}
+    for product in catalog:
+        # Smallest multiple of ROUND_TO_PENCE that is >= price * (100 + RISE_PERCENT) / 100.
+        steps = -(-product.price * (100 + RISE_PERCENT) // (100 * ROUND_TO_PENCE))
+        prices[product.code] = steps * ROUND_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..4e531db
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,35 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320 * 1.05 = 336 -> next 5p is 340
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_is_not_bumped_up(self):
+        catalog = Catalog([Product("BAG", "Bagel", 200)])
+        # 200 * 1.05 = 210 exactly
+        self.assertEqual(new_prices(catalog), {"BAG": 210})
+
+    def test_maps_every_product_code(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),
+            Product("ROL", "Roll", 45),
+        ])
+        # 45 * 1.05 = 47.25 -> 50
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "ROL": 50})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
