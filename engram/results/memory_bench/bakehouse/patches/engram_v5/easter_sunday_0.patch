+"""Seasonal dates, for planning when the seasonal lines are baked and sold."""
+
+import datetime
+
+FIRST_YEAR = 1900
+LAST_YEAR = 2199
+
+
+def easter_sunday(year):
+    """Easter Sunday in the Western church, Gregorian calendar, for 1900 to 2199 inclusive."""
+    if not FIRST_YEAR <= year <= LAST_YEAR:
+        raise ValueError("year must be from %d to %d, not %d" % (FIRST_YEAR, LAST_YEAR, year))
+    # Anonymous Gregorian algorithm (Meeus/Jones/Butcher)
+    a = year % 19
+    b = year // 100
+    c = year % 100
+    d = b // 4
+    e = b % 4
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i = c // 4
+    k = c % 4
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month = (h + l - 7 * m + 114) // 31
+    day = (h + l - 7 * m + 114) % 31 + 1
+    return datetime.date(year, month, day)
diff --git a/tests/test_seasons.py b/tests/test_seasons.py
new file mode 100644
index 0000000..f5a3647
--- /dev/null
+++ b/tests/test_seasons.py
@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from bakehouse.seasons import easter_sunday
+
+
+class EasterSundayTest(unittest.TestCase):
+    def test_known_dates(self):
+        cases = {
+            1900: datetime.date(1900, 4, 15),
+            1961: datetime.date(1961, 4, 2),
+            1981: datetime.date(1981, 4, 19),
+            2000: datetime.date(2000, 4, 23),
+            2008: datetime.date(2008, 3, 23),
+            2019: datetime.date(2019, 4, 21),
+            2024: datetime.date(2024, 3, 31),
+            2025: datetime.date(2025, 4, 20),
+        }
+        for year, easter in cases.items():
+            with self.subTest(year=year):
+                self.assertEqual(easter_sunday(year), easter)
+
+    def test_earliest_and_latest_possible_dates(self):
+        # Easter can fall no earlier than 22 March and no later than 25 April.
+        for year in range(1900, 2200):
+            easter = easter_sunday(year)
+            self.assertIn(easter.month, (3, 4))
+            self.assertTrue(datetime.date(year, 3, 22) <= easter <= datetime.date(year, 4, 25))
+
+    def test_always_a_sunday(self):
+        for year in range(1900, 2200):
+            self.assertEqual(easter_sunday(year).weekday(), 6, year)
+
+    def test_returns_a_date(self):
+        self.assertIsInstance(easter_sunday(2026), datetime.date)
+
+    def test_years_outside_range_are_rejected(self):
+        with self.assertRaises(ValueError):
+            easter_sunday(1899)
+        with self.assertRaises(ValueError):
+            easter_sunday(2200)
+
+
+if __name__ == "__main__":
+    unittest.main()
