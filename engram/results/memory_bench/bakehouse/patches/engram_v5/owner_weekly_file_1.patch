+class WeekTotalsFileTest(unittest.TestCase):
+    def write(self, book, week_start):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                return list(csv.reader(f, delimiter=";"))
+
+    def test_header_and_one_row_per_customer_in_pounds(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "AIDAN", "CRO", 48),
+        ])
+        self.assertEqual(self.write(book, DAY), [
+            ["Customer", "Total (£)"],
+            ["AIDAN", "52,80"],
+            ["LUMEN", "19,20"],
+        ])
+
+    def test_adds_up_across_the_seven_days(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 1),
+        ])
+        self.assertEqual(self.write(book, DAY)[1:], [["LUMEN", "22,40"]])
+
+    def test_days_outside_the_week_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=7), "AIDAN", "SOU", 6),
+        ])
+        self.assertEqual(self.write(book, DAY), [["Customer", "Total (£)"]])
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "CRO", 1)])
+        self.assertEqual(self.write(book, DAY)[1:], [["LUMEN", "1,10"]])
+
+
 if __name__ == "__main__":
     unittest.main()
