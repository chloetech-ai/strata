     return f"LK-{year}-{seq:04d}"
 
 
+def export_invoices(invoices, path):
+    """Write one row per invoice for Ledgerly: date as DD/MM/YYYY, customer code, total in pounds like 12.50 (no £ sign)."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, rest = divmod(abs(total), 100)
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, f"{sign}{pounds}.{rest:02d}"])
+
+
