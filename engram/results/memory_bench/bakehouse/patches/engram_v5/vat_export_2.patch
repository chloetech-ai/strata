+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_with_ledgerly_format(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 3), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 4), [InvoiceLine("CRO", 5, 110)]),
+        ]
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                text = f.read()
+        self.assertEqual(text, "Date,Customer,Total\r\n03/10/2026,LUMEN,45.60\r\n04/10/2026,AIDAN,5.50\r\n")
+
+    def test_negative_credit_note_and_pence_padding(self):
+        invoices = [Invoice("GREENWAY", datetime.date(2026, 12, 31), [InvoiceLine("SAN", -1, 605)]),
+                    Invoice("LUMEN", datetime.date(2026, 12, 31), [InvoiceLine("CRO", 1, 5)])]
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = f.read().splitlines()
+        self.assertEqual(rows[1:], ["31/12/2026,GREENWAY,-6.05", "31/12/2026,LUMEN,0.05"])
+
+    def test_no_invoices_writes_only_header(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "invoices.csv")
+            export_invoices([], path)
+            with open(path, newline="", encoding="utf-8") as f:
+                self.assertEqual(f.read(), "Date,Customer,Total\r\n")
+
+
