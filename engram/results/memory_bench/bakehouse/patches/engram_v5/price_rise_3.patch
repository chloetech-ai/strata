+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,20 @@
+"""Wholesale price changes."""
+
+# January rise: 5% on the current price, then rounded up to the next 5p.
+JANUARY_RISE_PERCENT = 5
+ROUND_UP_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Map each product code to its new wholesale price in integer pence.
+
+    The price goes up by JANUARY_RISE_PERCENT and is rounded up (never down)
+    to a multiple of ROUND_UP_TO_PENCE, so 320 becomes 340 and 300 becomes 315.
+    """
+    prices = {}
+    for product in catalog:
+        # Work in whole numbers: price * (100 + rise) / 100, then ceiling to the next 5p.
+        raised = product.price * (100 + JANUARY_RISE_PERCENT)
+        step = 100 * ROUND_UP_TO_PENCE
+        prices[product.code] = -(-raised // step) * ROUND_UP_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..6e4b1e7
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,40 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_and_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320 * 1.05 = 336 pence, rounded up to 340
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_is_not_bumped_again(self):
+        catalog = Catalog([Product("BAG", "Bagel", 300)])
+        # 300 * 1.05 = 315 pence, already a multiple of 5
+        self.assertEqual(new_prices(catalog), {"BAG": 315})
+
+    def test_rounds_up_never_down(self):
+        catalog = Catalog([Product("BUN", "Bun", 100)])
+        # 100 * 1.05 = 105 pence
+        self.assertEqual(new_prices(catalog), {"BUN": 105})
+        catalog = Catalog([Product("ROL", "Roll", 99)])
+        # 99 * 1.05 = 103.95, rounded up to 105
+        self.assertEqual(new_prices(catalog), {"ROL": 105})
+
+    def test_covers_every_product_and_returns_ints(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),
+            Product("BAG", "Bagel", 85),
+        ])
+        prices = new_prices(catalog)
+        self.assertEqual(set(prices), {"SOU", "BAG"})
+        for price in prices.values():
+            self.assertIsInstance(price, int)
+        # 85 * 1.05 = 89.25, rounded up to 90
+        self.assertEqual(prices["BAG"], 90)
+
+
+if __name__ == "__main__":
+    unittest.main()
