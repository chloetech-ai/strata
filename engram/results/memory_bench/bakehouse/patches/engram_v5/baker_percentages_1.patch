+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 500, "Water": 350, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 50.0, "Wholemeal flour": 50.0, "Water": 35.0, "Salt": 1.0},
+        )
+
+    def test_rounds_to_one_decimal(self):
+        self.assertEqual(baker_percentages({"Flour": 300, "Salt": 7})["Salt"], 2.3)
+
+    def test_flour_match_ignores_case(self):
+        self.assertEqual(baker_percentages({"FLOUR": 200, "water": 100}), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
