+"""Recipes: ingredient weights as baker's percentages of the flour."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: percent of total flour weight, rounded to one decimal place}.
+
+    Any ingredient whose name contains 'flour' (any case) counts as flour.
+    """
+    flour_g = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_g <= 0:
+        raise ValueError("recipe has no flour")
+    return {name: round(grams * 100 / flour_g, 1) for name, grams in recipe.items()}
