@@ -42,6 +42,26 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+RETURNS_CUSTOMER = "GREENWAY"  # the only customer on sale-or-return
+SANDWICH_LOAF = "SWL"  # the only product that is taken back
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` loaves from one delivery of `delivered` loaves.
+
+    Only Greenway Grocers' sandwich loaves earn credit: half the wholesale price per loaf,
+    for at most 10% of the loaves delivered (rounded down). Returns above that get nothing.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError("delivered and returned must not be negative")
+    if returned > delivered:
+        raise ValueError(f"returned ({returned}) is more than delivered ({delivered})")
+    if customer_code != RETURNS_CUSTOMER or product_code != SANDWICH_LOAF:
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * catalog.get(product_code).price // 2
+
+
