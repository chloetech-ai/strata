+"""Crate labels for packing. Text is plain ASCII, one line at most 48 characters, for the thermal label printer."""
+
+import unicodedata
+
+LINE_WIDTH = 48  # the printer cuts off anything longer
+
+
+def _printable(text):
+    """Fold accents to plain ASCII and shorten to the line width."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return ascii_text[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """Label text for each customer and product ordered for delivery on `day`, one label each.
+
+    `customers` is the dict from load_customers. Each label is three lines:
+    the customer's name, the quantity and product name, and the allergens in capitals.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        qtys = {}
+        for line in orderbook.lines_for(code, day):
+            qtys[line.product] = qtys.get(line.product, 0) + line.qty
+        for product_code in sorted(qtys):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                customers[code].name,
+                f"{qtys[product_code]} x {product.name}",
+            ]
+            if product.allergens:
+                lines.append("Allergens: " + product.allergen_text().upper())
+            labels.append("\n".join(_printable(line) for line in lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
