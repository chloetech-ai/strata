@@ -0,0 +1,67 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SOU", "White sourdough", 320, 10, 800, 240, ("wheat",)),
+            Product("CRO", "Croissant", 110, 24, 60, 220, ("wheat", "milk")),
+            Product("PLN", "Plain roll", 60, 12, 40, 230),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "AIDAN": Customer("AIDAN", "St Aidan's", "1 Church Rd", "LK3 1AA", 2),
+        }
+
+    def test_one_label_per_customer_and_product(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "AIDAN", "CRO", 48),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "St Aidan's\n48 x Croissant\nAllergens: MILK, WHEAT",
+            "Cafe Lumen\n24 x Croissant\nAllergens: MILK, WHEAT",
+            "Cafe Lumen\n6 x White sourdough\nAllergens: WHEAT",
+        ])
+
+    def test_quantities_for_same_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 4),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n10 x White sourdough\nAllergens: WHEAT",
+        ])
+
+    def test_product_without_allergens_has_no_allergen_line(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "AIDAN", "PLN", 12)])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["St Aidan's\n12 x Plain roll"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 6),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_text_is_ascii_and_lines_fit_the_printer(self):
+        long_name = "Ångström Bäkery & Tea Rooms of the Very Long Name Indeed"
+        customers = {"LUMEN": Customer("LUMEN", long_name, "", "", 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "CRO", 24)])
+        (label,) = crate_labels(book, customers, DAY)
+        label.encode("ascii")  # raises if anything is not plain ASCII
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertEqual(label.split("\n")[0], "Angstrom Bakery & Tea Rooms of the Very Long Nam")
+
+
+if __name__ == "__main__":
+    unittest.main()
