+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong White Flour": 500, "Water": 350, "Salt": 10, "Yeast": 2}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong White Flour": 100.0, "Water": 70.0, "Salt": 2.0, "Yeast": 0.4},
+        )
+
+    def test_all_flours_count_as_flour_in_any_case(self):
+        recipe = {"Rye FLOUR": 200, "white flour": 300, "Water": 400}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Rye FLOUR": 40.0, "white flour": 60.0, "Water": 80.0},
+        )
+
+    def test_rounds_to_one_decimal(self):
+        recipe = {"Flour": 300, "Starter": 1}
+        self.assertEqual(baker_percentages(recipe)["Starter"], 0.3)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
