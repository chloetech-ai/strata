+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong White Flour": 500, "Wholemeal Flour": 100, "Water": 350, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong White Flour": 83.3, "Wholemeal Flour": 16.7, "Water": 58.3, "Salt": 1.7},
+        )
+
+    def test_flour_match_ignores_case(self):
+        self.assertEqual(
+            baker_percentages({"FLOUR": 200, "water": 100}),
+            {"FLOUR": 100.0, "water": 50.0},
+        )
+
+    def test_rounds_to_one_decimal(self):
+        self.assertEqual(baker_percentages({"flour": 3, "water": 1}), {"flour": 100.0, "water": 33.3})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"water": 350, "salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"flour": 0, "water": 350})
