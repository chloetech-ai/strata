@@ -42,6 +42,20 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+# Delivery charge from November: £4.50 on a day's order under £40.00 (before VAT).
+# St Aidan's contract price already includes delivery, so it never pays it.
+DELIVERY_CHARGE = 450
+DELIVERY_CHARGE_BELOW = 4000
+DELIVERY_EXEMPT = ("AIDAN",)
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day; `subtotal` is that order's value in pence, before VAT."""
+    if customer_code in DELIVERY_EXEMPT or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
