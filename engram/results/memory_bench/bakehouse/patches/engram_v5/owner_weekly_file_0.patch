+class WeekTotalsFileTest(unittest.TestCase):
+    def write(self, book, week_start):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                return f.read()
+
+    def test_one_row_per_customer_in_pounds_with_comma_decimal(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "AIDAN", "SOU", 4),
+            OrderLine(DAY, "AIDAN", "CRO", 25),
+        ])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (£)\r\nAIDAN;40,30\r\nLUMEN;19,20\r\n")
+
+    def test_sums_every_day_of_the_week_and_leaves_out_the_next_week(self):
+        monday = DAY - datetime.timedelta(days=DAY.weekday())
+        book = OrderBook(catalog(), [
+            OrderLine(monday, "LUMEN", "SOU", 1),
+            OrderLine(monday + datetime.timedelta(days=6), "LUMEN", "SOU", 1),
+            OrderLine(monday + datetime.timedelta(days=7), "LUMEN", "SOU", 100),
+            OrderLine(monday - datetime.timedelta(days=1), "LUMEN", "SOU", 100),
+        ])
+        self.assertEqual(self.write(book, monday), "Customer;Total (£)\r\nLUMEN;6,40\r\n")
+
+    def test_pence_are_padded_to_two_decimals(self):
+        book = OrderBook(Catalog([Product("BUN", "Bun", 105, 1)]), [OrderLine(DAY, "LUMEN", "BUN", 1)])
+        self.assertEqual(self.write(book, DAY), "Customer;Total (£)\r\nLUMEN;1,05\r\n")
+
+    def test_no_orders_gives_only_the_header(self):
+        self.assertEqual(self.write(OrderBook(catalog()), DAY), "Customer;Total (£)\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
