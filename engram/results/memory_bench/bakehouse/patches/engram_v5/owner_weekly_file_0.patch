+def week_totals_file(orderbook, week_start, path):
+    """Writes one row per customer with their order value in pounds, before VAT, for the seven
+    days starting at `week_start`, sorted by customer code.
+
+    Semicolon-separated with a comma decimal separator, so Greta's German-locale Excel puts
+    each value in its own column. UTF-8 with a byte-order mark so Excel reads the £ sign."""
+    totals = {}
+    for offset in range(7):
+        day = week_start + datetime.timedelta(days=offset)
+        for customer, pence in day_summary(orderbook, day).items():
+            totals[customer] = totals.get(customer, 0) + pence
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (£)"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds},{pence:02d}"])
