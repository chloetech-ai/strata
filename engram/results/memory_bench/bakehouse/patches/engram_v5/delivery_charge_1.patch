index deca720..cd22144 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -42,6 +42,22 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, added to an order under DELIVERY_CHARGE_BELOW
+DELIVERY_CHARGE_BELOW = 4000  # pence, before VAT
+DELIVERY_CHARGE_EXEMPT = ("AIDAN",)  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day.
+
+    `subtotal` is the order value in pence before VAT. Orders under DELIVERY_CHARGE_BELOW
+    pay DELIVERY_CHARGE; an empty order and exempt customers pay nothing.
+    """
+    if customer_code in DELIVERY_CHARGE_EXEMPT or subtotal <= 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_CHARGE_BELOW else 0
+
+
