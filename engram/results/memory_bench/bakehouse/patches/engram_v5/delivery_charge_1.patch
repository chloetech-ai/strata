+class DeliveryChargeTest(unittest.TestCase):
+    def test_order_under_40_pounds_pays_4_50(self):
+        self.assertEqual(delivery_charge("LUMEN", 1), 450)
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)
+
+    def test_order_of_exactly_40_pounds_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+
+    def test_order_over_40_pounds_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4001), 0)
+        self.assertEqual(delivery_charge("LUMEN", 12345), 0)
+
+    def test_st_aidans_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 1000), 0)
+        self.assertEqual(delivery_charge("AIDAN", 9000), 0)
+
+    def test_empty_order_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 0), 0)
