@@ -0,0 +1,13 @@
+"""Recipes: ingredient weights expressed relative to the flour."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: percentage of total flour weight}, rounded to one decimal.
+
+    `recipe` maps ingredient names to grams. Any ingredient whose name contains
+    'flour' (any case) counts as flour.
+    """
+    flour_g = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_g <= 0:
+        raise ValueError("recipe has no flour to base the percentages on")
+    return {name: round(100 * grams / flour_g, 1) for name, grams in recipe.items()}
