+    def test_bake_sheet_lists_hottest_oven_first(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, dough_g=300, bake_temp=230),
+            Product("SOU", "White sourdough", 320, batch_size=10, dough_g=800, bake_temp=250),
