+
+
+def bake_sheet(orderbook, day):
+    """One line per product to bake on `day`, hottest oven first, as text.
+
+    Each line gives the product name, units, batches and the dough to weigh out in grams.
+    """
+    catalog = orderbook.catalog
+    lines = []
+    for code, (units, batches) in plan(orderbook, day).items():
+        product = catalog.get(code)
+        lines.append((product, units, batches))
+    lines.sort(key=lambda item: (-item[0].bake_temp, item[0].code))
+    return "\n".join(
+        f"{product.name}: {units} units, {batches} batches, {dough_weight_g(product, units)} g dough"
+        for product, units, batches in lines
+    )
