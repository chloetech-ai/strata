+"""The van's run: which customers to visit on a delivery day, and in what order."""
+
+import csv
+
+
+def drops_for(orderbook, customers, day):
+    """Customers with orders on `day`, in the order the van visits them.
+
+    Greenway Grocers opens at 7:00 and needs bread before then, so it always
+    goes first; everyone else follows in route_seq order.
+    """
+    codes = orderbook.customers_for(day)
+    return sorted(
+        (customers[code] for code in codes),
+        key=lambda c: (c.code != "GREENWAY", c.route_seq),
+    )
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path` as CSV, one row per drop in run order."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["code", "name", "address", "postcode"])
+        for customer in drops_for(orderbook, customers, day):
+            writer.writerow([customer.code, customer.name, customer.address, customer.postcode])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
