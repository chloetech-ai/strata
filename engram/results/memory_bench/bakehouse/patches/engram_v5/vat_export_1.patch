+
+def _pounds(pence):
+    """Plain pounds for the Ledgerly CSV: 1250 -> '12.50', -300 -> '-3.00'. No currency sign, no pence-only form."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write invoices to a CSV file for the VAT return, one row per invoice: date, customer code, total.
+
+    Ledgerly imports plain comma-separated files with a header row, dates as DD/MM/YYYY
+    and amounts in pounds with a decimal point and two decimals.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds(invoice.total())])
