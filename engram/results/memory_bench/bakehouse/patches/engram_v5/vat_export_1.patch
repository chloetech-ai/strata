+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "invoices.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return f.read()
+
+    def test_header_and_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("SOU", 10, 320), InvoiceLine("CRO", 24, 110)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 3), [InvoiceLine("CRO", 48, 110)]),
+        ]
+        export_invoices(invoices, self.path)
+        self.assertEqual(self.read(), "Date,Customer,Total\r\n01/10/2026,LUMEN,58.40\r\n03/10/2026,AIDAN,52.80\r\n")
+
+    def test_amounts_are_pounds_with_two_decimals(self):
+        invoices = [
+            Invoice("A", datetime.date(2026, 10, 1), [InvoiceLine("X", 1, 1250)]),
+            Invoice("B", datetime.date(2026, 10, 1), [InvoiceLine("X", 1, 5)]),
+            Invoice("C", datetime.date(2026, 10, 1), [InvoiceLine("X", 3, 100)]),
+            Invoice("D", datetime.date(2026, 10, 1)),
+        ]
+        export_invoices(invoices, self.path)
+        rows = list(csv.reader(self.read().splitlines()))
+        self.assertEqual([row[2] for row in rows[1:]], ["12.50", "0.05", "3.00", "0.00"])
+
+    def test_credit_note_is_negative_pounds(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("SOU", -2, 320)])], self.path)
+        self.assertEqual(self.read().splitlines()[1], "01/10/2026,LUMEN,-6.40")
+
+    def test_no_invoices_writes_header_only(self):
+        export_invoices([], self.path)
+        self.assertEqual(self.read(), "Date,Customer,Total\r\n")
+
