+"""The van's delivery run."""
+
+import csv
+
+# Greenway Grocers opens at 7:00 and needs bread on its shelves before then,
+# so it is always the first drop, whatever the rest of the run looks like.
+FIRST_DROP = "GREENWAY"
+
+
+def drops_for(orderbook, customers, day):
+    """Customers with orders on `day`, in the order the van visits them."""
+    codes = orderbook.customers_for(day)
+    return sorted(
+        (customers[code] for code in codes),
+        key=lambda c: (c.code != FIRST_DROP, c.route_seq),
+    )
+
+
+def drops_file(orderbook, customers, day, path):
+    """Write the van's drops for `day` to `path` as CSV, one row per customer with orders that day."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["code", "name", "address", "postcode"])
+        for c in drops_for(orderbook, customers, day):
+            writer.writerow([c.code, c.name, c.address, c.postcode])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
