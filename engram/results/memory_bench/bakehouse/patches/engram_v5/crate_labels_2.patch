@@ -0,0 +1,90 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import PRINTER_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def catalog():
+    return Catalog([
+        Product("BRO", "Brötchen", 40, 30, 85, 230, ("wheat",)),
+        Product("CRO", "Croissant", 110, 24, 95, 200, ("eggs", "milk", "wheat")),
+        Product("SOU", "White sourdough", 320, 10, 800, 240, ("wheat",)),
+    ])
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        "AIDAN": Customer("AIDAN", "St Aidan's Primary School", "School Road", "LK4 9SA", 5),
+        "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+    }
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Cafe Lumen\n24 x Croissant\nALLERGENS: EGGS, MILK, WHEAT",
+            "Cafe Lumen\n6 x White sourdough\nALLERGENS: WHEAT",
+        ])
+
+    def test_customers_in_driving_order_not_code_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "HARBOUR", "SOU", 2),
+        ])
+        labels = crate_labels(book, customers(), DAY)
+        self.assertEqual([label.split("\n")[0] for label in labels], ["Cafe Lumen", "Harbour Deli"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "AIDAN", "CRO", 24),
+        ])
+        self.assertEqual(len(crate_labels(book, customers(), DAY)), 1)
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(catalog()), customers(), DAY), [])
+
+    def test_repeated_lines_for_a_product_are_added_into_one_label(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 4),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n10 x White sourdough\nALLERGENS: WHEAT"])
+
+    def test_product_without_allergens_has_no_allergen_line(self):
+        plain = Catalog([Product("PLN", "Plain loaf", 100, 10)])
+        book = OrderBook(plain, [OrderLine(DAY, "LUMEN", "PLN", 3)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n3 x Plain loaf"])
+
+    def test_text_is_plain_ascii(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "BRO", 30)])
+        label = crate_labels(book, customers(), DAY)[0]
+        self.assertEqual(label, "Cafe Lumen\n30 x Brotchen\nALLERGENS: WHEAT")
+        label.encode("ascii")
+
+    def test_every_line_fits_the_printer(self):
+        long_name = "A" * 60
+        many = Catalog([Product("ALG", "Mixed", 100, 1, allergens=("almond", "celery", "cereal", "egg", "fish", "lupin", "milk", "mustard", "nuts", "peanut", "sesame", "soya"))])
+        cust = {"LONG": Customer("LONG", long_name, "1 Road", "LK1 1AA", 1)}
+        book = OrderBook(many, [OrderLine(DAY, "LONG", "ALG", 1000)])
+        labels = crate_labels(book, cust, DAY)
+        lines = labels[0].split("\n")
+        self.assertTrue(all(len(line) <= PRINTER_WIDTH for line in lines))
+        self.assertEqual(lines[0], "A" * PRINTER_WIDTH)
+        allergen_text = " ".join(lines[2:])
+        for allergen in ("ALMOND", "CELERY", "SESAME", "SOYA"):
+            self.assertIn(allergen, allergen_text)
+
+
+if __name__ == "__main__":
+    unittest.main()
