+"""Crate labels for the packing room's thermal label printer."""
+
+import textwrap
+import unicodedata
+
+PRINTER_WIDTH = 48  # the printer silently cuts off anything longer than this
+
+
+def _ascii(text):
+    """`text` as plain ASCII: accents are stripped, other characters are dropped."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _fit(text):
+    return _ascii(text)[:PRINTER_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`.
+
+    Labels are in driving order, then by product code. Each label is a string of
+    lines: the customer's name, the quantity and product name, then the allergens
+    in capitals. Allergens are wrapped rather than cut, so none are lost.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        quantities = {}
+        for line in orderbook.lines_for(code, day):
+            quantities[line.product] = quantities.get(line.product, 0) + line.qty
+        for product_code in sorted(quantities):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                _fit(customers[code].name),
+                _fit(f"{quantities[product_code]} x {product.name}"),
+            ]
+            if product.allergens:
+                allergens = _ascii("ALLERGENS: " + product.allergen_text().upper())
+                lines += textwrap.wrap(allergens, PRINTER_WIDTH)
+            labels.append("\n".join(lines))
+    return labels
