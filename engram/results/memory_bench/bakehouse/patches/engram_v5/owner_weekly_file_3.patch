@@ -18,3 +21,26 @@ def top_products(orderbook, start, end, n=5):
         if start <= line.day <= end:
             units[line.product] = units.get(line.product, 0) + line.qty
     return sorted(units, key=lambda code: (-units[code], code))[:n]
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order value for the seven days starting at `week_start`.
+
+    The value is before VAT, in pounds. The file is semicolon-separated with a comma as the
+    decimal separator, because Greta's German-locale Excel puts comma-separated files into one column."""
+    totals = {}
+    for offset in range(7):
+        day = week_start + datetime.timedelta(days=offset)
+        for customer, pence in day_summary(orderbook, day).items():
+            totals[customer] = totals.get(customer, 0) + pence
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (GBP)"])
+        for customer in sorted(totals):
+            writer.writerow([customer, _pounds_with_comma(totals[customer])])
+
+
+def _pounds_with_comma(pence):
+    """Integer pence as pounds with a comma decimal separator: 1250 -> '12,50', 5 -> '0,05'."""
+    pounds, rest = divmod(pence, 100)
+    return f"{pounds},{rest:02d}"
