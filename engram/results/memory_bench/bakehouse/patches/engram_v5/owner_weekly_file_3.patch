+class WeekTotalsFileTest(unittest.TestCase):
+    def write(self, book, week_start):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return list(csv.reader(f, delimiter=";"))
+
+    def test_one_row_per_customer_summed_over_the_week(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "CRO", 24),
+            OrderLine(DAY + datetime.timedelta(days=2), "AIDAN", "SOU", 4),
+        ])
+        self.assertEqual(self.write(book, DAY), [
+            ["Customer", "Total (GBP)"],
+            ["AIDAN", "12,80"],
+            ["LUMEN", "45,60"],
+        ])
+
+    def test_days_outside_the_seven_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "AIDAN", "CRO", 24),
+        ])
+        self.assertEqual(self.write(book, DAY), [["Customer", "Total (GBP)"], ["AIDAN", "26,40"]])
+
+    def test_pence_are_padded_to_two_digits(self):
+        cheap = Catalog([Product("MIN", "Mini roll", 5, 1)])
+        book = OrderBook(cheap, [OrderLine(DAY, "LUMEN", "MIN", 1)])
+        self.assertEqual(self.write(book, DAY), [["Customer", "Total (GBP)"], ["LUMEN", "0,05"]])
+
+    def test_no_orders_gives_just_the_header(self):
+        self.assertEqual(self.write(OrderBook(catalog()), DAY), [["Customer", "Total (GBP)"]])
+
+
 if __name__ == "__main__":
     unittest.main()
