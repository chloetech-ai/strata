+"""The van's run for a delivery day."""
+
+# Greenway opens at 7:00 and needs our bread on the shelves before then, so it is always the first drop.
+FIRST_DROP = "GREENWAY"
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one numbered line per customer with orders that day.
+
+    Drops go in driving order: FIRST_DROP, then the rest by route_seq. `customers` is the dict from load_customers.
+    """
+    codes = sorted(orderbook.customers_for(day), key=lambda code: (code != FIRST_DROP, customers[code].route_seq))
+    with open(path, "w", encoding="utf-8") as f:
+        for n, code in enumerate(codes, 1):
+            customer = customers[code]
+            f.write(f"{n}. {customer.name}, {customer.address}, {customer.postcode}\n")
