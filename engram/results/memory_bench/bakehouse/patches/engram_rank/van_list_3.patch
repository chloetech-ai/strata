+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customer(code, seq):
+    return Customer(code, f"{code.title()} shop", f"{seq} Test Street", "LK1 1AA", seq)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.customers = {
+            "GREENWAY": customer("GREENWAY", 4),
+            "LUMEN": customer("LUMEN", 1),
+            "HARBOUR": customer("HARBOUR", 2),
+            "OLDMILL": customer("OLDMILL", 3),
+        }
+        self.catalog = Catalog([Product("BAG", "Baguette", 95)])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.txt")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_only_customers_with_orders_that_day_in_driving_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "OLDMILL", "BAG", 3),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "BAG", 1),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), (
+            "1. Lumen shop, 1 Test Street, LK1 1AA\n"
+            "2. Oldmill shop, 3 Test Street, LK1 1AA\n"
+        ))
+
+    def test_greenway_is_first_even_though_its_route_seq_is_later(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        lines = self.read().splitlines()
+        self.assertTrue(lines[0].startswith("1. Greenway shop,"))
+        self.assertTrue(lines[1].startswith("2. Lumen shop,"))
+
+    def test_day_without_orders_writes_an_empty_file(self):
+        drops_file(OrderBook(self.catalog), self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
