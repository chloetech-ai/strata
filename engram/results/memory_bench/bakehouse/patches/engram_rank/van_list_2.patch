+"""The van's run: which drops to make on a delivery day, in driving order."""
+
+# Greenway Grocers opens at 7:00 and needs bread on its shelves before then, so it is always first.
+FIRST_DROP = "GREENWAY"
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one per line, in driving order.
+
+    Only customers with orders for `day` are listed. Greenway Grocers always comes first;
+    the rest follow their route_seq.
+    """
+    codes = sorted(orderbook.customers_for(day), key=lambda code: (code != FIRST_DROP, customers[code].route_seq))
+    with open(path, "w", encoding="utf-8") as f:
+        for n, code in enumerate(codes, 1):
+            customer = customers[code]
+            f.write(f"{n}. {customer.name}, {customer.address}, {customer.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
