+DELIVERY_CHARGE = 450  # pence: £4.50
+DELIVERY_CHARGE_BELOW = 4000  # pence: orders under £40.00 pay the charge
+DELIVERY_CHARGE_EXEMPT = {"AIDAN"}  # St Aidan's Primary: the contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day, before VAT.
+
+    `subtotal` is the value in pence of that order before VAT. Orders under £40.00 pay £4.50;
+    an order of £40.00 or more pays nothing, and so does an order with no value. St Aidan's
+    Primary never pays it.
+    """
+    if customer_code in DELIVERY_CHARGE_EXEMPT or not 0 < subtotal < DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
