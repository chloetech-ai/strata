@@ -0,0 +1,32 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rise_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        # 95p * 1.05 = 99.75p -> 100p; 320p * 1.05 = 336p -> 340p
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "SOU": 340})
+
+    def test_exact_multiple_of_5p_is_not_bumped(self):
+        catalog = Catalog([Product("ROL", "Roll", 100)])
+        # 100p * 1.05 = 105p, already on a 5p step
+        self.assertEqual(new_prices(catalog), {"ROL": 105})
+
+    def test_never_rounds_down(self):
+        catalog = Catalog([Product("CAK", "Cake", 201)])
+        # 201p * 1.05 = 211.05p -> 215p
+        self.assertEqual(new_prices(catalog), {"CAK": 215})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FRE", "Free sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FRE": 0})
+
+    def test_empty_catalog(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
