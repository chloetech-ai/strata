new file mode 100644
index 0000000..7d56ff2
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,18 @@
+"""Wholesale price changes."""
+
+# Greta's January rise: 5% on every wholesale price.
+RISE_PERCENT = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for the January rise.
+
+    Each price goes up by RISE_PERCENT and is rounded up to the next 5p, never
+    down, so the cafés' price boards only show whole 5p amounts. Done in integer
+    arithmetic: the raised price is price * (100 + RISE_PERCENT) / 100 pence, and
+    the ceiling division by 5 is -(-x // 5).
+    """
+    return {
+        product.code: -(-product.price * (100 + RISE_PERCENT) // 500) * 5
+        for product in catalog
+    }
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
