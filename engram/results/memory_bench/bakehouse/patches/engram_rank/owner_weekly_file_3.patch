+
+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with orders for the seven days from `week_start` inclusive:
+    their total before VAT in pounds. For Greta Vogel's German-configured Excel the file uses
+    semicolons between fields and a comma as the decimal separator, e.g. 'GREENWAY;19,00'."""
+    end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= end:
+            value = line.qty * orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + value
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (GBP)"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds},{pence:02d}"])
