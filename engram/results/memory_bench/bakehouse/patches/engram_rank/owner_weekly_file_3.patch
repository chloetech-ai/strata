+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        self.week_start = DAY
+
+    def read(self, path):
+        with open(path, encoding="utf-8") as f:
+            return f.read().splitlines()
+
+    def test_one_row_per_customer_with_pounds_and_comma_decimal(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY + datetime.timedelta(days=3), "GREENWAY", "SOU", 1),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+        ])
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "week.csv")
+            week_totals_file(book, self.week_start, path)
+            self.assertEqual(self.read(path), ["Customer;Total (GBP)", "GREENWAY;22,20", "LUMEN;4,75"])
+
+    def test_covers_seven_days_inclusive_and_leaves_out_other_days(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "AIDAN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "GREENWAY", "BAG", 1),
+        ])
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "week.csv")
+            week_totals_file(book, self.week_start, path)
+            self.assertEqual(self.read(path), ["Customer;Total (GBP)", "AIDAN;0,95", "LUMEN;0,95"])
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(Catalog([Product("CAK", "Cake", 305)]), [OrderLine(DAY, "LUMEN", "CAK", 1)])
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "week.csv")
+            week_totals_file(book, self.week_start, path)
+            self.assertEqual(self.read(path)[1], "LUMEN;3,05")
+
+    def test_no_orders_gives_only_the_header(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "week.csv")
+            week_totals_file(OrderBook(self.catalog), self.week_start, path)
+            self.assertEqual(self.read(path), ["Customer;Total (GBP)"])
+
+
 if __name__ == "__main__":
     unittest.main()
