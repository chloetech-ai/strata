+"""Calendar dates for seasonal planning, such as hot cross bun season."""
+
+import datetime
+
+FIRST_YEAR = 1900
+LAST_YEAR = 2199
+
+
+def easter_sunday(year):
+    """Return Easter Sunday for a Western (Gregorian) year as a datetime.date.
+
+    Uses the anonymous Gregorian algorithm (Meeus/Jones/Butcher).
+    Only years from 1900 to 2199 are accepted.
+    """
+    if not FIRST_YEAR <= year <= LAST_YEAR:
+        raise ValueError("year must be from %d to %d, not %r" % (FIRST_YEAR, LAST_YEAR, year))
+
+    a = year % 19
+    b, c = divmod(year, 100)
+    d, e = divmod(b, 4)
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i, k = divmod(c, 4)
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month, day = divmod(h + l - 7 * m + 114, 31)
+
+    return datetime.date(year, month, day + 1)
