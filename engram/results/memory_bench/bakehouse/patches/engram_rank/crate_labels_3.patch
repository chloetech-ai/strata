@@ -0,0 +1,66 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LABEL_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("FLA", "Fruit flapjack", 210, batch_size=6, allergens=("nuts", "Milk")),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "1 High St", "AB1 2CD", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 Mill Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_driving_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "FLA", 4),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Grocers\n20 x Baguette",
+            "Cafe Lumen\n5 x Baguette",
+            "Cafe Lumen\n4 x Fruit flapjack\nMILK, NUTS",
+        ])
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 3),
+            OrderLine(DAY, "GREENWAY", "BAG", 7),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Greenway Grocers\n10 x Baguette"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 3),
+            OrderLine(datetime.date(2026, 10, 21), "LUMEN", "BAG", 9),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Greenway Grocers\n3 x Baguette"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog), self.customers, DAY), [])
+
+    def test_lines_are_plain_ascii_and_fit_the_printer(self):
+        long_name = "Ñandú Bakery & Tea Rooms of the Very Long Name Street Corner Shop"
+        customers = {"LONG": Customer("LONG", long_name, "1 St", "AB1 2CD", 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LONG", "BAG", 2)])
+        label = crate_labels(book, customers, DAY)[0]
+        first_line = label.split("\n")[0]
+        self.assertEqual(first_line, long_name.replace("Ñandú", "Nandu")[:LABEL_WIDTH])
+        self.assertEqual(len(first_line), LABEL_WIDTH)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LABEL_WIDTH)
+            line.encode("ascii")
+
+
+if __name__ == "__main__":
+    unittest.main()
