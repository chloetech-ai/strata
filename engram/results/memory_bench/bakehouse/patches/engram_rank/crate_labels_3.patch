+"""Crate labels for packing."""
+
+import unicodedata
+
+LABEL_WIDTH = 48  # characters per line on the label printer
+
+
+def _printable(text):
+    """Plain ASCII, one line of at most LABEL_WIDTH characters: accents are folded to their base letter and other characters are dropped."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return ascii_text[:LABEL_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """The text of each crate label for deliveries on `day`, one per customer and product.
+
+    Labels follow the van's driving order, then product code. Each label is up to three
+    lines: the customer's name, the quantity and product name, and the allergens in
+    capitals (omitted if the product has none). Lines are joined with '\\n'.
+    """
+    qty_by_key = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        qty_by_key[key] = qty_by_key.get(key, 0) + line.qty
+
+    labels = []
+    for customer, product_code in sorted(qty_by_key, key=lambda k: (customers[k[0]].route_seq, k[1])):
+        product = orderbook.catalog.get(product_code)
+        lines = [customers[customer].name, f"{qty_by_key[(customer, product_code)]} x {product.name}"]
+        if product.allergens:
+            lines.append(product.allergen_text().upper())
+        labels.append("\n".join(_printable(line) for line in lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
