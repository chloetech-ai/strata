+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product to bake, hottest oven first.
+
+    Each line gives the product name, pieces, batches and the dough to weigh out in grams.
+    Products with the same bake temperature keep their product code order.
+    """
+    catalog = orderbook.catalog
+    products = [
+        (catalog.get(code), units, batches)
+        for code, (units, batches) in plan(orderbook, day).items()
+    ]
+    products.sort(key=lambda row: (-row[0].bake_temp, row[0].code))
+    name_width = max((len(product.name) for product, _units, _batches in products), default=0)
+    units_width = max((len(str(units)) for _product, units, _batches in products), default=0)
+    batches_width = max((len(str(batches)) for _product, _units, batches in products), default=0)
+    lines = []
+    for product, units, batches in products:
+        grams = dough_weight_g(product, units)
+        lines.append(
+            f"{product.name:<{name_width}}  {units:>{units_width}} pcs  "
+            f"{batches:>{batches_width}} batches  {grams} g dough"
+        )
+    return "\n".join(lines)
