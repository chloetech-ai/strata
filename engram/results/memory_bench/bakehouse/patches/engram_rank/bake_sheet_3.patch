+        book = OrderBook(catalog, [OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 5)])
+        self.assertEqual(bake_sheet(book, DAY), "")
+
 
 if __name__ == "__main__":
     unittest.main()
