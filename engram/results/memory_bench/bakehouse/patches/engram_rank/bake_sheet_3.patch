     def test_total_batches_empty_plan_is_zero(self):
         self.assertEqual(total_batches({}), 0)
 
+    def test_bake_sheet_lists_hottest_oven_first(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, dough_g=350, bake_temp=250),
+            Product("CRO", "Croissant", 110, batch_size=24, dough_g=95, bake_temp=200),
+            Product("SOU", "White sourdough", 320, batch_size=10, dough_g=800, bake_temp=240),
+        ])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+        ])
+        sheet = bake_sheet(book, DAY).split("\n")
+        self.assertEqual(len(sheet), 3)
+        self.assertTrue(sheet[0].startswith("Baguette"))
+        self.assertTrue(sheet[0].endswith("5 pcs  1 batches  1750 g dough"))
+        self.assertTrue(sheet[1].startswith("White sourdough"))
+        self.assertTrue(sheet[1].endswith("10 pcs  1 batches  8000 g dough"))
+        self.assertTrue(sheet[2].startswith("Croissant"))
+        self.assertTrue(sheet[2].endswith("24 pcs  1 batches  2280 g dough"))
+
+    def test_bake_sheet_leaves_out_products_not_ordered_for_the_day(self):
