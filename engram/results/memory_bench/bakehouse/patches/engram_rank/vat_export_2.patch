+def export_invoices(invoices, path):
+    """Write one row per invoice to `path` as CSV for Ledgerly: date (DD/MM/YYYY), customer code, total in pounds.
+
+    Ledgerly wants plain commas, a header row and a decimal point, so amounts are written
+    as pounds with two decimals (1250 -> 12.50), never in pence and never with a £ sign.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, rest = divmod(abs(total), 100)
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, f"{sign}{pounds}.{rest:02d}"])
