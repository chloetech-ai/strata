+class ExportInvoicesTest(unittest.TestCase):
+    def read(self, invoices):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, encoding="utf-8", newline="") as f:
+                return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 24, 110)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 2), [InvoiceLine("SOU", 6, 320)]),
+        ]
+        self.assertEqual(
+            self.read(invoices),
+            "date,customer,total\r\n01/10/2026,LUMEN,26.40\r\n02/10/2026,GREENWAY,19.20\r\n",
+        )
+
+    def test_pence_become_pounds_with_two_decimals(self):
+        invoice = Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 1, 5)])
+        self.assertIn("01/10/2026,LUMEN,0.05\r\n", self.read([invoice]))
+
+    def test_whole_pounds_keep_two_decimals(self):
+        invoice = Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 10, 100)])
+        self.assertIn("01/10/2026,LUMEN,10.00\r\n", self.read([invoice]))
+
+    def test_negative_total_gets_leading_minus(self):
+        invoice = Invoice("GREENWAY", datetime.date(2026, 10, 1), [InvoiceLine("SWL", -3, 180)])
+        self.assertIn("01/10/2026,GREENWAY,-5.40\r\n", self.read([invoice]))
+
+    def test_empty_invoice_list_writes_only_header(self):
+        self.assertEqual(self.read([]), "date,customer,total\r\n")
+
+
 if __name__ == "__main__":
