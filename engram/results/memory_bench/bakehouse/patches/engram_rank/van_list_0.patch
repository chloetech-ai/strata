@@ -0,0 +1,57 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import load_customers
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+MONDAY = datetime.date(2026, 10, 13)
+TUESDAY = datetime.date(2026, 10, 14)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.customers = load_customers(os.path.join(DATA, "customers.csv"))
+        self.catalog = Catalog([Product("WHT", "White loaf", 250)])
+        fd, self.path = tempfile.mkstemp(suffix=".csv")
+        os.close(fd)
+        self.addCleanup(os.unlink, self.path)
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_header_and_driving_order_with_greenway_first(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(TUESDAY, "HARBOUR", "WHT", 2),
+            OrderLine(TUESDAY, "GREENWAY", "WHT", 5),
+            OrderLine(TUESDAY, "LUMEN", "WHT", 1),
+        ])
+        drops_file(book, self.customers, TUESDAY, self.path)
+        rows = self.read_rows()
+        self.assertEqual(rows[0], ["Name", "Address", "Postcode", "Notes"])
+        self.assertEqual([row[0] for row in rows[1:]], [
+            "Greenway Grocers", "Café Lumen", "Harbour Deli",
+        ])
+
+    def test_only_customers_with_orders_that_day(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(TUESDAY, "LUMEN", "WHT", 1),
+            OrderLine(MONDAY, "AIDAN", "WHT", 3),
+        ])
+        drops_file(book, self.customers, TUESDAY, self.path)
+        rows = self.read_rows()
+        self.assertEqual(rows[1:], [["Café Lumen", "14 Mill Lane", "LK1 2AB", ""]])
+
+    def test_no_orders_writes_header_only(self):
+        drops_file(OrderBook(self.catalog), self.customers, TUESDAY, self.path)
+        self.assertEqual(self.read_rows(), [["Name", "Address", "Postcode", "Notes"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
