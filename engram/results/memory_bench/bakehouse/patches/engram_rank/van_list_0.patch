+"""The van's morning run: the drops for one delivery day, in driving order."""
+
+import csv
+
+# Greenway Grocers opens at 7:00 and needs bread on its shelves before then, so it is always first.
+FIRST_CODE = "GREENWAY"
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path` as a Stopwise import CSV.
+
+    Only customers with orders for `day` get a row. Rows run in driving order: Greenway
+    first, then by route_seq. Stopwise re-optimises the route if the rows are out of order.
+    """
+    codes = sorted(
+        orderbook.customers_for(day),
+        key=lambda code: (code != FIRST_CODE, customers[code].route_seq),
+    )
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for code in codes:
+            customer = customers[code]
+            writer.writerow([customer.name, customer.address, customer.postcode, ""])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
