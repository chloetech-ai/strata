@@ -37,3 +37,24 @@ def plan(orderbook, day):
         code: (units, batches_needed(units, catalog.get(code).batch_size))
         for code, units in sorted(totals.items())
     }
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text, one line per product, hottest oven first.
+
+    Each line gives the product name, units, batches and the dough to weigh out in grams.
+    Products with the same oven temperature keep code order. Returns '' if nothing is ordered for `day`.
+    """
+    rows = plan(orderbook, day)
+    catalog = orderbook.catalog
+    codes = sorted(rows, key=lambda code: -catalog.get(code).bake_temp)
+    if not codes:
+        return ""
+    width = max(len(catalog.get(code).name) for code in codes)
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<{width}}  {units:>5} pcs  {batches:>3} batches  {grams:>7} g dough")
+    return "\n".join(lines)
