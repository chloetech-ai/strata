+    def test_bake_sheet_lists_hottest_oven_first(self):
+        catalog = Catalog([
+            Product("CRO", "Croissant", 110, batch_size=24, dough_g=95, bake_temp=200),
+            Product("BAG", "Baguette", 95, batch_size=12, dough_g=350, bake_temp=250),
+            Product("SOU", "White sourdough", 320, batch_size=10, dough_g=800, bake_temp=240),
+        ])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 30),
+            OrderLine(DAY, "LUMEN", "BAG", 25),
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+        ])
+        self.assertEqual(bake_sheet(book, DAY).splitlines(), [
+            "Baguette            25 pcs    3 batches     8750 g dough",
+            "White sourdough     10 pcs    1 batches     8000 g dough",
+            "Croissant           30 pcs    2 batches     2850 g dough",
+        ])
+
+    def test_bake_sheet_ties_keep_code_order(self):
+        catalog = Catalog([
+            Product("WRL", "White roll", 35, batch_size=30, dough_g=90, bake_temp=220),
+            Product("SWL", "Sandwich loaf", 180, batch_size=16, dough_g=850, bake_temp=220),
+        ])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "WRL", 30),
+            OrderLine(DAY, "LUMEN", "SWL", 16),
+        ])
+        names = [line.split("  ")[0] for line in bake_sheet(book, DAY).splitlines()]
+        self.assertEqual(names, ["Sandwich loaf", "White roll"])
+
+    def test_bake_sheet_leaves_out_products_not_ordered_for_the_day(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12, dough_g=350, bake_temp=250)])
+        book = OrderBook(catalog, [OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 5)])
+        self.assertEqual(bake_sheet(book, DAY), "")
+
 
 if __name__ == "__main__":
