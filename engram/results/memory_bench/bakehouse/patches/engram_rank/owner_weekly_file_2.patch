         if start <= line.day <= end:
             units[line.product] = units.get(line.product, 0) + line.qty
     return sorted(units, key=lambda code: (-units[code], code))[:n]
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order value before VAT for the seven days from `week_start` inclusive.
+
+    Greta opens this in German Excel, so it uses semicolons between fields and a comma as the decimal separator."""
+    week_end = week_start + datetime.timedelta(days=7)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day < week_end:
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * orderbook.catalog.get(line.product).price
+    # utf-8-sig adds a byte order mark so Excel reads the file as UTF-8
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["customer", "total"])
+        for customer, pence in sorted(totals.items()):
+            writer.writerow([customer, _pounds_with_comma(pence)])
+
+
+def _pounds_with_comma(pence):
+    """Integer pence as pounds with two decimals and a comma separator, e.g. 1234 -> '12,34'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds},{rest:02d}"
