+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return list(csv.reader(f, delimiter=";"))
+
+    def test_one_row_per_customer_with_pounds_and_comma_decimal(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "SOU", 10),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total"], ["GREENWAY", "19,00"], ["LUMEN", "36,75"]])
+
+    def test_window_is_seven_days_from_start_inclusive(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "BAG", 3),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total"], ["LUMEN", "4,75"]])
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(Catalog([Product("CHE", "Cheap roll", 5)]), [OrderLine(DAY, "LUMEN", "CHE", 3)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows()[1], ["LUMEN", "0,15"])
+
+    def test_week_without_orders_writes_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total"]])
+
+
 if __name__ == "__main__":
     unittest.main()
