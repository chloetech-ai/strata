+"""The van's drops for a delivery day."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the drops for `day` to `path` as a Stopwise import, one row per customer
+    with orders that day, in the order Dev will drive them.
+
+    Greenway Grocers always comes first (it opens at 7:00); everyone else follows route_seq.
+    """
+    codes = orderbook.customers_for(day)
+    for code in codes:
+        if code not in customers:
+            raise ValueError(f"no customer {code} in customers")
+    codes.sort(key=lambda code: (code != "GREENWAY", customers[code].route_seq))
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for code in codes:
+            c = customers[code]
+            writer.writerow([c.name, c.address, c.postcode, ""])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
