+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text, one line per product, hottest oven first.
+
+    Each line gives the product name, pieces, batches and the grams of dough to weigh out.
+    Products with the same bake temperature keep their code order. Returns '' if nothing is ordered.
+    """
+    catalog = orderbook.catalog
+    products = [
+        (catalog.get(code), units, batches)
+        for code, (units, batches) in plan(orderbook, day).items()
+    ]
+    products.sort(key=lambda entry: -entry[0].bake_temp)
+    name_width = max((len(product.name) for product, _units, _batches in products), default=0)
+    lines = []
+    for product, units, batches in products:
+        grams = dough_weight_g(product, units)
+        lines.append(
+            f"{product.name:<{name_width}}  {units:>4} pcs  {batches:>3} batches  {grams:>6} g dough"
+        )
+    return "\n".join(lines)
