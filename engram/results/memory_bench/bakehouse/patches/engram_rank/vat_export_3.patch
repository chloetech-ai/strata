+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "invoices.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_header_then_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 2), [InvoiceLine("SWL", 50, 180)]),
+        ]
+        export_invoices(invoices, self.path)
+        self.assertEqual(self.read(), [
+            ["date", "customer", "total"],
+            ["01/10/2026", "LUMEN", "45.60"],
+            ["02/10/2026", "GREENWAY", "90.00"],
+        ])
+
+    def test_totals_are_pounds_with_two_decimals(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 1, 1250)]),
+            Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", 1, 5)]),
+            Invoice("LUMEN", datetime.date(2026, 10, 3)),
+        ]
+        export_invoices(invoices, self.path)
+        self.assertEqual([row[2] for row in self.read()[1:]], ["12.50", "0.05", "0.00"])
+
+    def test_negative_total_keeps_leading_minus(self):
+        invoices = [Invoice("GREENWAY", datetime.date(2026, 10, 4), [InvoiceLine("SWL", 1, -300)])]
+        export_invoices(invoices, self.path)
+        self.assertEqual(self.read()[1], ["04/10/2026", "GREENWAY", "-3.00"])
+
+    def test_no_invoices_gives_header_only(self):
+        export_invoices([], self.path)
+        self.assertEqual(self.read(), [["date", "customer", "total"]])
+
+
 if __name__ == "__main__":
