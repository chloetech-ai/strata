+
+
+def export_invoices(invoices, path):
+    """Write one row per invoice for the VAT return: date, customer code and total.
+
+    The file is plain comma-separated with a header row, dates as DD/MM/YYYY and
+    totals in pounds with a decimal point and exactly two decimals (12.50), which is
+    the format Ledgerly imports. Totals are converted from pence here only.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, pence = divmod(abs(total), 100)
+            writer.writerow([
+                invoice.day.strftime("%d/%m/%Y"),
+                invoice.customer,
+                f"{sign}{pounds}.{pence:02d}",
+            ])
