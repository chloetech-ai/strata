+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 500, "Water": 350, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 50.0, "Wholemeal flour": 50.0, "Water": 35.0, "Salt": 1.0},
+        )
+
+    def test_flour_match_ignores_case(self):
+        recipe = {"FLOUR": 200, "rye FLOUR": 100, "water": 150}
+        self.assertEqual(baker_percentages(recipe)["water"], 50.0)
+
+    def test_percentages_are_rounded_to_one_decimal(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 7}
+        self.assertEqual(baker_percentages(recipe)["Salt"], 2.3)
+
+    def test_flour_itself_is_one_hundred_percent_when_alone(self):
+        self.assertEqual(baker_percentages({"Bread flour": 1000}), {"Bread flour": 100.0})
+
+    def test_recipe_without_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_recipe_with_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
