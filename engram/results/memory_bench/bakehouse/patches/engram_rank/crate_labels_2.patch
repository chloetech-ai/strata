+++ b/tests/test_labels.py
@@ -0,0 +1,62 @@
+import datetime
+import os
+import unittest
+
+from bakehouse.customers import load_customers
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product, load_catalog
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+DAY = datetime.date(2026, 10, 16)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        self.customers = load_customers(os.path.join(DATA, "customers.csv"))
+
+    def book(self, *lines):
+        return OrderBook(self.catalog, [OrderLine(DAY, c, p, q) for c, p, q in lines])
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = self.book(("GREENWAY", "SOU", 2), ("LUMEN", "BAG", 3), ("LUMEN", "CRO", 1))
+        self.assertEqual(
+            crate_labels(book, self.customers, DAY),
+            [
+                "Cafe Lumen\n3 x Baguette\nWHEAT",
+                "Cafe Lumen\n1 x Croissant\nEGGS, MILK, WHEAT",
+                "Greenway Grocers\n2 x White sourdough\nWHEAT",
+            ],
+        )
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = self.book(("LUMEN", "BAG", 3), ("LUMEN", "BAG", 2))
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n5 x Baguette\nWHEAT"])
+
+    def test_only_the_given_day_is_labelled(self):
+        book = self.book(("LUMEN", "BAG", 3))
+        book.add(OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 1))
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n3 x Baguette\nWHEAT"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(self.book(), self.customers, DAY), [])
+
+    def test_text_is_plain_ascii(self):
+        labels = crate_labels(self.book(("HARBOUR", "BRO", 30)), self.customers, DAY)
+        self.assertEqual(labels, ["Harbour Deli\n30 x Brotchen\nWHEAT"])
+        labels[0].encode("ascii")
+
+    def test_lines_are_cut_to_the_printer_width(self):
+        catalog = Catalog([Product("LON", "A" * 60, 100, allergens=("milk", "nuts", "eggs", "soya", "wheat", "rye", "sesame", "celery", "mustard", "lupin"))])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "LON", 1)])
+        label = crate_labels(book, self.customers, DAY)[0]
+        lines = label.split("\n")
+        self.assertEqual(len(lines), 3)
+        for line in lines:
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertEqual(lines[1], "1 x " + "A" * (LINE_WIDTH - 4))
+
+
+if __name__ == "__main__":
+    unittest.main()
