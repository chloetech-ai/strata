+"""Labels for the crates we pack for delivery."""
+
+import unicodedata
+
+# The label printer fits this many characters on a line.
+LINE_WIDTH = 48
+
+
+def _printable(text):
+    """Plain ASCII, with accents dropped (so 'Brötchen' becomes 'Brotchen'), cut to one line."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return ascii_text[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """Text of each crate label for deliveries on `day`, one per customer and product.
+
+    Customers are in van run order (route_seq). Each label is three lines: the
+    customer's name, the quantity and product name, then the allergens in capitals
+    (omitted if the product has none). Lines are plain ASCII and at most 48 characters.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        name = customers[code].name
+        qty_by_product = {}
+        for line in orderbook.lines_for(code, day):
+            qty_by_product[line.product] = qty_by_product.get(line.product, 0) + line.qty
+        for product_code in sorted(qty_by_product):
+            product = orderbook.catalog.get(product_code)
+            lines = [name, f"{qty_by_product[product_code]} x {product.name}"]
+            if product.allergens:
+                lines.append(product.allergen_text().upper())
+            labels.append("\n".join(_printable(line) for line in lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
