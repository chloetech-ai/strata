+"""Crate labels for packing."""
+
+import unicodedata
+
+LINE_WIDTH = 48  # the label printer prints this many characters per line
+
+
+def _printable(text):
+    """Plain ASCII, shortened to LINE_WIDTH. German sharp s becomes 'ss', accents are folded to their
+    base letter, and anything else is dropped."""
+    ascii_text = unicodedata.normalize("NFKD", text.replace("ß", "ss")).encode("ascii", "ignore").decode("ascii")
+    return ascii_text[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in driving order.
+
+    `customers` is the dict from load_customers. Each label is three lines: the customer's
+    name, the quantity and product name, then the allergens in capitals (if any).
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+
+    labels = []
+    for customer, product in sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1])):
+        item = orderbook.catalog.get(product)
+        lines = [
+            customers[customer].name,
+            f"{totals[(customer, product)]} x {item.name}",
+        ]
+        if item.allergens:
+            lines.append(item.allergen_text().upper())
+        labels.append("\n".join(_printable(text) for text in lines))
+    return labels
