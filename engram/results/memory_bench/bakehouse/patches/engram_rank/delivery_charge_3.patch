     return Invoice(customer, day, lines)
 
 
+DELIVERY_CHARGE = 450  # pence (£4.50)
+DELIVERY_CHARGE_BELOW = 4000  # pence (£40.00): orders under this pay the charge
+DELIVERY_CHARGE_EXEMPT = ("AIDAN",)  # St Aidan's Primary: contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence on one customer's order for one delivery day.
+
+    `subtotal` is the value of that order in pence, before VAT. Orders under £40.00 pay £4.50;
+    St Aidan's Primary never pays it, and a day with no order (subtotal 0) has no charge.
+    """
+    if customer_code in DELIVERY_CHARGE_EXEMPT or not 0 < subtotal < DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
