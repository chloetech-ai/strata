     return credited * price // 2
 
 
+# Delivery charge: applies to a customer's order for one delivery day, before VAT,
+# when that order is worth less than DELIVERY_CHARGE_BELOW. Customers listed in
+# NO_DELIVERY_CHARGE never pay it (St Aidan's Primary's contract price includes delivery).
+DELIVERY_CHARGE = 450  # pence
+DELIVERY_CHARGE_BELOW = 4000  # pence
+NO_DELIVERY_CHARGE = ("AIDAN",)
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order worth `subtotal` pence (before VAT) for one day.
+
+    Orders of £40.00 or more, orders of nothing, and exempt customers pay no charge.
+    Raises ValueError for a negative subtotal.
+    """
+    if subtotal < 0:
+        raise ValueError(f"subtotal must not be negative, not {subtotal}")
+    if customer_code in NO_DELIVERY_CHARGE or subtotal == 0 or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 @dataclass
 class Invoice:
     customer: str  # customer code
