diff --git a/src/bakehouse/pricing.py b/src/bakehouse/pricing.py
new file mode 100644
index 0000000..c279f43
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,18 @@
+"""Price changes. All amounts are integer pence."""
+
+RISE_PERCENT = 5  # January price rise, applied to every wholesale price
+ROUND_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """Maps each product code to its new wholesale price in pence.
+
+    Each price is raised by RISE_PERCENT and rounded up, never down, to the
+    next ROUND_TO pence, so the cafés' price boards show whole 5p steps.
+    Integer arithmetic only: ceil(price * (100 + RISE_PERCENT) / 100 / ROUND_TO) * ROUND_TO.
+    """
+    divisor = 100 * ROUND_TO
+    return {
+        product.code: -(-(product.price * (100 + RISE_PERCENT)) // divisor) * ROUND_TO
+        for product in catalog
+    }
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..c69e44f
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,42 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_raises_by_five_percent_and_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320 * 1.05 = 336 -> rounded up to 340
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_after_rise_is_not_bumped(self):
+        catalog = Catalog([Product("BAG", "Bagel", 100)])
+        # 100 * 1.05 = 105 exactly
+        self.assertEqual(new_prices(catalog), {"BAG": 105})
+
+    def test_any_fraction_rounds_up_never_down(self):
+        catalog = Catalog([Product("ROL", "Roll", 101)])
+        # 101 * 1.05 = 106.05 -> 110, not 105
+        self.assertEqual(new_prices(catalog), {"ROL": 110})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_maps_every_product_code(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("ROL", "Roll", 55)])
+        self.assertEqual(set(new_prices(catalog)), {"SOU", "ROL"})
+
+    def test_results_are_integers(self):
+        catalog = Catalog([Product("ROL", "Roll", 55)])
+        self.assertIsInstance(new_prices(catalog)["ROL"], int)
+
+    def test_does_not_change_catalog(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        new_prices(catalog)
+        self.assertEqual(catalog.get("SOU").price, 320)
+
+
+if __name__ == "__main__":
+    unittest.main()
