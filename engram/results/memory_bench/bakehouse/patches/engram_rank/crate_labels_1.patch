+"""Crate labels for packing a delivery day."""
+
+import unicodedata
+
+LABEL_WIDTH = 48  # characters per line on the label printer
+
+
+def _ascii(text):
+    """`text` as plain ASCII, accents removed and anything else dropped, e.g. 'Brötchen' -> 'Brotchen'."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as text.
+
+    `customers` is the dict from load_customers. Line one of a label is the customer's name, line two the
+    quantity and product name, and any allergens follow in capitals. Each line is plain ASCII and cut to LABEL_WIDTH.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        customer = customers[code]
+        units = {}
+        for line in orderbook.lines_for(code, day):
+            units[line.product] = units.get(line.product, 0) + line.qty
+        for product_code in sorted(units):
+            product = orderbook.catalog.get(product_code)
+            lines = [customer.name, f"{units[product_code]} x {product.name}"]
+            if product.allergens:
+                lines.append(", ".join(sorted(allergen.upper() for allergen in product.allergens)))
+            labels.append("\n".join(_ascii(line)[:LABEL_WIDTH] for line in lines))
+    return labels
