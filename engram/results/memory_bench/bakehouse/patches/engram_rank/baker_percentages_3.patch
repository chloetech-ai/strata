+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"strong white flour": 500, "wholemeal flour": 100, "water": 350, "salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"strong white flour": 83.3, "wholemeal flour": 16.7, "water": 58.3, "salt": 1.7},
+        )
+
+    def test_flour_is_matched_in_any_case(self):
+        self.assertEqual(
+            baker_percentages({"Strong FLOUR": 400, "Water": 280}),
+            {"Strong FLOUR": 100.0, "Water": 70.0},
+        )
+
+    def test_rounds_to_one_decimal(self):
+        self.assertEqual(baker_percentages({"Flour": 300, "Water": 200, "Salt": 6}),
+                         {"Flour": 100.0, "Water": 66.7, "Salt": 2.0})
+
+    def test_recipe_without_flour_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"water": 300, "salt": 6})
+
+    def test_empty_recipe_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
+
+
+if __name__ == "__main__":
+    unittest.main()
