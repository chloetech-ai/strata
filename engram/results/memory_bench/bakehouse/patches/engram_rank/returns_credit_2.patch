+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for one delivery's returns, with the price taken from `catalog`."""
+    price = catalog.get(product_code).price
+    return sale_or_return_credit(customer_code, product_code, price, delivered, returned)
