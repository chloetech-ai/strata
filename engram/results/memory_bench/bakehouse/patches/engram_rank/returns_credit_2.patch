+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("BAG", "Baguette", 95)])
+
+    def test_uses_catalog_price(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", delivered=50, returned=3), 3 * 90)
+
+    def test_capped_at_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", delivered=50, returned=9), 5 * 90)
+
+    def test_only_greenway_sandwich_loaves(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", delivered=50, returned=3), 0)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", delivered=50, returned=3), 0)
+
+    def test_unknown_product_raises(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "XXX", delivered=50, returned=3)
+
