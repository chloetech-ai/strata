@@ -29,6 +29,22 @@ def sale_or_return_credit(customer, product, price, delivered, returned):
     return credited * price // 2
 
 
+DELIVERY_CHARGE = 450  # £4.50
+DELIVERY_CHARGE_BELOW = 4000  # charged on orders under £40.00
+EXEMPT_FROM_DELIVERY_CHARGE = {"AIDAN"}  # St Aidan's Primary: contract price includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day, before VAT.
+
+    `subtotal` is the value in pence of that customer's order for the day. Orders under
+    £40.00 pay £4.50; an order of nothing pays no charge, and St Aidan's Primary is exempt.
+    """
+    if customer_code in EXEMPT_FROM_DELIVERY_CHARGE or not 0 < subtotal < DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 @dataclass
 class Invoice:
     customer: str  # customer code
