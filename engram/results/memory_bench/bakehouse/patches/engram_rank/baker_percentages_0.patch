+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_flour_weight(self):
+        recipe = {"Strong white flour": 500, "Water": 350, "Salt": 10, "Yeast": 2}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 100.0, "Water": 70.0, "Salt": 2.0, "Yeast": 0.4},
+        )
+
+    def test_rounds_to_one_decimal(self):
+        self.assertEqual(baker_percentages({"Flour": 300, "Water": 200, "Salt": 7})["Salt"], 2.3)
+
+    def test_flour_match_is_case_insensitive_and_sums_all_flours(self):
+        recipe = {"Strong white FLOUR": 300, "Wholemeal flour": 200, "Water": 250}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["Strong white FLOUR"], 60.0)
+        self.assertEqual(result["Wholemeal flour"], 40.0)
+        self.assertEqual(result["Water"], 50.0)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
