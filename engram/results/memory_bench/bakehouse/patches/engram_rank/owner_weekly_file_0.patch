+class WeekTotalsFileTest(unittest.TestCase):
+    def read_rows(self, book, week_start):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                return list(csv.reader(f, delimiter=";"))
+
+    def test_one_row_per_customer_in_pounds_with_comma_decimal(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "AIDAN", "BAG", 1),
+        ])
+        self.assertEqual(self.read_rows(book, DAY), [
+            ["Customer", "Total"],
+            ["AIDAN", "0,95"],
+            ["GREENWAY", "19,00"],
+            ["LUMEN", "36,75"],
+        ])
+
+    def test_week_is_seven_days_from_start(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "BAG", 3),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 4),
+        ])
+        self.assertEqual(self.read_rows(book, DAY)[1:], [["LUMEN", "4,75"]])
+
+    def test_customer_with_no_orders_in_week_has_no_row(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [OrderLine(DAY + datetime.timedelta(days=9), "LUMEN", "BAG", 1)])
+        self.assertEqual(self.read_rows(book, DAY), [["Customer", "Total"]])
+
+
 if __name__ == "__main__":
     unittest.main()
