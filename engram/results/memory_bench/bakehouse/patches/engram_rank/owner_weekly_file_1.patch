+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        self.dir = tempfile.mkdtemp()
+        self.path = os.path.join(self.dir, "week.csv")
+
+    def tearDown(self):
+        if os.path.exists(self.path):
+            os.remove(self.path)
+        os.rmdir(self.dir)
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return f.read()
+
+    def test_one_row_per_customer_in_semicolon_and_comma_format(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "SOU", 10),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total\r\nGREENWAY;19,00\r\nLUMEN;36,75\r\n")
+
+    def test_seven_days_from_week_start_inclusive(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 1),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total\r\nLUMEN;1,90\r\n")
+
+    def test_pence_are_padded_to_two_digits(self):
+        catalog = Catalog([Product("CHE", "Cheap roll", 5)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "CHE", 3)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total\r\nLUMEN;0,15\r\n")
+
+    def test_no_orders_gives_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total\r\n")
+
