+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,17 @@
+"""Wholesale price changes. All amounts are integer pence."""
+
+RISE_PERCENT = 5  # January price rise
+ROUND_TO = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """Maps each product code to its wholesale price after the January rise, in pence.
+
+    Each price goes up by RISE_PERCENT, then rounds up (never down) to the next 5p.
+    Integer arithmetic only, so there are no float rounding errors.
+    """
+    prices = {}
+    for product in catalog:
+        raised = -(-product.price * (100 + RISE_PERCENT) // 100)  # ceiling division
+        prices[product.code] = -(-raised // ROUND_TO) * ROUND_TO
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
