@@ -0,0 +1,36 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_then_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320 * 1.05 = 336 -> next 5p is 340
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_is_not_rounded_further(self):
+        catalog = Catalog([Product("BUN", "Bun", 200)])
+        # 200 * 1.05 = 210 exactly
+        self.assertEqual(new_prices(catalog), {"BUN": 210})
+
+    def test_rounds_up_not_to_nearest(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        # 95 * 1.05 = 99.75 -> 100
+        self.assertEqual(new_prices(catalog), {"BAG": 100})
+
+    def test_small_price_rounds_up(self):
+        catalog = Catalog([Product("CRO", "Croissant", 1)])
+        # 1 * 1.05 = 1.05 -> 5
+        self.assertEqual(new_prices(catalog), {"CRO": 5})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_maps_every_product_code_and_leaves_catalog_unchanged(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("BAG", "Baguette", 95)])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 100})
+        self.assertEqual(catalog.get("SOU").price, 320)
+        self.assertEqual(catalog.get("BAG").price, 95)
