+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product, hottest oven first.
+
+    Each line gives the product name, units, batches and the dough to weigh out in grams.
+    Products with the same temperature keep product code order. Returns "" if nothing is ordered.
+    """
+    rows = plan(orderbook, day)
+    products = sorted((orderbook.catalog.get(code) for code in rows), key=lambda p: (-p.bake_temp, p.code))
+    if not products:
+        return ""
+    width = max(len(product.name) for product in products)
+    lines = []
+    for product in products:
+        units, batches = rows[product.code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<{width}}  {units:>5} pcs  {batches:>3} batches  {grams:>7} g dough")
+    return "\n".join(lines)
