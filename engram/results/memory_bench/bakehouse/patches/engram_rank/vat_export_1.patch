 from dataclasses import dataclass, field
 from typing import List
@@ -64,3 +65,17 @@ def format_pence(pence):
     sign = "-" if pence < 0 else ""
     pounds, rest = divmod(abs(pence), 100)
     return f"{sign}£{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write one row per invoice for the VAT return: date (DD/MM/YYYY), customer code, total in pounds.
+
+    Plain comma-separated with a header row, as Ledgerly imports it. Totals are converted
+    from pence to pounds with two decimals here, not in the invoice model.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            total = format_pence(invoice.total()).replace("£", "")
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, total])
