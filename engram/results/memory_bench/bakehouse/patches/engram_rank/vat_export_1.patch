+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "invoices.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return f.read()
+
+    def test_header_and_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("SWL", 50, 180)]),
+        ]
+        export_invoices(invoices, self.path)
+        self.assertEqual(self.read(), "date,customer,total\r\n20/10/2026,LUMEN,45.60\r\n21/10/2026,GREENWAY,90.00\r\n")
+
+    def test_total_is_in_pounds_with_two_decimals(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 1, 5), [InvoiceLine("CRO", 1, 5)])]
+        export_invoices(invoices, self.path)
+        self.assertEqual(self.read(), "date,customer,total\r\n05/01/2026,LUMEN,0.05\r\n")
+
+    def test_credit_total_is_negative(self):
+        invoices = [Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("SWL", -2, 90)])]
+        export_invoices(invoices, self.path)
+        self.assertEqual(self.read(), "date,customer,total\r\n21/10/2026,GREENWAY,-1.80\r\n")
+
+    def test_no_invoices_gives_header_only(self):
+        export_invoices([], self.path)
+        self.assertEqual(self.read(), "date,customer,total\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
