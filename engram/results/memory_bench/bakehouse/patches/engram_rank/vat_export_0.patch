+def export_invoices(invoices, path):
+    """Write one row per invoice to `path` for the Ledgerly import: date, customer code, total.
+
+    Ledgerly only takes a plain comma-separated file with a header row, dates as DD/MM/YYYY
+    and amounts in pounds with a decimal point and two decimals (12.50), never pence and
+    never Greta Vogel's semicolon format. Totals are before VAT.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds_text(invoice.total())])
+
+
+def _pounds_text(pence):
+    """Plain pounds with two decimals and no currency sign, e.g. 1234 -> '12.34', -300 -> '-3.00'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
