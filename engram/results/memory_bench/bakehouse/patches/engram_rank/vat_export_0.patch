+class ExportInvoicesTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "ledgerly.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_text(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("SWL", 50, 180), InvoiceLine("BAG", 3, 95)]),
+        ]
+        export_invoices(invoices, self.path)
+        with open(self.path, newline="", encoding="utf-8") as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["date", "customer", "total"],
+            ["20/10/2026", "LUMEN", "26.40"],
+            ["21/10/2026", "GREENWAY", "92.85"],
+        ])
+
+    def test_dates_are_zero_padded_day_first(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 1, 5))], self.path)
+        self.assertIn("05/01/2026,LUMEN,0.00", self.read_text())
+
+    def test_pence_only_total_keeps_two_decimals(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 1, 5)])], self.path)
+        self.assertIn("20/10/2026,LUMEN,0.05", self.read_text())
+
+    def test_negative_total_gets_leading_minus(self):
+        export_invoices([Invoice("GREENWAY", datetime.date(2026, 10, 20), [InvoiceLine("SWL", 1, -300)])], self.path)
+        self.assertIn("20/10/2026,GREENWAY,-3.00", self.read_text())
+
+    def test_no_currency_sign_and_no_semicolons(self):
+        export_invoices([Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110)])], self.path)
+        text = self.read_text()
+        self.assertNotIn("£", text)
+        self.assertNotIn(";", text)
+
+    def test_no_invoices_writes_header_only(self):
+        export_invoices([], self.path)
+        self.assertEqual(self.read_text().splitlines(), ["date,customer,total"])
+
+
