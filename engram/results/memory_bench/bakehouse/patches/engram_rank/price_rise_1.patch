new file mode 100644
index 0000000..a700f93
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,18 @@
+"""Price changes. All amounts are integer pence."""
+
+PRICE_RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Maps each product code to its new wholesale price in pence after the January rise.
+
+    Each price is raised by PRICE_RISE_PERCENT and rounded up to the next multiple of
+    ROUND_TO_PENCE, never down. Integer arithmetic avoids float rounding errors.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + PRICE_RISE_PERCENT)  # in hundredths of a penny
+        step = ROUND_TO_PENCE * 100
+        prices[product.code] = -(-raised // step) * ROUND_TO_PENCE  # ceiling division
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..25dbdd0
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,32 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_and_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        # 95 * 1.05 = 99.75 -> 100; 320 * 1.05 = 336 -> 340
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "SOU": 340})
+
+    def test_exact_multiple_of_5p_is_not_rounded_further(self):
+        catalog = Catalog([Product("CAK", "Cake", 100)])
+        # 100 * 1.05 = 105 exactly
+        self.assertEqual(new_prices(catalog), {"CAK": 105})
+
+    def test_rounds_up_never_down(self):
+        catalog = Catalog([Product("ROL", "Roll", 41)])
+        # 41 * 1.05 = 43.05 -> 45, not 40
+        self.assertEqual(new_prices(catalog), {"ROL": 45})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FRE", "Free sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FRE": 0})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
