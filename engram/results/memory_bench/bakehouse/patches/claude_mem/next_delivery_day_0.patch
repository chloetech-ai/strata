+    def test_next_delivery_day_skips_closed_days(self):
+        # Monday is closed, so the Sunday before it jumps straight to Tuesday.
+        sunday = datetime.date(2026, 10, 18)
+        self.assertEqual(sunday.weekday(), 6)
+        self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))
+
+    def test_next_delivery_day_is_strictly_after_the_given_day(self):
+        tuesday = datetime.date(2026, 10, 20)
+        self.assertEqual(next_delivery_day(tuesday), datetime.date(2026, 10, 21))
+
+    def test_next_delivery_day_is_always_a_delivery_day_after_the_given_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            nxt = next_delivery_day(day)
+            self.assertGreater(nxt, day)
+            self.assertTrue(is_delivery_day(nxt))
+            between = [day + datetime.timedelta(days=i) for i in range(1, (nxt - day).days)]
+            self.assertFalse(any(is_delivery_day(d) for d in between))
+
 
 if __name__ == "__main__":
     unittest.main()
