+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SOU", "White sourdough", 320, 10), Product("CRO", "Croissant", 110, 24)])
+
+    def test_returned_pieces_at_catalog_price(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 10, 3), 3 * 320)
+
+    def test_no_return_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 10, 0), 0)
+
+    def test_everything_returned(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "CRO", 24, 24), 24 * 110)
+
+    def test_returned_more_than_delivered_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SOU", 10, 11)
+
+    def test_negative_return_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SOU", 10, -1)
+
+    def test_unknown_product_is_rejected(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "BAG", 10, 1)
+
+
 class FormatPenceTest(unittest.TestCase):
