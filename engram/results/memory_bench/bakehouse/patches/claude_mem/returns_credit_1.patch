@@ -47,6 +47,19 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for unsold pieces of one product sent back on one delivery: the returned
+    count at the catalog price. Prices are the same for every customer, so the amount does not
+    depend on `customer_code`; it is only used in the error message.
+
+    Raises ValueError if `returned` is negative or more than `delivered`."""
+    if not 0 <= returned <= delivered:
+        raise ValueError(
+            f"{customer_code} {product_code}: returned must be between 0 and delivered ({delivered}), got {returned}"
+        )
+    return returned * catalog.get(product_code).price
+
+
 def format_pence(pence):
     """Format integer pence as pounds, e.g. 1234 -> '£12.34'. Negative amounts get a leading minus."""
     sign = "-" if pence < 0 else ""
