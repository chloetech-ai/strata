+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SOU", "White sourdough", 320, 10), Product("CRO", "Croissant", 110, 24)])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return list(csv.reader(f))
+
+    def test_totals_in_pounds_for_seven_days_from_week_start(self):
+        week_start = DAY
+        book = OrderBook(self.catalog, [
+            OrderLine(week_start, "LUMEN", "SOU", 6),                         # 1920p
+            OrderLine(week_start + datetime.timedelta(days=6), "LUMEN", "CRO", 24),  # last day, 2640p
+            OrderLine(week_start + datetime.timedelta(days=2), "HARBOUR", "CRO", 3),  # 330p
+            OrderLine(week_start + datetime.timedelta(days=7), "LUMEN", "SOU", 50),  # next week, ignored
+            OrderLine(week_start - datetime.timedelta(days=1), "HARBOUR", "SOU", 50),  # before, ignored
+        ])
+        week_totals_file(book, week_start, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"], ["HARBOUR", "3.30"], ["LUMEN", "45.60"]])
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "CRO", 1)])  # 110p
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows()[1], ["LUMEN", "1.10"])
+
+    def test_week_with_no_orders_has_only_header(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "SOU", 1)])
+        week_totals_file(book, DAY + datetime.timedelta(days=7), self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"]])
+
+    def test_file_has_byte_order_mark_for_excel(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "SOU", 1)])
+        week_totals_file(book, DAY, self.path)
+        with open(self.path, "rb") as f:
+            self.assertTrue(f.read(3) == b"\xef\xbb\xbf")
+
+
 if __name__ == "__main__":
     unittest.main()
