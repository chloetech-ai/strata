 def day_summary(orderbook, day):
     """{customer code: order value in pence} for everything ordered for delivery on `day`.
@@ -21,3 +24,21 @@ def top_products(orderbook, start, end, n=5):
         if start <= line.day <= end:
             units[line.product] = units.get(line.product, 0) + line.qty
     return sorted(units, key=lambda code: (-units[code], code))[:n]
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Write a CSV to `path` with one row per customer who ordered for delivery in the seven
+    days starting at `week_start`: the customer code and their total in pounds, before VAT.
+    Rows are in customer code order. Opens cleanly in Excel (UTF-8 with a byte order mark)."""
+    end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= end:
+            value = line.qty * orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + value
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds}.{pence:02d}"])
