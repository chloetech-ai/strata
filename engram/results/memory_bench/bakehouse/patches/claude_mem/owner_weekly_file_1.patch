+class WeekTotalsFileTest(unittest.TestCase):
+    def read(self, path):
+        with open(path, encoding="utf-8-sig", newline="") as f:
+            return f.read()
+
+    def test_one_row_per_customer_in_pounds_for_seven_days(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320, 10), Product("CRO", "Croissant", 110, 24)])
+        day7 = DAY + datetime.timedelta(days=6)
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(day7, "LUMEN", "CRO", 24),
+            OrderLine(day7, "HARBOUR", "CRO", 5),
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "SOU", 100),
+            OrderLine(day7 + datetime.timedelta(days=1), "HARBOUR", "SOU", 100),
+        ])
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, DAY, path)
+            self.assertEqual(self.read(path), "customer,total_gbp\r\nHARBOUR,5.50\r\nLUMEN,45.60\r\n")
+
+    def test_pence_are_always_two_digits(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 305, 10)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "SOU", 1)])
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, DAY, path)
+            self.assertEqual(self.read(path), "customer,total_gbp\r\nLUMEN,3.05\r\n")
+
+    def test_no_orders_gives_header_only(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(OrderBook(Catalog()), DAY, path)
+            self.assertEqual(self.read(path), "customer,total_gbp\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
