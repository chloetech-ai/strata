+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_with_date_customer_and_total(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("SOU", 6, 320)]),
+            Invoice("HARBOUR", datetime.date(2026, 10, 21), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 1, 320)]),
+        ]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["date", "customer", "total_pence"],
+            ["2026-10-20", "LUMEN", str(6 * 320)],
+            ["2026-10-21", "HARBOUR", str(24 * 110 + 320)],
+        ])
+
+    def test_no_invoices_writes_only_header(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices([], path)
+            with open(path, newline="", encoding="utf-8") as f:
+                self.assertEqual(list(csv.reader(f)), [["date", "customer", "total_pence"]])
