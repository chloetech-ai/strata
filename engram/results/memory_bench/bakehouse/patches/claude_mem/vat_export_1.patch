@@ -47,6 +48,17 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def export_invoices(invoices, path):
+    """Writes one CSV row per invoice for the VAT return: delivery date, customer code and
+    total in integer pence. Pass only the invoices for the quarter; they are written in the
+    order given."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total_pence"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.isoformat(), invoice.customer, invoice.total()])
+
+
 def format_pence(pence):
     """Format integer pence as pounds, e.g. 1234 -> '£12.34'. Negative amounts get a leading minus."""
     sign = "-" if pence < 0 else ""
