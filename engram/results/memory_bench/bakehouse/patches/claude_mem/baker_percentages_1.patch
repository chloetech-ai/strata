+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour_rounded_to_one_decimal(self):
+        recipe = {"Strong White Flour": 500, "Wholemeal flour": 100, "Water": 375, "Salt": 10, "Starter": 100}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong White Flour": 83.3, "Wholemeal flour": 16.7, "Water": 62.5, "Salt": 1.7, "Starter": 16.7},
+        )
+
+    def test_flour_is_matched_by_name_in_any_case(self):
+        self.assertEqual(baker_percentages({"FLOUR": 200, "water": 100}), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_only_flour_is_100_percent(self):
+        self.assertEqual(baker_percentages({"Rye FLOUR": 250}), {"Rye FLOUR": 100.0})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_empty_recipe_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
+
+    def test_zero_weight_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 100})
