+"""Recipe arithmetic."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: weight as a percentage of total flour weight, to one decimal place}.
+
+    `recipe` maps ingredient names to grams. Any ingredient whose name contains 'flour'
+    (any case) counts as flour. Raises ValueError if there is no flour, or if the flour
+    weighs nothing, since the percentages are undefined.
+    """
+    flour_grams = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if not any("flour" in name.lower() for name in recipe):
+        raise ValueError("recipe has no flour")
+    if flour_grams == 0:
+        raise ValueError("recipe flour weighs nothing")
+    return {name: round(grams * 100 / flour_grams, 1) for name, grams in recipe.items()}
