+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour_rounded_to_one_decimal(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 100, "Water": 375, "Salt": 10}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong white flour": 83.3,
+            "Wholemeal flour": 16.7,
+            "Water": 62.5,
+            "Salt": 1.7,
+        })
+
+    def test_flour_match_is_case_insensitive(self):
+        recipe = {"RYE FLOUR": 200, "water": 150}
+        self.assertEqual(baker_percentages(recipe), {"RYE FLOUR": 100.0, "water": 75.0})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Rye flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
