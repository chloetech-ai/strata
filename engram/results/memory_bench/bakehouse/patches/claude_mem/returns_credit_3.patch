@@ -47,6 +47,14 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold units out of `delivered` on one delivery, at the
+    catalog price. Raises ValueError if the returned count is negative or more than was delivered."""
+    if not 0 <= returned <= delivered:
+        raise ValueError(f"returned must be between 0 and delivered ({delivered}), got {returned}")
+    return returned * catalog.get(product_code).price
+
+
 def format_pence(pence):
     """Format integer pence as pounds, e.g. 1234 -> '£12.34'. Negative amounts get a leading minus."""
     sign = "-" if pence < 0 else ""
