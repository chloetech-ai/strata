+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SOU", "White sourdough", 320, 10)])
+
+    def test_credit_is_returned_units_at_catalog_price(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 12, 3), 3 * 320)
+
+    def test_nothing_returned_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 12, 0), 0)
+
+    def test_everything_returned(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 12, 12), 12 * 320)
+
+    def test_returned_more_than_delivered_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SOU", 12, 13)
+
+    def test_negative_return_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SOU", 12, -1)
+
+    def test_unknown_product_is_rejected(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "BAG", 12, 1)
+
