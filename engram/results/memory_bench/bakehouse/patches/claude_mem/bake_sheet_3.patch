@@ -33,3 +33,19 @@ def plan(orderbook, day):
 def total_batches(plan_result):
     """Trays in the oven: the total number of batches across all products in a plan."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product with its units, batches
+    and the grams of dough to weigh out."""
+    rows = plan(orderbook, day)
+    header = f"Bake sheet for {day:%A %d %B %Y}"
+    if not rows:
+        return f"{header}\nNothing to bake."
+    catalog = orderbook.catalog
+    width = max(len(catalog.get(code).name) for code in rows)
+    lines = [header, f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>9}"]
+    for code, (units, batches) in rows.items():
+        product = catalog.get(code)
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough_weight_g(product, units):>9}")
+    return "\n".join(lines)
