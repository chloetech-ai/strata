@@ -0,0 +1,19 @@
+"""Price changes for the wholesale price list."""
+
+# January rise: 5% on each wholesale price, rounded up to the next 5p.
+JANUARY_RISE_PERCENT = 5
+ROUND_UP_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Maps each product code to its wholesale price in pence after the January rise.
+
+    Works in whole pence: price * (100 + rise) / 100, rounded up to the next
+    ROUND_UP_TO_PENCE. A price already on a 5p step still moves up if the rise
+    takes it past that step.
+    """
+    prices = {}
+    for product in catalog:
+        raised = -(-product.price * (100 + JANUARY_RISE_PERCENT) // 100)
+        prices[product.code] = -(-raised // ROUND_UP_TO_PENCE) * ROUND_UP_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
