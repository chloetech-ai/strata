+++ b/tests/test_pricing.py
@@ -0,0 +1,30 @@
+import os
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product, load_catalog
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_five_percent_rounded_up_to_next_5p(self):
+        catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        prices = new_prices(catalog)
+        self.assertEqual(prices["BAG"], 100)  # 99.75 -> 100
+        self.assertEqual(prices["SOU"], 340)  # 336 -> 340
+        self.assertEqual(prices["BRO"], 45)  # 42 -> 45
+        self.assertEqual(prices["WRL"], 40)  # 36.75 -> 40
+        self.assertEqual(prices["FLO"], 95)  # 94.5 -> 95
+        self.assertEqual(set(prices), {p.code for p in catalog})
+
+    def test_price_already_on_a_step_still_rises(self):
+        catalog = Catalog([Product("X", "Test", 100), Product("Y", "Free", 0)])
+        self.assertEqual(new_prices(catalog), {"X": 105, "Y": 0})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
