+def week_totals_file(orderbook, week_start, path):
+    """Write a CSV at `path` with one row per customer: `customer,total_gbp`, where total_gbp is
+    the order value in pounds (e.g. 13.20) for the seven days from `week_start` inclusive.
+    Rows are in customer code order; customers with nothing ordered that week are left out.
+    The file is UTF-8 with a byte order mark so Excel opens it cleanly."""
+    week_end = week_start + datetime.timedelta(days=6)
+    pence = {}
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            value = line.qty * orderbook.catalog.get(line.product).price
+            pence[line.customer] = pence.get(line.customer, 0) + value
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_gbp"])
+        for customer, total in sorted(pence.items()):
+            writer.writerow([customer, f"{total // 100}.{total % 100:02d}"])
