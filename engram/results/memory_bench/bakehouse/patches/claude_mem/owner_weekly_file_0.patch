+class WeekTotalsFileTest(unittest.TestCase):
+    def read_rows(self, book, week_start):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                return list(csv.reader(f))
+
+    def test_one_row_per_customer_in_pounds(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320, 10), Product("BUN", "Bun", 105, 12)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "BUN", 1),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "BUN", 1),
+        ])
+        self.assertEqual(self.read_rows(book, DAY), [
+            ["customer", "total_gbp"],
+            ["HARBOUR", "1.05"],
+            ["LUMEN", "20.25"],
+        ])
+
+    def test_seven_days_from_start_inclusive(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320, 10)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "AIDAN", "SOU", 1),
+            OrderLine(DAY, "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "AIDAN", "SOU", 1),
+        ])
+        self.assertEqual(self.read_rows(book, DAY), [
+            ["customer", "total_gbp"],
+            ["LUMEN", "6.40"],
+        ])
+
+    def test_empty_week_has_only_header(self):
+        book = OrderBook(Catalog([Product("SOU", "White sourdough", 320, 10)]))
+        self.assertEqual(self.read_rows(book, DAY), [["customer", "total_gbp"]])
+
+
 if __name__ == "__main__":
     unittest.main()
