+class BakeSheetTest(unittest.TestCase):
+    def catalog(self):
+        return Catalog([
+            Product("SOU", "White sourdough", 320, batch_size=10, dough_g=800),
+            Product("CRO", "Croissant", 110, batch_size=24, dough_g=95),
+        ])
+
+    def test_one_line_per_product_with_units_batches_and_dough(self):
+        book = OrderBook(self.catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "GREENWAY", "SOU", 10),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+        ])
+        self.assertEqual(
+            bake_sheet(book, DAY),
+            "Croissant           24 units    1 batches     2280 g dough\n"
+            "White sourdough     16 units    2 batches    16000 g dough",
+        )
+
+    def test_dough_is_weighed_for_whole_batches(self):
+        book = OrderBook(self.catalog(), [OrderLine(DAY, "LUMEN", "CRO", 25)])
+        self.assertEqual(bake_sheet(book, DAY), "Croissant     25 units    2 batches     4560 g dough")
+
+    def test_says_so_when_nothing_is_ordered(self):
+        book = OrderBook(self.catalog(), [OrderLine(DAY, "LUMEN", "SOU", 6)])
+        self.assertEqual(bake_sheet(book, DAY + datetime.timedelta(days=1)), "Nothing to bake for 2026-10-21.")
+
+
 if __name__ == "__main__":
     unittest.main()
