 def total_batches(plan_result):
     """Trays in the oven: the total number of batches across all products in a plan."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product with its name, units,
+    batches and the grams of dough to weigh out. Dough is weighed for whole batches,
+    since we only bake whole batches."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    width = max(len(catalog.get(code).name) for code in rows)
+    lines = []
+    for code, (units, batches) in rows.items():
+        product = catalog.get(code)
+        baked = batches * product.batch_size
+        dough = dough_weight_g(product, baked)
+        lines.append(f"{product.name:<{width}}  {units:>5} units  {batches:>3} batches  {dough:>7} g dough")
+    return "\n".join(lines)
