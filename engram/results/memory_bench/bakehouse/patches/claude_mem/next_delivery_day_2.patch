+    def test_next_delivery_day_is_strictly_after_and_skips_closed_days(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            nxt = next_delivery_day(day)
+            self.assertGreater(nxt, day)
+            self.assertTrue(is_delivery_day(nxt))
+            # Nothing in between is a delivery day.
+            for gap in range(1, (nxt - day).days):
+                self.assertFalse(is_delivery_day(day + datetime.timedelta(days=gap)))
+
+    def test_next_delivery_day_from_sunday_skips_closed_monday(self):
+        sunday = datetime.date(2026, 10, 18)  # config.CLOSED_WEEKDAYS == (0,), so Monday 19th is closed
+        self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))
+
 
