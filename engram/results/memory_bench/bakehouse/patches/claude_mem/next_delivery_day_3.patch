@@ -68,6 +68,16 @@ def is_delivery_day(day):
     return day.weekday() not in config.CLOSED_WEEKDAYS
 
 
+def next_delivery_day(day):
+    """The first delivery day strictly after `day`."""
+    if len(set(config.CLOSED_WEEKDAYS)) >= 7:
+        raise ValueError("no delivery days: every weekday is in config.CLOSED_WEEKDAYS")
+    candidate = day + datetime.timedelta(days=1)
+    while not is_delivery_day(candidate):
+        candidate += datetime.timedelta(days=1)
+    return candidate
+
+
