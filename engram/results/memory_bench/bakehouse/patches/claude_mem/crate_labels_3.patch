@@ -0,0 +1,74 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("CRO", "Croissant", 110, 24),
+            Product("SOU", "White sourdough", 320, 10),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        }
+
+    def test_one_label_per_customer_and_product_in_run_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "HARBOUR", "SOU", 3),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "HARBOUR", "CRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Café Lumen: 24 x Croissant",
+            "Café Lumen: 6 x White sourdough",
+            "Harbour Deli: 12 x Croissant",
+            "Harbour Deli: 3 x White sourdough",
+        ])
+
+    def test_run_order_follows_route_seq_not_customer_code(self):
+        self.customers["HARBOUR"] = Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 0)
+        self.customers["LUMEN"] = Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 5)
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "HARBOUR", "CRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Harbour Deli: 12 x Croissant",
+            "Café Lumen: 24 x Croissant",
+        ])
+
+    def test_duplicate_lines_for_same_customer_and_product_are_combined(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Café Lumen: 24 x Croissant"])
+
+    def test_only_the_named_day_is_labelled(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 10),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Café Lumen: 24 x Croissant"])
+
+    def test_no_orders_gives_no_labels(self):
+        book = OrderBook(self.catalog)
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_unknown_customer_is_an_error(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOPE", "CRO", 24)])
+        with self.assertRaises(ValueError):
+            crate_labels(book, self.customers, DAY)
+
+
+if __name__ == "__main__":
+    unittest.main()
