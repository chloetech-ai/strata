@@ -0,0 +1,22 @@
+"""Crate labels for packing a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in run order:
+    by the customer's route_seq, then product code. Duplicate lines for the same customer
+    and product are combined into one label.
+
+    `customers` is the dict from load_customers. Raises ValueError if an order names a
+    customer that is not in it.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        if line.customer not in customers:
+            raise ValueError(f"unknown customer code {line.customer}")
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    run_order = sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1]))
+    return [
+        f"{customers[code].name}: {totals[(code, product)]} x {orderbook.catalog.get(product).name}"
+        for code, product in run_order
+    ]
