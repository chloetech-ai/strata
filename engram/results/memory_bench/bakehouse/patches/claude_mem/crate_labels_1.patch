+"""Labels for the crates we pack for a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """Text of each crate label for delivery on `day`: one label per customer and product.
+
+    `customers` is the dict from load_customers. Labels run in van order (route_seq), then
+    product code order, so packing matches the run. Quantities for the same product are added
+    together. Raises KeyError if an order names a customer that is not in `customers`.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    ordered = sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1]))
+    labels = []
+    for customer_code, product_code in ordered:
+        customer = customers[customer_code]
+        product = orderbook.catalog.get(product_code)
+        qty = totals[(customer_code, product_code)]
+        labels.append(f"{customer.name}\n{customer.address}, {customer.postcode}\n{qty} x {product.name}")
+    return labels
