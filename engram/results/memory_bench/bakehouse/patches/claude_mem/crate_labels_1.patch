@@ -0,0 +1,57 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SOU", "White sourdough", 320, 10),
+            Product("CRO", "Croissant", 110, 24),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "1 Mill Lane", "AB1 2CD", 2),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "9 Quay Road", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_van_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "HARBOUR", "CRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Harbour Deli\n9 Quay Road, AB3 4EF\n12 x Croissant",
+            "Lumen Cafe\n1 Mill Lane, AB1 2CD\n24 x Croissant",
+            "Lumen Cafe\n1 Mill Lane, AB1 2CD\n6 x White sourdough",
+        ])
+
+    def test_duplicate_lines_for_a_product_are_added_together(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 4),
+            OrderLine(DAY, "LUMEN", "SOU", 3),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Lumen Cafe\n1 Mill Lane, AB1 2CD\n7 x White sourdough",
+        ])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 6),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_unknown_customer_raises(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "SOU", 1)])
+        with self.assertRaises(KeyError):
+            crate_labels(book, self.customers, DAY)
+
+
+if __name__ == "__main__":
+    unittest.main()
