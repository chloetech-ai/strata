+"""Delivery run sheets for the van."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one per line in route order.
+
+    Only customers with an order for `day` are listed. `customers` is the dict from load_customers.
+    Raises KeyError if an order names a customer code that isn't in `customers`.
+    """
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for code in codes:
+            c = customers[code]
+            f.write(f"{c.route_seq:>2}  {c.name}, {c.address}, {c.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
