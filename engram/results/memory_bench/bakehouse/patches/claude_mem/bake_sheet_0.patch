 def total_batches(plan_result):
     """Trays in the oven: the total number of batches across all products in a plan."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product to bake, with its units,
+    batches and the dough to weigh out. Dough is weighed for whole batches, because
+    the bakery only bakes whole batches."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    width = max(len(catalog.get(code).name) for code in rows)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>9}",
+    ]
+    for code, (units, batches) in rows.items():
+        product = catalog.get(code)
+        dough = dough_weight_g(product, batches * product.batch_size)
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough:>9}")
+    return "\n".join(lines)
