+    def test_bake_sheet_lists_units_batches_and_dough_per_product(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12, dough_g=350), Product("SOU", "White sourdough", 320, batch_size=10, dough_g=800)])
+        book = OrderBook(catalog, [
