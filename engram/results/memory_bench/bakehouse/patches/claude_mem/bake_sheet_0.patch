+        self.assertEqual(bake_sheet(book, DAY), "\n".join([
+            "Bake sheet for Tuesday 20 October 2026",
+            "Product          Units  Batches  Dough (g)",
+            "Baguette            25        3      12600",
+            "White sourdough     10        1       8000",
