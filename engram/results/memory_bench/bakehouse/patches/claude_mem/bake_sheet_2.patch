@@ -33,3 +33,16 @@ def plan(orderbook, day):
 def total_batches(plan_result):
     """Trays in the oven: the total number of batches across all products in a plan."""
     return sum(batches for _units, batches in plan_result.values())
+
+
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product with its units, batches and dough weight."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    lines = []
+    for code, (units, batches) in rows.items():
+        product = orderbook.catalog.get(code)
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name}: {units} units, {batches} batches, {grams} g dough")
+    return "\n".join(lines)
