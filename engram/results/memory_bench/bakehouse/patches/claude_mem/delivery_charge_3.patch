@@ -39,6 +41,17 @@ def invoice_for(orderbook, customer, day):
     return invoice
 
 
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day, where `subtotal`
+    is that order's value in pence before VAT. Orders under the threshold pay the charge; a
+    customer with nothing ordered pays nothing, and exempt customers never pay it."""
+    if customer_code in config.DELIVERY_CHARGE_EXEMPT or subtotal <= 0:
+        return 0
+    if subtotal < config.DELIVERY_THRESHOLD:
+        return config.DELIVERY_CHARGE
+    return 0
+
+
 def invoice_number(year, seq):
     """Invoice number such as 'LK-2026-0001': the year, then the running number for that year
     (starting again at 1 each year), zero-padded to four digits."""
