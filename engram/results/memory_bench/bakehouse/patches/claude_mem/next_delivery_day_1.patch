 DAY = datetime.date(2026, 10, 20)
@@ -173,6 +181,20 @@ class CutoffTest(unittest.TestCase):
             day = DAY + datetime.timedelta(days=offset)
             self.assertEqual(is_delivery_day(day), day.weekday() not in config.CLOSED_WEEKDAYS)
 
+    def test_next_delivery_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            nxt = next_delivery_day(day)
+            self.assertGreater(nxt, day)
+            self.assertTrue(is_delivery_day(nxt))
+            # Nothing skipped: every day strictly between `day` and `nxt` is a closed day.
+            between = [day + datetime.timedelta(days=i) for i in range(1, (nxt - day).days)]
+            self.assertFalse(any(is_delivery_day(d) for d in between))
+        # Saturday 2026-10-17 -> Sunday 2026-10-18 (Monday is closed, but Sunday is open).
+        self.assertEqual(next_delivery_day(datetime.date(2026, 10, 17)), datetime.date(2026, 10, 18))
+        # Sunday 2026-10-18 -> Tuesday 2026-10-20 (Monday 2026-10-19 is closed).
+        self.assertEqual(next_delivery_day(datetime.date(2026, 10, 18)), datetime.date(2026, 10, 20))
+
 
 if __name__ == "__main__":
     unittest.main()
