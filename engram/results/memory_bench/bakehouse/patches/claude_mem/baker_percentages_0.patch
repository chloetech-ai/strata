+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Bread flour": 500, "Water": 350, "Salt": 10, "Starter": 100}
+        self.assertEqual(baker_percentages(recipe), {
+            "Bread flour": 100.0,
+            "Water": 70.0,
+            "Salt": 2.0,
+            "Starter": 20.0,
+        })
+
+    def test_every_flour_counts_toward_the_total(self):
+        recipe = {"Bread flour": 400, "Rye FLOUR": 100, "Water": 375}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["Bread flour"], 80.0)
+        self.assertEqual(result["Rye FLOUR"], 20.0)
+        self.assertEqual(result["Water"], 75.0)
+
+    def test_rounds_to_one_decimal(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 7}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["Salt"], 2.3)
+        self.assertEqual(result["Water"], 66.7)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 350})
