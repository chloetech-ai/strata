+"""The van's delivery run."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Write the van's drops for `day` to `path`, one line per customer with an order that day,
+    in route order. `customers` is the dict from load_customers."""
+    stops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for customer in stops:
+            f.write(f"{customer.route_seq}. {customer.name}, {customer.address}, {customer.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
