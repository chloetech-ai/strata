+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SOU", "White sourdough", 320, 10)])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 3),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "2 Quay Street", "LK3 4CD", 1),
+            "GREENWAY": Customer("GREENWAY", "Greenway Stores", "9 High Road", "LK5 6EF", 2),
+        }
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+        self.path = os.path.join(self.dir.name, "drops.txt")
+
+    def read(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_lists_only_customers_with_orders_that_day_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "HARBOUR", "SOU", 2),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "SOU", 4),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(),
+                         "1. Harbour Deli, 2 Quay Street, LK3 4CD\n"
+                         "3. Café Lumen, 14 Mill Lane, LK1 2AB\n")
+
+    def test_duplicate_lines_for_one_customer_give_one_drop(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "3. Café Lumen, 14 Mill Lane, LK1 2AB\n")
+
+    def test_day_with_no_orders_writes_empty_file(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "SOU", 6)])
+        drops_file(book, self.customers, DAY + datetime.timedelta(days=2), self.path)
+        self.assertEqual(self.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
