+"""The van's run: the drops for a delivery day, in route order."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one line per customer with an order that day,
+    in route order. `customers` is the dict from load_customers.
+
+    Raises ValueError if an order names a customer code that is not in `customers`.
+    """
+    drops = []
+    for code in orderbook.customers_for(day):
+        if code not in customers:
+            raise ValueError(f"no customer record for code {code}")
+        drops.append(customers[code])
+    drops.sort(key=lambda c: c.route_seq)
+
+    with open(path, "w", encoding="utf-8") as f:
+        for c in drops:
+            f.write(f"{c.route_seq}. {c.name}, {c.address}, {c.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
index 0000000..845d043
--- /dev/null
+++ b/tests/test_delivery.py
@@ -0,0 +1,53 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Product
+
+MON = datetime.date(2026, 10, 19)
+TUE = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        catalog = {"LOAF": Product("LOAF", "Sourdough loaf", 350)}
+        self.customers = {
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "GREENWAY": Customer("GREENWAY", "Greenway Stores", "9 Hill Road", "LK3 4TT", 4),
+        }
+        self.book = OrderBook(catalog, [
+            OrderLine(MON, "HARBOUR", "LOAF", 2),
+            OrderLine(MON, "LUMEN", "LOAF", 5),
+            OrderLine(TUE, "GREENWAY", "LOAF", 1),
+        ])
+
+    def write_drops(self, day):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(self.book, self.customers, day, path)
+            with open(path, encoding="utf-8") as f:
+                return f.read()
+
+    def test_lists_only_customers_with_orders_that_day_in_route_order(self):
+        self.assertEqual(
+            self.write_drops(MON),
+            "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+            "2. Harbour Deli, 3 Quay Street, LK2 7QS\n",
+        )
+
+    def test_day_with_no_orders_writes_empty_file(self):
+        self.assertEqual(self.write_drops(datetime.date(2026, 10, 21)), "")
+
+    def test_unknown_customer_code_is_rejected(self):
+        self.book.add(OrderLine(MON, "NOBODY", "LOAF", 1))
+        with self.assertRaises(ValueError):
+            self.write_drops(MON)
+
+
+if __name__ == "__main__":
+    unittest.main()
