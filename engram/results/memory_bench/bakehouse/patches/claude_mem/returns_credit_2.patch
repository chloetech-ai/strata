diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index c576cf0..e7d6b7b 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -47,6 +47,20 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold units of `product_code` from one delivery of
+    `delivered` units to `customer_code`, credited at the catalog price.
+
+    The customer code does not change the price today; it is taken so the credit can be
+    tied to the customer's delivery. Raises ValueError for negative counts or for more
+    units returned than were delivered."""
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"unit counts must not be negative, got delivered={delivered}, returned={returned}")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} of {product_code}: only {delivered} were delivered")
+    return returned * catalog.get(product_code).price
+
+
 def format_pence(pence):
     """Format integer pence as pounds, e.g. 1234 -> '£12.34'. Negative amounts get a leading minus."""
     sign = "-" if pence < 0 else ""
