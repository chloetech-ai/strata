+"""Crate labels for packing a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as a list of strings.
+
+    Labels follow the van's run (customers by route_seq), then product code. Each label is
+    several lines: the customer's name and address, then the product and quantity. Duplicate
+    lines for the same customer and product are added together. `customers` is the dict
+    from load_customers.
+    """
+    qty_by_customer_product = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        qty_by_customer_product[key] = qty_by_customer_product.get(key, 0) + line.qty
+
+    labels = []
+    for (code, product_code), qty in sorted(
+        qty_by_customer_product.items(),
+        key=lambda item: (customers[item[0][0]].route_seq, item[0][1]),
+    ):
+        customer = customers[code]
+        product = orderbook.catalog.get(product_code)
+        labels.append(
+            f"{customer.name}\n"
+            f"{customer.address}, {customer.postcode}\n"
+            f"{product.name} x {qty}"
+        )
+    return labels
