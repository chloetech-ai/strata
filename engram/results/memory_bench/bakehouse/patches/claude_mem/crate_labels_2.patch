@@ -0,0 +1,65 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("CRO", "Croissant", 110, 24),
+            Product("SOU", "White sourdough", 320, 10),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "HARBOUR", "CRO", 12),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Café Lumen\n14 Mill Lane, LK1 2AB\nCroissant x 24",
+            "Café Lumen\n14 Mill Lane, LK1 2AB\nWhite sourdough x 6",
+            "Harbour Deli\n3 Quay Street, LK2 7QS\nCroissant x 12",
+        ])
+
+    def test_route_order_beats_customer_code_order(self):
+        customers = {
+            "AAA": Customer("AAA", "Late Stop", "1 High St", "LK3 1AA", 9),
+            "ZZZ": Customer("ZZZ", "First Stop", "2 High St", "LK3 2AA", 1),
+        }
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "AAA", "CRO", 1),
+            OrderLine(DAY, "ZZZ", "CRO", 1),
+        ])
+        labels = crate_labels(book, customers, DAY)
+        self.assertTrue(labels[0].startswith("First Stop"))
+        self.assertTrue(labels[1].startswith("Late Stop"))
+
+    def test_duplicate_lines_are_added_together(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 10),
+            OrderLine(DAY, "LUMEN", "CRO", 14),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Café Lumen\n14 Mill Lane, LK1 2AB\nCroissant x 24",
+        ])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "CRO", 24),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
