@@ -0,0 +1,64 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("CRO", "Croissant", 110, 24)])
+        self.customers = {
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "OLDMILL": Customer("OLDMILL", "The Old Mill Tearoom", "Old Mill Yard", "LK3 1MY", 3),
+        }
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "drops.txt")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_lists_only_customers_with_orders_that_day_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "HARBOUR", "CRO", 5),
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+            OrderLine(DAY + datetime.timedelta(days=1), "OLDMILL", "CRO", 2),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), (
+            "1\tLUMEN\tCafé Lumen\t14 Mill Lane\tLK1 2AB\n"
+            "2\tHARBOUR\tHarbour Deli\t3 Quay Street\tLK2 7QS\n"
+        ))
+
+    def test_a_customer_with_several_lines_gets_one_drop(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read().count("LUMEN"), 1)
+
+    def test_day_with_no_orders_writes_an_empty_file(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "CRO", 12)])
+        drops_file(book, self.customers, DAY + datetime.timedelta(days=7), self.path)
+        self.assertEqual(self.read(), "")
+
+    def test_order_for_unknown_customer_is_rejected(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOPE", "CRO", 1)])
+        with self.assertRaises(ValueError):
+            drops_file(book, self.customers, DAY, self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
