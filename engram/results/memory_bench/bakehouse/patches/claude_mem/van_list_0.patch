+"""The van's delivery run."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one line per customer with an order that day,
+    in route order: route number, customer code, name, address and postcode.
+
+    `customers` is the dict from load_customers. Raises ValueError if an order names a customer
+    that isn't in it."""
+    codes = orderbook.customers_for(day)
+    missing = [code for code in codes if code not in customers]
+    if missing:
+        raise ValueError(f"no customer record for {', '.join(missing)}")
+    stops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for c in stops:
+            f.write(f"{c.route_seq}\t{c.code}\t{c.name}\t{c.address}\t{c.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
