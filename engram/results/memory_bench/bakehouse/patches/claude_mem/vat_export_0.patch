+def export_invoices(invoices, path):
+    """Writes one CSV row per invoice for the VAT return: delivery date, customer code and
+    total in pounds (e.g. 1234 pence -> '12.34'). Pass only the invoices for the quarter."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in sorted(invoices, key=lambda i: (i.day, i.customer)):
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, pence = divmod(abs(total), 100)
+            writer.writerow([invoice.day.isoformat(), invoice.customer, f"{sign}{pounds}.{pence:02d}"])
+
+
 def format_pence(pence):
     """Format integer pence as pounds, e.g. 1234 -> '£12.34'. Negative amounts get a leading minus."""
     sign = "-" if pence < 0 else ""
