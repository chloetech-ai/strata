+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_sorted_by_date_then_customer(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 21), [InvoiceLine("SOU", 6, 320)]),
+            Invoice("HARBOUR", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 5, 110), InvoiceLine("SOU", 1, 5)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 20), []),
+        ]
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["date", "customer", "total"],
+            ["2026-10-20", "AIDAN", "0.00"],
+            ["2026-10-20", "HARBOUR", "5.55"],
+            ["2026-10-21", "LUMEN", "19.20"],
+        ])
