+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SOU", "White sourdough", 320, 10), Product("CRO", "Croissant", 110, 24)])
+        self.monday = DAY - datetime.timedelta(days=DAY.weekday())
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return list(csv.reader(f))
+
+    def test_one_row_per_customer_in_pounds_for_seven_days(self):
+        day = lambda n: self.monday + datetime.timedelta(days=n)
+        book = OrderBook(self.catalog, [
+            OrderLine(day(0), "LUMEN", "SOU", 6),
+            OrderLine(day(6), "LUMEN", "CRO", 24),
+            OrderLine(day(2), "HARBOUR", "CRO", 5),
+        ])
+        week_totals_file(book, self.monday, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_pounds"],
+            ["HARBOUR", "5.50"],
+            ["LUMEN", "45.60"],
+        ])
+
+    def test_days_outside_the_week_are_left_out(self):
+        before = self.monday - datetime.timedelta(days=1)
+        after = self.monday + datetime.timedelta(days=7)
+        book = OrderBook(self.catalog, [
+            OrderLine(before, "LUMEN", "SOU", 1),
+            OrderLine(self.monday, "LUMEN", "SOU", 1),
+            OrderLine(after, "LUMEN", "SOU", 1),
+        ])
+        week_totals_file(book, self.monday, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_pounds"], ["LUMEN", "3.20"]])
+
+    def test_pence_are_padded_and_customers_sorted(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.monday, "ZETA", "CRO", 1),
+            OrderLine(self.monday, "ALPHA", "CRO", 3),
+        ])
+        week_totals_file(book, self.monday, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_pounds"],
+            ["ALPHA", "3.30"],
+            ["ZETA", "1.10"],
+        ])
+
+    def test_empty_week_writes_only_the_header(self):
+        week_totals_file(OrderBook(self.catalog), self.monday, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_pounds"]])
+
+
 if __name__ == "__main__":
     unittest.main()
