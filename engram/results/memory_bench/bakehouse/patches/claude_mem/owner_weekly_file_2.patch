+def week_totals_file(orderbook, week_start, path):
+    """Write one CSV row per customer with their order total in pounds for the seven days
+    starting at `week_start` (inclusive). Customers with nothing ordered in that week get no row.
+
+    Rows are sorted by customer code. The file is UTF-8 with a byte-order mark so that Excel
+    opens it with the right encoding; amounts are plain numbers such as 12.34, with no £ sign.
+    """
+    end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= end:
+            value = line.qty * orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + value
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_pounds"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds}.{pence:02d}"])
