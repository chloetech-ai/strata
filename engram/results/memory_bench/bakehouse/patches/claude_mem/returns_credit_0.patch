@@ -39,6 +39,18 @@ def invoice_for(orderbook, customer, day):
     return invoice
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold units of one product from one delivery.
+
+    Credit is at catalog price. `customer_code` is accepted for the call site but does not
+    change the price, since there is no customer-specific pricing. Raises ValueError if
+    `returned` is negative or more than `delivered`.
+    """
+    if not 0 <= returned <= delivered:
+        raise ValueError(f"returned must be between 0 and delivered ({delivered}) for {product_code}, got {returned}")
+    return returned * catalog.get(product_code).price
+
+
 def invoice_number(year, seq):
     """Invoice number such as 'LK-2026-0001': the year, then the running number for that year
     (starting again at 1 each year), zero-padded to four digits."""
