@@ -0,0 +1,18 @@
+"""Wholesale price changes. All amounts are integer pence."""
+
+RISE_PERCENT = 5  # the January rise
+STEP = 5  # new prices are rounded up to the next multiple of this many pence
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for the January rise.
+
+    Each price goes up by RISE_PERCENT and is rounded up to the next STEP pence,
+    so a new price is never below the old one. Exact multiples of STEP are kept.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + RISE_PERCENT)  # price * 105, in hundredths of a penny
+        steps = -(-raised // (100 * STEP))  # ceiling division
+        prices[product.code] = steps * STEP
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
