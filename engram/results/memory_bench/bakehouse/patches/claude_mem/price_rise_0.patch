+++ b/tests/test_pricing.py
@@ -0,0 +1,39 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95),  # 99.75p -> 100p
+            Product("SOU", "White sourdough", 320),  # 336p -> 340p
+            Product("BRO", "Brötchen", 40),  # 42p -> 45p
+            Product("FLO", "Florentine", 90),  # 94.5p -> 95p
+        ])
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "BRO": 45, "FLO": 95, "SOU": 340})
+
+    def test_exact_multiple_of_5p_is_kept(self):
+        # 100p * 1.05 = 105p, which is already a multiple of 5p
+        self.assertEqual(new_prices(Catalog([Product("X", "X", 100)])), {"X": 105})
+        # 200p * 1.05 = 210p
+        self.assertEqual(new_prices(Catalog([Product("X", "X", 200)])), {"X": 210})
+
+    def test_never_below_the_old_price(self):
+        catalog = Catalog([Product("P%d" % p, "P", p) for p in range(0, 1000)])
+        prices = new_prices(catalog)
+        for product in catalog:
+            self.assertGreaterEqual(prices[product.code], product.price)
+            self.assertGreaterEqual(prices[product.code] * 100, product.price * 105)
+            self.assertEqual(prices[product.code] % 5, 0)
+
+    def test_zero_price_stays_zero(self):
+        self.assertEqual(new_prices(Catalog([Product("FREE", "Sample", 0)])), {"FREE": 0})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
