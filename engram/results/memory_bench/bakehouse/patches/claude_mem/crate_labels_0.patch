@@ -0,0 +1,60 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SOU", "White sourdough", 320, 10),
+            Product("CRO", "Croissant", 110, 24),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Coffee", "1 High St", "AB1 2CD", 2),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "4 Quay Rd", "AB3 4EF", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "HARBOUR", "CRO", 5),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Harbour Deli: 5 x Croissant",
+            "Lumen Coffee: 24 x Croissant",
+            "Lumen Coffee: 6 x White sourdough",
+        ])
+
+    def test_repeated_lines_are_added_together(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Lumen Coffee: 24 x Croissant"])
+
+    def test_only_the_given_day(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 2),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Lumen Coffee: 6 x White sourdough"])
+
+    def test_no_orders_gives_no_labels(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "SOU", 6)])
+        self.assertEqual(crate_labels(book, self.customers, DAY + datetime.timedelta(days=7)), [])
+
+    def test_unknown_customer_code_raises(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "GHOST", "SOU", 1)])
+        with self.assertRaises(KeyError):
+            crate_labels(book, self.customers, DAY)
+
+
+if __name__ == "__main__":
+    unittest.main()
