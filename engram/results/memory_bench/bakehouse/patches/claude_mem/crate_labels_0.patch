+"""Crate labels for packing a delivery day."""
+
+
+def crate_labels(orderbook, customers, day):
+    """Text of each crate label for delivery on `day`: one per customer and product, in van
+    run order (by route_seq), then product code order. Each label reads like
+    'Lumen Coffee: 24 x Croissant'. Repeated lines for the same customer and product are
+    added together.
+
+    Raises KeyError if an order is for a customer code missing from `customers`.
+    """
+    qty_by_customer = {}
+    for line in orderbook.for_day(day):
+        if line.customer not in customers:
+            raise KeyError(f"no customer record for code {line.customer}")
+        products = qty_by_customer.setdefault(line.customer, {})
+        products[line.product] = products.get(line.product, 0) + line.qty
+
+    labels = []
+    for code in sorted(qty_by_customer, key=lambda c: customers[c].route_seq):
+        name = customers[code].name
+        for product_code, qty in sorted(qty_by_customer[code].items()):
+            product_name = orderbook.catalog.get(product_code).name
+            labels.append(f"{name}: {qty} x {product_name}")
+    return labels
