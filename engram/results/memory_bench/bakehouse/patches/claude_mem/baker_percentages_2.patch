+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour_weight(self):
+        recipe = {"bread flour": 500, "water": 350, "salt": 10, "levain": 100, "rye flour": 100}
+        self.assertEqual(baker_percentages(recipe), {
+            "bread flour": 83.3,
+            "water": 58.3,
+            "salt": 1.7,
+            "levain": 16.7,
+            "rye flour": 16.7,
+        })
+
+    def test_flour_is_matched_case_insensitively_anywhere_in_the_name(self):
+        recipe = {"WHOLEMEAL FLOUR": 200, "Strong Flour": 300, "water": 300}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["water"], 60.0)
+        self.assertEqual(result["WHOLEMEAL FLOUR"], 40.0)
+        self.assertEqual(result["Strong Flour"], 60.0)
+
+    def test_single_flour_is_one_hundred_percent(self):
+        self.assertEqual(baker_percentages({"flour": 1000}), {"flour": 100.0})
+
+    def test_rounds_to_one_decimal(self):
+        self.assertEqual(baker_percentages({"flour": 3, "water": 2}), {"flour": 100.0, "water": 66.7})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"water": 350, "salt": 10})
+
+    def test_empty_recipe_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
+
+    def test_zero_weight_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"flour": 0, "water": 100})
+
+
+if __name__ == "__main__":
+    unittest.main()
