 DAY = datetime.date(2026, 10, 20)
@@ -153,6 +153,25 @@ class CutoffTest(unittest.TestCase):
             day = DAY + datetime.timedelta(days=offset)
             self.assertEqual(is_delivery_day(day), day.weekday() not in config.CLOSED_WEEKDAYS)
 
+    def test_next_delivery_day_is_the_next_day_we_deliver(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            nxt = next_delivery_day(day)
+            self.assertGreater(nxt, day)
+            self.assertTrue(is_delivery_day(nxt))
+            # nothing in between is a delivery day
+            day_after = day + datetime.timedelta(days=1)
+            while day_after < nxt:
+                self.assertFalse(is_delivery_day(day_after))
+                day_after += datetime.timedelta(days=1)
+
+    def test_next_delivery_day_skips_closed_day(self):
+        # Monday is closed (config.CLOSED_WEEKDAYS), so Sunday's next delivery day is Tuesday.
+        sunday = datetime.date(2026, 10, 18)
+        self.assertEqual(sunday.weekday(), 6)
+        self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))
+        self.assertEqual(next_delivery_day(datetime.date(2026, 10, 19)), datetime.date(2026, 10, 20))
+
 
 if __name__ == "__main__":
     unittest.main()
