+class DeliveryChargeTest(unittest.TestCase):
+    def test_under_twenty_five_pounds_pays_three_pounds(self):
+        self.assertEqual(delivery_charge("LUMEN", 1), 300)
+        self.assertEqual(delivery_charge("LUMEN", 2499), 300)
+
+    def test_twenty_five_pounds_and_over_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 2500), 0)
+        self.assertEqual(delivery_charge("LUMEN", 12345), 0)
+
+    def test_no_order_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 0), 0)
+
+    def test_st_aidans_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 1000), 0)
+        self.assertEqual(delivery_charge("AIDAN", 0), 0)
