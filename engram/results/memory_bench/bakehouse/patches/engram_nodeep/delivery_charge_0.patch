+DELIVERY_CHARGE = 300  # pence, charged on orders under DELIVERY_THRESHOLD before VAT
+DELIVERY_THRESHOLD = 2500  # pence
+NO_DELIVERY_CHARGE = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day, given its value in pence before VAT.
+
+    £3.00 on orders under £25.00. Nothing for a day with no order, or for St Aidan's.
+    """
+    if subtotal <= 0 or customer_code in NO_DELIVERY_CHARGE:
+        return 0
+    if subtotal < DELIVERY_THRESHOLD:
+        return DELIVERY_CHARGE
+    return 0
+
+
