+# Sale-or-return terms: only Greenway takes sandwich loaves on sale-or-return.
+SALE_OR_RETURN_CUSTOMER = "GREENWAY"
+SALE_OR_RETURN_PRODUCT = "SWL"
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for loaves `returned` the next morning from one day's delivery of `delivered` loaves.
+
+    Each returned loaf is credited at half its wholesale price. Credit is limited to 10% of the
+    loaves delivered that day (rounded down); returns above that are not credited.
+    Only Greenway's sandwich loaves are on sale-or-return, so any other customer or product gets 0.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    product = catalog.get(product_code)
+    if customer_code != SALE_OR_RETURN_CUSTOMER or product_code != SALE_OR_RETURN_PRODUCT:
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * (product.price // 2)
+
+
