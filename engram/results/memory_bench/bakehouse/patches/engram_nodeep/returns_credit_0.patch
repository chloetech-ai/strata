+from bakehouse.invoice import Invoice, InvoiceLine, format_pence, invoice_for, invoice_number, returns_credit
 from bakehouse.orders import OrderBook, OrderLine
 from bakehouse.products import Catalog, Product
 
 DAY = datetime.date(2026, 10, 20)
 
 
+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("CRO", "Croissant", 110)])
+
+    def test_half_price_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 5), 5 * 90)
+
+    def test_credit_capped_at_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 9), 5 * 90)
+
+    def test_cap_rounds_down(self):
+        # 10% of 35 is 3.5, so only 3 loaves can be credited
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 35, 10), 3 * 90)
+
+    def test_returns_below_cap_are_all_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 2), 2 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 0), 0)
+
+    def test_small_delivery_has_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 1), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 50, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "CRO", 50, 5), 0)
+
+    def test_unknown_product_code_is_rejected(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "XXX", 50, 5)
+
+    def test_negative_quantities_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 50, -1)
+
+
