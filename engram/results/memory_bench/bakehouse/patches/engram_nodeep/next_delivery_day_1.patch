+def next_delivery_day(day):
+    """The first date after `day` on which we bake and deliver."""
+    candidate = day + datetime.timedelta(days=1)
+    while not is_delivery_day(candidate):
+        candidate += datetime.timedelta(days=1)
+    return candidate
