@@ -0,0 +1,18 @@
+"""Wholesale price changes for the price list."""
+
+RISE_PERCENT = 5  # January wholesale price rise
+ROUND_TO = 5  # new prices round up to a multiple of this many pence
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} after the January rise.
+
+    Each price rises by RISE_PERCENT and is rounded up to the next ROUND_TO pence,
+    so a price is never reduced. Integer arithmetic only: no floats for money.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + RISE_PERCENT)  # pence times 100
+        step = 100 * ROUND_TO
+        prices[product.code] = -(-raised // step) * ROUND_TO  # ceiling division
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
