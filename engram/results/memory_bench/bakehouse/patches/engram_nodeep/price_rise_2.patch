@@ -0,0 +1,41 @@
+import os
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product, load_catalog
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rise_rounded_up_to_next_5p(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])  # 95 * 1.05 = 99.75 -> 100
+        self.assertEqual(new_prices(catalog), {"BAG": 100})
+
+    def test_exact_multiple_of_5_not_bumped_further(self):
+        catalog = Catalog([Product("BRO", "Brötchen", 100)])  # 105.00 exactly
+        self.assertEqual(new_prices(catalog), {"BRO": 105})
+
+    def test_just_over_a_step_rounds_up(self):
+        catalog = Catalog([Product("X", "x", 101)])  # 106.05 -> 110
+        self.assertEqual(new_prices(catalog), {"X": 110})
+
+    def test_never_down(self):
+        catalog = Catalog([Product(f"P{p}", "x", p) for p in range(0, 300)])
+        prices = new_prices(catalog)
+        for product in catalog:
+            self.assertGreaterEqual(prices[product.code], product.price)
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Free", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_every_product_in_price_list(self):
+        catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        prices = new_prices(catalog)
+        self.assertEqual(set(prices), {p.code for p in catalog})
+        self.assertEqual(prices["SOU"], 340)  # 320 * 1.05 = 336 -> 340
+
+
+if __name__ == "__main__":
+    unittest.main()
