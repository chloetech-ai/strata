+"""Crate labels for packing. The label printer prints plain ASCII, 48 characters a line."""
+
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def _line(text):
+    """`text` folded to ASCII (accents dropped) and cut to fit one printed line."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return ascii_text[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`.
+
+    Each label is three lines: the customer's name, the quantity and product
+    name, then the allergens in capitals (omitted if the product has none).
+    `customers` is the dict from load_customers. Customers are in code order.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        qty_by_product = {}
+        for line in orderbook.lines_for(code, day):
+            qty_by_product[line.product] = qty_by_product.get(line.product, 0) + line.qty
+        for product_code in sorted(qty_by_product):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                _line(customers[code].name),
+                _line(f"{qty_by_product[product_code]} x {product.name}"),
+            ]
+            if product.allergens:
+                lines.append(_line(product.allergen_text().upper()))
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
