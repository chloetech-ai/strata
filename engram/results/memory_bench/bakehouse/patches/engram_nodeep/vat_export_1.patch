+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_in_ledgerly_format(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("SWL", 5, 250)]),
+            Invoice("HARBOUR", datetime.date(2026, 10, 22)),
+        ]
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                text = f.read()
+        self.assertEqual(text.splitlines(), [
+            "date,customer,total",
+            "20/10/2026,LUMEN,45.60",
+            "21/10/2026,GREENWAY,12.50",
+            "22/10/2026,HARBOUR,0.00",
+        ])
+
+    def test_pence_are_never_written_as_pounds_without_decimals(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 3, 5)])]
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows[1], ["20/10/2026", "LUMEN", "0.15"])
+
