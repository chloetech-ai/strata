+def export_invoices(invoices, path):
+    """Write one row per invoice for the VAT return, in Ledgerly's format: comma-separated with a
+    header, DD/MM/YYYY dates, and amounts in pounds with a decimal point and two decimals (12.50)."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            pence = invoice.total()
+            sign = "-" if pence < 0 else ""
+            pounds, rest = divmod(abs(pence), 100)
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, f"{sign}{pounds}.{rest:02d}"])
