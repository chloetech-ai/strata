@@ -0,0 +1,20 @@
+"""Wholesale price changes."""
+
+# January rise: 5%, and each new price is rounded up to the next 5p so that
+# café price boards never show odd pennies.
+JANUARY_RISE_PERCENT = 5
+ROUND_UP_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for the January rise.
+
+    Integer arithmetic only: the rise is applied as price * (100 + rise) / 100
+    and rounded up to a multiple of ROUND_UP_TO_PENCE, so a price never goes down.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + JANUARY_RISE_PERCENT)
+        step = 100 * ROUND_UP_TO_PENCE
+        prices[product.code] = -(-raised // step) * ROUND_UP_TO_PENCE
+    return prices
