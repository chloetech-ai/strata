+"""The van's delivery run for one day."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path` as a Stopwise import: one row per customer with orders that day,
+    in route_seq order. `customers` is the dict from load_customers."""
+    codes = orderbook.customers_for(day)
+    for code in codes:
+        if code not in customers:
+            raise ValueError(f"no customer {code} in customers file")
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for c in drops:
+            writer.writerow([c.name, c.address, c.postcode, ""])
