+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        self.customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "1 High Street", "LK1 1AA", 1),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 3),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        }
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "drops.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_one_row_per_customer_with_orders_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "HARBOUR", "BAG", 2),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["Name", "Address", "Postcode", "Notes"],
+            ["Greenway Grocers", "1 High Street", "LK1 1AA", ""],
+            ["Harbour Deli", "3 Quay Street", "LK2 7QS", ""],
+            ["Café Lumen", "14 Mill Lane", "LK1 2AB", ""],
+        ])
+
+    def test_customers_without_orders_that_day_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "BAG", 9),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["Name", "Address", "Postcode", "Notes"],
+            ["Café Lumen", "14 Mill Lane", "LK1 2AB", ""],
+        ])
+
+    def test_no_orders_gives_header_only(self):
+        drops_file(OrderBook(self.catalog), self.customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["Name", "Address", "Postcode", "Notes"]])
+
+    def test_unknown_customer_is_rejected(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 1)])
+        with self.assertRaisesRegex(ValueError, "NOBODY"):
+            drops_file(book, self.customers, DAY, self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
