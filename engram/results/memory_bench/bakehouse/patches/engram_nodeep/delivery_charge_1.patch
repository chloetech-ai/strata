index 7e3854b..60f2d22 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -46,6 +46,21 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence: £4.50, from November
+DELIVERY_CHARGE_UNDER = 4000  # pence: charged when the order is under £40.00, before VAT
+NO_DELIVERY_CHARGE = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day, before VAT.
+
+    `subtotal` is that order's value in pence, before VAT. No order, or a credit, attracts no charge.
+    """
+    if customer_code in NO_DELIVERY_CHARGE or subtotal <= 0 or subtotal >= DELIVERY_CHARGE_UNDER:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def format_pence(pence):
     """Format integer pence as pounds: 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
