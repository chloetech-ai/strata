+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return list(csv.reader(f, delimiter=";"))
+
+    def test_one_row_per_customer_with_pounds_and_comma_decimal(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "SOU", 10),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["Customer", "Total (£)"],
+            ["GREENWAY", "19,00"],
+            ["LUMEN", "36,75"],
+        ])
+
+    def test_week_is_seven_days_from_start_inclusive(self):
+        last_day = DAY + datetime.timedelta(days=6)
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(last_day, "LUMEN", "BAG", 1),
+            OrderLine(last_day + datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows()[1:], [["LUMEN", "1,90"]])
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows()[1:], [["LUMEN", "0,95"]])
+
+    def test_no_orders_gives_header_only(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY + datetime.timedelta(days=7), self.path)
+        self.assertEqual(self.read_rows(), [["Customer", "Total (£)"]])
+
+
