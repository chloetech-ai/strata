+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order total for the seven days starting at `week_start`, before VAT.
+
+    The file is for Greta's Excel, which is set up in German: semicolons between fields and a comma as the decimal
+    separator, so `12.50` is written as `12,50`. Customers with nothing ordered that week get no row."""
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    # utf-8-sig adds a byte-order mark so Excel reads the £ sign correctly.
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (£)"])
+        for code in sorted(totals):
+            pence = totals[code]
+            writer.writerow([code, f"{pence // 100},{pence % 100:02d}"])
+
+
