+# Sale-or-return applies only to this customer and product.
+RETURNS_CUSTOMER = "GREENWAY"
+RETURNS_PRODUCT = "SWL"
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for loaves `customer_code` sent back from one delivery.
+
+    Only Greenway's sandwich loaves are sale-or-return: each returned loaf earns half its
+    wholesale price, but at most 10% of the loaves delivered that day are credited
+    (rounded down); returns above that are not credited. Anything else earns no credit.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError("delivered and returned must not be negative")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    creditable = min(returned, delivered // 10)
+    return creditable * catalog.get(product_code).price // 2
+
+
