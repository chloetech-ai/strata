+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("SOU", "White sourdough", 320)])
+
+    def test_half_the_wholesale_price_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 4), 4 * 90)
+
+    def test_returns_above_ten_percent_of_delivered_are_not_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 15), 10 * 90)
+
+    def test_ten_percent_cap_rounds_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 5), 2 * 90)
+
+    def test_no_credit_below_ten_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 5), 0)
+
+    def test_odd_price_rounds_credit_down_to_whole_pence(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 185)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 100, 3), 3 * 185 // 2)
+
+    def test_other_customers_earn_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 4), 0)
+
+    def test_other_products_earn_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 100, 4), 0)
+
+    def test_nothing_returned_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+
