@@ -0,0 +1,85 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, ascii_only, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+OTHER_DAY = datetime.date(2026, 10, 21)
+
+
+def _book(lines, products=None):
+    catalog = Catalog(products or [
+        Product("BAG", "Baguette", 95, allergens=("wheat",)),
+        Product("FLO", "Florentine", 90, allergens=("nuts", "milk")),
+        Product("SOU", "White sourdough", 320),
+    ])
+    return OrderBook(catalog, [OrderLine(*line) for line in lines])
+
+
+CUSTOMERS = {
+    "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+    "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+}
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_for_the_day(self):
+        book = _book([
+            (DAY, "HARBOUR", "BAG", 12),
+            (DAY, "LUMEN", "BAG", 6),
+            (DAY, "LUMEN", "FLO", 4),
+        ])
+        labels = crate_labels(book, CUSTOMERS, DAY)
+        self.assertEqual(labels, [
+            "Harbour Deli\n12 x Baguette\nWHEAT",
+            "Cafe Lumen\n6 x Baguette\nWHEAT",
+            "Cafe Lumen\n4 x Florentine\nMILK, NUTS",
+        ])
+
+    def test_other_days_are_left_out(self):
+        book = _book([(OTHER_DAY, "LUMEN", "BAG", 6)])
+        self.assertEqual(crate_labels(book, CUSTOMERS, DAY), [])
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = _book([(DAY, "LUMEN", "BAG", 2), (DAY, "LUMEN", "BAG", 3)])
+        self.assertEqual(crate_labels(book, CUSTOMERS, DAY), ["Cafe Lumen\n5 x Baguette\nWHEAT"])
+
+    def test_product_without_allergens_has_no_allergen_line(self):
+        book = _book([(DAY, "LUMEN", "SOU", 1)])
+        self.assertEqual(crate_labels(book, CUSTOMERS, DAY), ["Cafe Lumen\n1 x White sourdough"])
+
+    def test_accents_are_removed(self):
+        self.assertEqual(ascii_only("Brötchen Café"), "Brotchen Cafe")
+
+    def test_long_name_is_cut_to_line_width(self):
+        customers = {"LONG": Customer("LONG", "A" * 60, "x", "y", 1)}
+        book = _book([(DAY, "LONG", "SOU", 1)])
+        first_line = crate_labels(book, customers, DAY)[0].split("\n")[0]
+        self.assertEqual(first_line, "A" * LINE_WIDTH)
+
+    def test_long_allergen_list_wraps_without_losing_any_allergen(self):
+        many = tuple(f"allergen{i:02d}" for i in range(12))
+        catalog_products = [Product("MIX", "Mixed", 100, allergens=many)]
+        book = _book([(DAY, "LUMEN", "MIX", 1)], products=catalog_products)
+        lines = crate_labels(book, CUSTOMERS, DAY)[0].split("\n")
+        self.assertGreater(len(lines), 3)
+        allergen_text = " ".join(lines[2:])
+        for name in many:
+            self.assertIn(name.upper(), allergen_text)
+
+    def test_every_line_fits_and_is_ascii(self):
+        book = _book([
+            (DAY, "LUMEN", "FLO", 4),
+            (DAY, "LUMEN", "BAG", 6),
+        ])
+        for label in crate_labels(book, CUSTOMERS, DAY):
+            for line in label.split("\n"):
+                self.assertLessEqual(len(line), LINE_WIDTH)
+                line.encode("ascii")
+
+
+if __name__ == "__main__":
+    unittest.main()
