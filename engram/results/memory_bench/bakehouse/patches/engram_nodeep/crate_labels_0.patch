+"""Crate labels for the packing room."""
+
+import textwrap
+import unicodedata
+
+# The label printer's line length.
+LINE_WIDTH = 48
+
+
+def ascii_only(text):
+    """Plain ASCII version of `text`, with accents removed: 'Café' becomes 'Cafe'."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as a list of strings.
+
+    Line 1 is the customer's name, line 2 the quantity and product name, and the
+    allergens follow in capitals. Name and product lines are cut to LINE_WIDTH.
+    Allergen text is wrapped onto further lines rather than cut, so no allergen is lost.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        name = ascii_only(customers[code].name)
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code in sorted(totals):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                name[:LINE_WIDTH],
+                f"{totals[product_code]} x {ascii_only(product.name)}"[:LINE_WIDTH],
+            ]
+            allergens = ascii_only(product.allergen_text()).upper()
+            if allergens:
+                lines.extend(textwrap.wrap(allergens, LINE_WIDTH))
+            labels.append("\n".join(lines))
+    return labels
