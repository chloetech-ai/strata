+"""Wholesale price changes for the price list."""
+
+# Greta Vogel's January rise, as a percentage. Prices rise by this much, then
+# round up to the next 5p, so a café's price board never shows odd pennies.
+JANUARY_RISE_PERCENT = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} after the January rise.
+
+    Each new price is the old price times 1.05, rounded up to the next 5p.
+    Rounding is done in whole pence so no float error can push a price over
+    a 5p step, and a price never goes down.
+    """
+    prices = {}
+    for product in catalog:
+        # ceil(price * 1.05 / 0.05) * 5 pence, in integer arithmetic.
+        raised = product.price * (100 + JANUARY_RISE_PERCENT)
+        step = 100 * 5
+        prices[product.code] = -(-raised // step) * 5
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
