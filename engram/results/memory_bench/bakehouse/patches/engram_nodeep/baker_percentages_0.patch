@@ -0,0 +1,27 @@
+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 100, "Water": 375, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 83.3, "Wholemeal flour": 16.7, "Water": 62.5, "Salt": 1.7},
+        )
+
+    def test_flour_match_ignores_case(self):
+        self.assertEqual(baker_percentages({"FLOUR": 200, "water": 140}), {"FLOUR": 100.0, "water": 70.0})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Rye flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
