+from bakehouse.reports import day_summary, top_products, week_totals_file
 
 DAY = datetime.date(2026, 10, 20)
 
 
+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8-sig", newline="") as f:
+            return f.read().splitlines()
+
+    def test_one_row_per_customer_in_pounds_with_semicolons_and_comma_decimals(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)", "GREENWAY;19,00", "LUMEN;36,75"])
+
+    def test_pence_are_padded_to_two_digits(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)", "LUMEN;0,95"])
+
+    def test_covers_seven_days_from_week_start_inclusive(self):
+        week_end = DAY + datetime.timedelta(days=6)
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "AIDAN", "BAG", 100),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(week_end, "LUMEN", "BAG", 1),
+            OrderLine(week_end + datetime.timedelta(days=1), "AIDAN", "BAG", 100),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)", "LUMEN;1,90"])
+
+    def test_customers_with_no_orders_that_week_are_left_out(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY + datetime.timedelta(days=7), self.path)
+        self.assertEqual(self.read(), ["Customer;Total (£)"])
+
+
