+def bake_sheet(orderbook, day):
+    """The printed bake sheet for `day`: one line per product, hottest oven first.
+
+    The hottest product is baked first so the deck oven, which is slow to
+    reheat from cold, is used before the others.
+    """
+    catalog = orderbook.catalog
+    result = plan(orderbook, day)
+    codes = sorted(result, key=lambda code: (-catalog.get(code).bake_temp, code))
+    lines = [f"Bake sheet for {day:%a %d %b %Y}"]
+    if not codes:
+        lines.append("Nothing to bake.")
+    for code in codes:
+        units, batches = result[code]
+        product = catalog.get(code)
+        grams = dough_weight_g(product, units)
+        lines.append(
+            f"{product.name}: pieces {units}, batches {batches}, dough {grams} g, oven {product.bake_temp} C"
+        )
+    return "\n".join(lines)
