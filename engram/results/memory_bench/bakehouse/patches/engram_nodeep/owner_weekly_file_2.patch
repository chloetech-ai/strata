+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.week_end = DAY + datetime.timedelta(days=6)
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return f.read()
+
+    def test_one_row_per_customer_in_pounds_with_semicolons_and_comma_decimal(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 1),
+            OrderLine(self.week_end, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total (£)\r\nGREENWAY;19,00\r\nLUMEN;7,95\r\n")
+
+    def test_pence_are_padded_to_two_digits(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertIn("LUMEN;0,95", self.read())
+
+    def test_days_outside_the_week_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "SOU", 100),
+            OrderLine(self.week_end + datetime.timedelta(days=1), "LUMEN", "SOU", 100),
+            OrderLine(DAY, "AIDAN", "BAG", 2),
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total (£)\r\nAIDAN;1,90\r\n")
+
+    def test_customers_without_orders_that_week_have_no_row(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY + datetime.timedelta(days=30), "LUMEN", "SOU", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), "Customer;Total (£)\r\n")
+
