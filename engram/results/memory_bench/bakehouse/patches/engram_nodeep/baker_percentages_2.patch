@@ -0,0 +1,30 @@
+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class RecipesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 100, "Water": 375, "Salt": 10}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong white flour": 83.3,
+            "Wholemeal flour": 16.7,
+            "Water": 62.5,
+            "Salt": 1.7,
+        })
+
+    def test_flour_match_ignores_case(self):
+        recipe = {"FLOUR": 200, "water": 100}
+        self.assertEqual(baker_percentages(recipe), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_raises_when_there_is_no_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 6})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
