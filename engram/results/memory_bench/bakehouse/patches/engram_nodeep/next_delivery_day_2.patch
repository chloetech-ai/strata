@@ -154,5 +154,24 @@ class CutoffTest(unittest.TestCase):
             self.assertEqual(is_delivery_day(day), day.weekday() not in config.CLOSED_WEEKDAYS)
 
 
+class NextDeliveryDayTest(unittest.TestCase):
+    def test_next_day_when_it_is_a_delivery_day(self):
+        self.assertEqual(next_delivery_day(DAY), DAY + datetime.timedelta(days=1))
+
+    def test_skips_closed_days(self):
+        # 2026-10-18 is a Sunday, 2026-10-19 a Monday (closed), so the next delivery day is Tuesday.
+        sunday = datetime.date(2026, 10, 18)
+        self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))
+
+    def test_is_strictly_after_the_given_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            following = next_delivery_day(day)
+            self.assertGreater(following, day)
+            self.assertTrue(is_delivery_day(following))
+            between = [day + datetime.timedelta(days=i) for i in range(1, (following - day).days)]
+            self.assertFalse(any(is_delivery_day(d) for d in between))
+
+
 if __name__ == "__main__":
     unittest.main()
