+def bake_sheet(orderbook, day):
+    """The printed bake sheet for `day`: one line per product, hottest oven first,
+    so the deck oven is used before the others (it costs time to heat from cold)."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    codes = sorted(rows, key=lambda code: -catalog.get(code).bake_temp)
+    width = max(len(catalog.get(code).name) for code in codes)
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name:<{width}}  units {units:>5}  batches {batches:>3}  dough {grams:>6} g")
+    return "\n".join(lines)
