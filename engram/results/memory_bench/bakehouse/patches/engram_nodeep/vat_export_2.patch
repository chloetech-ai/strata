+class ExportInvoicesTest(unittest.TestCase):
+    def read_export(self, invoices):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_header_and_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 4), [InvoiceLine("SWL", 10, 250)]),
+        ]
+        self.assertEqual(
+            self.read_export(invoices),
+            "date,customer,total\r\n"
+            "02/10/2026,LUMEN,45.60\r\n"
+            "04/10/2026,GREENWAY,25.00\r\n",
+        )
+
+    def test_total_is_pounds_with_two_decimals_not_pence(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", 1, 5)])]
+        self.assertIn("02/10/2026,LUMEN,0.05", self.read_export(invoices))
+
+    def test_empty_invoice_is_zero(self):
+        invoices = [Invoice("HARBOUR", datetime.date(2026, 10, 2))]
+        self.assertIn("02/10/2026,HARBOUR,0.00", self.read_export(invoices))
+
+    def test_no_invoices_writes_only_the_header(self):
+        self.assertEqual(self.read_export([]), "date,customer,total\r\n")
+
+
