+def export_invoices(invoices, path):
+    """Write one row per invoice for the VAT return, as a CSV that Ledgerly imports.
+
+    Columns: date (DD/MM/YYYY), customer code, total in pounds with two decimals (1234 -> 12.34).
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, rest = divmod(abs(total), 100)
+            writer.writerow([f"{invoice.day:%d/%m/%Y}", invoice.customer, f"{sign}{pounds}.{rest:02d}"])
