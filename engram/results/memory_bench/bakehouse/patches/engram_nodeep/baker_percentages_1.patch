+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 100, "Water": 350, "Salt": 10}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong white flour": 83.3,
+            "Wholemeal flour": 16.7,
+            "Water": 58.3,
+            "Salt": 1.7,
+        })
+
+    def test_flour_match_ignores_case(self):
+        self.assertEqual(baker_percentages({"FLOUR": 200, "water": 100}), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_no_flour_is_an_error(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_zero_flour_is_an_error(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Rye flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
