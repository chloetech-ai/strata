@@ -0,0 +1,61 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "1 High St", "LK3 9ZZ", 1),
+            "AIDAN": Customer("AIDAN", "St Aidan's Primary", "Church Rd", "LK4 4QQ", 3),
+        }
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_only_customers_with_orders_that_day_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY, "GREENWAY", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=1), "AIDAN", "BAG", 9),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), [
+            ["route_seq", "code", "name", "address", "postcode"],
+            ["1", "GREENWAY", "Greenway Grocers", "1 High St", "LK3 9ZZ"],
+            ["2", "LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB"],
+        ])
+
+    def test_customer_with_several_lines_is_one_drop(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(len(self.read()), 2)
+
+    def test_empty_day_writes_only_the_header(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 2)])
+        drops_file(book, self.customers, DAY + datetime.timedelta(days=3), self.path)
+        self.assertEqual(self.read(), [["route_seq", "code", "name", "address", "postcode"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
