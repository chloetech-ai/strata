+"""The van's drops for a delivery day."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the drops for `day` to `path` as CSV, one row per customer with orders that day, in route order.
+
+    `customers` is the dict from load_customers."""
+    drops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["route_seq", "code", "name", "address", "postcode"])
+        for c in drops:
+            writer.writerow([c.route_seq, c.code, c.name, c.address, c.postcode])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
