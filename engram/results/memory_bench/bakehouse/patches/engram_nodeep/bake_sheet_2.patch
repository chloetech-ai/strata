+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product, hottest oven first,
+    with units, batches and the dough weight in grams to weigh out."""
+    rows = plan(orderbook, day)
+    catalog = orderbook.catalog
+    # Hottest first so the deck oven is used before it cools; ties go by code.
+    order = sorted(rows, key=lambda code: (-catalog.get(code).bake_temp, code))
+    lines = []
+    for code in order:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name}: {units} units, {batches} batches, {grams} g dough")
+    return "\n".join(lines)
