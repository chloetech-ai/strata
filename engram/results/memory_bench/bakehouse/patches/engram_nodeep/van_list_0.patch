+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "1 High St", "AB1 2CD", 3),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 Mill Rd", "AB3 4EF", 1),
+            "MILL": Customer("MILL", "The Old Mill Tearoom", "2 Weir Ln", "AB5 6GH", 2),
+            "POTTER": Customer("POTTER", "Potter's Farm Shop", "Farm Lane", "AB7 8IJ", 4),
+        }
+
+    def write(self, book):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "drops.csv")
+            drops_file(book, self.customers, DAY, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return list(csv.reader(f))
+
+    def test_header_and_one_row_per_drop_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "MILL", "BAG", 2),
+        ])
+        self.assertEqual(self.write(book), [
+            ["Name", "Address", "Postcode", "Notes"],
+            ["Greenway Grocers", "9 Mill Rd", "AB3 4EF", ""],
+            ["The Old Mill Tearoom", "2 Weir Ln", "AB5 6GH", ""],
+            ["Café Lumen", "1 High St", "AB1 2CD", ""],
+        ])
+
+    def test_customers_without_orders_that_day_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "POTTER", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "BAG", 1),
+        ])
+        rows = self.write(book)
+        self.assertEqual(rows[1:], [["Potter's Farm Shop", "Farm Lane", "AB7 8IJ", ""]])
+
+    def test_no_orders_gives_header_only(self):
+        self.assertEqual(self.write(OrderBook(self.catalog)), [["Name", "Address", "Postcode", "Notes"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
