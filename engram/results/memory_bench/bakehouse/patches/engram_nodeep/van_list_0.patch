+"""The van's run for a delivery day."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path` as a Stopwise import file: one row per customer with an order
+    that day, in route_seq order. `customers` is the dict from load_customers."""
+    drops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for c in drops:
+            writer.writerow([c.name, c.address, c.postcode, ""])
