+"""Crate labels for packing a delivery day."""
+
+import unicodedata
+
+# The label printer prints at most this many characters per line.
+LINE_WIDTH = 48
+
+
+def _fit(text):
+    """Plain ASCII, no longer than LINE_WIDTH. Accents are dropped (Café -> Cafe)
+    because the printer prints anything non-ASCII as garbage."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    if len(ascii_text) > LINE_WIDTH:
+        return ascii_text[:LINE_WIDTH - 3] + "..."
+    return ascii_text
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as text.
+
+    Each label is three lines at most: the customer's name, the quantity and the
+    product name, then the allergens in capitals if the product has any. Customers
+    are in code order, and each customer's products are in product code order.
+    """
+    labels = []
+    for code in orderbook.customers_for(day):
+        customer = customers[code]
+        lines = orderbook.lines_for(code, day)
+        for product_code in sorted({line.product for line in lines}):
+            product = orderbook.catalog.get(product_code)
+            qty = sum(line.qty for line in lines if line.product == product_code)
+            label = [_fit(customer.name), _fit(f"{qty} x {product.name}")]
+            if product.allergens:
+                label.append(_fit("ALLERGENS: " + product.allergen_text().upper()))
+            labels.append("\n".join(label))
+    return labels
