@@ -0,0 +1,81 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customer(code, name):
+    return Customer(code, name, "1 High Street", "LK1 1AA", 1)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, allergens=("wheat",)),
+            Product("JAM", "Plum jam", 350, batch_size=6),
+            Product("CRO", "Croissant", 110, batch_size=24, allergens=("wheat", "milk", "eggs")),
+        ])
+        self.customers = {
+            "GREENWAY": customer("GREENWAY", "Greenway Grocers"),
+            "LUMEN": customer("LUMEN", "Café Lumen"),
+        }
+
+    def test_one_label_per_customer_and_product_in_code_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 4),
+            OrderLine(DAY, "GREENWAY", "JAM", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 3),
+            OrderLine(DAY, "GREENWAY", "BAG", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Grocers\n12 x Baguette\nALLERGENS: WHEAT",
+            "Greenway Grocers\n2 x Plum jam",
+            "Cafe Lumen\n3 x Baguette\nALLERGENS: WHEAT",
+            "Cafe Lumen\n4 x Croissant\nALLERGENS: EGGS, MILK, WHEAT",
+        ])
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n7 x Baguette\nALLERGENS: WHEAT"])
+
+    def test_no_allergen_line_when_product_has_none(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "GREENWAY", "JAM", 1)])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Greenway Grocers\n1 x Plum jam"])
+
+    def test_other_days_are_ignored(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "BAG", 9),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n1 x Baguette\nALLERGENS: WHEAT"])
+
+    def test_empty_day_gives_no_labels(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        self.assertEqual(crate_labels(book, self.customers, DAY + datetime.timedelta(days=3)), [])
+
+    def test_long_lines_are_shortened_to_the_printer_width(self):
+        long_name = customer("LONG", "The " + "Very " * 20 + "Long Name Bakery")
+        catalog = Catalog([Product("SOU", "White sourdough " + "loaf " * 15, 320, batch_size=10)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LONG", "SOU", 3)])
+        labels = crate_labels(book, {"LONG": long_name}, DAY)
+        name_line, product_line = labels[0].split("\n")
+        self.assertEqual(len(name_line), LINE_WIDTH)
+        self.assertEqual(len(product_line), LINE_WIDTH)
+        self.assertTrue(name_line.endswith("..."))
+
+    def test_output_is_ascii_only(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        for label in crate_labels(book, self.customers, DAY):
+            label.encode("ascii")
+
+
+if __name__ == "__main__":
+    unittest.main()
