+
+
+def export_invoices(invoices, path):
+    """Write one row per invoice to `path` as a CSV for Ledgerly: date, customer code and total.
+
+    Dates are DD/MM/YYYY and totals are pounds with two decimals, such as 12.50, never pence.
+    Totals exclude VAT, which Ledgerly handles.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds(invoice.total())])
+
+
+def _pounds(pence):
+    """Integer pence as a plain pounds figure with two decimals: 1234 -> '12.34'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
