+class ExportInvoicesTest(unittest.TestCase):
+    def export(self, invoices):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        text = self.export([
+            Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", 24, 110)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 5), [InvoiceLine("SOU", 6, 320), InvoiceLine("CRO", 2, 110)]),
+        ])
+        self.assertEqual(text, "date,customer,total\r\n02/10/2026,LUMEN,26.40\r\n05/10/2026,GREENWAY,21.40\r\n")
+
+    def test_total_is_pounds_with_two_decimals_not_pence(self):
+        text = self.export([Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", 1, 5)])])
+        self.assertEqual(text.splitlines()[1], "02/10/2026,LUMEN,0.05")
+
+    def test_no_currency_symbol_or_semicolons(self):
+        text = self.export([Invoice("LUMEN", datetime.date(2026, 10, 2), [InvoiceLine("CRO", 1, 110)])])
+        self.assertNotIn("£", text)
+        self.assertNotIn(";", text)
+
+    def test_empty_invoice_totals_zero(self):
+        text = self.export([Invoice("HARBOUR", datetime.date(2026, 10, 2))])
+        self.assertEqual(list(csv.reader(text.splitlines()))[1], ["02/10/2026", "HARBOUR", "0.00"])
+
+    def test_no_invoices_writes_only_header(self):
+        self.assertEqual(self.export([]), "date,customer,total\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
