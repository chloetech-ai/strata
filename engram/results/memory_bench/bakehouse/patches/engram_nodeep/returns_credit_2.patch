+from bakehouse.invoice import Invoice, InvoiceLine, format_pence, invoice_for, invoice_number, returns_credit
 from bakehouse.orders import OrderBook, OrderLine
 from bakehouse.products import Catalog, Product
 
 DAY = datetime.date(2026, 10, 20)
 
 
+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("SOU", "White sourdough", 320)])
+
+    def test_half_wholesale_price_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 5), 5 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_returns_capped_at_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 30), 10 * 90)
+
+    def test_cap_rounds_down(self):
+        # 10% of 25 loaves is 2.5, so only 2 returns are credited.
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 5), 2 * 90)
+
+    def test_returns_exactly_at_cap_are_all_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 50, 5), 5 * 90)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 100, 5), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
