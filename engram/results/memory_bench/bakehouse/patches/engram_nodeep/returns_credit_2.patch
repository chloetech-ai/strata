+# Sale-or-return terms: Greenway Grocers may send back unsold sandwich loaves the next morning.
+SALE_OR_RETURN_CUSTOMER = "GREENWAY"
+SALE_OR_RETURN_PRODUCT = "SWL"
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold loaves from one delivery of `delivered` loaves.
+
+    Only Greenway's sandwich loaves are on sale-or-return: they earn half the wholesale price
+    per loaf, for at most 10% of the loaves delivered that day (rounded down). Anything else earns 0.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if customer_code != SALE_OR_RETURN_CUSTOMER or product_code != SALE_OR_RETURN_PRODUCT:
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * catalog.get(product_code).price // 2
+
+
