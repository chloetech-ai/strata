diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index 7e3854b..e34196f 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -46,6 +46,23 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 300  # pence, on orders under DELIVERY_CHARGE_BELOW
+DELIVERY_CHARGE_BELOW = 2500  # pence: £25.00
+NO_DELIVERY_CHARGE = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day.
+
+    `subtotal` is that order's value in pence, before VAT.
+    """
+    if customer_code in NO_DELIVERY_CHARGE:
+        return 0
+    if subtotal < DELIVERY_CHARGE_BELOW:
+        return DELIVERY_CHARGE
+    return 0
+
+
 def format_pence(pence):
     """Format integer pence as pounds: 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
