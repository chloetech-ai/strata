+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_totals_in_pounds_over_seven_days_from_week_start(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        monday_before = DAY - datetime.timedelta(days=1)
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),                                        # 475p
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 1),           # 320p, last day of week
+            OrderLine(DAY + datetime.timedelta(days=6), "GREENWAY", "BAG", 3),        # 285p
+            OrderLine(DAY + datetime.timedelta(days=7), "GREENWAY", "SOU", 9),        # next week, left out
+            OrderLine(monday_before, "AIDAN", "SOU", 2),                              # before the week, left out
+        ])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read(), [["customer", "total_gbp"], ["GREENWAY", "2.85"], ["LUMEN", "7.95"]])
+
+    def test_pence_are_zero_padded(self):
+        catalog = Catalog([Product("BAG", "Baguette", 105)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read()[1], ["LUMEN", "1.05"])
+
+    def test_no_orders_writes_only_the_header(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        week_totals_file(OrderBook(catalog), DAY, self.path)
+        self.assertEqual(self.read(), [["customer", "total_gbp"]])
+
 
 if __name__ == "__main__":
     unittest.main()
