+def week_totals_file(orderbook, week_start, path):
+    """Write a CSV at `path` with one row per customer giving their order total in pounds
+    for the seven days from `week_start` inclusive. Customers with no orders that week are left out.
+
+    Rows are sorted by customer code. Amounts are plain numbers such as 12.34 (no £ sign),
+    so the file opens as numbers in a spreadsheet.
+    """
+    totals = {}
+    for offset in range(7):
+        day = week_start + datetime.timedelta(days=offset)
+        for customer, pence in day_summary(orderbook, day).items():
+            totals[customer] = totals.get(customer, 0) + pence
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds}.{pence:02d}"])
