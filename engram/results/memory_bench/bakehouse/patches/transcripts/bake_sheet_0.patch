+def _kilos_text(grams):
+    """Kilos to one decimal place, rounding halves up, e.g. 5350 g -> '5.4 kg'."""
+    tenths = (grams + 50) // 100
+    return f"{tenths // 10}.{tenths % 10} kg"
+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    order = sorted(rows, key=lambda code: (-catalog.get(code).bake_temp, code))
+    width = max(len(catalog.get(code).name) for code in order)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}",
+    ]
+    for code in order:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        dough = _kilos_text(dough_weight_g(product, units))
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough:>8}")
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays going in the oven: one tray holds one batch, so this is the batch count across all products."""
     return sum(batches for _units, batches in plan_result.values())
