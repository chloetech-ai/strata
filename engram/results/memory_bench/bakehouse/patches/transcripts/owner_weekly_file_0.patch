+def week_totals_file(orderbook, week_start, path):
+    """Write a CSV with one row per customer: their order total in pounds (e.g. '19.50')
+    for the seven days starting at `week_start`. Customers with no orders that week
+    are left out. Rows are sorted by customer code.
+
+    The file is UTF-8 with a byte-order mark so that Excel opens it with the right characters.
+    """
+    totals = {}
+    for offset in range(7):
+        day = week_start + datetime.timedelta(days=offset)
+        for customer, pence in day_summary(orderbook, day).items():
+            totals[customer] = totals.get(customer, 0) + pence
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f)
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            pence = totals[customer]
+            writer.writerow([customer, f"{pence // 100}.{pence % 100:02d}"])
