+class WeekTotalsFileTest(unittest.TestCase):
+    def read_rows(self, book, week_start):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                return list(csv.reader(f))
+
+    def test_one_row_per_customer_in_pounds_over_seven_days(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 10),                             # first day of the week
+            OrderLine(datetime.date(2026, 10, 26), "LUMEN", "BAG", 5),      # last day of the week
+            OrderLine(datetime.date(2026, 10, 27), "LUMEN", "BAG", 100),    # day after: excluded
+            OrderLine(datetime.date(2026, 10, 19), "GREENWAY", "BAG", 100), # day before: excluded
+            OrderLine(DAY, "GREENWAY", "BAG", 1),
+        ])
+        self.assertEqual(self.read_rows(book, DAY), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "0.95"],
+            ["LUMEN", "36.75"],
+        ])
+
+    def test_pence_are_always_two_digits(self):
+        catalog = Catalog([Product("CHE", "Cheap roll", 5)])
+        book = OrderBook(catalog, [OrderLine(DAY, "AIDAN", "CHE", 1)])
+        self.assertEqual(self.read_rows(book, DAY)[1], ["AIDAN", "0.05"])
+
+    def test_no_orders_gives_only_the_header(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        self.assertEqual(self.read_rows(OrderBook(catalog), DAY), [["customer", "total_gbp"]])
+
+    def test_file_has_byte_order_mark_for_excel(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)]), DAY, path)
+            with open(path, "rb") as f:
+                self.assertTrue(f.read().startswith(b"\xef\xbb\xbf"))
+
+
 if __name__ == "__main__":
     unittest.main()
