+
+    def test_forty_pounds_or_more_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+        self.assertEqual(delivery_charge("LUMEN", 12345), 0)
+
+    def test_no_order_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 0), 0)
+
+    def test_st_aidans_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 1000), 0)
