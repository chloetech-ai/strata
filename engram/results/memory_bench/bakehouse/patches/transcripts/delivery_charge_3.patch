+# Delivery charge from November: £4.50 on any order under £40.00 (before VAT).
+DELIVERY_CHARGE = 450
+DELIVERY_CHARGE_BELOW = 4000
+# Customers whose contract price already includes delivery.
+NO_DELIVERY_CHARGE = {"AIDAN"}
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order worth `subtotal` pence
+    (before VAT) for one delivery day. No order, or an order of £40.00 or more, or a
+    customer in NO_DELIVERY_CHARGE, pays nothing."""
+    if customer_code in NO_DELIVERY_CHARGE or subtotal <= 0 or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
