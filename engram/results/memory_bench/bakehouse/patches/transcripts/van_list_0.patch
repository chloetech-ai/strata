+"""The van's run: the drops to make on a delivery day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`: one line per customer with orders
+    that day, in run order (route_seq), giving the stop number, name, address and postcode."""
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for stop, code in enumerate(codes, start=1):
+            c = customers[code]
+            f.write(f"{stop}. {c.name}, {c.address}, {c.postcode}\n")
