index 07b9dd8..ade7a66 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -41,6 +41,20 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, charged on orders below DELIVERY_CHARGE_BELOW
+DELIVERY_CHARGE_BELOW = 4000  # pence, before VAT, per customer per delivery day
+DELIVERY_CHARGE_EXEMPT = ("AIDAN",)  # contract prices already include delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order worth `subtotal` pence
+    (before VAT) for one delivery day. Orders of DELIVERY_CHARGE_BELOW or more, and
+    orders from DELIVERY_CHARGE_EXEMPT customers, pay no delivery charge."""
+    if customer_code in DELIVERY_CHARGE_EXEMPT or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def invoice_for(orderbook, customer, day):
