+class DeliveryChargeTest(unittest.TestCase):
+    def test_small_order_pays_the_charge(self):
+        self.assertEqual(delivery_charge("LUMEN", 2500), 450)
+        self.assertEqual(delivery_charge("LUMEN", 1), 450)
+
+    def test_order_just_under_threshold_pays_the_charge(self):
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)
+
+    def test_order_at_threshold_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+
+    def test_large_order_pays_nothing(self):
+        self.assertEqual(delivery_charge("GREENWAY", 8135), 0)
+
+    def test_st_aidans_never_pays_the_charge(self):
+        self.assertEqual(delivery_charge("AIDAN", 2100), 0)
+        self.assertEqual(delivery_charge("AIDAN", 0), 0)
+
