+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_with_date_customer_and_total(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 4, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("BAG", 30, 95)]),
+        ]
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "vat.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["date", "customer", "total_pence"],
+            ["2026-10-20", "LUMEN", str(24 * 110 + 4 * 320)],
+            ["2026-10-21", "GREENWAY", str(30 * 95)],
+        ])
+
+    def test_no_invoices_writes_only_the_header(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "vat.csv")
+            export_invoices([], path)
