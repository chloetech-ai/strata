--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,34 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95),  # 99.75 -> 100
+            Product("SOU", "White sourdough", 320),  # 336 -> 340
+            Product("CRO", "Croissant", 110),  # 115.5 -> 120
+            Product("BRO", "Brötchen", 40),  # 42 -> 45
+        ])
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "SOU": 340, "CRO": 120, "BRO": 45})
+
+    def test_price_already_on_a_5p_step_after_rise_stays(self):
+        # 100 * 1.05 = 105 exactly, which is already a multiple of 5
+        self.assertEqual(new_prices(Catalog([Product("X", "Test", 100)])), {"X": 105})
+
+    def test_never_rounds_down(self):
+        self.assertEqual(new_prices(Catalog([Product("X", "Test", 35)])), {"X": 40})
+
+    def test_does_not_change_the_catalog(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        new_prices(catalog)
+        self.assertEqual(catalog.get("BAG").price, 95)
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
