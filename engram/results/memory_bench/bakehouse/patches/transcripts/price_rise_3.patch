diff --git a/src/bakehouse/pricing.py b/src/bakehouse/pricing.py
new file mode 100644
index 0000000..f094294
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,19 @@
+"""January price rise."""
+
+RISE_PERCENT = 5  # all wholesale prices go up by this much
+ROUND_TO = 5  # new prices are rounded up to a multiple of this many pence
+
+
+def new_prices(catalog):
+    """Map each product code to its new wholesale price in pence.
+
+    The rise is RISE_PERCENT, and each new price is rounded up (never down)
+    to the next ROUND_TO pence, so café price boards show whole 5p steps.
+    Uses integer arithmetic so that no rounding error creeps in.
+    """
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + RISE_PERCENT)  # pence times 100
+        step = 100 * ROUND_TO
+        prices[product.code] = -(-raised // step) * ROUND_TO  # ceiling division
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
