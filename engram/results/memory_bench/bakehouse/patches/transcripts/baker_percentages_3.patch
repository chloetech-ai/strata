+++ b/src/bakehouse/recipes.py
@@ -0,0 +1,14 @@
+"""Recipes: ingredient weights as baker's percentages."""
+
+
+def baker_percentages(recipe):
+    """Each ingredient's weight as a percentage of the total flour weight, to one decimal place.
+
+    `recipe` maps ingredient names to grams. Any ingredient whose name contains
+    'flour' (ignoring case) counts as flour. Raises ValueError if there is no
+    flour, or if the flour weighs nothing (the percentages would be undefined).
+    """
+    flour_g = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_g <= 0:
+        raise ValueError("recipe has no flour to base the percentages on")
+    return {name: round(grams / flour_g * 100, 1) for name, grams in recipe.items()}
