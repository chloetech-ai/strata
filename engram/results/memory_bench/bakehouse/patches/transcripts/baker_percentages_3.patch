@@ -0,0 +1,28 @@
+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"strong white flour": 500, "wholemeal flour": 100, "water": 375, "salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"strong white flour": 83.3, "wholemeal flour": 16.7, "water": 62.5, "salt": 1.7},
+        )
+
+    def test_flour_is_matched_ignoring_case(self):
+        recipe = {"FLOUR": 200, "Rye Flour": 100, "water": 150}
+        self.assertEqual(baker_percentages(recipe), {"FLOUR": 66.7, "Rye Flour": 33.3, "water": 50.0})
+
+    def test_no_flour_raises_value_error(self):
+        with self.assertRaisesRegex(ValueError, "no flour"):
+            baker_percentages({"water": 300, "salt": 10})
+
+    def test_zero_flour_raises_value_error(self):
+        with self.assertRaisesRegex(ValueError, "no flour"):
+            baker_percentages({"white flour": 0, "water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
