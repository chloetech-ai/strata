index 3462796..fcdb8b8 100644
--- a/src/bakehouse/orders.py
+++ b/src/bakehouse/orders.py
@@ -68,6 +68,16 @@ def is_delivery_day(day):
     return day.weekday() not in config.CLOSED_WEEKDAYS
 
 
+def next_delivery_day(day):
+    """The first date after `day` on which we bake and deliver."""
+    candidate = day + datetime.timedelta(days=1)
+    for _ in range(7):
+        if is_delivery_day(candidate):
+            return candidate
+        candidate += datetime.timedelta(days=1)
+    raise ValueError("no delivery days are configured")
+
+
