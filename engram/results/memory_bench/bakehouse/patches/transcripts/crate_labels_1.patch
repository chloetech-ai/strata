+"""Crate labels for packing. The packing room's thermal printer is plain ASCII and
+prints 48 characters per line, cutting off anything longer."""
+
+import textwrap
+import unicodedata
+
+LABEL_WIDTH = 48
+
+
+def ascii_text(text):
+    """`text` with accents folded to their base letters and anything else non-ASCII
+    dropped: 'Brötchen' -> 'Brotchen'."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def _fit(text):
+    """`text` cut to the label width so the printer does not lose its end."""
+    return text[:LABEL_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in van run
+    order (route_seq), then by product code. Each label is three or more lines:
+    the customer's name, the quantity and product name, then the allergens in
+    capitals (wrapped, never cut, because the allergen list is required by law)."""
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code, qty in sorted(totals.items()):
+            product = orderbook.catalog.get(product_code)
+            lines = [
+                _fit(ascii_text(customer.name)),
+                _fit(ascii_text(f"{qty} x {product.name}")),
+            ]
+            allergens = ascii_text(product.allergen_text()).upper()
+            if allergens:
+                lines += textwrap.wrap(f"Allergens: {allergens}", LABEL_WIDTH, break_on_hyphens=False)
+            labels.append("\n".join(lines))
+    return labels
