@@ -0,0 +1,17 @@
+"""January's wholesale price rise."""
+
+RISE_PERCENT = 5  # the rise applied to every wholesale price
+ROUND_STEP = 5  # new prices are rounded up to a multiple of this many pence
+
+
+def new_price(price):
+    """A wholesale price in pence after the rise, rounded up to the next 5p.
+
+    Done in whole pence so no float error creeps in: 95p -> 100p, 320p -> 340p.
+    """
+    return -(-price * (100 + RISE_PERCENT) // (100 * ROUND_STEP)) * ROUND_STEP
+
+
+def new_prices(catalog):
+    """Maps each product code in `catalog` to its new wholesale price in pence."""
+    return {product.code: new_price(product.price) for product in catalog}
