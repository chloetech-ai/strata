 @dataclass
 class InvoiceLine:
@@ -41,6 +43,15 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for a customer whose order for one delivery day is worth
+    `subtotal` pence before VAT: config.DELIVERY_CHARGE if under config.DELIVERY_CHARGE_BELOW,
+    else nothing. Exempt customers never pay it."""
+    if customer_code in config.DELIVERY_CHARGE_EXEMPT or subtotal >= config.DELIVERY_CHARGE_BELOW:
+        return 0
+    return config.DELIVERY_CHARGE
+
+
 def invoice_for(orderbook, customer, day):
     """Invoice for what `customer` ordered for delivery on `day`: one line per product,
     at catalog prices, sorted by product code."""
