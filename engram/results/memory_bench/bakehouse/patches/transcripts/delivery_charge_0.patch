+# delivery day is under DELIVERY_CHARGE_BELOW. Customers in DELIVERY_CHARGE_EXEMPT never pay it.
+# From November the charge is 450 under 4000; not coded yet, as it depends on the delivery day.
+DELIVERY_CHARGE = 300
+DELIVERY_CHARGE_BELOW = 2500
+DELIVERY_CHARGE_EXEMPT = ("AIDAN",)
