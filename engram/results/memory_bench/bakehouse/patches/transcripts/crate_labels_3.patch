+"""Crate labels for the packing room."""
+
+
+def crate_labels(orderbook, customers, day):
+    """Text of each crate label for delivery on `day`: one label per customer and product.
+
+    Labels follow the van run (route_seq), then product code. Each label is the
+    customer's name, the quantity and product name, then the allergens (left out
+    when there are none), one per line.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    keys = sorted(totals, key=lambda k: (customers[k[0]].route_seq, k[1]))
+    labels = []
+    for customer_code, product_code in keys:
+        product = orderbook.catalog.get(product_code)
+        lines = [customers[customer_code].name, f"{totals[(customer_code, product_code)]} x {product.name}"]
+        if product.allergens:
+            lines.append(product.allergen_text())
+        labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
