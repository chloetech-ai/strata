@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.day = datetime.date(2026, 10, 20)
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95),
+            Product("RYE", "Seeded rye sourdough", 360, allergens=("wheat", "sesame", "rye")),
+        ])
+        self.customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_van_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day, "GREENWAY", "BAG", 30),
+            OrderLine(self.day, "LUMEN", "RYE", 4),
+            OrderLine(self.day, "LUMEN", "BAG", 9),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, self.day), [
+            "Café Lumen\n9 x Baguette",
+            "Café Lumen\n4 x Seeded rye sourdough\nrye, sesame, wheat",
+            "Greenway Grocers\n30 x Baguette",
+        ])
+
+    def test_quantities_for_the_same_product_are_added_up(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day, "LUMEN", "BAG", 9),
+            OrderLine(self.day, "LUMEN", "BAG", 3),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, self.day), ["Café Lumen\n12 x Baguette"])
+
+    def test_ignores_other_days(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(datetime.date(2026, 10, 21), "LUMEN", "BAG", 9),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, self.day), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
