+class WeekTotalsFileTest(unittest.TestCase):
+    def read_rows(self, path):
+        with open(path, newline="", encoding="utf-8-sig") as f:
+            return list(csv.reader(f))
+
+    def test_totals_in_pounds_for_seven_days_from_week_start(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),                       # first day: counted
+            OrderLine(datetime.date(2026, 10, 26), "LUMEN", "SOU", 10),  # last day: counted
+            OrderLine(datetime.date(2026, 10, 26), "LUMEN", "BAG", 5),
+            OrderLine(datetime.date(2026, 10, 27), "LUMEN", "SOU", 3),   # day after: not counted
+            OrderLine(datetime.date(2026, 10, 19), "AIDAN", "BAG", 9),   # day before: not counted
+        ])
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(book, DAY, path)
+            self.assertEqual(self.read_rows(path), [
+                ["customer", "total_gbp"],
+                ["GREENWAY", "19.00"],
+                ["LUMEN", "36.75"],
+            ])
+
+    def test_no_orders_writes_only_the_header(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        with tempfile.TemporaryDirectory() as folder:
+            path = os.path.join(folder, "week.csv")
+            week_totals_file(OrderBook(catalog), DAY, path)
+            self.assertEqual(self.read_rows(path), [["customer", "total_gbp"]])
+
+
 if __name__ == "__main__":
     unittest.main()
