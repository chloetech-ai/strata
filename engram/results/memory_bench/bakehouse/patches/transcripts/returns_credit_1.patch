+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for the loaves a customer sent back from one delivery.
+
+    Only Greenway's sandwich loaves (SWL) are sale-or-return; anything else earns no
+    credit. Each returned loaf is credited at half its wholesale price, and credit is
+    given for at most 10% of the loaves delivered that day, rounded down. Returns
+    above that cap are not credited."""
+    if customer_code != "GREENWAY" or product_code != "SWL":
+        return 0
+    if delivered < 0 or returned < 0:
+        raise ValueError("delivered and returned must not be negative")
+    creditable = min(returned, delivered // 10)
+    return creditable * catalog.get(product_code).price // 2
