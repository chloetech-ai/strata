+from bakehouse.invoice import Invoice, InvoiceLine, format_pence, invoice_for, invoice_number, returns_credit
 from bakehouse.orders import OrderBook, OrderLine
 from bakehouse.products import Catalog, Product
 
 
+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("BAG", "Baguette", 95)])
+
+    def test_half_price_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 4), 4 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_cap_is_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 10), 10 * 90)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 25), 10 * 90)
+
+    def test_cap_rounds_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 19, 19), 1 * 90)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 9), 0)
+
+    def test_nothing_delivered_nothing_credited(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 0, 5), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 10), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 100, 10), 0)
+
+    def test_negative_counts_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 100, -1)
+
