--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,20 @@
+"""The January price list. All amounts are integer pence."""
+
+# Wholesale prices rise by 5%, and each new price is rounded up to the next
+# 5p (never down), so the cafés' price boards show whole 5p steps.
+RISE_PERCENT = 5
+ROUND_TO = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in `catalog`.
+
+    The catalog itself is not changed; the stored prices stay as they are
+    until the new list is adopted."""
+    prices = {}
+    for product in catalog:
+        raised = product.price * (100 + RISE_PERCENT)  # pence times 100
+        # Round up to a multiple of ROUND_TO pence using integer arithmetic.
+        steps = -(-raised // (100 * ROUND_TO))
+        prices[product.code] = steps * ROUND_TO
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..b95215b
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,36 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rises_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95),  # 99.75 -> 100
+            Product("SOU", "White sourdough", 320),  # 336 -> 340
+            Product("BRO", "Brötchen", 40),  # 42 -> 45
+            Product("FLO", "Florentine", 90),  # 94.5 -> 95
+        ])
+        self.assertEqual(new_prices(catalog), {"BAG": 100, "SOU": 340, "BRO": 45, "FLO": 95})
+
+    def test_price_already_on_a_5p_step_only_rises_by_the_percentage(self):
+        catalog = Catalog([Product("X", "Exact", 100)])  # 105 exactly
+        self.assertEqual(new_prices(catalog), {"X": 105})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("BRO", "Free bread", 0)])
+        self.assertEqual(new_prices(catalog), {"BRO": 0})
+
+    def test_does_not_change_the_catalog(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        new_prices(catalog)
+        self.assertEqual(catalog.get("BAG").price, 95)
+
+    def test_one_entry_per_product(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        self.assertEqual(set(new_prices(catalog)), {"BAG", "SOU"})
+
+
+if __name__ == "__main__":
+    unittest.main()
