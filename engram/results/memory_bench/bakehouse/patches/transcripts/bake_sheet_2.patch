     }
 
 
+def bake_sheet(orderbook, day):
+    """The bake sheet for `day` as text: one line per product, hottest oven first."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    products = sorted((catalog.get(code) for code in rows), key=lambda p: -p.bake_temp)
+    width = max(len(p.name) for p in products)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>10}",
+    ]
+    for product in products:
+        units, batches = rows[product.code]
+        lines.append(
+            f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough_weight_g(product, units):>10,}"
+        )
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays going in the oven: one tray holds one batch, so this is the batch count across all products."""
     return sum(batches for _units, batches in plan_result.values())
