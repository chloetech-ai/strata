+def export_invoices(invoices, path):
+    """Writes one CSV row per invoice: date, customer code, total in pounds before VAT.
+    Pass in the invoices for the quarter; this does not filter by date."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.isoformat(), invoice.customer, f"{invoice.total() / 100:.2f}"])
