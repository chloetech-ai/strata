@@ -0,0 +1,26 @@
+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_relative_to_total_flour(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 100, "Water": 350, "Salt": 10}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong white flour": 83.3,
+            "Wholemeal flour": 16.7,
+            "Water": 58.3,
+            "Salt": 1.7,
+        })
+
+    def test_flour_is_matched_in_any_case(self):
+        recipe = {"FLOUR": 200, "water": 100}
+        self.assertEqual(baker_percentages(recipe), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_recipe_without_flour_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+
+if __name__ == "__main__":
+    unittest.main()
