     return f"LK-{year}-{seq:04d}"
 
 
+def export_invoices(invoices, path):
+    """Writes one CSV row per invoice for the VAT return: delivery date, customer code
+    and total in pence, oldest first. Pass in the quarter's invoices; nothing is filtered by date here."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total_pence"])
+        for invoice in sorted(invoices, key=lambda i: (i.day, i.customer)):
+            writer.writerow([invoice.day.isoformat(), invoice.customer, invoice.total()])
+
+
 def invoice_for(orderbook, customer, day):
