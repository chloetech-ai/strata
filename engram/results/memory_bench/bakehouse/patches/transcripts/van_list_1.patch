+"""The van's run: which customers to visit on a delivery day, in route order."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one line per customer with orders that day.
+
+    Stops are in route order (`route_seq`), each as "seq. name, address, postcode".
+    `customers` is the dict from load_customers.
+    """
+    stops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for c in stops:
+            f.write(f"{c.route_seq}. {c.name}, {c.address}, {c.postcode}\n")
