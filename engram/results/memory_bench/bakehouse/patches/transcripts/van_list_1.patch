+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+
+class DropsFileTest(unittest.TestCase):
+    def test_lists_only_customers_with_orders_that_day_in_route_order(self):
+        day = datetime.date(2026, 10, 20)
+        catalog = Catalog([Product("CRO", "Croissant", 110)])
+        customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "OLDMILL": Customer("OLDMILL", "The Old Mill Tearoom", "Old Mill Yard", "LK3 1MY", 3),
+        }
+        book = OrderBook(catalog, [
+            OrderLine(day, "GREENWAY", "CRO", 10),
+            OrderLine(day, "LUMEN", "CRO", 24),
+            OrderLine(datetime.date(2026, 10, 21), "OLDMILL", "CRO", 5),
+        ])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(book, customers, day, path)
+            with open(path, encoding="utf-8") as f:
+                text = f.read()
+        self.assertEqual(text, "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+                               "4. Greenway Grocers, 88 High Street, LK1 4HS\n")
+
+    def test_no_orders_writes_empty_file(self):
+        day = datetime.date(2026, 10, 20)
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(OrderBook(Catalog([])), {}, day, path)
+            with open(path, encoding="utf-8") as f:
+                self.assertEqual(f.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
