+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong white flour": 500, "Water": 350, "Salt": 10, "Wholemeal flour": 100}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong white flour": 83.3,
+            "Water": 58.3,
+            "Salt": 1.7,
+            "Wholemeal flour": 16.7,
+        })
+
+    def test_flour_match_ignores_case(self):
+        recipe = {"FLOUR": 200, "Rye Flour": 50, "Water": 150}
+        self.assertEqual(baker_percentages(recipe)["Water"], 60.0)
+
+    def test_rounds_to_one_decimal(self):
+        recipe = {"Flour": 300, "Water": 100}
+        self.assertEqual(baker_percentages(recipe)["Water"], 33.3)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
