+"""Recipe maths: each ingredient as a share of the flour in a dough."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: percent of total flour weight, to one decimal place}.
+
+    `recipe` maps ingredient names to grams. Any ingredient whose name contains
+    'flour' (any case) counts as flour.
+    """
+    flour_g = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_g <= 0:
+        raise ValueError("recipe needs flour weighing more than zero to work out baker's percentages")
+    return {name: round(grams / flour_g * 100, 1) for name, grams in recipe.items()}
