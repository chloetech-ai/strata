+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_totals_in_pounds_for_seven_days_from_week_start(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        start = datetime.date(2026, 10, 18)  # a Sunday
+        book = OrderBook(catalog, [
+            OrderLine(start, "LUMEN", "BAG", 5),                              # first day: included
+            OrderLine(start + datetime.timedelta(days=6), "LUMEN", "SOU", 10),  # last day: included
+            OrderLine(start + datetime.timedelta(days=7), "LUMEN", "SOU", 3),   # next week: excluded
+            OrderLine(start - datetime.timedelta(days=1), "GREENWAY", "BAG", 9),  # day before: excluded
+            OrderLine(start + datetime.timedelta(days=2), "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, start, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "19.00"],
+            ["LUMEN", "36.75"],
+        ])
+
+    def test_week_with_no_orders_writes_only_the_header(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        week_totals_file(OrderBook(catalog), DAY, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"]])
+
+    def test_pence_are_padded_to_two_decimals(self):
+        catalog = Catalog([Product("BUN", "Bun", 5)])
+        book = OrderBook(catalog, [OrderLine(DAY, "AIDAN", "BUN", 3)])
+        week_totals_file(book, DAY, self.path)
+        self.assertEqual(self.read_rows()[1], ["AIDAN", "0.15"])
+
+
 if __name__ == "__main__":
     unittest.main()
