+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import load_customers
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import load_catalog
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+
+
+class DropsFileTest(unittest.TestCase):
+    def test_lists_only_customers_with_orders_in_route_order(self):
+        catalog = load_catalog(os.path.join(DATA, "products.csv"))
+        customers = load_customers(os.path.join(DATA, "customers.csv"))
+        day = datetime.date(2026, 10, 20)
+        book = OrderBook(catalog, [
+            OrderLine(day, "GREENWAY", "SWL", 32),
+            OrderLine(day, "LUMEN", "CRO", 24),
+            OrderLine(datetime.date(2026, 10, 21), "HARBOUR", "CRO", 6),
+        ])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.txt")
+            drops_file(book, customers, day, path)
+            with open(path, encoding="utf-8") as f:
+                lines = f.read().splitlines()
+        self.assertEqual(lines[0], "Drops for 2026-10-20")
+        self.assertEqual(lines[1:], [
+            "1. Café Lumen, 14 Mill Lane, LK1 2AB",
+            "4. Greenway Grocers, 88 High Street, LK1 4HS",
+        ])
+
+
+if __name__ == "__main__":
+    unittest.main()
