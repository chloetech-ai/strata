+"""Delivery runs: the van's drops for a day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one line per customer who has
+    orders that day, in route order. `customers` is the dict from load_customers."""
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(f"Drops for {day.isoformat()}\n")
+        for code in codes:
+            c = customers[code]
+            f.write(f"{c.route_seq}. {c.name}, {c.address}, {c.postcode}\n")
