+def bake_sheet(orderbook, day):
+    """Text sheet for `day`: one line per product, hottest oven first.
+
+    Dough is weighed out for whole batches, as Tomasz mixes it, so the weight
+    covers the part of the last batch that is not ordered.
+    """
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    products = sorted((orderbook.catalog.get(code) for code in rows), key=lambda p: -p.bake_temp)
+    width = max(len(p.name) for p in products)
+    lines = [f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}"]
+    for product in products:
+        units, batches = rows[product.code]
+        grams = dough_weight_g(product, batches * product.batch_size)
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {grams:>6} g")
+    return "\n".join(lines)
+
+
 def total_batches(plan_result):
     """Trays going in the oven: one tray holds one batch, so this is the batch count across all products."""
     return sum(batches for _units, batches in plan_result.values())
