+"""Crate labels for packing. The packing room's label printer is plain ASCII and
+prints at most LABEL_WIDTH characters per line; anything longer is cut off."""
+
+import unicodedata
+
+LABEL_WIDTH = 48
+
+
+def _fit(text):
+    """`text` as the printer can print it: accents dropped (e.g. 'Brötchen' -> 'Brotchen'),
+    other non-ASCII characters dropped, and cut to LABEL_WIDTH characters."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return ascii_text[:LABEL_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in van-run order.
+
+    Each label is three lines: the customer's name, the quantity and product name,
+    then the allergens in capitals (the line is left out if the product has none).
+    `customers` is the dict from load_customers.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    ordered = sorted(totals.items(), key=lambda item: (customers[item[0][0]].route_seq, item[0][1]))
+    labels = []
+    for (customer_code, product_code), qty in ordered:
+        product = orderbook.catalog.get(product_code)
+        lines = [
+            _fit(customers[customer_code].name),
+            _fit(f"{qty} x {product.name}"),
+        ]
+        if product.allergens:
+            lines.append(_fit(product.allergen_text().upper()))
+        labels.append("\n".join(lines))
+    return labels
