diff --git a/src/bakehouse/pricing.py b/src/bakehouse/pricing.py
new file mode 100644
index 0000000..d46a2bb
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,17 @@
+"""The January price rise. Prices are whole pence, so the arithmetic stays exact."""
+
+RISE_PERCENT = 5  # the January rise on wholesale prices
+ROUND_UP_TO = 5  # new prices round up to the next multiple of this many pence
+
+
+def new_price(price):
+    """The price after the rise: up by RISE_PERCENT, rounded up to the next 5p, never down."""
+    # price * (1 + RISE_PERCENT/100) pence is price * (100 + RISE_PERCENT) / 100;
+    # dividing that by ROUND_UP_TO gives the number of 5p steps, rounded up.
+    steps = -(-price * (100 + RISE_PERCENT) // (100 * ROUND_UP_TO))
+    return steps * ROUND_UP_TO
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in `catalog`."""
+    return {product.code: new_price(product.price) for product in catalog}
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..4ee37c6
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,31 @@
+import unittest
+
+from bakehouse.pricing import new_price, new_prices
+from bakehouse.products import Catalog, Product
+
+
+class PricingTest(unittest.TestCase):
+    def test_rises_five_percent_and_rounds_up_to_next_5p(self):
+        self.assertEqual(new_price(320), 340)  # 336 -> 340
+        self.assertEqual(new_price(95), 100)  # 99.75 -> 100
+        self.assertEqual(new_price(110), 120)  # 115.5 -> 120
+        self.assertEqual(new_price(35), 40)  # 36.75 -> 40
+
+    def test_price_already_on_a_5p_step_after_rise_stays(self):
+        self.assertEqual(new_price(100), 105)  # exactly 105, not rounded further
+
+    def test_zero_stays_zero(self):
+        self.assertEqual(new_price(0), 0)
+
+    def test_new_prices_maps_every_code_to_its_new_price(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("BAG", "Baguette", 95)])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 100})
+
+    def test_new_prices_leaves_catalog_unchanged(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        new_prices(catalog)
+        self.assertEqual(catalog.get("SOU").price, 320)
+
+
+if __name__ == "__main__":
+    unittest.main()
