diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index 07b9dd8..0ce99c9 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -41,6 +41,16 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for the unsold units `customer_code` sent back from one delivery
+    of `product_code`: each returned unit at catalog price."""
+    if not 0 <= returned <= delivered:
+        raise ValueError(
+            f"{customer_code} returned {returned} of {product_code} but was delivered {delivered}"
+        )
+    return returned * catalog.get(product_code).price
+
+
 def invoice_for(orderbook, customer, day):
     """Invoice for what `customer` ordered for delivery on `day`: one line per product,
     at catalog prices, sorted by product code."""
