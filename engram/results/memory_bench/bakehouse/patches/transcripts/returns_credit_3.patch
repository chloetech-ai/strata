+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SOU", "White sourdough", 320)])
+
+    def test_returned_units_at_catalog_price(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 20, 3), 3 * 320)
+
+    def test_nothing_returned_is_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 20, 0), 0)
+
+    def test_everything_returned(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 20, 20), 20 * 320)
+
+    def test_more_back_than_delivered_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SOU", 20, 21)
+
+    def test_negative_return_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SOU", 20, -1)
+
+
