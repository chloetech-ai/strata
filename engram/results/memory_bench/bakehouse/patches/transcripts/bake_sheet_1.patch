+def bake_sheet(orderbook, day):
+    """Text sheet for `day`: one line per product, hottest oven first, with units, batches and dough to weigh out."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    products = sorted((catalog.get(code) for code in rows), key=lambda p: (-p.bake_temp, p.code))
+    lines = []
+    for product in products:
+        units, batches = rows[product.code]
+        lines.append([product.name, str(units), str(batches), f"{dough_weight_g(product, units)} g"])
+    headers = ["Product", "Units", "Batches", "Dough"]
+    widths = [max(len(text) for text in column) for column in zip(headers, *lines)]
+    out = [f"Bake sheet for {day:%A %d %B %Y}"]
+    out.append("  ".join(h.ljust(w) if i == 0 else h.rjust(w) for i, (h, w) in enumerate(zip(headers, widths))))
+    for line in lines:
+        out.append("  ".join(t.ljust(w) if i == 0 else t.rjust(w) for i, (t, w) in enumerate(zip(line, widths))))
+    return "\n".join(out)
+
+
 def total_batches(plan_result):
     """Trays going in the oven: one tray holds one batch, so this is the batch count across all products."""
     return sum(batches for _units, batches in plan_result.values())
