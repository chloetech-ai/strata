+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` unsold units from one delivery of `product_code`
+    to `customer_code`, at catalog price. Units returned can't exceed units delivered."""
+    if not 0 <= returned <= delivered:
+        raise ValueError(
+            f"{customer_code} returned {returned} of {product_code} but was delivered {delivered}"
+        )
+    return returned * catalog.get(product_code).price
