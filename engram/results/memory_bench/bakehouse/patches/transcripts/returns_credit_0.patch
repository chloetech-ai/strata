+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("CRO", "Croissant", 110), Product("SOU", "White sourdough", 320)])
+
+    def test_returned_units_at_catalog_price(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 12, 3), 3 * 320)
+
+    def test_nothing_returned_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "CRO", 24, 0), 0)
+
+    def test_everything_returned(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "CRO", 24, 24), 24 * 110)
+
+    def test_more_returned_than_delivered_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "CRO", 24, 25)
+
+    def test_negative_returns_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "CRO", 24, -1)
+
+    def test_unknown_product_is_rejected(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "BAG", 24, 1)
+
