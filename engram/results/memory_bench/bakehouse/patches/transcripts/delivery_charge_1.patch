index 07b9dd8..4bae595 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -41,6 +41,19 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, from November
+DELIVERY_CHARGE_BELOW = 4000  # pence: orders under £40.00 pay the charge
+DELIVERY_CHARGE_EXEMPT = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day, where
+    `subtotal` is the order's value in pence before VAT."""
+    if customer_code in DELIVERY_CHARGE_EXEMPT or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def invoice_for(orderbook, customer, day):
     """Invoice for what `customer` ordered for delivery on `day`: one line per product,
     at catalog prices, sorted by product code."""
