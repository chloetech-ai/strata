+class DeliveryChargeTest(unittest.TestCase):
+    def test_order_under_forty_pounds_pays_four_pounds_fifty(self):
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)
+        self.assertEqual(delivery_charge("LUMEN", 500), 450)
+
+    def test_order_of_forty_pounds_or_more_is_free(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+        self.assertEqual(delivery_charge("GREENWAY", 8135), 0)
+
+    def test_st_aidans_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 2100), 0)
+        self.assertEqual(delivery_charge("AIDAN", 4000), 0)
+
