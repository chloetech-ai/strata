+"""Crate labels for packing.
+
+The packing room's label printer prints plain ASCII only, 48 characters per
+line, and cuts off anything past that.
+"""
+
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def ascii_text(text):
+    """`text` as the printer can print it: accents go to their base letter, so 'Brötchen' -> 'Brotchen'.
+    Anything with no ASCII equivalent is dropped."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def label_line(text):
+    """One printed line: ASCII, cut to the printer's width."""
+    return ascii_text(text)[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in route order.
+
+    Each label is three lines: the customer's name, the quantity and the product name,
+    then the allergens in capitals (the law requires them to stand out). The allergen
+    line is left out for products with none.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    keys = sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1]))
+    labels = []
+    for customer_code, product_code in keys:
+        customer = customers[customer_code]
+        product = orderbook.catalog.get(product_code)
+        lines = [customer.name, f"{totals[(customer_code, product_code)]} x {product.name}"]
+        allergens = product.allergen_text()
+        if allergens:
+            lines.append(allergens.upper())
+        labels.append("\n".join(label_line(text) for text in lines))
+    return labels
