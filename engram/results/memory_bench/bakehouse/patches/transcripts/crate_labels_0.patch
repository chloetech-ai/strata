@@ -0,0 +1,69 @@
+import datetime
+import os
+import unittest
+
+from bakehouse.customers import load_customers
+from bakehouse.labels import LINE_WIDTH, ascii_text, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DATA = os.path.join(os.path.dirname(__file__), "..", "data")
+DAY = datetime.date(2026, 11, 3)
+
+
+def catalog():
+    return Catalog([
+        Product("SOU", "White sourdough", 320, 10, allergens=("wheat",)),
+        Product("CRO", "Croissant", 110, 24, allergens=("wheat", "milk", "eggs")),
+        Product("BRO", "Brötchen", 40, 30),
+    ])
+
+
+def customers():
+    return load_customers(os.path.join(DATA, "customers.csv"))
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "GREENWAY", "SOU", 4),
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY, "LUMEN", "CRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Cafe Lumen\n12 x Croissant\nEGGS, MILK, WHEAT",
+            "Cafe Lumen\n2 x White sourdough\nWHEAT",
+            "Greenway Grocers\n4 x White sourdough\nWHEAT",
+        ])
+
+    def test_quantities_for_the_same_customer_and_product_are_added(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY, "LUMEN", "SOU", 3),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n5 x White sourdough\nWHEAT"])
+
+    def test_product_without_allergens_has_no_allergen_line(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "BRO", 30)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n30 x Brotchen"])
+
+    def test_other_days_are_ignored(self):
+        book = OrderBook(catalog(), [OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 2)])
+        self.assertEqual(crate_labels(book, customers(), DAY), [])
+
+    def test_lines_are_cut_to_the_printer_width(self):
+        cat = catalog()
+        cat.add(Product("LNG", "A" * 60, 100, 1, allergens=("wheat",)))
+        book = OrderBook(cat, [OrderLine(DAY, "AIDAN", "LNG", 1)])
+        label = crate_labels(book, customers(), DAY)[0]
+        self.assertEqual(label.split("\n")[1], "1 x " + "A" * (LINE_WIDTH - 4))
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+
+    def test_ascii_text_drops_accents(self):
+        self.assertEqual(ascii_text("Brötchen"), "Brotchen")
+        self.assertEqual(ascii_text("Café"), "Cafe")
+
+
+if __name__ == "__main__":
+    unittest.main()
