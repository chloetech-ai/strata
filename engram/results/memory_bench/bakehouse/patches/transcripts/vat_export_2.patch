+def _pounds(pence):
+    """Pence as plain pounds for a CSV: 1234 -> '12.34', -300 -> '-3.00'."""
+    sign = "-" if pence < 0 else ""
+    pounds, p = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{p:02d}"
+
+
+def export_invoices(invoices, path):
+    """Writes one row per invoice for the VAT return: date (DD/MM/YYYY), customer code
+    and total in pounds, before VAT, under a header row."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds(invoice.total())])
+
+
 def invoice_number(year, seq):
