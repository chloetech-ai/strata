+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def test_lists_only_customers_with_orders_in_route_order(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "2 High St", "AB1 2CD", 3),
+            "GREENWAY": Customer("GREENWAY", "Greenway Stores", "9 Mill Rd", "AB3 4EF", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "5 Quay", "AB5 6GH", 2),
+        }
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+            OrderLine(DAY, "GREENWAY", "BAG", 7),
+            OrderLine(datetime.date(2026, 10, 21), "HARBOUR", "BAG", 2),
+        ])
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "drops.txt")
+            drops_file(book, customers, DAY, path)
+            with open(path, encoding="utf-8") as f:
+                text = f.read()
+        self.assertEqual(text, "1. Greenway Stores, 9 Mill Rd, AB3 4EF\n3. Lumen Cafe, 2 High St, AB1 2CD\n")
+
+    def test_no_orders_writes_empty_file(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        customers = {"LUMEN": Customer("LUMEN", "Lumen Cafe", "2 High St", "AB1 2CD", 1)}
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "drops.txt")
+            drops_file(OrderBook(catalog), customers, DAY, path)
+            with open(path, encoding="utf-8") as f:
+                self.assertEqual(f.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
