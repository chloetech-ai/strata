+def week_totals_file(orderbook, week_start, path):
+    """Writes one row per customer with their order total in pounds for the seven days from `week_start`.
+
+    Built for Excel on a German-locale PC: semicolon separators, a comma as the decimal separator,
+    and a UTF-8 byte-order mark so umlauts display correctly.
+    """
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = Counter()
+    for line in orderbook:
+        if week_start <= line.day <= week_end:
+            totals[line.customer] += line.qty * orderbook.catalog.get(line.product).price
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";", lineterminator="\r\n")
+        writer.writerow(["Customer", "Total (£)"])
+        for customer, pence in sorted(totals.items()):
+            pounds, rest = divmod(pence, 100)
+            writer.writerow([customer, f"{pounds},{rest:02d}"])
+
+
