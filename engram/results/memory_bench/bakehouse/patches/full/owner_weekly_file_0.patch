+import csv
+import os
+import tempfile
+
+from bakehouse.reports import day_summary, top_products, week_totals_file
 
 DAY = datetime.date(2026, 10, 20)
 
 
+class WeekTotalsFileTest(unittest.TestCase):
+    def test_semicolons_comma_decimals_and_only_the_week(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("CRO", "Croissant", 110)])
+        week_start = DAY
+        book = OrderBook(catalog, [
+            OrderLine(week_start, "CAFÉ", "SOU", 6),
+            OrderLine(week_start + datetime.timedelta(days=6), "CAFÉ", "CRO", 5),
+            OrderLine(week_start + datetime.timedelta(days=7), "CAFÉ", "SOU", 100),
+            OrderLine(week_start + datetime.timedelta(days=1), "LUMEN", "CRO", 3),
+        ])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, "rb") as f:
+                raw = f.read()
+            self.assertTrue(raw.startswith(b"\xef\xbb\xbf"))
+            with open(path, encoding="utf-8-sig", newline="") as f:
+                rows = list(csv.reader(f, delimiter=";"))
+        self.assertEqual(rows, [
+            ["Customer", "Total (£)"],
+            ["CAFÉ", "24,70"],
+            ["LUMEN", "3,30"],
+        ])
+
