+"""The van's drops for a delivery day, in the order Dev drives them."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the Stopwise import for `day`: one row per customer with orders, in route order.
+
+    `customers` is the dict from load_customers, keyed by customer code.
+    """
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, lineterminator="\n")
+        writer.writerow(["Name", "Address", "Postcode", "Notes"])
+        for code in codes:
+            customer = customers[code]
+            writer.writerow([customer.name, customer.address, customer.postcode, ""])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
