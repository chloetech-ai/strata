+"""Wholesale price changes."""
+
+PRICE_RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_price(price):
+    """`price` raised by PRICE_RISE_PERCENT, rounded up to the next ROUND_TO_PENCE, in whole pence."""
+    raised = price * (100 + PRICE_RISE_PERCENT)  # the raised price, times 100
+    step = 100 * ROUND_TO_PENCE
+    return -(-raised // step) * ROUND_TO_PENCE
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in the catalog."""
+    return {product.code: new_price(product.price) for product in catalog}
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
