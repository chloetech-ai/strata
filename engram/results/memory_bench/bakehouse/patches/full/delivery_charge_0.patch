+class DeliveryChargeTest(unittest.TestCase):
+    def test_november_rates(self):
+        november = datetime.date(2026, 11, 2)
+        self.assertEqual(delivery_charge("LUMEN", 3999, november), 450)
+        self.assertEqual(delivery_charge("LUMEN", 4000, november), 0)
+        self.assertEqual(delivery_charge("LUMEN", 2500, november), 450)
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)  # no day given: November rates
+
+    def test_rates_before_november(self):
+        october = datetime.date(2026, 10, 31)
+        self.assertEqual(delivery_charge("LUMEN", 2499, october), 300)
+        self.assertEqual(delivery_charge("LUMEN", 2500, october), 0)
+        self.assertEqual(delivery_charge("LUMEN", 3000, october), 0)
+
+    def test_st_aidans_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 1000), 0)
+        self.assertEqual(delivery_charge("AIDAN", 1000, datetime.date(2026, 10, 1)), 0)
+
+    def test_no_order_no_charge(self):
