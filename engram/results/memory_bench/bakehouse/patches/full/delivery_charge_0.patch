+DELIVERY_EXEMPT = ("AIDAN",)  # St Aidan's contract price already includes delivery
+NEW_DELIVERY_RATES_FROM = datetime.date(2026, 11, 1)
+
+
+def delivery_charge(customer_code, subtotal, day=None):
+    """Delivery charge in pence for a customer's order value `subtotal` (pence, before VAT).
+
+    From November: £4.50 on orders under £40.00. Before that: £3.00 under £25.00.
+    `day` is the delivery day; without it the November rates apply.
+    """
+    if customer_code in DELIVERY_EXEMPT or subtotal <= 0:
+        return 0
+    if day is not None and day < NEW_DELIVERY_RATES_FROM:
+        threshold, charge = 2500, 300
+    else:
+        threshold, charge = 4000, 450
+    return charge if subtotal < threshold else 0
+
+
