+"""Crate labels for the packing room's thermal printer.
+
+The printer takes plain ASCII only and prints 48 characters per line, cutting off anything longer.
+"""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def _ascii(text):
+    """Plain ASCII: accented letters become their base letter ('é' -> 'e')."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _wrap(text):
+    """Lines of at most LINE_WIDTH characters. Wrapped, not cut, so nothing is lost."""
+    return textwrap.wrap(_ascii(text), LINE_WIDTH) or [""]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, in driving order.
+
+    Each label is the customer's name, the quantity and product name, then the
+    allergens in capitals if the product has any. `customers` is the dict that
+    load_customers returns.
+    """
+    units = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        units[key] = units.get(key, 0) + line.qty
+
+    labels = []
+    for (customer, code), qty in sorted(units.items(), key=lambda item: (customers[item[0][0]].route_seq, item[0][1])):
+        product = orderbook.catalog.get(code)
+        text = _wrap(customers[customer].name) + _wrap(f"{qty} {product.name}")
+        if product.allergens:
+            text += _wrap("ALLERGENS: " + product.allergen_text().upper())
+        labels.append("\n".join(text))
+    return labels
