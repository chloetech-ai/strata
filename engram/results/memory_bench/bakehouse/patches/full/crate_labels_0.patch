+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+        }
+        self.catalog = Catalog([
+            Product("CRO", "Croissant", 110, allergens=("eggs", "milk", "wheat")),
+            Product("BRO", "Brötchen", 40),
+            Product("BAG", "Baguette", 95, allergens=("wheat",)),
+        ])
+
+    def test_one_label_per_customer_and_product_in_driving_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 25),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "LUMEN", "CRO", 6),
+            OrderLine(DAY, "LUMEN", "BRO", 30),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n30 Brotchen",
+            "Cafe Lumen\n30 Croissant\nALLERGENS: EGGS, MILK, WHEAT",
+            "Greenway Grocers\n25 Baguette\nALLERGENS: WHEAT",
+        ])
+
+    def test_labels_fit_the_printer_and_long_allergen_lists_are_wrapped(self):
+        catalog = Catalog([Product("X", "Long product", 100, allergens=("celery", "eggs", "lupin", "milk", "mustard", "nuts", "soya", "sulphites", "wheat"))])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "X", 1)])
+        (label,) = crate_labels(book, self.customers, DAY)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertIn("CELERY", label.replace("\n", " "))
+        self.assertIn("WHEAT", label.replace("\n", " "))
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog), self.customers, DAY), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
