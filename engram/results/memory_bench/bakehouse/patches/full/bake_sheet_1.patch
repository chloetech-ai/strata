     return sum(batches for _, batches in plan_result.values())
 
 
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`, hottest oven first: product, units, batches and dough grams."""
+    rows = [
+        (orderbook.catalog.get(code), units, batches)
+        for code, (units, batches) in plan(orderbook, day).items()
+    ]
+    rows.sort(key=lambda row: (-row[0].bake_temp, row[0].code))
+    width = max((len(product.name) for product, _, _ in rows), default=0)
+    lines = [f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>9}"]
+    for product, units, batches in rows:
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough_weight_g(product, units):>9}")
+    return "\n".join(lines)
+
+
 def plan(orderbook, day):
     """{product code: (units, batches)} for everything ordered for delivery on `day`."""
     totals = {}
