@@ -0,0 +1,41 @@
+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def test_drops_in_driving_order_for_customers_with_orders(self):
+        customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+        }
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "GREENWAY", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "SOU", 2),
+        ])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "drops.csv")
+            drops_file(book, customers, DAY, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["Name", "Address", "Postcode", "Notes"],
+            ["Café Lumen", "14 Mill Lane", "LK1 2AB", ""],
+            ["Greenway Grocers", "88 High Street", "LK1 4HS", ""],
+        ])
+
+
+if __name__ == "__main__":
+    unittest.main()
