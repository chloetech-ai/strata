+class ExportInvoicesTest(unittest.TestCase):
+    def test_rows_have_date_customer_and_pounds(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 2), [InvoiceLine("WRL", 60, 35), InvoiceLine("BAG", 1, 5)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 3), [InvoiceLine("SWL", 1, -180)]),
+        ]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, encoding="utf-8") as f:
+                text = f.read()
+        self.assertEqual(text, "date,customer,total\n"
+                               "01/10/2026,LUMEN,45.60\n"
+                               "02/10/2026,AIDAN,21.05\n"
+                               "03/10/2026,GREENWAY,-1.80\n")
+
+    def test_empty_export_has_only_header(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices([], path)
+            with open(path, encoding="utf-8") as f:
+                self.assertEqual(f.read(), "date,customer,total\n")
+
