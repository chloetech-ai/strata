 import datetime
 from dataclasses import dataclass, field
 from typing import List
@@ -33,6 +34,25 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+def pounds_text(pence):
+    """Pounds with two decimals and no currency sign, e.g. '12.50', for Ledgerly imports."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Writes one CSV row per invoice (date, customer, total) for Ledgerly.
+
+    Dates are DD/MM/YYYY and totals are pounds with two decimals, as Ledgerly expects.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, lineterminator="\n")
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, pounds_text(invoice.total())])
+
+
 def format_pence(pence):
