+def day_summary(orderbook, day):
+    """{customer code: order value in pence} for everything delivered on `day`, before VAT."""
+    return _value_by_customer(orderbook, day, day)
+
+
+def _decimal_comma(pence):
+    """Pounds with a comma before the pence, as German Excel expects: 1234 gives '12,34'."""
+    pounds, rest = divmod(pence, 100)
+    return f"{pounds},{rest:02d}"
+
+
+def week_totals_file(orderbook, week_start, path):
+    """Writes one row per customer with their order total in pounds for the seven days from `week_start`.
+
+    Semicolon-separated with a comma decimal separator, for German-set Excel. The file starts with a
+    byte-order mark so accented names open correctly.
+    """
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = _value_by_customer(orderbook, week_start, week_end)
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total"])
+        for code in sorted(totals):
+            writer.writerow([code, _decimal_comma(totals[code])])
