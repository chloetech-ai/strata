+"""Wholesale price changes."""
+
+# Each new price is 5% up, rounded up to the next 5p (never down).
+RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_price(price):
+    """The price after the January rise, in pence."""
+    # price * (100 + RISE_PERCENT) / 100, rounded up to a multiple of ROUND_TO_PENCE,
+    # done in integers: ceil(x / 500) * 5 for x = price * 105.
+    scale = 100 * ROUND_TO_PENCE
+    raised = price * (100 + RISE_PERCENT)
+    return -(-raised // scale) * ROUND_TO_PENCE
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in `catalog`."""
+    return {product.code: new_price(product.price) for product in catalog}
