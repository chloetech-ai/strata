@@ -0,0 +1,70 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels, to_ascii
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        "AIDAN": Customer("AIDAN", "St Aidan's Primary School", "School Road", "LK4 9SA", 5),
+    }
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        catalog = Catalog([
+            Product("CRO", "Croissant", 110, allergens=("eggs", "milk", "wheat")),
+            Product("SOU", "White sourdough", 320, allergens=("wheat",)),
+        ])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "AIDAN", "CRO", 48),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "Cafe Lumen\n24 x Croissant\nEGGS, MILK, WHEAT",
+            "Cafe Lumen\n6 x White sourdough\nWHEAT",
+            "St Aidan's Primary School\n48 x Croissant\nEGGS, MILK, WHEAT",
+        ])
+
+    def test_text_is_ascii_and_fits_the_line_width(self):
+        catalog = Catalog([Product("BRO", "Brötchen mit " + "x" * 60, 40, allergens=("wheat",))])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BRO", 30)])
+        (label,) = crate_labels(book, customers(), DAY)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+            self.assertTrue(line.isascii())
+        self.assertTrue(label.startswith("Cafe Lumen\n30 x Brotchen mit "))
+
+    def test_long_allergen_list_wraps_instead_of_being_cut(self):
+        allergens = ("celery", "eggs", "fish", "gluten", "lupin", "milk", "molluscs", "mustard", "nuts", "peanuts", "sesame", "soya")
+        catalog = Catalog([Product("BIG", "Big loaf", 100, allergens=allergens)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BIG", 1)])
+        (label,) = crate_labels(book, customers(), DAY)
+        allergen_lines = label.split("\n")[2:]
+        self.assertGreater(len(allergen_lines), 1)
+        words = " ".join(allergen_lines).replace(",", "").split()
+        self.assertEqual(words, [a.upper() for a in sorted(allergens)])
+
+    def test_no_allergens_gives_no_allergen_line(self):
+        catalog = Catalog([Product("PLAIN", "Plain roll", 35)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "PLAIN", 30)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n30 x Plain roll"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(Catalog()), customers(), DAY), [])
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_accents_are_dropped(self):
+        self.assertEqual(to_ascii("Café Brötchen Ångström"), "Cafe Brotchen Angstrom")
+
+
+if __name__ == "__main__":
+    unittest.main()
