+"""Crate labels for the packing room's thermal printer.
+
+The printer only prints plain ASCII and has 48 characters per line, so text is
+converted to ASCII and cut or wrapped to fit.
+"""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def to_ascii(text):
+    """Drops accents, so 'Café' becomes 'Cafe' and 'Brötchen' becomes 'Brotchen'."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, in route order.
+
+    Each label is a name line, a quantity and product line, then the allergens in
+    capitals. Long name and product lines are cut to fit; allergens are wrapped
+    over more lines, never cut, because they must be readable.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        qty_by_product = {}
+        for line in orderbook.lines_for(code, day):
+            qty_by_product[line.product] = qty_by_product.get(line.product, 0) + line.qty
+        for product_code, qty in sorted(qty_by_product.items()):
+            product = orderbook.catalog.get(product_code)
+            allergens = to_ascii(product.allergen_text()).upper()
+            lines = [
+                to_ascii(customers[code].name)[:LINE_WIDTH],
+                f"{qty} x {to_ascii(product.name)}"[:LINE_WIDTH],
+                *textwrap.wrap(allergens, LINE_WIDTH),
+            ]
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
