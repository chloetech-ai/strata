+"""Dates that move from year to year, for planning seasonal bakes."""
+
+import datetime
+
+
+def easter_sunday(year):
+    """Date of Easter Sunday in the Western church, Gregorian calendar (Anonymous Gregorian algorithm).
+
+    Valid for years 1900 to 2199.
+    """
+    if not 1900 <= year <= 2199:
+        raise ValueError(f"year must be between 1900 and 2199, got {year}")
+    a = year % 19
+    b, c = divmod(year, 100)
+    d, e = divmod(b, 4)
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i, k = divmod(c, 4)
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month = (h + l - 7 * m + 114) // 31
+    day = (h + l - 7 * m + 114) % 31 + 1
+    return datetime.date(year, month, day)
diff --git a/tests/test_seasons.py b/tests/test_seasons.py
