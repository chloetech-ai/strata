@@ -130,6 +130,18 @@ class SaleOrReturnTest(unittest.TestCase):
         self.assertEqual(sale_or_return_credit("GREENWAY", "BAG", 95, delivered=32, returned=5), 0)
 
 
+class NextDeliveryDayTest(unittest.TestCase):
+    def test_first_delivery_day_after_each_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            nxt = next_delivery_day(day)
+            self.assertGreater(nxt, day)
+            self.assertTrue(is_delivery_day(nxt))
+            # every day in between is a closed day
+            between = [day + datetime.timedelta(days=i) for i in range(1, (nxt - day).days)]
+            self.assertFalse(any(is_delivery_day(d) for d in between))
+
+
 class CutoffTest(unittest.TestCase):
     def cutoff_on(self, delivery_day):
         return datetime.datetime.combine(delivery_day - datetime.timedelta(days=1), config.ORDER_CUTOFF)
