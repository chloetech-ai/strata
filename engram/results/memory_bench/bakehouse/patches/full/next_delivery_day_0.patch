+class NextDeliveryDayTest(unittest.TestCase):
+    def test_skips_closed_days(self):
+        sunday = datetime.date(2026, 10, 18)
+        monday = datetime.date(2026, 10, 19)
+        with mock.patch.object(config, "CLOSED_WEEKDAYS", (0,)):
+            self.assertEqual(next_delivery_day(sunday), datetime.date(2026, 10, 20))
+            self.assertEqual(next_delivery_day(monday - datetime.timedelta(days=1)), datetime.date(2026, 10, 20))
+
+    def test_next_day_when_it_is_open(self):
+        tuesday = datetime.date(2026, 10, 20)
+        with mock.patch.object(config, "CLOSED_WEEKDAYS", (0,)):
+            self.assertEqual(next_delivery_day(tuesday), datetime.date(2026, 10, 21))
+
+    def test_all_days_closed_rejected(self):
+        with mock.patch.object(config, "CLOSED_WEEKDAYS", tuple(range(7))):
+            with self.assertRaises(ValueError):
+                next_delivery_day(DAY)
+
