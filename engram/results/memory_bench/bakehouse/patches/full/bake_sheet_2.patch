     return sum(batches for _, batches in plan_result.values())
 
 
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first."""
+    rows = []
+    for code, (units, batches) in plan(orderbook, day).items():
+        product = orderbook.catalog.get(code)
+        rows.append((product, units, batches))
+    rows.sort(key=lambda row: (-row[0].bake_temp, row[0].code))
+    width = max((len(product.name) for product, _, _ in rows), default=0)
+    lines = [f"{'Product':<{width}}  {'Oven':>5}  {'Units':>5}  {'Batches':>7}  {'Dough':>8}"]
+    for product, units, batches in rows:
+        lines.append(
+            f"{product.name:<{width}}  {product.bake_temp:>4}C  {units:>5}  {batches:>7}  "
+            f"{dough_weight_g(product, units):>6} g"
+        )
+    if not rows:
+        lines.append("Nothing to bake")
+    return "\n".join(lines)
+
+
 def plan(orderbook, day):
