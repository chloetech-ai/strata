+++ b/tests/test_pricing.py
@@ -0,0 +1,26 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_five_percent_rounded_up_to_the_next_5p(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),  # 336 -> 340
+            Product("BAG", "Baguette", 95),  # 99.75 -> 100
+            Product("CRO", "Croissant", 110),  # 115.5 -> 120
+        ])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 100, "CRO": 120})
+
+    def test_exact_multiple_of_5p_is_not_bumped(self):
+        catalog = Catalog([Product("BRO", "Brötchen", 100)])  # 105 exactly
+        self.assertEqual(new_prices(catalog), {"BRO": 105})
+
+    def test_never_rounds_down(self):
+        catalog = Catalog([Product("FLO", "Florentine", 90)])  # 94.5 -> 95, not 90
+        self.assertEqual(new_prices(catalog), {"FLO": 95})
+
+
+if __name__ == "__main__":
+    unittest.main()
