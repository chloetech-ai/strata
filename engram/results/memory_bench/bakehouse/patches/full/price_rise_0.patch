index 0000000..f17c632
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,17 @@
+"""Wholesale price changes."""
+
+PRICE_RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} after the price rise.
+
+    Each price goes up by PRICE_RISE_PERCENT and is rounded up, never down,
+    to the next ROUND_TO_PENCE pence.
+    """
+    prices = {}
+    for product in catalog:
+        raised = -(-product.price * (100 + PRICE_RISE_PERCENT) // 100)  # ceiling, in pence
+        prices[product.code] = -(-raised // ROUND_TO_PENCE) * ROUND_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
