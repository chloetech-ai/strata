+"""Recipes: ingredient weights, shown as baker's percentages of the flour."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: weight as a percentage of the total flour, to one decimal place}.
+
+    Any ingredient whose name contains 'flour' (in any case) counts as flour.
+    """
+    flour_total = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_total <= 0:
+        raise ValueError("recipe has no flour, so baker's percentages cannot be worked out")
+    return {name: round(grams / flour_total * 100, 1) for name, grams in recipe.items()}
