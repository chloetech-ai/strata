@@ -0,0 +1,26 @@
+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour(self):
+        recipe = {"Strong white flour": 1000, "Wholemeal Flour": 200, "Water": 700, "Salt": 20, "Yeast": 10}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong white flour": 83.3,
+            "Wholemeal Flour": 16.7,
+            "Water": 58.3,
+            "Salt": 1.7,
+            "Yeast": 0.8,
+        })
+
+    def test_flour_match_ignores_case(self):
+        self.assertEqual(baker_percentages({"FLOUR": 500, "water": 250}), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_no_flour_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 700, "Salt": 20})
+
+
+if __name__ == "__main__":
+    unittest.main()
