+from bakehouse.reports import day_summary, top_products, week_totals_file
 
 DAY = datetime.date(2026, 10, 20)
 
 
+class WeekTotalsFileTest(unittest.TestCase):
+    def test_semicolons_comma_decimals_and_bom(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("CRO", "Croissant", 110), Product("FREE", "Taster", 5)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 1),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 9),
+            OrderLine(DAY + datetime.timedelta(days=3), "AIDAN", "CRO", 48),
+            OrderLine(DAY, "GREENWAY", "FREE", 1),
+        ])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, DAY, path)
+            with open(path, "rb") as f:
+                raw = f.read()
+        self.assertTrue(raw.startswith(b"\xef\xbb\xbf"))
+        self.assertEqual(
+            raw[3:].decode("utf-8"),
+            "Customer;Total (GBP)\r\nAIDAN;52,80\r\nGREENWAY;0,05\r\nLUMEN;22,40\r\n",
+        )
+
