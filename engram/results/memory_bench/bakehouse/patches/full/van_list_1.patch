+"""The van's drops for a day, in the format Stopwise imports."""
+
+import csv
+
+HEADER = ["Name", "Address", "Postcode", "Notes"]
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes one row per customer with orders on `day`, in driving order (route_seq).
+
+    `customers` is the dict from load_customers. The Notes column is left empty.
+    """
+    drops = sorted(
+        (customers[code] for code in orderbook.customers_for(day)),
+        key=lambda c: c.route_seq,
+    )
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(HEADER)
+        for customer in drops:
+            writer.writerow([customer.name, customer.address, customer.postcode, ""])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
