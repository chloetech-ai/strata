+def export_invoices(invoices, path):
+    """Writes one row per invoice for Ledgerly: date (DD/MM/YYYY), customer code, total in pounds.
+
+    Amounts are written in pounds with two decimals, e.g. 12.50; the totals are
+    kept in integer pence until the last step, so no rounding errors creep in.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, lineterminator="\n")
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, pence = divmod(abs(total), 100)
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, f"{sign}{pounds}.{pence:02d}"])
+
