+"""Crate labels for packing: one label per customer and product for a delivery day."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48  # characters per line on the packing room's label printer
+
+
+def ascii_only(text):
+    """Plain ASCII for the printer: accents are dropped, so 'Café' becomes 'Cafe'."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _wrap(text):
+    return textwrap.wrap(ascii_only(text), LINE_WIDTH, break_long_words=True)
+
+
+def crate_labels(orderbook, customers, day):
+    """Label text for every customer and product ordered for `day`.
+
+    Labels run in route order. Each has the customer's name, then the quantity
+    and product name, then the allergens in capitals. Long lines wrap, never cut.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        qty_by_product = {}
+        for line in orderbook.lines_for(code, day):
+            qty_by_product[line.product] = qty_by_product.get(line.product, 0) + line.qty
+        for product_code in sorted(qty_by_product):
+            product = orderbook.catalog.get(product_code)
+            text = [customers[code].name, f"{qty_by_product[product_code]} x {product.name}"]
+            allergens = product.allergen_text()
+            if allergens:
+                text.append(allergens.upper())
+            lines = []
+            for part in text:
+                lines.extend(_wrap(part))
+            labels.append("\n".join(lines))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
