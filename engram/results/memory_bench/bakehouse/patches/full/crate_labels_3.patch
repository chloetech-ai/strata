@@ -0,0 +1,59 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, ascii_only, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 2),
+        "AIDAN": Customer("AIDAN", "St Aidan's Primary School", "School Road", "LK4 9SA", 1),
+    }
+
+
+def catalog():
+    return Catalog([
+        Product("CRO", "Croissant", 110, batch_size=24, allergens=("wheat", "milk", "eggs")),
+        Product("BRO", "Brötchen", 40, batch_size=30, allergens=("wheat",)),
+        Product("PLN", "Plain roll", 35, batch_size=30),
+    ])
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY, "LUMEN", "BRO", 30),
+            OrderLine(DAY, "AIDAN", "PLN", 60),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), [
+            "St Aidan's Primary School\n60 x Plain roll",
+            "Cafe Lumen\n30 x Brotchen\nWHEAT",
+            "Cafe Lumen\n24 x Croissant\nEGGS, MILK, WHEAT",
+        ])
+
+    def test_labels_are_plain_ascii(self):
+        self.assertEqual(ascii_only("Café Brötchen"), "Cafe Brotchen")
+
+    def test_long_lines_wrap_and_allergens_are_kept(self):
+        long_name = "A" * 40 + " Bakery and Tea Rooms Limited"
+        cust = {"LUMEN": Customer("LUMEN", long_name, "14 Mill Lane", "LK1 2AB", 1)}
+        book = OrderBook(Catalog([Product("CRO", "Croissant", 110, allergens=("wheat", "milk", "eggs", "nuts", "soya", "sesame"))]), [
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+        ])
+        (label,) = crate_labels(book, cust, DAY)
+        lines = label.split("\n")
+        self.assertTrue(all(len(line) <= LINE_WIDTH for line in lines))
+        self.assertIn("EGGS, MILK, NUTS, SESAME, SOYA, WHEAT", " ".join(lines))
+
+    def test_no_orders_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(catalog()), customers(), DAY), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
