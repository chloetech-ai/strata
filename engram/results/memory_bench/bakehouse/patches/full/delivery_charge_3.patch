+DELIVERY_CHARGE = 450  # pence, from November
+DELIVERY_CHARGE_BELOW = 4000  # orders under this value (pence, before VAT) pay the charge
+DELIVERY_FREE_CUSTOMERS = ("AIDAN",)  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order worth `subtotal` pence before VAT."""
+    if customer_code in DELIVERY_FREE_CUSTOMERS or subtotal <= 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_CHARGE_BELOW else 0
+
+
