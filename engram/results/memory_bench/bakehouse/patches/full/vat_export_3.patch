+def export_invoices(invoices, path):
+    """Writes one row per invoice for Ledgerly: date (DD/MM/YYYY), customer code, total in pounds like 12.50.
+
+    Totals are before VAT, which Ledgerly handles.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            pence = invoice.total()
+            sign = "-" if pence < 0 else ""
+            pounds, rest = divmod(abs(pence), 100)
+            writer.writerow([f"{invoice.day:%d/%m/%Y}", invoice.customer, f"{sign}{pounds}.{rest:02d}"])
+
+
