+"""Recipes, in the baker's percentage form."""
+
+
+def baker_percentages(recipe):
+    """Each ingredient's weight as a percentage of the total flour weight, to one decimal.
+
+    `recipe` maps ingredient names to grams. Any ingredient whose name contains
+    'flour' (any case) counts as flour.
+    """
+    flour_total = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_total <= 0:
+        raise ValueError("recipe has no flour")
+    return {name: round(grams / flour_total * 100, 1) for name, grams in recipe.items()}
