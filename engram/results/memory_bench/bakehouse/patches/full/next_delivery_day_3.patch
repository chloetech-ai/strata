 from bakehouse.products import Catalog, Product
 
 DAY = datetime.date(2026, 10, 20)
@@ -130,6 +130,22 @@ class SaleOrReturnTest(unittest.TestCase):
         self.assertEqual(sale_or_return_credit("GREENWAY", "BAG", 95, delivered=32, returned=5), 0)
 
 
+class NextDeliveryDayTest(unittest.TestCase):
+    def test_first_delivery_day_after_given_day(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            nxt = next_delivery_day(day)
+            self.assertGreater(nxt, day)
+            self.assertTrue(is_delivery_day(nxt))
+            # no delivery day in between
+            between = [day + datetime.timedelta(days=k) for k in range(1, (nxt - day).days)]
+            self.assertFalse(any(is_delivery_day(d) for d in between))
+
+    def test_skips_a_closed_day(self):
+        closed = next(DAY + datetime.timedelta(days=k) for k in range(7) if not is_delivery_day(DAY + datetime.timedelta(days=k)))
+        self.assertEqual(next_delivery_day(closed - datetime.timedelta(days=1)), closed + datetime.timedelta(days=1))
+
+
 class CutoffTest(unittest.TestCase):
     def cutoff_on(self, delivery_day):
         return datetime.datetime.combine(delivery_day - datetime.timedelta(days=1), config.ORDER_CUTOFF)
