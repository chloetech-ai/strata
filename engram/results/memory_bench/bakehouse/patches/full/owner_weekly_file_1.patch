+from bakehouse.reports import day_summary, top_products, week_totals_file
 
 DAY = datetime.date(2026, 10, 20)
 
 
+class WeekTotalsFileTest(unittest.TestCase):
+    def test_one_row_per_customer_in_german_csv(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("CRO", "Croissant", 110)])
+        week_start = DAY
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "CRO", 24),
+            OrderLine(DAY + datetime.timedelta(days=1), "AIDAN", "CRO", 5),
+            OrderLine(DAY + datetime.timedelta(days=7), "AIDAN", "CRO", 99),
+        ])
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, encoding="utf-8-sig", newline="") as f:
+                rows = list(csv.reader(f, delimiter=";"))
+        self.assertEqual(rows, [
+            ["Customer", "Total (£)"],
+            ["AIDAN", "5,50"],
+            ["LUMEN", "45,60"],
+        ])
+
