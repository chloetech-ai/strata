+def week_totals_file(orderbook, week_start, path):
+    """Writes each customer's order total for the seven days from `week_start` to `path`.
+
+    Written for the office PC's German settings: semicolon separators, a comma
+    decimal separator, and a UTF-8 byte-order mark so umlauts display correctly.
+    Customers with no orders that week are left out.
+    """
+    totals = Counter()
+    for offset in range(7):
+        for customer, pence in day_summary(orderbook, week_start + datetime.timedelta(days=offset)).items():
+            totals[customer] += pence
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (£)"])
+        for customer in sorted(totals):
+            writer.writerow([customer, _pounds_text(totals[customer])])
+
+
+def _pounds_text(pence):
+    """Pounds with a comma decimal separator and two places, e.g. 1234 gives '12,34'."""
+    pounds, rest = divmod(pence, 100)
+    return f"{pounds},{rest:02d}"
+
+
