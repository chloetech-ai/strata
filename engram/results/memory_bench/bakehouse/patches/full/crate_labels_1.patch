@@ -0,0 +1,54 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels, to_ascii
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("SOU", "White sourdough", 320, allergens=("wheat",)),
+            Product("BRO", "Brötchen", 40, allergens=("wheat", "milk")),
+        ])
+        self.customers = {
+            "AIDAN": Customer("AIDAN", "St Aidan's Primary School", "School Road", "LK4 9SA", 2),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "AIDAN", "BRO", 60),
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "BRO", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n12 x Brotchen\nMILK, WHEAT",
+            "Cafe Lumen\n6 x White sourdough\nWHEAT",
+            "St Aidan's Primary School\n60 x Brotchen\nMILK, WHEAT",
+        ])
+
+    def test_no_orders_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog), self.customers, DAY), [])
+
+    def test_lines_fit_the_printer_and_allergens_are_not_cut(self):
+        catalog = Catalog([Product("X", "A very long product name " * 3, 100,
+                                   allergens=("wheat", "milk", "eggs", "nuts", "sesame", "soya", "celery", "mustard"))])
+        customer = Customer("Y", "An extremely long customer name for a shop " * 2, "", "", 1)
+        book = OrderBook(catalog, [OrderLine(DAY, "Y", "X", 1000)])
+        (label,) = crate_labels(book, {"Y": customer}, DAY)
+        lines = label.split("\n")
+        self.assertTrue(all(len(line) <= LINE_WIDTH for line in lines))
+        allergen_text = ", ".join(sorted(["wheat", "milk", "eggs", "nuts", "sesame", "soya", "celery", "mustard"])).upper()
+        self.assertEqual(" ".join(lines[2:]).replace(" ", ""), allergen_text.replace(" ", ""))
+
+    def test_to_ascii_drops_accents(self):
+        self.assertEqual(to_ascii("Brötchen Café"), "Brotchen Cafe")
+
+
+if __name__ == "__main__":
+    unittest.main()
