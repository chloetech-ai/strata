+"""Crate labels for the packing room's thermal printer."""
+
+import textwrap
+import unicodedata
+
+from .invoice import invoice_for
+
+LINE_WIDTH = 48  # characters per line on the label printer
+
+
+def to_ascii(text):
+    """Plain ASCII for the printer: accents are dropped, so 'Brötchen' becomes 'Brotchen'."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for `day`, in route order.
+
+    Each label is customer name, quantity and product name, then the allergens in capitals.
+    Names are cut to the line width; allergens are wrapped onto more lines so none are cut.
+    """
+    labels = []
+    for customer in sorted(customers.values(), key=lambda c: c.route_seq):
+        for line in invoice_for(orderbook, customer.code, day).lines:
+            product = orderbook.catalog.get(line.product)
+            rows = [
+                to_ascii(customer.name)[:LINE_WIDTH],
+                f"{line.qty} x {to_ascii(product.name)}"[:LINE_WIDTH],
+            ]
+            allergens = to_ascii(product.allergen_text()).upper()
+            if allergens:
+                rows += textwrap.wrap(allergens, LINE_WIDTH)
+            labels.append("\n".join(rows))
+    return labels
