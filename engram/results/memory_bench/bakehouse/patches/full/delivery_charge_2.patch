+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one delivery day's order worth `subtotal` pence before VAT.
+
+    Charged on orders under config.DELIVERY_CHARGE_BELOW, except for exempt customers.
+    An empty order (subtotal 0) has nothing to deliver, so no charge.
+    """
+    if customer_code in config.DELIVERY_CHARGE_EXEMPT or subtotal == 0:
+        return 0
+    if subtotal < config.DELIVERY_CHARGE_BELOW:
+        return config.DELIVERY_CHARGE
+    return 0
+
