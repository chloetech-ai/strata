+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first."""
+    rows = []
+    for code, (units, batches) in plan(orderbook, day).items():
+        product = orderbook.catalog.get(code)
+        rows.append((product, units, batches, dough_weight_g(product, units)))
+    rows.sort(key=lambda row: (-row[0].bake_temp, row[0].code))
+    width = max((len(product.name) for product, *_ in rows), default=0)
+    lines = [f"Bake sheet for {day.isoformat()}"]
+    lines.append(f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>9}")
+    for product, units, batches, grams in rows:
+        lines.append(f"{product.name:<{width}}  {units:>5}  {batches:>7}  {grams:>9}")
+    return "\n".join(lines)
+
+
