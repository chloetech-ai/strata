+class ReturnsCreditTest(unittest.TestCase):
+    def test_greenway_loaves_credited_at_catalog_price(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 180)])
+        # 10% of 32 delivered is 3 loaves, each credited at half of 180p
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", delivered=32, returned=10), 3 * 90)
