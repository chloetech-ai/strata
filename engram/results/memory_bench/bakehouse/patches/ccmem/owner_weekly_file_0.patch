+class WeekTotalsFileTest(unittest.TestCase):
+    WEEK = datetime.date(2026, 10, 18)  # a Sunday
+
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "week.csv")
+        self.catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return list(csv.reader(f, delimiter=";"))
+
+    def day(self, offset):
+        return self.WEEK + datetime.timedelta(days=offset)
+
+    def test_totals_in_pounds_with_comma_decimals(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day(0), "LUMEN", "SOU", 10),  # 3200
+            OrderLine(self.day(3), "LUMEN", "BAG", 5),   # 475
+            OrderLine(self.day(6), "GREENWAY", "BAG", 1),  # 95
+        ])
+        week_totals_file(book, self.WEEK, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "0,95"],
+            ["LUMEN", "36,75"],
+        ])
+
+    def test_covers_seven_days_inclusive_and_nothing_else(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.day(-1), "LUMEN", "BAG", 100),
+            OrderLine(self.day(0), "LUMEN", "BAG", 1),
+            OrderLine(self.day(6), "LUMEN", "BAG", 2),
+            OrderLine(self.day(7), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, self.WEEK, self.path)
+        self.assertEqual(self.read_rows()[1:], [["LUMEN", "2,85"]])
+
+    def test_pence_are_padded_to_two_digits(self):
+        book = OrderBook(Catalog([Product("BAG", "Baguette", 5)]), [OrderLine(self.day(0), "LUMEN", "BAG", 1)])
+        week_totals_file(book, self.WEEK, self.path)
+        self.assertEqual(self.read_rows()[1:], [["LUMEN", "0,05"]])
+
+    def test_no_orders_gives_header_only(self):
+        week_totals_file(OrderBook(self.catalog), self.WEEK, self.path)
+        self.assertEqual(self.read_rows(), [["customer", "total_gbp"]])
+
+
 if __name__ == "__main__":
