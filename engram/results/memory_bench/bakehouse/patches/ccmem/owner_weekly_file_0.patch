+def week_totals_file(orderbook, week_start, path):
+    """Write each customer's order value for the seven days from `week_start` to `path`.
+
+    For Greta's Excel: semicolon-separated, with comma decimals and amounts in pounds (e.g. 51,35).
+    Values are products only, before VAT, as in `day_summary`. Customers with no orders that week are left out.
+    """
+    end = week_start + datetime.timedelta(days=6)
+    lines = [line for line in orderbook if week_start <= line.day <= end]
+    totals = _value_by_customer(orderbook, lines)
+    # utf-8-sig writes a byte-order mark so Excel reads the file as UTF-8
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            writer.writerow([customer, _pounds_with_comma(totals[customer])])
+
+
+def _pounds_with_comma(pence):
+    """1234 -> '12,34'."""
+    pounds, rest = divmod(pence, 100)
+    return f"{pounds},{rest:02d}"
 
 
