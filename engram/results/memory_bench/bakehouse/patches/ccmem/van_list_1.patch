+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95)])
+        self.customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "HARBOUR": Customer("HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS", 2),
+        }
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "drops.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_one_row_per_customer_in_run_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "HARBOUR", "BAG", 3),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["stop", "code", "name", "address", "postcode"],
+            ["1", "LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB"],
+            ["2", "HARBOUR", "Harbour Deli", "3 Quay Street", "LK2 7QS"],
+            ["4", "GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS"],
+        ])
+
+    def test_customer_with_several_lines_appears_once(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(len(self.read_rows()), 2)
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "BAG", 7),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual([row[1] for row in self.read_rows()[1:]], ["LUMEN"])
+
+    def test_no_orders_writes_header_only(self):
+        drops_file(OrderBook(self.catalog), self.customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["stop", "code", "name", "address", "postcode"]])
+
+    def test_order_for_unknown_customer_is_rejected(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 1)])
+        with self.assertRaisesRegex(ValueError, "no customer details for NOBODY"):
+            drops_file(book, self.customers, DAY, self.path)
+        self.assertFalse(os.path.exists(self.path))
+
+
+if __name__ == "__main__":
+    unittest.main()
