+"""The van's run for a delivery day."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, in run order.
+
+    One row per customer with orders for `day`, sorted by route_seq. `customers`
+    is the dict from load_customers. A customer with orders but no entry there
+    is an error, so no drop is silently left off the run.
+    """
+    missing = [code for code in orderbook.customers_for(day) if code not in customers]
+    if missing:
+        raise ValueError(f"no customer details for {', '.join(missing)} (orders for {day.isoformat()})")
+    stops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["stop", "code", "name", "address", "postcode"])
+        for c in stops:
+            writer.writerow([c.route_seq, c.code, c.name, c.address, c.postcode])
