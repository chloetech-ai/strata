+"""Seasons: dates that drive production planning, such as the hot cross bun run before Easter."""
+
+import datetime
+
+
+def easter_sunday(year):
+    """Date of Easter Sunday in the Western (Gregorian) church for `year`.
+
+    Anonymous Gregorian algorithm (Meeus/Jones/Butcher).
+    """
+    a = year % 19
+    b, c = divmod(year, 100)
+    d, e = divmod(b, 4)
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i, k = divmod(c, 4)
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month, day_offset = divmod(h + l - 7 * m + 114, 31)
+    return datetime.date(year, month, day_offset + 1)
