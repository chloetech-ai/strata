+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour_weight(self):
+        recipe = {"Strong White Flour": 500, "Wholemeal flour": 500, "Water": 350, "Salt": 10}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong White Flour": 50.0,
+            "Wholemeal flour": 50.0,
+            "Water": 35.0,
+            "Salt": 1.0,
+        })
+
+    def test_flour_matches_any_case_anywhere_in_the_name(self):
+        recipe = {"FLOUR": 200, "rye FLOUR blend": 100, "Water": 150}
+        self.assertEqual(baker_percentages(recipe)["Water"], 50.0)
+
+    def test_rounds_to_one_decimal(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 7}
+        self.assertEqual(baker_percentages(recipe)["Salt"], 2.3)
+
+    def test_raises_when_there_is_no_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
