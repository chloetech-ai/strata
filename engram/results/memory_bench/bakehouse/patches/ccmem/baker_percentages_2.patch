+"""Recipes: ingredient weights in grams, expressed as baker's percentages."""
+
+
+def baker_percentages(recipe):
+    """Each ingredient's weight as a percentage of the total flour weight, rounded to one decimal.
+
+    `recipe` maps ingredient names to grams. Any ingredient whose name contains 'flour'
+    (any case) counts as flour.
+    """
+    flour = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour == 0:
+        raise ValueError("recipe has no flour")
+    return {name: round(grams / flour * 100, 1) for name, grams in recipe.items()}
