@@ -33,3 +33,22 @@ def plan(orderbook, day):
         code: (units, batches_needed(units, catalog.get(code).batch_size))
         for code, units in sorted(totals.items())
     }
+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first (by bake_temp).
+
+    Dough is weighed for whole batches, because a part batch is still baked in full.
+    Returns an empty string when nothing is ordered for `day`."""
+    catalog = orderbook.catalog
+    rows = []
+    for code, (units, batches) in plan(orderbook, day).items():
+        product = catalog.get(code)
+        dough = dough_weight_g(product, batches * product.batch_size)
+        rows.append((product, units, batches, dough))
+    rows.sort(key=lambda row: (-row[0].bake_temp, row[0].code))
+    width = max((len(product.name) for product, *_ in rows), default=0)
+    return "\n".join(
+        f"{product.name:<{width}}  {units:>5} units  {batches:>3} batches  {dough:>7} g dough"
+        for product, units, batches, dough in rows
+    )
