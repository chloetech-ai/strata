+    def test_bake_sheet_lists_hottest_oven_first(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12, dough_g=350, bake_temp=250),
+            Product("SOU", "White sourdough", 320, batch_size=10, dough_g=800, bake_temp=240),
+            Product("FLO", "Florentine", 90, batch_size=40, dough_g=30, bake_temp=170),
+        ])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "FLO", 40),
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+        ])
+        lines = bake_sheet(book, DAY).splitlines()
+        self.assertEqual([line.split()[0] for line in lines], ["Baguette", "White", "Florentine"])
