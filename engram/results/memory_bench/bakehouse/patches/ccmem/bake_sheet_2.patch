         for code, units in sorted(totals.items())
     }
+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first so the deck oven isn't reheated.
+
+    Dough is weighed for whole batches, since a part batch is still mixed and baked."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    products = sorted((catalog.get(code) for code in rows), key=lambda p: (-p.bake_temp, p.code))
+    width = max(len(p.name) for p in products)
+    lines = []
+    for product in products:
+        units, batches = rows[product.code]
+        grams = dough_weight_g(product, batches * product.batch_size)
+        lines.append(f"{product.name:<{width}}  {units:>4} pcs  {batches:>2} batches  {grams:>6} g dough")
+    return "\n".join(lines)
