+    def test_bake_sheet_gives_units_batches_and_dough_for_whole_batches(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12, dough_g=350, bake_temp=250)])
+        book = OrderBook(catalog, [OrderLine(DAY, "GREENWAY", "BAG", 25)])
