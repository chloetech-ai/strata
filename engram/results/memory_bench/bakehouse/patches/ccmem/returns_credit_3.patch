+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("SOU", "White sourdough", 320)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 5), 5 * 90)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+
+    def test_returns_capped_at_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 10), 10 * 90)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 40), 10 * 90)
+
+    def test_cap_rounds_down(self):
+        # 10% of 25 is 2.5, so only 2 loaves count
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 25), 2 * 90)
+
+    def test_small_delivery_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 9, 9), 0)
+
+    def test_other_customer_gets_nothing(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 10), 0)
+
+    def test_other_product_gets_nothing(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SOU", 100, 10), 0)
+
+    def test_unknown_product_code_is_loud(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "SWLX", 100, 10)
+
+    def test_returned_more_than_delivered_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, 11)
+
+    def test_negative_quantities_are_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
