+# Greenway takes sandwich loaves on sale-or-return; only these earn a credit.
+RETURNS_CUSTOMER = "GREENWAY"
+RETURNS_PRODUCT = "SWL"
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` of `delivered` units on one delivery.
+
+    Only Greenway's sandwich loaves earn credit: half the wholesale price per returned loaf,
+    counting at most 10% of the loaves delivered (rounded down). Returns above that get no credit.
+    Any other customer or product gets 0.
+    """
+    price = catalog.get(product_code).price
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"quantities must not be negative, got delivered={delivered}, returned={returned}")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} of {delivered} delivered")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    counted = min(returned, delivered // 10)
+    return counted * price // 2
