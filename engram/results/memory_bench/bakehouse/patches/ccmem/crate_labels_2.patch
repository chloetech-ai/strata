@@ -0,0 +1,76 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customer(code, name, route_seq):
+    return Customer(code, name, "1 High Street", "LK1 1AA", route_seq)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SOU", "White sourdough", 320, batch_size=10),
+        ])
+        self.customers = {
+            "LUMEN": customer("LUMEN", "Café Lumen", 2),
+            "GREENWAY": customer("GREENWAY", "Greenway Grocers", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "BAG", 24),
+            OrderLine(DAY, "GREENWAY", "BAG", 10),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Grocers\n10 x Baguette\nDelivery Tue 20 Oct 2026",
+            "Cafe Lumen\n24 x Baguette\nDelivery Tue 20 Oct 2026",
+            "Cafe Lumen\n6 x White sourdough\nDelivery Tue 20 Oct 2026",
+        ])
+
+    def test_repeated_lines_for_one_product_make_one_label(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 12),
+            OrderLine(DAY, "LUMEN", "BAG", 6),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n18 x Baguette\nDelivery Tue 20 Oct 2026",
+        ])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 12),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "SOU", 4),
+        ])
+        self.assertEqual(len(crate_labels(book, self.customers, DAY)), 1)
+
+    def test_no_orders_gives_no_labels(self):
+        book = OrderBook(self.catalog, [])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_every_line_fits_the_printer_and_is_ascii(self):
+        long_name = "Très Longue Boulangerie Généreuse de la Vallée du Nord"
+        customers = {"BIG": customer("BIG", long_name, 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "BIG", "SOU", 3)])
+        (label,) = crate_labels(book, customers, DAY)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        label.encode("ascii")
+        self.assertTrue(label.startswith("Tres Longue Boulangerie Genereuse de la Va"))
+
+    def test_customer_missing_from_customers_raises_key_error(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 1)])
+        with self.assertRaises(KeyError):
+            crate_labels(book, self.customers, DAY)
+
+
+if __name__ == "__main__":
+    unittest.main()
