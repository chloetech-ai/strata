+"""Packing labels: one crate label per customer and product for a delivery day."""
+
+import unicodedata
+
+LINE_WIDTH = 48  # the packing label printer prints 48 characters per line
+
+
+def _printable(text):
+    """Plain ASCII for the printer: accents are stripped ('é' -> 'e'), anything else becomes '?'."""
+    decomposed = unicodedata.normalize("NFKD", text)
+    without_marks = "".join(c for c in decomposed if not unicodedata.combining(c))
+    return without_marks.encode("ascii", "replace").decode("ascii")
+
+
+def _line(text):
+    return _printable(text)[:LINE_WIDTH]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, in route order.
+
+    Each label is a string of lines: the customer, the product and quantity, and the delivery day.
+    `customers` is the dict from load_customers. Raises KeyError for an order from a customer not in it.
+    """
+    catalog = orderbook.catalog
+    day_text = f"Delivery {day:%a %d %b %Y}"
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code in sorted(totals):
+            product = catalog.get(product_code)
+            labels.append("\n".join([
+                _line(customer.name),
+                _line(f"{totals[product_code]} x {product.name}"),
+                _line(day_text),
+            ]))
+    return labels
