+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 250), Product("BAG", "Bagel", 95)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 4), 4 * 250 // 2)
+
+    def test_cap_is_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 10), 10 * 125)
+
+    def test_returns_above_cap_get_no_credit_for_the_excess(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 15), 10 * 125)
+
+    def test_cap_rounds_down(self):
+        # 10% of 19 is 1.9, so only 1 loaf is creditable.
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 19, 5), 125)
+
+    def test_nothing_returned_or_nothing_delivered_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 0), 0)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 0, 5), 0)
+
+    def test_odd_price_rounds_down_to_the_penny(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 251)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 10, 1), 125)
+
+    def test_other_customer_or_product_is_refused(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "LUMEN", "SWL", 100, 4)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "BAG", 100, 4)
+
+    def test_negative_quantities_are_refused(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
