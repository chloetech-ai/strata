+
+
+RETURNS_CUSTOMER = "GREENWAY"
+RETURNS_PRODUCT = "SWL"  # sandwich loaf
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for loaves `customer_code` sent back from one delivery of `product_code`.
+
+    Only Greenway's sandwich loaves (SWL) are on sale-or-return. Returns are capped at 10% of the
+    delivered quantity (rounded down), and each returned loaf in the cap is credited at half its
+    wholesale price (rounded down to the penny). Returns above the cap get no credit.
+    """
+    if (customer_code, product_code) != (RETURNS_CUSTOMER, RETURNS_PRODUCT):
+        raise ValueError(f"no sale-or-return credit for {customer_code} {product_code}")
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    cap = delivered // 10
+    credited = min(returned, cap)
+    return credited * catalog.get(product_code).price // 2
