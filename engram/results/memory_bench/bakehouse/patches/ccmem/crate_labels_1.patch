+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import PRINTER_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 16)
+
+
+def _customers():
+    return {
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 2),
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+    }
+
+
+def _catalog():
+    return Catalog([
+        Product("RYE", "Seeded rye sourdough", 360),
+        Product("SOU", "White sourdough", 320),
+    ])
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(_catalog(), [
+            OrderLine(DAY, "GREENWAY", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY, "LUMEN", "RYE", 4),
+        ])
+        labels = crate_labels(book, _customers(), DAY)
+        self.assertEqual(labels, [
+            "Cafe Lumen\n4 x Seeded rye sourdough",
+            "Cafe Lumen\n2 x White sourdough",
+            "Greenway Grocers\n6 x White sourdough",
+        ])
+
+    def test_quantities_are_summed_per_customer_and_product(self):
+        book = OrderBook(_catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY, "LUMEN", "SOU", 3),
+        ])
+        self.assertEqual(crate_labels(book, _customers(), DAY), ["Cafe Lumen\n5 x White sourdough"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(_catalog(), [
+            OrderLine(DAY, "LUMEN", "SOU", 2),
+            OrderLine(DAY + datetime.timedelta(days=1), "GREENWAY", "SOU", 6),
+        ])
+        self.assertEqual(crate_labels(book, _customers(), DAY), ["Cafe Lumen\n2 x White sourdough"])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(_catalog()), _customers(), DAY), [])
+
+    def test_long_names_wrap_within_printer_width(self):
+        long_name = "The Very Long Name Of A Delicatessen And Tearoom Which Goes On For Ages"
+        customers = {"LONG": Customer("LONG", long_name, "1 Road", "LK1 1AA", 1)}
+        book = OrderBook(_catalog(), [OrderLine(DAY, "LONG", "SOU", 1)])
+        labels = crate_labels(book, customers, DAY)
+        lines = labels[0].split("\n")
+        self.assertGreater(len(lines), 2)
+        for line in lines:
+            self.assertLessEqual(len(line), PRINTER_WIDTH)
+            self.assertTrue(line.isascii())
+        self.assertEqual(" ".join(lines[:-1]), long_name)
+
+    def test_non_ascii_product_name_is_transliterated(self):
+        catalog = Catalog([Product("BRI", "Brioche à la crème", 250)])
+        customers = {"LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1)}
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BRI", 1)])
+        self.assertEqual(crate_labels(book, customers, DAY), ["Cafe Lumen\n1 x Brioche a la creme"])
+
+    def test_unknown_customer_raises_key_error_naming_it(self):
+        book = OrderBook(_catalog(), [OrderLine(DAY, "NOBODY", "SOU", 1)])
+        with self.assertRaisesRegex(KeyError, "NOBODY"):
+            crate_labels(book, _customers(), DAY)
+
+
+if __name__ == "__main__":
+    unittest.main()
