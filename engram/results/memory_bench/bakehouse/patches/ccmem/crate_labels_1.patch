+"""Crate labels for packing: one label per customer and product on a delivery day."""
+
+import textwrap
+import unicodedata
+
+# The packing label printer prints 48 characters per line, plain ASCII only.
+PRINTER_WIDTH = 48
+
+
+def _printable_lines(text):
+    """`text` as ASCII (accents stripped, e.g. 'é' to 'e') wrapped to the printer width."""
+    ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+    return textwrap.wrap(ascii_text, width=PRINTER_WIDTH) or [""]
+
+
+def crate_labels(orderbook, customers, day):
+    """Label text for everything ordered for delivery on `day`, one label per customer and product.
+
+    Labels are in route order (by `route_seq`), then product code. Each label is the customer's
+    name, then the quantity and product name, one per line. `customers` is the dict that
+    load_customers returns.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    keys = sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1]))
+    labels = []
+    for customer_code, product_code in keys:
+        customer = customers[customer_code]
+        product = orderbook.catalog.get(product_code)
+        lines = _printable_lines(customer.name) + _printable_lines(f"{totals[(customer_code, product_code)]} x {product.name}")
+        labels.append("\n".join(lines))
+    return labels
