--- a/src/bakehouse/orders.py
+++ b/src/bakehouse/orders.py
@@ -68,6 +68,14 @@ def is_delivery_day(day):
     return day.weekday() not in config.CLOSED_WEEKDAYS
 
 
+def next_delivery_day(day):
+    """The first date after `day` on which we deliver."""
+    following = day + datetime.timedelta(days=1)
+    while not is_delivery_day(following):
+        following += datetime.timedelta(days=1)
+    return following
+
+
 def is_on_time(placed_at, delivery_day):
