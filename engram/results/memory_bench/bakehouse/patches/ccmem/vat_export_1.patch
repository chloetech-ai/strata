+def format_pounds(pence):
+    """Format integer pence as plain pounds for a CSV, e.g. 1234 -> '12.34', -300 -> '-3.00'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write one row per invoice for the VAT return, in Ledgerly's import format: DD/MM/YYYY dates, pounds with a decimal point, pre-VAT totals."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, format_pounds(invoice.total())])
