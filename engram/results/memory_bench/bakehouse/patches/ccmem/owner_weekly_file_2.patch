+def week_totals_file(orderbook, week_start, path):
+    """Write each customer's order value for the seven days from `week_start` to a CSV file at `path`.
+
+    Like `day_summary`, the value is products only, at wholesale price before VAT; delivery charges are not included.
+    Rows are sorted by customer code, and only customers with orders in the week get a row.
+
+    The file is made for Greta's German-locale Excel: `;` between fields, `,` as the decimal separator,
+    and a UTF-8 byte-order mark so Excel reads any non-ASCII names correctly.
+    """
+    week = {week_start + datetime.timedelta(days=i) for i in range(7)}
+    totals = {}
+    for line in orderbook:
+        if line.day in week:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["customer", "total"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds},{pence:02d}"])
