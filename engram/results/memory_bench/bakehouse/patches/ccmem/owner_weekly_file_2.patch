+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95), Product("CRO", "Croissant", 5)])
+        self.start = datetime.date(2026, 10, 18)  # a Sunday
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return f.read()
+
+    def test_sums_each_customer_over_seven_days_in_semicolon_csv(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.start, "LUMEN", "BAG", 5),
+            OrderLine(self.start + datetime.timedelta(days=6), "LUMEN", "BAG", 5),
+            OrderLine(self.start + datetime.timedelta(days=3), "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, self.start, self.path)
+        self.assertEqual(self.read(), "customer;total\r\nGREENWAY;19,00\r\nLUMEN;9,50\r\n")
+
+    def test_days_outside_the_week_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(self.start - datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+            OrderLine(self.start, "LUMEN", "BAG", 1),
+            OrderLine(self.start + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+        ])
+        week_totals_file(book, self.start, self.path)
+        self.assertEqual(self.read(), "customer;total\r\nLUMEN;0,95\r\n")
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(self.catalog, [OrderLine(self.start, "LUMEN", "CRO", 1)])
+        week_totals_file(book, self.start, self.path)
+        self.assertEqual(self.read(), "customer;total\r\nLUMEN;0,05\r\n")
+
+    def test_no_orders_gives_header_only(self):
+        week_totals_file(OrderBook(self.catalog), self.start, self.path)
+        self.assertEqual(self.read(), "customer;total\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
