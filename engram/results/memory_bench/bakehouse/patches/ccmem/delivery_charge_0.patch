@@ -40,6 +40,22 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence: £4.50
+DELIVERY_CHARGE_UNDER = 4000  # pence: orders under £40.00 pay the charge
+DELIVERY_EXEMPT = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day.
+
+    `subtotal` is the order value in pence before VAT. Orders under £40.00 pay £4.50;
+    St Aidan's is exempt, and an order with no value pays nothing.
+    """
+    if customer_code in DELIVERY_EXEMPT or subtotal <= 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_CHARGE_UNDER else 0
+
+
