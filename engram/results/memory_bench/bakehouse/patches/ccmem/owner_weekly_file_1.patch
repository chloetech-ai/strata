+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        self.week = DAY
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def _read(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return f.read()
+
+    def test_semicolons_and_comma_decimals_for_excel(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 10),
+            OrderLine(DAY + datetime.timedelta(days=3), "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self._read(), "customer;total\r\nGREENWAY;19,00\r\nLUMEN;36,75\r\n")
+
+    def test_covers_seven_days_inclusive(self):
+        last = DAY + datetime.timedelta(days=6)
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 50),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(last, "LUMEN", "BAG", 2),
+            OrderLine(last + datetime.timedelta(days=1), "LUMEN", "BAG", 99),
+        ])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self._read(), "customer;total\r\nLUMEN;2,85\r\n")
+
+    def test_pads_pence_to_two_digits(self):
+        book = OrderBook(Catalog([Product("CHE", "Cheap", 5)]), [OrderLine(DAY, "LUMEN", "CHE", 3)])
+        week_totals_file(book, self.week, self.path)
+        self.assertEqual(self._read(), "customer;total\r\nLUMEN;0,15\r\n")
+
+    def test_no_orders_gives_header_only(self):
+        week_totals_file(OrderBook(self.catalog), self.week, self.path)
+        self.assertEqual(self._read(), "customer;total\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
