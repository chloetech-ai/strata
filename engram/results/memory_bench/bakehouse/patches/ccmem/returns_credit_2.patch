+from bakehouse.invoice import Invoice, InvoiceLine, format_pence, invoice_for, invoice_number, returns_credit
 from bakehouse.orders import OrderBook, OrderLine
 from bakehouse.products import Catalog, Product
 
 DAY = datetime.date(2026, 10, 20)
 
 
+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 250), Product("BAG", "Baguette", 95)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 4), 4 * 125)
+
+    def test_capped_at_ten_percent_of_delivered_loaves(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 100, 15), 10 * 125)
+
+    def test_cap_rounds_down(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 9), 3 * 125)
+
+    def test_nothing_returned_gives_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 100, 5), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 100, 5), 0)
+
+    def test_returned_cannot_exceed_delivered(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, 11)
+
+    def test_negative_returned_is_rejected(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+    def test_unknown_product_code_is_loud(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "SWLL", 100, 5)
+
