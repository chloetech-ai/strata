+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for `returned` of the `delivered` units of one delivery.
+
+    Greenway gets half the wholesale price back on sandwich loaves (SWL), for at most 10% of the
+    delivered loaves (rounded down). Nothing else earns credit. Unknown product codes raise KeyError.
+    """
+    product = catalog.get(product_code)
+    if not 0 <= returned <= delivered:
+        raise ValueError(f"returned must be between 0 and delivered ({delivered}), not {returned}")
+    if customer_code != "GREENWAY" or product_code != "SWL":
+        return 0
+    credited = min(returned, delivered // 10)
+    return credited * product.price // 2
