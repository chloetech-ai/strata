+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong White Flour": 1000, "Wholemeal Flour": 200, "Water": 750, "Salt": 20}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong White Flour": 83.3,
+            "Wholemeal Flour": 16.7,
+            "Water": 62.5,
+            "Salt": 1.7,
+        })
+
+    def test_flour_is_matched_case_insensitively_anywhere_in_the_name(self):
+        recipe = {"FLOUR": 500, "rye flour": 500, "Water": 400}
+        self.assertEqual(baker_percentages(recipe), {"FLOUR": 50.0, "rye flour": 50.0, "Water": 40.0})
+
+    def test_flour_itself_is_100_percent_when_it_is_the_only_flour(self):
+        self.assertEqual(baker_percentages({"Bread flour": 400, "Water": 300})["Bread flour"], 100.0)
+
+    def test_raises_when_there_is_no_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_raises_when_flour_weight_is_zero(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Strong flour": 0, "Water": 300})
