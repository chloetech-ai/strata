+"""Crate labels for packing. The label printer is 48 characters per line and plain ASCII only."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def printable(text):
+    """`text` as plain ASCII: accents are stripped (e.g. 'Café' -> 'Cafe'), anything else non-ASCII is dropped."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _wrapped(text):
+    return textwrap.wrap(printable(text), width=LINE_WIDTH) or [""]
+
+
+def crate_labels(orderbook, customers, day):
+    """Text of each crate label for delivery on `day`: one per customer and product, in route order.
+
+    `customers` is the dict from load_customers. Quantities for the same customer and product are
+    summed. Raises KeyError if an order is for a customer that isn't in `customers`.
+    """
+    labels = []
+    catalog = orderbook.catalog
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code in sorted(totals):
+            product = catalog.get(product_code)
+            lines = _wrapped(customer.name) + _wrapped(product.name) + _wrapped(f"Qty {totals[product_code]}")
+            lines.append(day.strftime("%d/%m/%Y"))
+            labels.append("\n".join(lines))
+    return labels
