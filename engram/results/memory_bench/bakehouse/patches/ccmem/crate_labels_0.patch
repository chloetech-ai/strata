@@ -0,0 +1,82 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels, printable
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers():
+    return {
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 2),
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+    }
+
+
+def catalog():
+    return Catalog([
+        Product("BAG", "Baguette", 95, batch_size=12),
+        Product("SWL", "Sandwich loaf", 250, batch_size=8),
+        Product("CRO", "Croissant", 160, batch_size=12),
+    ])
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "GREENWAY", "SWL", 32),
+            OrderLine(DAY, "GREENWAY", "BAG", 25),
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+        ])
+        labels = crate_labels(book, customers(), DAY)
+        self.assertEqual(len(labels), 3)
+        self.assertTrue(labels[0].startswith("Cafe Lumen\nCroissant\nQty 24"))
+        self.assertTrue(labels[1].startswith("Greenway Grocers\nBaguette\nQty 25"))
+        self.assertTrue(labels[2].startswith("Greenway Grocers\nSandwich loaf\nQty 32"))
+
+    def test_label_has_delivery_date(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "LUMEN", "CRO", 24)])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\nCroissant\nQty 24\n20/10/2026"])
+
+    def test_same_customer_and_product_is_one_label(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "CRO", 10),
+            OrderLine(DAY, "LUMEN", "CRO", 14),
+        ])
+        labels = crate_labels(book, customers(), DAY)
+        self.assertEqual(len(labels), 1)
+        self.assertIn("Qty 24", labels[0])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(catalog(), [
+            OrderLine(DAY, "LUMEN", "CRO", 24),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 12),
+        ])
+        self.assertEqual(len(crate_labels(book, customers(), DAY)), 1)
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(catalog()), customers(), DAY), [])
+
+    def test_unknown_customer_fails_loudly(self):
+        book = OrderBook(catalog(), [OrderLine(DAY, "NOBODY", "CRO", 1)])
+        with self.assertRaises(KeyError):
+            crate_labels(book, customers(), DAY)
+
+    def test_every_line_fits_the_printer_and_is_ascii(self):
+        long_name = "Très Longue Boulangerie Café-Épicerie de la Rue des Nombreux Accents Français"
+        cust = {"LONG": Customer("LONG", long_name, "1 Road", "LK1 1AA", 1)}
+        book = OrderBook(catalog(), [OrderLine(DAY, "LONG", "BAG", 5)])
+        (label,) = crate_labels(book, cust, DAY)
+        for line in label.split("\n"):
+            self.assertLessEqual(len(line), LINE_WIDTH)
+            line.encode("ascii")
+
+    def test_printable_strips_accents(self):
+        self.assertEqual(printable("Brötchen Café"), "Brotchen Cafe")
+
+
+if __name__ == "__main__":
+    unittest.main()
