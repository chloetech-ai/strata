+class ExportInvoicesTest(unittest.TestCase):
+    def _export(self, invoices):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return list(csv.reader(f))
+
+    def test_header_then_one_row_per_invoice(self):
+        rows = self._export([
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110)]),
+            Invoice("AIDAN", datetime.date(2026, 7, 5), [InvoiceLine("SOU", 6, 320), InvoiceLine("CRO", 1, 110)]),
+        ])
+        self.assertEqual(rows, [
+            ["date", "customer", "total"],
+            ["20/10/2026", "LUMEN", "26.40"],
+            ["05/07/2026", "AIDAN", "20.30"],
+        ])
+
+    def test_no_invoices_gives_header_only(self):
+        self.assertEqual(self._export([]), [["date", "customer", "total"]])
+
+    def test_empty_invoice_is_zero(self):
+        rows = self._export([Invoice("LUMEN", datetime.date(2026, 10, 20))])
+        self.assertEqual(rows[1], ["20/10/2026", "LUMEN", "0.00"])
+
+    def test_pence_below_one_pound_and_negative_totals(self):
+        rows = self._export([
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 1, 5)]),
+            Invoice("LUMEN", datetime.date(2026, 10, 21), [InvoiceLine("CRO", -1, 300)]),
+        ])
+        self.assertEqual(rows[1][2], "0.05")
+        self.assertEqual(rows[2][2], "-3.00")
+
