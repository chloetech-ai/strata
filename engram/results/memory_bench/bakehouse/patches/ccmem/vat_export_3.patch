+def pounds_text(pence):
+    """Plain pounds with two decimals for a CSV, e.g. 1234 -> '12.34', -5 -> '-0.05'."""
+    sign = "-" if pence < 0 else ""
+    pounds, rest = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{rest:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write invoices to a CSV for the VAT return: one row per invoice with its date, customer code and total.
+
+    Totals are before VAT. The file is in the Ledgerly import format: comma-separated with a header row,
+    DD/MM/YYYY dates and pound amounts with a decimal point.
+    """
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, pounds_text(invoice.total())])
