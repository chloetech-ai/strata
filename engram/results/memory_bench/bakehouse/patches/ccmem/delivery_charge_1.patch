     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, from November
+DELIVERY_CHARGE_THRESHOLD = 4000  # pence: orders under this value pay the charge
+DELIVERY_CHARGE_EXEMPT = {"AIDAN"}  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for one customer's order for one delivery day.
+
+    `subtotal` is the order value in pence before VAT. Orders under the threshold pay the charge;
+    a day with no order (subtotal 0) pays nothing, and exempt customers never pay it."""
+    if subtotal < 0:
+        raise ValueError(f"order value cannot be negative, not {subtotal}")
+    if customer_code in DELIVERY_CHARGE_EXEMPT or subtotal == 0:
+        return 0
+    if subtotal < DELIVERY_CHARGE_THRESHOLD:
+        return DELIVERY_CHARGE
+    return 0
+
+
