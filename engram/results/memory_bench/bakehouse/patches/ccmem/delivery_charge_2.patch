@@ -40,6 +40,21 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+DELIVERY_CHARGE = 450  # pence, charged when the order is under the threshold
+DELIVERY_THRESHOLD = 4000  # pence, before VAT
+DELIVERY_EXEMPT = ("AIDAN",)  # St Aidan's contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order worth `subtotal` pence before VAT for one delivery day.
+
+    Orders under DELIVERY_THRESHOLD pay DELIVERY_CHARGE; St Aidan's never pays. No order, no charge.
+    """
+    if customer_code in DELIVERY_EXEMPT or subtotal <= 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_THRESHOLD else 0
+
+
