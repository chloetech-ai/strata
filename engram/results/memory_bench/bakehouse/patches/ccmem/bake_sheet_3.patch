         for code, units in sorted(totals.items())
     }
+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first, so the deck oven isn't reheated."""
+    rows = plan(orderbook, day)
+    if not rows:
+        return f"Nothing to bake for {day.isoformat()}."
+    catalog = orderbook.catalog
+    order = sorted(rows, key=lambda code: (-catalog.get(code).bake_temp, code))
+    width = max(len(catalog.get(code).name) for code in order)
+    lines = [
+        f"Bake sheet for {day:%A %d %B %Y}",
+        f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>9}",
+    ]
+    for code in order:
+        product = catalog.get(code)
+        units, batches = rows[code]
+        lines.append(
+            f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough_weight_g(product, units):>9}"
+        )
+    return "\n".join(lines)
