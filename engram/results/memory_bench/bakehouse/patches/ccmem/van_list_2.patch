+"""The van's run for a delivery day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one line per customer in run order.
+
+    Only customers with orders for `day` are listed. `customers` is the dict from load_customers.
+    """
+    stops = []
+    for code in orderbook.customers_for(day):
+        if code not in customers:
+            raise ValueError(f"no customer record for {code}")
+        stops.append(customers[code])
+    stops.sort(key=lambda customer: customer.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for number, customer in enumerate(stops, start=1):
+            f.write(f"{number}. {customer.name}, {customer.address}, {customer.postcode}\n")
