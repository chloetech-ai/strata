+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.txt")
+        self.customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "88 High Street", "LK1 4HS", 4),
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 1),
+            "OLDMILL": Customer("OLDMILL", "The Old Mill Tearoom", "Old Mill Yard", "LK3 1MY", 3),
+        }
+        self.catalog = Catalog([Product("BAG", "Baguette", 95)])
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_lists_drops_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY, "OLDMILL", "BAG", 3),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), (
+            "1. Café Lumen, 14 Mill Lane, LK1 2AB\n"
+            "2. The Old Mill Tearoom, Old Mill Yard, LK3 1MY\n"
+            "3. Greenway Grocers, 88 High Street, LK1 4HS\n"
+        ))
+
+    def test_customers_without_orders_that_day_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 2),
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 1),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "1. Greenway Grocers, 88 High Street, LK1 4HS\n")
+
+    def test_customer_with_several_lines_is_one_drop(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 1),
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "1. Café Lumen, 14 Mill Lane, LK1 2AB\n")
+
+    def test_no_orders_writes_empty_file(self):
+        book = OrderBook(self.catalog)
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "")
+
+    def test_order_for_unknown_customer_is_an_error(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 1)])
+        with self.assertRaisesRegex(ValueError, "NOBODY"):
+            drops_file(book, self.customers, DAY, self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
