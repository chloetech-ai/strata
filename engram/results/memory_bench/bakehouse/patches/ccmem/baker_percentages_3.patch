+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour_to_one_decimal(self):
+        recipe = {"Strong White Flour": 1000, "Water": 720, "Salt": 20, "Levain": 200}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong White Flour": 100.0, "Water": 72.0, "Salt": 2.0, "Levain": 20.0},
+        )
+
+    def test_all_flours_are_summed_whatever_their_case(self):
+        recipe = {"Strong white FLOUR": 600, "rye flour": 400, "Water": 750}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white FLOUR": 60.0, "rye flour": 40.0, "Water": 75.0},
+        )
+
+    def test_rounds_to_one_decimal(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 7}
+        self.assertEqual(baker_percentages(recipe)["Salt"], 2.3)
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 500, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 500})
+
+
+if __name__ == "__main__":
+    unittest.main()
