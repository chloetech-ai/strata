@@ -0,0 +1,13 @@
+"""Recipe arithmetic. Weights are grams."""
+
+
+def baker_percentages(recipe):
+    """{ingredient: weight as a percentage of total flour weight, to one decimal place}.
+
+    Any ingredient whose name contains "flour" (any case) counts as flour. Raises ValueError if the
+    recipe has no flour, or if its flour weighs nothing, since the percentages are then undefined.
+    """
+    flour_total = sum(grams for name, grams in recipe.items() if "flour" in name.lower())
+    if flour_total <= 0:
+        raise ValueError("recipe has no flour weight to base percentages on")
+    return {name: round(grams / flour_total * 100, 1) for name, grams in recipe.items()}
