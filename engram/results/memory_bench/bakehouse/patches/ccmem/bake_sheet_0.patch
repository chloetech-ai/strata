     }
+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product to bake, hottest oven first.
+
+    Products with the same bake temperature are listed by product code. Dough is
+    weighed for whole batches, since we only bake whole batches.
+    """
+    rows = plan(orderbook, day)
+    catalog = orderbook.catalog
+    products = sorted((catalog.get(code) for code in rows), key=lambda p: (-p.bake_temp, p.code))
+    lines = []
+    for product in products:
+        units, batches = rows[product.code]
+        dough = dough_weight_g(product, batches * product.batch_size)
+        lines.append(f"{product.name} | {product.bake_temp} C | units {units} | batches {batches} | dough {dough} g")
+    return "\n".join(lines)
