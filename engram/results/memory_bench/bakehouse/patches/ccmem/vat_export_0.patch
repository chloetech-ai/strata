+class ExportInvoicesTest(unittest.TestCase):
+    def test_writes_date_customer_and_total_in_pounds(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 4), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 5), [InvoiceLine("CRO", 1, 5)]),
+            Invoice("AIDAN", datetime.date(2026, 10, 6)),
+        ]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["date", "customer", "total"],
+            ["04/10/2026", "LUMEN", "45.60"],
+            ["05/10/2026", "GREENWAY", "0.05"],
+            ["06/10/2026", "AIDAN", "0.00"],
+        ])
+
+    def test_negative_total_gets_leading_minus(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 10, 4), [InvoiceLine("CRO", -3, 110)])]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
