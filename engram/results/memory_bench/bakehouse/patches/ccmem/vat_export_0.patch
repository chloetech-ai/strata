+def export_invoices(invoices, path):
+    """Write invoices to a CSV for Ledgerly: date (DD/MM/YYYY), customer code, total in pounds before VAT."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, rest = divmod(abs(total), 100)
+            writer.writerow([
+                invoice.day.strftime("%d/%m/%Y"),
+                invoice.customer,
+                f"{sign}{pounds}.{rest:02d}",
+            ])
+
