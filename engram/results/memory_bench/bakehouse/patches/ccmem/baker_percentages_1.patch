+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        # 400g + 100g of flour = 500g total
+        recipe = {"White bread flour": 400, "Wholemeal flour": 100, "Water": 350, "Salt": 10, "Starter": 100}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"White bread flour": 80.0, "Wholemeal flour": 20.0, "Water": 70.0, "Salt": 2.0, "Starter": 20.0},
+        )
+
+    def test_flour_match_is_case_insensitive(self):
+        result = baker_percentages({"RYE FLOUR": 200, "rye Flour": 200, "Water": 300})
+        self.assertEqual(result["Water"], 75.0)
+
+    def test_rounds_to_one_decimal_place(self):
+        result = baker_percentages({"Flour": 300, "Water": 200, "Salt": 7})
+        self.assertEqual(result["Salt"], 2.3)
+        self.assertEqual(result["Water"], 66.7)
+
+    def test_raises_when_there_is_no_flour(self):
+        with self.assertRaisesRegex(ValueError, "no flour"):
+            baker_percentages({"Water": 300, "Salt": 6})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
