+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order of `subtotal` pence (before VAT) for one delivery day.
+
+    Orders under the threshold pay the charge; orders at or over it, exempt customers, and days with no order pay nothing.
+    """
+    if subtotal <= 0 or customer_code in config.DELIVERY_EXEMPT_CUSTOMERS:
+        return 0
+    if subtotal < config.DELIVERY_THRESHOLD_PENCE:
+        return config.DELIVERY_CHARGE_PENCE
+    return 0
+
