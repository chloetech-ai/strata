+"""The van's run: which customers to visit on a delivery day, in route order."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path` as CSV, one row per customer with orders that day, in route order.
+
+    `customers` is the dict from customers.load_customers. A customer with orders but no entry there is an error.
+    """
+    codes = orderbook.customers_for(day)
+    missing = [code for code in codes if code not in customers]
+    if missing:
+        raise KeyError(f"no customer record for {', '.join(missing)}")
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["stop", "code", "name", "address", "postcode", "email"])
+        for c in drops:
+            writer.writerow([c.route_seq, c.code, c.name, c.address, c.postcode, c.email])
