+"""Packing labels: one per customer and product for a delivery day."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48  # the label printer prints 48 characters per line
+
+
+def ascii_only(text):
+    """Plain ASCII for the label printer: accents become their base letter ('é' -> 'e'), anything else is dropped."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _wrapped(text):
+    return textwrap.wrap(ascii_only(text), width=LINE_WIDTH)
+
+
+def crate_labels(orderbook, customers, day):
+    """Label text for each customer and product ordered for delivery on `day`, in van run order.
+
+    `customers` is the dict from load_customers. Each label is the customer's name, then the
+    quantity and product name, wrapped to the printer width. Quantities are summed across the
+    customer's lines for the same product.
+    """
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        customer = customers[code]
+        totals = {}
+        for line in orderbook.lines_for(code, day):
+            totals[line.product] = totals.get(line.product, 0) + line.qty
+        for product_code in sorted(totals):
+            product = orderbook.catalog.get(product_code)
+            lines = _wrapped(customer.name) + _wrapped(f"{totals[product_code]} x {product.name}")
+            labels.append("\n".join(lines))
+    return labels
