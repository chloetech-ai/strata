+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, ascii_only, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customer(code, name, route_seq):
+    return Customer(code, name, "1 Mill Lane", "LK1 2AB", route_seq)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("BRO", "Brötchen", 40, batch_size=30),
+        ])
+        self.customers = {
+            "GREENWAY": customer("GREENWAY", "Greenway Grocers", 2),
+            "LUMEN": customer("LUMEN", "Café Lumen", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "BRO", 30),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n5 x Baguette",
+            "Cafe Lumen\n30 x Brotchen",
+            "Greenway Grocers\n20 x Baguette",
+        ])
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 12),
+            OrderLine(DAY, "LUMEN", "BAG", 6),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n18 x Baguette"])
+
+    def test_other_days_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 12),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_no_orders_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog), self.customers, DAY), [])
+
+    def test_unknown_customer_is_an_error(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "NOBODY", "BAG", 1)])
+        with self.assertRaises(KeyError):
+            crate_labels(book, self.customers, DAY)
+
+    def test_long_names_wrap_to_printer_width(self):
+        long_name = "The Very Long Named Old Mill Tearoom and Bakehouse Shop Company Limited"
+        customers = {"LUMEN": customer("LUMEN", long_name, 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 12)])
+        label = crate_labels(book, customers, DAY)[0]
+        lines = label.split("\n")
+        self.assertGreater(len(lines), 2)
+        for line in lines:
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertEqual(" ".join(lines[:-1]), long_name)
+        self.assertEqual(lines[-1], "12 x Baguette")
+
+    def test_labels_are_plain_ascii(self):
+        for label in crate_labels(
+            OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BRO", 30)]), self.customers, DAY
+        ):
+            label.encode("ascii")
+
+    def test_ascii_only_drops_accents_to_base_letters(self):
+        self.assertEqual(ascii_only("Brötchen Café"), "Brotchen Cafe")
+
+
+if __name__ == "__main__":
+    unittest.main()
