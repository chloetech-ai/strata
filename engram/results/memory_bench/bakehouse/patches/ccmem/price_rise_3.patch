diff --git a/src/bakehouse/pricing.py b/src/bakehouse/pricing.py
new file mode 100644
index 0000000..03a2738
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,16 @@
+"""January price rise. All amounts are integer pence."""
+
+# Greta's January rise: every wholesale price goes up 4%.
+RISE_PERCENT = 4
+
+
+def new_prices(catalog):
+    """{product code: new wholesale price in pence} for every product in `catalog`.
+
+    Each new price is the old price times 1.04, rounded half up to the nearest penny.
+    Integer arithmetic keeps the halfway cases exact (no float rounding surprises).
+    """
+    return {
+        product.code: (product.price * (100 + RISE_PERCENT) + 50) // 100
+        for product in catalog
+    }
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..6ca6aaa
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,29 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_raises_by_four_percent_rounded_half_up_to_the_penny(self):
+        catalog = Catalog([
+            Product("BAG", "Baguette", 95),   # 98.8 -> 99
+            Product("BRO", "Brownie", 40),    # 41.6 -> 42
+            Product("CRO", "Croissant", 110), # 114.4 -> 114
+            Product("PCH", "Pain au chocolat", 125),  # 130.0 -> 130
+        ])
+        self.assertEqual(new_prices(catalog), {"BAG": 99, "BRO": 42, "CRO": 114, "PCH": 130})
+
+    def test_rounds_to_nearest_penny_not_down(self):
+        self.assertEqual(new_prices(Catalog([Product("X", "x", 37)])), {"X": 38})  # 38.48 -> 38
+        self.assertEqual(new_prices(Catalog([Product("Y", "y", 13)])), {"Y": 14})  # 13.52 -> 14
+
+    def test_zero_price_stays_zero(self):
+        self.assertEqual(new_prices(Catalog([Product("FRE", "Free sample", 0)])), {"FRE": 0})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
