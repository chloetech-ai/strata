index effee1c..ce38ff7 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -40,6 +40,29 @@ def invoice_number(year, seq):
     return f"LK-{year}-{seq:04d}"
 
 
+RETURNS_CUSTOMER = "GREENWAY"
+RETURNS_PRODUCT = "SWL"  # sandwich loaves
+RETURNS_CAP_PERCENT = 10  # at most this share of the day's delivered loaves can earn credit
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Credit in pence for loaves `customer_code` sent back from one delivery.
+
+    Sale-or-return applies only to Greenway's sandwich loaves: anything else gets no credit.
+    The credit is half the wholesale price per returned loaf. Returns above 10% of the
+    delivered loaves get no credit beyond that cap. Rounding is down throughout (the
+    cap in whole loaves, the half price in whole pence); Greta has not confirmed this.
+    """
+    if delivered < 0 or returned < 0:
+        raise ValueError(f"delivered and returned must not be negative, got {delivered} and {returned}")
+    if returned > delivered:
+        raise ValueError(f"cannot return {returned} of {delivered} delivered {product_code} for {customer_code}")
+    if customer_code != RETURNS_CUSTOMER or product_code != RETURNS_PRODUCT:
+        return 0
+    capped = min(returned, delivered * RETURNS_CAP_PERCENT // 100)
+    return capped * catalog.get(product_code).price // 2
+
+
