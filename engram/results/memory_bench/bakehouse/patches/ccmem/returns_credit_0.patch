+class ReturnsCreditTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("BAG", "Baguette", 95)])
+
+    def test_half_wholesale_per_returned_loaf(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 3), 3 * 90)
+
+    def test_cap_is_ten_percent_of_delivered(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 6), 3 * 90)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 32), 3 * 90)
+
+    def test_cap_rounds_down_to_whole_loaves(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 25, 10), 2 * 90)
+
+    def test_odd_price_rounds_half_pence_down(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 175)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 20, 2), 175)
+
+    def test_no_returns_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 32, 0), 0)
+
+    def test_other_customers_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 32, 3), 0)
+
+    def test_other_products_get_no_credit(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 32, 3), 0)
+
+    def test_returning_more_than_delivered_is_an_error(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 5, 6)
+
+    def test_negative_quantities_are_an_error(self):
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", -1, 0)
+        with self.assertRaises(ValueError):
+            returns_credit(self.catalog, "GREENWAY", "SWL", 10, -1)
+
+
