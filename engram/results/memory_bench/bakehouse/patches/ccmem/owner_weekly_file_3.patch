+class WeekTotalsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        self.week_start = DAY
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "week.csv")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, newline="", encoding="utf-8-sig") as f:
+            return f.read()
+
+    def test_one_row_per_customer_in_pounds_with_semicolons(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 10),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+        ])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\nGREENWAY;19,00\r\nLUMEN;36,75\r\n")
+
+    def test_days_outside_the_seven_are_left_out(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 50),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 99),
+        ])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\nLUMEN;1,90\r\n")
+
+    def test_pence_are_zero_padded(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        week_totals_file(book, self.week_start, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\nLUMEN;0,95\r\n")
+
+    def test_no_orders_gives_header_only(self):
+        week_totals_file(OrderBook(self.catalog), self.week_start, self.path)
+        self.assertEqual(self.read(), "customer;total_gbp\r\n")
+
+
 if __name__ == "__main__":
