+def week_totals_file(orderbook, week_start, path):
+    """Write each customer's order value for the seven days from `week_start` to `path`.
+
+    Only customers with orders in that week get a row, sorted by customer code. Values are
+    products only, before VAT, in pounds. The file is for Greta's German-locale Excel, so it
+    uses `;` between fields and `,` as the decimal separator.
+    """
+    week_end = week_start + datetime.timedelta(days=7)
+    totals = {}
+    for line in orderbook:
+        if week_start <= line.day < week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["customer", "total_gbp"])
+        for customer in sorted(totals):
+            pounds, pence = divmod(totals[customer], 100)
+            writer.writerow([customer, f"{pounds},{pence:02d}"])
