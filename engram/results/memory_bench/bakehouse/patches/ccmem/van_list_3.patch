+import csv
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customer(code, seq):
+    return Customer(code, f"{code} shop", f"{seq} Some Street", "LK1 1AA", seq)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "drops.csv")
+        self.catalog = Catalog([Product("BAG", "Baguette", 95)])
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read_rows(self):
+        with open(self.path, newline="", encoding="utf-8") as f:
+            return list(csv.reader(f))
+
+    def test_lists_only_customers_ordering_that_day_in_run_order(self):
+        customers = {"GREENWAY": customer("GREENWAY", 4), "LUMEN": customer("LUMEN", 1), "HARBOUR": customer("HARBOUR", 2)}
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 3),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY + datetime.timedelta(days=1), "HARBOUR", "BAG", 1),
+        ])
+        drops_file(book, customers, DAY, self.path)
+        self.assertEqual(self.read_rows(), [
+            ["route_seq", "code", "name", "address", "postcode"],
+            ["1", "LUMEN", "LUMEN shop", "1 Some Street", "LK1 1AA"],
+            ["4", "GREENWAY", "GREENWAY shop", "4 Some Street", "LK1 1AA"],
+        ])
+
+    def test_customer_with_several_lines_appears_once(self):
+        customers = {"LUMEN": customer("LUMEN", 1)}
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+        ])
+        drops_file(book, customers, DAY, self.path)
+        self.assertEqual(len(self.read_rows()), 2)
+
+    def test_no_orders_gives_header_only(self):
+        drops_file(OrderBook(self.catalog), {}, DAY, self.path)
+        self.assertEqual(self.read_rows(), [["route_seq", "code", "name", "address", "postcode"]])
+
+    def test_unknown_customer_raises_naming_the_code(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "GHOST", "BAG", 1)])
+        with self.assertRaises(KeyError) as cm:
+            drops_file(book, {}, DAY, self.path)
+        self.assertIn("GHOST", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
