+"""The van's drops for a delivery day."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, in run order (route_seq).
+
+    Only customers with orders for `day` are listed. `customers` is the dict from
+    load_customers. Raises KeyError naming the code if an order's customer is unknown.
+    """
+    codes = sorted(orderbook.customers_for(day), key=lambda code: customers[code].route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["route_seq", "code", "name", "address", "postcode"])
+        for code in codes:
+            c = customers[code]
+            writer.writerow([c.route_seq, c.code, c.name, c.address, c.postcode])
