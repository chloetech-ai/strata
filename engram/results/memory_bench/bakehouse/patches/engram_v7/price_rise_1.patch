new file mode 100644
index 0000000..9239473
--- /dev/null
+++ b/src/bakehouse/pricing.py
@@ -0,0 +1,21 @@
+"""Wholesale price changes."""
+
+# January rise: 5% on every wholesale price, rounded up to the next 5p.
+RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Maps each product code to its new wholesale price in pence.
+
+    Integer arithmetic throughout: the rise is applied as price * 105 / 100 and
+    the result is rounded up (never down) to a multiple of 5p. A price that is
+    already an exact multiple of 5p after the rise stays where it is.
+    """
+    prices = {}
+    for product in catalog:
+        risen_numerator = product.price * (100 + RISE_PERCENT)
+        # Ceiling division by (100 * ROUND_TO_PENCE) gives the rounded-up multiple of 5p.
+        steps = -(-risen_numerator // (100 * ROUND_TO_PENCE))
+        prices[product.code] = steps * ROUND_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..b36aa3e
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,35 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rise_rounds_up_to_next_5p(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 180)])
+        # 180 * 1.05 = 189, rounded up to 190
+        self.assertEqual(new_prices(catalog), {"SWL": 190})
+
+    def test_rounds_up_not_to_nearest(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320 * 1.05 = 336, rounded up to 340 (nearest 5p would also give 335, which is wrong)
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_is_unchanged_by_rounding(self):
+        catalog = Catalog([Product("BUN", "Bun", 100)])
+        # 100 * 1.05 = 105, already a multiple of 5
+        self.assertEqual(new_prices(catalog), {"BUN": 105})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_covers_every_product_and_leaves_catalog_alone(self):
+        catalog = Catalog([Product("A", "a", 200), Product("B", "b", 45)])
+        self.assertEqual(new_prices(catalog), {"A": 210, "B": 50})
+        self.assertEqual(catalog.get("A").price, 200)
+        self.assertEqual(catalog.get("B").price, 45)
+
+
+if __name__ == "__main__":
+    unittest.main()
