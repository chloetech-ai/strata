+class WeekTotalsFileTest(unittest.TestCase):
+    def read_file(self, book, week_start):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, encoding="utf-8-sig", newline="") as f:
+                return f.read()
+
+    def test_totals_for_seven_days_from_week_start(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),                                    # first day, included
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 1),      # last day, included
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "SOU", 99),     # next week, excluded
+            OrderLine(DAY - datetime.timedelta(days=1), "GREENWAY", "BAG", 50),  # before, excluded
+            OrderLine(DAY + datetime.timedelta(days=2), "GREENWAY", "BAG", 20),
+        ])
+        self.assertEqual(self.read_file(book, DAY), "Customer;Total (£)\r\nGREENWAY;19,00\r\nLUMEN;7,95\r\n")
+
+    def test_pence_padded_to_two_decimals(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("CRO", "Croissant", 105)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BAG", 5), OrderLine(DAY, "AIDAN", "CRO", 1)])
+        self.assertEqual(self.read_file(book, DAY), "Customer;Total (£)\r\nAIDAN;1,05\r\nLUMEN;4,75\r\n")
+
+    def test_no_orders_in_week_writes_header_only(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BAG", 5)])
+        self.assertEqual(self.read_file(book, DAY + datetime.timedelta(days=7)), "Customer;Total (£)\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
