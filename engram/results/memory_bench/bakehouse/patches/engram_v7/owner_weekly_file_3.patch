     return dict(sorted(totals.items()))
 
 
+def week_totals_file(orderbook, week_start, path):
+    """Write one row per customer with their order value in pounds for the seven days from `week_start`.
+
+    For Greta's German-locale Excel: fields are separated by semicolons and the decimal separator is a
+    comma. The file is UTF-8 with a byte-order mark so Excel reads the £ sign correctly."""
+    week_end = week_start + datetime.timedelta(days=6)
+    totals = {}
+    for line in orderbook.lines:
+        if week_start <= line.day <= week_end:
+            price = orderbook.catalog.get(line.product).price
+            totals[line.customer] = totals.get(line.customer, 0) + line.qty * price
+    with open(path, "w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.writer(f, delimiter=";")
+        writer.writerow(["Customer", "Total (£)"])
+        for customer in sorted(totals):
+            pence = totals[customer]
+            writer.writerow([customer, f"{pence // 100},{pence % 100:02d}"])
+
+
 def top_products(orderbook, start, end, n=5):
