+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_of_total_flour_rounded_to_one_decimal(self):
+        recipe = {"Strong White Flour": 500, "Water": 350, "Salt": 10, "Yeast": 2}
+        self.assertEqual(baker_percentages(recipe), {
+            "Strong White Flour": 100.0,
+            "Water": 70.0,
+            "Salt": 2.0,
+            "Yeast": 0.4,
+        })
+
+    def test_every_flour_counts_towards_the_base_in_any_case(self):
+        recipe = {"Wholemeal FLOUR": 200, "rye flour": 100, "Water": 180}
+        self.assertEqual(baker_percentages(recipe), {
+            "Wholemeal FLOUR": 66.7,
+            "rye flour": 33.3,
+            "Water": 60.0,
+        })
+
+    def test_rounds_to_one_decimal_place(self):
+        recipe = {"Flour": 300, "Water": 200, "Salt": 1}
+        self.assertEqual(baker_percentages(recipe)["Salt"], 0.3)
+
+    def test_recipe_without_flour_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_empty_recipe_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({})
