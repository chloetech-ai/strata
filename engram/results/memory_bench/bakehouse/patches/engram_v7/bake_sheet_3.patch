+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first, with units, batches and dough in grams."""
+    catalog = orderbook.catalog
+    products = [catalog.get(code) for code in plan(orderbook, day)]
+    products.sort(key=lambda p: (-p.bake_temp, p.code))
+    width = max((len(p.name) for p in products), default=0)
+    lines = []
+    for product in products:
+        units = orderbook.total_for(day, product.code)
+        batches = batches_needed(units, product.batch_size)
+        grams = dough_weight_g(product, units)
+        lines.append(f"{product.name.ljust(width)}  {units:>4} units  {batches:>3} batches  {grams:>6} g dough")
+    return "\n".join(lines)
