@@ -149,6 +149,15 @@ class CutoffTest(unittest.TestCase):
             day = DAY + datetime.timedelta(days=offset)
             self.assertEqual(is_delivery_day(day), day.weekday() not in config.CLOSED_WEEKDAYS)
 
+    def test_next_delivery_day_skips_closed_days(self):
+        for offset in range(14):
+            day = DAY + datetime.timedelta(days=offset)
+            following = next_delivery_day(day)
+            self.assertGreater(following, day)
+            self.assertTrue(is_delivery_day(following))
+            skipped = [day + datetime.timedelta(days=n) for n in range(1, (following - day).days)]
+            self.assertFalse(any(is_delivery_day(d) for d in skipped))
+
 
 if __name__ == "__main__":
     unittest.main()
