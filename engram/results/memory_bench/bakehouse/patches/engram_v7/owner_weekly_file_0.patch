+class WeekTotalsFileTest(unittest.TestCase):
+    def read_lines(self, path):
+        with open(path, encoding="utf-8") as f:
+            return f.read().splitlines()
+
+    def test_totals_in_pounds_with_german_separators(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        week_start = DAY  # Tuesday 20 October 2026
+        book = OrderBook(catalog, [
+            OrderLine(week_start, "LUMEN", "BAG", 5),                                  # 475
+            OrderLine(week_start + datetime.timedelta(days=6), "LUMEN", "SOU", 1),     # last day of week: 320
+            OrderLine(week_start + datetime.timedelta(days=6), "AIDAN", "BAG", 1),     # 95
+            OrderLine(week_start - datetime.timedelta(days=1), "GREENWAY", "SOU", 9),  # day before: excluded
+            OrderLine(week_start + datetime.timedelta(days=7), "GREENWAY", "SOU", 9),  # day after: excluded
+        ])
+        path = os.path.join(tempfile.mkdtemp(), "week.csv")
+        week_totals_file(book, week_start, path)
+        self.assertEqual(self.read_lines(path), [
+            "Customer;Total (GBP)",
+            "AIDAN;0,95",
+            "LUMEN;7,95",
+        ])
+
+    def test_pence_are_zero_padded_and_no_thousands_separator(self):
+        catalog = Catalog([Product("CAK", "Celebration cake", 1205)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "CAK", 100)])
+        path = os.path.join(tempfile.mkdtemp(), "week.csv")
+        week_totals_file(book, DAY, path)
+        self.assertEqual(self.read_lines(path)[1], "LUMEN;1205,00")
+
+    def test_no_orders_in_week_gives_header_only(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BAG", 5)])
+        path = os.path.join(tempfile.mkdtemp(), "week.csv")
+        week_totals_file(book, DAY + datetime.timedelta(days=7), path)
+        self.assertEqual(self.read_lines(path), ["Customer;Total (GBP)"])
+
+
 if __name__ == "__main__":
     unittest.main()
