+++ b/tests/test_seasons.py
@@ -0,0 +1,31 @@
+import datetime
+import unittest
+
+from bakehouse.seasons import easter_sunday
+
+
+class SeasonsTest(unittest.TestCase):
+    def test_easter_sunday_known_dates(self):
+        self.assertEqual(easter_sunday(1900), datetime.date(1900, 4, 15))
+        self.assertEqual(easter_sunday(1943), datetime.date(1943, 4, 25))
+        self.assertEqual(easter_sunday(1961), datetime.date(1961, 4, 2))
+        self.assertEqual(easter_sunday(2000), datetime.date(2000, 4, 23))
+        self.assertEqual(easter_sunday(2008), datetime.date(2008, 3, 23))
+        self.assertEqual(easter_sunday(2026), datetime.date(2026, 4, 5))
+
+    def test_easter_sunday_is_always_a_sunday_between_march_22_and_april_25(self):
+        for year in range(1900, 2200):
+            easter = easter_sunday(year)
+            self.assertEqual(easter.weekday(), 6, year)
+            self.assertGreaterEqual(easter, datetime.date(year, 3, 22), year)
+            self.assertLessEqual(easter, datetime.date(year, 4, 25), year)
+
+    def test_easter_sunday_rejects_years_outside_range(self):
+        with self.assertRaises(ValueError):
+            easter_sunday(1899)
+        with self.assertRaises(ValueError):
+            easter_sunday(2200)
+
+
+if __name__ == "__main__":
+    unittest.main()
