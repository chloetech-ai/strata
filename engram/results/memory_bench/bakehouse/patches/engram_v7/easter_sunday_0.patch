+"""Seasonal dates: when the hot cross bun season starts and ends."""
+
+import datetime
+
+FIRST_YEAR = 1900
+LAST_YEAR = 2199
+
+
+def easter_sunday(year):
+    """Easter Sunday in the Western church, Gregorian calendar, for `year` from 1900 to 2199."""
+    if not FIRST_YEAR <= year <= LAST_YEAR:
+        raise ValueError(f"year must be from {FIRST_YEAR} to {LAST_YEAR}, got {year}")
+    # Anonymous Gregorian algorithm (Meeus/Jones/Butcher)
+    a = year % 19
+    b, c = divmod(year, 100)
+    d, e = divmod(b, 4)
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i, k = divmod(c, 4)
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month, day = divmod(h + l - 7 * m + 114, 31)
+    return datetime.date(year, month, day + 1)
