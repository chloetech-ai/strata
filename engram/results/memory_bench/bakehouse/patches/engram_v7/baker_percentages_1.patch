+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour(self):
+        recipe = {"Strong white flour": 500, "Wholemeal flour": 100, "Water": 375, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 83.3, "Wholemeal flour": 16.7, "Water": 62.5, "Salt": 1.7},
+        )
+
+    def test_flour_is_matched_case_insensitively(self):
+        recipe = {"FLOUR": 200, "flour, rye": 100, "Water": 150}
+        self.assertEqual(baker_percentages(recipe)["Water"], 50.0)
+
+    def test_flour_itself_is_100_percent_when_it_is_the_only_flour(self):
+        self.assertEqual(baker_percentages({"Bread flour": 400, "Water": 280}),
+                         {"Bread flour": 100.0, "Water": 70.0})
+
+    def test_raises_when_there_is_no_flour(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_raises_when_flour_weighs_nothing(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
