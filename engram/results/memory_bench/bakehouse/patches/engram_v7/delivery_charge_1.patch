+DELIVERY_CHARGE_EXEMPT = ("AIDAN",)
diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index ae23e67..70fede3 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -41,6 +41,20 @@ def invoice_for(orderbook, customer, day):
     return Invoice(customer, day, lines)
 
 
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day, where
+    `subtotal` is the value of that order in pence before VAT.
+
+    Orders worth less than config.DELIVERY_CHARGE_BELOW_PENCE pay config.DELIVERY_CHARGE_PENCE.
+    Customers in config.DELIVERY_CHARGE_EXEMPT never pay it, and a day with no order (subtotal 0)
+    pays nothing."""
+    if subtotal < 0:
+        raise ValueError("subtotal must not be negative")
+    if customer_code in config.DELIVERY_CHARGE_EXEMPT or subtotal == 0:
+        return 0
+    return config.DELIVERY_CHARGE_PENCE if subtotal < config.DELIVERY_CHARGE_BELOW_PENCE else 0
+
+
 def format_pence(pence):
     """Pounds for an integer pence amount, e.g. 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
