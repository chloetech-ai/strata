@@ -0,0 +1,36 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rise_is_rounded_up_to_next_5p(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),  # 336 -> 340
+            Product("BAG", "Baguette", 95),  # 99.75 -> 100
+        ])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "BAG": 100})
+
+    def test_exact_multiple_after_rise_is_not_bumped(self):
+        catalog = Catalog([Product("CIA", "Ciabatta", 200)])  # 210 exactly
+        self.assertEqual(new_prices(catalog), {"CIA": 210})
+
+    def test_never_rounds_down(self):
+        catalog = Catalog([Product("ROL", "Bread roll", 1)])  # 1.05 -> 5
+        self.assertEqual(new_prices(catalog), {"ROL": 5})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_returns_every_product_code_with_integer_pence(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320), Product("BAG", "Baguette", 95)])
+        prices = new_prices(catalog)
+        self.assertEqual(set(prices), {"SOU", "BAG"})
+        for price in prices.values():
+            self.assertIsInstance(price, int)
+
+
+if __name__ == "__main__":
+    unittest.main()
