@@ -0,0 +1,20 @@
+"""Wholesale price changes."""
+
+RISE_PERCENT = 5  # January rise on all wholesale prices
+ROUND_UP_TO = 5  # pence; each new price is rounded up to the next multiple of this
+
+
+def new_prices(catalog):
+    """New wholesale price in pence for each product code.
+
+    Each price is raised by RISE_PERCENT and rounded up, never down, to the
+    next ROUND_UP_TO pence. Integer arithmetic only, so no float drift.
+    """
+    prices = {}
+    for product in catalog:
+        # product.price * (100 + RISE_PERCENT) is the raised price in hundredths of a penny
+        raised = product.price * (100 + RISE_PERCENT)
+        # ceiling division of raised / (100 * ROUND_UP_TO), then back to pence
+        steps = -(-raised // (100 * ROUND_UP_TO))
+        prices[product.code] = steps * ROUND_UP_TO
+    return prices
