+def export_invoices(invoices, path):
+    """Write `invoices` to `path` as a Ledgerly import for the VAT return: a CSV with a
+    header row, one row per invoice with its date (DD/MM/YYYY), customer code and total
+    in pounds with two decimals and a decimal point, e.g. 12.50, never pence."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f, lineterminator="\n")
+        writer.writerow(["date", "customer", "total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds(invoice.total())])
+
+
+def _pounds(pence):
+    """Pounds for an integer pence amount with a decimal point and two decimals, e.g. 1250 -> '12.50'."""
+    sign = "-" if pence < 0 else ""
+    pounds, remainder = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{remainder:02d}"
+
