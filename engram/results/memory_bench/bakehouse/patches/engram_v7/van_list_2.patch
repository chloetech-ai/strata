@@ -0,0 +1,13 @@
+"""The van's run: which drops to make on a given day."""
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path`, one per line in route order.
+
+    Only customers with orders for `day` appear. `customers` is the dict from customers.load_customers.
+    """
+    codes = orderbook.customers_for(day)
+    drops = sorted((customers[code] for code in codes), key=lambda c: c.route_seq)
+    with open(path, "w", encoding="utf-8") as f:
+        for drop in drops:
+            f.write(f"{drop.route_seq}. {drop.name}, {drop.address}, {drop.postcode}\n")
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
new file mode 100644
index 0000000..8f1676c
--- /dev/null
+++ b/tests/test_delivery.py
@@ -0,0 +1,47 @@
+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "drops.txt")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_drops_in_route_order_for_that_day_only(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        customers = {
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "2 Mill Lane", "AB1 2CD", 3),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "9 High St", "AB1 3EF", 1),
+            "AIDAN": Customer("AIDAN", "St Aidan's Primary", "Church Rd", "AB1 4GH", 2),
+        }
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(datetime.date(2026, 10, 21), "AIDAN", "BAG", 6),
+        ])
+        drops_file(book, customers, DAY, self.path)
+        with open(self.path, encoding="utf-8") as f:
+            self.assertEqual(f.read(), "1. Greenway Grocers, 9 High St, AB1 3EF\n3. Lumen Cafe, 2 Mill Lane, AB1 2CD\n")
+
+    def test_no_orders_writes_empty_file(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        customers = {"LUMEN": Customer("LUMEN", "Lumen Cafe", "2 Mill Lane", "AB1 2CD", 1)}
+        drops_file(OrderBook(catalog), customers, DAY, self.path)
+        with open(self.path, encoding="utf-8") as f:
+            self.assertEqual(f.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
