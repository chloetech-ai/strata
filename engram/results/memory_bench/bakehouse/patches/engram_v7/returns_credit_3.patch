+class ReturnsCreditTest(unittest.TestCase):
+    catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("BAG", "Baguette", 95)])
+
+    def test_prices_the_return_from_the_catalog(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 40, 3), 3 * 90)
+
+    def test_cap_applies(self):
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "SWL", 40, 10), 4 * 90)
+
+    def test_other_customer_or_product_gets_nothing(self):
+        self.assertEqual(returns_credit(self.catalog, "LUMEN", "SWL", 40, 4), 0)
+        self.assertEqual(returns_credit(self.catalog, "GREENWAY", "BAG", 40, 4), 0)
+
+    def test_unknown_product_code_is_an_error(self):
+        with self.assertRaises(KeyError):
+            returns_credit(self.catalog, "GREENWAY", "XXX", 40, 4)
+
+
 if __name__ == "__main__":
     unittest.main()
