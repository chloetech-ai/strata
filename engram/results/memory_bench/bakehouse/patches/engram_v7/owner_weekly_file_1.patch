+class WeekTotalsFileTest(unittest.TestCase):
+    def read_rows(self, book, week_start):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                return list(csv.reader(f, delimiter=";"))
+
+    def test_sums_seven_days_from_week_start_in_pounds(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12), Product("SOU", "White sourdough", 320, batch_size=10)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 10),
+            OrderLine(DAY + datetime.timedelta(days=2), "LUMEN", "BAG", 5),
+        ])
+        self.assertEqual(self.read_rows(book, DAY), [
+            ["customer", "total_gbp"],
+            ["GREENWAY", "19,00"],
+            ["LUMEN", "36,75"],
+        ])
+
+    def test_excludes_days_outside_the_week(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 3),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 3),
+        ])
+        self.assertEqual(self.read_rows(book, DAY), [["customer", "total_gbp"]])
+
+    def test_pads_pence_to_two_digits(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        self.assertEqual(self.read_rows(book, DAY)[1], ["LUMEN", "0,95"])
+
+
 if __name__ == "__main__":
     unittest.main()
