+"""Seasons: dates that set the bakery calendar, such as the hot cross bun season."""
+
+import datetime
+
+
+def easter_sunday(year):
+    """Date of Easter Sunday in the Western church (Gregorian calendar), for 1900 to 2199.
+    Anonymous Gregorian algorithm (Meeus/Jones/Butcher)."""
+    if not 1900 <= year <= 2199:
+        raise ValueError(f"easter_sunday is only defined here for 1900 to 2199, not {year}")
+    a = year % 19
+    b, c = divmod(year, 100)
+    d, e = divmod(b, 4)
+    f = (b + 8) // 25
+    g = (b - f + 1) // 3
+    h = (19 * a + b - d - g + 15) % 30
+    i, k = divmod(c, 4)
+    l = (32 + 2 * e + 2 * i - h - k) % 7
+    m = (a + 11 * h + 22 * l) // 451
+    month, day = divmod(h + l - 7 * m + 114, 31)
+    return datetime.date(year, month, day + 1)
