+"""The van's delivery run."""
+
+import csv
+
+
+def drops_file(orderbook, customers, day, path):
+    """Writes the van's drops for `day` to `path` as CSV, in driving order (route_seq).
+    Only customers with orders that day get a row."""
+    drops = sorted((customers[code] for code in orderbook.customers_for(day)), key=lambda c: c.route_seq)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Stop", "Code", "Name", "Address", "Postcode"])
+        for customer in drops:
+            writer.writerow([customer.route_seq, customer.code, customer.name, customer.address, customer.postcode])
diff --git a/tests/test_delivery.py b/tests/test_delivery.py
