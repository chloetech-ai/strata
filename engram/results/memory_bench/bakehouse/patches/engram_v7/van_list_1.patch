+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def read(self, path):
+        with open(path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_drops_in_route_order_only_for_that_day(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "1 High St", "AB1 2CD", 1),
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "2 Mill Rd", "AB3 4EF", 3),
+            "DELI": Customer("DELI", "Harbour Deli", "9 Quay", "AB5 6GH", 2),
+        }
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(datetime.date(2026, 10, 21), "DELI", "BAG", 3),
+        ])
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "drops.csv")
+            drops_file(book, customers, DAY, path)
+            self.assertEqual(self.read(path).splitlines(), [
+                "Stop,Code,Name,Address,Postcode",
+                "1,GREENWAY,Greenway Grocers,1 High St,AB1 2CD",
+                "3,LUMEN,Lumen Cafe,2 Mill Rd,AB3 4EF",
+            ])
+
+    def test_no_orders_gives_header_only(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95, batch_size=12)])
+        customers = {"LUMEN": Customer("LUMEN", "Lumen Cafe", "2 Mill Rd", "AB3 4EF", 1)}
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "drops.csv")
+            drops_file(OrderBook(catalog), customers, DAY, path)
+            self.assertEqual(self.read(path).splitlines(), ["Stop,Code,Name,Address,Postcode"])
+
+
+if __name__ == "__main__":
+    unittest.main()
