+
+
+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first.
+
+    The deck oven only cools down overnight, so products with the higher bake
+    temperature go first; reheating it mid-morning costs half an hour.
+    """
+    catalog = orderbook.catalog
+    rows = [
+        (catalog.get(code), units, batches)
+        for code, (units, batches) in plan(orderbook, day).items()
+    ]
+    rows.sort(key=lambda row: (-row[0].bake_temp, row[0].code))
+    width = max([len("Product")] + [len(product.name) for product, _units, _batches in rows])
+    lines = [f"{'Product':<{width}}  {'Units':>5}  {'Batches':>7}  {'Dough (g)':>9}"]
+    for product, units, batches in rows:
+        lines.append(
+            f"{product.name:<{width}}  {units:>5}  {batches:>7}  {dough_weight_g(product, units):>9}"
+        )
+    return "\n".join(lines)
