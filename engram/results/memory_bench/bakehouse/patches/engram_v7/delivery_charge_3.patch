     return Invoice(customer, day, lines)
 
 
+# Delivery charge from November, on the value of one customer's order for one delivery day, before VAT.
+DELIVERY_CHARGE = 450  # pence
+DELIVERY_CHARGE_BELOW = 4000  # pence: orders under £40.00 pay the charge
+NO_DELIVERY_CHARGE = ("AIDAN",)  # St Aidan's Primary: contract price already includes delivery
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order worth `subtotal` pence for one
+    delivery day, before VAT. Nothing is charged for an empty order, for orders of £40.00
+    or more, or for customers in NO_DELIVERY_CHARGE."""
+    if subtotal < 0:
+        raise ValueError("subtotal must not be negative")
+    if subtotal == 0 or customer_code in NO_DELIVERY_CHARGE or subtotal >= DELIVERY_CHARGE_BELOW:
+        return 0
+    return DELIVERY_CHARGE
+
+
 def format_pence(pence):
     """Pounds for an integer pence amount, e.g. 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
