     return f"{sign}£{pounds}.{remainder:02d}"
 
 
+def _pounds_plain(pence):
+    """Plain pounds for an integer pence amount, e.g. 1234 -> '12.34', -300 -> '-3.00'."""
+    sign = "-" if pence < 0 else ""
+    pounds, remainder = divmod(abs(pence), 100)
+    return f"{sign}{pounds}.{remainder:02d}"
+
+
+def export_invoices(invoices, path):
+    """Write `invoices` to `path` as a Ledgerly import CSV for the VAT return: a header row,
+    then one row per invoice with its date (DD/MM/YYYY), customer code and total in pounds.
+    Totals are before VAT, as invoices carry no VAT."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            writer.writerow([invoice.day.strftime("%d/%m/%Y"), invoice.customer, _pounds_plain(invoice.total())])
+
+
 def invoice_number(year, seq):
     """Invoice number for the `seq`th invoice of `year`, e.g. 2026, 1 -> 'LK-2026-0001'.
     The running number restarts at 1 each year and has four digits."""
