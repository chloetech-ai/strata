+class ExportInvoicesTest(unittest.TestCase):
+    def export(self, invoices):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 20), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 21), [InvoiceLine("BAG", 20, 95)]),
+        ]
+        self.assertEqual(self.export(invoices), "Date,Customer,Total\r\n20/10/2026,LUMEN,45.60\r\n21/10/2026,GREENWAY,19.00\r\n")
