diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index ae23e67..716cc07 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -41,6 +41,19 @@ def invoice_for(orderbook, customer, day):
     return Invoice(customer, day, lines)
 
 
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day,
+    where `subtotal` is that order's value in pence before VAT.
+
+    Orders under config.DELIVERY_CHARGE_BELOW_PENCE pay config.DELIVERY_CHARGE_PENCE.
+    Customers in config.NO_DELIVERY_CHARGE_CUSTOMERS never pay it."""
+    if customer_code in config.NO_DELIVERY_CHARGE_CUSTOMERS:
+        return 0
+    if subtotal < config.DELIVERY_CHARGE_BELOW_PENCE:
+        return config.DELIVERY_CHARGE_PENCE
+    return 0
+
+
 def format_pence(pence):
     """Pounds for an integer pence amount, e.g. 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
