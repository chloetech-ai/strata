+# DELIVERY_CHARGE_BELOW_PENCE (£40.00). Amounts are integer pence.
+DELIVERY_CHARGE_PENCE = 450
+DELIVERY_CHARGE_BELOW_PENCE = 4000
+# St Aidan's contract price already includes delivery.
