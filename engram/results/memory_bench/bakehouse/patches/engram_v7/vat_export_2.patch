+class ExportInvoicesTest(unittest.TestCase):
+    def test_one_row_per_invoice_in_ledgerly_format(self):
+        invoices = [
+            Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 24, 110), InvoiceLine("SOU", 6, 320)]),
+            Invoice("GREENWAY", datetime.date(2026, 10, 4), [InvoiceLine("BAG", 5, 95)]),
+            Invoice("AIDAN", datetime.date(2026, 12, 20)),
+        ]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                rows = list(csv.reader(f))
+        self.assertEqual(rows, [
+            ["Date", "Customer", "Total"],
+            ["01/10/2026", "LUMEN", "45.60"],
+            ["04/10/2026", "GREENWAY", "4.75"],
+            ["20/12/2026", "AIDAN", "0.00"],
+        ])
+
+    def test_no_pence_or_currency_symbol_in_raw_text(self):
+        invoices = [Invoice("LUMEN", datetime.date(2026, 10, 1), [InvoiceLine("CRO", 1, 5)])]
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                text = f.read()
+        self.assertEqual(text, "Date,Customer,Total\r\n01/10/2026,LUMEN,0.05\r\n")
+
