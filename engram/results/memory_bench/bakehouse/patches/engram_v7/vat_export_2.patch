+def export_invoices(invoices, path):
+    """Writes one row per invoice (date, customer code, total) to `path` as a Ledgerly
+    import file: plain comma-separated with a header row, DD/MM/YYYY dates, and totals
+    in pounds with a decimal point and two decimals, e.g. 1234 -> 12.34, never pence."""
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(["Date", "Customer", "Total"])
+        for invoice in invoices:
+            total = invoice.total()
+            sign = "-" if total < 0 else ""
+            pounds, remainder = divmod(abs(total), 100)
+            writer.writerow([
+                invoice.day.strftime("%d/%m/%Y"),
+                invoice.customer,
+                f"{sign}{pounds}.{remainder:02d}",
+            ])
+
+
 def invoice_number(year, seq):
     """Invoice number for the `seq`th invoice of `year`, e.g. 2026, 1 -> 'LK-2026-0001'.
     The running number restarts at 1 each year and has four digits."""
