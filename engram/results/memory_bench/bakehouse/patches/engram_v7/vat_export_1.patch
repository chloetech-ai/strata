+class FormatPoundsPlainTest(unittest.TestCase):
+    def test_pounds_with_two_decimals_and_no_currency_sign(self):
+        self.assertEqual(format_pounds_plain(1234), "12.34")
+
+    def test_pence_only_keeps_two_digits(self):
+        self.assertEqual(format_pounds_plain(5), "0.05")
+
+    def test_whole_pounds(self):
+        self.assertEqual(format_pounds_plain(300), "3.00")
+
+    def test_negative_gets_leading_minus(self):
+        self.assertEqual(format_pounds_plain(-300), "-3.00")
+
+
+class ExportInvoicesTest(unittest.TestCase):
+    def export(self, invoices):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, "invoices.csv")
+            export_invoices(invoices, path)
+            with open(path, newline="", encoding="utf-8") as f:
+                return f.read()
+
+    def test_header_then_one_row_per_invoice(self):
+        invoices = [
