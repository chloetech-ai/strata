+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first, so the deck oven cools down as little as possible."""
+    catalog = orderbook.catalog
+    rows = [
+        (catalog.get(code), units, batches)
+        for code, (units, batches) in plan(orderbook, day).items()
+    ]
+    rows.sort(key=lambda row: -row[0].bake_temp)  # stable: equal temperatures keep product code order
+    return "\n".join(
+        f"{product.name}  units {units}  batches {batches}  dough {dough_weight_g(product, units)} g"
+        for product, units, batches in rows
+    )
