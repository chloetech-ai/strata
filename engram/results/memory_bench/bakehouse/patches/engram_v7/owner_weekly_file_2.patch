+class WeekTotalsFileTest(unittest.TestCase):
+    def read_file(self, book, week_start):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "week.csv")
+            week_totals_file(book, week_start, path)
+            with open(path, newline="", encoding="utf-8-sig") as f:
+                return f.read()
+
+    def test_totals_in_pounds_semicolon_and_comma_decimal(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95), Product("SOU", "White sourdough", 320)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY + datetime.timedelta(days=6), "LUMEN", "SOU", 10),
+            OrderLine(DAY, "AIDAN", "BAG", 1),
+        ])
+        self.assertEqual(self.read_file(book, DAY), "customer;total_gbp\r\nAIDAN;0,95\r\nLUMEN;36,75\r\n")
+
+    def test_only_days_in_the_seven_day_window(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        book = OrderBook(catalog, [
+            OrderLine(DAY - datetime.timedelta(days=1), "LUMEN", "BAG", 100),
+            OrderLine(DAY + datetime.timedelta(days=7), "LUMEN", "BAG", 100),
+            OrderLine(DAY + datetime.timedelta(days=2), "GREENWAY", "BAG", 3),
+        ])
+        self.assertEqual(self.read_file(book, DAY), "customer;total_gbp\r\nGREENWAY;2,85\r\n")
+
+    def test_pence_below_ten_keep_two_digits(self):
+        catalog = Catalog([Product("CHE", "Cheap bun", 5)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LUMEN", "CHE", 3)])
+        self.assertEqual(self.read_file(book, DAY), "customer;total_gbp\r\nLUMEN;0,15\r\n")
+
+    def test_no_orders_gives_header_only(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        self.assertEqual(self.read_file(OrderBook(catalog), DAY), "customer;total_gbp\r\n")
+
+
 if __name__ == "__main__":
     unittest.main()
