@@ -41,6 +41,24 @@ def invoice_for(orderbook, customer, day):
     return Invoice(customer, day, lines)
 
 
+# Delivery charge from November: £4.50 on an order under £40.00 (before VAT).
+DELIVERY_CHARGE = 450  # pence
+DELIVERY_CHARGE_BELOW = 4000  # pence
+# St Aidan's contract price already includes delivery.
+DELIVERY_EXEMPT_CUSTOMERS = ("AIDAN",)
+
+
+def delivery_charge(customer_code, subtotal):
+    """Delivery charge in pence for `customer_code`'s order for one delivery day.
+    `subtotal` is the value of that order in pence, before VAT. A day with no order
+    is not charged, and St Aidan's is never charged."""
+    if subtotal < 0:
+        raise ValueError("subtotal must not be negative")
+    if customer_code in DELIVERY_EXEMPT_CUSTOMERS or subtotal == 0:
+        return 0
+    return DELIVERY_CHARGE if subtotal < DELIVERY_CHARGE_BELOW else 0
+
+
 def format_pence(pence):
     """Pounds for an integer pence amount, e.g. 1234 -> '£12.34', -300 -> '-£3.00'."""
     sign = "-" if pence < 0 else ""
