+class DeliveryChargeTest(unittest.TestCase):
+    def test_order_under_40_pounds_pays_450(self):
+        self.assertEqual(delivery_charge("LUMEN", 3999), 450)
+        self.assertEqual(delivery_charge("LUMEN", 1), 450)
+
+    def test_order_of_40_pounds_or_more_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 4000), 0)
+        self.assertEqual(delivery_charge("GREENWAY", 8135), 0)
+
+    def test_no_order_pays_nothing(self):
+        self.assertEqual(delivery_charge("LUMEN", 0), 0)
+
+    def test_st_aidans_never_pays(self):
+        self.assertEqual(delivery_charge("AIDAN", 2100), 0)
+        self.assertEqual(delivery_charge("AIDAN", 1), 0)
+
+    def test_negative_subtotal_rejected(self):
+        with self.assertRaises(ValueError):
+            delivery_charge("LUMEN", -1)
