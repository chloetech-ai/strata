+def bake_sheet(orderbook, day):
+    """Text bake sheet for `day`: one line per product, hottest oven first.
+
+    The deck oven only cools down overnight, so the highest bake temperature comes first.
+    """
+    catalog = orderbook.catalog
+    day_plan = plan(orderbook, day)
+    codes = sorted(day_plan, key=lambda code: (-catalog.get(code).bake_temp, code))
+    name_width = max((len(catalog.get(code).name) for code in codes), default=0)
+    lines = []
+    for code in codes:
+        product = catalog.get(code)
+        units, batches = day_plan[code]
+        grams = dough_weight_g(product, units)
+        lines.append(
+            f"{product.name:<{name_width}}  {units:>4} units  {batches:>2} batches  {grams:>7} g dough"
+        )
+    return "\n".join(lines)
