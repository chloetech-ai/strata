@@ -0,0 +1,21 @@
+"""Wholesale price changes."""
+
+# January rise: 5% on every wholesale price, each new price rounded up to the next 5p.
+RISE_PERCENT = 5
+ROUND_TO_PENCE = 5
+
+
+def new_price(price):
+    """The price after the January rise, in pence.
+
+    Works in whole pence so there is no float rounding: the rise is
+    price * 105 / 100, and rounding up to a multiple of 5 is a ceiling division.
+    """
+    raised = price * (100 + RISE_PERCENT)  # in hundredths of a penny
+    step = 100 * ROUND_TO_PENCE
+    return -(-raised // step) * ROUND_TO_PENCE
+
+
+def new_prices(catalog):
+    """Maps each product code in `catalog` to its new wholesale price in pence."""
+    return {product.code: new_price(product.price) for product in catalog}
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
new file mode 100644
index 0000000..faa30c2
--- /dev/null
+++ b/tests/test_pricing.py
@@ -0,0 +1,37 @@
+import unittest
+
+from bakehouse.pricing import new_price, new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPriceTest(unittest.TestCase):
+    def test_rise_is_rounded_up_to_next_5p(self):
+        self.assertEqual(new_price(320), 340)  # 336 -> 340
+        self.assertEqual(new_price(360), 380)  # 378 -> 380
+        self.assertEqual(new_price(180), 190)  # 189 -> 190
+
+    def test_never_rounds_down(self):
+        self.assertEqual(new_price(101), 110)  # 106.05 -> 110, not 105
+
+    def test_exact_multiple_of_5p_is_unchanged_by_rounding(self):
+        self.assertEqual(new_price(100), 105)  # 105.00 exactly
+        self.assertEqual(new_price(200), 210)  # 210.00 exactly
+
+    def test_zero_stays_zero(self):
+        self.assertEqual(new_price(0), 0)
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_maps_each_code_to_new_price(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),
+            Product("SWL", "Sandwich loaf", 180),
+        ])
+        self.assertEqual(new_prices(catalog), {"SOU": 340, "SWL": 190})
+
+    def test_empty_catalog_gives_empty_dict(self):
+        self.assertEqual(new_prices(Catalog()), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
