+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong White Flour": 500, "Wholegrain Flour": 100, "Water": 350, "Salt": 10}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong White Flour": 83.3, "Wholegrain Flour": 16.7, "Water": 58.3, "Salt": 1.7},
+        )
+
+    def test_flour_is_matched_in_any_case(self):
+        self.assertEqual(baker_percentages({"FLOUR": 200, "water": 100}), {"FLOUR": 100.0, "water": 50.0})
+
+    def test_no_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 300, "Salt": 10})
+
+    def test_zero_flour_raises(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 300})
+
+
+if __name__ == "__main__":
+    unittest.main()
