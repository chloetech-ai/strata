+"""Crate labels for the packing room. The label printer prints plain ASCII only, fits
+48 characters per line and cuts off anything longer rather than wrapping it."""
+
+import textwrap
+import unicodedata
+
+from .invoice import invoice_for
+
+LINE_WIDTH = 48
+
+
+def ascii_text(text):
+    """`text` with accents folded to plain ASCII, e.g. 'Café' -> 'Cafe'. Other characters are dropped."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as a list of strings.
+
+    Labels follow the van run (route_seq), then product code. Each label is the customer's
+    name, then the quantity and product name, then the allergens in capitals. Every line is
+    wrapped to LINE_WIDTH characters, so nothing is cut off."""
+    labels = []
+    for code in sorted(orderbook.customers_for(day), key=lambda c: customers[c].route_seq):
+        for line in invoice_for(orderbook, code, day).lines:
+            product = orderbook.catalog.get(line.product)
+            parts = [customers[code].name, f"{line.qty} x {product.name}"]
+            if product.allergens:
+                parts.append(f"ALLERGENS: {product.allergen_text()}")
+            lines = []
+            for part in parts:
+                lines.extend(textwrap.wrap(ascii_text(part), LINE_WIDTH))
+            labels.append("\n".join(lines))
+    return labels
