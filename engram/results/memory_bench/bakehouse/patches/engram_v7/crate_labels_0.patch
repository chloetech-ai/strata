+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import ascii_text, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Product("CRO", "Croissant", 110),
+            Product("RYE", "Seeded rye sourdough", 360, allergens=("wheat", "sesame", "rye")),
+            Product("SOU", "White sourdough", 320),
+        ])
+        self.customers = {
+            "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 2),
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "1 High St", "LK3 4CD", 1),
+        }
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "SOU", 6),
+            OrderLine(DAY, "LUMEN", "CRO", 10),
+            OrderLine(DAY, "GREENWAY", "CRO", 20),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Greenway Grocers\n20 x Croissant",
+            "Cafe Lumen\n10 x Croissant",
+            "Cafe Lumen\n6 x White sourdough",
+        ])
+
+    def test_quantities_for_the_same_product_are_summed(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "CRO", 10),
+            OrderLine(DAY, "LUMEN", "CRO", 14),
+        ])
+        self.assertEqual(crate_labels(book, self.customers, DAY), ["Cafe Lumen\n24 x Croissant"])
+
+    def test_allergens_follow_in_capitals(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "RYE", 4)])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [
+            "Cafe Lumen\n4 x Seeded rye sourdough\nALLERGENS: RYE, SESAME, WHEAT",
+        ])
+
+    def test_long_lines_wrap_and_stay_within_48_characters(self):
+        long_name = "The Very Long Name Of A Café And Delicatessen Company Limited"
+        customers = {"LUMEN": Customer("LUMEN", long_name, "14 Mill Lane", "LK1 2AB", 1)}
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "RYE", 4)])
+        label = crate_labels(book, customers, DAY)[0]
+        lines = label.split("\n")
+        self.assertTrue(all(len(line) <= 48 for line in lines), lines)
+        self.assertEqual(" ".join(lines[:-2]), long_name.replace("é", "e"))
+        self.assertEqual(lines[-1], "ALLERGENS: RYE, SESAME, WHEAT")
+
+    def test_other_days_and_empty_days_give_no_labels(self):
+        book = OrderBook(self.catalog, [OrderLine(datetime.date(2026, 10, 21), "LUMEN", "CRO", 5)])
+        self.assertEqual(crate_labels(book, self.customers, DAY), [])
+
+    def test_ascii_text_folds_accents(self):
+        self.assertEqual(ascii_text("Crème brûlée"), "Creme brulee")
+
+
+if __name__ == "__main__":
+    unittest.main()
