+import unittest
+
+from bakehouse.recipes import baker_percentages
+
+
+class BakerPercentagesTest(unittest.TestCase):
+    def test_percentages_are_of_total_flour_weight(self):
+        recipe = {"Strong white flour": 500, "Water": 350, "Salt": 10, "Yeast": 2}
+        self.assertEqual(
+            baker_percentages(recipe),
+            {"Strong white flour": 100.0, "Water": 70.0, "Salt": 2.0, "Yeast": 0.4},
+        )
+
+    def test_every_flour_counts_towards_the_total(self):
+        recipe = {"White Flour": 300, "Rye FLOUR": 200, "Water": 400}
+        result = baker_percentages(recipe)
+        self.assertEqual(result["White Flour"], 60.0)
+        self.assertEqual(result["Rye FLOUR"], 40.0)
+        self.assertEqual(result["Water"], 80.0)
+
+    def test_rounds_to_one_decimal_place(self):
+        recipe = {"Flour": 300, "Water": 200, "Starter": 1}
+        self.assertEqual(baker_percentages(recipe)["Starter"], 0.3)
+
+    def test_recipe_without_flour_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Water": 350, "Salt": 10})
+
+    def test_flour_weight_of_zero_is_rejected(self):
+        with self.assertRaises(ValueError):
+            baker_percentages({"Flour": 0, "Water": 350})
+
+
+if __name__ == "__main__":
+    unittest.main()
