+"""Crate labels for packing. The label printer prints plain ASCII, 48 characters a line,
+and cuts off anything longer rather than wrapping it, so text is wrapped here first."""
+
+import textwrap
+import unicodedata
+
+LINE_WIDTH = 48
+
+
+def _ascii(text):
+    """Text the printer can print: accents dropped to their plain letters, e.g. 'Café' -> 'Cafe'."""
+    return unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
+
+
+def _lines(text):
+    """`text` split into lines of at most LINE_WIDTH characters, wrapping at spaces."""
+    return textwrap.wrap(_ascii(text), LINE_WIDTH, break_long_words=True) or [""]
+
+
+def crate_labels(orderbook, customers, day):
+    """One label per customer and product ordered for delivery on `day`, as a list of strings.
+
+    Customers come in route order, then products by code. Each label is:
+    the customer's name, the quantity and product name, then the allergens (if any),
+    one printer line each. Nothing is cut off; long text wraps onto more lines.
+    """
+    totals = {}
+    for line in orderbook.for_day(day):
+        key = (line.customer, line.product)
+        totals[key] = totals.get(key, 0) + line.qty
+    catalog = orderbook.catalog
+    keys = sorted(totals, key=lambda key: (customers[key[0]].route_seq, key[1]))
+    labels = []
+    for customer_code, product_code in keys:
+        product = catalog.get(product_code)
+        qty = totals[(customer_code, product_code)]
+        printed = _lines(customers[customer_code].name) + _lines(f"{qty} x {product.name}")
+        if product.allergens:
+            printed += _lines(f"ALLERGENS: {product.allergen_text()}")
+        labels.append("\n".join(printed))
+    return labels
diff --git a/tests/test_labels.py b/tests/test_labels.py
