@@ -0,0 +1,73 @@
+import datetime
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.labels import LINE_WIDTH, crate_labels
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+def customers():
+    return {
+        "LUMEN": Customer("LUMEN", "Café Lumen", "14 Mill Lane", "LK1 2AB", 2),
+        "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "1 High Street", "LK3 4CD", 1),
+    }
+
+
+class CrateLabelsTest(unittest.TestCase):
+    def catalog(self):
+        return Catalog([
+            Product("BAG", "Baguette", 95, batch_size=12),
+            Product("SAN", "Sandwich loaf", 250, batch_size=8, allergens=("milk", "gluten")),
+        ])
+
+    def test_one_label_per_customer_and_product_in_route_order(self):
+        book = OrderBook(self.catalog(), [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "GREENWAY", "SAN", 3),
+            OrderLine(DAY, "GREENWAY", "BAG", 7),
+        ])
+        labels = crate_labels(book, customers(), DAY)
+        self.assertEqual(labels, [
+            "Greenway Grocers\n7 x Baguette",
+            "Greenway Grocers\n3 x Sandwich loaf\nALLERGENS: GLUTEN, MILK",
+            "Cafe Lumen\n5 x Baguette",
+        ])
+
+    def test_quantities_summed_across_a_customers_lines_for_the_product(self):
+        book = OrderBook(self.catalog(), [
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+            OrderLine(DAY, "LUMEN", "BAG", 4),
+        ])
+        self.assertEqual(crate_labels(book, customers(), DAY), ["Cafe Lumen\n6 x Baguette"])
+
+    def test_other_days_are_ignored(self):
+        book = OrderBook(self.catalog(), [OrderLine(DAY + datetime.timedelta(days=1), "LUMEN", "BAG", 5)])
+        self.assertEqual(crate_labels(book, customers(), DAY), [])
+
+    def test_no_allergen_line_for_products_without_allergens(self):
+        book = OrderBook(self.catalog(), [OrderLine(DAY, "LUMEN", "BAG", 1)])
+        self.assertEqual(len(crate_labels(book, customers(), DAY)[0].split("\n")), 2)
+
+    def test_every_printed_line_fits_and_is_ascii(self):
+        long_name = "Ünïcödé Bakers & Sons of the Very Long Named Riverside Terrace Co Ltd"
+        many = ("egg", "milk", "gluten", "sesame", "mustard", "celery", "lupin", "soya", "sulphites", "nuts")
+        catalog = Catalog([Product("X", "A product name that is long enough to need wrapping onto two lines", 100, allergens=many)])
+        book = OrderBook(catalog, [OrderLine(DAY, "LONG", "X", 12)])
+        custs = {"LONG": Customer("LONG", long_name, "1 Road", "LK1 1AA", 1)}
+        (label,) = crate_labels(book, custs, DAY)
+        lines = label.split("\n")
+        self.assertGreater(len(lines), 4)
+        for line in lines:
+            self.assertLessEqual(len(line), LINE_WIDTH)
+            line.encode("ascii")
+        self.assertIn("ALLERGENS: CELERY, EGG, GLUTEN, LUPIN, MILK, MUSTARD, NUTS, SESAME, SOYA, SULPHITES", label.replace("\n", " "))
+
+    def test_empty_day_gives_no_labels(self):
+        self.assertEqual(crate_labels(OrderBook(self.catalog()), customers(), DAY), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
