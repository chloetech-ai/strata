+++ b/tests/test_pricing.py
@@ -0,0 +1,37 @@
+import unittest
+
+from bakehouse.pricing import new_prices
+from bakehouse.products import Catalog, Product
+
+
+class NewPricesTest(unittest.TestCase):
+    def test_rise_is_five_percent_rounded_up_to_next_5p(self):
+        catalog = Catalog([Product("SOU", "White sourdough", 320)])
+        # 320p * 1.05 = 336p, rounded up to 340p
+        self.assertEqual(new_prices(catalog), {"SOU": 340})
+
+    def test_exact_multiple_of_5p_is_not_bumped(self):
+        catalog = Catalog([Product("BUN", "Bun", 100)])
+        # 100p * 1.05 = 105p exactly
+        self.assertEqual(new_prices(catalog), {"BUN": 105})
+
+    def test_never_rounds_down(self):
+        catalog = Catalog([Product("BAG", "Baguette", 95)])
+        # 95p * 1.05 = 99.75p, rounded up to 100p (not down to 95p)
+        self.assertEqual(new_prices(catalog), {"BAG": 100})
+
+    def test_zero_price_stays_zero(self):
+        catalog = Catalog([Product("FREE", "Sample", 0)])
+        self.assertEqual(new_prices(catalog), {"FREE": 0})
+
+    def test_covers_every_product(self):
+        catalog = Catalog([
+            Product("SOU", "White sourdough", 320),
+            Product("SWL", "Sandwich loaf", 180),
+        ])
+        self.assertEqual(set(new_prices(catalog)), {"SOU", "SWL"})
+        self.assertEqual(new_prices(catalog)["SWL"], 190)  # 189p -> 190p
+
+
+if __name__ == "__main__":
+    unittest.main()
