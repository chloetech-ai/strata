+"""Wholesale price changes."""
+
+# January rise: 5% on every wholesale price, then rounded up to the next 5p.
+# Rounding is always up, never down, so the cafés' price boards stay in round 5p steps.
+JANUARY_RISE_PERCENT = 5
+ROUND_UP_TO_PENCE = 5
+
+
+def new_prices(catalog):
+    """Maps each product code to its new wholesale price in pence after the January rise."""
+    prices = {}
+    for product in catalog:
+        # Integer arithmetic: ceil(price * (100 + rise) / 100 / step) * step, without floats.
+        raw = product.price * (100 + JANUARY_RISE_PERCENT)
+        step = 100 * ROUND_UP_TO_PENCE
+        prices[product.code] = -(-raw // step) * ROUND_UP_TO_PENCE
+    return prices
diff --git a/tests/test_pricing.py b/tests/test_pricing.py
