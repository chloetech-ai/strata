+import datetime
+import os
+import tempfile
+import unittest
+
+from bakehouse.customers import Customer
+from bakehouse.delivery import drops_file
+from bakehouse.orders import OrderBook, OrderLine
+from bakehouse.products import Catalog, Product
+
+DAY = datetime.date(2026, 10, 20)
+
+
+class DropsFileTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([Product("BAG", "Baguette", 95)])
+        self.customers = {
+            "GREENWAY": Customer("GREENWAY", "Greenway Grocers", "1 High St", "AB1 2CD", 3),
+            "LUMEN": Customer("LUMEN", "Lumen Cafe", "9 Mill Lane", "AB3 4EF", 1),
+            "AIDAN": Customer("AIDAN", "St Aidan's Primary", "Church Rd", "AB5 6GH", 2),
+        }
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.tmp.name, "drops.txt")
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def read(self):
+        with open(self.path, encoding="utf-8") as f:
+            return f.read()
+
+    def test_drops_in_route_order_for_that_day_only(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "GREENWAY", "BAG", 20),
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(datetime.date(2026, 10, 21), "AIDAN", "BAG", 9),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), (
+            "1. Lumen Cafe, 9 Mill Lane, AB3 4EF\n"
+            "3. Greenway Grocers, 1 High St, AB1 2CD\n"
+        ))
+
+    def test_customer_with_several_lines_appears_once(self):
+        book = OrderBook(self.catalog, [
+            OrderLine(DAY, "LUMEN", "BAG", 5),
+            OrderLine(DAY, "LUMEN", "BAG", 2),
+        ])
+        drops_file(book, self.customers, DAY, self.path)
+        self.assertEqual(self.read(), "1. Lumen Cafe, 9 Mill Lane, AB3 4EF\n")
+
+    def test_no_orders_for_day_writes_empty_file(self):
+        book = OrderBook(self.catalog, [OrderLine(DAY, "LUMEN", "BAG", 5)])
+        drops_file(book, self.customers, datetime.date(2026, 10, 22), self.path)
+        self.assertEqual(self.read(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
