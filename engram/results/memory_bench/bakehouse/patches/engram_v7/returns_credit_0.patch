index 8636bbf..8d50970 100644
--- a/src/bakehouse/config.py
+++ b/src/bakehouse/config.py
@@ -11,3 +11,11 @@ ORDER_CUTOFF = datetime.time(13, 0)
 # Weekdays on which we neither bake nor deliver (Monday is 0, Sunday is 6).
 # Monday since November: we have the stall at the Sunday farmers' market.
 CLOSED_WEEKDAYS = (0,)
+
+# Sale-or-return for unsold loaves sent back the next morning: only this customer
+# and product earn a credit, at this percentage of wholesale price per loaf, for at
+# most this percentage of the loaves delivered that day.
+SALE_OR_RETURN_CUSTOMER = "GREENWAY"
+SALE_OR_RETURN_PRODUCT = "SWL"  # sandwich loaf
+SALE_OR_RETURN_RATE_PERCENT = 50
+SALE_OR_RETURN_CAP_PERCENT = 10
diff --git a/src/bakehouse/invoice.py b/src/bakehouse/invoice.py
index ae23e67..1b754a6 100644
--- a/src/bakehouse/invoice.py
+++ b/src/bakehouse/invoice.py
@@ -70,3 +70,10 @@ def sale_or_return_credit(customer, product, delivered, returned, unit_price):
         return 0
     creditable = min(returned, delivered * config.SALE_OR_RETURN_CAP_PERCENT // 100)
     return creditable * unit_price * config.SALE_OR_RETURN_RATE_PERCENT // 100
+
+
+def returns_credit(catalog, customer_code, product_code, delivered, returned):
+    """Pence credited for one delivery's returns, at the catalog's wholesale price.
+    See sale_or_return_credit for the rules."""
+    unit_price = catalog.get(product_code).price
+    return sale_or_return_credit(customer_code, product_code, delivered, returned, unit_price)
