+    def test_returns_credit_uses_catalog_price(self):
+        catalog = Catalog([Product("SWL", "Sandwich loaf", 180), Product("BAG", "Baguette", 95)])
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 40, 3), 3 * 90)
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "SWL", 40, 10), 4 * 90)
+        self.assertEqual(returns_credit(catalog, "LUMEN", "SWL", 40, 4), 0)
+        self.assertEqual(returns_credit(catalog, "GREENWAY", "BAG", 40, 4), 0)
