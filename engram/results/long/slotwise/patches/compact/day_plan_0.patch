@@ -0,0 +1,59 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import LINE_WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 10, 12)
+
+
+def at(hour, minute=0):
+    return datetime.datetime.combine(MONDAY, datetime.time(hour, minute))
+
+
+class DayPlanTest(unittest.TestCase):
+    def setUp(self):
+        self.schedule = Schedule()
+
+    def test_lists_appointments_by_time(self):
+        self.schedule.book(Appointment("lindqvist", "Kim Weber", at(10), "short"))
+        self.schedule.book(Appointment("lindqvist", "Jo Li", at(8, 30), "initial"))
+        self.assertEqual(
+            day_plan(self.schedule, "lindqvist", MONDAY),
+            "Lindqvist - Monday 12.10.2026\n"
+            "\n"
+            "08:30-09:30 initial\n"
+            "  Jo Li\n"
+            "10:00-10:30 short\n"
+            "  Kim Weber",
+        )
+
+    def test_empty_day(self):
+        self.assertEqual(
+            day_plan(self.schedule, "lindqvist", MONDAY),
+            "Lindqvist - Monday 12.10.2026\n\nNo appointments.",
+        )
+
+    def test_cancelled_appointments_are_left_out(self):
+        booked = self.schedule.book(Appointment("lindqvist", "Kim Weber", at(9)))
+        self.schedule.cancel(booked.id)
+        self.assertIn("No appointments.", day_plan(self.schedule, "lindqvist", MONDAY))
+
+    def test_other_therapists_are_left_out(self):
+        self.schedule.book(Appointment("meier", "Jo Li", at(9)))
+        self.assertIn("No appointments.", day_plan(self.schedule, "lindqvist", MONDAY))
+
+    def test_every_line_fits_the_printer(self):
+        long_name = "Maria Verónica-Gabriela de los Ángeles Fernández-Moreno Schmidt-Zimmermann"
+        self.schedule.book(Appointment("lindqvist", long_name, at(9), "initial"))
+        self.schedule.book(Appointment("lindqvist", "Kim Weber", at(11)))
+        plan = day_plan(self.schedule, "lindqvist", MONDAY)
+        for line in plan.splitlines():
+            with self.subTest(line=line):
+                self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertIn(long_name, " ".join(line.strip() for line in plan.splitlines()))
+
+
+if __name__ == "__main__":
+    unittest.main()
