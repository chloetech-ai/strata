+"""Plain-text printouts for reception."""
+
+import textwrap
+
+# The receipt printer prints 42 characters a line; anything longer wraps into a mess.
+LINE_WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s active appointments on `day` as text that fits the receipt printer.
+
+    Cancelled appointments are left out. Each line is at most LINE_WIDTH characters.
+    """
+    lines = [f"{therapist.capitalize()} - {day:%A %d.%m.%Y}", ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for appointment in appointments:
+        lines.append(f"{appointment.start:%H:%M}-{appointment.end:%H:%M} {appointment.treatment}")
+        lines.extend(textwrap.wrap(appointment.client, LINE_WIDTH, initial_indent="  ", subsequent_indent="  "))
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
