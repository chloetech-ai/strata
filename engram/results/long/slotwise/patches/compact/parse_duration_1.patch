+"""Reads treatment lengths typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+# Forms: '1h', '1h30', '1h 30m', '1h 30 min' (hours, optional minutes),
+# '1:30' (hours:minutes), and '45', '45m', '45 min' (minutes only).
+_DURATION = re.compile(
+    r"(?:(?P<hours>\d+)\s*h\s*(?:(?P<h_minutes>\d+)\s*(?:min|m)?)?)"
+    r"|(?P<clock_hours>\d+):(?P<clock_minutes>\d{2})"
+    r"|(?P<minutes>\d+)\s*(?:min|m)?"
+)
+
+
+def parse_duration(text):
+    """Turns a duration written by hand into minutes, e.g. '1h 30m' -> 90.
+
+    Ignores case and surrounding spaces. Raises ValueError for empty input,
+    for zero, and for anything that is not one of the forms above.
+    """
+    wanted = text.strip().casefold()
+    if not wanted:
+        raise ValueError("Enter a duration, e.g. 45, 1h or 1:30.")
+    match = _DURATION.fullmatch(wanted)
+    if match is None:
+        raise ValueError(f"Cannot read duration {text!r}; try 45, 1h30 or 1:30.")
+
+    if match["hours"] is not None:
+        minutes = int(match["hours"]) * 60 + int(match["h_minutes"] or 0)
+    elif match["clock_hours"] is not None:
+        if int(match["clock_minutes"]) >= 60:
+            raise ValueError(f"Minutes must be below 60 in {text!r}.")
+        minutes = int(match["clock_hours"]) * 60 + int(match["clock_minutes"])
+    else:
+        minutes = int(match["minutes"])
+
+    if minutes == 0:
+        raise ValueError("A duration must be more than zero minutes.")
+    return minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
