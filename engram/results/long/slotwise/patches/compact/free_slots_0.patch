+import copy
 import datetime
 import unittest
 
@@ -120,6 +121,57 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 8))
 
+    def test_free_slots_on_empty_day_start_at_opening_on_grid(self):
+        day = datetime.date(2026, 9, 8)  # Tuesday, 07:30-19:00
+        slots = Schedule().free_slots("lena", day, 60)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))
+        self.assertEqual(len(slots), (19 * 60 - 7 * 60 - 30 - 60) // 15 + 1)  # 07:30 to 18:00 starts
+
+    def test_free_slots_on_closed_day_is_empty(self):
+        sunday = datetime.date(2026, 9, 13)
+        self.assertEqual(Schedule().free_slots("lena", sunday, 30), [])
+
+    def test_free_slots_saturday_ends_at_noon(self):
+        saturday = datetime.date(2026, 9, 12)  # 08:00-12:00
+        slots = Schedule().free_slots("lena", saturday, 45)
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 12, 11, 15))
+
+    def test_free_slots_respect_booking_and_buffer(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so nothing may end after 08:50 or start before 09:55
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # 08:15-08:45 ends 10 minutes before 09:00
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)  # 08:30-09:00 runs into it
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # starts inside the 10-minute buffer
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_agree_with_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(13, 15, client="Jo Li", treatment="short"))  # 13:15-13:45
+        day = datetime.date(2026, 9, 8)
+        offered = s.free_slots("lena", day, 45)
+        grid = [datetime.datetime.combine(day, datetime.time(7, 30)) + i * datetime.timedelta(minutes=15) for i in range(47)]
+        for start in grid:
+            with self.subTest(start=start):
+                trial = copy.deepcopy(s)
+                try:
+                    trial.book(Appointment("lena", "Test", start, "standard"))
+                    bookable = True
+                except (SlotTaken, OutsideOpeningHours):
+                    bookable = False
+                self.assertEqual(start in offered, bookable)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(10, therapist="marco", client="Jo Li"))
+        s.cancel(a.id)
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+
 
 if __name__ == "__main__":
