         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 8))
 
+    def fill_day(self, s, count, therapist="lena", cancel_last=False):
+        """Books `count` short treatments on 8 September, 40 minutes apart from 08:00."""
+        booked = []
+        for i in range(count):
+            start = datetime.datetime(2026, 9, 8, 8) + i * datetime.timedelta(minutes=40)
+            booked.append(s.book(Appointment(therapist, f"Client {i}", start, "short")))
+        if cancel_last:
+            s.cancel(booked[-1].id)
+        return booked
+
+    def test_not_fully_booked_below_cap(self):
+        s = Schedule()
+        self.fill_day(s, 6)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_fully_booked_at_cap(self):
+        s = Schedule()
+        self.fill_day(s, 7)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointment_does_not_count_towards_cap(self):
+        s = Schedule()
+        self.fill_day(s, 7, cancel_last=True)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_other_therapist_and_other_day_do_not_count(self):
+        s = Schedule()
+        self.fill_day(s, 7, therapist="marco")
+        self.fill_day(s, 6)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertTrue(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+
+    def test_book_does_not_enforce_cap(self):
+        s = Schedule()
+        self.fill_day(s, 7)
+        start = datetime.datetime(2026, 9, 8, 13, 0)
+        s.book(Appointment("lena", "Jo Li", start, "short"))
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
 
 if __name__ == "__main__":
