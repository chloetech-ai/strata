+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_and_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 6), (8, 9)]), [(1, 6), (8, 9)])
+
+    def test_separate_intervals_stay_separate(self):
+        self.assertEqual(merge_intervals([(1, 2), (3, 4)]), [(1, 2), (3, 4)])
+
+    def test_nested_interval_does_not_shorten_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_unsorted_input_is_sorted_by_start(self):
+        self.assertEqual(merge_intervals([(8, 9), (5, 6), (1, 3), (2, 5)]), [(1, 6), (8, 9)])
+
+    def test_datetimes_are_merged(self):
+        def at(hour, minute=0):
+            return datetime.datetime(2026, 10, 12, hour, minute)
+
+        result = merge_intervals([(at(9), at(9, 30)), (at(9, 30), at(10)), (at(11), at(12))])
+        self.assertEqual(result, [(at(9), at(10)), (at(11), at(12))])
+
+    def test_input_is_not_changed(self):
+        intervals = [(5, 6), (1, 3), (2, 5)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 5)])
+
+    def test_empty_input_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
