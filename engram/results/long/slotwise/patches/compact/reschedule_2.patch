+from slotwise.errors import BookingError, OutsideOpeningHours, SlotTaken
 from slotwise.model import Appointment
 from slotwise.schedule import Schedule
 
@@ -120,6 +120,56 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 8))
 
+    def test_reschedule_moves_appointment(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 15))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 15))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_may_overlap_its_own_old_time(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 20))
+        self.assertEqual(a.start.hour, 9)
+        self.assertEqual(a.start.minute, 20)
+
+    def test_reschedule_onto_taken_slot_keeps_old_time(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9))
+
+    def test_reschedule_respects_gap(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))  # 14:00-14:45
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 10))  # ends 13:55, only 5 minutes before
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 5))  # ends 13:50, 10 minutes before
+        self.assertEqual(a.start.hour, 13)
+
+    def test_reschedule_outside_opening_hours_keeps_old_time(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9))
+
+    def test_reschedule_cancelled_appointment_raises(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11))
+
+    def test_reschedule_unknown_id_raises(self):
+        with self.assertRaises(KeyError):
