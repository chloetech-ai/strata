+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to `new_start`, with the same checks as booking.
+
+        If the new time is not allowed, the appointment stays where it was.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("That appointment is cancelled, so it cannot be moved. Book a new appointment instead.")
