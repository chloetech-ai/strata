+    def test_reschedule_moves_start_and_keeps_the_rest(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11))
+        self.assertIs(moved, a)
+        self.assertEqual((a.start.hour, a.end.hour, a.therapist, a.client), (11, 11, "lena", "Kim Weber"))
+        self.assertEqual(a.end - a.start, datetime.timedelta(minutes=45))
+
+    def test_reschedule_frees_the_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11))
+        s.book(at(9, client="Jo Li"))
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00-09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start.hour * 60 + a.start.minute, 9 * 60 + 5)
+
+    def test_reschedule_into_taken_slot_leaves_it_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaises(SlotTaken):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 55))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9))
+
+    def test_reschedule_outside_opening_hours_leaves_it_unchanged(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9))
+
+    def test_reschedule_cancelled_appointment_raises(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaises(BookingError):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9))
+
+    def test_reschedule_unknown_id_raises(self):
+        with self.assertRaises(KeyError):
+            Schedule().reschedule(999999, datetime.datetime(2026, 9, 8, 11))
