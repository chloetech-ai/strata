+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to `new_start`, keeping its therapist, client and treatment.
+
+        The same rules as book() apply, and the appointment does not block its own old slot.
+        If the move is refused, the appointment stays where it was.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment was cancelled, so it cannot be moved. Book a new one instead.")
+        new_end = new_start + datetime.timedelta(minutes=appointment.minutes)
+        self._check_slot(appointment.therapist, new_start, new_end, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
+    def _check_slot(self, therapist, start, end, ignore=None):
+        """Raises if the practice is closed from `start` to `end`, or `therapist` is not free then."""
+        if not is_open_between(start, end):
+            raise OutsideOpeningHours(f"The practice is closed for that appointment ({start:%H:%M} to {end:%H:%M}).")
+        for other in self.appointments:
+            if other is ignore or other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                raise SlotTaken(
+                    f"{therapist.capitalize()} already has an appointment from "
+                    f"{other.start:%H:%M} to {other.end:%H:%M}. "
+                    f"Appointments need {BUFFER.seconds // 60} minutes between them."
+                )
+
