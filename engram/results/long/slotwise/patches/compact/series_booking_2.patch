+++ b/tests/test_series.py
@@ -0,0 +1,69 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise import series
+from slotwise.errors import BookingError, SeriesTooLong, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+MONDAY = datetime.datetime(2026, 10, 5, 9, 0)
+
+
+def week_later(weeks):
+    return MONDAY + datetime.timedelta(weeks=weeks)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def setUp(self):
+        self.schedule = Schedule()
+        self.first = Appointment("lena", "Kim Weber", MONDAY, "short")
+
+    def test_books_one_session_per_week_at_the_same_time(self):
+        booked = book_series(self.schedule, self.first, 3)
+        self.assertEqual([a.start for a in booked], [week_later(0), week_later(1), week_later(2)])
+        for appointment in booked:
+            self.assertEqual((appointment.therapist, appointment.client, appointment.treatment), ("lena", "Kim Weber", "short"))
+        self.assertEqual(self.schedule.appointments, booked)
+
+    def test_taken_week_is_skipped_and_series_continues_at_the_end(self):
+        self.schedule.book(Appointment("lena", "Jo Li", week_later(1), "short"))
+        booked = book_series(self.schedule, self.first, 3)
+        self.assertEqual([a.start for a in booked], [week_later(0), week_later(2), week_later(3)])
+
+    def test_other_therapists_do_not_take_the_week(self):
+        self.schedule.book(Appointment("omar", "Jo Li", week_later(1), "short"))
+        booked = book_series(self.schedule, self.first, 2)
+        self.assertEqual([a.start for a in booked], [week_later(0), week_later(1)])
+
+    def test_nine_sessions_is_allowed(self):
+        booked = book_series(self.schedule, self.first, MAX_SESSIONS)
+        self.assertEqual(len(booked), MAX_SESSIONS)
+
+    def test_more_than_nine_sessions_is_refused_and_nothing_is_booked(self):
+        with self.assertRaises(SeriesTooLong):
+            book_series(self.schedule, self.first, MAX_SESSIONS + 1)
+        self.assertEqual(self.schedule.appointments, [])
+
+    def test_first_session_already_taken_is_an_error(self):
+        self.schedule.book(Appointment("lena", "Jo Li", MONDAY, "short"))
+        with self.assertRaises(SlotTaken):
+            book_series(self.schedule, self.first, 2)
+        self.assertEqual(len(self.schedule.appointments), 1)
+
+    def test_incomplete_series_is_refused_and_rolled_back(self):
+        self.schedule.book(Appointment("lena", "Jo Li", week_later(1), "short"))
+        self.schedule.book(Appointment("lena", "Jo Li", week_later(2), "short"))
+        with mock.patch.object(series, "SEARCH_WEEKS", 3):
+            with self.assertRaises(BookingError):
+                book_series(self.schedule, self.first, 3)
+        self.assertEqual(len(self.schedule.appointments), 2)
+
+    def test_count_below_one_is_an_error(self):
+        with self.assertRaises(ValueError):
+            book_series(self.schedule, self.first, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
