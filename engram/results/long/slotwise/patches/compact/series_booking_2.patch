@@ -0,0 +1,54 @@
+"""Booking a series of weekly sessions, as doctors prescribe them."""
+
+import datetime
+
+from .errors import BookingError, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# The insurance pays for at most this many sessions per prescription.
+MAX_SESSIONS = 9
+
+# How many weeks ahead to look for free weeks before giving up.
+SEARCH_WEEKS = 26
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly appointments, starting with `first`, and returns them in date order.
+
+    Every session has the same therapist, client, treatment, weekday and time as `first`. A week that is already
+    taken is skipped, and the series continues in a later free week. If the series cannot be completed, nothing is
+    booked.
+    """
+    if count < 1:
+        raise ValueError("A series needs at least one session.")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(
+            f"A series can have at most {MAX_SESSIONS} sessions, because the insurance pays for "
+            f"{MAX_SESSIONS} per prescription. Please book {count} sessions as separate series."
+        )
+    booked = []
+    try:
+        booked.append(schedule.book(first))
+        week = 1
+        while len(booked) < count:
+            if week > SEARCH_WEEKS:
+                raise BookingError(
+                    f"Only {len(booked)} of the {count} sessions fit within {SEARCH_WEEKS} weeks. "
+                    "Nothing has been booked."
+                )
+            session = Appointment(
+                first.therapist,
+                first.client,
+                first.start + datetime.timedelta(weeks=week),
+                first.treatment,
+            )
+            try:
+                booked.append(schedule.book(session))
+            except SlotTaken:
+                pass  # That week is taken, so try the next one.
+            week += 1
+    except Exception:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
