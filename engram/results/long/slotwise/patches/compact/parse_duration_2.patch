+"""Reads the durations reception types in, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_PATTERN = re.compile(
+    r"(?:(?P<hours>\d+)\s*h\s*(?P<h_minutes>\d+)?\s*(?:m|min)?"
+    r"|(?P<clock_hours>\d+):(?P<clock_minutes>\d{2})"
+    r"|(?P<minutes>\d+)\s*(?:m|min)?)"
+)
+
+
+def parse_duration(text):
+    """Minutes for a duration like '45', '45 min', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Ignores case and surrounding spaces. Raises ValueError for empty input, zero,
+    or anything else, such as 'abc' or '-5'.
+    """
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("duration is empty")
+    match = _PATTERN.fullmatch(cleaned)
+    if match is None:
+        raise ValueError(f"not a duration: {text!r}")
+
+    if match["hours"] is not None:
+        minutes = int(match["hours"]) * 60
+        if match["h_minutes"] is not None:
+            minutes += _minute_part(match["h_minutes"], text)
+    elif match["clock_hours"] is not None:
+        minutes = int(match["clock_hours"]) * 60 + _minute_part(match["clock_minutes"], text)
+    else:
+        minutes = int(match["minutes"])
+
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _minute_part(digits, text):
+    """The minutes after an hour, which must be below 60."""
+    minutes = int(digits)
+    if minutes >= 60:
+        raise ValueError(f"minutes must be below 60: {text!r}")
+    return minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
