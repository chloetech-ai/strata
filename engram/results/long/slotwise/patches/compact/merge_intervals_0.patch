+"""Helpers for working with (start, end) ranges, such as appointment times."""
+
+
+def merge_intervals(intervals):
+    """Merges the (start, end) pairs that overlap or touch.
+
+    Works with ints or datetimes. The result is a new list of tuples sorted by start;
+    the list passed in is not changed.
+
+    merge_intervals([(1, 3), (2, 5), (5, 6), (8, 9)]) gives [(1, 6), (8, 9)]
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
