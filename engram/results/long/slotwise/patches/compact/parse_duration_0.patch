+"""Reads durations typed by reception, such as '45', '1h30' or '1:30', as minutes."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*(?:m|min)?")
+_HOURS = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"(\d+):(\d{2})")
+
+
+def parse_duration(text):
+    """Turns a duration like '45', '45 min', '1h', '1h 30m' or '1:30' into minutes.
+
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    cleaned = text.strip().lower()
+    if not cleaned:
+        raise ValueError("Enter a duration, for example 45 or 1h30.")
+
+    if match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match.group(1))
+    elif match := _HOURS.fullmatch(cleaned):
+        minutes = _total(match.group(1), match.group(2) or 0)
+    elif match := _CLOCK.fullmatch(cleaned):
+        minutes = _total(match.group(1), match.group(2))
+    else:
+        raise ValueError(f"Cannot read {text!r} as a duration, for example 45 or 1h30.")
+
+    if minutes == 0:
+        raise ValueError("A duration must be more than zero.")
+    return minutes
+
+
+def _total(hours, minutes):
+    """Hours and minutes as total minutes; minutes must be below 60."""
+    if int(minutes) >= 60:
+        raise ValueError(f"Minutes must be below 60, got {minutes}.")
+    return int(hours) * 60 + int(minutes)
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
