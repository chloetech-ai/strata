+    def test_day_with_fewer_than_seven_is_not_fully_booked(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 14):  # six appointments
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_seven_appointments_is_fully_booked(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for i in range(7):
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 8 + i, 0)))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointments_do_not_count(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 8 + i, 0))) for i in range(7)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_full_day_is_per_therapist(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for i in range(7):
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 8 + i, 0)))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
