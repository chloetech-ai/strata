+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import RECEPTION_NUMBER, reminder_text, to_ascii
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_are_spelled_out(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Jörg Müller"), "Joerg Mueller")
+        self.assertEqual(to_ascii("Strauß"), "Strauss")
+
+    def test_other_accents_are_dropped(self):
+        self.assertEqual(to_ascii("Hélène Dubois"), "Helene Dubois")
+
+    def test_plain_ascii_is_unchanged(self):
+        self.assertEqual(to_ascii("Kim Weber"), "Kim Weber")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def setUp(self):
+        self.appointment = Appointment(
+            therapist="Brändli",
+            client="Kim Weber",
+            start=datetime.datetime(2026, 10, 12, 14, 30),
+        )
+
+    def test_reminder_has_date_time_and_therapist(self):
+        text = reminder_text(self.appointment)
+        self.assertIn("12.10.", text)
+        self.assertIn("14:30", text)
+        self.assertIn("Braendli", text)
+
+    def test_reminder_has_reception_number(self):
+        self.assertIn(RECEPTION_NUMBER, reminder_text(self.appointment))
+
+    def test_reminder_is_plain_ascii(self):
+        text = reminder_text(self.appointment)
+        text.encode("ascii")
+
+    def test_reminder_leaves_out_the_patient_name(self):
+        self.assertNotIn("Kim", reminder_text(self.appointment))
+
+    def test_reminder_fits_in_one_sms(self):
+        self.appointment.therapist = "Maximilian-Konstantin Brändlinger-Schoenenberger"
+        self.assertLessEqual(len(reminder_text(self.appointment)), 160)
+
+    def test_too_long_reminder_is_refused(self):
+        self.appointment.therapist = "X" * 200
+        with self.assertRaises(ValueError):
+            reminder_text(self.appointment)
+
+
+if __name__ == "__main__":
+    unittest.main()
