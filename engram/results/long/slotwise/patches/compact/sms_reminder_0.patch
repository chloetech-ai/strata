+"""Reminder SMS texts.
+
+The SMS gateway only takes plain ASCII and a reminder must fit in one 160-character SMS.
+"""
+
+import unicodedata
+
+from .model import Appointment
+
+# The reception number, which must appear in every reminder so people can call to move
+# their appointment.
+RECEPTION_NUMBER = "044 512 77 30"
+
+MAX_LENGTH = 160
+
+# German letters that NFKD cannot split into a base letter and an accent.
+_GERMAN = {
+    "ä": "ae", "ö": "oe", "ü": "ue",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+    "ß": "ss",
+}
+
+
+def to_ascii(text):
+    """Turns 'Brändli' into 'Braendli' and drops other accents, e.g. 'é' into 'e'."""
+    for char, replacement in _GERMAN.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(char for char in decomposed if not unicodedata.combining(char))
+    stripped.encode("ascii")  # raises UnicodeEncodeError for anything else
+    return stripped
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`, in plain ASCII and at most 160 characters.
+
+    The patient's name is left out, because the SMS gateway is a third-party service.
+    """
+    when = appointment.start
+    text = (
+        f"Lindqvist Physio: Termin am {when:%d.%m.} um {when:%H:%M} "
+        f"bei {to_ascii(appointment.therapist)}. "
+        f"Verschieben: {RECEPTION_NUMBER}"
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}")
+    return text
