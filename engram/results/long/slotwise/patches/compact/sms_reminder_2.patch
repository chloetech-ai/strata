+"""The text of the SMS reminders sent before an appointment."""
+
+# The SMS gateway only takes plain ASCII, so the text avoids umlauts and accents.
+# It also leaves out the client's name, because the gateway is a third-party service.
+RECEPTION_NUMBER = "044 512 77 30"
+MAX_LENGTH = 160  # longer messages are billed as two SMS
+
+# Abbreviated German weekday names, indexed by datetime.weekday() (Monday is 0).
+WEEKDAYS = ("Mo", "Di", "Mi", "Do", "Fr", "Sa", "So")
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`, with the reception number so the client can call to move it."""
+    start = appointment.start
+    return (
+        f"Lindqvist Physio: Erinnerung an Ihren Termin am "
+        f"{WEEKDAYS[start.weekday()]} {start:%d.%m.} um {start:%H:%M}. "
+        f"Verschieben: {RECEPTION_NUMBER}."
+    )
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..24ffa99
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,38 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_NUMBER, reminder_text
+
+
+class ReminderTextTest(unittest.TestCase):
+    def setUp(self):
+        self.appointment = Appointment(
+            "Anna Keller", "Brändli Müller", datetime.datetime(2026, 10, 12, 14, 30)
+        )
+
+    def test_names_date_and_time(self):
+        text = reminder_text(self.appointment)
+        self.assertIn("Mo 12.10.", text)
+        self.assertIn("um 14:30", text)
+
+    def test_includes_reception_number(self):
+        self.assertIn(RECEPTION_NUMBER, reminder_text(self.appointment))
+
+    def test_plain_ascii_without_client_name(self):
+        text = reminder_text(self.appointment)
+        self.assertTrue(text.isascii())
+        self.assertNotIn("Brändli", text)
+        self.assertNotIn("Braendli", text)
+        self.assertNotIn("Müller", text)
+
+    def test_fits_in_one_sms(self):
+        self.assertLessEqual(len(reminder_text(self.appointment)), MAX_LENGTH)
+
+    def test_weekday_follows_the_date(self):
+        friday = Appointment("Anna Keller", "Kim Weber", datetime.datetime(2026, 10, 16, 8, 0))
+        self.assertIn("Fr 16.10.", reminder_text(friday))
+
+
+if __name__ == "__main__":
+    unittest.main()
