+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_intervals_are_kept_and_sorted(self):
+        self.assertEqual(merge_intervals([(5, 6), (1, 2)]), [(1, 2), (5, 6)])
+
+    def test_overlapping_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_contained_interval_does_not_shrink_the_result(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_chain_of_overlaps_becomes_one(self):
+        self.assertEqual(merge_intervals([(6, 8), (1, 3), (2, 5)]), [(1, 5), (6, 8)])
+
+    def test_datetimes_are_merged(self):
+        day = datetime.datetime(2026, 10, 12)
+        at = lambda hour: day.replace(hour=hour)
+        self.assertEqual(
+            merge_intervals([(at(9), at(10)), (at(8), at(9)), (at(11), at(12))]),
+            [(at(8), at(10)), (at(11), at(12))],
+        )
+
+    def test_input_is_not_changed(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
