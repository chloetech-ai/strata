+    def test_fully_booked_after_seven_appointments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        # Seven 30-minute treatments with 10 minutes between them, 08:00 to 12:30.
+        starts = [(8, 0), (8, 40), (9, 20), (10, 0), (10, 40), (11, 20), (12, 0)]
+        for i, (hour, minute) in enumerate(starts):
+            self.assertFalse(s.is_fully_booked("lena", day))
+            s.book(at(hour, minute, treatment="short", client=f"Client {i}"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cancelled_appointments_do_not_count_towards_limit(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        booked = [s.book(at(8 + i, 0, treatment="short", client=f"Client {i}")) for i in range(7)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
+    def test_fully_booked_is_per_therapist_and_day(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(at(8 + i, 0, treatment="short", client=f"Client {i}"))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_book_does_not_enforce_daily_limit(self):
+        s = Schedule()
+        for i in range(8):
+            s.book(at(8 + i, 0, treatment="short", client=f"Client {i}"))
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+
     def test_week_rejects_non_monday(self):
