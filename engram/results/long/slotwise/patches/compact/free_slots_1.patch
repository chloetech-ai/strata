+    def test_free_slots_on_empty_day_run_from_opening_to_closing(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 8), 30)  # Tuesday
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(len(slots), 45)
+
+    def test_free_slots_respect_buffer_around_booked_appointment(self):
+        s = Schedule()
+        s.book(at(9))  # standard, 09:00 to 09:45
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 30)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(9, therapist="tom", client="Jo Li"))
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), s.free_slots("lena", datetime.date(2026, 9, 8), 30))
+        s.cancel(a.id)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 30), s.free_slots("lena", datetime.date(2026, 9, 8), 30))
+
+    def test_free_slots_for_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 30), [])  # Sunday
+
+    def test_free_slots_must_fit_before_closing(self):
+        slots = Schedule().free_slots("lena", datetime.date(2026, 9, 12), 60)  # Saturday, 08:00 to 12:00
