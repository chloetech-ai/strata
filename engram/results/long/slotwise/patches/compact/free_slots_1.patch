+from .hours import is_open_between, opening_hours
 from .model import TREATMENTS
 
 # Time a therapist needs after each appointment to clean up and write notes.
 BUFFER = datetime.timedelta(minutes=10)
+# Grid on which free start times are offered.
+STEP = datetime.timedelta(minutes=15)
 
 
 class Schedule:
@@ -23,18 +25,40 @@ class Schedule:
             raise OutsideOpeningHours(
                 f"The practice is closed for that appointment ({appointment.start:%H:%M} to {appointment.end:%H:%M})."
             )
-        for other in self.appointments:
-            if other.cancelled or other.therapist != appointment.therapist:
-                continue
-            if other.start < appointment.end + BUFFER and appointment.start < other.end + BUFFER:
-                raise SlotTaken(
-                    f"{appointment.therapist.capitalize()} already has an appointment from "
-                    f"{other.start:%H:%M} to {other.end:%H:%M}. "
-                    f"Appointments need {BUFFER.seconds // 60} minutes between them."
-                )
+        other = self._clash(appointment.therapist, appointment.start, appointment.end)
+        if other is not None:
+            raise SlotTaken(
+                f"{appointment.therapist.capitalize()} already has an appointment from "
+                f"{other.start:%H:%M} to {other.end:%H:%M}. "
+                f"Appointments need {BUFFER.seconds // 60} minutes between them."
+            )
         self.appointments.append(appointment)
         return appointment
 
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (every 15 minutes from opening) where a `minutes`-long appointment for `therapist` would fit."""
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += STEP
+        return slots
+
+    def _clash(self, therapist, start, end):
+        """The active appointment of `therapist` that leaves no buffer for [start, end), or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + BUFFER and start < other.end + BUFFER:
+                return other
+        return None
+
     def cancel(self, appointment_id):
         """Marks an appointment as cancelled. It stays on record, but no longer blocks its slot."""
         appointment = self.get(appointment_id)
