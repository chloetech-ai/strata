     def book(self, appointment):
         """Adds `appointment` if the practice is open and the therapist is free."""
+        self._check(appointment)
+        self.appointments.append(appointment)
+        return appointment
+
+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to start at `new_start`, keeping its id and treatment.
+
+        The same rules as `book()` apply, and the appointment does not conflict with itself.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("That appointment was cancelled, so it cannot be moved. Book a new appointment instead.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check(moved, moving_id=appointment_id)
+        appointment.start = new_start
+        return appointment
+
+    def _check(self, appointment, moving_id=None):
+        """Raises a BookingError if `appointment` cannot go in the schedule.
+
+        `moving_id` is the id of an existing appointment being moved, which is ignored in the overlap check.
+        """
         if appointment.treatment not in TREATMENTS:
             options = ", ".join(sorted(TREATMENTS))
             raise BookingError(f"There is no treatment called '{appointment.treatment}'. Choose one of: {options}.")
