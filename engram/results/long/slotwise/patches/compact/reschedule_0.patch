+    def test_reschedule_moves_appointment_and_keeps_id(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11))
+        self.assertIs(moved, a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 11))
+        self.assertEqual(a.treatment, "standard")
+        self.assertEqual(len(s.appointments), 1)
