+"""Text output for reception's printers."""
+
+import textwrap
+
+# The receipt printer prints 42 characters a line and wraps anything longer into a mess.
+LINE_WIDTH = 42
+
+
+def day_plan(schedule, therapist, day):
+    """The day plan for `therapist` on `day` as text, at most 42 characters a line.
+
+    Cancelled appointments are left out. Long names wrap onto the next line, indented.
+    """
+    lines = [f"{therapist.capitalize()}, {day:%d.%m.%Y}", ""]
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for appointment in appointments:
+        time = f"{appointment.start:%H:%M}-{appointment.end:%H:%M}"
+        lines += textwrap.wrap(f"{time} {appointment.client}", LINE_WIDTH, subsequent_indent="      ")
+        lines += textwrap.wrap(f"{appointment.treatment}, {appointment.minutes} min", LINE_WIDTH, initial_indent="      ", subsequent_indent="      ")
+    return "\n".join(lines)
diff --git a/tests/test_printing.py b/tests/test_printing.py
