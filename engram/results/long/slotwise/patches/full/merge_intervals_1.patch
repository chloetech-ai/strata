+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_touching_and_nested_are_merged(self):
+        self.assertEqual(merge_intervals([(5, 8), (1, 3), (3, 4), (2, 6), (10, 11)]), [(1, 8), (10, 11)])
+
+    def test_unsorted_input_gives_sorted_output(self):
+        self.assertEqual(merge_intervals([(9, 10), (1, 2)]), [(1, 2), (9, 10)])
+
+    def test_empty_input(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_works_with_datetimes(self):
+        intervals = [
+            (DT(2026, 9, 8, 9, 0), DT(2026, 9, 8, 9, 45)),
+            (DT(2026, 9, 8, 9, 30), DT(2026, 9, 8, 10, 0)),
+            (DT(2026, 9, 8, 11, 0), DT(2026, 9, 8, 11, 45)),
+        ]
+        self.assertEqual(
+            merge_intervals(intervals),
+            [(DT(2026, 9, 8, 9, 0), DT(2026, 9, 8, 10, 0)), (DT(2026, 9, 8, 11, 0), DT(2026, 9, 8, 11, 45))],
+        )
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 8), (1, 3)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 8), (1, 3)])
+
+
+if __name__ == "__main__":
+    unittest.main()
