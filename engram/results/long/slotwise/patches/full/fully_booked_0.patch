+    def test_fully_booked_at_daily_cap(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # seven appointments, 45 minutes each with the gap between them
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
+    def test_six_appointments_is_not_fully_booked(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        s = Schedule()
+        for hour in range(8, 15):
+            a = s.book(at(hour, client=f"Client {hour}"))
+            if hour == 14:
+                s.cancel(a.id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
     def test_week_rejects_non_monday(self):
