+    def reschedule(self, appointment_id, new_start):
+        """Moves an active appointment to `new_start`, with the same checks as booking.
+
+        The appointment is left unchanged if the new time is refused.
+        """
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError(f"{appointment.client}'s appointment was cancelled, so it can't be moved.")
+        self._check_free(appointment, new_start, ignore=appointment)
+        appointment.start = new_start
+        return appointment
+
