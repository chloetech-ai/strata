+"""Helpers for (start, end) intervals."""
+
+
+def merge_intervals(intervals):
+    """Merges intervals that overlap or touch. Returns new (start, end) tuples sorted by start.
+
+    Works with ints or datetimes. `intervals` is not modified.
+    """
+    merged = []
+    for start, end in sorted(intervals, key=lambda interval: interval[0]):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
