+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+DT = datetime.datetime
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_touching_and_nested_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 6), (7, 8), (7, 7)]), [(1, 6), (7, 8)])
+
+    def test_sorted_by_start_whatever_the_input_order(self):
+        self.assertEqual(merge_intervals([(10, 12), (1, 2), (4, 5)]), [(1, 2), (4, 5), (10, 12)])
+
+    def test_datetimes(self):
+        morning = (DT(2026, 9, 8, 9, 0), DT(2026, 9, 8, 9, 45))
+        overlap = (DT(2026, 9, 8, 9, 30), DT(2026, 9, 8, 10, 15))
+        later = (DT(2026, 9, 8, 11, 0), DT(2026, 9, 8, 12, 0))
+        self.assertEqual(merge_intervals([later, overlap, morning]), [(morning[0], overlap[1]), later])
+
+    def test_empty(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
