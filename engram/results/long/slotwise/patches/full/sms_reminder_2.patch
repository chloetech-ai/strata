+"""Text of the reminder SMS sent before an appointment."""
+
+import unicodedata
+
+from .model import Appointment
+
+RECEPTION_NUMBER = "044 512 77 30"
+# The SMS gateway bills anything longer than this as two messages.
+MAX_LENGTH = 160
+
+_REPLACEMENTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def to_ascii(text):
+    """Plain ASCII for the SMS gateway: umlauts spelled out, accents dropped, anything else removed."""
+    for char, replacement in _REPLACEMENTS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def _message(name, appointment):
+    return (
+        f"Hallo {name}, Erinnerung an Ihren Termin am {appointment.start:%d.%m.} "
+        f"um {appointment.start:%H:%M}. Verschieben: {RECEPTION_NUMBER}"
+    )
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`, at most MAX_LENGTH characters of plain ASCII.
+
+    Uses the full name if it fits, otherwise the first name. Raises ValueError if neither fits.
+    """
+    full = to_ascii(appointment.client)
+    text = _message(full, appointment)
+    if len(text) <= MAX_LENGTH:
+        return text
+    first = full.split()[0] if full.split() else full
+    text = _message(first, appointment)
+    if len(text) <= MAX_LENGTH:
+        return text
+    raise ValueError(f"reminder for {appointment.client!r} is too long even with the first name")
