@@ -0,0 +1,43 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, reminder_text, to_ascii
+
+
+def appt(client, hour=9, minute=0):
+    return Appointment("lena", client, datetime.datetime(2026, 9, 8, hour, minute))
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_text(self):
+        self.assertEqual(
+            reminder_text(appt("Kim Weber")),
+            "Hallo Kim Weber, Erinnerung an Ihren Termin am 08.09. um 09:00. Verschieben: 044 512 77 30",
+        )
+
+    def test_umlauts_and_accents_become_ascii(self):
+        text = reminder_text(appt("Zoë Brändli"))
+        self.assertEqual(text.encode("ascii").decode("ascii"), text)
+        self.assertIn("Hallo Zoe Braendli,", text)
+
+    def test_reception_number_always_included(self):
+        self.assertIn("044 512 77 30", reminder_text(appt("Kim Weber")))
+
+    def test_long_name_falls_back_to_first_name(self):
+        text = reminder_text(appt("Maximilian " + "Ueberlangername " * 6 + "Schmidt-Vonderau"))
+        self.assertLessEqual(len(text), MAX_LENGTH)
+        self.assertTrue(text.startswith("Hallo Maximilian,"))
+        self.assertIn("044 512 77 30", text)
+
+    def test_hopeless_length_is_refused(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appt("X" * 200))
+
+    def test_to_ascii(self):
+        self.assertEqual(to_ascii("Grüße Ölfeld Straße"), "Gruesse Oelfeld Strasse")
+        self.assertEqual(to_ascii("José"), "Jose")
+
+
+if __name__ == "__main__":
+    unittest.main()
