diff --git a/tests/test_schedule.py b/tests/test_schedule.py
index a1dae1e..e55c0fe 100644
--- a/tests/test_schedule.py
+++ b/tests/test_schedule.py
@@ -89,6 +89,27 @@ class ScheduleTest(unittest.TestCase):
         with self.assertRaises(KeyError):
             Schedule().cancel(12345)
 
+    def test_fully_booked_at_daily_cap(self):
+        s = Schedule()
+        # seven 45-minute treatments from 07:30 with 10-minute gaps fit between 07:30 and 17:00 on a Tuesday
+        starts = [datetime.datetime(2026, 9, 8, 7, 30) + datetime.timedelta(minutes=55 * i) for i in range(7)]
+        for i, start in enumerate(starts[:6]):
+            s.book(Appointment("lena", f"Client {i}", start))
+        day = datetime.date(2026, 9, 8)
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(Appointment("lena", "Client 6", starts[6]))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
+    def test_cancelled_appointment_frees_a_place(self):
+        s = Schedule()
+        starts = [datetime.datetime(2026, 9, 8, 7, 30) + datetime.timedelta(minutes=55 * i) for i in range(7)]
+        booked = [s.book(Appointment("lena", f"Client {i}", start)) for i, start in enumerate(starts)]
+        day = datetime.date(2026, 9, 8)
+        self.assertTrue(s.is_fully_booked("lena", day))
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", day))
+
     def test_other_therapist_is_free(self):
         s = Schedule()
         s.book(at(9))
