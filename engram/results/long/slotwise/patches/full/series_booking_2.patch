@@ -0,0 +1,72 @@
+import datetime
+import unittest
+
+from slotwise.errors import BookingError, SeriesNotFree, SeriesTooLong, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+TUESDAY = datetime.datetime(2026, 9, 8, 9, 0)
+
+
+def appt(start=TUESDAY, therapist="lena", client="Kim Weber", treatment="standard"):
+    return Appointment(therapist, client, start, treatment)
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_on_same_weekday_and_time(self):
+        s = Schedule()
+        booked = book_series(s, appt(), 3)
+        self.assertEqual([a.start for a in booked], [
+            TUESDAY,
+            TUESDAY + datetime.timedelta(weeks=1),
+            TUESDAY + datetime.timedelta(weeks=2),
+        ])
+        self.assertEqual(s.appointments, booked)
+        self.assertTrue(all(a.therapist == "lena" and a.client == "Kim Weber" for a in booked))
+
+    def test_taken_week_is_skipped_and_a_later_week_added(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", TUESDAY + datetime.timedelta(weeks=1)))
+        booked = book_series(s, appt(), 3)
+        self.assertEqual([a.start for a in booked], [
+            TUESDAY,
+            TUESDAY + datetime.timedelta(weeks=2),
+            TUESDAY + datetime.timedelta(weeks=3),
+        ])
+
+    def test_closed_week_is_skipped(self):
+        s = Schedule()
+        saturday = datetime.datetime(2026, 9, 5, 9, 0)  # Saturday, open 08:00-12:00
+        booked = book_series(s, appt(saturday), 2)
+        self.assertEqual([a.start.date() for a in booked], [datetime.date(2026, 9, 5), datetime.date(2026, 9, 12)])
+
+    def test_nine_sessions_is_allowed(self):
+        self.assertEqual(len(book_series(Schedule(), appt(), 9)), 9)
+
+    def test_more_than_nine_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, appt(), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_not_enough_free_weeks_books_nothing(self):
+        s = Schedule()
+        blocked = [s.book(appt(TUESDAY + datetime.timedelta(weeks=w), client="Jo Li")) for w in range(1, 5)]
+        with self.assertRaises(SeriesNotFree):
+            book_series(s, appt(), 9)  # only 8 free weeks in the 12-week window
+        self.assertEqual(s.appointments, blocked)
+
+    def test_unknown_treatment_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(BookingError):
+            book_series(s, appt(treatment="nope"), 3)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_is_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), appt(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
