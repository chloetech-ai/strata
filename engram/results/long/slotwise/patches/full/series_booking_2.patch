@@ -0,0 +1,45 @@
+"""Booking a series of weekly sessions, as a doctor's prescription asks for."""
+
+import datetime
+
+from .errors import OutsideOpeningHours, SeriesNotFree, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+MAX_SESSIONS = 9  # insurance pays for 9 sessions per prescription
+MAX_WEEKS = 12  # a series may run this far ahead, counting skipped weeks
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions starting with `first`, returning them in order.
+
+    `first` gives the therapist, client, treatment and first start time. A week that is
+    already taken or closed is skipped and a later week is used instead. Either all
+    sessions are booked or none are.
+    """
+    if count < 1:
+        raise ValueError("a series needs at least one session")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(
+            f"A series can have at most {MAX_SESSIONS} sessions, so {count} can't be booked. "
+            f"Please book {MAX_SESSIONS} or fewer."
+        )
+    booked = []
+    try:
+        for week in range(MAX_WEEKS):
+            if len(booked) == count:
+                break
+            start = first.start + datetime.timedelta(weeks=week)
+            try:
+                booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+            except (SlotTaken, OutsideOpeningHours):
+                continue
+        if len(booked) < count:
+            raise SeriesNotFree(
+                f"Only {len(booked)} of the {count} sessions fit within {MAX_WEEKS} weeks of "
+                f"{first.start:%d.%m.%Y}, so no sessions were booked. Please choose another start date."
+            )
+    except Exception:
+        booked_ids = {a.id for a in booked}
+        schedule.appointments = [a for a in schedule.appointments if a.id not in booked_ids]
+        raise
+    return booked
