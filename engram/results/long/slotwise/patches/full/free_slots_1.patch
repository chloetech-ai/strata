+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (every 15 minutes from opening) where a `minutes`-long appointment fits."""
+        if minutes <= 0:
+            raise ValueError("minutes must be positive")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._blocking(therapist, start, start + length) is None:
+                slots.append(start)
+            start += STEP
+        return slots
+
+    def _blocking(self, therapist, start, end):
+        """An active appointment of `therapist` that leaves no gap for [start, end), or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if start < other.end + GAP and other.start < end + GAP:
+                return other
+        return None
+
     @staticmethod
     def _closed_message(appointment):
         day = _day(appointment.start)
