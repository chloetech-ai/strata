         with self.assertRaises(ValueError):
             Schedule().week("lena", datetime.date(2026, 9, 8))
 
+    def test_free_slots_on_empty_day_start_at_opening(self):
+        monday = datetime.date(2026, 9, 7)
+        slots = Schedule().free_slots("lena", monday, 45)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 7, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 7, 18, 15))  # ends at 19:00
+        self.assertEqual(len(slots), (690 - 45) // 15 + 1)  # 11.5 open hours, 45-minute grid
+
+    def test_free_slots_respect_booking_and_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so nothing may start 08:35 to 09:55
+        starts = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), starts)  # would end 09:15
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), starts)  # ends 09:00, no gap before it
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), starts)  # ends 08:45, 15 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 15), starts)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), starts)  # 10 minutes after 09:45
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        s.book(at(12, therapist="marco", client="Jo Li"))
+        starts = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), starts)
+        self.assertIn(datetime.datetime(2026, 9, 8, 12, 0), starts)
+
+    def test_free_slots_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])
+
+    def test_free_slots_rejects_zero_length(self):
+        with self.assertRaises(ValueError):
+            Schedule().free_slots("lena", datetime.date(2026, 9, 8), 0)
+
