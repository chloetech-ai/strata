+"""Reading treatment lengths typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+
+def parse_duration(text):
+    """Minutes for a duration like '45', '45 min', '1h', '1h 30m' or '1:30'.
+
+    Raises ValueError for empty input, zero, or anything else.
+    """
+    s = text.strip().lower()
+    if not s:
+        raise ValueError("empty duration")
+    minutes = _parse(s)
+    if minutes is None or minutes == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
+
+
+def _parse(s):
+    m = re.fullmatch(r"(\d+)\s*(?:m|min)?", s)
+    if m:
+        return int(m[1])
+    m = re.fullmatch(r"(\d+)\s*h\s*(?:(\d{1,2})\s*(?:m|min)?)?", s)
+    if m:
+        return _minutes(int(m[1]) * 60 + int(m[2] or 0), m[2])
+    m = re.fullmatch(r"(\d+):(\d{2})", s)
+    if m:
+        return _minutes(int(m[1]) * 60 + int(m[2]), m[2])
+    return None
+
+
+def _minutes(total, minute_part):
+    """Rejects a minute part of 60 or more, e.g. '1h90'."""
+    if minute_part is not None and int(minute_part) >= 60:
+        return None
+    return total
