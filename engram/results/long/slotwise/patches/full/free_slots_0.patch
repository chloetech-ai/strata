+    def test_free_slots_on_empty_day_run_to_closing(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tuesday, open 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))
+        self.assertEqual(len(slots), 43)  # 07:30 to 18:00 in 15-minute steps
+        self.assertTrue(all((t.minute % 15) == 0 for t in slots))
+
+    def test_free_slots_respect_booking_gap_and_existing(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, blocks 08:50-09:55 for a new booking
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        hours = [(t.hour, t.minute) for t in slots if t.hour in (8, 9, 10)]
+        self.assertEqual(hours, [(8, 0), (10, 0), (10, 15), (10, 30), (10, 45)])
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        s.book(at(10, therapist="marco", client="Jo Li"))
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+
+    def test_free_slots_closed_day_is_empty(self):
+        self.assertEqual(Schedule().free_slots("lena", datetime.date(2026, 9, 13), 45), [])
+
