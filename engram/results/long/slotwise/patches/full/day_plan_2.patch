@@ -0,0 +1,43 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.printing import WIDTH, day_plan
+from slotwise.schedule import Schedule
+
+MONDAY = datetime.date(2026, 9, 7)
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_active_appointments_in_order(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 14, 0), "standard"))
+        s.book(Appointment("lena", "Zoë Brändli", datetime.datetime(2026, 9, 7, 8, 0), "initial"))
+        text = day_plan(s, "lena", MONDAY)
+        self.assertEqual(
+            text,
+            "Lena - Mon 07.09.2026\n"
+            "------------------------------------------\n"
+            "08:00-09:00  initial\n"
+            "      Zoe Braendli\n"
+            "14:00-14:45  standard\n"
+            "      Kim Weber\n",
+        )
+
+    def test_cancelled_appointments_are_left_out(self):
+        s = Schedule()
+        a = s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 7, 9, 0)))
+        s.cancel(a.id)
+        self.assertIn("No appointments.", day_plan(s, "lena", MONDAY))
+
+    def test_no_line_is_wider_than_the_printer(self):
+        s = Schedule()
+        long_name = "Maria-Theresia von Hohenstaufen-Liechtenstein-Wassermann Gonzalez"
+        s.book(Appointment("lena", long_name, datetime.datetime(2026, 9, 7, 9, 0), "initial"))
+        lines = day_plan(s, "lena", MONDAY).splitlines()
+        self.assertTrue(all(len(line) <= WIDTH for line in lines), lines)
+        self.assertIn("Gonzalez", " ".join(lines))
+
+
+if __name__ == "__main__":
+    unittest.main()
