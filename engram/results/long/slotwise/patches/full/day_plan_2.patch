+"""Printable day plans for the receipt printer, which fits 42 characters a line."""
+
+import textwrap
+import unicodedata
+
+WIDTH = 42
+
+_UMLAUTS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def _ascii(text):
+    """The printer has no umlauts, so they are spelled out; other accents lose their accent."""
+    for char, replacement in _UMLAUTS.items():
+        text = text.replace(char, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    return decomposed.encode("ascii", "ignore").decode("ascii")
+
+
+def _wrap(text, indent=""):
+    return textwrap.wrap(_ascii(text), WIDTH, initial_indent=indent, subsequent_indent=" " * len(indent))
+
+
+def day_plan(schedule, therapist, day):
+    """The day's active appointments for `therapist` as printable text, one entry per appointment."""
+    lines = _wrap(f"{therapist.capitalize()} - {day:%a %d.%m.%Y}")
+    lines.append("-" * WIDTH)
+    appointments = [a for a in schedule.appointments_for(therapist, day) if not a.cancelled]
+    if not appointments:
+        lines.append("No appointments.")
+    for a in appointments:
+        time_range = f"{a.start:%H:%M}-{a.end:%H:%M}"
+        lines += _wrap(f"{time_range}  {a.treatment}")
+        lines += _wrap(a.client, indent="      ")
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_printing.py b/tests/test_printing.py
