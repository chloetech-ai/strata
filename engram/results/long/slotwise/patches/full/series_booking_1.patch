@@ -0,0 +1,59 @@
+import datetime
+import unittest
+
+from slotwise.errors import SeriesIncomplete, SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import MAX_SESSIONS, book_series
+
+
+def at(day, hour=9, therapist="lena", client="Kim Weber"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, day, hour, 0))
+
+
+class SeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions(self):
+        s = Schedule()
+        booked = book_series(s, at(8), 3)  # Tuesdays 8, 15, 22 September
+        self.assertEqual([a.start.day for a in booked], [8, 15, 22])
+        self.assertEqual({a.start.hour for a in booked}, {9})
+        self.assertEqual(len(s.appointments), 3)
+
+    def test_skips_taken_week_and_continues_after(self):
+        s = Schedule()
+        s.book(at(15, client="Jo Li"))
+        booked = book_series(s, at(8), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_other_therapist_does_not_block(self):
+        s = Schedule()
+        s.book(at(15, therapist="marco", client="Jo Li"))
+        booked = book_series(s, at(8), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 15, 22])
+
+    def test_too_many_sessions_is_refused_and_nothing_booked(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, at(8), MAX_SESSIONS + 1)
+        self.assertEqual(s.appointments, [])
+
+    def test_nine_sessions_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, at(8), MAX_SESSIONS)), MAX_SESSIONS)
+
+    def test_incomplete_series_books_nothing(self):
+        s = Schedule()
+        for week in range(1, 5):  # 4 of the 12 weeks are taken, leaving 8 free
+            start = datetime.datetime(2026, 9, 8, 9) + datetime.timedelta(weeks=week)
+            s.book(Appointment("lena", "Jo Li", start))
+        with self.assertRaises(SeriesIncomplete):
+            book_series(s, at(8), MAX_SESSIONS)
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_zero_sessions_is_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), at(8), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
