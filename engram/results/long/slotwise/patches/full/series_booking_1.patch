+"""Weekly series of sessions, as prescribed by a doctor."""
+
+import datetime
+
+from .errors import BookingError, OutsideOpeningHours, SeriesIncomplete, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+MAX_SESSIONS = 9  # insurance pays for 9 sessions per prescription
+SEARCH_WEEKS = 12  # how far ahead a series may run
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions starting with `first`, returning the booked appointments.
+
+    A week that is already taken is skipped and the series continues in the next free week.
+    If the whole series cannot be booked within SEARCH_WEEKS, nothing is booked.
+    """
+    if count < 1:
+        raise ValueError("a series needs at least one session")
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(f"A series can have at most {MAX_SESSIONS} sessions. Please book {MAX_SESSIONS} or fewer.")
+    booked = []
+    try:
+        for week in range(SEARCH_WEEKS):
+            if len(booked) == count:
+                break
+            start = first.start + datetime.timedelta(weeks=week)
+            appointment = Appointment(first.therapist, first.client, start, first.treatment)
+            try:
+                booked.append(schedule.book(appointment))
+            except (SlotTaken, OutsideOpeningHours):
+                continue
+        if len(booked) < count:
+            raise SeriesIncomplete(
+                f"Only {len(booked)} of the {count} sessions fit within {SEARCH_WEEKS} weeks, "
+                "so nothing was booked. Please choose another start time."
+            )
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
