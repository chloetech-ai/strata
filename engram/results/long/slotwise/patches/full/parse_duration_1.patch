@@ -0,0 +1,35 @@
+"""Treatment lengths typed by reception, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_MINUTES = re.compile(r"(\d+)\s*(?:m|min)?")
+_HOURS = re.compile(r"(\d+)\s*h(?:\s*(\d+)\s*(?:m|min)?)?")
+_CLOCK = re.compile(r"(\d+):(\d+)")
+
+
+def parse_duration(text):
+    """Minutes for a duration written as '45', '45m', '1h', '1h30', '1h 30m' or '1:30'.
+
+    Raises ValueError for anything else, or for a zero duration.
+    """
+    s = text.strip().lower()
+    minutes = None
+    if m := _MINUTES.fullmatch(s):
+        minutes = int(m.group(1))
+    elif m := _HOURS.fullmatch(s):
+        minutes = int(m.group(1)) * 60 + _checked_minutes(m.group(2))
+    elif m := _CLOCK.fullmatch(s):
+        minutes = int(m.group(1)) * 60 + _checked_minutes(m.group(2))
+    if minutes is None or minutes == 0:
+        raise ValueError(f"not a duration: {text!r}")
+    return minutes
+
+
+def _checked_minutes(digits):
+    """Minutes after an hour part; None means none was given. Must be under 60."""
+    if digits is None:
+        return 0
+    value = int(digits)
+    if value >= 60:
+        raise ValueError(f"minutes must be under 60: {digits!r}")
+    return value
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
index 0000000..f2f1789
--- /dev/null
+++ b/tests/test_durations.py
@@ -0,0 +1,34 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H30M  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_rejects_bad_input(self):
+        for text in ["", "   ", "0", "0h", "abc", "-5", "1h60", "1:75", "1.5h", "1h-30"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
