@@ -0,0 +1,38 @@
+"""Weekly series of sessions, as prescribed by a doctor."""
+
+import datetime
+
+from .errors import BookingError, NotEnoughFreeWeeks, SeriesTooLong
+from .model import Appointment
+
+MAX_SESSIONS = 9  # the insurer pays for no more per prescription
+SEARCH_WEEKS = 12  # how far ahead a series may run to find free weeks
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions like `first`, starting with `first`'s week.
+
+    A week that is already taken is skipped and the series continues in a later week.
+    Either all `count` sessions are booked or none are, and the booked appointments are returned.
+    """
+    if count > MAX_SESSIONS:
+        raise SeriesTooLong(f"A series can have at most {MAX_SESSIONS} sessions, not {count}.")
+    booked = []
+    for week in range(SEARCH_WEEKS):
+        if len(booked) == count:
+            break
+        candidate = Appointment(
+            first.therapist, first.client, first.start + datetime.timedelta(weeks=week), first.treatment
+        )
+        try:
+            booked.append(schedule.book(candidate))
+        except BookingError:
+            continue
+    if len(booked) < count:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise NotEnoughFreeWeeks(
+            f"Only {len(booked)} of {count} sessions fit within {SEARCH_WEEKS} weeks, so none were booked. "
+            "Please choose another start date."
+        )
+    return booked
diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
