--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,62 @@
+import datetime
+import unittest
+
+from slotwise.errors import NotEnoughFreeWeeks, SeriesTooLong
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+MONDAY = datetime.datetime(2026, 9, 7, 9, 0)  # Monday 7 September 2026, 09:00
+
+
+def first(therapist="lena", client="Kim Weber", start=MONDAY):
+    return Appointment(therapist, client, start, "standard")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_consecutive_weeks_at_same_time(self):
+        s = Schedule()
+        booked = book_series(s, first(), 4)
+        self.assertEqual([a.start for a in booked], [MONDAY + datetime.timedelta(weeks=i) for i in range(4)])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_nine_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first(), 9)), 9)
+
+    def test_more_than_nine_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, first(), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_taken_week_is_skipped_and_series_continues_later(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", MONDAY + datetime.timedelta(weeks=1), "standard"))
+        booked = book_series(s, first(), 3)
+        self.assertEqual([a.start for a in booked], [
+            MONDAY,
+            MONDAY + datetime.timedelta(weeks=2),
+            MONDAY + datetime.timedelta(weeks=3),
+        ])
+
+    def test_too_few_free_weeks_books_nothing(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", MONDAY, "standard"))
+        before = list(s.appointments)
+        # within the 12-week window only week 5 is free, which is one short of the 2 needed
+        for week in range(1, 12):
+            if week != 5:
+                s.book(Appointment("lena", "Jo Li", MONDAY + datetime.timedelta(weeks=week), "standard"))
+        with self.assertRaises(NotEnoughFreeWeeks):
+            book_series(s, first(), 2)
+        self.assertEqual(len(s.appointments), len(before) + 10)
+
+    def test_other_therapist_does_not_block_series(self):
+        s = Schedule()
+        s.book(Appointment("marco", "Jo Li", MONDAY, "standard"))
+        self.assertEqual(len(book_series(s, first(), 2)), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
