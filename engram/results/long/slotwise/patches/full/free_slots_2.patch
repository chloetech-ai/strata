+    def _clash(self, therapist, start, end):
+        """An active appointment of `therapist` that leaves no gap for `start`-`end`, or None."""
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if start < other.end + GAP and other.start < end + GAP:
+                return other
+        return None
+
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` where an appointment of `minutes` could be booked for `therapist`.
+
+        Times are on a 15-minute grid from opening time, and a slot must end before closing.
+        Uses the same rules as book(), so every slot returned would be accepted.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            if self._clash(therapist, start, start + length) is None:
+                slots.append(start)
+            start += SLOT
+        return slots
+
     @staticmethod
     def _closed_message(appointment):
         day = _day(appointment.start)
