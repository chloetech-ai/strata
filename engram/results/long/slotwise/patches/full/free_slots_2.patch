+    def test_free_slots_on_empty_day_run_from_opening_to_closing(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 60)  # Tuesday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 0))  # 60 min ends at closing
+        self.assertEqual(len(slots), (18 * 60 - 7 * 60 - 30) // 15 + 1)
+
+    def test_free_slots_respect_booking_and_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45; a 45-minute start must end by 08:50 to leave the gap
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 30), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_agree_with_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(13, 30, client="Jo Li"))
+        day = datetime.date(2026, 9, 8)
+        for start in s.free_slots("lena", day, 45):
+            probe = Appointment("lena", "Probe", start, "standard")
+            s.book(probe)  # must not raise
+            s.cancel(probe.id)
+
