         with self.assertRaises(KeyError):
             Schedule().cancel(12345)
 
+    def test_fully_booked_at_daily_cap(self):
+        s = Schedule()
+        for hour in range(8, 15):  # seven appointments, 08:00 to 14:00 starts
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("marco", datetime.date(2026, 9, 8)))
+
+    def test_six_appointments_is_not_fully_booked(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour, client=f"Client {hour}"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointment_frees_a_place(self):
+        s = Schedule()
+        booked = [s.book(at(hour, client=f"Client {hour}")) for hour in range(8, 15)]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
