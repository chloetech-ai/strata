+"""Text of the SMS reminder sent before an appointment."""
+
+import unicodedata
+
+RECEPTION_NUMBER = "044 512 77 30"
+MAX_LENGTH = 160
+
+# Letters that don't decompose to ASCII under NFKD.
+_SPECIAL = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def to_ascii(text):
+    """Plain ASCII for the SMS gateway: 'Brändli' -> 'Braendli'."""
+    parts = []
+    for ch in text:
+        if ch in _SPECIAL:
+            parts.append(_SPECIAL[ch])
+            continue
+        decomposed = unicodedata.normalize("NFKD", ch)
+        parts.append("".join(c for c in decomposed if ord(c) < 128))
+    return "".join(parts)
+
+
+def reminder_text(appointment):
+    """The reminder SMS for `appointment`, plain ASCII, at most 160 characters.
+
+    If the client's name makes the message too long, the greeting is dropped.
+    """
+    when = f"{appointment.start:%d.%m.%Y} at {appointment.start:%H:%M}"
+    ending = f"To move it, call {RECEPTION_NUMBER}."
+    with_name = to_ascii(
+        f"Hi {appointment.client}, reminder of your physio appointment with "
+        f"{appointment.therapist} on {when}. {ending}"
+    )
+    if len(with_name) <= MAX_LENGTH:
+        return with_name
+    text = to_ascii(
+        f"Reminder of your physio appointment with {appointment.therapist} on {when}. {ending}"
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
new file mode 100644
index 0000000..afab91b
--- /dev/null
+++ b/tests/test_reminders.py
@@ -0,0 +1,46 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_NUMBER, reminder_text, to_ascii
+
+
+def appt(client="Kim Weber", therapist="lena"):
+    return Appointment(therapist, client, datetime.datetime(2026, 9, 8, 9, 0))
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_and_accents(self):
+        self.assertEqual(to_ascii("Zoë Brändli"), "Zoe Braendli")
+        self.assertEqual(to_ascii("Ölfeld Ümit Straße"), "Oelfeld Uemit Strasse")
+        self.assertEqual(to_ascii("José Müller"), "Jose Mueller")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_contains_details_and_reception_number(self):
+        text = reminder_text(appt("Zoë Brändli"))
+        self.assertEqual(
+            text,
+            "Hi Zoe Braendli, reminder of your physio appointment with lena on 08.09.2026 at 09:00. "
+            "To move it, call 044 512 77 30.",
+        )
+        self.assertIn(RECEPTION_NUMBER, text)
+
+    def test_plain_ascii_and_within_limit(self):
+        text = reminder_text(appt("Zoë Brändli"))
+        self.assertTrue(text.isascii())
+        self.assertLessEqual(len(text), MAX_LENGTH)
+
+    def test_long_name_drops_greeting(self):
+        text = reminder_text(appt("Maximilian-Alexander von Wartenberg-Schönfeld zu Oberhausen-Neudorf"))
+        self.assertTrue(text.startswith("Reminder of your physio appointment"))
+        self.assertIn(RECEPTION_NUMBER, text)
+        self.assertLessEqual(len(text), MAX_LENGTH)
+
+    def test_too_long_even_without_greeting_is_refused(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appt(therapist="x" * 150))
+
+
+if __name__ == "__main__":
+    unittest.main()
