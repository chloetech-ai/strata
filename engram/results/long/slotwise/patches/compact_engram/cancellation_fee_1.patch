+"""Cancellation fees: how much a client pays for cancelling an appointment."""
+
+import datetime
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """The fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before the start: the full price.
+    Less than 48 hours before the start: half the price.
+    Otherwise: nothing. Exactly 48 hours before is free; exactly 24 hours is half.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < datetime.timedelta(hours=24):
+        return appointment.price
+    if notice < datetime.timedelta(hours=48):
+        return appointment.price // 2
+    return 0
