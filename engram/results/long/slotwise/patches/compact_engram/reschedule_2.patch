+    def test_reschedule_moves_the_appointment_and_keeps_its_length(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 15, 0))
+        self.assertIs(s.get(a.id), a)
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 15, 0))
+        self.assertEqual(a.end, datetime.datetime(2026, 9, 8, 15, 45))
+
+    def test_reschedule_to_a_slot_just_vacated_by_itself_is_allowed(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00 to 09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 5))
+        self.assertEqual(a.start.time(), datetime.time(9, 5))
+
+    def test_reschedule_into_a_taken_slot_is_refused_and_leaves_it_where_it_was(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "Lena already has Jo Li from 14:00 to 14:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 20))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_respects_the_gap(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))  # 14:00 to 14:45
+        with self.assertRaisesRegex(SlotTaken, "needs 10 minutes between appointments"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 13, 10))  # ends 13:55, 5 minutes before
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_respects_opening_hours(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start, datetime.datetime(2026, 9, 8, 9, 0))
+
+    def test_reschedule_a_cancelled_appointment_is_refused(self):
