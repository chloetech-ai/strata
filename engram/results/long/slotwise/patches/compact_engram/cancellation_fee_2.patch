+"""Cancellation fees: free with 48 hours' notice, half price under 48 hours, full price under 24 hours."""
+
+import datetime
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """The fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours' notice pays the full price, less than 48 hours pays half,
+    and exactly 48 hours or more pays nothing.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < datetime.timedelta(hours=24):
+        return appointment.price
+    if notice < datetime.timedelta(hours=48):
+        return appointment.price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
