+++ b/tests/test_fees.py
@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import Appointment
+
+START = datetime.datetime(2026, 10, 20, 10, 0)
+
+
+def at(hours_before):
+    return START - datetime.timedelta(hours=hours_before)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def test_more_than_48_hours_notice_is_free(self):
+        appt = Appointment("Anna", "Jo Li", START, "standard")
+        self.assertEqual(cancellation_fee(appt, at(72)), 0)
+        self.assertEqual(cancellation_fee(appt, at(48.5)), 0)
+
+    def test_exactly_48_hours_notice_is_free(self):
+        appt = Appointment("Anna", "Jo Li", START, "standard")
+        self.assertEqual(cancellation_fee(appt, at(48)), 0)
+
+    def test_under_48_hours_pays_half(self):
+        appt = Appointment("Anna", "Jo Li", START, "standard")
+        self.assertEqual(cancellation_fee(appt, at(47)), 4900)
+        self.assertEqual(cancellation_fee(appt, at(24.5)), 4900)
+
+    def test_exactly_24_hours_pays_half(self):
+        appt = Appointment("Anna", "Jo Li", START, "initial")
+        self.assertEqual(cancellation_fee(appt, at(24)), 7250)
+
+    def test_under_24_hours_pays_full_price(self):
+        appt = Appointment("Anna", "Jo Li", START, "short")
+        self.assertEqual(cancellation_fee(appt, at(23)), 6800)
+        self.assertEqual(cancellation_fee(appt, at(0)), 6800)
+
+    def test_cancelling_after_the_start_pays_full_price(self):
+        appt = Appointment("Anna", "Jo Li", START, "standard")
+        self.assertEqual(cancellation_fee(appt, at(-1)), 9800)
+
+    def test_fee_uses_the_treatment_price(self):
+        for treatment, (_, price) in [("initial", (60, 14500)), ("standard", (45, 9800)), ("short", (30, 6800))]:
+            appt = Appointment("Anna", "Jo Li", START, treatment)
+            self.assertEqual(cancellation_fee(appt, at(1)), price)
+
+
+if __name__ == "__main__":
+    unittest.main()
