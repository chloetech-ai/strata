+from .hours import is_open_between, opening_hours
 from .model import TREATMENTS
 
 # Time a therapist needs between two appointments to clean up and write notes.
 GAP = datetime.timedelta(minutes=10)
+# Grid on which free start times are offered.
+SLOT_STEP = datetime.timedelta(minutes=15)
 
 
 class Schedule:
@@ -63,3 +65,26 @@ class Schedule:
         """`therapist`'s active appointments for the seven days from `monday`, keyed by date."""
         days = [monday + datetime.timedelta(days=i) for i in range(7)]
         return {day: self.appointments_for(therapist, day) for day in days}
+
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` where a `minutes`-long appointment for `therapist` would fit.
+
+        Starts run every 15 minutes from opening time, and keep the 10-minute gap from
+        the therapist's other appointments. An empty list means the practice is closed
+        or the day is full.
+        """
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        booked = self.appointments_for(therapist, day)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            end = start + length
+            clash = any(other.start < end + GAP and start < other.end + GAP for other in booked)
+            if not clash:
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
