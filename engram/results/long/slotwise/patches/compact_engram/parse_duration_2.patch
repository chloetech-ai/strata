+"""Appointment lengths as reception types them, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_CLOCK = re.compile(r"([0-9]+):([0-9]{1,2})")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:min|m)?)?")
+_MINUTES = re.compile(r"([0-9]+)\s*(?:min|m)?")
+
+
+def parse_duration(text):
+    """Minutes for a length typed as '45', '45 min', '1h', '1h 30m' or '1:30'.
+
+    Case and surrounding spaces are ignored. Raises ValueError for anything else,
+    for minutes of 60 or more after hours, and for a length of zero.
+    """
+    cleaned = text.strip().lower()
+    if match := _CLOCK.fullmatch(cleaned):
+        hours, minutes = int(match[1]), int(match[2])
+    elif match := _HOURS.fullmatch(cleaned):
+        hours, minutes = int(match[1]), int(match[2] or 0)
+    elif match := _MINUTES.fullmatch(cleaned):
+        hours, minutes = 0, int(match[1])
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes >= 60:
+        raise ValueError(f"minutes must be under 60 after hours: {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
new file mode 100644
