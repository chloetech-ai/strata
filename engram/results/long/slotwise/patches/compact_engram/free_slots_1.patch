+    def test_free_slots_on_an_empty_day_run_from_opening_to_last_fit(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)  # Tuesday, 07:30 to 19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))
+        self.assertEqual(len(slots), 44)
+
+    def test_free_slots_keep_the_gap_on_both_sides(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00 to 09:45, so nothing may start from 08:15 to 09:45
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 15 minutes before
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
+
+    def test_free_slots_match_what_book_accepts(self):
+        s = Schedule()
+        s.book(at(9))
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        for start in slots:
+            trial = Schedule()
+            trial.appointments = list(s.appointments)
+            trial.book(Appointment("lena", "Jo Li", start, "standard"))
+
+    def test_free_slots_ignore_cancelled_and_other_therapists(self):
