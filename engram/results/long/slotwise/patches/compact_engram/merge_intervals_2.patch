+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_overlapping_and_touching_intervals_are_joined(self):
+        self.assertEqual(
+            merge_intervals([(5, 8), (1, 3), (3, 4), (7, 10)]),
+            [(1, 4), (5, 10)],
+        )
+
+    def test_one_interval_inside_another_is_absorbed(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_disjoint_intervals_are_kept_sorted(self):
+        self.assertEqual(merge_intervals([(8, 9), (1, 2)]), [(1, 2), (8, 9)])
+
+    def test_works_with_datetimes(self):
+        t = datetime.datetime(2026, 10, 12, 9, 0)
+        m = datetime.timedelta(minutes=30)
+        self.assertEqual(
+            merge_intervals([(t + m, t + 2 * m), (t, t + m)]),
+            [(t, t + 2 * m)],
+        )
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 8), (1, 3), (3, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 8), (1, 3), (3, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
