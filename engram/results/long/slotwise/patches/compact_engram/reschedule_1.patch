diff --git a/tests/test_schedule.py b/tests/test_schedule.py
index 36d41f9..90bcd59 100644
--- a/tests/test_schedule.py
+++ b/tests/test_schedule.py
@@ -140,6 +140,56 @@ class ScheduleTest(unittest.TestCase):
         s.book(at(10, therapist="marco"))
         self.assertEqual([a.start.hour for a in s.appointments_for("lena", datetime.date(2026, 9, 8))], [8, 14])
 
+    def test_reschedule_moves_the_start_and_keeps_the_record(self):
+        s = Schedule()
+        a = s.book(at(9))
+        moved = s.reschedule(a.id, datetime.datetime(2026, 9, 8, 15, 0))
+        self.assertIs(moved, a)
+        self.assertEqual((a.start.hour, a.client, a.treatment, a.therapist), (15, "Kim Weber", "standard", "lena"))
+        self.assertEqual(len(s.appointments), 1)
+
+    def test_reschedule_may_overlap_its_own_old_slot(self):
+        s = Schedule()
+        a = s.book(at(9))  # 09:00 to 09:45
+        s.reschedule(a.id, datetime.datetime(2026, 9, 8, 9, 20))
+        self.assertEqual(a.start.hour * 60 + a.start.minute, 9 * 60 + 20)
+
+    def test_reschedule_into_a_taken_slot_leaves_it_where_it_was(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(14, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "Lena already has Jo Li from 14:00 to 14:45"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 14, 0))
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_respects_the_gap(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.book(at(11, client="Jo Li"))
+        with self.assertRaisesRegex(SlotTaken, "needs 10 minutes between appointments"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 10, 6))  # ends 10:51, 9 minutes before Jo Li
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_outside_opening_hours_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        with self.assertRaises(OutsideOpeningHours):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 18, 30))
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_cancelled_appointment_is_refused(self):
+        s = Schedule()
+        a = s.book(at(9))
+        s.cancel(a.id)
+        with self.assertRaisesRegex(BookingError, "is cancelled, so it cannot be moved"):
+            s.reschedule(a.id, datetime.datetime(2026, 9, 8, 11, 0))
+        self.assertEqual(a.start.hour, 9)
+
+    def test_reschedule_unknown_id_raises_key_error(self):
+        s = Schedule()
+        with self.assertRaises(KeyError):
+            s.reschedule(999999, datetime.datetime(2026, 9, 8, 11, 0))
+
 
 if __name__ == "__main__":
     unittest.main()
