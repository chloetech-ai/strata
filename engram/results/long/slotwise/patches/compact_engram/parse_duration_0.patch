+"""Appointment lengths as reception types them: '45', '1h30', '1:30' and so on."""
+
+import re
+
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*(?:m|min)?)?")
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")
+
+
+def parse_duration(text):
+    """Minutes for a typed length: '45' -> 45, '1h30' -> 90, '1:30' -> 90.
+
+    Case and surrounding spaces are ignored. Raises ValueError for empty input,
+    zero, minutes of 60 or more, and anything else.
+    """
+    cleaned = text.strip().lower()
+    clock = _CLOCK.fullmatch(cleaned)
+    hours = _HOURS.fullmatch(cleaned)
+    minutes = _MINUTES.fullmatch(cleaned)
+    if clock:
+        total = int(clock.group(1)) * 60 + int(clock.group(2))
+    elif hours:
+        total = int(hours.group(1)) * 60 + int(hours.group(2) or 0)
+    elif minutes:
+        total = int(minutes.group(1))
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if clock or hours:
+        minute_part = clock.group(2) if clock else hours.group(2)
+        if minute_part is not None and int(minute_part) >= 60:
+            raise ValueError(f"minutes must be under 60: {text!r}")
+    if total == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return total
