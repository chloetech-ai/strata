+"""Text of the SMS reminders sent before an appointment."""
+
+import unicodedata
+
+RECEPTION_PHONE = "044 512 77 30"
+SMS_LIMIT = 160
+
+# Letters that do not decompose to an ASCII base letter, so they need their own spelling.
+_SPELLINGS = {
+    "ä": "ae", "ö": "oe", "ü": "ue", "ß": "ss",
+    "Ä": "Ae", "Ö": "Oe", "Ü": "Ue",
+}
+
+
+def transliterate(text):
+    """Plain ASCII: 'Brändli' -> 'Braendli'. Raises ValueError for anything else."""
+    spelled = "".join(_SPELLINGS.get(ch, ch) for ch in text)
+    decomposed = unicodedata.normalize("NFKD", spelled)
+    ascii_text = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    if not ascii_text.isascii():
+        bad = sorted({ch for ch in ascii_text if not ch.isascii()})
+        raise ValueError(f"cannot send {bad} in an SMS: {text!r}")
+    return ascii_text
+
+
+def reminder_text(appointment):
+    """The reminder for `appointment`, in plain ASCII, at most SMS_LIMIT characters.
+
+    Raises ValueError if the text would be longer than one SMS, so reception can
+    check it rather than the gateway billing it as two messages.
+    """
+    when = appointment.start.strftime("%a %d %b %H:%M")
+    text = (
+        f"Lindqvist Physio: reminder for {transliterate(appointment.client)} "
+        f"on {when} with {transliterate(appointment.therapist)}. "
+        f"To move it, call {RECEPTION_PHONE}."
+    )
+    if len(text) > SMS_LIMIT:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {SMS_LIMIT}: {text!r}")
+    return text
