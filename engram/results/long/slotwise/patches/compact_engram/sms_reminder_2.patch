@@ -0,0 +1,44 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import RECEPTION_PHONE, SMS_LIMIT, reminder_text, transliterate
+
+
+class TransliterateTest(unittest.TestCase):
+    def test_umlauts_and_sharp_s_are_spelled_out(self):
+        self.assertEqual(transliterate("Brändli"), "Braendli")
+        self.assertEqual(transliterate("Ößi Müller Äbi"), "Oessi Mueller Aebi")
+
+    def test_accents_lose_their_marks(self):
+        self.assertEqual(transliterate("Zoë Séguin"), "Zoe Seguin")
+
+    def test_unknown_characters_are_an_error(self):
+        with self.assertRaises(ValueError):
+            transliterate("Łukasz")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def appointment(self, client="Brändli", therapist="Anna Keller"):
+        return Appointment(therapist, client, datetime.datetime(2026, 10, 19, 14, 0))
+
+    def test_reminder_is_plain_ascii_and_names_the_client_and_time(self):
+        text = reminder_text(self.appointment())
+        self.assertTrue(text.isascii())
+        self.assertIn("Braendli", text)
+        self.assertIn("Mon 19 Oct 14:00", text)
+        self.assertIn("Anna Keller", text)
+
+    def test_reminder_includes_reception_phone(self):
+        self.assertIn(RECEPTION_PHONE, reminder_text(self.appointment()))
+
+    def test_reminder_fits_one_sms(self):
+        self.assertLessEqual(len(reminder_text(self.appointment())), SMS_LIMIT)
+
+    def test_too_long_reminder_is_refused(self):
+        with self.assertRaises(ValueError):
+            reminder_text(self.appointment(client="X" * 150))
+
+
+if __name__ == "__main__":
+    unittest.main()
