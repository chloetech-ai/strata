+    def test_free_slots_on_empty_day_start_at_opening_on_the_grid(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 8, 7, 30))
+        self.assertEqual(slots[1], datetime.datetime(2026, 9, 8, 7, 45))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 8, 18, 15))  # ends 19:00, the closing time
+
+    def test_free_slots_closed_day_is_empty(self):
+        s = Schedule()
