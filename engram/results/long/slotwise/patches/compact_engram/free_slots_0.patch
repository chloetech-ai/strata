+    def test_free_slots_leaves_out_times_that_overlap_or_break_the_gap(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00 to 09:45, so the next start must be 09:55 or later
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
