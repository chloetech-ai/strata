+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day` (every 15 minutes from opening) where a `minutes`-long appointment would fit."""
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        length = datetime.timedelta(minutes=minutes)
+        slots = []
+        start = hours[0]
+        while start + length <= hours[1]:
+            if self._is_free(therapist, start, start + length):
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+    def _is_free(self, therapist, start, end):
+        """True if `therapist` has no active appointment within GAP of the interval from `start` to `end`."""
+        if not is_open_between(start, end):
+            return False
+        for other in self.appointments:
+            if other.cancelled or other.therapist != therapist:
+                continue
+            if other.start < end + GAP and start < other.end + GAP:
+                return False
+        return True
+
