+"""Merging of (start, end) intervals, for ints or datetimes alike."""
+
+
+def merge_intervals(intervals):
+    """Merge intervals that overlap or touch, sorted by start. The input list is left unchanged.
+
+    [(1, 3), (2, 5), (5, 6), (8, 9)] -> [(1, 6), (8, 9)]
+    """
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            if end > merged[-1][1]:
+                merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
