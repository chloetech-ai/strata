+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_disjoint_intervals_are_kept_and_sorted(self):
+        self.assertEqual(merge_intervals([(8, 9), (1, 2)]), [(1, 2), (8, 9)])
+
+    def test_overlapping_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6)]), [(1, 6)])
+
+    def test_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (3, 5)]), [(1, 5)])
+
+    def test_nested_interval_does_not_shorten_the_outer_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3)]), [(1, 10)])
+
+    def test_chain_of_overlaps_becomes_one_interval(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (4, 6), (9, 10)]), [(1, 6), (9, 10)])
+
+    def test_datetimes_are_merged_too(self):
+        d = datetime.datetime(2026, 10, 12, 9, 0)
+        result = merge_intervals([
+            (d + datetime.timedelta(minutes=60), d + datetime.timedelta(minutes=90)),
+            (d, d + datetime.timedelta(minutes=60)),
+        ])
+        self.assertEqual(result, [(d, d + datetime.timedelta(minutes=90))])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
