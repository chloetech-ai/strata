+"""Printable day plans for the receipt printer, which fits 42 characters a line."""
+
+import textwrap
+
+LINE_WIDTH = 42
+
+
+def _wrapped(text, indent=""):
+    """`text` as lines no wider than LINE_WIDTH; continuation lines start with `indent`."""
+    return textwrap.wrap(
+        text,
+        width=LINE_WIDTH,
+        initial_indent=indent,
+        subsequent_indent=" " * len(indent),
+    )
+
+
+def day_plan(schedule, therapist, day):
+    """The day plan for `therapist` on `day` as plain text, one printer line per row."""
+    lines = _wrapped(f"{therapist.title()}, {day:%A %d %B %Y}")
+    lines.append("-" * LINE_WIDTH)
+    appointments = schedule.appointments_for(therapist, day)
+    if not appointments:
+        lines.append("No appointments")
+    for appointment in appointments:
+        time = f"{appointment.start:%H:%M}-{appointment.end:%H:%M}"
+        lines.extend(_wrapped(f"{appointment.client} ({appointment.treatment})", indent=f"{time}  "))
+    return "\n".join(lines) + "\n"
