@@ -0,0 +1,48 @@
+import datetime
+import unittest
+
+from slotwise import Appointment, Schedule
+from slotwise.printing import LINE_WIDTH, day_plan
+
+MONDAY = datetime.date(2026, 10, 12)
+
+
+def at(hour, minute=0):
+    return datetime.datetime.combine(MONDAY, datetime.time(hour, minute))
+
+
+class DayPlanTest(unittest.TestCase):
+    def test_lists_the_day_by_start_time(self):
+        s = Schedule()
+        s.book(Appointment("anna", "Jo Li", at(10), "short"))
+        s.book(Appointment("anna", "Kim Weber", at(9), "standard"))
+        self.assertEqual(
+            day_plan(s, "anna", MONDAY),
+            "Anna, Monday 12 October 2026\n"
+            + "-" * LINE_WIDTH + "\n"
+            + "09:00-09:45  Kim Weber (standard)\n"
+            + "10:00-10:30  Jo Li (short)\n",
+        )
+
+    def test_empty_day_says_so(self):
+        plan = day_plan(Schedule(), "anna", MONDAY)
+        self.assertTrue(plan.endswith("No appointments\n"))
+
+    def test_other_therapists_and_cancelled_appointments_are_left_out(self):
+        s = Schedule()
+        s.book(Appointment("ben", "Jo Li", at(9)))
+        cancelled = s.book(Appointment("anna", "Kim Weber", at(11)))
+        s.cancel(cancelled.id)
+        self.assertNotIn("Jo Li", day_plan(s, "anna", MONDAY))
+        self.assertNotIn("Kim Weber", day_plan(s, "anna", MONDAY))
+
+    def test_no_line_is_wider_than_the_printer(self):
+        s = Schedule()
+        s.book(Appointment("anna", "Maria-Theresia von Hohenlohe-Langenburg-Schwarzenberg", at(9), "initial"))
+        for line in day_plan(s, "anna", MONDAY).splitlines():
+            self.assertLessEqual(len(line), LINE_WIDTH)
+        self.assertIn("Schwarzenberg (initial)", " ".join(day_plan(s, "anna", MONDAY).split()))
+
+
+if __name__ == "__main__":
+    unittest.main()
