+    def test_day_with_seven_treatments_is_fully_booked(self):
+        s = Schedule()
+        for i in range(7):  # 30-minute treatments, 10 minutes apart: 09:00 to 13:30
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 9, 0) + i * datetime.timedelta(minutes=40), "short"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_day_with_six_treatments_is_not_fully_booked(self):
+        s = Schedule()
+        for i in range(6):
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 9, 0) + i * datetime.timedelta(minutes=40), "short"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_treatments_do_not_count_towards_full(self):
+        s = Schedule()
+        for i in range(7):
+            a = s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 9, 0) + i * datetime.timedelta(minutes=40), "short"))
+        s.cancel(a.id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_other_therapists_treatments_do_not_count(self):
+        s = Schedule()
+        for i in range(6):
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 9, 0) + i * datetime.timedelta(minutes=40), "short"))
+        s.book(Appointment("marco", "Jo Li", datetime.datetime(2026, 9, 8, 9, 0), "short"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_empty_day_is_not_fully_booked(self):
+        s = Schedule()
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
