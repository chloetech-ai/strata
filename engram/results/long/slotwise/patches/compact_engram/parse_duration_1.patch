+++ b/tests/test_durations.py
@@ -0,0 +1,46 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_typed_forms_become_minutes(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_case_and_surrounding_spaces_are_ignored(self):
+        self.assertEqual(parse_duration("  1H30  "), 90)
+        self.assertEqual(parse_duration(" 45 MIN "), 45)
+
+    def test_empty_input_is_an_error(self):
+        for text in ["", "   "]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_zero_is_an_error(self):
+        for text in ["0", "0m", "0h", "0:00"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_anything_else_is_an_error(self):
+        for text in ["abc", "-5", "1.5h", "1h60", "1:75", "45 seconds"]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
