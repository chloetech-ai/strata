+"""Durations typed by receptionists, such as '45', '1h30' or '1:30', turned into minutes."""
+
+import re
+
+_MINUTES = re.compile(r"([0-9]+)\s*(?:min|m)?")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]+)\s*m?)?")
+_CLOCK = re.compile(r"([0-9]+):([0-9]+)")
+
+
+def parse_duration(text):
+    """Minutes for a duration typed by a receptionist.
+
+    Accepts '45', '45m', '45 min', '1h', '1h30', '1h 30m' and '1:30'. Ignores case and surrounding spaces.
+    Raises ValueError for empty input, zero, minutes of 60 or more after an hour, or anything else.
+    """
+    cleaned = text.strip().lower()
+    if match := _MINUTES.fullmatch(cleaned):
+        minutes = int(match[1])
+    elif match := _HOURS.fullmatch(cleaned):
+        minutes = int(match[1]) * 60 + _minute_part(match[2], text)
+    elif match := _CLOCK.fullmatch(cleaned):
+        minutes = int(match[1]) * 60 + _minute_part(match[2], text)
+    else:
+        raise ValueError(f"not a duration: {text!r}")
+    if minutes == 0:
+        raise ValueError(f"duration must be more than zero: {text!r}")
+    return minutes
+
+
+def _minute_part(digits, text):
+    """The minutes after an hour, which must be below 60; missing means 0."""
+    if digits is None:
+        return 0
+    minutes = int(digits)
+    if minutes >= 60:
+        raise ValueError(f"minutes after the hour must be below 60: {text!r}")
+    return minutes
diff --git a/tests/test_durations.py b/tests/test_durations.py
