+    def test_day_with_seven_appointments_is_fully_booked(self):
+        s = Schedule()
+        for i in range(7):  # short treatments, 40 minutes apart including the gap
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 8, 0) + i * datetime.timedelta(minutes=40), "short"))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_day_with_six_appointments_is_not_fully_booked(self):
+        s = Schedule()
+        for i in range(6):
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 8, 0) + i * datetime.timedelta(minutes=40), "short"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointments_do_not_count_towards_full(self):
+        s = Schedule()
+        booked = [
+            s.book(Appointment("lena", f"Client {i}", datetime.datetime(2026, 9, 8, 8, 0) + i * datetime.timedelta(minutes=40), "short"))
+            for i in range(7)
+        ]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_other_therapists_do_not_count_towards_full(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(Appointment("marco", f"Client {i}", datetime.datetime(2026, 9, 8, 8, 0) + i * datetime.timedelta(minutes=40), "short"))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_book_does_not_refuse_an_eighth_appointment(self):
