+"""Printable day plans for the receipt printer at reception, 42 characters a line."""
+
+import textwrap
+
+# The receipt printer wraps anything longer than this into a mess.
+LINE_WIDTH = 42
+
+
+def _wrap(text, indent=""):
+    return textwrap.wrap(text, width=LINE_WIDTH, initial_indent=indent, subsequent_indent=indent) or [indent]
+
+
+def day_plan(schedule, therapist, day):
+    """`therapist`'s active appointments on `day` as plain text, one block per appointment."""
+    lines = _wrap(f"Day plan: {therapist.title()}")
+    lines += _wrap(f"{day:%A %d %B %Y}")
+    lines.append("-" * LINE_WIDTH)
+    appointments = schedule.appointments_for(therapist, day)
+    if not appointments:
+        lines += _wrap("No appointments.")
+    for appointment in appointments:
+        lines += _wrap(f"{appointment.start:%H:%M}-{appointment.end:%H:%M} {appointment.treatment}")
+        lines += _wrap(appointment.client, indent="  ")
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_printing.py b/tests/test_printing.py
