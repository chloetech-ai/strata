+"""The text of appointment reminder SMS: plain ASCII, at most 160 characters, with the reception number."""
+
+import unicodedata
+
+RECEPTION_PHONE = "044 512 77 30"
+MAX_LENGTH = 160
+
+# German letters that decomposition cannot handle, so they are spelled out first.
+_LETTERS = {"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"}
+
+
+def to_ascii(text):
+    """'Brändli' -> 'Braendli'. Raises ValueError for anything that has no plain ASCII form."""
+    for letter, replacement in _LETTERS.items():
+        text = text.replace(letter, replacement)
+    decomposed = unicodedata.normalize("NFKD", text)
+    stripped = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    if not stripped.isascii():
+        raise ValueError(f"cannot write {text!r} in plain ASCII")
+    return stripped
+
+
+def reminder_text(appointment):
+    """The reminder SMS for an appointment. Raises ValueError if it would not fit in 160 characters."""
+    when = appointment.start
+    text = (
+        f"Lindqvist Physio: reminder for {to_ascii(appointment.client)}, "
+        f"{when:%d.%m.%Y} at {when:%H:%M} with {to_ascii(appointment.therapist)}. "
+        f"To change it call {RECEPTION_PHONE}."
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder is {len(text)} characters, the limit is {MAX_LENGTH}: {text!r}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
