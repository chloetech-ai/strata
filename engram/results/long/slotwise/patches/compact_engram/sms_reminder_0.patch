@@ -0,0 +1,56 @@
+import datetime
+import unittest
+
+from slotwise.model import Appointment
+from slotwise.reminders import MAX_LENGTH, RECEPTION_PHONE, reminder_text, to_ascii
+
+
+def appointment(client="Zoe Braendli", therapist="Anna Keller"):
+    return Appointment(therapist, client, datetime.datetime(2026, 10, 20, 9, 30))
+
+
+class ToAsciiTest(unittest.TestCase):
+    def test_umlauts_are_spelled_out(self):
+        self.assertEqual(to_ascii("Brändli"), "Braendli")
+        self.assertEqual(to_ascii("Jörg Müller"), "Joerg Mueller")
+        self.assertEqual(to_ascii("Strauß"), "Strauss")
+
+    def test_other_accents_are_dropped(self):
+        self.assertEqual(to_ascii("Zoë Érard"), "Zoe Erard")
+
+    def test_text_without_special_letters_is_unchanged(self):
+        self.assertEqual(to_ascii("Jo Li"), "Jo Li")
+
+    def test_letters_with_no_ascii_form_are_an_error(self):
+        with self.assertRaises(ValueError):
+            to_ascii("Øyvind")
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_reminder_names_client_time_therapist_and_reception(self):
+        text = reminder_text(appointment())
+        self.assertEqual(
+            text,
+            "Lindqvist Physio: reminder for Zoe Braendli, 20.10.2026 at 09:30 with Anna Keller. "
+            "To change it call 044 512 77 30.",
+        )
+
+    def test_reminder_is_plain_ascii_with_transliterated_names(self):
+        text = reminder_text(appointment(client="Zoë Brändli", therapist="Jörg Müller"))
+        self.assertTrue(text.isascii())
+        self.assertIn("Zoe Braendli", text)
+        self.assertIn("Joerg Mueller", text)
+
+    def test_reminder_contains_reception_number(self):
+        self.assertIn(RECEPTION_PHONE, reminder_text(appointment()))
+
+    def test_reminder_fits_in_160_characters(self):
+        self.assertLessEqual(len(reminder_text(appointment())), MAX_LENGTH)
+
+    def test_too_long_reminder_is_an_error_for_reception_to_check(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client="A" * 150))
+
+
+if __name__ == "__main__":
+    unittest.main()
