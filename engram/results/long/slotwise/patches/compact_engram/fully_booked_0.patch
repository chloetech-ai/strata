+    def book_short_days(self, s, count, therapist="lena", day=8):
+        # 30-minute appointments, 40 minutes apart, from 08:00
+        for i in range(count):
+            start = datetime.datetime(2026, 9, day, 8) + datetime.timedelta(minutes=40 * i)
+            s.book(Appointment(therapist, f"Client {i}", start, "short"))
+
+    def test_day_with_six_appointments_is_not_fully_booked(self):
+        s = Schedule()
+        self.book_short_days(s, 6)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_seven_appointments_is_fully_booked(self):
+        s = Schedule()
+        self.book_short_days(s, 7)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cap_is_not_enforced_by_book(self):
+        s = Schedule()
+        self.book_short_days(s, 8)
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        self.assertEqual(len(s.appointments), 8)
+
+    def test_cancelled_appointments_do_not_count_towards_the_cap(self):
+        s = Schedule()
+        self.book_short_days(s, 7)
+        s.cancel(s.appointments[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_other_therapists_and_other_days_do_not_count(self):
+        s = Schedule()
+        self.book_short_days(s, 6)
+        self.book_short_days(s, 1, therapist="marco")
+        self.book_short_days(s, 1, day=9)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_empty_day_is_not_fully_booked(self):
+        s = Schedule()
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
