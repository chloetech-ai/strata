+"""The text of the SMS reminder sent before an appointment."""
+
+import unicodedata
+
+PHONE = "044 512 77 30"
+MAX_LENGTH = 160
+
+# Umlauts and ß are spelled out, as they are on a keyboard without them.
+_SPELLED = str.maketrans({"ä": "ae", "ö": "oe", "ü": "ue", "Ä": "Ae", "Ö": "Oe", "Ü": "Ue", "ß": "ss"})
+
+
+def to_ascii(text):
+    """Plain ASCII for the SMS gateway: 'Brändli' -> 'Braendli', 'Zoë' -> 'Zoe'."""
+    text = text.translate(_SPELLED)
+    decomposed = unicodedata.normalize("NFKD", text)
+    ascii_text = "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+    if not ascii_text.isascii():
+        raise ValueError(f"cannot send {text!r} by SMS: no plain ASCII form")
+    return ascii_text
+
+
+def reminder_text(appointment):
+    """The reminder for an appointment, in plain ASCII and at most 160 characters.
+
+    A reminder that would be too long raises ValueError rather than being cut short,
+    so that reception can check it.
+    """
+    when = appointment.start
+    text = to_ascii(
+        f"Hallo {appointment.client}, Erinnerung an Ihren Termin am {when:%d.%m.} um {when:%H:%M}"
+        f" bei Lindqvist Physio. Zum Verschieben bitte anrufen: {PHONE}"
+    )
+    if len(text) > MAX_LENGTH:
+        raise ValueError(f"reminder for {appointment.client!r} is {len(text)} characters, the limit is {MAX_LENGTH}")
+    return text
diff --git a/tests/test_reminders.py b/tests/test_reminders.py
