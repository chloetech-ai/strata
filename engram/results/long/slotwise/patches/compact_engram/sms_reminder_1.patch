@@ -0,0 +1,45 @@
+import datetime
+import unittest
+
+from slotwise import Appointment
+from slotwise.reminders import reminder_text, to_ascii
+
+
+def appointment(client="Zoë Brändli", start=datetime.datetime(2026, 10, 13, 14, 30)):
+    return Appointment("Anna Keller", client, start)
+
+
+class ReminderTextTest(unittest.TestCase):
+    def test_umlauts_are_spelled_out(self):
+        self.assertIn("Hallo Zoe Braendli,", reminder_text(appointment()))
+
+    def test_capital_umlauts_and_sharp_s(self):
+        self.assertEqual(to_ascii("Ö Ä Ü ß"), "Oe Ae Ue ss")
+
+    def test_accents_are_dropped(self):
+        self.assertEqual(to_ascii("Érica Núñez"), "Erica Nunez")
+
+    def test_text_is_plain_ascii(self):
+        self.assertTrue(reminder_text(appointment()).isascii())
+
+    def test_contains_date_time_and_reception_number(self):
+        text = reminder_text(appointment())
+        self.assertIn("13.10.", text)
+        self.assertIn("14:30", text)
+        self.assertIn("044 512 77 30", text)
+
+    def test_at_most_160_characters(self):
+        self.assertLessEqual(len(reminder_text(appointment())), 160)
+
+    def test_too_long_for_one_sms_is_an_error(self):
+        long_name = "Maria " + "Schneider-" * 15 + "Weber"
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client=long_name))
+
+    def test_name_without_ascii_form_is_an_error(self):
+        with self.assertRaises(ValueError):
+            reminder_text(appointment(client="李 Wei"))
+
+
+if __name__ == "__main__":
+    unittest.main()
