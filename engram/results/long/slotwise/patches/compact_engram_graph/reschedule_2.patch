+    def _check_slot(self, appointment):
+        """Raises unless the practice is open for `appointment` and its therapist is free around it.
+
+        The record with the same id (the appointment being moved) is not counted as a clash.
+        """
+        if not is_open_between(appointment.start, appointment.end):
+            raise OutsideOpeningHours(_closed_message(appointment))
+        for other in self.appointments:
+            if other.id == appointment.id or other.cancelled or other.therapist != appointment.therapist:
+                continue
+            if other.start < appointment.end and appointment.start < other.end:
+                raise SlotTaken(
+                    f"{appointment.therapist.title()} is busy at {appointment.start:%H:%M} "
+                    f"on {appointment.start:%A %d %B}. Please choose another time."
+                )
+            if other.start < appointment.end + CHANGEOVER and appointment.start < other.end + CHANGEOVER:
+                raise SlotTaken(
+                    f"{appointment.therapist.title()} needs {CHANGEOVER.seconds // 60} minutes between appointments. "
+                    f"The {other.start:%H:%M}–{other.end:%H:%M} appointment is too close to this one. "
+                    f"Please choose another time."
+                )
+
