+    def reschedule(self, appointment_id, new_start):
+        """Moves an appointment to `new_start`, keeping its id. Checked like a new booking; on refusal nothing moves."""
+        appointment = self.get(appointment_id)
+        if appointment.cancelled:
+            raise BookingError("This appointment was cancelled, so it can't be moved. Please book a new one.")
+        moved = dataclasses.replace(appointment, start=new_start)
+        self._check_slot(moved)
+        appointment.start = new_start
+        return appointment
