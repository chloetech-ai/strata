+    def test_free_slots_keep_changeover_either_side(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so a 45-minute slot must end by 08:50 or start at 10:00 or later
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)  # ends 09:00, no gap
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 45), slots)  # starts at the end of the booking
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)
