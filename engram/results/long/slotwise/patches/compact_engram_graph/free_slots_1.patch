+    def test_free_slots_on_empty_day_run_from_opening_in_quarter_hours(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 7), 45)  # Monday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 7, 7, 30))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 7, 18, 15))  # last start that still ends by 19:00
