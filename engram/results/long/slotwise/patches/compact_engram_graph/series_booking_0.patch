diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..9d52a66
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,67 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.errors import OutsideOpeningHours, SeriesTooLong, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def first_session(hour=9):
+    return Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, hour), "initial")
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_weekly_sessions_and_returns_them(self):
+        s = Schedule()
+        booked = book_series(s, first_session(), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 15, 22])
+        self.assertEqual(s.appointments, booked)
+
+    def test_sessions_keep_therapist_client_and_treatment(self):
+        s = Schedule()
+        for a in book_series(s, first_session(), 2):
+            self.assertEqual((a.therapist, a.client, a.treatment), ("lena", "Kim Weber", "initial"))
+
+    def test_skips_taken_week_and_adds_one_at_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        booked = book_series(s, first_session(), 3)
+        self.assertEqual([a.start.day for a in booked], [8, 22, 29])
+
+    def test_nine_is_allowed(self):
+        self.assertEqual(len(book_series(Schedule(), first_session(), 9)), 9)
+
+    def test_over_nine_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, first_session(), 10)
+        self.assertEqual(s.appointments, [])
+
+    def test_cannot_fit_books_nothing(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9)))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        with mock.patch("slotwise.series.SERIES_SEARCH_WEEKS", 2):
+            with self.assertRaises(SlotTaken):
+                book_series(s, first_session(), 2)
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_outside_opening_hours_fails_whole_series_and_books_nothing(self):
+        s = Schedule()
+        # 18:30 is after closing on a weekday, so the first session already fails
+        late = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 18, 30))
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, late, 2)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_or_negative_count_books_nothing(self):
+        s = Schedule()
+        self.assertEqual(book_series(s, first_session(), 0), [])
+        self.assertEqual(book_series(s, first_session(), -1), [])
+        self.assertEqual(s.appointments, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
