diff --git a/src/slotwise/series.py b/src/slotwise/series.py
new file mode 100644
index 0000000..426e8f8
--- /dev/null
+++ b/src/slotwise/series.py
@@ -0,0 +1,44 @@
+"""Booking a series of weekly sessions, as a doctor's prescription asks for."""
+
+import datetime
+
+from .errors import BookingError, SeriesTooLong, SlotTaken
+from .model import Appointment
+
+# the insurer pays for at most this many sessions per prescription
+MAX_SERIES_SESSIONS = 9
+# how many weeks a series may run on while looking for free weeks
+SERIES_SEARCH_WEEKS = 26
+
+
+def book_series(schedule, first, count):
+    """Books `count` weekly sessions with the therapist, client and treatment of `first`, starting at `first.start`.
+
+    A week that is already taken is skipped and a later week is used instead, so the client still gets
+    all `count` sessions. Either the whole series is booked or nothing is. Returns the booked appointments.
+    """
+    if count > MAX_SERIES_SESSIONS:
+        raise SeriesTooLong(
+            f"A prescription covers at most {MAX_SERIES_SESSIONS} sessions, so we can't book {count}. "
+            f"Please book {MAX_SERIES_SESSIONS} and start a new series for the rest."
+        )
+    booked = []
+    try:
+        for week in range(SERIES_SEARCH_WEEKS):
+            if len(booked) >= count:
+                break
+            start = first.start + datetime.timedelta(weeks=week)
+            try:
+                booked.append(schedule.book(Appointment(first.therapist, first.client, start, first.treatment)))
+            except SlotTaken:
+                continue
+        if len(booked) < count:
+            raise SlotTaken(
+                f"{first.therapist.title()} doesn't have {count} free {first.start:%A}s at {first.start:%H:%M} "
+                f"in the next {SERIES_SEARCH_WEEKS} weeks. Please choose another time."
+            )
+    except BookingError:
+        for appointment in booked:
+            schedule.appointments.remove(appointment)
+        raise
+    return booked
