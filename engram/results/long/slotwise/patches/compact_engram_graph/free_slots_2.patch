 # time a therapist needs between appointments to clean up and write notes
 CHANGEOVER = datetime.timedelta(minutes=10)
+# grid that free_slots steps through
+SLOT_STEP = datetime.timedelta(minutes=15)
 
 # the insurer pays for at most this many sessions per prescription
 MAX_SERIES_SESSIONS = 9
