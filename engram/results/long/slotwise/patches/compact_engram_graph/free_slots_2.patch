                 )
-            if other.start < appointment.end + CHANGEOVER and appointment.start < other.end + CHANGEOVER:
+            if _too_close(other, appointment.start, appointment.end):
                 raise SlotTaken(
                     f"{appointment.therapist.title()} needs {CHANGEOVER.seconds // 60} minutes between appointments. "
                     f"The {other.start:%H:%M}–{other.end:%H:%M} appointment is too close to this one. "
@@ -99,6 +101,30 @@ class Schedule:
         days = [monday + datetime.timedelta(days=i) for i in range(7)]
         return {day: self.appointments_for(therapist, day) for day in days}
 
+    def free_slots(self, therapist, day, minutes):
+        """Start times on `day`, every 15 minutes from opening, where a `minutes`-long appointment could be booked."""
+        if minutes <= 0:
+            raise ValueError(f"An appointment needs a positive length, not {minutes} minutes")
+        hours = opening_hours(day)
+        if hours is None:
+            return []
+        opens, closes = hours
+        length = datetime.timedelta(minutes=minutes)
+        taken = self.appointments_for(therapist, day)
+        slots = []
+        start = opens
+        while start + length <= closes:
+            end = start + length
+            if not any(_too_close(other, start, end) for other in taken):
+                slots.append(start)
+            start += SLOT_STEP
+        return slots
+
+
+def _too_close(other, start, end):
+    """True if an appointment from `start` to `end` would overlap `other` or leave less than the changeover gap."""
+    return other.start < end + CHANGEOVER and start < other.end + CHANGEOVER
+
 
 def _closed_message(appointment):
     day = appointment.start.date()
