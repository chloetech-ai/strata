+import unittest
+from datetime import datetime
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_and_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 7), (9, 10)]), [(1, 7), (9, 10)])
+
+    def test_disjoint_intervals_are_kept_sorted_by_start(self):
+        self.assertEqual(merge_intervals([(8, 9), (1, 2), (4, 5)]), [(1, 2), (4, 5), (8, 9)])
+
+    def test_one_interval_swallowing_others(self):
+        self.assertEqual(merge_intervals([(1, 10), (2, 3), (4, 5)]), [(1, 10)])
+
+    def test_empty_input_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_datetimes_are_merged_too(self):
+        nine = datetime(2026, 10, 12, 9, 0)
+        ten = datetime(2026, 10, 12, 10, 0)
+        eleven = datetime(2026, 10, 12, 11, 0)
+        self.assertEqual(merge_intervals([(ten, eleven), (nine, ten)]), [(nine, eleven)])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 7), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 7), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
