+"""Merging of (start, end) intervals, for ints or datetimes alike."""
+
+
+def merge_intervals(intervals):
+    """Merged (start, end) tuples sorted by start; overlapping or touching intervals become one. The input is not modified."""
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
