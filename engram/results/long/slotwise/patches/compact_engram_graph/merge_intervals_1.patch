+"""Merging of (start, end) intervals, for ints or datetimes."""
+
+
+def merge_intervals(intervals):
+    """Merges intervals that overlap or touch, sorted by start. The input list is not changed."""
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        else:
+            merged.append((start, end))
+    return merged
