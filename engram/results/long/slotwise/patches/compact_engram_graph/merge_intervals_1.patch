+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+    def test_overlapping_and_touching_intervals_are_merged(self):
+        self.assertEqual(merge_intervals([(1, 3), (2, 5), (5, 7)]), [(1, 7)])
+
+    def test_disjoint_intervals_stay_apart_and_are_sorted(self):
+        self.assertEqual(merge_intervals([(8, 9), (1, 2), (4, 5)]), [(1, 2), (4, 5), (8, 9)])
+
+    def test_contained_interval_does_not_shorten_the_merged_one(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_datetimes_are_merged_too(self):
+        nine = datetime.datetime(2026, 10, 12, 9, 0)
+        half_past = datetime.datetime(2026, 10, 12, 9, 30)
+        ten = datetime.datetime(2026, 10, 12, 10, 0)
+        self.assertEqual(merge_intervals([(nine, half_past), (half_past, ten)]), [(nine, ten)])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 7), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 7), (1, 3), (2, 4)])
+
+
+if __name__ == "__main__":
+    unittest.main()
