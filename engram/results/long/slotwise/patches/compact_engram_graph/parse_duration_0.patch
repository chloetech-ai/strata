+++ b/tests/test_durations.py
@@ -0,0 +1,32 @@
+import unittest
+
+from slotwise.durations import parse_duration
+
+
+class ParseDurationTest(unittest.TestCase):
+    def test_accepted_notations(self):
+        cases = {
+            "45": 45,
+            "45m": 45,
+            "45 min": 45,
+            "1h": 60,
+            "1h30": 90,
+            "1h 30m": 90,
+            "2h15": 135,
+            "1:30": 90,
+        }
+        for text, minutes in cases.items():
+            with self.subTest(text=text):
+                self.assertEqual(parse_duration(text), minutes)
+
+    def test_ignores_case_and_surrounding_spaces(self):
+        self.assertEqual(parse_duration("  1H 30M  "), 90)
+
+    def test_empty_zero_and_unreadable_input_is_refused(self):
+        for text in ["", "   ", "0", "0h", "abc", "-5", "1h30m extra", "1:60"]:
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_duration(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
