+"""Appointment lengths as receptionists type them, such as '45', '1h30' or '1:30'."""
+
+import re
+
+_CLOCK = re.compile(r"([0-9]+):([0-9]+)")
+_UNITS = re.compile(r"(?:([0-9]+)\s*h)?\s*(?:([0-9]+)\s*(?:min|m)?)?")
+
+
+def parse_duration(text):
+    """Minutes in a length, ignoring case and surrounding spaces. Raises ValueError unless it is a positive length."""
+    cleaned = text.strip().lower()
+    clock = _CLOCK.fullmatch(cleaned)
+    if clock:
+        hours, minutes = int(clock[1]), int(clock[2])
+        if minutes >= 60:
+            raise ValueError(f"Minutes must be under 60 in duration {text!r}")
+    else:
+        units = _UNITS.fullmatch(cleaned)
+        if not units or (units[1] is None and units[2] is None):
+            raise ValueError(f"Cannot read duration {text!r}")
+        hours, minutes = int(units[1] or 0), int(units[2] or 0)
+        if units[1] is not None and minutes >= 60:
+            raise ValueError(f"Minutes must be under 60 in duration {text!r}")
+    total = hours * 60 + minutes
+    if total == 0:
+        raise ValueError(f"Duration must be more than zero: {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
