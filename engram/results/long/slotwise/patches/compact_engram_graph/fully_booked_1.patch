         week = s.week("lena", datetime.date(2026, 9, 7))
         self.assertEqual([a.start.hour for a in week[datetime.date(2026, 9, 8)]], [12])
 
+    def test_fully_booked_at_seven_appointments_that_day(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for i in range(6):
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 8) + datetime.timedelta(minutes=55 * i)))
+        self.assertFalse(s.is_fully_booked("lena", day))
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 8) + datetime.timedelta(minutes=55 * 6)))
+        self.assertTrue(s.is_fully_booked("lena", day))
+
+    def test_cap_is_per_therapist_and_per_day(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 8) + datetime.timedelta(minutes=55 * i)))
+        self.assertFalse(s.is_fully_booked("maya", datetime.date(2026, 9, 8)))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 9)))
+
+    def test_cancelled_appointments_do_not_count_towards_cap(self):
+        s = Schedule()
+        booked = [
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 8) + datetime.timedelta(minutes=55 * i)))
+            for i in range(7)
+        ]
+        s.cancel(booked[0].id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_book_still_accepts_an_eighth_appointment(self):
+        s = Schedule()
+        for i in range(7):
+            s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 8) + datetime.timedelta(minutes=55 * i)))
+        s.book(Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 8) + datetime.timedelta(minutes=55 * 7)))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
