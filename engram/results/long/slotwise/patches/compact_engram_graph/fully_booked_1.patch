         days = [monday + datetime.timedelta(days=i) for i in range(7)]
         return {day: self.appointments_for(therapist, day) for day in days}
 
+    def is_fully_booked(self, therapist, day):
+        """True once `therapist` has reached the daily cap on `day`, so the online booking page greys it out."""
+        return len(self.appointments_for(therapist, day)) >= DAILY_CAP
+
 
 def _closed_message(appointment):
     day = appointment.start.date()
