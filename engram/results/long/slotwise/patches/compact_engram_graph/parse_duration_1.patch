+"""Reads appointment lengths typed by reception, such as '45', '1h30' or '1:30', as minutes."""
+
+import re
+
+_CLOCK = re.compile(r"([0-9]+):([0-9]{2})")
+_HOURS = re.compile(r"([0-9]+)\s*h(?:\s*([0-9]{1,2})\s*(?:m|min)?)?")
+_MINUTES = re.compile(r"([0-9]+)\s*(?:m|min)?")
+
+
+def parse_duration(text):
+    """Minutes for a duration such as '45', '45 min', '1h', '1h 30m' or '1:30'. Raises ValueError otherwise."""
+    s = text.strip().lower()
+    if not s:
+        raise ValueError("Duration is empty")
+    if match := _CLOCK.fullmatch(s) or _HOURS.fullmatch(s):
+        minutes = int(match[2] or 0)
+        if minutes >= 60:
+            raise ValueError(f"Minutes must be under 60 in {text!r}")
+        total = int(match[1]) * 60 + minutes
+    elif match := _MINUTES.fullmatch(s):
+        total = int(match[1])
+    else:
+        raise ValueError(f"Cannot read duration {text!r}")
+    if total == 0:
+        raise ValueError(f"Duration must be more than zero, got {text!r}")
+    return total
diff --git a/tests/test_durations.py b/tests/test_durations.py
