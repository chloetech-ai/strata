@@ -0,0 +1,18 @@
+"""Cancellation fees, worked out here so reception doesn't have to do it by hand."""
+
+import datetime
+
+
+def cancellation_fee(appointment, cancelled_at):
+    """Fee in cents for cancelling `appointment` at `cancelled_at`.
+
+    Less than 24 hours before: the full treatment price. Less than 48 hours: half the price.
+    Earlier than that: nothing. Exactly 24 or 48 hours counts as the later band.
+    Half of an odd number of cents is rounded down.
+    """
+    notice = appointment.start - cancelled_at
+    if notice < datetime.timedelta(hours=24):
+        return appointment.price
+    if notice < datetime.timedelta(hours=48):
+        return appointment.price // 2
+    return 0
diff --git a/tests/test_fees.py b/tests/test_fees.py
new file mode 100644
