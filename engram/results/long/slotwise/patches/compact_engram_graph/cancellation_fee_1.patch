+++ b/tests/test_fees.py
@@ -0,0 +1,48 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.fees import cancellation_fee
+from slotwise.model import TREATMENTS, Appointment
+
+START = datetime.datetime(2026, 11, 2, 10, 0)
+
+
+def appointment(treatment="standard"):
+    return Appointment("lena", "Ruth Brändli", START, treatment)
+
+
+class CancellationFeeTest(unittest.TestCase):
+    def cancel_hours_before(self, hours, treatment="standard"):
+        return cancellation_fee(appointment(treatment), START - datetime.timedelta(hours=hours))
+
+    def test_more_than_48_hours_before_is_free(self):
+        self.assertEqual(self.cancel_hours_before(72), 0)
+
+    def test_exactly_48_hours_before_is_free(self):
+        self.assertEqual(self.cancel_hours_before(48), 0)
+
+    def test_under_48_hours_before_is_half_price(self):
+        self.assertEqual(self.cancel_hours_before(47), 4900)
+
+    def test_exactly_24_hours_before_is_half_price(self):
+        self.assertEqual(self.cancel_hours_before(24), 4900)
+
+    def test_under_24_hours_before_is_full_price(self):
+        self.assertEqual(self.cancel_hours_before(23), 9800)
+
+    def test_after_the_start_is_full_price(self):
+        self.assertEqual(self.cancel_hours_before(-1), 9800)
+
+    def test_fee_follows_the_treatment_price(self):
+        self.assertEqual(self.cancel_hours_before(1, treatment="initial"), 14500)
+        self.assertEqual(self.cancel_hours_before(30, treatment="short"), 3400)
+
+    def test_half_of_an_odd_number_of_cents_rounds_down(self):
+        with mock.patch.dict(TREATMENTS, {"odd": (45, 9801)}):
+            fee = cancellation_fee(appointment("odd"), START - datetime.timedelta(hours=30))
+        self.assertEqual(fee, 4900)
+
+
+if __name__ == "__main__":
+    unittest.main()
