+    def test_free_slots_on_empty_day_run_from_opening_on_fifteen_minute_grid(self):
+        s = Schedule()
+        slots = s.free_slots("lena", datetime.date(2026, 9, 7), 45)  # Monday, 07:30-19:00
+        self.assertEqual(slots[0], datetime.datetime(2026, 9, 7, 7, 30))
+        self.assertEqual(slots[1], datetime.datetime(2026, 9, 7, 7, 45))
+        self.assertEqual(slots[-1], datetime.datetime(2026, 9, 7, 18, 15))  # ends 19:00
+
+    def test_free_slots_leave_out_times_too_close_to_booking(self):
+        s = Schedule()
+        s.book(at(9))  # 09:00-09:45, so 08:10-09:55 is blocked by overlap or changeover
+        slots = s.free_slots("lena", datetime.date(2026, 9, 8), 45)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 8, 15), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 0), slots)
+        self.assertNotIn(datetime.datetime(2026, 9, 8, 9, 30), slots)
+        self.assertIn(datetime.datetime(2026, 9, 8, 8, 0), slots)  # ends 08:45, 15 minutes before 09:00
+        self.assertIn(datetime.datetime(2026, 9, 8, 10, 0), slots)  # starts 15 minutes after 09:45
+
+    def test_each_free_slot_is_accepted_by_book(self):
+        s = Schedule()
+        s.book(at(9))
+        s.book(at(13, 30, client="Jo Li"))
+        day = datetime.date(2026, 9, 8)
+        slots = s.free_slots("lena", day, 60)
+        self.assertTrue(slots)
+        for start in slots:
+            trial = Schedule()
+            trial.appointments = list(s.appointments)  # the bookings as they are now, nothing else
+            trial.book(Appointment("lena", "Sam Ng", start, "initial"))  # must not raise
+
