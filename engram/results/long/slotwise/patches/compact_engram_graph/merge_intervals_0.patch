+import datetime
+import unittest
+
+from slotwise.intervals import merge_intervals
+
+
+class MergeIntervalsTest(unittest.TestCase):
+    def test_overlapping_and_touching_intervals_merge(self):
+        self.assertEqual(merge_intervals([(1, 4), (3, 6), (6, 8)]), [(1, 8)])
+
+    def test_disjoint_intervals_stay_apart_and_are_sorted(self):
+        self.assertEqual(merge_intervals([(10, 12), (1, 2), (5, 6)]), [(1, 2), (5, 6), (10, 12)])
+
+    def test_contained_interval_does_not_shorten_the_merge(self):
+        self.assertEqual(merge_intervals([(1, 10), (3, 4)]), [(1, 10)])
+
+    def test_datetimes_merge_like_ints(self):
+        nine = datetime.datetime(2026, 10, 12, 9, 0)
+        half_past = datetime.datetime(2026, 10, 12, 9, 30)
+        ten = datetime.datetime(2026, 10, 12, 10, 0)
+        eleven = datetime.datetime(2026, 10, 12, 11, 0)
+        self.assertEqual(merge_intervals([(half_past, ten), (nine, half_past)]), [(nine, ten)])
+        self.assertEqual(merge_intervals([(nine, ten), (eleven, eleven)]), [(nine, ten), (eleven, eleven)])
+
+    def test_input_is_not_modified(self):
+        intervals = [(5, 6), (1, 3), (2, 4)]
+        merge_intervals(intervals)
+        self.assertEqual(intervals, [(5, 6), (1, 3), (2, 4)])
+
+    def test_empty_list_gives_empty_list(self):
+        self.assertEqual(merge_intervals([]), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
