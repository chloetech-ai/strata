diff --git a/tests/test_series.py b/tests/test_series.py
new file mode 100644
index 0000000..65145e6
--- /dev/null
+++ b/tests/test_series.py
@@ -0,0 +1,83 @@
+import datetime
+import unittest
+from unittest import mock
+
+from slotwise.errors import OutsideOpeningHours, SeriesTooLong, SlotTaken
+from slotwise.model import Appointment
+from slotwise.schedule import Schedule
+from slotwise.series import book_series
+
+
+def first_session(hour=9, minute=0):
+    return Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, hour, minute))
+
+
+class BookSeriesTest(unittest.TestCase):
+    def test_books_consecutive_weeks_starting_with_first(self):
+        s = Schedule()
+        first = first_session()
+        series = book_series(s, first, 3)
+        self.assertEqual([a.start for a in series], [
+            datetime.datetime(2026, 9, 8, 9),
+            datetime.datetime(2026, 9, 15, 9),
+            datetime.datetime(2026, 9, 22, 9),
+        ])
+        self.assertIs(series[0], first)
+        self.assertEqual(s.appointments, series)
+
+    def test_sessions_keep_client_therapist_and_treatment(self):
+        s = Schedule()
+        first = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 8, 9), "initial")
+        series = book_series(s, first, 2)
+        self.assertEqual({(a.therapist, a.client, a.treatment) for a in series}, {("lena", "Kim Weber", "initial")})
+        self.assertEqual(len({a.id for a in series}), 2)
+
+    def test_skips_taken_week_and_adds_one_at_end(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        series = book_series(s, first_session(), 3)
+        self.assertEqual([a.start.day for a in series], [8, 22, 29])
+        self.assertEqual(len(s.appointments), 4)
+
+    def test_skips_taken_first_week(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9)))
+        first = first_session()
+        series = book_series(s, first, 2)
+        self.assertEqual([a.start.day for a in series], [15, 22])
+        self.assertNotIn(first, s.appointments)
+
+    def test_series_of_nine_is_allowed(self):
+        s = Schedule()
+        self.assertEqual(len(book_series(s, first_session(), 9)), 9)
+
+    def test_series_over_nine_is_refused_and_books_nothing(self):
+        s = Schedule()
+        with self.assertRaises(SeriesTooLong):
+            book_series(s, first_session(), 12)
+        self.assertEqual(s.appointments, [])
+
+    def test_series_that_cannot_fit_books_nothing(self):
+        s = Schedule()
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 8, 9)))
+        s.book(Appointment("lena", "Jo Li", datetime.datetime(2026, 9, 15, 9)))
+        with mock.patch("slotwise.series.SERIES_SEARCH_WEEKS", 2):
+            with self.assertRaises(SlotTaken):
+                book_series(s, first_session(), 2)
+        self.assertEqual(len(s.appointments), 2)
+
+    def test_outside_opening_hours_books_nothing(self):
+        s = Schedule()
+        # Saturdays close at 12:00, so a 45-minute session from 11:30 does not fit
+        saturday = Appointment("lena", "Kim Weber", datetime.datetime(2026, 9, 12, 11, 30))
+        with self.assertRaises(OutsideOpeningHours):
+            book_series(s, saturday, 3)
+        self.assertEqual(s.appointments, [])
+
+    def test_zero_sessions_is_refused(self):
+        with self.assertRaises(ValueError):
+            book_series(Schedule(), first_session(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
