+    def test_day_is_fully_booked_at_seven_appointments(self):
+        s = Schedule()
+        day = datetime.date(2026, 9, 8)
+        for hour in range(8, 15):  # 08:00 to 14:00 starts, 45 minutes each, 10-minute gaps
+            s.book(at(hour))
+        self.assertTrue(s.is_fully_booked("lena", day))
+        self.assertFalse(s.is_fully_booked("marco", day))
+
+    def test_six_appointments_is_not_fully_booked(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour))
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_cancelled_appointment_does_not_count_towards_full(self):
+        s = Schedule()
+        for hour in range(8, 14):
+            s.book(at(hour))
+        a = s.book(at(14))
+        self.assertTrue(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+        s.cancel(a.id)
+        self.assertFalse(s.is_fully_booked("lena", datetime.date(2026, 9, 8)))
+
+    def test_booking_past_seven_is_still_allowed(self):
+        s = Schedule()
+        for hour in range(8, 16):
+            s.book(at(hour))
+        self.assertEqual(len(s.appointments_for("lena", datetime.date(2026, 9, 8))), 8)
+
