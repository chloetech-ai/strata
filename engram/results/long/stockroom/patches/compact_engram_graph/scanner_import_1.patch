@@ -0,0 +1,57 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self._dir.name, "count.txt")
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def write(self, text):
+        with open(self.path, "w", encoding="utf-8") as f:
+            f.write(text)
+
+    def test_reads_quantity_per_sku(self):
+        self.write("B-12-3;BR-1042;7\nB-9-1;BR-2000;4\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7, "BR-2000": 4})
+
+    def test_adds_up_a_sku_counted_in_several_bins(self):
+        self.write("B-12-3;BR-1042;7\nOVERFLOW-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 12})
+
+    def test_normalizes_sku_spelling(self):
+        self.write("B-1;br-1042 ;3\nB-1; BR-1042;2\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 5})
+
+    def test_zero_count_is_kept(self):
+        self.write("B-1;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 0})
+
+    def test_blank_lines_are_skipped(self):
+        self.write("\nB-1;BR-1042;2\n\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 2})
+
+    def test_wrong_field_count_names_the_line(self):
+        self.write("B-1;BR-1042;2\nB-1;BR-2000\n")
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            read_scanner_file(self.path)
+
+    def test_non_numeric_quantity_names_the_line(self):
+        self.write("B-1;BR-1042;two\n")
+        with self.assertRaisesRegex(ValueError, "line 1.*whole number"):
+            read_scanner_file(self.path)
+
+    def test_negative_quantity_is_rejected(self):
+        self.write("B-1;BR-1042;-3\n")
+        with self.assertRaisesRegex(ValueError, "line 1.*negative"):
+            read_scanner_file(self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
