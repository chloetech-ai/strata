@@ -0,0 +1,25 @@
+"""Reading the handheld scanner export: plain text, `bin;sku;qty`, no header line."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU, with a SKU's lines in several bins added together."""
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = [field.strip() for field in line.split(";")]
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity {qty!r} is not a whole number") from None
+            if qty < 0:
+                raise ValueError(f"line {number}: quantity cannot be negative")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
