+"""Reading the count files exported by the handheld scanners.
+
+Each line is `bin;sku;qty` with no header. A SKU can appear on several
+lines when some of it sits in an overflow bin, so quantities are summed.
+"""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per normalized SKU, e.g. {'BR-1042': 37}."""
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = [field.strip() for field in line.split(";")]
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty = fields
+            if not sku:
+                raise ValueError(f"line {number}: missing SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity must be a whole number, got {qty!r}")
+            if qty < 0:
+                raise ValueError(f"line {number}: quantity cannot be negative")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
