+"""What stock on hand is worth, costed first in, first out (FIFO)."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` on hand, costed FIFO.
+
+    Each receipt adds a layer of stock at its unit cost. Goods out use up the
+    oldest layers first. Stock taken below zero has no layer left to use up,
+    so it adds nothing to the value.
+    """
+    layers = deque()  # [qty, unit_cost in cents], oldest first
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost for {m.reason} of {m.qty} {m.sku}")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            taken = min(remaining, layers[0][0])
+            layers[0][0] -= taken
+            remaining -= taken
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
