-from stockroom.items import Catalog, Item, normalize_sku
+from stockroom.items import Catalog, Item, normalize_sku, parse_location
+
+
+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code_into_aisle_bay_shelf(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_accepts_lowercase_aisle_and_surrounding_whitespace(self):
+        self.assertEqual(parse_location(" b-9-1 "), ("B", 9, 1))
+
+    def test_rejects_anything_else(self):
+        for code in ("", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                     "B-12-", "B--3", "B-1.5-3", "B-+12-3", "B-12-3 4"):
+            with self.assertRaises(ValueError, msg=code):
+                parse_location(code)
 
 
 class NormalizeSkuTest(unittest.TestCase):
