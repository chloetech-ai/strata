diff --git a/src/stockroom/items.py b/src/stockroom/items.py
index 75f79ae..3a3d5d8 100644
--- a/src/stockroom/items.py
+++ b/src/stockroom/items.py
@@ -8,6 +8,19 @@ def normalize_sku(sku):
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like ' b-12-3 ' into ('B', 12, 3); anything else is a ValueError."""
+    parts = code.strip().split("-")
+    if len(parts) != 3:
+        raise ValueError(f"bin code must look like A-12-3, got {code!r}")
+    aisle, bay, shelf = parts
+    if len(aisle) != 1 or not ("A" <= aisle.upper() <= "Z"):
+        raise ValueError(f"aisle must be a single letter, got {aisle!r} in {code!r}")
+    if not (bay.isdecimal() and shelf.isdecimal()):
+        raise ValueError(f"bay and shelf must be whole numbers, got {code!r}")
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
