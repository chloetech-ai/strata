diff --git a/src/stockroom/items.py b/src/stockroom/items.py
index 75f79ae..ece6500 100644
--- a/src/stockroom/items.py
+++ b/src/stockroom/items.py
@@ -1,13 +1,29 @@
 """The item catalog."""
 
+import re
 from dataclasses import dataclass, replace
 
+_LOCATION = re.compile(r"([A-Za-z])-([0-9]+)-([0-9]+)")
+
 
 def normalize_sku(sku):
     """Trim surrounding whitespace and uppercase, so ' br-1042 ' is 'BR-1042'."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code such as 'b-12-3' into ('B', 12, 3).
+
+    Raises ValueError for anything that is not an aisle letter, a bay number
+    and a shelf number joined by hyphens.
+    """
+    match = _LOCATION.fullmatch(code.strip())
+    if match is None:
+        raise ValueError(f"not a bin code: {code!r}")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
