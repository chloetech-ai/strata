+"""Reads the counted quantities from a handheld scanner export.
+
+The scanners write a plain text file, one line per bin and SKU, with no header:
+    bin;sku;qty
+A SKU can appear on several lines (overflow bins), so quantities are added up.
+"""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Return {SKU: counted quantity} for the scanner export at `path`."""
+    counts = {}
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty = fields
+            try:
+                quantity = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity {qty.strip()!r} is not a whole number") from None
+            if quantity < 0:
+                raise ValueError(f"{path}:{number}: quantity cannot be negative")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + quantity
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
