@@ -0,0 +1,61 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self._dir.name, "count.txt")
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def write(self, text):
+        with open(self.path, "w", encoding="utf-8") as f:
+            f.write(text)
+
+    def test_reads_quantity_per_sku(self):
+        self.write("B-12-3;BR-1042;7\nB-12-4;BR-2000;3\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7, "BR-2000": 3})
+
+    def test_adds_up_a_sku_counted_in_several_bins(self):
+        self.write("B-12-3;BR-1042;7\nOVF-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 12})
+
+    def test_normalizes_sku_spelling(self):
+        self.write("B-1;br-1042 ;2\nB-2; BR-1042;3\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 5})
+
+    def test_zero_count_is_kept(self):
+        self.write("B-1;BR-1042;0\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 0})
+
+    def test_blank_lines_and_crlf_are_ignored(self):
+        self.write("B-1;BR-1042;4\r\n\r\nB-2;BR-2000;1\r\n\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 4, "BR-2000": 1})
+
+    def test_empty_file_gives_no_counts(self):
+        self.write("")
+        self.assertEqual(read_scanner_file(self.path), {})
+
+    def test_wrong_number_of_fields_names_the_line(self):
+        self.write("B-1;BR-1042;4\nB-2;BR-2000\n")
+        with self.assertRaisesRegex(ValueError, r":2: expected bin;sku;qty"):
+            read_scanner_file(self.path)
+
+    def test_non_numeric_quantity_names_the_line(self):
+        self.write("B-1;BR-1042;four\n")
+        with self.assertRaisesRegex(ValueError, r":1: quantity 'four' is not a whole number"):
+            read_scanner_file(self.path)
+
+    def test_negative_quantity_is_rejected(self):
+        self.write("B-1;BR-1042;-2\n")
+        with self.assertRaisesRegex(ValueError, r":1: quantity cannot be negative"):
+            read_scanner_file(self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
