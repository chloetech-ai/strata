@@ -0,0 +1,66 @@
+import datetime
+import unittest
+
+from stockroom import Inventory, Movement
+from stockroom.valuation import stock_value
+
+D1 = datetime.date(2026, 9, 1)
+D2 = datetime.date(2026, 9, 5)
+D3 = datetime.date(2026, 9, 9)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_nothing_received_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt_is_qty_times_unit_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 250, date=D1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 2500)
+
+    def test_sales_take_the_oldest_stock_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=D1)
+        inv.receive("BR-1042", 10, 300, date=D2)
+        inv.issue("BR-1042", 15, date=D3)  # 10 at 100, then 5 at 300
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_a_sale_that_ends_inside_a_layer_leaves_the_rest_of_it(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=D1)
+        inv.issue("BR-1042", 4, date=D2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100)
+
+    def test_receipts_are_costed_by_date_not_by_logged_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 300, date=D2)
+        inv.receive("BR-1042", 10, 100, date=D1)  # logged later, received earlier
+        inv.issue("BR-1042", 10, date=D3)  # consumes the D1 layer at 100
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 300)
+
+    def test_negative_stock_adds_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, date=D1)
+        inv.issue("BR-1042", 8, date=D2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 50, date=D1)
+        self.assertEqual(stock_value(inv, " br-1042 "), 100)
+
+    def test_other_skus_are_not_counted(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 50, date=D1)
+        inv.receive("BR-2000", 9, 999, date=D1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 100)
+
+    def test_goods_in_without_a_unit_cost_cannot_be_valued(self):
+        inv = Inventory()
+        inv.movements.append(Movement(sku="BR-1042", qty=3, date=D1, reason="RETURN"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
