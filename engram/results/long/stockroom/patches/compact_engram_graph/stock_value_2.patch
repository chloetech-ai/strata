+"""What the stock on hand is worth, costed first in, first out (FIFO)."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Each goods-in movement opens a layer at its unit cost. Each goods-out
+    movement uses up the oldest layers first. Stock that was issued beyond
+    what the layers hold (negative stock) has no cost and adds nothing.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost], oldest first
+    # Stable sort: movements on the same day keep their logged order.
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{sku}: goods in on {m.date.isoformat()} have no unit cost")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
