@@ -0,0 +1,36 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input_gives_empty_dict(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share_of_value(self):
+        # Total 100. Running shares: 50% (A), 75% (A), 90% (B), 97% (C), 100% (C).
+        values = {"BR-1": 50, "BR-2": 25, "BR-3": 15, "BR-4": 7, "BR-5": 3}
+        self.assertEqual(abc_classes(values), {
+            "BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C", "BR-5": "C",
+        })
+
+    def test_boundary_at_80_and_95_percent_is_inclusive(self):
+        # Running shares hit exactly 80% and 95%, which belong to A and B.
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "B", "BR-3": "C"})
+
+    def test_a_single_item_is_c_because_its_share_is_100_percent(self):
+        self.assertEqual(abc_classes({"BR-1": 10}), {"BR-1": "C"})
+
+    def test_input_order_does_not_matter(self):
+        values = {"BR-3": 15, "BR-1": 50, "BR-5": 3, "BR-2": 25, "BR-4": 7}
+        self.assertEqual(abc_classes(values)["BR-3"], "B")
+        self.assertEqual(abc_classes(values)["BR-4"], "C")
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
