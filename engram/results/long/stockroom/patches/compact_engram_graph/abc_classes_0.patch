+"""Stock analysis: ABC classification by annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are sorted by value,
+    highest first (ties broken by SKU). A SKU is 'A' if the cumulative share of
+    the grand total up to and including it is at most 80%, 'B' if at most 95%,
+    otherwise 'C'. Returns a dict mapping SKU to class.
+    """
+    for sku, value in values.items():
+        if value < 0:
+            raise ValueError(f"{sku}: consumption value cannot be negative")
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        # Compared by cross-multiplication, so no float rounding at the 80% and 95% edges.
+        if running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
