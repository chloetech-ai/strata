+"""The printable blind count sheet for the stock-take."""
+
+import re
+
+COUNT_WIDTH = 12  # the blank column people write their count in
+
+
+def bin_key(location, sku):
+    """Walking order: bins compare by their numbers, so B-9-1 comes before B-12-3."""
+    parts = []
+    for text in re.split(r"(\d+)", location):
+        if text.isdigit():
+            parts.append((0, int(text), ""))
+        elif text:
+            parts.append((1, 0, text))
+    return parts, sku
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin walking order.
+
+    Blind count: the system's on-hand quantity is deliberately left out, so the
+    last column is empty for the counter to write in.
+    """
+    if inventory.catalog is None:
+        raise ValueError("count sheet needs an inventory with a catalog")
+    items = sorted(inventory.catalog, key=lambda item: bin_key(item.location, item.sku))
+    lines = []
+    for item in items:
+        lines.append(
+            f"{item.location:<10}  {item.sku:<12}  {item.name:<32}  {item.unit:<5}  "
+            f"{'':<{COUNT_WIDTH}}"
+        )
+    return "\n".join(lines) + ("\n" if lines else "")
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
