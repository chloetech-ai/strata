+"""ABC analysis of stock by annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to 'A', 'B' or 'C' by its share of total annual value.
+
+    SKUs are sorted by value, highest first, and a running total is kept. A SKU
+    is 'A' while the cumulative share up to and including it is at most 80% of
+    the grand total, 'B' while it is at most 95%, and 'C' otherwise. When the
+    grand total is zero there is no share to measure, so every SKU is 'C'.
+    """
+    total = sum(values.values())
+    ordered = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ordered:
+        running += value
+        # Compare cross-multiplied so the percentage limits stay exact for integer values.
+        if total > 0 and running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif total > 0 and running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
