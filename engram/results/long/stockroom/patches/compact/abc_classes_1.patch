@@ -0,0 +1,31 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input_gives_empty_dict(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: A 50, B 30, C 15, D 5. Total 100.
+        # Running shares: 50%, 80%, 95%, 100%.
+        values = {"A": 50, "B": 30, "C": 15, "D": 5}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "A", "C": "B", "D": "C"})
+
+    def test_boundary_at_80_and_95_percent_is_inclusive(self):
+        # Running shares hit exactly 80% and 95%, then 100%.
+        values = {"X": 80, "Y": 15, "Z": 5}
+        self.assertEqual(abc_classes(values), {"X": "A", "Y": "B", "Z": "C"})
+
+    def test_input_order_does_not_matter(self):
+        values = {"D": 5, "C": 15, "B": 30, "A": 50}
+        self.assertEqual(abc_classes(values), {"A": "A", "B": "A", "C": "B", "D": "C"})
+
+    def test_negative_value_is_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1042": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
