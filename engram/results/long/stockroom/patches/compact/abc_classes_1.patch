@@ -0,0 +1,27 @@
+"""ABC analysis: classify SKUs by their share of annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to 'A', 'B' or 'C' by cumulative share of total value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest
+    value first. A SKU is 'A' if the running total, including itself, is at
+    most 80% of the grand total, 'B' if at most 95%, otherwise 'C'.
+    """
+    for sku, value in values.items():
+        if value < 0:
+            raise ValueError(f"negative consumption value for {sku}")
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda item: (-item[1], item[0]))
+
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.80 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
