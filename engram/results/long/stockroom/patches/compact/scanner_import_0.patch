index 0000000..1395e81
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,26 @@
+"""Import of the handheld scanner export: `bin;sku;qty`, one line per bin, no header."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Return the counted quantity per normalized SKU, summed across all bins.
+
+    A SKU can appear on several lines when part of it sits in an overflow bin.
+    """
+    totals = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty = fields
+            try:
+                count = int(qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity is not a whole number: {qty.strip()!r}")
+            sku = normalize_sku(sku)
+            totals[sku] = totals.get(sku, 0) + count
+    return totals
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
