index 0000000..919598a
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,36 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_sums_same_sku_across_bins(self):
+        totals = self.read("A-1-1;br-1042;12\nB-2-1;BR-1042 ;5\nA-1-2;BR-2000;7\n")
+        self.assertEqual(totals, {"BR-1042": 17, "BR-2000": 7})
+
+    def test_blank_lines_are_skipped(self):
+        self.assertEqual(self.read("\nA-1-1;BR-1042;3\n\n"), {"BR-1042": 3})
+
+    def test_empty_file_gives_empty_dict(self):
+        self.assertEqual(self.read(""), {})
+
+    def test_wrong_column_count_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self.read("A-1-1;BR-1042;3\nA-1-1;BR-1042\n")
+
+    def test_non_numeric_quantity_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, "line 1.*whole number"):
+            self.read("A-1-1;BR-1042;three\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
