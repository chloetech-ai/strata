@@ -28,6 +28,27 @@ class ReorderTest(unittest.TestCase):
     def test_enough_stock(self):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
+    def test_suggest_orders_fills_to_three_times_reorder_point(self):
+        self.assertEqual(suggest_orders(make_inventory()), {"BR-1": 25, "BR-2": 20})
+
+    def test_suggest_orders_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-4", "Hinge", "A-02-1", reorder_point=10, case_size=5)])
+        inv = Inventory(catalog)
+        inv.receive("BR-4", 8, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-4": 25})
+
+    def test_suggest_orders_covers_negative_stock(self):
+        catalog = Catalog([Item("BR-5", "Clip", "A-03-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.issue("BR-5", 2)
+        self.assertEqual(suggest_orders(inv), {"BR-5": 32})
+
+    def test_suggest_orders_empty_when_nothing_is_low(self):
+        catalog = Catalog([Item("BR-6", "Pin", "A-04-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-6", 50, 10)
+        self.assertEqual(suggest_orders(inv), {})
+
 
 if __name__ == "__main__":
     unittest.main()
