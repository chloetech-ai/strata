@@ -0,0 +1,28 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_at_the_80_and_95_percent_boundaries(self):
+        # Total 100. Running share: 50, 80 (exactly 80%), 95 (exactly 95%), 100.
+        values = {"BR-1": 50, "BR-2": 30, "BR-3": 15, "BR-4": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "C"},
+        )
+
+    def test_input_order_does_not_matter(self):
+        values = {"BR-4": 5, "BR-3": 15, "BR-2": 30, "BR-1": 50}
+        self.assertEqual(abc_classes(values)["BR-2"], "A")
+        self.assertEqual(abc_classes(values)["BR-4"], "C")
+
+    def test_single_sku_reaches_100_percent_so_is_c(self):
+        self.assertEqual(abc_classes({"BR-1": 42}), {"BR-1": "C"})
+
+
+if __name__ == "__main__":
+    unittest.main()
