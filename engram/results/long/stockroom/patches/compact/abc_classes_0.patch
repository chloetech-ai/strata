+"""Stock analysis."""
+
+
+def abc_classes(values):
+    """Classify SKUs A, B or C by cumulative share of annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest
+    value first; a SKU is 'A' while the cumulative share up to and including
+    it is at most 80% of the total, 'B' while at most 95%, otherwise 'C'.
+    """
+    if not values:
+        return {}
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda kv: (-kv[1], kv[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        if running <= 0.80 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
