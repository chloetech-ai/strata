+"""Printable stock-take count sheet: blind, in walking order by bin."""
+
+import re
+
+
+def _bin_key(location):
+    """Sort key for bin codes, so "B-2-1" comes before "B-12-3"."""
+    parts = re.split(r"(\d+)", location.upper())
+    return [(0, int(p), "") if p.isdigit() else (1, 0, p) for p in parts]
+
+
+def count_sheet(inventory):
+    """Blind count sheet as text, one line per catalog item, in bin order.
+
+    The system's on-hand quantity is deliberately left off: staff write
+    what they count in the empty column.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count from")
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    lines = [f"{'BIN':<10}  {'SKU':<12}  {'ITEM':<30}  {'UNIT':<5}  COUNTED"]
+    for item in items:
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  ____________")
+    return "\n".join(lines) + "\n"
