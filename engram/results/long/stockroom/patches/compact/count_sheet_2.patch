@@ -0,0 +1,43 @@
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def make_inventory(self):
+        catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8", "B-10-1"),
+            Item("BR-2000", "Wood screw 4x40", "B-2-1"),
+            Item("BR-0007", "Door hinge", "A-1-1"),
+        ])
+        return Inventory(catalog)
+
+    def test_one_line_per_catalog_item_after_header(self):
+        inv = self.make_inventory()
+        lines = count_sheet(inv).splitlines()
+        self.assertEqual(len(lines), 1 + len(inv.catalog))
+
+    def test_sorted_by_bin_location_numerically(self):
+        lines = count_sheet(self.make_inventory()).splitlines()[1:]
+        self.assertEqual([line.split()[0] for line in lines], ["A-1-1", "B-2-1", "B-10-1"])
+
+    def test_system_quantity_is_not_printed(self):
+        inv = self.make_inventory()
+        inv.receive("BR-1042", 9876, 12)
+        sheet = count_sheet(inv)
+        self.assertNotIn("9876", sheet)
+        self.assertNotIn("-9876", sheet)
+
+    def test_items_with_no_stock_are_listed(self):
+        lines = count_sheet(self.make_inventory()).splitlines()
+        self.assertTrue(any("BR-0007" in line and "Door hinge" in line for line in lines))
+
+    def test_requires_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
