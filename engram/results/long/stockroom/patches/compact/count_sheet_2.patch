@@ -0,0 +1,32 @@
+"""The blind count sheet: what to count and where, without what the system thinks is there."""
+
+import re
+
+
+HEADER = f"{'BIN':<10}  {'SKU':<10}  {'ITEM':<30}  COUNTED"
+
+
+def count_sheet(inventory):
+    """Text sheet with one line per catalog item, sorted by bin location.
+
+    The system quantity is deliberately left out; the COUNTED column is blank
+    for whoever is doing the count to fill in.
+    """
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog")
+    items = sorted(inventory.catalog, key=lambda item: (_location_key(item.location), item.sku))
+    lines = [HEADER.rstrip()]
+    for item in items:
+        lines.append(f"{item.location:<10}  {item.sku:<10}  {item.name:<30}".rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def _location_key(location):
+    """Sort key that orders digit runs by value, so B-2-1 comes before B-10-1."""
+    key = []
+    for part in re.split(r"(\d+)", location):
+        if part.isdigit():
+            key.append((0, int(part), ""))
+        elif part:
+            key.append((1, 0, part))
+    return key
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
