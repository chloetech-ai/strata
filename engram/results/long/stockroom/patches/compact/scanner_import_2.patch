+"""Import the handheld scanner export: `bin;sku;qty` per line, no header."""
+
+import csv
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per normalized SKU, summed across all bins.
+
+    A SKU may appear on several lines when part of it sits in an overflow bin.
+    """
+    counts = {}
+    with open(path, newline="", encoding="utf-8") as f:
+        for lineno, row in enumerate(csv.reader(f, delimiter=";"), start=1):
+            if not row or all(not field.strip() for field in row):
+                continue
+            if len(row) != 3:
+                raise ValueError(f"line {lineno}: expected bin;sku;qty, got {len(row)} fields")
+            _, sku, qty = row
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"line {lineno}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"line {lineno}: quantity must be a whole number, got {qty.strip()!r}")
+            if qty < 0:
+                raise ValueError(f"line {lineno}: counted quantity cannot be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
