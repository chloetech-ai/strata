+++ b/tests/test_scanner.py
@@ -0,0 +1,50 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "scan.txt")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_sums_same_sku_across_bins(self):
+        counts = self.read("B-12-3;br-1042;40\nC-01-1;BR-2000;7\nB-12-4;BR-1042;15\n")
+        self.assertEqual(counts, {"BR-1042": 55, "BR-2000": 7})
+
+    def test_no_header_first_line_is_data(self):
+        self.assertEqual(self.read("B-12-3;BR-1042;4\n"), {"BR-1042": 4})
+
+    def test_skips_blank_lines_and_trims_fields(self):
+        self.assertEqual(self.read("\n B-1 ; br-1042 ; 3 \n\n"), {"BR-1042": 3})
+
+    def test_zero_count_is_kept(self):
+        self.assertEqual(self.read("B-1;BR-1042;0\n"), {"BR-1042": 0})
+
+    def test_empty_file_gives_empty_dict(self):
+        self.assertEqual(self.read(""), {})
+
+    def test_wrong_field_count_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, "line 2: expected bin;sku;qty"):
+            self.read("B-1;BR-1042;3\nB-1;BR-1042\n")
+
+    def test_non_numeric_quantity_names_the_line(self):
+        with self.assertRaisesRegex(ValueError, "line 1: quantity must be a whole number"):
+            self.read("B-1;BR-1042;three\n")
+
+    def test_negative_quantity_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1: counted quantity cannot be negative"):
+            self.read("B-1;BR-1042;-2\n")
+
+    def test_empty_sku_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1: empty SKU"):
+            self.read("B-1; ;3\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
