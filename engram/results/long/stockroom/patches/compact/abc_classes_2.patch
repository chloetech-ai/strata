+"""ABC analysis: classify SKUs by their share of annual consumption value."""
+
+A_LIMIT = 0.80
+B_LIMIT = 0.95
+
+
+def abc_classes(values):
+    """Map each SKU in `values` (SKU -> annual consumption value) to 'A', 'B' or 'C'.
+
+    SKUs are taken highest value first. A SKU is 'A' while the cumulative share
+    up to and including it is at most 80% of the total, 'B' up to 95%, and 'C'
+    after that.
+    """
+    if not values:
+        return {}
+    if any(v < 0 for v in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    if total <= 0:
+        raise ValueError("total consumption must be positive")
+
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda item: (-item[1], item[0])):
+        running += value
+        share = running / total
+        if share <= A_LIMIT:
+            classes[sku] = "A"
+        elif share <= B_LIMIT:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
