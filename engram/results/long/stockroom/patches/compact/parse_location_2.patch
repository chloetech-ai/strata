@@ -1,13 +1,30 @@
 """The item catalog."""
 
+import re
 from dataclasses import dataclass
 
+# Only ASCII letters and digits, so no Unicode lookalikes sneak in.
+_LOCATION = re.compile(r"([A-Za-z])-([0-9]+)-([0-9]+)")
+
 
 def normalize_sku(sku):
     """Canonical form of a SKU: surrounding whitespace trimmed, uppercased."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like 'B-12-3' into ('B', 12, 3).
+
+    The aisle is one letter (returned uppercase); bay and shelf are integers.
+    Surrounding whitespace is ignored. Anything else raises ValueError.
+    """
+    match = _LOCATION.fullmatch(code.strip())
+    if match is None:
+        raise ValueError(f"bad bin code {code!r}, expected aisle-bay-shelf like 'B-12-3'")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
