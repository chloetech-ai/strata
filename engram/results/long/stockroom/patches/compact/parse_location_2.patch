+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_aisle_accepted_lowercase_and_returned_uppercase(self):
+        self.assertEqual(parse_location("b-12-3"), ("B", 12, 3))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  B-12-3\t"), ("B", 12, 3))
+
+    def test_anything_else_rejected(self):
+        for code in ["", "B-12", "B-12-3-1", "BB-12-3", "1-12-3", "B-x-3",
+                     "B-12-", "B 12 3", "B-12.5-3", "B-+12-3", "B-١٢-3"]:
+            with self.assertRaises(ValueError, msg=code):
+                parse_location(code)
+
