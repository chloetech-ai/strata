+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_aisle_is_uppercased_and_whitespace_ignored(self):
+        self.assertEqual(parse_location(" b-12-3 "), ("B", 12, 3))
+
+    def test_malformed_codes_rejected(self):
+        for code in ["", "B-12", "B-12-3-4", "12-3-4", "BB-12-3", "1-12-3",
+                     "B-x-3", "B-12-", "B--3", "B-12-3.5", "B - 12 - 3", "B-+12-3",
+                     "B-١٢-3"]:
+            with self.assertRaises(ValueError, msg=repr(code)):
+                parse_location(code)
+
