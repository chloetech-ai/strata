diff --git a/src/stockroom/items.py b/src/stockroom/items.py
index 82be29b..ea1789f 100644
--- a/src/stockroom/items.py
+++ b/src/stockroom/items.py
@@ -1,13 +1,29 @@
 """The item catalog."""
 
+import re
 from dataclasses import dataclass
 
+_LOCATION = re.compile(r"([A-Za-z])-([0-9]+)-([0-9]+)", re.ASCII)
+
 
 def normalize_sku(sku):
     """Canonical form of a SKU: surrounding whitespace trimmed, uppercased."""
     return sku.strip().upper()
 
 
+def parse_location(code):
+    """Split a bin code like "B-12-3" into ("B", 12, 3).
+
+    The aisle is a single letter, returned uppercase. Bay and shelf are whole
+    numbers. Surrounding whitespace is ignored; anything else raises ValueError.
+    """
+    match = _LOCATION.fullmatch(code.strip())
+    if match is None:
+        raise ValueError(f"bin code must look like 'B-12-3', got {code!r}")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
