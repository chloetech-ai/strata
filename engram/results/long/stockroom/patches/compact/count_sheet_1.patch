+"""The blind count sheet for the stock-take.
+
+The sheet shows where each item is and an empty column to write the count in.
+It never prints the quantity the system expects, so counters count what is there.
+"""
+
+import re
+
+
+def count_sheet(inventory):
+    """Text sheet with one line per catalog item, sorted by bin location."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to count")
+    items = sorted(inventory.catalog, key=lambda item: (_location_key(item.location), item.sku))
+    lines = [f"{'BIN':<10}  {'SKU':<12}  {'ITEM':<30}  {'UNIT':<6}  COUNTED"]
+    for item in items:
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<6}  __________")
+    return "\n".join(lines) + "\n"
+
+
+def _location_key(location):
+    """Sort key so that B-2-1 comes before B-10-1: digit runs compare as numbers."""
+    parts = re.split(r"(\d+)", location.upper())
+    return [(0, int(part), "") if part.isdigit() else (1, 0, part) for part in parts if part]
