+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+
+class CountSheetTest(unittest.TestCase):
+    def setUp(self):
+        self.catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8", "B-10-1", unit="pcs"),
+            Item("BR-2000", "Copper pipe 15mm", "A-2-3", unit="m"),
+            Item("BR-3000", "Wood screw", "B-2-1", unit="box"),
+        ])
+
+    def lines(self, inventory):
+        return count_sheet(inventory).splitlines()
+
+    def test_one_line_per_item_after_header(self):
+        lines = self.lines(Inventory(self.catalog))
+        self.assertEqual(len(lines), 1 + len(self.catalog))
+
+    def test_sorted_by_bin_location_numerically(self):
+        lines = self.lines(Inventory(self.catalog))
+        skus = [line.split()[1] for line in lines[1:]]
+        self.assertEqual(skus, ["BR-2000", "BR-3000", "BR-1042"])
+
+    def test_does_not_print_expected_quantity(self):
+        inv = Inventory(self.catalog)
+        inv.receive("BR-1042", 7777, 12)
+        self.assertNotIn("7777", count_sheet(inv))
+
+    def test_counted_column_is_blank_to_write_on(self):
+        lines = self.lines(Inventory(self.catalog))
+        self.assertTrue(lines[0].endswith("COUNTED"))
+        self.assertTrue(all(line.endswith("__________") for line in lines[1:]))
+
+    def test_no_catalog_is_error(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
