+++ b/tests/test_valuation.py
@@ -0,0 +1,74 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+
+D = datetime.date
+
+
+class StockValueTest(unittest.TestCase):
+    def test_empty_is_zero(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 250, date=D(2026, 1, 5))
+        self.assertEqual(stock_value(inv, "br-1042"), 2500)
+
+    def test_sale_takes_oldest_cost_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=D(2026, 1, 1))
+        inv.receive("BR-1042", 10, 300, date=D(2026, 2, 1))
+        inv.issue("BR-1042", 15, date=D(2026, 3, 1))
+        # The first layer (10 at 100) is used up; 5 of the second (at 300) go.
+        self.assertEqual(inv.on_hand("BR-1042"), 5)
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 300)
+
+    def test_value_is_fifo_not_average(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=D(2026, 1, 1))
+        inv.receive("BR-1042", 10, 300, date=D(2026, 2, 1))
+        inv.issue("BR-1042", 5, date=D(2026, 3, 1))
+        # Average cost would give 15 * 200 = 3000; FIFO gives 5*100 + 10*300.
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 100 + 10 * 300)
+
+    def test_receipts_are_costed_by_date_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 300, date=D(2026, 2, 1))
+        inv.receive("BR-1042", 10, 100, date=D(2026, 1, 1))
+        inv.issue("BR-1042", 10, date=D(2026, 3, 1))
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 300)
+
+    def test_sale_before_receipt_is_covered_by_it(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, date=D(2026, 1, 1))
+        inv.issue("BR-1042", 8, date=D(2026, 1, 2))
+        inv.receive("BR-1042", 10, 120, date=D(2026, 1, 3))
+        # The 3 units sold past zero are covered by the new receipt.
+        self.assertEqual(inv.on_hand("BR-1042"), 7)
+        self.assertEqual(stock_value(inv, "BR-1042"), 7 * 120)
+
+    def test_negative_stock_is_worth_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 2, 100, date=D(2026, 1, 1))
+        inv.issue("BR-1042", 5, date=D(2026, 1, 2))
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_other_skus_are_ignored(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100)
+        inv.receive("BR-2000", 4, 999)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_positive_movement_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv._record(Movement("BR-1042", 3, D(2026, 1, 1), "COUNT"))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
