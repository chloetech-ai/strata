@@ -0,0 +1,36 @@
+"""What the stock on hand is worth, costed FIFO (oldest receipt first)."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Positive movements add layers of (qty, unit_cost). Negative movements
+    consume the oldest layers first. A sale that outruns the layers is kept
+    as a deficit, which the next receipts cover before adding new layers,
+    so the value always matches on_hand: negative stock is valued at zero.
+    """
+    layers = deque()  # [qty, unit_cost] pairs, oldest at the left
+    deficit = 0
+    movements = sorted(inventory.movements_for(sku), key=lambda m: m.date)
+    for m in movements:
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"no unit cost on {m.reason} movement of {m.qty} for {m.sku}")
+            qty = m.qty
+            covered = min(deficit, qty)
+            deficit -= covered
+            qty -= covered
+            if qty:
+                layers.append([qty, m.unit_cost])
+        else:
+            need = -m.qty
+            while need and layers:
+                take = min(need, layers[0][0])
+                layers[0][0] -= take
+                need -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            deficit += need
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
