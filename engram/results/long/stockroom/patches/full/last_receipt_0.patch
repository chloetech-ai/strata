+class LastReceiptTest(unittest.TestCase):
+    def test_none_when_no_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.issue("BR-1042", 1, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+
+    def test_latest_receipt_by_date(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, datetime.date(2026, 9, 5))
+        inv.receive("BR-1042", 20, 13, datetime.date(2026, 9, 1))
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 10)
+
+    def test_tie_goes_to_last_logged(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.receive("BR-1042", 20, 13, DAY)
+        self.assertEqual(inv.last_receipt("BR-1042").qty, 20)
+
+    def test_ignores_other_reasons_and_skus(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        inv.issue("BR-1042", 3, datetime.date(2026, 9, 9))
+        inv.receive("BR-2210", 5, 30, datetime.date(2026, 9, 9))
+        self.assertEqual(inv.last_receipt(" br-1042").qty, 10)
+
