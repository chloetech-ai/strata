@@ -0,0 +1,29 @@
+"""Reading the handheld scanners' count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a `bin;sku;qty` export with no header line.
+
+    A SKU may appear on several lines (for example when some of it sits in an
+    overflow bin); its quantities are added together.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _bin, sku, qty = fields
+            try:
+                quantity = int(qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity is not a whole number: {qty!r}") from None
+            if quantity < 0:
+                raise ValueError(f"line {number}: quantity must not be negative, got {quantity}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + quantity
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
