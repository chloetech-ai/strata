+"""Printable blind count sheet for the stock-take.
+
+Lines are in walking order (by bin location) and the sheet never shows the
+quantity on hand, so people have to count rather than copy the system figure.
+"""
+
+HEADER = ("Bin", "SKU", "Description", "Unit", "Counted")
+WRITE_IN = "__________"
+
+
+def _bin_key(location):
+    # Compare bin codes part by part, numbers as numbers, so B-9-1 sorts before B-12-3.
+    return tuple((0, int(part)) if part.isdigit() else (1, part) for part in location.split("-"))
+
+
+def count_sheet(inventory):
+    """The blind count sheet for every catalog item, as text."""
+    if inventory.catalog is None:
+        raise ValueError("count sheet needs an inventory with a catalog")
+    items = sorted(inventory.catalog, key=lambda item: (_bin_key(item.location), item.sku))
+    rows = [HEADER] + [(item.location, item.sku, item.name, item.unit, WRITE_IN) for item in items]
+    widths = [max(len(row[col]) for row in rows) for col in range(len(HEADER) - 1)]
+    lines = []
+    for row in rows:
+        cells = [cell.ljust(width) for cell, width in zip(row, widths)] + [row[-1]]
+        lines.append("  ".join(cells).rstrip())
+    return "\n".join(lines) + "\n"
