+"""Stock analysis: ABC classification by annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs A, B or C by their share of total consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are ranked highest
+    value first; a SKU is 'A' while the cumulative share up to and including
+    it is at most 80% of the total, 'B' up to 95%, and 'C' after that.
+    SKUs with no value at all are 'C'.
+    """
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda pair: (-pair[1], pair[0])):
+        running += value
+        if total == 0:
+            classes[sku] = "C"
+        elif running <= 0.80 * total:
+            classes[sku] = "A"
+        elif running <= 0.95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
