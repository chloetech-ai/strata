         self.assertEqual(inv.movements[0].sku, "BR-1042")
         self.assertEqual(len(inv.movements_for(" BR-1042\t")), 2)
 
+    def test_last_receipt(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.receive("BR-1042", 10, 12, DAY)
+        later = inv.receive("BR-1042", 5, 13, DAY + datetime.timedelta(days=3))
+        inv.receive("BR-1042", 4, 14, DAY + datetime.timedelta(days=1))
+        inv.issue("BR-1042", 2, DAY + datetime.timedelta(days=9))
+        self.assertIs(inv.last_receipt(" br-1042"), later)
+
+    def test_last_receipt_ties_go_to_later_logged(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("BR-1042", 5, 13, DAY)
+        self.assertIs(inv.last_receipt("BR-1042"), second)
