+"""ABC analysis of annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs A, B or C by cumulative share of annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest value
+    first, and each gets the class of the cumulative share up to and including
+    it: A at most 80% of the total, B at most 95%, otherwise C.
+    """
+    if any(value < 0 for value in values.values()):
+        raise ValueError("consumption values must not be negative")
+    total = sum(values.values())
+    classes = {}
+    running = 0
+    # Ties broken by SKU so the result doesn't depend on dict order.
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        running += value
+        # Compare by multiplying out rather than dividing, to keep the 80% and
+        # 95% boundaries exact.
+        if total == 0 or running * 100 > 95 * total:
+            classes[sku] = "C"
+        elif running * 100 <= 80 * total:
+            classes[sku] = "A"
+        else:
+            classes[sku] = "B"
+    return classes
