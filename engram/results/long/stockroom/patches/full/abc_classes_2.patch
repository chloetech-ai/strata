@@ -0,0 +1,29 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_classes_by_cumulative_share(self):
+        # Sorted: BR-1 (80), BR-2 (15), BR-3 (5); total 100.
+        # Cumulative: 80% (A, boundary included), 95% (B, boundary included), 100% (C).
+        values = {"BR-3": 5, "BR-1": 80, "BR-2": 15}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "B", "BR-3": "C"})
+
+    def test_top_item_over_80_percent_is_b_not_a(self):
+        # Cumulative 90% for BR-1 is past the A cut-off, so it is B.
+        self.assertEqual(abc_classes({"BR-1": 90, "BR-2": 10}), {"BR-1": "B", "BR-2": "C"})
+
+    def test_zero_total_gives_c(self):
+        self.assertEqual(abc_classes({"BR-1": 0, "BR-2": 0}), {"BR-1": "C", "BR-2": "C"})
+
+    def test_negative_value_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
