+"""Stock valuation, FIFO: issues are costed against the oldest receipts first."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO."""
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost] still on hand, oldest first
+    deficit = 0  # units issued beyond the stock we had; they carry no cost
+    # sorted() is stable, so movements on the same day keep their log order
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"movement for {sku} on {m.date} has no unit cost")
+            qty = m.qty
+            # a deficit from earlier issues is made good by incoming stock first
+            covered = min(deficit, qty)
+            deficit -= covered
+            qty -= covered
+            if qty:
+                layers.append([qty, m.unit_cost])
+        else:
+            need = -m.qty
+            while need and layers:
+                take = min(need, layers[0][0])
+                layers[0][0] -= take
+                need -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+            deficit += need
+    return sum(qty * cost for qty, cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
