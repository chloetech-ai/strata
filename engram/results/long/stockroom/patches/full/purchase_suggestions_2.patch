diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..f93ff28 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,22 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Quantity to order for each SKU that needs reordering.
+
+    Orders up to three times the reorder point, rounded up to whole cases.
+    SKUs whose suggested quantity is zero (e.g. a zero reorder point) are left out.
+    """
+    orders = {}
+    for item in inventory.catalog:
+        on_hand = inventory.on_hand(item.sku)
+        if on_hand > item.reorder_point:
+            continue
+        shortfall = 3 * item.reorder_point - on_hand
+        cases = -(-shortfall // item.case_size)  # round up to whole cases
+        qty = cases * item.case_size
+        if qty > 0:
+            orders[item.sku] = qty
+    return orders
diff --git a/tests/test_reorder.py b/tests/test_reorder.py
index 62219cf..4ac3444 100644
--- a/tests/test_reorder.py
+++ b/tests/test_reorder.py
@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -29,5 +29,27 @@ class ReorderTest(unittest.TestCase):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
 
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        self.assertEqual(orders, {"BR-1": 25, "BR-2": 20})  # 30 - 5, 30 - 10
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 36})  # 25 short -> 3 cases
+
+    def test_negative_stock_orders_the_full_gap(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=6)])
+        inv = Inventory(catalog)
+        inv.issue("BR-1", 4)
+        self.assertEqual(suggest_orders(inv), {"BR-1": 36})  # 30 - (-4) = 34 short -> 6 cases of 6
+
+    def test_zero_reorder_point_gives_no_order(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=0)])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
+
+
 if __name__ == "__main__":
     unittest.main()
