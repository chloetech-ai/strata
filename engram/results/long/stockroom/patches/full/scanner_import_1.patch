index 0000000..10ec3eb
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,29 @@
+"""Reading the handheld scanners' count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a `bin;sku;qty` export.
+
+    The file has no header. A SKU can appear on several lines (for example
+    when some stock sits in an overflow bin), so its quantities are summed.
+    """
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"line {number}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _bin, sku, qty = fields
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"line {number}: quantity is not a whole number: {qty!r}") from None
+            if qty < 0:
+                raise ValueError(f"line {number}: quantity must not be negative, got {qty}")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..a8532e4
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,44 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ScannerTest(unittest.TestCase):
+    def read(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "count.txt")
+            with open(path, "w", encoding="utf-8", newline="") as f:
+                f.write(text)
+            return read_scanner_file(path)
+
+    def test_reads_bin_sku_qty(self):
+        self.assertEqual(self.read("A-01-1;BR-1042;12\nB-12-3;BR-2210;5\n"),
+                         {"BR-1042": 12, "BR-2210": 5})
+
+    def test_sums_sku_across_bins(self):
+        counts = self.read("A-01-1;BR-1042;12\nOVF-1;BR-1042;30\n")
+        self.assertEqual(counts, {"BR-1042": 42})
+
+    def test_normalizes_sku(self):
+        self.assertEqual(self.read("A-01-1; br-1042 ;3\nA-01-1;BR-1042;4\r\n"), {"BR-1042": 7})
+
+    def test_zero_count_kept_and_blank_lines_skipped(self):
+        self.assertEqual(self.read("A-01-1;BR-1042;0\n\n"), {"BR-1042": 0})
+
+    def test_malformed_line_reports_line_number(self):
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            self.read("A-01-1;BR-1042;12\nA-01-1;BR-2210\n")
+
+    def test_non_numeric_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("A-01-1;BR-1042;twelve\n")
+
+    def test_negative_quantity_rejected(self):
+        with self.assertRaisesRegex(ValueError, "line 1"):
+            self.read("A-01-1;BR-1042;-3\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
