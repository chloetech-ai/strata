+"""Printable blind count sheet for the stock-take.
+
+Lines are in walking order (by bin location). The sheet never shows the
+quantity on hand, so people have to count rather than copy the system figure.
+"""
+
+import re
+
+COUNT_WIDTH = 10
+
+
+def _walk_key(location):
+    """Sort bin codes naturally: "A-9-1" comes before "A-10-1"."""
+    parts = re.split(r"(\d+)", location)
+    return [(0, int(p)) if p.isdigit() else (1, p) for p in parts if p]
+
+
+def count_sheet(inventory):
+    items = sorted(inventory.catalog, key=lambda item: (_walk_key(item.location), item.sku))
+    header = ["Location", "SKU", "Name", "Unit", "Counted".ljust(COUNT_WIDTH)]
+    rows = [
+        [item.location, item.sku, item.name, item.unit, "_" * COUNT_WIDTH]
+        for item in items
+    ]
+    table = [header] + rows
+    widths = [max(len(row[i]) for row in table) for i in range(len(header))]
+    lines = [
+        "  ".join(cell.ljust(width) for cell, width in zip(row, widths)).rstrip()
+        for row in table
+    ]
+    return "\n".join(lines) + "\n"
diff --git a/tests/test_countsheet.py b/tests/test_countsheet.py
