+++ b/tests/test_countsheet.py
@@ -0,0 +1,50 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 9, 1)
+
+
+def make_inventory():
+    catalog = Catalog([
+        Item("BR-1042", "Hex bolt M8x40", "C-03-2", unit="pcs"),
+        Item("BR-2210", "Washer", "A-10-1", unit="pcs"),
+        Item("BR-3300", "Rivet", "A-9-4", unit="box"),
+    ])
+    inv = Inventory(catalog)
+    inv.receive("BR-1042", 737, 12, DAY)
+    inv.receive("BR-2210", 418, 3, DAY)
+    inv.receive("BR-3300", 52, 90, DAY)
+    inv.issue("BR-3300", 9, DAY)
+    return inv
+
+
+class CountSheetTest(unittest.TestCase):
+    def test_walking_order_by_location_not_sku(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        skus = [line.split()[1] for line in lines[1:]]
+        # A-9-4 before A-10-1 (numeric bay), then C-03-2
+        self.assertEqual(skus, ["BR-3300", "BR-2210", "BR-1042"])
+
+    def test_one_line_per_item_plus_header(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertEqual(len(lines), 1 + 3)
+        self.assertTrue(lines[0].startswith("Location"))
+
+    def test_has_blank_count_column(self):
+        lines = count_sheet(make_inventory()).splitlines()
+        self.assertIn("Counted", lines[0])
+        for line in lines[1:]:
+            self.assertTrue(line.endswith("_" * 10))
+
+    def test_never_shows_on_hand(self):
+        text = count_sheet(make_inventory())
+        for on_hand in ("737", "418", "43"):
+            self.assertNotIn(on_hand, text)
+
+
+if __name__ == "__main__":
+    unittest.main()
