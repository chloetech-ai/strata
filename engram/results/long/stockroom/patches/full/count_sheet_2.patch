+"""Printable blind count sheet for the stock-take.
+
+Lines are in walking order (by bin location), and the sheet deliberately
+leaves out the quantity on hand so that people count rather than copy it.
+"""
+
+
+def _walk_key(item):
+    # Compare bin codes like "B-12-3" part by part, numbers as numbers,
+    # so that B-2 comes before B-10.
+    parts = tuple((0, int(p), "") if p.isdigit() else (1, 0, p.upper())
+                  for p in item.location.split("-"))
+    return parts, item.sku
+
+
+def count_sheet(inventory):
+    if inventory.catalog is None:
+        raise ValueError("a count sheet needs a catalog")
+    items = sorted(inventory.catalog, key=_walk_key)
+    rows = [("Location", "SKU", "Description", "Unit")]
+    rows += [(item.location, item.sku, item.name, item.unit) for item in items]
+    widths = [max(len(row[col]) for row in rows) for col in range(4)]
+    lines = []
+    for index, row in enumerate(rows):
+        cells = "  ".join(value.ljust(width) for value, width in zip(row, widths))
+        counted = "Counted" if index == 0 else "__________"
+        lines.append(cells + "  " + counted)
+    return "\n".join(lines) + "\n"
