@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from stockroom.countsheet import count_sheet
+from stockroom.inventory import Inventory
+from stockroom.items import Catalog, Item
+
+DAY = datetime.date(2026, 12, 1)
+
+
+class CountSheetTest(unittest.TestCase):
+    def make_inventory(self):
+        catalog = Catalog([
+            Item("BR-1042", "Hex bolt M8x40", "B-10-1", unit="pcs"),
+            Item("BR-2210", "Washer M8", "B-2-4", unit="pcs"),
+            Item("BR-7", "Cable tie", "A-01-1", unit="pkt"),
+        ])
+        inv = Inventory(catalog)
+        inv.receive("BR-1042", 4711, 12, DAY)
+        inv.issue("BR-2210", 17, DAY)
+        return inv
+
+    def lines(self):
+        return count_sheet(self.make_inventory()).splitlines()
+
+    def test_one_line_per_item_plus_header(self):
+        self.assertEqual(len(self.lines()), 4)
+
+    def test_walking_order_by_location_not_sku(self):
+        body = self.lines()[1:]
+        skus = [line.split()[1] for line in body]
+        self.assertEqual(skus, ["BR-7", "BR-2210", "BR-1042"])
+
+    def test_no_on_hand_quantities_shown(self):
+        text = count_sheet(self.make_inventory())
+        self.assertNotIn("4711", text)
+        self.assertNotIn("-17", text)
+
+    def test_counted_column_is_blank_for_writing(self):
+        for line in self.lines()[1:]:
+            self.assertTrue(line.endswith("__________"))
+
+    def test_needs_a_catalog(self):
+        with self.assertRaises(ValueError):
+            count_sheet(Inventory())
+
+
+if __name__ == "__main__":
+    unittest.main()
