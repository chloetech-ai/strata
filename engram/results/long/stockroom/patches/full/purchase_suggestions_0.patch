+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        # BR-1 has 5 of a 10 reorder point: target 30, so 25 short.
+        # BR-2 has 10: target 30, so 20 short.
+        self.assertEqual(suggest_orders(make_inventory()), {"BR-1": 25, "BR-2": 20})
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 5, 10)
+        # 25 short of 30, so 3 cases of 12 = 36.
+        self.assertEqual(suggest_orders(inv), {"BR-1": 36})
+
+    def test_exact_case_multiple_is_not_padded(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10, case_size=5)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 10, 10)  # 10 on hand, at its reorder point: needs reorder
+        # Target 30, shortfall 20, which is exactly 4 cases of 5.
+        self.assertEqual(suggest_orders(inv), {"BR-1": 20})
+
+    def test_negative_stock_is_included(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=10)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1", 1, 10)
+        inv.issue("BR-1", 5)  # on hand -4
+        self.assertEqual(suggest_orders(inv), {"BR-1": 34})
+
+    def test_zero_reorder_point_at_zero_stock_orders_nothing(self):
+        catalog = Catalog([Item("BR-1", "Bolt", "A-01-1", reorder_point=0)])
+        inv = Inventory(catalog)
+        self.assertEqual(suggest_orders(inv), {})
+
+
 if __name__ == "__main__":
     unittest.main()
