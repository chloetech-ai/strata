diff --git a/src/stockroom/reorder.py b/src/stockroom/reorder.py
index 4672674..f11171d 100644
--- a/src/stockroom/reorder.py
+++ b/src/stockroom/reorder.py
@@ -8,3 +8,21 @@ def needs_reorder(inventory):
         if inventory.on_hand(item.sku) <= item.reorder_point:
             out.append(item.sku)
     return out
+
+
+def suggest_orders(inventory):
+    """Order quantity per SKU that needs reordering.
+
+    Orders up to three times the reorder point, rounded up to whole cases.
+    SKUs with nothing to order are left out.
+    """
+    reorder = set(needs_reorder(inventory))
+    orders = {}
+    for item in inventory.catalog:
+        if item.sku not in reorder:
+            continue
+        shortfall = 3 * item.reorder_point - inventory.on_hand(item.sku)
+        cases = -(-shortfall // item.case_size)  # ceiling division
+        if cases > 0:
+            orders[item.sku] = cases * item.case_size
+    return orders
