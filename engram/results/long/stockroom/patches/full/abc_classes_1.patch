@@ -0,0 +1,29 @@
+import unittest
+
+from stockroom.analysis import abc_classes
+
+
+class AbcClassesTest(unittest.TestCase):
+    def test_classes_by_cumulative_share(self):
+        # Total 100. Running shares: 50 (50%), 75 (75%), 90 (90%), 95 (95%), 100.
+        values = {"BR-1": 50, "BR-2": 25, "BR-3": 15, "BR-4": 5, "BR-5": 5}
+        self.assertEqual(
+            abc_classes(values),
+            {"BR-1": "A", "BR-2": "A", "BR-3": "B", "BR-4": "B", "BR-5": "C"},
+        )
+
+    def test_boundary_is_inclusive(self):
+        # Running share hits exactly 80% at BR-1 and 95% at BR-2.
+        values = {"BR-1": 80, "BR-2": 15, "BR-3": 5}
+        self.assertEqual(abc_classes(values), {"BR-1": "A", "BR-2": "B", "BR-3": "C"})
+
+    def test_empty_input(self):
+        self.assertEqual(abc_classes({}), {})
+
+    def test_negative_value_rejected(self):
+        with self.assertRaises(ValueError):
+            abc_classes({"BR-1": 10, "BR-2": -1})
+
+
+if __name__ == "__main__":
+    unittest.main()
