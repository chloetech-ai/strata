@@ -0,0 +1,62 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+D1 = datetime.date(2026, 9, 1)
+D2 = datetime.date(2026, 9, 2)
+D3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_nothing_on_hand_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 1250, D1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 12500)
+
+    def test_fifo_costs_issues_against_oldest_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, D1)
+        inv.receive("BR-1042", 10, 200, D2)
+        inv.issue("BR-1042", 15, D3)  # 10 @ 100 and 5 @ 200 leave; 5 @ 200 remain
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 200)
+
+    def test_partial_layer_keeps_remainder_at_its_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, D1)
+        inv.issue("BR-1042", 4, D2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 6 * 100)
+
+    def test_costs_differ_from_average(self):
+        # Average cost would value the 10 left at 150 each (1500); FIFO keeps them at 200.
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, D1)
+        inv.receive("BR-1042", 10, 200, D2)
+        inv.issue("BR-1042", 10, D3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 200)
+
+    def test_other_skus_do_not_count(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, D1)
+        inv.receive("BR-2210", 5, 999, D1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_negative_stock_is_worth_nothing_not_negative(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, D1)
+        inv.issue("BR-1042", 8, D2)
+        self.assertEqual(inv.on_hand("BR-1042"), -3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_sku_spelling_is_normalized(self):
+        inv = Inventory()
+        inv.receive(" br-1042", 10, 100, D1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+
+if __name__ == "__main__":
+    unittest.main()
