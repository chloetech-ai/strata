+"""Stock valuation, FIFO: issues are costed against the oldest receipts first."""
+
+from collections import deque
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand, costed FIFO.
+
+    Each receipt (a positive movement) opens a cost layer at its unit cost.
+    Each issue (a negative movement) consumes layers oldest first. Quantity
+    issued beyond the layers, which happens when stock goes negative, has no
+    cost layer to draw on and is not valued.
+    """
+    layers = deque()  # [qty, unit_cost in cents], oldest first
+    movements = sorted(inventory.movements_for(sku), key=lambda m: m.date)
+    for m in movements:
+        if m.qty > 0:
+            layers.append([m.qty, m.unit_cost or 0])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                layers.popleft()
+    return sum(qty * cost for qty, cost in layers)
