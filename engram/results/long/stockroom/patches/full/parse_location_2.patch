 """The item catalog."""
 
 from dataclasses import dataclass, replace
+import re
 
 
 def normalize_sku(sku):
@@ -8,6 +9,18 @@ def normalize_sku(sku):
     return sku.strip().upper()
 
 
+_LOCATION = re.compile(r"\s*([A-Za-z])-([0-9]+)-([0-9]+)\s*")
+
+
+def parse_location(code):
+    """Split a bin code like 'B-12-3' into ('B', 12, 3): aisle, bay, shelf."""
+    match = _LOCATION.fullmatch(code) if isinstance(code, str) else None
+    if match is None:
+        raise ValueError(f"not a bin code: {code!r}")
+    aisle, bay, shelf = match.groups()
+    return aisle.upper(), int(bay), int(shelf)
+
+
 @dataclass
 class Item:
     sku: str
