+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_accepts_lowercase_and_surrounding_whitespace(self):
+        self.assertEqual(parse_location(" b-12-3\t"), ("B", 12, 3))
+
+    def test_rejects_anything_else(self):
+        for code in ("", "B-12", "B-12-3-1", "BB-12-3", "1-12-3", "B-x-3", "B-12-", "B_12_3", "B-12.5-3", None, 123):
+            with self.assertRaises(ValueError, msg=repr(code)):
+                parse_location(code)
 
 
