@@ -2,7 +2,7 @@ import unittest
 
 from stockroom.inventory import Inventory
 from stockroom.items import Catalog, Item
-from stockroom.reorder import needs_reorder
+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -29,5 +29,31 @@ class ReorderTest(unittest.TestCase):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
 
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        orders = suggest_orders(make_inventory())
+        # BR-1: 5 on hand, target 30 -> 25 short, one case of 1 each.
+        # BR-2: 10 on hand, target 30 -> 20 short.
+        self.assertEqual(orders, {"BR-1": 25, "BR-2": 20})
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt", "C-03-2", reorder_point=10, case_size=6)])
+        inv = Inventory(catalog)
+        inv.receive("BR-1042", 5, 12)
+        # target 30, 25 short, 5 cases of 6 -> 30
+        self.assertEqual(suggest_orders(inv), {"BR-1042": 30})
+
+    def test_negative_stock_counts_as_shortfall(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt", "C-03-2", reorder_point=10, case_size=6)])
+        inv = Inventory(catalog)
+        inv.issue("BR-1042", 4)
+        # target 30, on hand -4 -> 34 short, 6 cases of 6 -> 36
+        self.assertEqual(suggest_orders(inv), {"BR-1042": 36})
+
+    def test_nothing_to_order_when_zero_reorder_point_and_no_stock(self):
+        catalog = Catalog([Item("BR-1042", "Hex bolt", "C-03-2", reorder_point=0)])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
+
+
 if __name__ == "__main__":
     unittest.main()
