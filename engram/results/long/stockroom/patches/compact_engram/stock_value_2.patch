@@ -0,0 +1,65 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+DAY1 = datetime.date(2026, 9, 1)
+DAY2 = datetime.date(2026, 9, 2)
+DAY3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_unknown_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt_is_qty_times_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 12, date=DAY1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 1200)
+
+    def test_sales_use_the_oldest_stock_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=DAY1)
+        inv.receive("BR-1042", 10, 200, date=DAY2)
+        inv.issue("BR-1042", 15, date=DAY3)
+        # 5 left, all from the second receipt.
+        self.assertEqual(stock_value(inv, "BR-1042"), 5 * 200)
+
+    def test_fifo_follows_movement_dates_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 200, date=DAY2)
+        inv.receive("BR-1042", 10, 100, date=DAY1)  # logged later, but older
+        inv.issue("BR-1042", 10, date=DAY3)
+        # The DAY1 receipt at 100 is used up; the DAY2 receipt at 200 remains.
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 200)
+
+    def test_sale_spanning_two_layers(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=DAY1)
+        inv.receive("BR-1042", 10, 300, date=DAY2)
+        inv.issue("BR-1042", 12, date=DAY3)
+        # 10 at 100 used up, 2 at 300 used; 8 left at 300.
+        self.assertEqual(stock_value(inv, "BR-1042"), 8 * 300)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("br-1042", 4, 25, date=DAY1)
+        self.assertEqual(stock_value(inv, " BR-1042"), 100)
+
+    def test_stock_gone_negative_is_worth_zero(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, date=DAY1)
+        inv.issue("BR-1042", 8, date=DAY2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_count_adjustment_without_cost_is_refused(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 100, date=DAY1)
+        inv.record("BR-1042", 2, "COUNT", date=DAY2)
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
