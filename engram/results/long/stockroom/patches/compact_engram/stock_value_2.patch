+"""What the stock on hand is worth, valued first in, first out."""
+
+from collections import deque
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Each positive movement opens a cost layer at its unit cost. Each negative
+    movement uses up the oldest layers first, by movement date. Stock that has
+    gone below zero has no layers left and is valued at zero.
+    """
+    sku = normalize_sku(sku)
+    layers = deque()  # [qty, unit_cost], oldest first
+    # sorted() is stable, so movements on the same day keep their log order.
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{sku} movement on {m.date} has no unit cost; cannot value it")
+            layers.append([m.qty, m.unit_cost])
+        else:
+            to_issue = -m.qty
+            while to_issue and layers:
+                take = min(to_issue, layers[0][0])
+                layers[0][0] -= take
+                to_issue -= take
+                if layers[0][0] == 0:
+                    layers.popleft()
+    return sum(qty * unit_cost for qty, unit_cost in layers)
