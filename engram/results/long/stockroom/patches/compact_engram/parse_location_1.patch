+class ParseLocationTest(unittest.TestCase):
+    def test_splits_bin_code(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_accepts_lowercase_aisle_and_surrounding_whitespace(self):
+        self.assertEqual(parse_location(" b-2-1 "), ("B", 2, 1))
+
+    def test_numbers_compare_as_numbers(self):
+        self.assertLess(parse_location("B-2-1")[1], parse_location("B-12-3")[1])
+
+    def test_rejects_anything_else(self):
+        for code in ("", "B-12", "B-12-3-4", "BB-12-3", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "B-12-3.5", "B-+12-3", "B-12-3 C", None):
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
+
