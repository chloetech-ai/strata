+"""The blind count sheet for the stock-take: one line per catalog item, in walking order."""
+
+
+def _bin_key(location):
+    """Sort key for a bin code "aisle-bay-shelf", comparing numeric parts as numbers."""
+    key = []
+    for part in location.split("-"):
+        if part.isdigit():
+            key.append((0, int(part), ""))
+        else:
+            key.append((1, 0, part))
+    return key
+
+
+def count_sheet(inventory):
+    """Printable count sheet as text. Never shows quantities on hand: counters must count, not copy."""
+    if inventory.catalog is None:
+        raise ValueError("count sheet needs an inventory with a catalog")
+    items = sorted(inventory.catalog, key=lambda item: _bin_key(item.location))
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<10}  {item.sku:<12}  {item.name:<30}  {item.unit:<5}  ________")
+    return "\n".join(lines) + "\n"
