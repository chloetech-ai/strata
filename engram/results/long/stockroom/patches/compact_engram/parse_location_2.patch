+class ParseLocationTest(unittest.TestCase):
+    def test_splits_aisle_bay_shelf(self):
+        self.assertEqual(parse_location("B-12-3"), ("B", 12, 3))
+
+    def test_lowercase_aisle_is_uppercased(self):
+        self.assertEqual(parse_location("c-03-2"), ("C", 3, 2))
+
+    def test_surrounding_whitespace_ignored(self):
+        self.assertEqual(parse_location("  A-1-1\t"), ("A", 1, 1))
+
+    def test_bad_codes_rejected(self):
+        for code in ("", "B-12", "B-12-3-4", "BB-1-1", "1-12-3", "B-x-3",
+                     "B--3", "B-12-", "B 12 3", "B-1.5-3", "B-+1-3", "B-12-3 extra"):
+            with self.subTest(code=code):
+                with self.assertRaises(ValueError):
+                    parse_location(code)
+
