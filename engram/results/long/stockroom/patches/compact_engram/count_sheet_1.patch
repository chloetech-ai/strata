+"""The blind count sheet for the stock-take: items in walking order, with no on-hand figures."""
+
+
+def _bin_key(location, sku):
+    """Sort key for a bin code like "B-12-3": numeric parts compare as numbers, so B-2-1 comes before B-12-3."""
+    parts = []
+    for part in location.split("-"):
+        if part.isdigit():
+            parts.append((0, int(part), ""))
+        else:
+            parts.append((1, 0, part))
+    return (parts, sku)
+
+
+def count_sheet(inventory):
+    """One line per catalog item, in bin order. The counted column is left blank: the sheet never shows on-hand."""
+    if inventory.catalog is None:
+        raise ValueError("inventory has no catalog to build a count sheet from")
+    items = sorted(inventory.catalog, key=lambda item: _bin_key(item.location, item.sku))
+    loc_w = max((len(item.location) for item in items), default=0)
+    sku_w = max((len(item.sku) for item in items), default=0)
+    name_w = max((len(item.name) for item in items), default=0)
+    unit_w = max((len(item.unit) for item in items), default=0)
+    lines = []
+    for item in items:
+        lines.append(f"{item.location:<{loc_w}}  {item.sku:<{sku_w}}  {item.name:<{name_w}}  "
+                     f"{item.unit:<{unit_w}}  {'_' * 8}")
+    return "\n".join(lines) + ("\n" if lines else "")
