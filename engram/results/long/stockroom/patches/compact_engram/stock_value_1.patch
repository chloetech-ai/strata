@@ -0,0 +1,70 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory
+from stockroom.valuation import stock_value
+
+D1 = datetime.date(2026, 9, 1)
+D2 = datetime.date(2026, 9, 2)
+D3 = datetime.date(2026, 9, 3)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_unknown_sku_is_worth_nothing(self):
+        self.assertEqual(stock_value(Inventory(), "BR-1042"), 0)
+
+    def test_single_receipt_is_qty_times_unit_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 1250, date=D1)
+        self.assertEqual(stock_value(inv, "BR-1042"), 125000)
+
+    def test_sale_takes_oldest_layer_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=D1)
+        inv.receive("BR-1042", 10, 200, date=D2)
+        inv.issue("BR-1042", 15, date=D3)
+        # 10 at 100 are gone; 5 left from the 200 layer.
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("br-1042", 4, 500, date=D1)
+        self.assertEqual(stock_value(inv, " BR-1042"), 2000)
+
+    def test_return_opens_a_layer_at_its_unit_cost(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 100, date=D1)
+        inv.record("BR-1042", 2, "RETURN", date=D2, unit_cost=300)
+        self.assertEqual(stock_value(inv, "BR-1042"), 10 * 100 + 2 * 300)
+
+    def test_back_dated_receipt_is_costed_before_later_stock(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 200, date=D2)
+        inv.receive("BR-1042", 5, 100, date=D1)  # logged later, but older
+        inv.issue("BR-1042", 5, date=D3)
+        # FIFO by date: the 100-cost receipt goes out, the 200-cost layer stays.
+        self.assertEqual(stock_value(inv, "BR-1042"), 1000)
+
+    def test_goods_out_beyond_stock_leave_nothing_to_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 3, 100, date=D1)
+        inv.issue("BR-1042", 5, date=D2)
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_stock_without_unit_cost_cannot_be_valued(self):
+        inv = Inventory()
+        inv.record("BR-1042", 4, "COUNT", date=D1)
+        with self.assertRaises(ValueError) as cm:
+            stock_value(inv, "BR-1042")
+        self.assertIn("BR-1042", str(cm.exception))
+
+    def test_costless_stock_that_has_gone_out_is_not_a_problem(self):
+        inv = Inventory()
+        inv.record("BR-1042", 4, "COUNT", date=D1)
+        inv.issue("BR-1042", 4, date=D2)
+        inv.receive("BR-1042", 1, 700, date=D3)
+        self.assertEqual(stock_value(inv, "BR-1042"), 700)
+
+
+if __name__ == "__main__":
+    unittest.main()
