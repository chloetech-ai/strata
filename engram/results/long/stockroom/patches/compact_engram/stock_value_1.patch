+"""What the stock on hand is worth, costed first in, first out (FIFO)."""
+
+from .items import normalize_sku
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand.
+
+    Goods in open cost layers at their unit cost. Goods out (sales, damage and so on)
+    take the oldest layers first. Movements are taken in date order, so a back-dated
+    receipt sits ahead of stock received later. Goods out beyond the layers (negative
+    stock) leave nothing to value. Raises ValueError if goods still on hand came in
+    without a unit cost, because their value is unknown.
+    """
+    layers = []  # [qty, unit_cost] pairs, oldest first; unit_cost is None when unknown
+    for m in sorted(inventory.movements_for(sku), key=lambda m: m.date):
+        if m.qty > 0:
+            layers.append([m.qty, m.unit_cost])
+            continue
+        remaining = -m.qty
+        while remaining and layers:
+            take = min(remaining, layers[0][0])
+            layers[0][0] -= take
+            remaining -= take
+            if layers[0][0] == 0:
+                del layers[0]
+    if any(unit_cost is None for _, unit_cost in layers):
+        raise ValueError(f"stock of {normalize_sku(sku)} came in without a unit cost; cannot value it")
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
