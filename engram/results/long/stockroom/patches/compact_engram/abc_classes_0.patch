+"""Stock analysis: ABC classification by annual consumption value."""
+
+
+def abc_classes(values):
+    """Classify SKUs as A, B or C by their share of total annual consumption value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest value
+    first; a SKU is 'A' while the running total, including it, is at most 80% of
+    the grand total, 'B' while it is at most 95%, and 'C' after that.
+    """
+    if not values:
+        return {}
+    if any(v < 0 for v in values.values()):
+        raise ValueError("annual consumption value must not be negative")
+    total = sum(values.values())
+    if total == 0:
+        raise ValueError("total annual consumption value must be positive")
+    # Compare running total to share of grand total by cross-multiplying, so no
+    # division or rounding is involved in the 80% and 95% boundaries.
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda pair: (-pair[1], pair[0])):
+        running += value
+        if running * 100 <= 80 * total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
