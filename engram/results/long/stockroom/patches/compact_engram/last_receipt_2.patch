+    def test_last_receipt_is_the_latest_receipt_for_the_sku(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 12, DAY)
+        second = inv.receive("br-1042", 5, 13, DAY)
+        inv.issue("BR-1042", 2, DAY)
+        inv.record("BR-1042", 1, "RETURN", DAY)
+        self.assertIs(inv.last_receipt(" BR-1042 "), second)
+
+    def test_last_receipt_is_none_without_receipts(self):
+        inv = Inventory()
+        self.assertIsNone(inv.last_receipt("BR-1042"))
+        inv.record("BR-1042", 3, "COUNT", DAY)
+        inv.receive("BR-2000", 4, 9, DAY)
+        self.assertIsNone(inv.last_receipt("BR-1042"))
