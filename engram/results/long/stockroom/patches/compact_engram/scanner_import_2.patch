+++ b/src/stockroom/scanner.py
@@ -0,0 +1,25 @@
+"""Reading the handheld scanners' count export: semicolon-separated, no header, columns bin;sku;qty."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU. A SKU on several lines (overflow bins) is added up."""
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path} line {number}: expected bin;sku;qty, got {line.strip()!r}")
+            _bin, sku, qty_text = fields
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError(f"{path} line {number}: quantity {qty_text.strip()!r} is not a whole number")
+            if qty < 0:
+                raise ValueError(f"{path} line {number}: counted quantity must not be negative")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
