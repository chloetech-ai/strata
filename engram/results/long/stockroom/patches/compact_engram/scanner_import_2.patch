index 0000000..db56e5f
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,53 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self._dir.name, "count.txt")
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def write(self, text):
+        with open(self.path, "w", encoding="utf-8") as f:
+            f.write(text)
+
+    def test_reads_bin_sku_qty_lines(self):
+        self.write("B-12-3;BR-1042;7\nA-1-1;BR-2000;0\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7, "BR-2000": 0})
+
+    def test_adds_up_a_sku_split_across_bins(self):
+        self.write("B-1-1;BR-1042;7\nOVERFLOW;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 12})
+
+    def test_normalizes_sku(self):
+        self.write("B-1-1;br-1042 ;3\nOVERFLOW;BR-1042;2\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 5})
+
+    def test_skips_blank_lines_and_handles_crlf(self):
+        self.write("B-1-1;BR-1042;4\r\n\r\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 4})
+
+    def test_wrong_field_count_names_the_line(self):
+        self.write("B-1-1;BR-1042;4\nB-1-2;BR-2000\n")
+        with self.assertRaisesRegex(ValueError, "line 2"):
+            read_scanner_file(self.path)
+
+    def test_non_numeric_quantity_names_the_line(self):
+        self.write("B-1-1;BR-1042;four\n")
+        with self.assertRaisesRegex(ValueError, "line 1.*four"):
+            read_scanner_file(self.path)
+
+    def test_negative_quantity_is_rejected(self):
+        self.write("B-1-1;BR-1042;-2\n")
+        with self.assertRaisesRegex(ValueError, "must not be negative"):
+            read_scanner_file(self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
