+from stockroom.reorder import needs_reorder, suggest_orders
 
 
 def make_inventory():
@@ -29,5 +29,33 @@ class ReorderTest(unittest.TestCase):
         self.assertNotIn("BR-3", needs_reorder(make_inventory()))
 
 
+class SuggestOrdersTest(unittest.TestCase):
+    def test_orders_up_to_three_times_reorder_point(self):
+        inv = make_inventory()  # BR-1 has 5 against a reorder point of 10
+        self.assertEqual(suggest_orders(inv)["BR-1"], 25)  # 30 - 5
+
+    def test_at_reorder_point_is_ordered(self):
+        self.assertEqual(suggest_orders(make_inventory())["BR-2"], 20)  # 30 - 10
+
+    def test_enough_stock_is_not_ordered(self):
+        self.assertNotIn("BR-3", suggest_orders(make_inventory()))
+
+    def test_rounds_up_to_whole_cases(self):
+        catalog = Catalog([Item("BR-9", "Screw", "A-02-1", reorder_point=10, case_size=12)])
+        inv = Inventory(catalog)
+        inv.receive("BR-9", 5, 10)
+        self.assertEqual(suggest_orders(inv)["BR-9"], 36)  # shortfall 25 -> 3 cases of 12
+
+    def test_negative_stock_counts_toward_the_order(self):
+        catalog = Catalog([Item("BR-9", "Screw", "A-02-1", reorder_point=4)])
+        inv = Inventory(catalog)
+        inv.issue("BR-9", 2)  # on hand -2
+        self.assertEqual(suggest_orders(inv)["BR-9"], 14)  # 12 - (-2)
+
+    def test_zero_reorder_point_with_no_stock_orders_nothing(self):
+        catalog = Catalog([Item("BR-9", "Screw", "A-02-1")])
+        self.assertEqual(suggest_orders(Inventory(catalog)), {})
+
+
 if __name__ == "__main__":
     unittest.main()
