@@ -0,0 +1,30 @@
+"""Value of stock on hand, costed first in, first out."""
+
+from .items import normalize_sku
+
+
+def _cost_layers(movements):
+    """Receipts still on the shelf after outgoing stock has taken the oldest first, as [qty, unit_cost]."""
+    layers = []
+    # Sorting is stable, so movements on the same day keep their log order.
+    for m in sorted(movements, key=lambda m: m.date):
+        if m.qty > 0:
+            if m.unit_cost is None:
+                raise ValueError(f"{m.reason} of {m.sku} on {m.date} has no unit cost")
+            layers.append([m.qty, m.unit_cost])
+            continue
+        left = -m.qty
+        while left and layers:
+            take = min(left, layers[0][0])
+            layers[0][0] -= take
+            left -= take
+            if layers[0][0] == 0:
+                layers.pop(0)
+        # Any left over means more went out than was ever received; there is no cost to take, so it adds nothing.
+    return layers
+
+
+def stock_value(inventory, sku):
+    """Value in cents of the stock of `sku` currently on hand."""
+    layers = _cost_layers(inventory.movements_for(normalize_sku(sku)))
+    return sum(qty * unit_cost for qty, unit_cost in layers)
diff --git a/tests/test_valuation.py b/tests/test_valuation.py
