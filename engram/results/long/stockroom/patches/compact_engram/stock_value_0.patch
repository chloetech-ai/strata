@@ -0,0 +1,79 @@
+import datetime
+import unittest
+
+from stockroom.inventory import Inventory, Movement
+from stockroom.valuation import stock_value
+
+JAN = datetime.date(2026, 1, 1)
+
+
+def day(n):
+    return JAN + datetime.timedelta(days=n)
+
+
+class StockValueTest(unittest.TestCase):
+    def test_single_receipt(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 12, date=day(0))
+        self.assertEqual(stock_value(inv, "BR-1042"), 1200)
+
+    def test_sale_takes_oldest_receipt_first(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 10, date=day(0))
+        inv.receive("BR-1042", 100, 12, date=day(4))
+        inv.issue("BR-1042", 150, date=day(9))
+        # 50 left, all from the second receipt at 12 cents.
+        self.assertEqual(stock_value(inv, "BR-1042"), 600)
+
+    def test_fifo_follows_dates_not_log_order(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 100, 12, date=day(4))  # logged first, but received later
+        inv.receive("BR-1042", 100, 10, date=day(0))
+        inv.issue("BR-1042", 150, date=day(9))
+        self.assertEqual(stock_value(inv, "BR-1042"), 600)
+
+    def test_damage_consumes_stock_like_a_sale(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 5, date=day(0))
+        inv.receive("BR-1042", 10, 7, date=day(1))
+        inv.record("BR-1042", -12, "DAMAGE", date=day(2))
+        # 8 left from the second receipt at 7 cents.
+        self.assertEqual(stock_value(inv, "BR-1042"), 56)
+
+    def test_return_adds_stock_at_the_cost_it_carries(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 5, date=day(0))
+        inv.record("BR-1042", 2, "RETURN", date=day(1), unit_cost=6)
+        self.assertEqual(stock_value(inv, "BR-1042"), 62)
+
+    def test_unknown_sku_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 5, date=day(0))
+        self.assertEqual(stock_value(inv, "BR-9999"), 0)
+
+    def test_sku_is_normalized(self):
+        inv = Inventory()
+        inv.receive("br-1042", 10, 5, date=day(0))
+        self.assertEqual(stock_value(inv, " BR-1042"), 50)
+
+    def test_sold_out_is_worth_nothing(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 10, 5, date=day(0))
+        inv.issue("BR-1042", 10, date=day(1))
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_more_out_than_in_adds_no_value(self):
+        inv = Inventory()
+        inv.receive("BR-1042", 5, 10, date=day(0))
+        inv.issue("BR-1042", 8, date=day(1))
+        self.assertEqual(stock_value(inv, "BR-1042"), 0)
+
+    def test_positive_movement_without_cost_is_an_error(self):
+        inv = Inventory()
+        inv.record("BR-1042", 3, "COUNT", date=day(0))
+        with self.assertRaises(ValueError):
+            stock_value(inv, "BR-1042")
+
+
+if __name__ == "__main__":
+    unittest.main()
