@@ -0,0 +1,33 @@
+"""Reading the handheld scanners' count export."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU from a scanner export.
+
+    The export is plain text, one line per bin and SKU, with no header line:
+    bin;sku;qty. A SKU can appear on several lines when part of it sits in an
+    overflow bin, so its quantities are added up.
+    """
+    counts = {}
+    # utf-8-sig drops a byte order mark if the scanner software writes one.
+    with open(path, encoding="utf-8-sig") as f:
+        for number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}:{number}: expected bin;sku;qty, got {line.strip()!r}")
+            _, sku, qty = fields
+            sku = normalize_sku(sku)
+            if not sku:
+                raise ValueError(f"{path}:{number}: empty SKU")
+            try:
+                qty = int(qty)
+            except ValueError:
+                raise ValueError(f"{path}:{number}: quantity is not a whole number: {qty!r}") from None
+            if qty < 0:
+                raise ValueError(f"{path}:{number}: quantity must not be negative, got {qty}")
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
new file mode 100644
index 0000000..8d931f9
--- /dev/null
+++ b/tests/test_scanner.py
@@ -0,0 +1,64 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self._dir.name, "count.txt")
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def write(self, text):
+        with open(self.path, "w", encoding="utf-8") as f:
+            f.write(text)
+
+    def test_reads_bin_sku_qty_lines(self):
+        self.write("B-12-3;BR-1042;7\nA-1-1;BR-2000;0\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7, "BR-2000": 0})
+
+    def test_adds_up_a_sku_split_over_bins(self):
+        self.write("B-1-1;BR-1042;7\nOVF-1-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 12})
+
+    def test_normalizes_sku_so_variants_are_added_together(self):
+        self.write("B-1-1;br-1042;7\nOVF-1-1; BR-1042 ;5\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 12})
+
+    def test_skips_blank_lines_and_handles_crlf(self):
+        self.write("B-1-1;BR-1042;7\r\n\r\nB-1-2;BR-2000;3\r\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7, "BR-2000": 3})
+
+    def test_strips_byte_order_mark(self):
+        with open(self.path, "w", encoding="utf-8-sig") as f:
+            f.write("B-1-1;BR-1042;7\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7})
+
+    def test_wrong_column_count_names_the_line(self):
+        self.write("B-1-1;BR-1042;7\nB-1-2;BR-2000\n")
+        with self.assertRaises(ValueError) as cm:
+            read_scanner_file(self.path)
+        self.assertIn(":2:", str(cm.exception))
+
+    def test_non_numeric_quantity_is_rejected(self):
+        self.write("B-1-1;BR-1042;seven\n")
+        with self.assertRaisesRegex(ValueError, "not a whole number"):
+            read_scanner_file(self.path)
+
+    def test_negative_quantity_is_rejected(self):
+        self.write("B-1-1;BR-1042;-3\n")
+        with self.assertRaisesRegex(ValueError, "must not be negative"):
+            read_scanner_file(self.path)
+
+    def test_empty_sku_is_rejected(self):
+        self.write("B-1-1;  ;3\n")
+        with self.assertRaisesRegex(ValueError, "empty SKU"):
+            read_scanner_file(self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
