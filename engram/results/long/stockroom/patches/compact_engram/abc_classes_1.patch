+"""ABC analysis of stock by annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to 'A', 'B' or 'C' by its share of the total value.
+
+    SKUs are taken highest value first. A SKU is 'A' while the cumulative share,
+    including itself, is at most 80% of the total, 'B' while it is at most 95%,
+    and 'C' after that. Ties are ordered by SKU so the result is repeatable.
+    """
+    for sku, value in values.items():
+        if value < 0:
+            raise ValueError(f"annual value must not be negative: {sku} {value}")
+    total = sum(values.values())
+    ranked = sorted(values.items(), key=lambda pair: (-pair[1], pair[0]))
+    classes = {}
+    running = 0
+    for sku, value in ranked:
+        running += value
+        # Compare cross-multiplied so the 80% and 95% limits are exact, with no float division.
+        if running * 5 <= total * 4:
+            classes[sku] = "A"
+        elif running * 20 <= total * 19:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
