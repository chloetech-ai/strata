@@ -0,0 +1,25 @@
+"""ABC analysis: classify SKUs by share of annual consumption value."""
+
+
+def abc_classes(values):
+    """Map each SKU to 'A', 'B' or 'C' by its cumulative share of total value.
+
+    `values` maps SKU to annual consumption value. SKUs are taken highest value
+    first; a SKU is 'A' while the running total up to and including it is at most
+    80% of the grand total, 'B' up to 95%, and 'C' after that.
+    """
+    if not values:
+        return {}
+    grand_total = sum(values.values())
+    classes = {}
+    running = 0
+    for sku, value in sorted(values.items(), key=lambda kv: (-kv[1], kv[0])):
+        running += value
+        # Multiply instead of dividing so the 80% and 95% boundaries compare exactly.
+        if running * 100 <= 80 * grand_total:
+            classes[sku] = "A"
+        elif running * 100 <= 95 * grand_total:
+            classes[sku] = "B"
+        else:
+            classes[sku] = "C"
+    return classes
diff --git a/tests/test_analysis.py b/tests/test_analysis.py
