index 0000000..c013a46
--- /dev/null
+++ b/src/stockroom/scanner.py
@@ -0,0 +1,25 @@
+"""Reading the handheld scanners' export: semicolon-separated, no header, columns bin;sku;qty."""
+
+from .items import normalize_sku
+
+
+def read_scanner_file(path):
+    """Counted quantity per SKU, summed over all bins the SKU appears in."""
+    counts = {}
+    with open(path, encoding="utf-8") as f:
+        for number, line in enumerate(f, 1):
+            if not line.strip():
+                continue
+            fields = line.rstrip("\r\n").split(";")
+            if len(fields) != 3:
+                raise ValueError(f"{path}, line {number}: expected bin;sku;qty, got {line.rstrip()!r}")
+            _bin, sku, qty_text = fields
+            try:
+                qty = int(qty_text)
+            except ValueError:
+                raise ValueError(f"{path}, line {number}: quantity is not a whole number: {qty_text!r}")
+            if qty < 0:
+                raise ValueError(f"{path}, line {number}: counted quantity must not be negative")
+            sku = normalize_sku(sku)
+            counts[sku] = counts.get(sku, 0) + qty
+    return counts
diff --git a/tests/test_scanner.py b/tests/test_scanner.py
