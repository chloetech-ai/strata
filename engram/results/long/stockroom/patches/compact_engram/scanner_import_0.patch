+++ b/tests/test_scanner.py
@@ -0,0 +1,60 @@
+import os
+import tempfile
+import unittest
+
+from stockroom.scanner import read_scanner_file
+
+
+class ReadScannerFileTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self._dir.name, "count.txt")
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def write(self, text):
+        with open(self.path, "w", encoding="utf-8") as f:
+            f.write(text)
+
+    def test_reads_bin_sku_qty_lines(self):
+        self.write("B-12-3;BR-1042;7\nC-03-2;BR-2000;4\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7, "BR-2000": 4})
+
+    def test_sums_quantities_across_overflow_bins(self):
+        self.write("B-12-3;BR-1042;7\nOVF-1-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 12})
+
+    def test_normalizes_sku(self):
+        self.write("B-12-3; br-1042 ;7\nOVF-1-1;BR-1042;5\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 12})
+
+    def test_skips_blank_lines_and_handles_crlf(self):
+        self.write("B-12-3;BR-1042;7\r\n\r\nC-03-2;BR-2000;4\r\n")
+        self.assertEqual(read_scanner_file(self.path), {"BR-1042": 7, "BR-2000": 4})
+
+    def test_empty_file_gives_no_counts(self):
+        self.write("")
+        self.assertEqual(read_scanner_file(self.path), {})
+
+    def test_wrong_field_count_names_the_line(self):
+        self.write("B-12-3;BR-1042;7\nB-12-3;BR-2000\n")
+        with self.assertRaises(ValueError) as ctx:
+            read_scanner_file(self.path)
+        self.assertIn("line 2", str(ctx.exception))
+
+    def test_non_numeric_quantity_names_the_line(self):
+        self.write("B-12-3;BR-1042;seven\n")
+        with self.assertRaises(ValueError) as ctx:
+            read_scanner_file(self.path)
+        self.assertIn("line 1", str(ctx.exception))
+        self.assertIn("seven", str(ctx.exception))
+
+    def test_negative_quantity_rejected(self):
+        self.write("B-12-3;BR-1042;-2\n")
+        with self.assertRaises(ValueError):
+            read_scanner_file(self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
