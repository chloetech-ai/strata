{
  "name": "more-cases",
  "description": "The same five personas on six more jobs people bring to a database: loading a CSV, a search that forgives typos, the best per category, cancelling stale orders, a join for top customers, and a count found in the command center.",
  "seeds": 3,
  "models": [
    "haiku",
    "haiku",
    "sonnet"
  ],
  "budget_usd": 14,
  "concurrency": 4,
  "personas": [
    {
      "id": "dev-postgres",
      "name": "Maya Chen",
      "role": "a backend developer who has used PostgreSQL every day for eight years",
      "device": "desktop",
      "background": "Maya is trying ChloeDB for a new service and judges it against Postgres.",
      "traits": [
        "Writes SQL fluently and reaches for Postgres habits first (SERIAL, ILIKE, NOW() - INTERVAL '7 days', \\d to describe a table).",
        "Reads error messages carefully and expects them to say what to change.",
        "Opens the documentation after two failed attempts, not before.",
        "Patient for about fifteen minutes, then decides the product is not ready."
      ]
    },
    {
      "id": "analyst",
      "name": "Tom\u00e1s Rivera",
      "role": "a data analyst who writes reporting SQL",
      "device": "desktop",
      "background": "Tom\u00e1s builds weekly reports. He has never used a search engine's query language.",
      "traits": [
        "Comfortable with SELECT, WHERE, GROUP BY and dates; has never heard of BM25 or full-text ranking.",
        "Likes to look at a table's columns and a few rows before writing a query.",
        "Copies examples from documentation when he finds one.",
        "Gives up after about five failed attempts and says what blocked him."
      ]
    },
    {
      "id": "ml-engineer",
      "name": "Priya Nair",
      "role": "a machine learning engineer building retrieval for a chatbot",
      "device": "desktop",
      "background": "Priya wants to know quickly whether ChloeDB can be her retrieval layer.",
      "traits": [
        "Thinks in embeddings, vector search and hybrid ranking; knows BM25 by name.",
        "Skims text and jumps to whatever looks like an API or a query box.",
        "Impatient with forms and wizards; prefers typing a query.",
        "Will judge the whole product on the first thing that confuses her."
      ]
    },
    {
      "id": "sre",
      "name": "Jordan Okafor",
      "role": "the on-call site reliability engineer for the team's databases",
      "device": "desktop",
      "background": "Jordan looks after production access and incidents.",
      "traits": [
        "Looks for admin, access and settings pages first.",
        "Cares about least privilege: read-only means read-only, keys should expire.",
        "Reads labels literally and distrusts anything ambiguous about permissions.",
        "Efficient: does not explore beyond what the task needs."
      ]
    },
    {
      "id": "pm",
      "name": "Sam Lee",
      "role": "a product manager who does not write SQL",
      "device": "phone",
      "background": "Sam checks things on a phone between meetings and wants answers, not queries.",
      "traits": [
        "Does not write SQL; will copy and edit an example if one is in front of them.",
        "Relies on labels, menus and search boxes; jargon (shards, segments, BM25) confuses Sam.",
        "Uses a phone, so wide tables and small buttons are a problem.",
        "Gives up after three or four dead ends and says why."
      ]
    }
  ],
  "tasks": [
    {
      "id": "load-a-csv",
      "title": "Load a CSV and ask about it",
      "surface": "mcp",
      "scope": "admin",
      "max_steps": 24,
      "personas": [
        "dev-postgres",
        "analyst",
        "pm"
      ],
      "prompt": "Our store's product list is in this CSV. Put it in ChloeDB as a table called gear, then tell me how many of the products cost more than $50 and are in stock.\n\nsku,name,category,price,in_stock\ns-01,Trail Running Shoes,shoes,120,true\ns-02,Road Running Shoes,shoes,95,true\ns-03,Hiking Boots,shoes,160,false\ns-04,Rain Jacket,outerwear,85,true\ns-05,Down Jacket,outerwear,210,true\ns-06,Fleece Pullover,outerwear,49.5,true\ns-07,Running Socks (3 pack),accessories,18,true\ns-08,Headlamp,accessories,35,false\ns-09,Water Bottle,accessories,22,true\ns-10,Trekking Poles,accessories,64,true\ns-11,Base Layer Top,outerwear,55,true\ns-12,Sandals,shoes,45,true",
      "fixture": {
        "tables": []
      },
      "checks": [
        {
          "name": "all rows loaded",
          "kind": "sql",
          "sql": "SELECT COUNT(*) AS n FROM gear",
          "expect": {
            "n": 12
          }
        },
        {
          "name": "the count",
          "kind": "answer_includes",
          "all": [
            "6"
          ]
        }
      ]
    },
