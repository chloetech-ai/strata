    {
      "id": "cancel-stale",
      "title": "Cancel stale orders",
      "surface": "mcp",
      "scope": "write",
      "max_steps": 20,
      "personas": [
        "dev-postgres",
        "sre",
        "analyst"
      ],
      "prompt": "Any order that's still 'placed' and was created more than 30 days ago is stale. Mark all of those as 'cancelled' and tell me how many you changed. Don't touch anything else.",
      "fixture": {
        "tables": [
          {
            "name": "orders",
            "create": "CREATE TABLE orders (id KEYWORD PRIMARY KEY, customer KEYWORD, total FLOAT, status KEYWORD, created TIMESTAMP)",
            "generate": {
              "count": 80,
              "fields": {
                "id": {
                  "seq": "o-"
                },
                "customer": {
                  "pick": [
                    "c-1",
                    "c-2",
                    "c-3",
                    "c-4",
                    "c-5"
                  ]
                },
                "total": {
                  "float": [
                    10,
                    300
                  ],
                  "digits": 2
                },
                "status": {
                  "pick": [
                    "placed",
                    "paid",
                    "shipped"
                  ],
                  "weights": [
                    2,
                    2,
                    1
                  ]
                },
                "created": {
                  "daysAgo": [
                    0,
                    60
                  ]
                }
              }
            }
          }
        ]
      },
      "checks": [
        {
          "name": "no stale order left",
          "kind": "sql",
          "sql": "SELECT COUNT(*) AS n FROM orders WHERE status = 'placed' AND created < '{{days_ago:30}}'",
          "expect": {
            "n": 0
          }
        },
        {
          "name": "recent placed kept",
          "kind": "sql",
          "sql": "SELECT id FROM orders WHERE status = 'placed' AND created > '{{days_ago:29}}'",
          "min_rows": 1
        },
        {
          "name": "others untouched",
          "kind": "sql",
          "sql": "SELECT COUNT(*) AS n FROM orders WHERE status = 'cancelled' AND created > '{{days_ago:29}}'",
          "expect": {
            "n": 0
          }
        }
      ]
    },
