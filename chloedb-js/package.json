{
  "name": "chloedb",
  "version": "0.3.3",
  "description": "ChloeDB from JavaScript: a search database with SQL, opened in-process from its file (Node, Bun, Deno) or over HTTP from any runtime with fetch",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./client.js",
      "workerd": "./client.js",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "common.js",
    "common.d.ts",
    "nearby.js",
    "scripts/build.mjs",
    "Cargo.toml",
    "Cargo.lock",
    "build.rs",
    "src/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install": "node scripts/build.mjs --if-missing",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chloetech-ai/chloedb",
    "directory": "chloedb-js"
  }
}
