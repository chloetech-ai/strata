{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "strataclusters.strata.chloetech.ai"
  },
  "spec": {
    "group": "strata.chloetech.ai",
    "names": {
      "kind": "StrataCluster",
      "listKind": "StrataClusterList",
      "plural": "strataclusters",
      "shortNames": [
        "strata"
      ],
      "singular": "stratacluster"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "additionalPrinterColumns": [
          {
            "jsonPath": ".spec.shards",
            "name": "Shards",
            "type": "integer"
          },
          {
            "jsonPath": ".spec.replicas",
            "name": "Copies",
            "type": "integer"
          },
          {
            "jsonPath": ".status.phase",
            "name": "Phase",
            "type": "string"
          },
          {
            "jsonPath": ".status.message",
            "name": "Message",
            "priority": 1,
            "type": "string"
          },
          {
            "jsonPath": ".metadata.creationTimestamp",
            "name": "Age",
            "type": "date"
          }
        ],
        "name": "v1alpha1",
        "schema": {
          "openAPIV3Schema": {
            "properties": {
              "spec": {
                "properties": {
                  "args": {
                    "description": "More arguments for every server.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "autoscale": {
                    "description": "Rules that change the copies, shards or volumes from how busy and full the servers are.",
                    "properties": {
                      "cooldownMinutes": {
                        "description": "Minutes after a change before the next (default 20).",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "freeze": {
                        "description": "Weekly windows, in UTC, in which nothing changes.",
                        "items": {
                          "properties": {
                            "allowGrow": {
                              "description": "Copies may still be added in it (default true).",
                              "type": "boolean"
                            },
                            "from": {
                              "description": "A day and a time, like Fri 16:00.",
                              "type": "string"
                            },
                            "to": {
                              "description": "A day and a time, like Mon 08:00.",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "grow": {
                        "description": "Add copies when the busiest shard's copies are busy.",
                        "properties": {
                          "add": {
                            "description": "Copies added to every shard (default 1).",
                            "minimum": 1,
                            "type": "integer"
                          },
                          "busyAbove": {
                            "description": "The share of their cores the copies use (default 0.7).",
                            "maximum": 1,
                            "minimum": 0,
                            "type": "number"
                          },
                          "forMinutes": {
                            "description": "For this long (default 10).",
                            "minimum": 1,
                            "type": "integer"
                          },
                          "max": {
                            "description": "Copies of each shard at most (default 5).",
                            "minimum": 1,
                            "type": "integer"
                          }
                        },
                        "type": "object"
                      },
                      "mode": {
                        "description": "off: nothing (the rules can be replayed); suggest: a change waits in status.autoscale for a person; on: the operator makes it (default off).",
                        "enum": [
                          "off",
                          "suggest",
                          "on"
                        ],
                        "type": "string"
                      },
                      "shrink": {
                        "description": "Remove a copy when every shard's copies are idle.",
                        "properties": {
                          "busyBelow": {
                            "description": "The share of their cores the busiest shard's copies use (default 0.35).",
                            "maximum": 1,
                            "minimum": 0,
                            "type": "number"
                          },
                          "forMinutes": {
                            "description": "For this long (default 60).",
                            "minimum": 1,
                            "type": "integer"
                          },
                          "min": {
                            "description": "Copies of each shard at least (default 2).",
                            "minimum": 1,
                            "type": "integer"
                          }
                        },
                        "type": "object"
                      },
                      "volumes": {
                        "description": "When the fullest volume fills.",
                        "properties": {
                          "action": {
                            "description": "grow: every volume by half; addShard: one more shard (default grow).",
                            "enum": [
                              "grow",
                              "addShard"
                            ],
                            "type": "string"
                          },
                          "fullAbove": {
                            "description": "Its used share (default 0.8).",
                            "maximum": 1,
                            "minimum": 0,
                            "type": "number"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "clusterTokenSecret": {
                    "description": "A Secret whose key token is the cluster's token (--cluster-token), which the servers and coordinators send each other and clients never hold. Needs tokenSecret.",
                    "type": "string"
                  },
                  "coordinatorArgs": {
                    "description": "More arguments for every coordinator.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "coordinatorResources": {
                    "description": "Resources of each coordinator's container.",
                    "type": "object",
                    "x-kubernetes-preserve-unknown-fields": true
                  },
                  "coordinators": {
                    "description": "Coordinators behind the cluster's Service (default 1).",
                    "minimum": 1,
                    "type": "integer"
                  },
                  "demo": {
                    "description": "Instead of a schema: this many demo products, split over the shards the cluster starts with.",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "failoverAfterMs": {
                    "description": "--failover-after-ms of every server (default 3000; 0: failover by hand).",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "image": {
                    "description": "The strata-server image of every server (default strata-server:dev).",
                    "type": "string"
                  },
                  "imagePullPolicy": {
                    "type": "string"
                  },
                  "replicas": {
                    "description": "Copies of each shard: a primary and its replicas (default 3).",
                    "minimum": 1,
                    "type": "integer"
                  },
                  "resources": {
                    "description": "Resources of each server's container.",
                    "type": "object",
                    "x-kubernetes-preserve-unknown-fields": true
                  },
                  "rollout": {
                    "description": "How changes are made: paused, or held by gates on the cluster's live numbers.",
                    "properties": {
                      "gates": {
                        "description": "Limits on live numbers: one over its limit for holdAfterSeconds holds the change until it is resumed.",
                        "properties": {
                          "diskUsedRatio": {
                            "description": "The fullest volume's used share.",
                            "maximum": 1,
                            "minimum": 0,
                            "type": "number"
                          },
                          "errorRatio": {
                            "description": "The share of searches that fail.",
                            "maximum": 1,
                            "minimum": 0,
                            "type": "number"
                          },
                          "p99Ms": {
                            "description": "The search p99 the coordinator's clients see, in ms.",
                            "minimum": 0,
                            "type": "number"
                          },
                          "replicaBehind": {
                            "description": "The transactions a replica is behind its primary.",
                            "minimum": 0,
                            "type": "number"
                          }
                        },
                        "type": "object"
                      },
                      "holdAfterSeconds": {
                        "description": "How long a gate is over its limit before it holds the change (default 30).",
                        "minimum": 0,
                        "type": "integer"
                      },
                      "paused": {
                        "description": "While true the operator takes no step toward the spec (a copy that lost its data still joins again).",
                        "type": "boolean"
                      },
                      "soakSeconds": {
                        "description": "How long a copy restarted with new settings serves before the next restarts (default 0).",
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  },
                  "schema": {
                    "description": "The first table's schema, as strata-server --schema takes it.",
                    "type": "object",
                    "x-kubernetes-preserve-unknown-fields": true
                  },
                  "shards": {
                    "description": "Shards, each holding a part of the 4,096 slots (default 1).",
                    "minimum": 1,
                    "type": "integer"
                  },
                  "storage": {
                    "properties": {
                      "size": {
                        "description": "Each copy's volume (default 10Gi).",
                        "type": "string"
                      },
                      "storageClassName": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "tokenSecret": {
                    "description": "A Secret whose key token every server and coordinator requires; with clusterTokenSecret, the coordinators only (the admin token).",
                    "type": "string"
                  },
                  "writeAcks": {
                    "description": "--write-acks of every primary (default all).",
                    "enum": [
                      "all",
                      "majority",
                      "primary"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "status": {
                "description": "What the operator found and does.",
                "type": "object",
                "x-kubernetes-preserve-unknown-fields": true
              }
            },
            "type": "object"
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
